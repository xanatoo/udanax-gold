bels: aString lines: anArray selectors: selArray 	"Answer a menu with labels from aString lines form anArray and selectors from selArray."	| aMenu |	aMenu _ self labels: aString lines: anArray.	aMenu setSelectors: selArray.	^ aMenu!labels: aString selectors: selArray 	"Answer a menu with labels from aString and selectors from selArray."	^ self labels: aString lines: nil selectors: selArray! !!ActionMenu class methodsFor: 'confirmation'!confirm  	"Confirm that the user really wants to take the action requested."	"ActionMenu confirm"	^ (ActionMenu labels: 'confirm\abort' withCRs selectors: nil) startUp = 1! !CodeController subclass: #AlwaysAcceptCodeController	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Interface-Text'!AlwaysAcceptCodeController comment:'An alwaysAcceptCodeController is a code controller that will do an accept even if the text is the same.'!!AlwaysAcceptCodeController methodsFor: 'menu messages'!accept	(model changeRequestFrom: view)		ifFalse: [^view flash].	self controlTerminate.	(view accept: self text from: self)		ifTrue: [initialText _ paragraph text copy]		ifFalse: [view flash].	self controlInitialize! !Path subclass: #Arc	instanceVariableNames: 'quadrant radius center '	classVariableNames: ''	poolDictionaries: ''	category: 'Graphics-Paths'!Arc comment:'Class Arc represents a quarter of a Circle, the quadrant is specified by 1, 2, 3 or 4 points which indicate which part of the circle is to be displayed. Quadrants are numbered 1 - 4 counter clockwise.Instance Variables:	quadrant	<Integer> 1 - 4 representing a part of the circle	radius	<Integer> length of the Circle radius	center	<Point> position at the center of the Circle'!!Arc methodsFor: 'accessing'!center	"Answer the point at the center of the receiver."	^center!center: aPoint 	"Set aPoint to be the receiver's center."	center _ aPoint!center: aPoint radius: anInteger 	"The receiver is defined by a point at the center and a radius.	The quadrant is not reset."	center _ aPoint.	radius _ anInteger!center: aPoint radius: anInteger quadrant: section 	"The receiver is an Arc for the quadrant specified by section.  The size of	the arc is defined by the center and its radius."	center _ aPoint.	radius _ anInteger.	quadrant _ section!quadrant	"Answer the section of a circle represented by the receiver."	^quadrant!quadrant: section 	"Set section to be the part of the circle represented by the receiver."	quadrant _ section!radius	"Answer the receiver's radius."	^radius!radius: anInteger 	"Set anInteger to be the receiver's radius."	radius _ anInteger! !!Arc methodsFor: 'displaying'!displayOn: aDisplayMedium at: aDisplayPoint clippingBox: clipRectangle rule: ruleInteger mask: aForm 	"Display the receiver on the display medium aDisplayMedium positioned at aDisplayPoint within 	the rectangle clipRectangle and with the rule, ruleInteger, and mask, aForm. "	| nSegments line angle sin cos xn yn xn1 yn1 |	nSegments _ 12.0.	line _ Line new.	line form: self form.	angle _ 90.0 / nSegments.	sin _ (angle * (2 * Float pi / 360.0)) sin.	cos _ (angle * (2 * Float pi / 360.0)) cos.	quadrant = 1		ifTrue: 			[xn _ radius asFloat.			yn _ 0.0].	quadrant = 2		ifTrue: 			[xn _ 0.0.			yn _ 0.0 - radius asFloat].	quadrant = 3		ifTrue: 			[xn _ 0.0 - radius asFloat.			yn _ 0.0].	quadrant = 4		ifTrue: 			[xn _ 0.0.			yn _ radius asFloat].	nSegments truncated		timesRepeat: 			[xn1 _ xn * cos + (yn * sin).			yn1 _ yn * cos - (xn * sin).			line beginPoint: center + (xn truncated @ yn truncated).			line endPoint: center + (xn1 truncated @ yn1 truncated).			line				displayOn: aDisplayMedium				at: aDisplayPoint				clippingBox: clipRectangle				rule: ruleInteger				mask: aForm.			xn _ xn1.			yn _ yn1]! !!Arc methodsFor: 'transforming'!scaleBy: aPoint 	"Answers with a new Arc scaled by aPoint.  Does not effect the current data in 	this Arc."	| newArc tempCenter |	newArc _ super scaleBy: aPoint.	newArc center: self center.	newArc radius: (self radius * aPoint x) truncated.	newArc quadrant: self quadrant.	^newArc!translateBy: aPoint 	"Answers with a new instance of Arc whose elements are translated by aPoint.  	Does not effect the elements of this Arc."	| newArc |	newArc _ super translateBy: aPoint.	newArc center: (self center x + aPoint x) @ (self center y + aPoint y).	newArc radius: self radius.	newArc quadrant: self quadrant.	^newArc! !!Arc methodsFor: 'display box access'!computeBoundingBox 	| origin |	quadrant = 1 ifTrue: [origin _ center - (0 @ radius)].	quadrant = 2 ifTrue: [origin _ center - (radius @ radius)].	quadrant = 3 ifTrue: [origin _ center - (radius @ 0)].	quadrant = 4 ifTrue: [origin _ center].	^Rectangle origin: origin + self form offset extent: radius @ radius + formextent! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Arc class	instanceVariableNames: ''!!Arc class methodsFor: 'examples'!arcDraw	"Click the button somewhere on the screen.  The designated point will	be the center of an Arc with radius 50 in the 4th quadrant."	"Arc arcDraw."	| anArc aForm |	aForm _ Form new extent: 1 @ 30.	"make a long thin Form for display"	aForm black.						"turn it black"	anArc _ Arc new.	anArc form: aForm.					"set the form for display"	anArc radius: 50.0.	anArc center: Sensor waitButton.	anArc quadrant: 4.	anArc displayOn: Display.	Sensor waitButton! !LocalVariable subclass: #ArgumentVariable	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'System-Compiler-Names and Scopes'!ArgumentVariable comment:'Class ArgumentVariables represents an argument variable.  An argument is just like a temporary, except that it is assumed to have a defined initial value that cannot be changed.'!!ArgumentVariable methodsFor: 'testing'!isInvariant	"Arguments cannot be stored into."	^true! !!ArgumentVariable methodsFor: 'checking'!leaveScope: codeStream between: minIndex and: maxIndex	(index >= minIndex and: [index <= maxIndex])		ifTrue:			[read ifFalse: ["warning: no references to argument"].			^true]		ifFalse: [^false]! !!ArgumentVariable methodsFor: 'code generation'!emitLoad: codeStream from: var	read _ true.	codeStream putLoadLocal: index argument: true scope: scope!emitStore: codeStream from: assignment	codeStream error: #error with: 'Attempt to store into argument' from: assignment!emitStorePop: codeStream from: assignment	codeStream error: #error with: 'Attempt to store into argument' from: assignment.	codeStream pop! !ValueNode subclass: #ArithmeticLoopNode	instanceVariableNames: 'variable initialValue increment stepSelector testSelector limit body '	classVariableNames: ''	poolDictionaries: ''	category: 'System-Compiler-Program Objects'!ArithmeticLoopNode comment:'Class ArithmeticLoopNode represents an internal node class for representing arithmetic loops (to:do:, to:by:do:).  Instances of the class are only created temporarily for code generation.Instance Variables:	variable		<VariableNode>	initialValue		<Integer>	increment		<LiteralNode>	stepSelector	<Symbol>	testSelector	<Symbol>	limit			<Integer>	body 			<BlockNode>'!!ArithmeticLoopNode methodsFor: 'initialize-release'!variable: var initialValue: initial increment: incr limit: lim body: bod	variable _ var.	initialValue _ initial.	incr numberValue >= 0		ifTrue: 			[increment _ incr.			stepSelector _ #+.			testSelector _ #<=]		ifFalse: 			[increment _ LiteralNode new value: incr numberValue negated.			stepSelector _ #-.			testSelector _ #>=].	limit _ lim.	body _ bod! !!ArithmeticLoopNode methodsFor: 'code generation'!emitEffect: codeStream	self expansion: codeStream do: [:seq | seq emitEffect: codeStream]!emitValue: codeStream	self emitEffect: codeStream.	codeStream pushConstant: nil! !!ArithmeticLoopNode methodsFor: 'private'!expansion: codeStream do: aBlock	"Evaluate aBlock with a parse tree of the form		var _ initial.		end _ limit.		[var <= end] whileTrue: [body.  var _ var + increment].	The increment must be a literal number.	The intermediate variable 'end' is not needed	if the limit is invariant."	| temps statements end test loopBody loop seq mark |	temps _ Array with: variable.	statements _ OrderedCollection with:		(AssignmentNode new			variable: variable			value: initialValue).	(limit isInvariantIn: codeStream)		ifTrue: [end _ limit]		ifFalse:			[end _ VariableNode new name: (codeStream generateNames: 1) first.			temps _ temps copyWith: end.			statements addLast: (AssignmentNode new				variable: end				value: limit)].	test _ MessageNode new		receiver: variable		selector: testSelector		arguments: (Array with: end).	loopBody _ (SequenceNode new statements:		(Array with: body with:			(AssignmentNode new				variable: variable				value: (MessageNode new					receiver: variable					selector: stepSelector					arguments: (Array with: increment))))).	loopBody sourcePosition: sourcePosition.	loop _ MessageNode new		receiver: (BlockNode new body: test)		selector: #whileTrue:		arguments: (Array with: (BlockNode new body: loopBody)).	statements addLast: loop.	seq _ SequenceNode new statements: statements asArray.	seq sourcePosition: sourcePosition.	mark _ codeStream addTemporaries: temps.	aBlock value: seq.	codeStream removeTemporaries: mark! !Magnitude subclass: #ArithmeticValue	instanceVariableNames: ''	classVariableNames: 'CoercionErrorSignal DivisionByZeroSignal DomainErrorSignal ImaginaryResultSignal NumberErrorSignal OverflowSignal RangeErrorSignal UnderflowSignal UnorderedSignal '	poolDictionaries: ''	category: 'Magnitude-Numbers'!ArithmeticValue comment:'ArithmeticValue is an abstract class for objects which can perform the familiar four arithmetic functions (and therefore have many other functions defined in terms of these).  To permit arithmetic between instances of different subclasses, ArithmeticValue''s subclasses have a notion of coercion generality.  This means that an instance of one subclass can always be coerced to an instance of another subclass of "higher generality".  For example, 1 can be coerced to 1.0 because Float is said to be of higher generality than SmallInteger.  Therefore, 1 + 1.0 can be evaluated by, in effect performing, 1 asFloat + 1.0.  Implementing mixed-type arithmetic via generalized coercion can be inefficient, so for subclasses where efficiency is important, we use a technique called "double dispatching".  See the additional comments in the class protocol under the message category documentation.ArithmeticValue is a subclass of Magnitude for implementation convenience (natural for most subclasses), although subclasses with no well-defined ordering will need to re-define #< as "^self shouldNotImplement".  For efficient mixed-mode arithmetic, subclasses should re-define all the methods in ArithmeticValue instance message category double dispatching.  Other efficiency measures include re-defining =.Subclasses must implement methods for 	instance protocol		arithmetic			+			*			-			/			<		coercing			coerce:			generality		testing			isZero		converting			reduceGeneralityIfPossible	class protocol 		constants access			zero			unity Class Variables:	CoercionErrorSignal		<Signal> Numeric coercion error	DivisionByZeroSignal	<Signal> Division by zero	DomainErrorSignal		<Signal> Numeric domain error	NumberErrorSignal		<Signal> Numeric error	OverflowSignal			<Signal> Numeric overflow	RangeErrorSignal		<Signal> Numeric range error	UnderflowSignal		<Signal> Numeric underflow	UnorderedSignal 		<Signal> Ordering of these numbers is ill-defined'!!ArithmeticValue methodsFor: 'arithmetic'!* aNumber 	"Answer the result of multiplying the receiver by the argument, aNumber."	^self subclassResponsibility!+ aNumber 	"Answer the sum of the receiver and the argument, aNumber."	^self subclassResponsibility!- aNumber 	"Answer the difference between the receiver and aNumber."	^self subclassResponsibility!/ aNumber 	"Answer the result of dividing receiver by aNumber."	^self subclassResponsibility!abs	"Answer a Number that is the absolute value (positive magnitude) of the receiver."	self negative		ifTrue: [^self negated]		ifFalse: [^self]!negated	"Answer a Number that is the negation of the receiver."	^self class zero - self!reciprocal	"Answer 1 divided by the receiver.  Provide an error 	notification if the receiver is 0."	^self class unity / self! !!ArithmeticValue methodsFor: 'mathematical functions'!raisedToInteger: anInteger 	"Answer the receiver raised to the power anInteger where the 	argument must be a kind of Integer. This is a special case of 	raisedTo:."	| count tmp |	anInteger isInteger		ifFalse: [^self class			raise: #domainErrorSignal			receiver: self			selector: #raisedToInteger:			arg: anInteger			errorString: 'raisedToInteger: expects an Integer as argument'].	anInteger < 0 ifTrue: [^(self raisedToInteger: anInteger negated) reciprocal].	anInteger = 0 ifTrue: [^self class unity].	anInteger = 1 ifTrue: [^self].	count _ 1.	[(count _ count + count) < anInteger] whileTrue.	tmp _ self class unity.	[count > 0]		whileTrue: 			[tmp _ tmp * tmp.			(anInteger bitAnd: count)				= 0 ifFalse: [tmp _ tmp * self].			count _ count bitShift: -1].	^tmp!squared	"Answer the receiver multiplied by itself."	^self * self! !!ArithmeticValue methodsFor: 'testing'!isZero	"Answer whether 'self = self class zero'.  We can't use #= because	#= is defined in terms of #isZero"	^self subclassResponsibility!negative	"Answer whether the receiver is less than 0."	^self < self class zero!positive	"Answer whether the receiver is greater than or equal to 0."	^self >= self class zero!respondsToArithmetic	"Answer whether the object responds to the numeric (#+, #-, #*, #/)	protocol as defined in the class ArithmeticValue"	^true!sign	"Answer 1 if the receiver is greater than 0, answer -1 if less than 0, 	else answer 0."	self > self class zero ifTrue: [^1].	self < self class zero ifTrue: [^-1].	^0!strictlyPositive	"Answer whether the receiver is greater than 0."	^self > self class zero! !!ArithmeticValue methodsFor: 'comparing'!= aNumber	"Answer whether the two objects are equal.  For numeric objects,	the two will be equal if the difference between them is zero"	^aNumber respondsToArithmetic		ifTrue:	[(self - aNumber) isZero]		ifFalse:	[false]! !!ArithmeticValue methodsFor: 'coercing'!coerce: aNumber 	"Answer a number representing the argument, aNumber, that is	the same kind of Number as the receiver.  Must be defined by all Number	classes."	^self subclassResponsibility!generality	"Answer the number representing the ordering of the receiver in the	generality hierarchy.  A number in this hierarchy coerces to numbers	higher in hierarchy (i.e., with larger generality numbers)."	^self subclassResponsibility!retry: aSymbol coercing: aNumber 	"Arithmetic represented by the symbol, aSymbol, could not be 	performed with the receiver and the argument, aNumber, because	of the differences in representation.  Coerce either the receiver or the	argument, depending on which has higher generality, and try again.  	If the generalities are the same, then this message	should not have been sent so an error notification is provided."	self generality < aNumber generality		ifTrue: [^(aNumber coerce: self) perform: aSymbol with: aNumber].	self generality > aNumber generality		ifTrue: [^self perform: aSymbol with: (self coerce: aNumber)].	self error: 'coercion attempt failed'! !!ArithmeticValue methodsFor: 'double dispatching'!differenceFromFloat: aFloat 	"The argument aFloat, known to be a kind of floating point number, 	encountered a problem on subtraction. Retry by coercing either aFloat	or self, whichever is the less general arithmetic value."	^aFloat retry: #- coercing: self!differenceFromFraction: aFraction	"The argument aFraction, known to be a kind of fraction, 	encountered a problem on subtraction. Retry by coercing either 	aFraction or self, whichever is the less general arithmetic value."	^aFraction retry: #- coercing: self!differenceFromInteger: anInteger	"The argument anInteger, known to be a kind of integer, 	encountered a problem on subtraction. Retry by coercing either 	anInteger or self, whichever is the less general arithmetic value."	^anInteger retry: #- coercing: self!lessFromFloat: aFloat 	"The argument aFloat, known to be a kind of floating point number, 	encountered a problem on less than comparison. Retry by coercing 	either aFloat or self, whichever is the less general arithmetic value."	^aFloat retry: #< coercing: self!lessFromFraction: aFraction	"The argument aFraction, known to be a kind of fraction, 	encountered a problem on less than comparison. Retry by coercing 	either aFraction or self, whichever is the less general arithmetic value."	^aFraction retry: #< coercing: self!lessFromInteger: anInteger 	"The argument anInteger, known to be a kind of integer, 	encountered a problem on less than comparison. Retry by 	coercing either anInteger or self, whichever is the less general	arithmetic value."	^anInteger retry: #< coercing: self!productFromFloat: aFloat 	"The argument aFloat, known to be a kind of floating point number, 	encountered a problem on multiplication. Retry by coercing either 	aFloat or self, whichever is the less general arithmetic value."	^aFloat retry: #* coercing: self!productFromFraction: aFraction	"The argument aFraction, known to be a kind of fraction, 	encountered a problem on multiplication. Retry by coercing either 	aFraction or self, whichever is the less general arithmetic value."	^aFraction retry: #* coercing: self!productFromInteger: anInteger	"The argument anInteger, known to be a kind of integer, 	encountered a problem on multiplication. Retry by coercing 	either anInteger or self, whichever is the less general	arithmetic value."	^anInteger retry: #* coercing: self!quotientFromFloat: aFloat 	"The argument aFloat, known to be a kind of floating point number, 	encountered a problem on division. Retry by coercing either aFloat 	or self, whichever is the less general arithmetic value."	^aFloat retry: #/ coercing: self!quotientFromFraction: aFraction	"The argument aFraction, known to be a kind of fraction, 	encountered a problem on division. Retry by coercing either 	aFraction or self, whichever is the less general arithmetic value."	^aFraction retry: #/ coercing: self!quotientFromInteger: anInteger	"The argument anInteger, known to be a kind of integer, 	encountered a problem on division. Retry by coercing either 	anInteger or self, whichever is the less general arithmetic value."	^anInteger retry: #/ coercing: self!sumFromFloat: aFloat 	"The argument aFloat, known to be a kind of floating point number, 	encountered a problem on addition. Retry by coercing either aFloat 	or self, whichever is the less general arithmetic value."	^aFloat retry: #+ coercing: self!sumFromFraction: aFraction	"The argument aFraction, known to be a kind of fraction, 	encountered a problem on addition. Retry by coercing either 	aFraction or self, whichever is the less general arithmetic value."	^aFraction retry: #+ coercing: self!sumFromInteger: anInteger	"The argument anInteger, known to be a kind of integer, 	encountered a problem on addition. Retry by coercing either 	anInteger or self, whichever is the less general arithmetic value."	^anInteger retry: #+ coercing: self! !!ArithmeticValue methodsFor: 'converting'!asSmallInteger	"Answer the receiver transformed to a lower generality, repeating the 	application until the generality of SmallInteger is reached.  If this is	not possible, signal an error."	^self reduceGeneralityToAtLeast: SmallInteger generality!reduceGeneralityIfPossible	"Answer the receiver transformed to a lower generality, if such a 	transformation is possible without losing information. If not, answer 	the receiver.  Answers self for simplicity, but subclasses should override."	^self!reduceGeneralityToAtLeast: aGenerality 	"Answer the receiver transformed to a lower generality, repeating the 	application until the specified generality is reached.  If the generality	can't be reached, signal an error"	| testVal lastTest generality |	testVal _ self.	lastTest _ 1000.	"An arbitrarily high generality"	[(generality _ testVal generality) < lastTest and: [aGenerality < generality]]		whileTrue: 			[lastTest _ generality.			testVal _ testVal reduceGeneralityIfPossible].	aGenerality < generality		ifTrue: [^self class				raise: #coercionErrorSignal				receiver: self				selector: #reduceGeneralityToAtLeast:				arg: aGenerality				errorString: self printString , ' could not be reduced to the desired generality']		ifFalse: [^testVal]!toMinimumGenerality	"Answer the receiver transformed to a lower generality, repeating the 	application until the generality doesn't change"	| testVal lastTest generality |	testVal _ self.	lastTest _ 1000.	"An arbitrarily high generality"	[(generality _ testVal generality) < lastTest]		whileTrue: 			[lastTest _ generality.			testVal _ testVal reduceGeneralityIfPossible].	^testVal! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!ArithmeticValue class	instanceVariableNames: ''!!ArithmeticValue class methodsFor: 'class initialization'!initialize	"Initialize signals."	"ArithmeticValue initialize"	| es rs ds |	es _ Object errorSignal.	NumberErrorSignal _ (es _ (es newSignalMayProceed: true)				notifierString: 'Numeric error';				nameClass: self message: #errorSignal).	UnorderedSignal _ ((es newSignal)				notifierString: 'Ordering of these numbers is ill-defined';				nameClass: self message: #unorderedSignal).	DomainErrorSignal _ (ds _ (es newSignal)				notifierString: 'Numeric domain error';				nameClass: self message: #domainErrorSignal).	DivisionByZeroSignal _ ((ds newSignal)				notifierString: 'Division by zero';				nameClass: self message: #divisionByZeroSignal).	ImaginaryResultSignal _ ((ds newSignal)				notifierString: 'Operation result would be imaginary';				nameClass: self message: #imaginaryResultSignal).	CoercionErrorSignal _ ((ds newSignal)				notifierString: 'Numeric coercion error';				nameClass: self message: #coercionErrorSignal).	RangeErrorSignal _ (rs _ (es newSignal)				notifierString: 'Numeric range error';				nameClass: self message: #rangeErrorSignal).	OverflowSignal _ ((rs newSignal)				notifierString: 'Numeric overflow';				nameClass: self message: #overflowSignal).	UnderflowSignal _ ((rs newSignal)				notifierString: 'Numeric underflow';				nameClass: self message: #underflowSignal)! !!ArithmeticValue class methodsFor: 'signal access'!coercionErrorSignal	^CoercionErrorSignal!divisionByZeroSignal	^DivisionByZeroSignal!domainErrorSignal	^DomainErrorSignal!errorSignal	^NumberErrorSignal!imaginaryResultSignal	^ImaginaryResultSignal!overflowSignal	^OverflowSignal!raise: signalName receiver: anObject selector: aSymbol arg: anArg errorString: aMessage	^(self perform: signalName) raiseRequestWith: (MessageSend receiver: anObject selector: aSymbol argument: anArg) errorString: aMessage!raise: signalName receiver: anObject selector: aSymbol args: anArray errorString: aMessage	^(self perform: signalName) raiseRequestWith: (MessageSend receiver: anObject selector: aSymbol arguments: anArray) errorString: aMessage!raise: signalName receiver: anObject selector: aSymbol errorString: aMessage	^(self perform: signalName) raiseRequestWith: (MessageSend receiver: anObject selector: aSymbol) errorString: aMessage!rangeErrorSignal	^RangeErrorSignal!underflowSignal	^UnderflowSignal!unorderedSignal	^UnorderedSignal! !!ArithmeticValue class methodsFor: 'constants access'!generality	"Answer the generality of the receiver's instances."	^self zero generality!unity	"Answer the value which allows, for any given arithmetic value, the following to be true		aNumber * aNumber class unity = aNumber	This must be true regardless of how a given subclass chooses to define #*"	^self subclassResponsibility!zero	"Answer the value which allows, for any given arithmetic value, the following to be true		aNumber + aNumber class zero = aNumber	This must be true regardless of how a given subclass chooses to define #+"	^self subclassResponsibility! !!ArithmeticValue class methodsFor: 'instance creation'!new	"Numbers should be created only through arithmetic operations."	^self shouldNotImplement!new: size	"Numbers should be created only through arithmetic operations."	^self shouldNotImplement! !!ArithmeticValue class methodsFor: 'documentation'!aboutDoubleDispatching	"Double dispatching is a useful technique for efficiently choosing an algorithm	based on the classes of one or more of the arguments of a message as well	as the class of the receiver.  For example, we might wish to evaluate the	following expression:		3 + 4.0	When the SmallInteger 3 receives the message #+, it may have to choose	among algorithms designed for Integers, Fractions, and Floats.  The fastest	way to do this is for it to simply send the argument of the message another	message--as shown here		+ aNumber 			<primitive: 1>			^aNumber sumFromInteger: self	If we replace variable names with values, this translates to		4.0 sumFromInteger: 3	Since the float knows that the argument must be an Integer, it knows immediately	what must be done to add itself to the integer.  Note that the order of the numbers	has changed, so that in methods such as Fraction>>quotientFromInteger:, it is the	argument that is divided by the receiver, and not the receiver divided by the argument	In the system as delivered, there are five operations that are subject to	double-dispatching:		+ (addition)		- (subtraction)		* (multiplication)		/ (division)		< (comparison--the rest of the comparison operators can be derived)	For addition, the dispatch operator takes the form #sumFrom[a class name]:	For subtraction, the dispatch operator takes the form #differenceFrom[a class name]:	For multiplication, the dispatch operator takes the form #productFrom[a class name]:	For division, the dispatch operator takes the form #quotientFrom[a class name]:	For comparison, the dispatch operator takes the form #lessFrom[a class name]:	"	^self error: 'comment only'!coercion	"The base numbers in the system evaluate arithmetic and comparison 	operations by a technique called double-dispatching. This provides 	significant speed at the expense of a large number of typed 	methods--sumFromFloat, sumFromInteger, sumFromFraction . . . . 	Obviously, when defining a new class of ArithmeticValue, you wouldn't 	always want to add a whole new set of dispatching messages for 	your new class. This causes an explosion that is uncontrollable. 	Therefore, there is a second, slightly less efficient method of 	integrating a ArithmeticValue class into the system. 		To implement a new class in the easiest possible fashion, you must 	first decide the class's generality. The generality of a number is an 	integer that defines its relationship to other kinds of numbers. For 	example: all Integers can be represented as Fractions, but not all 	Fractions can be represented as Integers. Therefore, Fractions have 	greater generality than Integers. Likewise, Floats have greater 	generality than either Fractions or Integers. For example, look at the 	class Double--part of the Extended Numbers fileIn. Because all 	Floats can be represented as Doubles, we give it a generality higher 	than Float. Not all Complex numbers can be represented as Doubles, 	so it should have a generality less than Complex. When we have 	given the same consideration to all of the existing ArithmetivValue	classes, we may settle on a generality of 90. 		It must be possible, if this technique is used, to convert anything 	with a smaller generality to an instance of the new class. For 	Double, this is acheived by defining a message called #asDouble, 	which is recognized by Floats, Fractions, and Integers. Then, when 	#coerce: is sent to a Double, with aNumber as the argument, the 	Double returns 'aNumber asDouble'. In this way, the argument of 	#coerce: is made compatible with the receiver. Likewise, Doubles 	must also know how to coerce themselves into instances of any 	class that has higher generality than they do. The protocol is 	defined by the class with higher generality. 		Finally, when a number is sent an arithmetic or comparison message, 	it should first test whether the argument is compatible. The easiest 	test is whether the receiver and argument have the same class. If 	they are compatible, there should be some kind of algorithm for 	performing the requested operation. If not, the receiver should be 	sent the message #retry:coercing:. The first argument is the 	selector of the message that was sent; the second is the argument 	of the message. The implementation of #retry:coercing: finds out 	which of the numbers has lower generality, coerces that number to 	have a compatible format with the other number, and resends the 	message. 		The class Complex depends heavily on this protocol. A useful 	example of how the code works can be had by filing in the code for 	Complex, and stepping through the following code in the Debugger: 		self halt. 	(3%2) + (5%3). 	(3%2) + 7. 	7 + (3%2). 		"	^self error: 'comment only'!thisClassIsFieldlike	"A more formal way of considering the role of ArithmeticValue is that 	all subclasses obey the field axioms: 		Given a set (all the potential instances of all the subclasses of 		ArithmeticValue) with two operations -- addition (+) and 		multiplication (*). 		1] a + b is in the set {closed under addition}. 		2] a + b = b + a and (a + b) + c = a + (b + c)			{addition is commutative and associative}. 		3] there is a set element z such that a + z = a			{additive identity or zero} 		4] for any a & b, there is a set element x such that a + x = b 			{additive inverse} 		5] a * b is in the set {closed under multiplication}. 		6] a * b = b * a and (a * b) * c = a * (b * c)			{multiplication is commutative and associative}. 		7] there is a set element u such that a * u = a			{multiplicitive identity or unity} 		8] for any a & b, there is a set element x such that a * x = b 			{multiplicitive inverse} 		9] a * (b + c) = (a * b) + (a * c)			{multiplication distributes over addition} 		Given this basis, we can define subtraction, division, remainder, 	negation etc. The guarentee of comutivity is needed for the 	double-dispatching stuff. 		Of course, the notion of a set being closed under some operation on 	real computers is tied-up with the halting problem (e.g. can the 	computation ever be completed) and lack of verification; so we can 	not really rely on this notion completely. 	"	^self error: 'comment only'! !ArithmeticValue initialize!ArrayedCollection variableSubclass: #Array	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Collections-Arrayed'!Array comment:'Class Array represents SequenceableCollections whose elements are any objects. It provides the concrete representation for storing a collection of elements that have integers as external keys.  Instance Variables: *indexed*'!!Array methodsFor: 'converting'!asArray	"Answer the receiver itself."	^self! !!Array methodsFor: 'printing'!isLiteral	"Answer whether all the elements of the array are literal."	self detect: [:element | element isLiteral not] ifNone: [^true].	^false!printOn: aStream 	"Append to the argument, aStream, the elements of the Array 	enclosed by parentheses."	| tooMany |	tooMany _ aStream position + self maxPrint.	aStream nextPut: $(.	self do: 		[:element | 		aStream position > tooMany			ifTrue: 				[aStream nextPutAll: '...etc...)'.				^self].		element printOn: aStream.		aStream space].	aStream nextPut: $)!storeOn: aStream 	"Append to the argument aStream a sequence of characters that is an	expression whose evaluation creates an object similar to the receiver.	Use the literal form if possible."	self isLiteral		ifTrue: 			[aStream nextPut: $#; nextPut: $(.			self do: 				[:element | 				element storeOn: aStream.				aStream space].			aStream nextPut: $)]		ifFalse: [super storeOn: aStream]! !SequenceableCollection subclass: #ArrayedCollection	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Collections-Abstract'!ArrayedCollection comment:'The abstract class ArrayedCollection represents a collection of elements with integers as external keys.   Its subclasses are	Array		elements are pointers	ByteArray	elements are bytes	RunArray	elements are typically runs of the same thing	String		elements are characters	Text		elements are characters with style	WordArray	elements are wordsIt re-implements several messages inherited from SequenceableCollection in order to obtain some performance gains.  Subclasses should not implement methods for	adding		add:	removing		remove:ifAbsent:'!!ArrayedCollection methodsFor: 'accessing'!size	"Answer the number of indexable fields in the receiver. This value is the 	same as the largest legal subscript.  Primitive is specified here to override 	SequenceableCollection size.  Essential.  See Object documentation 	whatIsAPrimitive. "	<primitive: 62>	^self basicSize! !!ArrayedCollection methodsFor: 'adding'!add: newObject	"ArrayedCollections cannot implement add:."	self shouldNotImplement! !!ArrayedCollection methodsFor: 'printing'!storeOn: aStream 	"Append to the argument aStream a sequence of characters that is an	expression whose evaluation creates an object similar to the receiver.	For an ArrayedCollection, the general format is		((class-name new: size) 			at: index put: element; at: nextIndex put: element; yourself)	"	aStream nextPutAll: '(('.	aStream nextPutAll: self class name.	aStream nextPutAll: ' new: '.	aStream store: self size.	aStream nextPut: $).	(self storeElementsFrom: 1 to: self size on: aStream)		ifFalse: [aStream nextPutAll: '; yourself'].	aStream nextPut: $)! !!ArrayedCollection methodsFor: 'private'!defaultElement	"Answer the object that is stored when no specific object is indicated."	^nil!storeElementsFrom: firstIndex to: lastIndex on: aStream 	"Append to the argument aStream a description of elements of the	receiver starting with the element at position firstIndex and ending	with the element at position lastIndex.  The general format for each	position is			at: index put: element	separated by semicolons."	| noneYet defaultElement arrayElement |	noneYet _ true.	defaultElement _ self defaultElement.	firstIndex to: lastIndex do: 		[:index | 		arrayElement _ self at: index.		arrayElement = defaultElement			ifFalse: 				[noneYet					ifTrue: [noneYet _ false]					ifFalse: [aStream nextPut: $;].				aStream nextPutAll: ' at: '.				aStream store: index.				aStream nextPutAll: ' put: '.				aStream store: arrayElement]].	^noneYet! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!ArrayedCollection class	instanceVariableNames: ''!!ArrayedCollection class methodsFor: 'instance creation'!new	"Answer a new instance of ArrayedCollection with size = 0."	^self new: 0!new: size withAll: value 	"Answer a new instance of ArrayedCollection whose every element is 	equal to the argument, value."	^(self new: size)		atAllPut: value!with: anObject 	"Answer a new instance of ArrayedCollection, containing only anObject."	| newCollection |	newCollection _ self new: 1.	newCollection at: 1 put: anObject.	^newCollection!with: firstObject with: secondObject 	"Answer a new instance of ArrayedCollection, containing firstObject 	and secondObject."	| newCollection |	newCollection _ self new: 2.	newCollection at: 1 put: firstObject.	newCollection at: 2 put: secondObject.	^newCollection!with: firstObject with: secondObject with: thirdObject 	"Answer a new instance of ArrayedCollection, containing only these 	three objects."	| newCollection |	newCollection _ self new: 3.	newCollection at: 1 put: firstObject.	newCollection at: 2 put: secondObject.	newCollection at: 3 put: thirdObject.	^newCollection!with: firstObject with: secondObject with: thirdObject with: fourthObject 	"Answer a new instance of ArrayedCollection, containing the four 	arguments as the elements."	| newCollection |	newCollection _ self new: 4.	newCollection at: 1 put: firstObject.	newCollection at: 2 put: secondObject.	newCollection at: 3 put: thirdObject.	newCollection at: 4 put: fourthObject.	^newCollection! !BinaryStorage subclass: #AsciiBinaryStorage	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'System-Binary Storage'!AsciiBinaryStorage comment:'The class AsciiBinaryStorage implements an alternative BinaryStorage encoding, an ASCII representation more convenient for debugging.'!!AsciiBinaryStorage methodsFor: 'initialize-release'!on: aStream	" Don't set to binary. "	stream _ aStream.	self initialize! !!AsciiBinaryStorage methodsFor: 'private-encoding'!encodeBytes: bytes	" Append the bytes to the output. "	bytes do: [:b | stream nextPut: (Character value: b)]!encodeOpByte: byte	stream		nextPut: $<; print: (byte bitShift: OpcodeShift negated);		nextPut: $,; print: (byte bitAnd: OperandMask);		nextPut: $>!encodeString: aByteString	" Append the characters of	aByteString to the output. "	stream nextPutAll: aByteString! !!AsciiBinaryStorage methodsFor: 'private-decoding'!decodeBytes: bytesClass size: size	| bytes |	bytes _ bytesClass new: size.	1 to: bytes size do: [:i | bytes at: i put: stream next asInteger].	^bytes!decodeOpByte	" Answer the next opcode/operand	byte from the stream. "	| op int |	stream next = $< ifFalse: [self error: 'expected <'.  ^-1].	op _ Integer readFrom: stream.	stream next = $, ifFalse: [self error: 'expected ,'.  ^-1].	int _ Integer readFrom: stream.	stream next = $> ifFalse: [self error: 'expected >'.  ^-1].	^(op bitShift: OpcodeShift) + int!decodeString: size	" Read and answer a String	of the given size. "	^stream next: size! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!AsciiBinaryStorage class	instanceVariableNames: ''!!AsciiBinaryStorage class methodsFor: 'private'!streamContentsClass	^String! !ValueNode subclass: #AssignmentNode	instanceVariableNames: 'variable value leftArrow '	classVariableNames: ''	poolDictionaries: ''	category: 'System-Compiler-Program Objects'!AssignmentNode comment:'Class AssignmentNode represents an assignment, variable _ value or variable := value.Instance Variables:	variable	<VariableNode>	value		<ValueNode>	leftArrow	<Boolean>	true if ''_'' generated this or default, false if '':='''!!AssignmentNode methodsFor: 'initialize-release'!leftArrowIsDefault 	"Answer true if '_' is the default way to print assignments, false if ':=' is"	^true!variable: aVariable value: anExpression 	^self variable: aVariable value: anExpression leftArrow: self leftArrowIsDefault!variable: aVariable value: anExpression leftArrow: aBoolean	variable _ aVariable.	value _ anExpression.	leftArrow _ aBoolean! !!AssignmentNode methodsFor: 'accessing'!absoluteSourcePosition	"Answer the sourcePosition of the first child-node of this node.	For assignment, this is the sourcePosition of the assignee"	^variable absoluteSourcePosition!value	^value!variable	"For error messages and noteStore:"	^variable! !!AssignmentNode methodsFor: 'printing'!printOn: aStream indent: level 	variable printOn: aStream indent: level.	leftArrow		ifTrue: [aStream nextPutAll: ' _ ']		ifFalse: [aStream nextPutAll: ' := '].	value printOn: aStream indent: level + 2!printOn: aStream indent: level precedence: p 	p < 4 ifTrue: [aStream nextPut: $(].	self printOn: aStream indent: level.	p < 4 ifTrue: [aStream nextPut: $)]! !!AssignmentNode methodsFor: 'code generation'!emitEffect: codeStream	variable emitStorePop: codeStream value: value from: self!emitValue: codeStream	variable emitStore: codeStream value: value from: self! !LookupKey subclass: #Association	instanceVariableNames: 'value '	classVariableNames: ''	poolDictionaries: ''	category: 'Collections-Support'!Association comment:'An Association is a pair of associated objects--a key and a value.  It can serve as an entry in a dictionary.  Think of the key as the left-hand side of the dictionary and the value as the right-hand side.Instance Variable:	value	<Object>'!!Association methodsFor: 'accessing'!key: aKey value: anObject 	"Store the arguments as the variables of the receiver."	key _ aKey.	value _ anObject!value	"Answer the value of the receiver."	^value!value: anObject 	"Store the argument, anObject, as the value of the receiver."	value _ anObject! !!Association methodsFor: 'printing'!printOn: aStream 	"Append to the argument, aStream, the two elements of the 	Association separated by a right arrow."	super printOn: aStream.	aStream nextPutAll: '->'.	value printOn: aStream! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Association class	instanceVariableNames: ''!!Association class methodsFor: 'instance creation'!key: newKey value: newValue	"Answer a new instance of the receiver with the arguments as the key and	value of the association."	^(super key: newKey) value: newValue! !Collection subclass: #Bag	instanceVariableNames: 'contents '	classVariableNames: ''	poolDictionaries: ''	category: 'Collections-Unordered'!Bag comment:'A Bag is an unordered collection of elements.  It stores these elements in a dictionary, tallying up occurrences of equal objects.  Because a Bag can store an occurrence only once, its clients should beware that objects they store will not necessarily be retrieved such that == is true.  If the client cares, a subclass of Bag should be created.Instance Variables:	contents		<Dictionary> of associations between elements and the number of occurrences of each element in the Bag'!!Bag methodsFor: 'accessing'!at: anInteger	"Provide an error notification that elements of a Bag	are not accessible by external keys." 	^self notKeyedError!at: anInteger put: anObject	"Provide an error notification that elements of a Bag	are not accessible by external keys."	^self notKeyedError!size	"Answer how many elements the receiver contains."	| tally |	tally _ 0.	contents do: [:each | tally _ tally + each].	^tally!sortedCounts	"Answer a collection of counts with elements, sorted by decreasing 	count. "	| counts |	counts _ SortedCollection sortBlock: [:x :y | x >= y].	contents associationsDo: 		[:assn | counts add: (Association key: assn value value: assn key)].	^counts!sortedElements	"Answer a collection of elements with counts, sorted by element."	| elements |	elements _ SortedCollection new.	contents associationsDo: [:assn | elements add: assn].	^ elements! !!Bag methodsFor: 'testing'!includes: anObject 	"Answer whether anObject is one of the receiver's elements."	^contents includesKey: anObject!occurrencesOf: anObject 	"Answer how many of the receiver's elements are equal to anObject."	(self includes: anObject)		ifTrue: [^contents at: anObject]		ifFalse: [^0]! !!Bag methodsFor: 'adding'!add: newObject 	"Include newObject as one of the receiver's elements.  Answer newObject."	^self add: newObject withOccurrences: 1!add: newObject withOccurrences: anInteger 	"Add the element newObject to the elements of the receiver.  Do so as	though the element were added anInteger number of times.  Answer newObject."	(self includes: newObject)		ifTrue: [contents at: newObject put: anInteger + (contents at: newObject)]		ifFalse: [contents at: newObject put: anInteger].	^newObject! !!Bag methodsFor: 'removing'!remove: oldObject ifAbsent: exceptionBlock  	"Remove oldObject as one of the receiver's elements.  If several of the	elements are equal to oldObject, only one is removed. If no element is equal to	oldObject, answer the result of evaluating anExceptionBlock.  Otherwise,	answer the argument, oldObject."	| count |	(self includes: oldObject)		ifTrue: [(count _ contents at: oldObject) = 1				ifTrue: [contents removeKey: oldObject]				ifFalse: [contents at: oldObject put: count - 1]]		ifFalse: [^exceptionBlock value].	^oldObject! !!Bag methodsFor: 'enumerating'!do: aBlock 	"Evaluate aBlock with each of the receiver's elements as the argument."	contents associationsDo: [:assoc | assoc value timesRepeat: [aBlock value: assoc key]]! !!Bag methodsFor: 'private'!setDictionary	"Initialize the instance variable."	contents _ Dictionary new! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Bag class	instanceVariableNames: ''!!Bag class methodsFor: 'instance creation'!new	"Create an instance of Bag whose contents are empty."	^super new setDictionary! !Object subclass: #Behavior	instanceVariableNames: 'superclass methodDict format subclasses '	classVariableNames: ''	poolDictionaries: ''	category: 'Kernel-Classes'!Behavior comment:'Instances of class Behavior provides the minimum state necessary for compiling methods, and creating and running instances.  Most objects are created as instances of the more fully supported subclass, Class, but Behavior is a good starting point for providing instance-specific behavior (as in Metaclass).Instance Variables:	superclass	<Behavior> links the chain of inheritance	methodDict	<IdentityDictionary> associates message names with methods	format		<Integer> encodes storage layout of instances	subclasses	<Set> back-pointers to the class'' subclasses'!!Behavior methodsFor: 'initialize-release'!localObsolete	"Remove the receiver from its superclass' subclass list."	self removeFromSuper!obsolete	"Invalidate and recycle local messages.  Remove the receiver from its superclass' 	subclass list."	self localObsolete! !!Behavior methodsFor: 'accessing'!format	"Answer an Integer that encodes the kinds and numbers of variables of instances	of the receiver."	^format! !!Behavior methodsFor: 'testing'!instSize	"Answer the number of named instance variables (as opposed to indexed	variables) of the receiver."	^format bitAnd: 255!isBehavior	"Answer whether the object can be the 'class' of another object"	^true!isBits	"Answer whether the receiver contains just bits (not pointers)."	^format noMask: -16384!isFixed	"Answer whether the receiver does not have a variable (indexable) part."	^self isVariable not!isPointers	"Answer whether the receiver contains just pointers (not bits)."	^self isBits not!isVariable	"Answer whether the receiver has a variable (indexable) part."	^(format bitAnd: 4096) ~= 0!shouldBeRegistered	"Answer whether the receiver is named and should be 'stored' in its environment"	^false! !!Behavior methodsFor: 'copying'!copy	"Make a copy of the receiver without a list of subclasses."	| myCopy savedSubclasses |	savedSubclasses _ subclasses.	subclasses _ nil. 			myCopy _ self shallowCopy.	subclasses _ savedSubclasses.	^myCopy methodDictionary: methodDict copy!deepCopy	"Answer a copy of the receiver with its own copy of each instance 	variable. This doesn't make sense for Behaviors."	^self deepCopyError! !!Behavior methodsFor: 'printing'!printHierarchy	"Answer a description containing the names and instance variable	names of all of the subclasses and superclasses of the receiver."	| aStream index |	index _ 0.	aStream _ WriteStream on: (String new: 16).	self allSuperclasses reverseDo: 		[:aClass | 		aStream crtab: index.		index _ index + 1.		aStream nextPutAll: aClass name.		aStream space.		aStream print: aClass instVarNames.].	aStream cr.	self printSubclassesOn: aStream level: index.	^aStream contents!printOn: aStream 	"Append to the argument aStream a statement of which	superclass the receiver descends from."	aStream nextPutAll: 'a descendent of '.	superclass printOn: aStream! !!Behavior methodsFor: 'creating class hierarchy'!addSubclass: aSubclass 	"Make the argument, aSubclass, be one of the subclasses of the receiver."		aSubclass superclass = self		ifTrue: [subclasses == nil					ifTrue:	[subclasses _ Set with: aSubclass]					ifFalse:	[subclasses add: aSubclass]]		ifFalse: [self error: aSubclass name , ' is not my subclass']!addToSuper	"Add the receiver to the superclass's subclass list."	(superclass == nil or: [superclass isMeta])		ifFalse:	[superclass addSubclass: self]!assignSuperclass: aClass	"Change the superclass, updating the superclass's subclass list."	self removeFromSuper.	superclass _ aClass.	self addToSuper!classBuilder	"Answer an appropriate class mutation object."	^ClassBuilder new!clearInstanceVariables	"After creating the copy, clear in the copy those instance variables that would be confusing"	superclass _ nil.	methodDict _ methodDict copy.	subclasses _ nil!removeFromSuper	"Remove the receiver from the superclass's subclass list"	(superclass == nil or: [superclass isMeta])		ifFalse:	[superclass removeSubclass: self]!removeSubclass: aSubclass 	"If the argument, aSubclass, is one of the receiver's subclasses, remove it."	subclasses == nil ifFalse:		[subclasses remove: aSubclass ifAbsent: [].		subclasses isEmpty ifTrue: [subclasses _ nil]]!superclass: aClass 	"Change the receiver's superclass to be aClass."	aClass isBehavior		ifTrue: [superclass _ aClass]		ifFalse: [self error: 'superclass must be a class-describing object']! !!Behavior methodsFor: 'creating method dictionary'!addSelector: selector withMethod: compiledMethod 	"Add the message selector with the corresponding compiled method to the receiver's	method dictionary."	methodDict at: selector put: compiledMethod.	self flushVMmethodCacheEntriesFor: selector!methodDictionary: aDictionary 	"Store the argument, aDictionary, as the method dictionary of the receiver."	methodDict _ aDictionary!removeSelector: selector 	"Assuming that the message selector is in the receiver's method dictionary,	remove it.  If the selector is not in the method dictionary, create an error	notification."	methodDict removeKey: selector.	self flushVMmethodCacheEntriesFor: selector! !!Behavior methodsFor: 'instance creation'!basicNew	"Answer a new instance of the receiver (which is a class) with no indexable 	variables.  Fail if the class is indexable.  Essential.  See Object documentation	whatIsAPrimitive."	<primitive: 70>	self isVariable ifTrue: [^self basicNew: 0].	self primitiveFailed!basicNew: anInteger 	"Answer a new instance of the receiver (which is a class) with the number of 	indexable variables specified by the argument, anInteger.  Fail if the class is not	indexable or if the argument is not a positive Integer.  Essential.  See Object	documentation whatIsAPrimitive."	<primitive: 71>	self primitiveFailed!new	"Answer with a new instance of the receiver, which is a class with no indexable 	variables.  Fail if the class is indexable.  Essential.  See Object documentation 	whatIsAPrimitive. "	<primitive: 70>	self isVariable ifTrue: [^self new: 0].	self primitiveFailed!new: anInteger 	"Answer with a new instance of the receiver, a class with the number of 	indexable variables specified by the argument, anInteger.  Fail if the class is not	indexable or if the argument is not a positive Integer.  Essential.  See Object	documentation whatIsAPrimitive."	<primitive: 71>	self primitiveFailed! !!Behavior methodsFor: 'accessing class hierarchy'!allSubclasses	"Answer an OrderedCollection of the receiver's subclasses and the receiver's ancestor's	subclasses in breadth-first order, with the immediate subclasses first."	| coll |	coll _ OrderedCollection new.	coll addAll: self subclasses.	self subclasses do: [:eachSubclass | coll addAll: eachSubclass allSubclasses].	^coll!allSuperclasses	"Answer an OrderedCollection of the receiver's superclass and the receiver's ancestor's	superclasses, with the immediate superclasses first."	superclass == nil		ifTrue:	[^OrderedCollection new]		ifFalse:	[| coll |				coll _ superclass allSuperclasses.				coll addFirst: superclass.				^coll].!subclasses	"Answer the receiver's subclasses.  Return a copy so that callers who 	add or delete subclasses won't get confused."	subclasses == nil		ifTrue: [^Set new]		ifFalse: [^subclasses copy]!superclass	"Answer the receiver's superclass.  Only returns the first one		- use 'superclasses' to find them all."	^superclass!withAllSubclasses	"Answer an OrderedCollection of subclasses including this class in breadth first order."	| subs |	subs _ self allSubclasses.	subs addFirst: self.	^subs!withAllSuperclasses	"Answer an OrderedCollection of superclasses including this class in breadth first order."	| subs |	subs _ self allSuperclasses.	subs addFirst: self.	^subs! !!Behavior methodsFor: 'accessing method dictionary'!allSelectors	"Answer a set of all the message selectors that instances of the receiver can	understand."	| aSet |	aSet _ Set new.	self withAllSuperclasses do: [:each | aSet addAll: each selectors].	^aSet	"Point allSelectors."!compiledMethodAt: selector 	"Answer the compiled method associated with the message selector in the	receiver's method dictionary.  If the selector is not in the dictionary,	create an error notification."	^methodDict at: selector!selectorAtMethod: method ifAbsent: aBlock	"Answer the message selector associated with the compiled method,	or the result of evaluating aBlock if the compiled method does not	appear in this class."	^methodDict keyAtValue: method ifAbsent: aBlock!selectorAtMethod: method setClass: classResultBlock 	"Answer both the message selector associated with the compiled method 	and the class in which that selector is defined."	| sel |	sel _ methodDict keyAtValue: method				ifAbsent: 					[superclass == nil						ifTrue: 							[classResultBlock value: self.							^self defaultSelectorForMethod: method].					sel _ superclass selectorAtMethod: method setClass: classResultBlock.					"Set class to be self, rather than that returned from 					superclass. "					sel == (self defaultSelectorForMethod: method) ifTrue: [classResultBlock value: self].					^sel].	classResultBlock value: self.	^sel!selectors	"Answer a Set of all the message selectors specified in the receiver's	method dictionary."	^methodDict keys  	"Point selectors."!sourceCodeAt: messageSelector 	"Answer the string corresponding to the source code for the argument."	^ self sourceCodeForMethod: (methodDict at: messageSelector) at: messageSelector!sourceCodeForMethod: method at: messageSelector 	"Answer the string corresponding to the source code for the argument."	^method getSourceForUserIfNone:		[(self decompilerClass new				decompile: messageSelector				in: self				method: method) decompileString]!sourceMethodAt: selector 	"Answer the paragraph corresponding to the source code for the argument."	^(self sourceCodeAt: selector) asText makeSelectorBoldIn: self! !!Behavior methodsFor: 'accessing instances and variables'!allClassVarNames	"Answer a Set of the names of the receiver's and the receiver's	ancestor's class variables."	^superclass allClassVarNames!allInstances 	"Answer a collection of all instances of this class."	| aCollection |	aCollection _ OrderedCollection new.	self allInstancesDo:		[:x | x == aCollection ifFalse: [aCollection add: x]].	^aCollection!allInstVarNames	"Answer an Array of the names of the receiver's instance variables."	| names |	names _ OrderedCollection new.	self accumulateInstVarNames: names.	^names!allSharedPools	"Answer a Set of the pools, dictionaries, that the receiver and the	receiver's ancestors share.  Subclasses, such as class Class, override this message."	^superclass allSharedPools!allVarNamesSelect: selectBlock 	"Answer a collection of all the static variable names defined for the 	receiver which satisfy the condition in selectBlock. Test class and 	pool variables, including superclass variables. Also include global 	variables."	| set |	set _ self classPool keys select: selectBlock.	self sharedPools do: [:pool | set addAll: (pool keys select: selectBlock)].	superclass == nil		ifTrue: [set addAll: (Smalltalk keys select: selectBlock)]		ifFalse: [set addAll: (superclass allVarNamesSelect: selectBlock)].	^set!classVarNames	"Answer a Set of the receiver's class variable names.  Since the receiver does	not retain knowledge of class variables, the method fakes it by creating an empty set."	^Set new!fastAllInstVarNamesDo: aBlock	"Evaluate aBlock with the names of the receiver's instance variables.	This is a fast version that bypasses (non-existent) multiple inheritance."	superclass == nil ifFalse: [superclass fastAllInstVarNamesDo: aBlock].	self instVarNames do: aBlock!instanceCount	"Answer the number of instances of the receiver that are currently in use."	| count |	count _ 0.	self allInstancesDo: [:x | count _ count + 1].	^count!instVarNames	"Answer an Array of the instance variable names.  Behaviors must make up fake	local instance variable names because Behaviors have instance variables for the	purpose of compiling methods, but these are not named instance variables.  "	| mySize superSize |	mySize _ self instSize.	superSize _ 		superclass == nil			ifTrue: [0]			ifFalse: [superclass instSize].	mySize = superSize ifTrue: [^#()].		^(superSize + 1 to: mySize) collect: [:i | 'inst' , i printString]!sharedPools	"Answer a Set of the pools, dictionaries, that the receiver shares.  Since the receiver	does not retain knowledge of pool dictionaries, the method fakes it by creating an	empty array.  Subclasses, such as class Class, override this message."	^Set new!someInstance	"Answer with the first instance of this receiver.  See Object  	nextInstance.  Fails if there are none.  Essential.  See Object 	documentation whatIsAPrimitive."	<primitive: 77>	^nil!subclassInstVarNames	"Answer with a Set of the names of the receiver's subclasses' 	instance variables."	| vars |	vars _ Set new.	self allSubclasses do: [:aSubclass | vars addAll: aSubclass instVarNames].	^vars! !!Behavior methodsFor: 'testing class hierarchy'!inheritsFrom: aClass 	"Answer whether the argument, aClass, is on the receiver's superclass chain."	superclass == nil		ifTrue:	[^superclass = aClass]		ifFalse:	[^superclass==aClass or: [superclass inheritsFrom: aClass]]! !!Behavior methodsFor: 'testing method dictionary'!canUnderstand: selector 	"Answer true if the receiver can respond to the message whose selector	is the argument, false otherwise.  The selector can be in the method dictionary	of the receiver's class or any of its superclasses."	(self includesSelector: selector) ifTrue: [^true].	superclass == nil ifTrue: [^false].	^superclass canUnderstand: selector!hasMethods	"Answer whether the receiver has any methods in its method dictionary."	^methodDict size > 0!includesSelector: aSymbol 	"Answer whether the message whose selector is the argument is in the 	method dictionary of the receiver's class."	^methodDict includesKey: aSymbol!scopeHas: varName ifTrue: assocBlock 	"Look up varName in this class, its superclasses, and Smalltalk.  If it is there,	pass the association to assocBlock, and answer true; else answer false."	| assoc |	self withAllSuperclasses do:		[:sup |		(sup poolHas: varName ifTrue: assocBlock) ifTrue: [^true]].	assoc _ Smalltalk associationAt: varName ifAbsent: [].	assoc == nil		ifFalse: 			[assocBlock value: assoc.			^true].	^false!whichClassIncludesSelector: aSymbol 	"Answer the class on the receiver's superclass chain where the argument, aSymbol	(a message selector), will be found."	(methodDict includesKey: aSymbol) ifTrue: [^self].	superclass == nil ifTrue: [^nil].	^superclass whichClassIncludesSelector: aSymbol	"Rectangle whichClassIncludesSelector: #inspect."!whichSelectorsAccess: instVarName 	"Answer a set of selectors whose methods access the argument, instVarName,	as a named instance variable."	| instVarIndex |	instVarIndex _ self allInstVarNames indexOf: instVarName ifAbsent: [^Set new].	^methodDict keys select: 		[:sel | 		((methodDict at: sel)			readsField: instVarIndex)			or: [(methodDict at: sel) writesField: instVarIndex]]	"Point whichSelectorsAccess: 'x'."!whichSelectorsReferTo: literal	"Answer a collection of selectors whose methods	access the argument as a literal."	^methodDict whichSelectorsReferTo: literal	"Rectangle whichSelectorsReferTo: #+."! !!Behavior methodsFor: 'compiling'!compile: code notifying: requestor	"Compile  the argument, code, as source code in the context of the 	receiver.  Use the default fail code [^nil].  Does not save source code. 	The second argument, requestor, is to be notified if an error occurs. The	argument code is either a string or an object that converts to a string or a	PositionableStream on an object that converts to a string."	^self compile: code notifying: requestor ifFail: [^nil]!compile: code notifying: requestor ifFail: failBlock 	"Compile the argument, code, as source code in the context of the receiver and	install the result in the receiver's method dictionary.  The argument requestor is to  	be notified if an error occurs. The argument code is either a string or an 	object that converts to a string or a PositionableStream on an object that   	converts to a string.  This method does not save the source code. 	Evaluate the failBlock if the compilation does not succeed."	| methodNode selector |	methodNode _ self compilerClass new				compile: code				in: self				notifying: requestor				ifFail: failBlock.	selector _ methodNode selector.	self addSelector: selector withMethod: methodNode generate.	^selector!compileAll	"Compile all the methods in the receiver's method dictionary."	^ self compileAllFrom: self!compileAllFrom: oldClass	"Compile all the methods in oldClass's method dictionary.	See recompile:from: regarding oldClass, which is normally just self."	self selectors do: [:sel | self recompile: sel from: oldClass]!compileAllFrom: oldClass into: third	"Compile all the methods in oldClass's method dictionary.	See recompile:from: regarding oldClass, which is normally just self."	self selectors do: [:sel | self recompile: sel from: oldClass into: third]!compileAllSubclasses	"Compile all the methods in the receiver's subclasses.  This does not modify	code (re-install the compiled versions), just compiles the methods as a kind of static	check."	self allSubclasses do: [:aSubclass | aSubclass compileAll]!compilerClass	"Answer a compiler class appropriate for source methods of this class."	^Compiler!decompile: selector 	"Find the compiled code associated with the argument, selector, as a message selector	in the receiver's method dictionary and decompile it.  Answer the resulting source	code as a string.  Create an error if the selector is not in the receiver's method	dictionary."	^self decompilerClass new decompile: selector in: self!decompilerClass	"Answer a decompiler class appropriate for compiled methods of this class."	^Decompiler!evaluatorClass	"Answer an evaluator class appropriate for evaluating expressions in the 	context of instances of this class."	^Compiler!parserClass	"Answer a parser class to use for parsing methods in this class."	^self compilerClass preferredParserClass!poolHas: varName ifTrue: assocBlock 	"Behaviors have no pools."	^false!recompile: selector 	"Recompile the method associated with selector in the receiver's method dictionary.	Take care not to write out any new source code - just generate new bytes."	^ self recompile: selector from: self!recompile: selector from: oldClass	"Recompile the method associated with selector in the receiver's method dictionary.	Take care not to write out any new source code - just generate new bytes.	oldClass may differ from self in order to decompile right (if sourceFiles == nil)	when adding or removing fields of a class."	| method sourceFile sourcePosition methodNode |	method _ oldClass compiledMethodAt: selector.	method hasSource ifTrue:		[sourceFile _ method fileIndex.		sourcePosition _ method filePosition].	methodNode _ self compilerClass new				compile: (oldClass sourceCodeAt: selector)				in: self				notifying: nil				ifFail: [].	methodNode == nil  "Try again after proceed from SyntaxError"		ifTrue: [^self recompile: selector].	selector == methodNode selector ifFalse: [self error: 'selector changed!!'].	method _ methodNode generate.	sourceFile notNil ifTrue:		[method setSourcePosition: sourcePosition inFile: sourceFile].	self addSelector: selector withMethod: method!recompile: selector from: oldClass into: third	"Recompile the method associated with selector in the receiver's method dictionary.	Take care not to write out any new source code - just generate new bytes.	oldClass may differ from self in order to decompile right (if sourceFiles == nil)	when adding or removing fields of a class."	| method sourceFile sourcePosition methodNode |	method _ oldClass compiledMethodAt: selector.	method hasSource ifTrue:		[sourceFile _ method fileIndex.		sourcePosition _ method filePosition].	methodNode _ self compilerClass new				targetClass: third;				compile: (oldClass sourceCodeAt: selector)				in: self				notifying: nil				ifFail: [].	methodNode == nil  "Try again after proceed from SyntaxError"		ifTrue: [^self recompile: selector].	selector == methodNode selector ifFalse: [self error: 'selector changed!!'].	method _ methodNode generate.	sourceFile notNil ifTrue:		[method setSourcePosition: sourcePosition inFile: sourceFile].	self addSelector: selector withMethod: method!sourceCodeTemplate	"Answer an expression to be edited and evaluated in order to	define methods in this class."	^'message selector and argument names	"comment stating purpose of message"	| temporary variable names |	statements'!subclassDefinerClass	"Answer an evaluator class appropriate for evaluating definitions of new 	subclasses of this class."	^Compiler! !!Behavior methodsFor: 'enumerating'!allAccessesTo: instVarName 	"Answer a list of all methods in the receiver's hierarchy that refer to the named instance variable."	| coll |	coll _ OrderedCollection new.	Cursor execute 		showWhile: 			[(self withAllSuperclasses reverse) , self allSubclasses do:				[:class | 				(class whichSelectorsAccess: instVarName) do: 					[:sel | sel ~~ #DoIt ifTrue: [coll add: class name , ' ' , sel]]]].	^coll	"Collection allAccessesTo: 'contents'."!allCallsOn: aLiteral	"Answer a SortedCollection of all the methods	in this class or any subclass that call on aLiteral."	| set |	self == Object ifTrue: [^Smalltalk allCallsOn: aLiteral].	set _ Set new.	self withAllSuperclasses reverse , self allSubclasses do:		[:class | 		(class whichSelectorsReferTo: aLiteral)			do: [:sel | sel ~~ #DoIt ifTrue: [set add: class name , ' ' , sel]].		(class class whichSelectorsReferTo: aLiteral)			do: [:sel | sel ~~ #DoIt ifTrue: [set add: class class name , ' ' , sel]]].	^set asSortedCollection!allInstancesDo: aBlock 	"Evaluate the argument, aBlock, for each of the current instances of the receiver."	| inst next all |	inst _ self someInstance.	all _ IdentitySet new.	inst == nil		ifFalse: 			[[next _ inst nextInstance.			all add: inst.			next == nil]				whileFalse: [inst _ next]].	nil class == self ifTrue: [aBlock value: nil].	all do:		[ :i |	aBlock value: i.	].!allSubclassesDo: aBlock 	"Evaluate the argument, aBlock, for each of the receiver's subclasses."	self subclasses do: 		[:cl | 		aBlock value: cl.		cl allSubclassesDo: aBlock]!allSubInstancesDo: aBlock 	"Evaluate the argument, aBlock, for each of the current instances of the receiver's	subclasses."	self allSubclassesDo: [:sub | sub allInstancesDo: aBlock]!browseAllAccessesTo: instanceVariable 	"Create and schedule a Message Set browser for all the receiver's 	methods or any methods of a subclass that refer to the instance 	variable name. If the instance variable name is not defined for the 	receiver, the notification 'Nobody' occurs in the System Transcript."	BrowserView		openListBrowserOn: (self allAccessesTo: instanceVariable)		label: instanceVariable		initialSelection: instanceVariable!browseAllCallsOn: aSymbol 	"Create and schedule a message browser on each method that calls on aSymbol."	"For example,		Number browseAllCallsOn: #/.	"	| label key |	(aSymbol isMemberOf: Association)		ifTrue: [key _ aSymbol key. 	label _ 'Users of ' , key]		ifFalse: [key _ aSymbol. 		label _ 'Senders of ', key].	^ BrowserView		openListBrowserOn: (self allCallsOn: aSymbol)		label: label, ' from ', self name		initialSelection: key asSymbol keywords first!crossReference	"Answer an array of arrays of size 2 whose first element is a message selector	in the receiver's method dictionary and whose second element is a set of all message	selectors in the method dictionary whose methods send a message with that selector.	Subclasses are not included."	^self selectors asSortedCollection asArray collect:		[:x | 		Array 			with: (String with: Character cr), x 			with: (self whichSelectorsReferTo: x)]	"Point crossReference."!showVariableMenu: generatorBlock collect: valueBlock	"Construct a menu of variable names supplied by the generatorBlock,	with lines between classes in the superclass chain.  Show the menu,	returning the variable chosen by the user, or nil if no	variable was chosen."	| aStream lines count lastLine variables index |	aStream _ WriteStream on: (String new: 200).	lines _ OrderedCollection new.	count _ 0.	lastLine _ 0.	variables _ OrderedCollection new.	self withAllSuperclasses reverseDo:		[:eachClass |		count = lastLine ifFalse: [lines add: count.  lastLine _ count].		(generatorBlock value: eachClass) do:			[:var |			aStream nextPutAll: ((valueBlock value: var) contractTo: 20); cr.			variables addLast: var.			count _ count + 1]].	variables isEmpty ifTrue: [^nil].  "Nothing to choose from"	aStream skip: -1.	index _ (PopUpMenu labels: aStream contents lines: lines) startUp.	^index = 0		ifTrue: [nil]		ifFalse: [variables at: index]! !!Behavior methodsFor: 'fileIn/Out'!printMethodChunk: selector on: aFileStream moveSource: moveSource toFile: fileIndex	"Print the source code for the method associated with the argument selector onto	the fileStream. aFileStream, and, for backup, if the argument moveSource (a Boolean)	is true, also set the file index within the method to be the argument fileIndex."	| position |	aFileStream cr; cr.	moveSource ifTrue: [position _ aFileStream position].	aFileStream nextChunkPut: (self sourceMethodAt: selector) asString.	moveSource 		ifTrue: [(self compiledMethodAt: selector)					setSourcePosition: position inFile: fileIndex]! !!Behavior methodsFor: 'private'!accumulateInstVarNames: names	"accumulate instance variable names in 'names'.  Do this in depth-first,	  left-to-right order.  This will give the ordering of instance variable names	  expected by the compiler and other parts of the system."	superclass == nil		ifFalse:	[superclass accumulateInstVarNames: names].	names addAll: self instVarNames.!copyMethodDictionary	methodDict _ methodDict copy!defaultSelectorForMethod: aMethod 	"Given a method, invent an appropriate selector, that is, one that will parse with	the correct number of arguments."	| aStream |	aStream _ WriteStream on: (String new: 16).	aStream nextPutAll: 'unboundMethod'.	1 to: aMethod numArgs do: [:i | aStream nextPutAll: 'with:'].	^aStream contents asSymbol!flushVMmethodCache	"Tell the interpreter to remove the contents of its method lookup cache, if it has 	one.  Essential.  See Object documentation whatIsAPrimitive."	<primitive: 89>	self primitiveFailed!flushVMmethodCacheEntriesFor: selector 	"Tell the interpreter to remove from its method lookup cache (if any) 	all entries affected by adding, changing, or removing a definition 	for this selector in the receiver. Optional. 	See Object documentation whatIsAPrimitive."	<primitive: 522>	"If we can't do a selective flush, flush the entire cache."	self flushVMmethodCache!printSubclassesOn: aStream level: level 	"As part of the algorithm for printing a description of the receiver, print the	subclass on the file stream, aStream, indenting level times."	| subs |	aStream crtab: level.	aStream nextPutAll: self name.	aStream space; print: self instVarNames.	subs _ self subclasses.	self == Class ifTrue:		[aStream crtab: level+1; nextPutAll: '... all the Metaclasses ...'.		subs _ subs reject: [:sub | sub isMeta]].	"Print subclasses in alphabetical order"	(subs asSortedCollection: [:x :y | x name < y name]) do:		[:sub |		sub printSubclassesOn: aStream level: level + 1]!removeSelectorSimply: selector 	"Remove the message selector from the receiver's method dictionary.	Internal access from compiler."	methodDict removeKey: selector ifAbsent: [^self].	self flushVMmethodCacheEntriesFor: selector!setInstanceFormat: sizeAndFlags 	"Set the format for the receiver (a Class)."	format _ sizeAndFlags!sourceTextAt: selector 	"Answer with the string of the source code for the message selector."	| newSource method |	method _ methodDict at: selector.	Sensor leftShiftDown		ifTrue: [newSource _ 					self decompilerClass new						decompile: selector						in: self						method: method]		ifFalse: 			[newSource _ method getSource.			newSource == nil 				ifTrue: [newSource _ 							self decompilerClass new								decompile: selector								in: self								method: method]].	^newSource asText! !Model subclass: #BinaryChoice	instanceVariableNames: 'trueAction falseAction actionTaken '	classVariableNames: ''	poolDictionaries: ''	category: 'Interface-Prompt/Confirm'!BinaryChoice comment:'Class BinaryChoice represents a true/false (yes/no) choice.  Its instances have two possible actions they can take, depending on which choice is made.Instance variables	trueAction		<BlockClosure>	sequence of expression to do if positive choice is made	falseAction		<BlockClosure>	sequence of expression to do if negative choice is made	actionTaken	<Boolean> was the action, true or false, already taken '!!BinaryChoice methodsFor: 'initialize-release'!falseAction: aBlock	"The argument, aBlock, will be evaluated if the receiver is sent the	message selectFalse."	falseAction _ aBlock!initialize	"Initialize the receiver so that it indicates no action has yet been taken."	actionTaken _ false!trueAction: aBlock	"The argument, aBlock, will be evaluated if the receiver is sent the	message selectTrue."	trueAction _ aBlock! !!BinaryChoice methodsFor: 'menu messages'!selectFalse	"Take the action, if one, associated with selecting no or false."		actionTaken _ true.	falseAction notNil ifTrue: [falseAction value]!selectTrue	"Take the action, if one, associated with selecting yes or true."		actionTaken _ true.	trueAction notNil ifTrue: [trueAction value]! !!BinaryChoice methodsFor: 'accessing'!actionTaken	"Answer whether the receiver has carried out its actions yet."	^actionTaken!active	"Answer whether the receiver is an active system view."	^false! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!BinaryChoice class	instanceVariableNames: ''!!BinaryChoice class methodsFor: 'instance creation'!message: messageString 	"Answer an instance of the receiver whose question is messageString.  If the user	answer is yes, then return true.  If the user answer is no, return false.  	Display the view of the instance at the cursor location."	| answer |	self		message: messageString		displayAt: Sensor cursorPoint		centered: true		ifTrue: [answer _ true]		ifFalse: [answer _ false].	^answer!message: messageString displayAt: aPoint centered: centered ifTrue: trueAlternative ifFalse: falseAlternative	"Answer an instance of the receiver whose question is messageString.  If the user	answer is yes, then evaluate trueAlternative.  If the user answer is no,	evaluate falseAlternative. If centered, a Boolean, is false, display the view of the	instance at aPoint; otherwise display it with its center at aPoint."	| newChoice |	newChoice _ self new initialize.	newChoice trueAction: trueAlternative.	newChoice falseAction: falseAlternative.	BinaryChoiceView openOn: newChoice message: messageString displayAt: aPoint centered: centered!message: messageString displayAt: originPoint ifFalse: falseAlternative 	"Answer an instance of the receiver whose question is messageString.  If the user	answer is yes, then do nothing.  If the user answer is no, evaluate falseAlternative. 	Display the view of the instance at originPoint."	^self		message: messageString		displayAt: originPoint		centered: false		ifTrue: nil		ifFalse: falseAlternative!message: messageString displayAt: originPoint ifTrue: trueAlternative 	"Answer an instance of the receiver whose question is messageString.  If the user	answer is yes, then evaluate trueAlternative.  If the user answer is no,	do nothing.  Display the view of the instance at originPoint."	^self		message: messageString		displayAt: originPoint		centered: false		ifTrue: trueAlternative		ifFalse: nil!message: messageString displayAt: originPoint ifTrue: trueAlternative ifFalse: falseAlternative 	"Answer an instance of the receiver whose question is messageString.  If the user	answer is yes, then evaluate trueAlternative.  If the user answer is no,	evaluate falseAlternative.  Display the view of the instance at originPoint."	^self		message: messageString		displayAt: originPoint		centered: false		ifTrue: trueAlternative		ifFalse: falseAlternative! !!BinaryChoice class methodsFor: 'examples'!example	"Shows an example of a binary choice.  Press any mouse	button.  The binary choice view will appear at the cursor	location."	"BinaryChoice example."	BinaryChoice		message: 'Are you happy?' 		displayAt: Sensor waitButton 		centered: true		ifTrue: [Transcript cr; show: 'happy'] 		ifFalse: [Transcript cr; show: 'not happy']! !Controller subclass: #BinaryChoiceController	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Interface-Prompt/Confirm'!BinaryChoiceController comment:'Instances of class BinaryChoiceController assume that their model can carry out some action only once--that is, make a selection only once.  Control is given up if the model responds true to the message actionTaken.'!!BinaryChoiceController methodsFor: 'control defaults'!isControlActive	model actionTaken ifTrue: [^false].	[super isControlActive] whileFalse: [view flash].	^true! !!BinaryChoiceController methodsFor: 'basic control sequence'!startUp	Cursor normal showWhile: [super startUp]! !!BinaryChoiceController methodsFor: 'cursor'!centerCursorInView	"Position sensor's mousePoint (which is assumed to be connected to the 	cursor) to the center of its view's inset display box (see Sensor|mousePoint: and 	View|insetDisplayBox)."	| lowestSubView subViews |	subViews_ view subViews.	subViews isEmpty		ifFalse:	[lowestSubView _ subViews at: 1.				subViews do:					[:subView |						(subView insetDisplayBox top >							lowestSubView insetDisplayBox top)						ifTrue:	[lowestSubView _ subView]].				^lowestSubView controller centerCursorInView].	^super centerCursorInView! !View subclass: #BinaryChoiceView	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Interface-Menus'!BinaryChoiceView comment:'A BinaryChoiceView is a view of a BinaryChoice.  It displays a question and two switches, yes and no, indicating choices the user can make.'!!BinaryChoiceView methodsFor: 'controller access'!defaultControllerClass	^BinaryChoiceController! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!BinaryChoiceView class	instanceVariableNames: ''!!BinaryChoiceView class methodsFor: 'instance creation'!openOn: aBinaryChoice message: messageString displayAt: originPoint centered: centered	"Answer an instance of me that displays aBinaryChoice asking the question	messageString.  If the argument centered, a Boolean, is false, display the instance	with top left corner at originPoint;  otherwise, display it with its center at	originPoint.  If necessary, translate so the view is completely on the screen.	Do not schedule, rather take control immediately and insist that the user respond."	| topView messageView switchView savedArea |	messageView _ DisplayTextView new editParagraph: messageString asParagraph.	messageView insideColor: Form white.	messageView controller: NoController new.	messageView centered.	switchView _ 		self buildSwitchesFor: aBinaryChoice width: messageView window width.	topView _ self new model: aBinaryChoice.	topView addSubView: messageView.	topView addSubView: switchView below: messageView.	topView		align: (centered				ifTrue: [switchView viewport center]				ifFalse: [topView viewport topLeft])		with: originPoint.	topView borderWidth: 2.	topView translateBy:		(topView displayBox amountToTranslateWithin: Display boundingBox).	topView insideColor: Form white.	savedArea _ Form fromDisplay: topView displayBox.	topView display.	topView controller startUp.	topView release.	savedArea displayOn: Display at: topView viewport topLeft! !!BinaryChoiceView class methodsFor: 'private'!buildSwitchesFor: aBinaryChoice	width: anInteger	|switchView yesSwitchView noSwitchView|	switchView _ View new model: aBinaryChoice.	switchView controller: BinaryChoiceController new.	yesSwitchView _ SwitchView new model: aBinaryChoice.	yesSwitchView borderWidthLeft: 0 right: 2 top: 0 bottom: 0.	yesSwitchView selector: #active.	yesSwitchView controller selector: #selectTrue.	yesSwitchView controller cursor: Cursor thumbsUp.	yesSwitchView label: 'yes' asParagraph.	yesSwitchView window: (0@0 extent: anInteger//2 @ yesSwitchView window height).	noSwitchView _ SwitchView new model: aBinaryChoice.	noSwitchView selector: #active.	noSwitchView controller selector: #selectFalse.	noSwitchView controller cursor: Cursor thumbsDown.	noSwitchView label: 'no' asParagraph.	noSwitchView window: (0@0 extent: anInteger//2 @ noSwitchView window height).	switchView addSubView: yesSwitchView.	switchView addSubView: noSwitchView toRightOf: yesSwitchView.	switchView borderWidthLeft: 0 right: 0 top: 2 bottom: 0.	^switchView! !Stream subclass: #BinaryStorage	instanceVariableNames: 'policy objects stream lastId '	classVariableNames: 'BinaryErrorSignal FalseTag FloatTag FormatErrorSignal HeaderErrorSignal NegateTag NilTag OpCharacter OpcodeMask OpcodeShift OperandMask OpId OpInteger OpPolicy OpPrefix OpString OpSymbol OpTag SendTag TrueTag '	poolDictionaries: ''	category: 'System-Binary Storage'!BinaryStorage comment:'Class BinaryStorage represents the storage of object structures in binary on a data stream for subsequent reloading, or read in such objects.  Objects to be written fall into two categories: ''manifest'' objects, for which only the contents or value matter, and other objects, for which the object identity matters as well.To write an object, the BinaryStorage sends the message	anObject storeBinaryOn: aBinaryStorageanObject must write itself out using only the public message (store:) and the primitive value-writing messages in the category ''storing-objects''.  In particular, the implementation of this message in non-manifest objects must begin with	aBinaryStorage storeRecordOfClass: self classso that the class of the object is recorded properly on the stream.When reading, the BinaryStorage treats manifest and other objects differently.  The algorithms for reading manifest objects are built in.  (It is obviously necessary to keep these algorithms consistent with the scattered implementations of storeBinaryOn: in the manifest object classes, but we don''t know how to put the algorithms in just one place for the purpose of doing this.)  For other objects, the object''s class is sent the message	aClass readBinaryFrom: aBinaryStorage tag: idThe implementation of this message must start by creating an object (normally, the object that will be returned as the value of the method) and ''register'' it by sending	aBinaryStorage register: newObject id: idThis is needed in case there are multiple references to the object, or circular references within the object''s contents that point back to the object itself.  The method must then read the contents of the object back using the primitive value-reading messages in the category ''reading-objects'', or the public message nextItem.The foregoing is not the whole story;  see BinaryStoragePolicy for more details.Instance Variables:	policy	<BinaryStoragePolicy>   defines policy for external references 	objects	<IdentityDictionary key: Object value: Integer>   objects with ids 	stream	<Stream>   data stream 	lastId	<Integer>   last id assignedClass Variables:	BinaryErrorSignal	<Signal> BOSS error	FormatErrorSignal	<Signal> Incompatible BOSS file format	HeaderErrorSignal	<Signal> Invalid BOSS file		The following variables are SmallIntegers used to denote various kinds of objects that might be stored.	FalseTag	FloatTag	NegateTag	NilTag	OpCharacter 	OpcodeMask 	OpcodeShift 	OperandMask 	OpId 		OpInteger	OpPolicy	OpPrefix	OpString	OpSymbol	OpTag	SendTag	TrueTag Implementation notes-------------------The private encode/decode messages define the storage representation for the four kinds of primitive objects (tags, integers, strings, and byte arrays): all other storing and reading messages are ultimately defined using encode/decode.'!!BinaryStorage methodsFor: 'initialize-release'!close	"Close the stream that the receiver is accessing."	stream close!initialize	"Initialize the receiver so that it has a new standard binary storage 	policy and its variables are property initialized."	policy _ StandardBSPolicy new.	self initializeObjects!on: aStream 	"Create a new instance of the receiver on aStream, making sure 	that this stream can handle binary reading and writing."	(aStream class canUnderstand: #binary)		ifTrue: [aStream binary].	stream _ aStream.	self initialize! !!BinaryStorage methodsFor: 'stream writing'!nextPut: object	"Put a binary representation of object into the receiver."	| objectId | 	object isManifest 		ifTrue: [object storeBinaryOn: self]		ifFalse:			[(objectId _ objects at: object ifAbsent: [nil]) == nil				ifTrue:					[objects at: object put: (lastId _ lastId + 1).					policy storeNew: object on: self]				ifFalse: [self encodeId: objectId]]!nextPutClasses: classes 	"Store a collection of classes. The semantics are equivalent to 	fileOut, i.e., only the code is written, not the values of the class 	variables or class instance variables."	"This message is inappropriate for a 	runtime environment, since it relies on 	the SystemOrganization being present."	| classSet |	self nextPut: classes size.	classSet _ IdentitySet new: classes size * 2.	classSet addAll: classes.	classes do: [:c | "for fast membership check"		"each class will be removed from classSet as it is stored"		self storeClass: c from: classSet]!print: object 	"Create an error indicating that this request to store text is not 	possible."	self error: 'BOSS streams do not store text'!store: object 	"Create an error indicating that this request to store text is not 	possible."	self error: 'BOSS streams do not store text'! !!BinaryStorage methodsFor: 'storing-policy'!nextPTagPut: pTag	"Store a policy tag. "	self encodeOpcode: OpPolicy operand: pTag! !!BinaryStorage methodsFor: 'storing-objects'!inClass: aClass do: aBlock	"Evaluate aBlock with the local naming	environment bound to that of aClass. "	^policy inClass: aClass do: aBlock!storeBoolean: bool	self encodeTag:		(bool 			ifTrue: [TrueTag]			ifFalse: [FalseTag])!storeBytes: byteObject	self encodeBytes: byteObject!storeCharacter: char	self encodeOpcode: OpCharacter operand: char asInteger!storeFloat: aFloat	| m f e zeros |	" We encode Floats in a canonical form	that is independent of internal representation. "	self encodeTag: FloatTag.	f _ aFloat.	f = 0.0		ifTrue: [e _ 0. m _ 0]		ifFalse:			[" Reduce f to an integer.			We can make a good guess at how many			significant bits it has, but we might be wrong			if f is a multi-precision Float. "			" The invariant below is that aFloat =			f (later m) timesTwoPower: e negated. "			e _ 23 - f exponent.			f _ f timesTwoPower: e.			[f fractionPart = 0.0]				whileFalse:					[e _ e + 8.					f _ f timesTwoPower: 8].			" Now remove trailing zeros.			(m bitAnd: m negated) is a trick to isolate			the least significant bit in m. "			m _ f truncated.			zeros _ (m bitAnd: m negated) highBit - 1.			e _ e - zeros.			m _ m bitShift: zeros negated].	self nextPut: e; nextPut: m!storeInteger: integer	integer < 0		ifTrue: [self encodeTag: NegateTag; storeInteger: integer negated]		ifFalse: [self encodeOpcode: OpInteger operand: integer]!storeNil	self encodeTag: NilTag!storeOther: anObject	" Store an object with no special syntax "	policy storeOther: anObject on: self!storeRecordOfClass: class	policy storeRecordOfClass: class on: self!storeSend: aMessageSend	self encodeTag: SendTag.	aMessageSend storeForExecutionOn: self!storeString: string	self encodeString: string opcode: OpString!storeSymbol: symbol	self encodeString: symbol opcode: OpSymbol! !!BinaryStorage methodsFor: 'stream reading'!atEnd	"Answer whether the receiver's input stream reached its end."	^stream atEnd!contents	"Answer the current contents of the receiver's input stream."	| cont |	cont _ (Array new: 20) writeStream.	[stream atEnd] whileFalse: [cont nextPut: self next].	^cont contents!next	"Answer the next object in the input stream."	| byte op operand |	byte _ self decodeOpByte.	op _ byte bitAnd: OpcodeMask.	operand _ byte bitAnd: OperandMask.	[op = OpPrefix]		whileTrue:			[" Accumulate operand prefixes "			byte _ self decodeOpByte.			op _ byte bitAnd: OpcodeMask.			operand _ (operand bitShift: OpcodeShift) +				(byte bitAnd: OperandMask)].	op = OpTag		ifFalse:			[	" Handle policy tags "			op = OpPolicy		ifTrue: [^policy nextWithTag: operand from: self].				" Handle special references "			op = OpId			ifTrue: [^objects at: operand].				" Handle registered (non-manifest) objects "			op = OpString		ifTrue: [^self register: (self decodeString: operand)].			op = OpSymbol		ifTrue: [^self register: (self decodeString: operand) asSymbol].				" Handle manifest objects "			op = OpInteger		ifTrue: [^operand].			op = OpCharacter	ifTrue: [^Character value: operand].			self error: 'Unknown BOSS opcode'.			^nil].		" Handle special kinds of references "	operand = SendTag			ifTrue: [^self nextSend].		" Handle manifest objects "	operand = NegateTag		ifTrue: [^self next "(integer)" negated].	operand = NilTag			ifTrue: [^nil].	operand = TrueTag			ifTrue: [^true].	operand = FalseTag			ifTrue: [^false].	operand = FloatTag			ifTrue:			[| expt mant |			expt _ self next.  mant _ self next.			^mant asFloat timesTwoPower: expt negated].	self error: 'Unknown BOSS tag'.	^nil!nextClasses	"Read a collection of classes. The semantics are equivalent to fileIn, 	i.e., we only read the code and declarations, not the values of class 	variables or class instance variables."	| count allClasses |	count _ self next.	allClasses _ OrderedCollection new: count.	1 to: count do: 		[:i | 		| c |		c _ self next.		c readBinaryContentsFrom: self."class creation expression"		c class instanceVariableNames: self next."Now do the metaclass."		c class readBinaryContentsFrom: self.		allClasses addLast: c].	^allClasses! !!BinaryStorage methodsFor: 'reading-objects'!assignId	"Assign and answer the next sequential object id."	^lastId _ lastId + 1!readBytes: byteClass size: size	^self decodeBytes: byteClass size: size!register: anObject id: objId	"Associate anObject with the key identification objId."	objects at: objId put: anObject! !!BinaryStorage methodsFor: 'state accessing'!currentState	"Answer the last assigned localId. This provides a primitive form of 	checkpointing, so that one can preload a BinaryStorage with a set 	of objects whose localIds can be available when storing many 	different objects subsequently."	^lastId!currentState: id	"Set the last assigned localId. This has the effect of 	rolling back the localId table to a checkpoint."	id <= lastId		ifFalse:			[^self error: 'Invalid lastId'].	id = lastId ifTrue: [^self].	id < 0		ifTrue: [self initializeObjects]		ifFalse:			[| keep |			keep _ IdentityDictionary new: (id * 2 max: 256).			objects associationsDo:				[:assoc | assoc value <= id ifTrue:					[keep add: assoc]].			objects _ keep].	lastId _ id! !!BinaryStorage methodsFor: 'private'!checkHeader	| check format char |	check _ self decodeString: 5.	check = 'BOSS ' ifFalse: [HeaderErrorSignal raise].	format _ 0.	[(char _ (self decodeString: 1) first) isDigit]		whileTrue:			[format _ format * 10 + char digitValue].	char = Character space ifFalse: [HeaderErrorSignal raise].	format = self streamFormatNumber ifFalse: [FormatErrorSignal raiseWith: format]!initializeObjects	lastId _ -1.  "first actual id is 0"	objects _ IdentityDictionary new: 256!writeHeader	self encodeString: 'BOSS ' , self streamFormatNumber printString , ' '! !!BinaryStorage methodsFor: 'private-storing'!encodeId: objId	self encodeOpcode: OpId operand: objId!encodeOpcode: op operand: int	" Encode an opcode, with an associated	non-negative integer operand.	Use as many prefix bytes as necessary. "	int > OperandMask		ifTrue:			[self encodeOpcode: OpPrefix operand: (int bitShift: OpcodeShift negated)].	self encodeOpByte: op + (int bitAnd: OperandMask)!encodeString: aString opcode: op	" Store a string or symbol. "	self encodeOpcode: op operand: aString size.	self encodeString: aString!encodeTag: tagValue	self encodeOpcode: OpTag operand: tagValue!storeClass: c from: classes	" Store a class from a collection of classes.	Make sure the superclasses get stored first. "	| kind |	c isNil ifTrue: [^self].  "reached top of hierarchy"	self storeClass: c superclass from: classes.	(classes includes: c) ifFalse: [^self].  "not in set"	classes remove: c.	self encodeTag: SendTag.	self nextPut: c superclass.	kind _ c kindOfSubclass.	kind _ kind copyFrom: 2 to: kind size - 1.  "HACK because kind includes leading and trailing blanks!!"	self nextPut: (kind , 'instanceVariableNames:classVariableNames:poolDictionaries:category:') asSymbol.	self nextPut: 5.  "# of args"	self nextPut: c name.	self nextPut: c instanceVariablesString.	self nextPut: c classVariablesString.		self nextPut: c sharedPoolsString.	self nextPut: (SystemOrganization categoryOfElement: c name) asString.	c storeBinaryContentsOn: self.	" Now do the metaclass. "	self nextPut: c class instanceVariablesString.	c class storeBinaryContentsOn: self! !!BinaryStorage methodsFor: 'private-reading'!nextSend	| rcvr selector numArgs |	rcvr _ self next.	selector _ self next.  "Symbol"	numArgs _ self next.  "Integer"	numArgs = 0 ifTrue: [^rcvr perform: selector].	numArgs = 1 ifTrue: [^rcvr perform: selector with: self next].	numArgs = 2 ifTrue:		[| arg1 |		arg1 _ self next.		^rcvr perform: selector with: arg1 with: self next].	^rcvr perform: selector withArguments: ((1 to: numArgs) collect: [:i | self next])!register: anObject	objects at: self assignId put: anObject.	^anObject! !!BinaryStorage methodsFor: 'private-encoding'!encodeBytes: bytes	" Append the bytes to the output. "	stream nextPutAll: bytes!encodeOpByte: byte	" Append an opcode/operand to the output. "	stream nextPut: byte!encodeString: aByteString	" Append the characters of	aByteString to the output. "		1 to: aByteString size do: [:i |		stream nextPut: (aByteString at: i) asInteger]! !!BinaryStorage methodsFor: 'private-decoding'!decodeBytes: bytesClass size: size	| bytes |	bytesClass == ByteArray		ifTrue: [^stream next: size].	bytes _ bytesClass new: size.	1 to: bytes size do: [:i | bytes at: i put: stream next].	^bytes!decodeOpByte	" Answer the next opcode/operand	byte from the stream. "	^stream next!decodeString: size	" Read and answer a String	of the given size. "	| aString |	aString _ String new: size.	1 to: size do: [:i | aString at: i put: (Character value: stream next)].	^aString! !!BinaryStorage methodsFor: 'private-constants'!streamFormatNumber	" Answer the format number supported by this	version of this class. "	^5! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!BinaryStorage class	instanceVariableNames: ''!!BinaryStorage class methodsFor: 'class initialization'!initialize	"BinaryStorage initialize"	self initializeTags.	self initializeSignals!initializeSignals	"BinaryStorage initializeSignals"	BinaryErrorSignal _ Object errorSignal newSignalMayProceed: false.	BinaryErrorSignal		nameClass: self message: #errorSignal;		notifierString: 'BOSS error'.	HeaderErrorSignal _ BinaryErrorSignal newSignal.	HeaderErrorSignal		nameClass: self message: #headerErrorSignal;		notifierString: 'Invalid BOSS file'.	FormatErrorSignal _ BinaryErrorSignal newSignal.	FormatErrorSignal		nameClass: self message: #formatErrorSignal;		notifierString: 'Incompatible BOSS file format'.!initializeTags	"BinaryStorage initializeTags"	OpcodeMask _ 2r11100000.	OperandMask _ 2r00011111.	OpcodeShift _ 5.	OpPrefix _ 0 bitShift: OpcodeShift.	OpId _ 1 bitShift: OpcodeShift.	OpCharacter _ 2 bitShift: OpcodeShift.	OpInteger _ 3 bitShift: OpcodeShift.	OpString _ 4 bitShift: OpcodeShift.	OpSymbol _ 5 bitShift: OpcodeShift.	OpPolicy _ 6 bitShift: OpcodeShift.	OpTag _ 7 bitShift: OpcodeShift.	SendTag _ 0.	NegateTag _ 1.	NilTag _ 2.	TrueTag _ 3.	FalseTag _ 4.	FloatTag _ 5! !!BinaryStorage class methodsFor: 'instance creation'!read: aStream	"Create a new instance of the receiver by reading from aStream."	^self basicNew on: aStream; checkHeader!write: aStream	"Write a description of the receiver on aStream."	^self basicNew on: aStream; writeHeader! !!BinaryStorage class methodsFor: 'convenience messages'!classesFrom: aStream 	"Answer a list of classes that have been stored on the stream. The 	stream should be positioned before the BOSS format header, and the 	classes stored in the format used by #putClasses:"	^(self read: aStream) nextClasses!classesFromFileNamed: aFileName 	"Answer a list of classes that have been stored on a file whose 	name is passed as the argument. The classes should have been 	stored in the format used by #putClasses:"	| storage classes |	storage _ self read: aFileName asFilename readStream.	[classes _ storage nextClasses]		valueNowOrOnUnwindDo: [storage close].	^classes!from: aStream 	"Answer the next object on the stream. The object must be 	immediately preceded by a BOSS format header"	^(self read: aStream) next!fromFileNamed: aFileName	"Answer the first object in the BOSS file"	| storage object |	storage _ self read: aFileName asFilename readStream.	[object _ storage next]		valueNowOrOnUnwindDo: [storage close].	^object!put: anObject 	"Answer a collection (String or IntegerArray) that represents the 	argument in a 'binary' format that can be used to reconstruct the 	object later"	| storage strm |	storage _ self write: (strm _ (self streamContentsClass new: 100) writeStream).	[storage nextPut: anObject]		valueNowOrOnUnwindDo: [storage close].	^strm contents!put: anObject onFileNamed: aFileName 	"Store the argument onto a file in a 'binary' format that can be used 	to reconstruct the object later"	| storage |	storage _ self write: aFileName asFilename writeStream.	[storage nextPut: anObject]		valueNowOrOnUnwindDo: [storage close].	^storage!putClasses: classes 	"Answer a collection (String or IntegerArray) that represents the list 	of classes in a binary format which may be used to reconstitute 	them later in the same or another image"	| storage strm |	storage _ self write: (strm _ (self streamContentsClass new: 100) writeStream).	[storage nextPutClasses: classes]		valueNowOrOnUnwindDo: [storage close].	^strm contents!putClasses: classes onFileNamed: aFileName 	"Store the list of classes on a file in a binary format which may be 	used to reconstitute them later in the same or another image"	| storage |	storage _ self write: aFileName asFilename writeStream.	[storage nextPutClasses: classes]		valueNowOrOnUnwindDo: [storage close].	^storage! !!BinaryStorage class methodsFor: 'Signal constants'!errorSignal	" Answer the Signal that indicates	a BOSS error. "	^BinaryErrorSignal!formatErrorSignal	" Answer the Signal that indicates	an incompatible BOSS file format. "	^FormatErrorSignal!headerErrorSignal	" Answer the Signal that indicates	an error in the BOSS file header. "	^HeaderErrorSignal! !!BinaryStorage class methodsFor: 'examples'!example1	"BinaryStorage from: BinaryStorage example1 readStream"	^self put: #(15 -3.0 true #halt $a 'eh?' #(1 2 3))!example2	"BinaryStorage from: BinaryStorage example2 first readStream"	^#(example2) collect: [:s | self put: (BinaryStorage class compiledMethodAt: s)]!example3	"BinaryStorage example3"	^self put: BinaryStorage example3Object  "do this way so subclass will work"	"| s | s _ BinaryStorage example3.	MessageTally spyOn: [5 timesRepeat: [BinaryStorage from: s readStream]]"!exampleClasses1	"BinaryStorage exampleClasses1"	^self putClasses: BinaryStorage withAllSubclasses!exampleClasses2	"BinaryStorage exampleClasses2"	^self putClasses: BinaryStorage withAllSubclasses onFileNamed: 't'! !!BinaryStorage class methodsFor: 'documentation'!binaryDataStreamDetails	"A BDS begins with a header.  The header contains a stream format version 	number, used to verify overall representation compatibility.  The stream 	format version is encoded as a string of decimal digits (ASCII characters), for 	maximum independence from particular BOSS representations.	In BOSS 1.0, the atomic types are: Integer, Float, ByteString, ByteSymbol, and 	Character, and the objects nil, true, and false.  The representation of Integers 	and Floats is independent of precision, exponent range, and byte ordering.	The default storage representation of an object is simply its instance 	variables.  The dependents are treated like an instance variable, i.e., they are 	saved with the object even if the object is not a subclass of Model.	As mentioned in (BinaryStorage class)>>storageFormats, the standard policy	records references to classes, global objects, and static variables symbolically.	For compatibility checking, a reference to a class or metaclass contains not 	only the class name, but the complete list of instance variable names, the 	instance format word, and a storage format version (obtained by sending 	the message binaryStorageFormat to the class.) If any of the check parameters 	do not match those obtained from the class when reading, the result is an 	exception.	"	^self error: 'comment only'!convenienceMessages	"The following messages provide for creating a stream or opening a file, 	reading or writing a single net or a collection of classes, and returning the 	stream contents or closing the file:	Storage		''binaryData will be a ByteArray''		binaryData := BinaryStorage put: anObject		binaryData := BinaryStorage putClasses: classCollection		BinaryStorage put: anObject onFileNamed: fileName		BinaryStorage putClasses: classCollection onFileNamed: fileName	Retreival		''binaryData should be an instance of ByteArray''		anObject := BinaryStorage from: binaryData		classCollection := BinaryStorage classesFrom: binaryData		anObject := BinaryStorage fromFileNamed: fileName		classCollection := BinaryStorage classesFromFileNamed: fileName	"	^self error: 'comment only'!creatingABinaryStorage	"BOSS is represented by the class BinaryStorage.  	A new instance of BinaryStorage using dataStream as a data source/sink 	may be obtained by evaluating:		bos := BinaryStorage read: dataStream		bos := BinaryStorage write: dataStream	The dataStream may be an instance of any subclass of Stream that is	readable or writable respectively; specifically, it need not have any encoding	or file-handling protocol.  However, the underlying collection must store binary 	(e.g., ByteArray) as opposed to text (e.g., String) information.	write: writes a header on the dataStream, which read: checks.  This is the 	only distinction between read: and write: - a client may mix reading and 	writing freely if the dataStream is positionable, using the checkpoint facility 	described below.	"	^self error: 'comment only'!encodingAlgorithms	"BOSS uses a single-pass algorithm for both fetching and storing.	When asked to store an object, a binaryStorage simply starts writing out the 	net starting with that object.  In doing so, it assigns a localId to each non-	manifest object it encounters.  (Manifest objects are those whose identity is 	not interesting, specifically: integers, characters, and nil/true/false.)  If it 	encounters a second reference to an object, it writes the localId instead of a 	second copy of the object.	Each time the binaryStorage encounters an object for the first time, it asks 	its policy object to actually write out the object's contents (or a symbolic 	external reference).  If the policy object has no special representation for the 	object, it asks the object to write itself out using the message storeBinaryOn: 	binaryStorage.  Implementations of this message then recursively invoke		stream store: item	to store the components of the receiver.	When reading a net back in, a binaryStorage does exactly the same thing as 	when writing.  In particular, it assigns localIds in the same order.  This 	allows general circular or multiple references without the need to write 	explicit ids on the BDS.	"	^self error: 'comment only'!protocolsForBinaryStreams	"Encoding is done principally through storeBinaryOn: stream instance-side methods.	Decoding is done principally through readBinaryFrom: stream class-side methods.	All atomic classes provide these methods.  Object provides a default by 	simply forwarding the message to the stream (stream storeOther: self.)  In 	turn, the stream forwards the message to the policy (policy storeOther: 	anObject on: stream.)  The standard policy uses concrete (instance variable) 	representations in a straightforward way.   Various collection classes have 	more abstract representations, specifically those having hash invariants.	"	^self error: 'comment only'!storageAndRetreival	"The protocol of BinaryStorage is a subset of Stream protocol.  Specifically, 	BinaryStorage understands the messages		atEnd, contents, next, nextPut:	and messages implemented in terms of them, such as nextPutAll:.  BinaryStorage	specifically does not understand the character-oriented messages such as	print: and store:, since each item in the stream is an arbitrary network of	objects, not a character.	BinaryStorage provides two special messages for reading and writing 	collections of classes:		bos nextPutClasses: classCollection		classCollection := bos nextClasses	nextPutClasses: sorts the classes into superclass order before writing them.  	It writes out the same information as fileOut, i.e., (the equivalent of) the 	class definition, all the method definitions (not including the source code), 	and an initialize expression if appropriate.  Similarly, nextClasses has the 	same effect as fileIn, except that the compiler is not required, and the method 	source code is not loaded.	"	^self error: 'comment only'!storageFormats	"BOSS uses a compact, machine-independent binary data representation, 	called a binary data stream (BDS).  	A BDS consists of a stream of items, each starting with a one-byte tag 	encoding the item's representation, and possibly its class as well.  The space 	of tags is divided into standard tags, recognized by BinaryStorage, and policy 	tags, used and recognized by BinaryStoragePolicy. 	Standard items have three possible forms:		- atom - the object is one of a set of frequently-used, typically-small 			objects deserving an optimized representation: the tag encodes the 			item's class, and possibly its value as well;		- localId - the object is the same as some previously written object in 			the net;		- send - the object is the result of an arbitrary message to be evaluated			at reading time.	Note that there are no composite standard items: in BOSS, the 	representation of composite items is a matter of policy, not mechanism.	The minimal policy adds two more item types:		- record - the object has internal structure, encoded in a sequence of 			items;		- dependents - the following object has dependents, which are stored 			immediately following it.	Finally, the standard policy adds an additional five types:		- class reference - the object is a reference to a class, specified by name;		- metaclass reference - the object is a reference to a metaclass, specified by 			name;		- global variable reference - the object is a reference to the Association for 			a global variable such as the Transcript;		- global object reference - the object is a global object such as the 			Transcript;		- local static reference - the object is a reference to the Association for a 			static variable that is not global (class or pool variable).	"	^self error: 'comment only'!storingMultipleObjectGroups	"A common use of BOSS will be to store many relatively small objects on a 	single file.  Since the overhead of storing checkable descriptions of classes is 	substantial, BOSS provides a mechanism for storing a set of commonly 	referenced objects (such as classes) only once, thereby initializing BOSS' table 	of local object identifiers, and then creating a kind of simple checkpoint.  The 	client can then restore the state to that checkpoint before writing or reading 	individual object structures.  Note that this table is an in-memory object 	structure: it is not actually stored on the file.	To create a checkpoint, execute		savedState := bos currentState	At a later time, to return to the checkpoint, execute		bos currentState: savedState	A typical use of this facility might be the following:		bos := BinaryStorage write: aFileStream.		bos nextPut: wellKnownObjects.		writeState := bos currentState.			...		bos currentState: writeState.		net1Position := aFileStream position.		bos nextPut: net1.			...		bos currentState: writeState.		net2Position := aFileStream position.		bos nextPut: net2.	Then at some later time,		bos := BinaryStorage read: bFileStream.		bos next.  ''preload wellKnownObjects''		readlState := bos currentState.			...		bos currentState: readState.		bFileStream position: net1Position.		net1 := bos next.			...		bos currentState: readState.		bFileStream position: net2Position.		net2 := bos next.	Of course, the client is responsible for remembering net1Position and 	net2Position.	"	^self error: 'comment only'!whatIsAStoragePolicy	"BOSS is implemented by two objects working together.  The BinaryStorage 	provides generic facilities such as encoding and decoding of atomic objects, 	bookkeeping for handling circular or multiple references to objects, and 	parsing of stored objects being read.  Subclasses of BinaryStorage represent 	different choices of how to handle these issues.  The BinaryStoragePolicy 	decides where to 'cut' object nets when storing, by representing selected 	objects by some kind of reference rather than by writing out their contents.  	Subclasses of BinaryStoragePolicy represent different choices about cut 	points and representation of external references.	"	^self error: 'comment only'! !!BinaryStorage class methodsFor: 'private'!streamContentsClass	" Answer the class of the contents	of the stream to be used for writing. "	^ByteArray! !!BinaryStorage class methodsFor: 'private-examples'!example3Object	^methodDict! !BinaryStorage initialize!Object subclass: #BinaryStoragePolicy	instanceVariableNames: ''	classVariableNames: 'DependentPTag RecordPTag '	poolDictionaries: ''	category: 'System-Binary Storage'!BinaryStoragePolicy comment:'A BinaryStoragePolicy represents a set of policies for a BinaryStorage, specifically:	- What objects will be represented externally as symbolic references of some kind, rather than having their contents stored, and how such references are represented (when writing) and resolved (when reading);	- For objects that do have their contents stored, how the container (class) is represented (e.g., whether it includes some kind of version number).The default (abstract) policy represents all objects by their contents.  BinaryStoragePolicy is designed to work closely with BinaryStorage, but it is not allowed to use private messages of BinaryStorage, unless otherwise noted below.Class Variables:	DependentPTag		<SmallInteger>	RecordPTag		<SmallInteger>Implementation notes------------------When BinaryStorage encounters a new object while writing, it assigns a sequence number (id) to the object, and then sends the following message to the policy object:	aBSPolicy storeNew: anObject on: aBStorageThe policy object gets to decide whether to encode the reference to anObject in some special way.  If it decides not to, it simply sends the message	anObject storeBinaryOn: aBStorageThe default implementation of storeBinaryOn: sends the message	aBStorage storeOther: anObjectwhich is forwarded to the policy object as	aBSPolicy storeOther: anObject on: aBStorageOther (class-specific) implementations of storeBinaryOn: will typically begin by sending the BinaryStorage the message	aBStorage storeRecordOfClass: aClassThe BinaryStorage simply forwards this message to the policy object as	aBSPolicy storeRecordOfClass: aClass on: aBStorageAgain, the policy object decides how to encode the class reference.If the policy object wants to use a special encoding for external references or for particular objects, it sends the message	aBStorage nextPTagPut: pTagpTag is a small integer drawn from a separate space of tag values, called policy tags or PTags, that BinaryStorage provides for the policy object.  After putting out the tag, the policy object can write whatever it wants, however only using the public storing message (store:) of BinaryStorage.When a BinaryStorage encounters a policy tag while reading, it simply sends the message	aBSPolicy nextWithTag: pTag from: storageIf this pTag results in creating an object, the BinaryStoragePolicy must make sure to assign it a sequence number by sending the message	objId _ storage assignIdand then, after reading the object,	storage register: theObject id: objIdThis is to make sure that the sequence numbers assigned when reading match the ones assigned when storing.'!!BinaryStoragePolicy methodsFor: 'binding'!inClass: aClass do: aBlock 	"Evaluate aBlock with the naming environment rebound to that of 	aClass. (Since the default policy doesn't care about the naming 	environment, this just evaluates aBlock.)"	^aBlock value! !!BinaryStoragePolicy methodsFor: 'storing'!storeNew: anObject on: storage	"Store (the contents of) a previously unregistered object. "	" The default is to store as a plain vanilla object. "	^self storeVanilla: anObject on: storage!storeOther: anObject on: storage	"This is the default implementation of storeBinaryOn:. "	| bsize |	self storeRecordOfClass: anObject class on: storage.	anObject class isVariable		ifTrue: [storage nextPut: (bsize _ anObject basicSize)]		ifFalse: [bsize _ 0].	1 to: anObject class instSize do:		[:i | storage nextPut: (anObject instVarAt: i)].	1 to: bsize do:		[:i | storage nextPut: (anObject basicAt: i)]!storeRecordOfClass: class on: storage	"Store an indication that the following items are a record of a given class. "	storage nextPTagPut: RecordPTag.	storage nextPut: class! !!BinaryStoragePolicy methodsFor: 'reading'!nextWithTag: pTag from: storage	"Read an item with the given policy tag from the storage stream. "	pTag = RecordPTag		ifTrue: [^self nextRecordFrom: storage].	pTag = DependentPTag		ifTrue: [^self nextDependentFrom: storage].	self error: 'Unknown policy tag'.	^nil! !!BinaryStoragePolicy methodsFor: 'private-storing'!storeVanilla: anObject on: storage	" Store an object that is not an external reference.	Dependents stored in DependentsFields must be treated specially. "	| deps |	deps _ DependentsFields at: anObject ifAbsent: [nil].	deps == nil		ifFalse:			[deps _ anObject dependents.  "dependents are stored specially"			(deps isEmpty not and: [(anObject isKindOf: Model) not])				ifTrue:					[1 to: deps size do: [:i | storage nextPTagPut: DependentPTag]]				ifFalse: [deps _ nil]].	anObject storeBinaryOn: storage.	deps == nil		ifFalse: [deps do: [:d | storage nextPut: d]]! !!BinaryStoragePolicy methodsFor: 'private-tag reading'!nextDependentFrom: storage	| obj |	obj _ storage next.	obj addDependent: storage next.	^obj!nextRecordFrom: storage	| id |	id _ storage assignId.	^storage next		readBinaryFrom: storage		tag: "should be id:" id! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!BinaryStoragePolicy class	instanceVariableNames: ''!!BinaryStoragePolicy class methodsFor: 'class initialization'!initialize	"BinaryStoragePolicy initialize"	self initializeTags!initializeTags	" Initialize the policy tags,	and answer the next available tag value. "	RecordPTag _ 0.	DependentPTag _ 1.	^2! !BinaryStoragePolicy initialize!Object subclass: #BitBlt	instanceVariableNames: 'destForm sourceForm halftoneForm combinationRule destX destY width height sourceX sourceY clipX clipY clipWidth clipHeight '	classVariableNames: ''	poolDictionaries: ''	category: 'Graphics-Support'!BitBlt comment:'The BitBlt operation copies bits from one rectangle within a Form (source) to another (dest).  The result is stored according to a combination rule which specifies one of the sixteen possibilities for how white and black should be combined.Instance Variables:	destForm	<Form> destination of a copy	sourceForm	<Form> source from which to copy	halftoneForm	<Form> screen to mask the source during the copy	combinationRule	<Integer> between 0 and 15	destX	<Integer>	destY	<Integer>	width	<Integer>	height	<Integer>	sourceX	<Integer>	sourceY	<Integer>	clipX	<Integer>	clipY	<Integer>	clipWidth	<Integer>	clipHeight 	<Integer>If halftoneForm is not nil, it is a halftone screen which masks (is ANDed with) the source during the operation.  Halftones are 16x16 bit Forms which are repeated indefinitely as needed by the BitBlt operation. with the two forms and a halftoneForm.If sourceForm is nil, the halftone is taken by itself to be the source, as for filling with a constant pattern.The clipping parameters specify a rectangle in the destination outside of which BitBlt will not make any changes'!!BitBlt methodsFor: 'accessing'!clipHeight: anInteger 	"Set the clipHeight instance variable in BitBlt."	clipHeight _ anInteger!clipRect	"Answer the clipX, clipY clipWidth and clipHeight instance variables in 	BitBlt."	^clipX @ clipY extent: clipWidth @ clipHeight!clipRect: aRectangle 	"Set the clipX, clipY clipWidth andclipHeight instance variables in BitBlt. 	This is a shorthand way to set four of the parameters to BitBlt."	clipX _ aRectangle left.	clipY _ aRectangle top.	clipWidth _ aRectangle width.	clipHeight _ aRectangle height!clipWidth: anInteger 	"Set the clipWidth instance variable in BitBlt."	clipWidth _ anInteger!clipX: anInteger 	"Set the clipX instance variable in BitBlt."	clipX _ anInteger!clipY: anInteger 	"Set the clipY instance variable in BitBlt."	clipY _ anInteger!combinationRule: anInteger 	"Set the combinationRule instance variable in BitBlt.  anInteger is in the range 0-16."	combinationRule _ anInteger!destForm: aForm 	"Set the destinationForm instance variable in BitBlt."	destForm _ aForm!destOrigin: aPoint 	"Set the destination coordinates to be those of aPoint."	destX _ aPoint x.	destY _ aPoint y!destRect	"Answer the destination rectangle."	^destX@destY extent: width@height!destRect: aRectangle 	"Set the destination coordinates to be those of aRectangle top left and	the width and height of the receiver to be the width and height of aRectangle."	destX _ aRectangle left.	destY _ aRectangle top.	width _ aRectangle width.	height _ aRectangle height!destX: anInteger 	"Set the destX instance variable in BitBlt."	destX _ anInteger!destY: anInteger 	"Set the destY instance variable in BitBlt."	destY _ anInteger!height: anInteger 	"Set the height instance variable in BitBlt ."	height _ anInteger!mask: aForm 	"Set the halftoneForm instance variable in BitBlt."	halftoneForm _ aForm!sourceForm: aForm 	"Set the sourceForm instance variable in BitBlt."	sourceForm _ aForm!sourceOrigin: aPoint 	"Set the source form coordinats to be those of aPoint."	sourceX _ aPoint x.	sourceY _ aPoint y!sourceRect: aRectangle 	"Set the sourceX, sourceY width and height instance variables in BitBlt.  This 	is a shorthand way to set four of the parameters to BitBlt."	sourceX _ aRectangle left.	sourceY _ aRectangle top.	width _ aRectangle width.	height _ aRectangle height!sourceX: anInteger 	"Set the sourceX instance variable in BitBlt."	sourceX _ anInteger!sourceY: anInteger 	"Set the sourceY instance variable in BitBlt."	sourceY _ anInteger!width: anInteger 	"Set the width instance variable in BitBlt."	width _ anInteger! !!BitBlt methodsFor: 'copying'!clipFully	"Do the clipping in Smalltalk (after the primitive failed,	and after truncating all parameters to integers).	Fixes very negative or very large rectangles."	| deltaLeft deltaTop deltaRight deltaBottom |	deltaLeft _ clipX - destX max: 0.	deltaTop _ clipY - destY max: 0.	deltaRight _ clipX + clipWidth - (destX + width) min: 0.	deltaBottom _ clipY + clipHeight - (destY + height) min: 0.	destX _ destX + deltaLeft.	destY _ destY + deltaTop.	sourceX _ sourceX + deltaLeft.	sourceY _ sourceY + deltaTop.	height _ height - deltaTop + deltaBottom max: 0.	width  _ width - deltaLeft  + deltaRight max: 0.	clipX _ clipX max: 0.	clipY _ clipY max: 0.	clipHeight _ clipHeight max: 0.	clipWidth _ clipWidth max: 0!copyBits	"Perform the movement of bits from one Form to another described by 	the instance variables of the receiver. Fail if any instance variables 	are not of the right type (Integer or Form) or if combinationRule is 	not between 0 and 15 inclusive. Set the variables and try again 	(BitBlt|copyBitsAgain). Essential. See Object documentation 	whatIsAPrimitive."	<primitive: 96>	combinationRule = Form paint		ifTrue: [^self paintBits]		ifFalse: [^(self copy) truncateFully; copyBitsAgain"Handle Float coordinates"]!paintBits	"Perform the paint operation, which may require two calls to BitBlt."	| oldMask |	(halftoneForm == nil or: [halftoneForm == Form black]) ifFalse: 		"optimization"		[oldMask _ halftoneForm.		combinationRule _ Form erase.		halftoneForm _ nil.		self copyBits. 			"first erase hole in dest"		halftoneForm _ oldMask].	halftoneForm == Form white ifFalse: 		"optimization"		[combinationRule _ Form under.		self copyBits].	combinationRule _ Form paint. 	"restore rule"	"(Form dotOfSize: 32)		displayOn: Display		at: Sensor cursorPoint		clippingBox: Display boundingBox		rule: Form paint		mask: Form lightGray"!truncateFully	"Truncate all coordinates in case any of them was a Float."	destX _ destX truncated.	destY _ destY truncated.	width _ width truncated.	height _ height truncated.	sourceX _ sourceX truncated.	sourceY _ sourceY truncated.	clipX _ clipX truncated.	clipY _ clipY truncated.	clipWidth _ clipWidth truncated.	clipHeight _ clipHeight truncated! !!BitBlt methodsFor: 'line drawing'!drawFrom: startPoint to: stopPoint	"Draw a line from startPoint to stopPoint."	| offset point1 point2 |	"Always draw down, or at least left-to-right"	((startPoint y = stopPoint y and: [startPoint x < stopPoint x])		or: [startPoint y < stopPoint y])		ifTrue: [point1 _ startPoint. point2 _ stopPoint]		ifFalse: [point1 _ stopPoint. point2 _ startPoint].	width _ sourceForm width.	height _ sourceForm height.	offset _ sourceForm offset.	destX _ (point1 x + offset x) rounded.	destY _ (point1 y + offset y) rounded.	self drawLoopX: (point2 x - point1 x) rounded 				  Y: (point2 y - point1 y) rounded!drawLoopX: xDelta Y: yDelta 	"This is the Bresenham plotting algorithm (IBM Systems Journal Vol 	4 No. 1, 1965). It chooses a principal direction, and maintains  	a potential, P.  When P's sign changes, it is time to move in the 	minor direction as well.  Optional.  See Object documentation whatIsAPrimitive."	| dx dy px py P i |	<primitive: 104>	combinationRule = Form paint		ifTrue: [^self paintLoopX: xDelta Y: yDelta ].	dx _ xDelta sign.	dy _ yDelta sign.	px _ yDelta abs.	py _ xDelta abs.	self copyBits.	py > px		ifTrue: 			["more horizontal"			P _ py // 2.			i _ 0.			[(i _ i + 1) <= py]				whileTrue: 					[destX _ destX + dx.					(P _ P - px) < 0						ifTrue: 							[destY _ destY + dy.							P _ P + py].					self copyBits]]		ifFalse: 			["more vertical"			P _ px // 2.			i _ 0.			[(i _ i + 1) <= px]				whileTrue: 					[destY _ destY + dy.					(P _ P - py) < 0						ifTrue: 							[destX _ destX + dx.							P _ P + px].					self copyBits]]!paintLoopX: xDelta Y: yDelta 	"Perform the paint operation, which may require two calls to BitBlt."| oldMask startX startY |	(halftoneForm == nil or: [halftoneForm == Form black])		ifFalse: 			["optimization"			startX _ destX.			startY _ destY.			oldMask _ halftoneForm.			combinationRule _ Form erase.			halftoneForm _ nil.			self drawLoopX: xDelta Y: yDelta.			"first erase hole in dest"			halftoneForm _ oldMask.			destX _ startX.			destY _ startY	].	halftoneForm == Form white		ifFalse: 			["optimization"			combinationRule _ Form under.			self drawLoopX: xDelta Y: yDelta].	combinationRule _ Form paint! !!BitBlt methodsFor: 'private'!copyBitsAgain	<primitive: 96>	(self clipRect intersects: self destRect)	"check for intersection before clipping"		ifTrue: [self clipFully.	"Clipping for very negative or very large rectangles"				^self copyBitsAgainAgain]!copyBitsAgainAgain	<primitive: 96>	self primitiveFailed!setDestForm: df sourceForm: sf halftoneForm: hf combinationRule: cr destOrigin: destOrigin sourceOrigin: sourceOrigin extent: extent clipRect: clipRect 	| aPoint |	destForm _ df.	sourceForm _ sf.	halftoneForm _ hf.	combinationRule _ cr.	destX _ destOrigin x.	destY _ destOrigin y.	sourceX _ sourceOrigin x.	sourceY _ sourceOrigin y.	width _ extent x.	height _ extent y.	aPoint _ clipRect origin.	clipX _ aPoint x.	clipY _ aPoint y.	aPoint _ clipRect corner.	clipWidth _ aPoint x - clipX.	clipHeight _ aPoint y - clipY! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!BitBlt class	instanceVariableNames: ''!!BitBlt class methodsFor: 'instance creation'!destForm: df sourceForm: sf halftoneForm: hf combinationRule: cr destOrigin: destOrigin sourceOrigin: sourceOrigin extent: extent clipRect: clipRect 	"Answer an instance of the receiver with values set according to the 	arguments. "	^self new		setDestForm: df		sourceForm: sf		halftoneForm: hf		combinationRule: cr		destOrigin: destOrigin		sourceOrigin: sourceOrigin		extent: extent		clipRect: clipRect!toReverse: aRectangle 	"Answer a new instance of the receiveer that will reverse a particular rectangle in the 	destination (which must be supplied later)."	^self		destForm: nil		sourceForm: nil		halftoneForm: nil		combinationRule: Form reverse		destOrigin: aRectangle origin		sourceOrigin: 0 @ 0		extent: aRectangle extent		clipRect: aRectangle! !!BitBlt class methodsFor: 'examples'!exampleOne	"This tests BitBlt by displaying the result of all sixteen combination rules 	that BitBlt is capable of using.  (Please see the Byte magazine article by D. Ingalls 	for the meaning of the combination rules and the complete documentation for 	BitBlt in Smalltalk-80.)"	"BitBlt exampleOne."	| path |	path _ Path new.	0 to: 3 do: [:i | 0 to: 3 do: [:j | path add: j * 100 @ (i * 100)]].	Display white.	path _ path translateBy: 100 @ 100.	1 to: 16 do: [:index | BitBlt			exampleAt: (path at: index)			rule: index - 1			mask: Form gray]!exampleTwo	"This is to test painting with a gray tone. It also tests that the seaming with gray 	patterns is correct in the implementation.  Lets you paint until you press a mouse button."	"BitBlt exampleTwo."	| f aBitBlt |	"create a small black Form source as a brush."	f _ Form new extent: 20 @ 20.	f black.	"create a BitBlt which will OR gray into the display"	aBitBlt _ BitBlt		destForm: Display		sourceForm: f		halftoneForm: Form gray		combinationRule: Form under		destOrigin: Sensor cursorPoint		sourceOrigin: 0 @ 0		extent: f extent		clipRect: Display computeBoundingBox.	"paint the gray Form on the screen for a while"	[Sensor anyButtonPressed]		whileFalse:			[aBitBlt destOrigin: Sensor cursorPoint.			aBitBlt copyBits]! !!BitBlt class methodsFor: 'private'!exampleAt: originPoint rule: rule mask:  mask 	"This builds a source and destination form and copies the source to the destination	using the specifed rule and mask.  It is called from the method named exampleOne."	| s d border aBitBlt | 	border_Form new extent: 32@32.	border black.	border fill: (1@1 extent: 30@30) mask: Form white.	s_Form new extent: 32@32.	s white.	s fill: (7@7 corner: 25@25) mask: Form black.	d_Form new extent: 32@32.	d white.	d fill: (0@0 corner: 32@16) mask: Form black.	s displayOn: Display at: originPoint.	border displayOn: Display at: originPoint rule: Form under.	d displayOn: Display at: originPoint + (s width @0).	border displayOn: Display at: originPoint + (s width @0) rule: Form under.	d displayOn: Display at: originPoint + (s extent // (2 @ 1)).	aBitBlt _ BitBlt		destForm: Display		sourceForm: s		halftoneForm: mask		combinationRule: rule		destOrigin: originPoint + (s extent // (2 @ 1))		sourceOrigin: 0 @ 0		extent: s extent		clipRect: Display computeBoundingBox.	aBitBlt copyBits.	border 		displayOn: Display at: originPoint + (s extent // (2 @ 1))		rule: Form under.   	"BitBlt exampleAt: 100@100 rule: 3 mask: Form gray."! !MouseMenuController subclass: #BitEditor	instanceVariableNames: 'scale squareForm color '	classVariableNames: 'YellowButtonMenu YellowButtonMessages '	poolDictionaries: ''	category: 'Tools-Form editing'!BitEditor comment:'A BitEditor is a bit-magnifying tool for editing small Forms directly on the display screen.Instance Variables: 	scale	<Point>	squareForm	<Form>	color	<Symbol> denoting the color for marking a bitClass Variables:	YellowButtonMenu		<PopUpMenu> to be displayed when the operate button is pressed, operations on remembering the contents	YellowButtonMessages	<Array of: Symbols> of message names, one associated with each item in the YellowButtonMenu'!!BitEditor methodsFor: 'initialize-release'!initialize	super initialize.	self initializeYellowButtonMenu!release	super release.	squareForm release.	squareForm _ nil! !!BitEditor methodsFor: 'view access'!view: aView	super view: aView.	scale _ aView transformation scale.		scale _ scale x rounded @ scale y rounded.	squareForm _ Form new extent: scale.	squareForm black! !!BitEditor methodsFor: 'basic control sequence'!controlInitialize	super controlInitialize.	Cursor crossHair show!controlTerminate	Cursor normal show! !!BitEditor methodsFor: 'control defaults'!controlActivity 	| absoluteScreenPoint formPoint displayPoint |	super controlActivity.	[sensor redButtonPressed]	  whileTrue: 		[absoluteScreenPoint _ sensor cursorPoint.			formPoint _ (view inverseDisplayTransform: absoluteScreenPoint - (scale//2)) rounded.		displayPoint _ view displayTransform: formPoint.		squareForm 			displayOn: Display			at: displayPoint 			clippingBox: view insetDisplayBox 			rule: Form over			mask: (Form perform: color).		view changeValueAt: formPoint put:			(#(white black gray) indexOf: color)-1].!isControlActive	^super isControlActive & sensor blueButtonPressed not 		& sensor keyboardPressed not! !!BitEditor methodsFor: 'private-menu messages'!accept	"The edited information should now be accepted by the view."	view accept!cancel	"The edited informatin should be forgotten by the view."	view cancel!setColor: aSymbol	color _ aSymbol! !!BitEditor methodsFor: 'private'!initializeYellowButtonMenu	self yellowButtonMenu: YellowButtonMenu		yellowButtonMessages: YellowButtonMessages! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!BitEditor class	instanceVariableNames: ''!!BitEditor class methodsFor: 'class initialization'!initialize	"The Bit Editor is the only controller to override the use of the blue button with	a different pop-up menu.  Initialize this menu."		"BitEditor initialize."	YellowButtonMenu _ PopUpMenu labels:'acceptcancel'.	YellowButtonMessages _ #(accept cancel )! !!BitEditor class methodsFor: 'instance creation'!openOnForm: aForm	"Create and schedule a BitEditor on the form aForm."	| scaleFactor |	scaleFactor _ 8 @ 8.	^ self openOnForm: aForm		at: (self locateMagnifiedView: aForm scale: scaleFactor) topLeft		scale: scaleFactor!openOnForm: aForm at: aPoint	"Create and schedule a BitEditor on the form aForm with origin point at aPoint."	^ self openOnForm: aForm		at: aPoint		scale: 8 @ 8!openOnForm: aForm at: magnifiedLocation scale: scaleFactor 	"Create and schedule a BitEditor on the form aForm.  Show the small and 	magnified view of aForm."	| aScheduledView |	aScheduledView _ self				bitEdit: aForm				at: magnifiedLocation				scale: scaleFactor				remoteView: nil.	aScheduledView controller openDisplayAt:		aScheduledView displayBox topLeft + (aScheduledView displayBox extent / 2)!openScreenViewOnForm: aForm at: formLocation magnifiedAt: magnifiedLocation scale: scaleFactor	"Create and schedule a BitEditor on the form aForm.  Show the magnified	view of aForm in a scheduled window."	| smallFormView bitEditor savedForm |	smallFormView _ FormView new model: aForm.	smallFormView align: smallFormView viewport topLeft with: formLocation.	bitEditor _ self bitEdit: aForm at: magnifiedLocation scale: scaleFactor remoteView: smallFormView.	savedForm _ Form fromDisplay: bitEditor displayBox.	bitEditor controller blueButtonMenu: nil blueButtonMessages: nil.	bitEditor controller startUp.	savedForm displayOn: Display at: bitEditor displayBox topLeft.	bitEditor release.	smallFormView release! !!BitEditor class methodsFor: 'examples'!magnifyOnScreen	"Bit editing of an area of the display screen. User designates a 	rectangular area that is magnified by 8 to allow individual screens dots to be 	modified.  Editor is not scheduled in a view.  Original screen location is 	updated immediately.  This is the same as FormEditor magnify."	"BitEditor magnifyOnScreen."	| smallRect smallForm scaleFactor tempRect |	scaleFactor _ 8 @ 8.	smallRect _ Rectangle fromUser.	smallRect isNil ifTrue: [^self].	smallForm _ Form fromDisplay: smallRect.	tempRect _ self locateMagnifiedView: smallForm scale: scaleFactor.	"show magnified form size until mouse is depressed"	BitEditor		openScreenViewOnForm: smallForm 		at: smallRect topLeft 		magnifiedAt: tempRect topLeft 		scale: scaleFactor!magnifyWithSmall	"Bit editing of an area of the Form. User designates a rectangular area 	that is magnified by 8 to allow individual screens dots to be modified.  	Editor is scheduled in a view, showing the magnified view only."	"BitEditor magnifyWithSmall."	| smallRect smallForm  |	smallRect _ Rectangle fromUser.	smallRect isNil ifTrue: [^self].	smallForm _ Form fromDisplay: smallRect.	BitEditor openOnForm: smallForm! !!BitEditor class methodsFor: 'private'!bitEdit: aForm at: magnifiedFormLocation scale: scaleFactor remoteView: remoteView	"Creates a BitEditor on aForm. That is, aForm is a small image that will 	change as a result of the BitEditor changing a second and magnified 	view of me. magnifiedFormLocation is where the magnified form is to be 	located on the screen. scaleFactor is the amount of magnification. This 	method implements a scheduled view containing both a small and 	magnified view of aForm. Upon accept, aForm is updated."	| aFormView scaledFormView bitEditor topView extent menuView lowerRightExtent |	scaledFormView _ FormHolderView new model: aForm.	scaledFormView scaleBy: scaleFactor.	bitEditor _ self new.	bitEditor setColor: #black.	scaledFormView controller: bitEditor.	topView _ StandardSystemView new.	remoteView == nil ifTrue: [topView label: 'Bit Editor'].	topView borderWidth: 2.	topView insideColor: Form white.	topView addSubView: scaledFormView.	remoteView == nil		ifTrue:  "If no remote view, then provide a local view of the form"			[aFormView _ FormView new model: scaledFormView workingForm.			aFormView controller: NoController new.			(aForm isMemberOf: OpaqueForm) ifTrue:				[scaledFormView insideColor: Form gray.				aFormView insideColor: Form white].			aForm height < 50				ifTrue: [aFormView borderWidthLeft: 0 right: 2 top: 2 bottom: 2]				ifFalse: [aFormView borderWidthLeft: 0 right: 2 top: 2 bottom: 0].			topView addSubView: aFormView below: scaledFormView]		 ifFalse:  "Otherwise, the remote one should view the same form"			[remoteView model: scaledFormView workingForm].	lowerRightExtent _ remoteView == nil			ifTrue:				[(scaledFormView viewport width - aFormView viewport width) @					(aFormView viewport height max: 50)]			ifFalse:				[scaledFormView viewport width @ 50].	menuView _ self buildColorMenu: lowerRightExtent		colorCount: ((aForm isMemberOf: OpaqueForm) ifTrue: [3] ifFalse: [2]).	menuView model: bitEditor.	menuView borderWidthLeft: 0 right: 0 top: 2 bottom: 0.	topView		addSubView: menuView		align: menuView viewport topRight		with: scaledFormView viewport bottomRight.	extent _ scaledFormView viewport extent + (0 @ lowerRightExtent y)			+ (4 @ 4).  "+4 for borders"	topView minimumSize: extent.	topView maximumSize: extent.	topView translateBy: magnifiedFormLocation.	^topView!buildColorMenu: extent colorCount: nColors  "BitEditor magnifyWithSmall."	| menuView form aSwitchView connector	  button formExtent highlightForm color leftOffset |	connector _ Object new.	menuView _ FormMenuView new.	menuView window: (0@0 corner: extent).	formExtent _ 30@30 min: extent//(nColors*2+1@2).  "compute this better"	leftOffset _ extent x-(nColors*2-1*formExtent x)//2.	highlightForm _ Form extent: formExtent.	highlightForm borderWidth: 4 mask: Form black.	1 to: nColors do:		[:index | 		color _ (nColors=2			ifTrue: [#(white black)]			ifFalse: [#(white gray black)]) at: index.		form _ Form extent: formExtent.		form fill: form boundingBox mask: (Form perform: color).		form borderWidth: 5 mask: Form black.		color = #black ifTrue: [form borderWidth: 5 mask: Form white].		form borderWidth: 4 mask: Form white.		button _ color = #black			ifTrue: [OneOnSwitch newOn]			ifFalse: [OneOnSwitch newOff].		button onAction: [menuView model setColor: color].		button connection: connector.		aSwitchView _ SwitchView new model: button.		aSwitchView key: ((nColors=3 ifTrue: ['xvn'] ifFalse: ['xn']) at: index).		aSwitchView label: form.		aSwitchView window: (0@0 extent: form extent).		aSwitchView translateBy: (index-1*2*form width+leftOffset) @ (form height//2).		aSwitchView insideColor: Form white.		aSwitchView highlightForm: highlightForm.			aSwitchView borderWidth: 1.		aSwitchView controller selector: #turnOn.		menuView addSubView: aSwitchView].	^menuView!locateMagnifiedView: aForm scale: scaleFactor 	"Answers with a rectangle at the location where the scaled view of 	the form aForm 	should be displayed."	| tempExtent tempRect |	tempExtent _ aForm extent * scaleFactor + (0 @ 50).	tempRect _ Sensor cursorPoint extent: tempExtent.	"show magnified form size until mouse is depressed"	Cursor origin showWhile:		[tempRect _ Display				outline: [Sensor cursorPoint extent: tempExtent]				while: [Sensor anyButtonPressed not]				width: 2				halftone: Form gray].	^tempRect! !BitEditor initialize!Object subclass: #BlockClosure	instanceVariableNames: 'method outerContext copiedValues '	classVariableNames: ''	poolDictionaries: ''	category: 'Kernel-Methods'!BlockClosure comment:'A BlockClosure represents a block closure, created by executing a block expression ([] construct).  I may include a reference to the outer context and/or copied variables (currently, only one or the other).There are currently three kinds of closures: "clean" closures with no references to anything from outer scopes (these have outerContext = nil, copiedValues = nil); "copying" closures that copy immutable values from outer scopes when the closure is created (these have outerContext = nil, copiedValues used); and "full" closures that retain a reference to the next outer scope (these have outerContext ~= nil, copiedValues = nil.)  As an optimization, copiedValues holds the (single) copied value if there is exactly one, or an Array of values if there is more than one.  Note that if there is a single copied value, copiedValues may still be nil: the way to check whether a closure has copied values is to ask its method whether numCopiedValues > 0.Instance Variables:	method			<CompiledMethod>	outerContext	<Context | nil>	copiedValues	<Object | Array | nil>'!!BlockClosure methodsFor: 'accessing'!home	"Answer the outermost MethodContext, or nil if none was saved."	^outerContext == nil		ifTrue: [nil]		ifFalse: [outerContext home]!method	"Answer the deferred sequence of expressions."	^method!numArgs	"Answer the number of arguments expected."	^method numArgs!outerContext	"Answer the context from which the receiver can obtain values."	^outerContext! !!BlockClosure methodsFor: 'comparing'!= aBlockClosure	^aBlockClosure class = self class and:	 [method = aBlockClosure method and:	  [outerContext = aBlockClosure outerContext and:	   [copiedValues = aBlockClosure copiedValues]]]!hash	^method hash bitXor: outerContext hash! !!BlockClosure methodsFor: 'evaluating'!value	"Evaluate the block represented by the receiver.  Fail if the block expects any 	arguments.  Optional.  See Object documentation whatIsAPrimitive."	<primitive: 501>	^self valueWithArguments: #()!value: arg 	"Evaluate the block represented by the receiver.  Fail if the block expects other 	than one argument.  Optional.  See Object documentation whatIsAPrimitive."	<primitive: 502>	^self valueWithArguments: (Array with: arg)!value: arg1 value: arg2 	"Evaluate the block represented by the receiver.  Fail if the block expects other 	than two arguments.  Optional.  See Object documentation whatIsAPrimitive."	<primitive: 503>	^self valueWithArguments: (Array with: arg1 with: arg2)!value: arg1 value: arg2 value: arg3 	"Evaluate the block represented by the receiver.  Fail if the block expects other 	than three arguments.  Optional.  See Object documentation whatIsAPrimitive."	<primitive: 504>	^self valueWithArguments: 		(Array			with: arg1			with: arg2			with: arg3)!valueWithArguments: anArray 	"Evaluate the block represented by the receiver.  The argument is an Array 	whose elements are the arguments for the block.  Fail if the length of the Array 	is not the same as the the number of arguments that the block was expecting.  	Essential.  See Object documentation whatIsAPrimitive."	<primitive: 500>	(anArray isMemberOf: Array)		ifTrue: [self error: 'This block expects ', self numArgs printString, ' argument(s)']		ifFalse: [self error: 'BlockClosure>>valueWithArguments: requires an Array']! !!BlockClosure methodsFor: 'unwinding'!valueNowOrOnUnwindDo: aBlock	"Answer the result of evaluating the receiver.	If an exception would cause the evaluation to	be abandoned, evaluate aBlock.  The logic for	this is in Exception.  If no exception occurs,	also evaluate aBlock."	| result |	result _ self value.	aBlock value.	^result!valueOnUnwindDo: aBlock	"Answer the result of evaluating the receiver.	If an exception would cause the evaluation to	be abandoned, evaluate aBlock.  The logic for	this is in Exception."	^self value! !!BlockClosure methodsFor: 'controlling'!repeat	"Evaluate the receiver repeatedly, not ending unless the block	forces some stopping condition. Ordinarily compiled in-line.  	But could also be done in Smalltalk as follows"	self value.	[self value] repeat!whileFalse	"Evaluate the receiver once and then repeatedly as long as the value	returned by the evaluation is false. Ordinarily compiled in-line.  	But could also be done in Smalltalk as follows"	^[self value] whileFalse: []!whileFalse: aBlock 	"Evaluate the argument, aBlock, as long as the value   	of the receiver is false. Ordinarily compiled in-line.  	But could also be done in Smalltalk as follows"	^self value		ifFalse:			[aBlock value.			[self value] whileFalse: [aBlock value]]!whileTrue	"Evaluate the receiver once and then repeatedly as long as the value	returned by the evaluation is true. Ordinarily compiled in-line.  	But could also be done in Smalltalk as follows"	^[self value] whileTrue: []!whileTrue: aBlock 	"Evaluate the argument, aBlock, as long as the value   	of the receiver is true. Ordinarily compiled in-line.  	But could also be done in Smalltalk as follows"	^self value		ifTrue:			[aBlock value.			[self value] whileTrue: [aBlock value]]! !!BlockClosure methodsFor: 'scheduling'!fork	"Create and schedule a process running the code in the receiver."	self newProcess resume!forkAt: priority 	"Create and schedule a process running the code in the receiver.	The priority of the process is the argument, priority."	| forkedProcess |	forkedProcess _ self newProcess.	forkedProcess priority: priority.	forkedProcess resume!newProcess	"Answer a new process running the code in the receiver.	The process is not scheduled."	^Process		forContext: 			[Process terminateSignal				handle: [:ex | ex return]				do: self.			Processor terminateActive]				newContext		priority: Processor activePriority!newProcessWithArguments: anArray 	"Answer a new process running the code in the receiver.	The receiver's block arguments are bound to the contents	of the argument, anArray.  The process is not scheduled."	^[self valueWithArguments: anArray] newProcess! !!BlockClosure methodsFor: 'private'!copiedValues	"This is here only for comparing"	^copiedValues!newContext	"Construct a BlockContext for running	this closure as a new process with no arguments."	^BlockContext		sender: nil		receiver: self		method: method		arguments: #()!pushCopiedValues: aContext	"This is only used for simulation"	method numCopiedValues = 1		ifTrue: [aContext push: copiedValues]		ifFalse: [copiedValues do: [:value | aContext push: value]]!setMethod: meth outerContext: ctx copiedValues: values	method _ meth.	outerContext _ ctx.	copiedValues _ values! !!BlockClosure methodsFor: 'testing'!refersToLiteral: anObject	^method refersToLiteral: anObject! !!BlockClosure methodsFor: 'backward compatibility'!fixTemps	"This message has three purposes:		- To avoid creating circularities.  This is not an issue	in HPS.		- To preserve home variables across process boundaries,	because all local variables get set to nil when a process	is terminated.  Because circularities are no longer an issue,	it is no longer necessary to set the local variables to nil,	so this should not be an issue either.		- To 'capture' home variables.  This is obscure at best,	and there are other perfectly good ways to do it without	having to go inside the implementation of contexts.	Nevertheless, it is necessary to implement fixTemps	for the time being, lest programs (such as the BitEditor	and FormEditor) break."	| newCopied |	newCopied _ method numCopiedValues <= 1  "i.e. 0 or 1"		ifTrue: [copiedValues]		ifFalse: [copiedValues shallowCopy].	outerContext == nil		ifTrue:			["No outer context.  Copy the copied values if any."			^self class				newMethod: method				outerContext: nil				copiedValues: newCopied].	"There is an outer context.	Copy it, and continue copying recursively	until we reach a MethodContext."	^self class		newMethod: method		outerContext: outerContext copyForFixTemps		copiedValues: newCopied! !!BlockClosure methodsFor: 'privileged evaluation'!valueUninterruptably	"Execute the receiver without interrupts (e.g. Process>>interruptWith: staved off).	Note that this does not prevent preemption by higher priority processes.	Use this facility VERY sparingly!!"	^Processor activeProcess		uninterruptablyDo: self!valueUnpreemptively	"Evaluate the receiver (block), without the possibility of preemption 	by higher priority processes. Use this facility VERY sparingly!!"	"Think about using Block>>valueUninterruptably first, and think about 	using Semaphore>>critical: before that, and think about redesigning 	your application even before that!! After you've done all that 	thinking it would still behoove you to remember that no input will be 	recognized, etc. while in this block (and Processor>>yield won't help). 	Then, go right ahead and use it..."	| activeProcess oldPriority |	activeProcess _ Processor activeProcess.	oldPriority _ activeProcess priority.	activeProcess priority: Processor highestPriority.	^self valueNowOrOnUnwindDo: [activeProcess priority: oldPriority]! !!BlockClosure methodsFor: 'copying'!deepCopy	"Answer a copy of the receiver with its own copy of each instance 	variable. This doesn't make sense for BlockClosures."	^self deepCopyError! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!BlockClosure class	instanceVariableNames: ''!BlockClosure class comment:'Methods addSelectorUnchecked:withMethod: and addSelector:withMethod: are overridden here so that the unique unwind method (valueOnUnwindDo:) can be marked and recorded when it is re-defined.'!!BlockClosure class methodsFor: 'instance creation'!newCleanMethod: meth 	"Answer a new instance of the receiver that defers execution of 	expressions meth that has no access to outside names."	^super new		setMethod: meth		outerContext: nil		copiedValues: #()!newCopyingMethod: meth size: size valuesFrom: aBlock	"Answer a new instance of the receiver that defers execution of 	expressions meth that has accesses outside names from aBlock."	| values |	size = meth numCopiedValues		ifFalse:			[self error: 'Wrong # of copied values'.			^nil].	values _ size = 1		ifTrue: [aBlock value: 1]		ifFalse: [(1 to: size) collect: [:i | aBlock value: i]].	^super new setMethod: meth outerContext: nil copiedValues: values!newFullMethod: meth outerContext: ctx	"Answer a new instance of the receiver that defers execution of 	expressions meth that has accesses outside names from ctx."	^super new setMethod: meth outerContext: ctx copiedValues: #()! !!BlockClosure class methodsFor: 'private'!addSelector: selector withMethod: compiledMethod 	"Intercept this so we can mark unwind method"	super addSelector: selector withMethod:		((selector == #valueOnUnwindDo: or: [selector == #valueNowOrOnUnwindDo:])			ifTrue: [compiledMethod asUnwindMethod]			ifFalse: [compiledMethod])!newMethod: meth outerContext: ctx copiedValues: values	^super new setMethod: meth outerContext: ctx copiedValues: values! !Context subclass: #BlockContext	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Kernel-Methods'!BlockContext comment:'Class BlockContext represents the context created for executing a block.  The receiver for the BlockContext is the BlockClosure being executed.'!!BlockContext methodsFor: 'accessing'!home	"Answer the outermost MethodContext.	Note that this may be nil."	^receiver home  "receiver is a BlockClosure"!homeReceiver	"Answer the receiver from the context	in which the receiver was defined."	| home |	home _ self home.	^home isNil		ifTrue: [nil]		ifFalse: [home receiver]!mclass 	"Answer the class in which the home receiver's method was found."	| home mclass |	home _ self home.	home == nil ifTrue:		["We don't have a home, but the CompiledBlock		should know."		home _ method mclass.		home isNil ifTrue: [home _ Object].  "this shouldn't happen!!"		^home].	home receiver class 		selectorAtMethod: method homeMethod setClass: [:mc | mclass _ mc].	^mclass!outerContext	"Answer the next outer context.	If this is a clean or copying block,	answer nil."	^receiver outerContext!selector	"Answer the selector of the method that created the receiver."	| home classOfMethod |	home _ self home.	home notNil		ifTrue:			[^home receiver class 				selectorAtMethod: home method 				setClass: [:ignored]].	classOfMethod _ self mclass.	^classOfMethod parserClass new parseSelector: self sourceCode!sourceCode 	"Answer the source form of the receiver's method."	| homeMethod mclass selector |	^method getSourceForUserIfNone:		[homeMethod _ method homeMethod.		^homeMethod getSourceForUserIfNone:			["We have to decompile.			Use the home class."			mclass _ self mclass.			selector _ mclass selectorAtMethod: homeMethod setClass: [:mc | mclass _ mc].			mclass sourceCodeForMethod: homeMethod at: selector]]! !!BlockContext methodsFor: 'unwinding'!methodReturn: aValue	"Answer the result to the receiver's home."	| home ctx |	home _ receiver home.	ctx _ home sender.	self unwindUpTo: home.	ctx isNil ifTrue: [^self cannotReturn: aValue].	ctx push: aValue.	^ctx!nonlocalReturn: innerResult through: firstUnwindContext 	"Answer the result to the receiver's home's sender, executing all 	the unwind blocks found on the way."	| unwindCtx home result |	home _ self home.	result _ innerResult.	unwindCtx _ firstUnwindContext.	[unwindCtx notNil]		whileTrue: 			[| tc |			"We consider ^-returns inside unwind-blocks, viz:					self turnOnWater.					[self bathe]						valueNowOrOnUnwindDo: [^self shutOffWater]			...bad style at least and pathological at worst; hence we don't make			any provision for *these* ^-returns to trigger any unwind-blocks they			have.  Nonetheless, these ^-returns are permitted, and the value returned			overrides any inner ^-return's value.			The trick when running unwind-blocks is to catch *their* ^-returns			(if any), and short-circuit the nonlocalReturn:through: search			to prevent infinitely recursive unwinds.  Luckily, there is a mechanism			to catch those returns: unwind blocks!!  Doug Hofstadter, call your office..."			tc _ thisContext.			[(unwindCtx localAt: 1) value]				valueOnUnwindDo: 					[result _ thisContext sender home localAt: 1.					tc resume].			unwindCtx _ unwindCtx findNextUnwindUpTo: home].	home sender resumeWith: result! !!BlockContext methodsFor: 'testing'!isBlockContext	^true! !!BlockContext methodsFor: 'printing'!printOn: aStream	| outerContext |	outerContext _ receiver outerContext.	outerContext == nil 		ifTrue: [aStream nextPutAll: '[] optimized']		ifFalse: [aStream nextPutAll: '[] in '.				receiver outerContext printOn: aStream]! !!BlockContext methodsFor: 'simulation-push/store/pop'!pushCopiedValues: count	| oldp |	oldp _ stackp.	receiver pushCopiedValues: self.	stackp = (oldp + count)		ifFalse:			[self error: 'wrong # of copied values']!pushInst: index outer: level	self push: ((self outer: level - 1) outerContext receiver instVarAt: index + 1)!pushLocal: index outer: level	self push: ((self outer: level - 1) outerContext localAt: index + 1)!pushReceiverOuter: level	self push: (self outer: level - 1) outerContext receiver!storePopInst: index outer: level	(self outer: level - 1) outerContext receiver instVarAt: index + 1 put: self topPop!storePopLocal: index outer: level	(self outer: level - 1) outerContext localAt: index + 1 put: self topPop! !!BlockContext methodsFor: 'simulation-control'!methodReturnTop: levels	^self methodReturn: self top! !!BlockContext methodsFor: 'backward compatibility'!finishCopyForFixTemps	"Fix the temps of the receiver	(a BlockClosure)."	super finishCopyForFixTemps.	receiver _ receiver fixTemps! !!BlockContext methodsFor: 'private'!findTemp: index do: aBlock elseDo: elseBlock	" aBlock is guaranteed to do a ^ return "	| outer left |	outer _ self outerContext.	outer == nil		ifTrue:			[left _ index]		ifFalse:			[outer findTemp: index do: aBlock elseDo:				[:excess | left _ excess]].	^self countTemps: left do: aBlock elseDo: elseBlock!outer: level	"Return the BlockClosure which is the receiver	counting outward the given # of levels."	^level = 0		ifTrue: [receiver]		ifFalse: [receiver outerContext outer: level - 1]!privateTempAt: index	^stack at: index!privateTempAt: index put: value	index <= method numArgs		ifTrue:			[(self confirm: 'I will restart from the beginning of this block.Is that OK?')				ifTrue: [self restart]				ifFalse: [^value]].	(index > method numTemps and:	 [index <= (method numTemps + method numCopiedValues)])		ifTrue:			[self error: 'Storing into locally copied values is not allowed.'.			^value].	^stack at: index put: value! !LeafNode subclass: #BlockNode	instanceVariableNames: 'arguments body '	classVariableNames: ''	poolDictionaries: ''	category: 'System-Compiler-Program Objects'!BlockNode comment:'Class BlockNode represents a block, with or without arguments.  Local temporaries, if any, are bound in the SequenceNode which is the body.Instance Variables:	arguments	<Array of: ParameterNode>	body		<ValueNode>  normally, but not necessarily, a SequenceNode'!!BlockNode methodsFor: 'initialize-release'!arguments: args body: seq	arguments _ args.	body _ seq!body: seq	arguments _ #().	body _ seq! !!BlockNode methodsFor: 'accessing'!arguments	"for printing method header,	checking numArgs for control messages,	and binding remote variables"	^arguments!body	"for de-blocking args of conditionals, loops,	and methods"	^body! !!BlockNode methodsFor: 'testing'!isBlockWithNumArgs: nargs	^arguments size = nargs!isComplex	^body size > 1! !!BlockNode methodsFor: 'transforming'!arithmeticLoopFrom: initial by: increment to: limit	"I am a block of the form [:var | body],	the body of an arithmetic loop.	Generate an ArithmeticLoopNode."	^ArithmeticLoopNode new		variable: (arguments at: 1) variable		initialValue: initial		increment: increment		limit: limit		body: body! !!BlockNode methodsFor: 'printing'!printArgumentsOn: aStream indent: level 	arguments size = 0		ifFalse: 			[arguments do: 				[:arg | 				aStream nextPut: $:.				arg printOn: aStream indent: level.				aStream space].			aStream nextPutAll: '| ']!printMethodBodyOn: aStream indent: level	"Print the temps and body of a method"	body isEmpty ifFalse:		[aStream crtab: level.		body printOn: aStream indent: level]!printOn: aStream indent: level 	body isComplex ifTrue: [aStream crtab: level].	aStream nextPut: $[.	self printArgumentsOn: aStream indent: level.	"If >0 temps or >1 statement, put all statements on separate lines"	(body isComplex and: [arguments size > 0])		ifTrue: [aStream crtab: level].	body printOn: aStream indent: level.	aStream nextPut: $]! !!BlockNode methodsFor: 'code generation'!emitBody: codeStream	"The codeStream invokes this to compile	the body of the block,	including the final return."	(body isEmpty and: [arguments isEmpty not])		ifTrue: [arguments last variable emitLocalReturn: codeStream from: body]		ifFalse: [body emitLocalReturn: codeStream from: body]!emitSend: codeStream selector: selector arguments: args	"Blocks (closures) have a fixed class,	so we can use a no-check send."	codeStream sendNoCheck: selector numArgs: args size!emitValue: codeStream	"This is handled specially, so that the codeStream	can choose its block implementation strategy."	codeStream codeBlock: self!emitValue: codeStream forAssignment: assignNode	"This is handled specially, because the variable	represented by varNode should be treated	as if it had already received a value."	codeStream noteStore: assignNode variable.	self emitValue: codeStream!initScope: codeStream	"Give the codeStream the variables"	codeStream topNode: self.  "do this first in case of error"	codeStream arguments: arguments! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!BlockNode class	instanceVariableNames: ''!!BlockNode class methodsFor: 'instance creation'!body: seq	^self new arguments: #() body: seq! !Object subclass: #Boolean	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Kernel-Objects'!Boolean comment:'Class Boolean is an abstract class that implements behavior common to true and false.  Its subclasses are True and False.Subclasses must implement methods for 	logical operations		&		not		| 	controlling		and:		or:		ifTrue:		ifFalse:		ifTrue:ifFalse:		ifFalse:ifTrue:'!!Boolean methodsFor: 'logical operations'!& aBoolean 	"Evaluating conjunction.  Evaluate the argument.  Answer true if both the	receiver and the argument are true."	self subclassResponsibility!eqv: aBoolean 	"Answer true if the receiver is equivalent to aBoolean."	^self == aBoolean!not	"Negation.  Answer true if the receiver is false, answer false if the receiver is true."	self subclassResponsibility!xor: aBoolean 	"Exclusive OR.  Answer true if the receiver is not equivalent to aBoolean."	^(self == aBoolean) not!| aBoolean 	"Evaluating disjunction (OR).  Evaluate the argument.  Answer true if	either the receiver or the argument is true."	self subclassResponsibility! !!Boolean methodsFor: 'controlling'!and: alternativeBlock 	"Nonevaluating conjunction.  If the receiver is true, answer the value of	the argument, alternativeBlock; otherwise answer false without evaluating the	argument."	"Execution does not actually reach here because the expression is compiled in-line."	self subclassResponsibility!ifFalse: alternativeBlock 	"If the receiver is true (i.e., the condition is true), then the value is 	the true alternative, which is nil. Otherwise answer the result of 	evaluating the argument, alternativeBlock. This method is typically 	not invoked because ifTrue:/ifFalse: expressions are compiled in-line 	for literal blocks."	^self subclassResponsibility!ifFalse: falseAlternativeBlock ifTrue: trueAlternativeBlock 	"If the receiver is true (i.e., the condition is true), then answer the 	value of the argument trueAlternativeBlock. If the receiver is false, 	answer the result of evaluating the argument falseAlternativeBlock. 	This method is typically not invoked because ifTrue:/ifFalse: 	expressions are compiled in-line for literal blocks."	^self subclassResponsibility!ifTrue: alternativeBlock 	"If the receiver is false (i.e., the condition is false), then the value is 	the false alternative, which is nil. Otherwise answer the result of 	evaluating the argument, alternativeBlock. This method is typically 	not invoked because ifTrue:/ifFalse: expressions are compiled in-line 	for literal blocks."	^self subclassResponsibility!ifTrue: trueAlternativeBlock ifFalse: falseAlternativeBlock 	"If the receiver is true (i.e., the condition is true), then answer the 	value of the argument trueAlternativeBlock. If the receiver is false, 	answer the result of evaluating the argument falseAlternativeBlock. 	This method is typically not invoked because ifTrue:/ifFalse: 	expressions are compiled in-line for literal blocks."	^self subclassResponsibility!or: alternativeBlock 	"Nonevaluating disjunction.  If the receiver is false, answer the value of	the argument, alternativeBlock; otherwise answer true without evaluating the	argument."	"Execution does not actually reach here because the expression is compiled in-line."	self subclassResponsibility! !!Boolean methodsFor: 'copying'!deepCopy 	"Receiver has two concrete subclasses, True and False.	Only one instance of each should be made, so return self."	^self!shallowCopy 	"Receiver has two concrete subclasses, True and False.	Only one instance of each should be made, so return self."	^self! !!Boolean methodsFor: 'printing'!storeOn: aStream	"Append to the argument aStream a sequence of characters that is an	expression whose evaluation creates an object similar to the receiver."	self printOn: aStream! !!Boolean methodsFor: 'testing'!isManifest	"Answer whether receiver is manifestly storable."	^true! !!Boolean methodsFor: 'fileIn/Out'!storeBinaryOn: stream 	"Put a binary representation of the receiver into stream."	stream storeBoolean: self! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Boolean class	instanceVariableNames: ''!!Boolean class methodsFor: 'instance creation'!new	"Provide an error notification that it is not appropriate	to create an instance of the receiver."	self error: 'You may not create any more Booleans - this is two-valued logic'! !SwitchView subclass: #BooleanView	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Interface-Menus'!BooleanView comment:'BooleanView is a "pluggable" view of a Boolean value. The notion of pluggable views is an experiment in user interface design. The idea is to provide a view which can be plugged onto any object, rather than having to define a new subclass specific to every kind of object which needs to be viewed. The chief mechanism is a set of selectors, which can be thought of as an adaptor to convert the generic textView operations (such as interrogateModel) into model-specific operations (such as metaclassSelected).  See the creation messages in the class for an explication of the various parameters. Browse senders of the creation messages in the class for examples in the system.'!!BooleanView methodsFor: 'updating'!interrogateModel	^ (model perform: selector) = arguments first!update: aspect	aspect == selector ifTrue: [super update: aspect]! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!BooleanView class	instanceVariableNames: ''!!BooleanView class methodsFor: 'instance creation'!on: model aspect: aspect label: label change: changeSel value: onValue	"Create a 'pluggable' (see class comment) switchView viewing anObject.	aspect is sent to read the current boolean value in the model.		It is also used as the changed: parameter for this view.	changeSel is sent to inform anObject of new boolean value for the model."	| view args |	view _ self new.	view model: model.	view selector: aspect; arguments: (args _ Array with: onValue).	view controller selector: changeSel; arguments: args.	view label: label asParagraph.	^view! !Model subclass: #Browser	instanceVariableNames: 'organization category className meta protocol selector textMode '	classVariableNames: 'CategoryMenu ClassMenu LastProtocol MessageMenu MethodMoveProtocol ProtocolMenu TextMenu '	poolDictionaries: ''	category: 'Tools-Programming'!Browser comment:'A browser represents a hierarchical query path through an organization of class and method information.  A full path query identifies a Smalltalk-80 method to be examined.Instance Variables:	organization <SystemOrganizer>	category	 <String> a selection from all categories in the organization.	className	 <Symbol> a selection from all classes in the category.	meta 		<Boolean> false for viewing instance methods, true for class methods.	protocol 	<Symbol> a selection from all protocols in the class.	selector 	<Symbol> a selection from all messages in the protocol.	textMode 	<Symbol> indicating the nature of the currently viewed textClass Variables:	CategoryMenu	<ActionMenu> of operations on the class categories	ClassMenu		<ActionMenu> of operations and queries about a class	LastProtocol	<Symbol> last message category selected	MessageMenu	<ActionMenu> of operations on the message categories	MethodMoveProtocol	<Symbol> last message category used in a move	ProtocolMenu	<ActionMenu> of operations and queries about a message	TextMenu 		<ActionMenu> of text editing operations'!!Browser methodsFor: 'initialize-release'!on: anOrganizer	"Set the receiver to be a browser on the system class organization anOrganizer."	 organization _ anOrganizer.	meta _ false!onClass: aClass 	"Set the receiver to be a browser on the class aClass, so that 	therefore the organization is the system organizer."	organization _ SystemOrganization.	className _ aClass isMeta				ifTrue: [aClass soleInstance name]				ifFalse: [aClass name].	meta _ aClass isMeta! !!Browser methodsFor: 'category list'!category	"Answer the receiver's currently selected category."	^ category!category: selection 	"Set the receiver's currently selected category to be selection and 	update the class list."	category = '**Hierarchy**' ifTrue: [^nil].	category _ selection.	selection isNil ifTrue: [self textMode: nil].	self newClassList: className!categoryList	"Answer the sequenceable collection containing the class categories that 	the receiver accesses."	^organization categories!categoryMenu	"Answer an ActionMenu of operations on class categories to be 	displayed when the operate menu button is pressed."	"Browser flushMenus"	category == nil ifTrue: [^ActionMenu			labels: 'add category\update\edit all\find class' withCRs			lines: #(1 3 )			selectors: #(#addCategory #updateCategories #editCategories #findClass )].	CategoryMenu == nil ifTrue: [CategoryMenu _ ActionMenu					labels: 'file out\print out\spawn\add category\rename\remove\update\edit all\find class' withCRs					lines: #(3 6 8 )					selectors: #(#fileOutCategory #printOutCategory #spawnCategory #addCategory #renameCategory #removeCategory #updateCategories #editCategories #findClass )].	^CategoryMenu!newCategoryList: initialSelection	"Set the currently selected category to be initialSelection."	category _ initialSelection.	self changed: #category! !!Browser methodsFor: 'class list'!classList	"Answer the sequenceable collection containing the classes that 	are accessed from the currently selected category."	category == nil ifTrue: [^ nil].	category = '**Hierarchy**' ifTrue:		[self selectedClass == nil			ifTrue: ["Class is gone, probably was removed"					^nil].			^ (self selectedClass withAllSuperclasses reverse , self selectedClass allSubclasses)			collect: [:cls | cls name]].	^ organization listAtCategoryNamed: category!classMenu	"Answer an ActionMenu of operations on classes that is to be displayed 	when the operate menu button is pressed."	"Browser flushMenus"	className == nil ifTrue: [^nil].	ClassMenu == nil ifTrue: [ClassMenu _ ActionMenu					labels: 'file out\print out\spawn\spawn hierarchyhierarchy\definition\comment\protocolsinst var refs\class var refs\class refsfind methodrename\remove' withCRs					lines: #(4 8 11 12 )					selectors: #(#fileOutClass #printOutClass #spawnClass #spawnHierarchy #showHierarchy #editClass #editComment #editProtocols #browseFieldReferences #browseClassVariables #browseClassReferences #findMethodAndSelectAlphabetic #renameClass #removeClass )].	^ClassMenu!className	"Answer the receiver's currently selected class."	^ className!className: selection	"Set the receiver's currently selected class to be selection and 	update the message category list.  If this class no longer exists,	print a message to that effect in the system transcript, if it is open."	className _ selection.	Dictionary keyNotFoundSignal		handle: [:ex | Transcript cr; show: 'class ', className, ' no longer exists.'. 				ex return]				"KeyNotFoundSignal is raised when the class name selected 				in a browser is already removed in another browser."		do: [self newProtocolList: protocol.			selection isNil & category notNil				ifTrue: [self textMode: #classDefinition]				ifFalse: [self classMode ifTrue: [self changed: #text]]]!newClassList: initialSelection	"Set the currently selected class to be initialSelection."	className _ initialSelection.	self changed: #className!selectedClass	"Answer the class object that is currently selected."	className == nil ifTrue: [^ nil].	meta		ifTrue: [^ (Smalltalk at: className) class]		ifFalse: [^ Smalltalk at: className]! !!Browser methodsFor: 'class/inst switch'!meta	"Answer true if class protocols is selected, false for the instance protocols."	^ meta!meta: aBoolean 	"Set the flag to indicate which protocols are to be selected, false 	for instance and true for class."	self changeRequest ifFalse: [^self changed: #meta].	meta _ aBoolean.	self changed: #meta.	self newProtocolList: protocol.	self classMode ifTrue: [self changed: #text]! !!Browser methodsFor: 'protocol list'!newProtocolList: initialSelection	"Set the currently selected message category to be initialSelection."	protocol _ initialSelection.	self changed: #protocol!protocol	"Answer the receiver's currently selected message category."	^ protocol!protocol: selection	"Set the receiver's currently selected message category to be selection and 	update the message selector list."	protocol _ selection.	selection == nil  "save for addProtocol"		ifFalse: [LastProtocol _ selection].	self classMode ifTrue: [^ self newSelectorList: nil].	selection isNil & className notNil ifTrue: [self textMode: #classDefinition].	self newSelectorList: selector!protocolList	"Answer the sequenceable collection containing the message categories that 	the receiver accesses from the currently selected class."	className == nil ifTrue: [^ nil].	^ self selectedClass organization categories!protocolMenu	"Answer an ActionMenu of operations on message categories to be 	displayed when the operate menu button is pressed."	"Browser flushMenus"	protocol == nil ifTrue:		[^ ActionMenu labels: 'add protocol' selectors: #(addProtocol)].	ProtocolMenu == nil ifTrue:		[ProtocolMenu _ ActionMenu			labels: 'file out\print out\spawn\add protocol\rename\remove' withCRs			lines: #(3)			selectors: #(fileOutProtocol printOutProtocol spawnProtocol addProtocol renameProtocol removeProtocol)].	^ ProtocolMenu! !!Browser methodsFor: 'selector list'!newSelectorList: initialSelection	"Set the currently selected message selector to be initialSelection."	selector _ initialSelection.	self changed: #selector!selector	"Answer the receiver's currently selected message selector."	^ selector!selector: selection 	"Set the receiver's currently selected message selector to be 	selection. If the selection has been separately removed from the 	system, then print a message to that effect in the system 	transcript, if it is open."	selector _ selection.	(selection == nil and: [protocol == nil])		ifTrue: [^self].	Dictionary keyNotFoundSignal		handle: 			[:ex | 			Transcript cr; show: 'selector ' , selector , ' no longer exists.'.			ex return]		do: ["KeyNotFoundSignal is raised when the selector name 			selected 			in a browser is already removed in another browser."			self textMode: #methodDefinition]!selectorList	"Answer the sequenceable collection containing the message selectors that 	the receiver accesses via the currently selected class and message category."	protocol == nil ifTrue: [^ nil].	^ self selectedClass organization listAtCategoryNamed: protocol!selectorMenu	"Answer an ActionMenu of operations on message selectors to be 	displayed when the operate menu button is pressed."	"Browser flushMenus"	selector == nil ifTrue: [^ nil].	MessageMenu == nil ifTrue:		[MessageMenu _ ActionMenu			labels: 'file out\print out\spawn\senders\implementors\messages\move\remove' withCRs			lines: #(3 6)			selectors: #(fileOutMessage printOutMessage spawnMethod browseSenders browseImplementors browseMessages moveMethod removeMethod)].	^ MessageMenu! !!Browser methodsFor: 'text'!prompt: promptString initially: initialString 	"Prompt the user with the message question promptString, with initial 	answer initialString, and accept the answer either with the menu 	item accept or the keyboard press RETURN. Answer the string that 	the user provides."	^FillInTheBlank 		request: promptString , 'then accept or CR' 		initialAnswer: initialString!text	"Determine the text that is selected by the current query path:		nothing if no class category is selected,		the class definition template if no class is selected,		the class's definition if a class is selected,		the method definition template if a message category is selected,		the source code if a message selector is selected,	or, if a menu selection has been made for one of		the class hierarchy		class organization		message selector organization		class comment."	| text |	textMode == #classDefinition ifTrue:		[className == nil			ifTrue: [^ (Class template: category) asText]			ifFalse: [^ self selectedClass definition asText]].	textMode == #methodDefinition ifTrue:		[selector == nil			ifTrue: [^ self selectedClass sourceCodeTemplate asText]			ifFalse: [^ (self selectedClass sourceCodeAt: selector) asText						makeSelectorBoldIn: self selectedClass]].	textMode == #category ifTrue:		[^ 'category to add' asText].	textMode == #categories ifTrue:		[^ organization printString asText].	textMode == #protocol ifTrue:		[^ 'protocol to add' asText].	textMode == #protocols ifTrue:		[^ self selectedClass organization printString asText].	textMode == #comment ifTrue:		[text _ self selectedClass comment asText.		text isEmpty ifFalse: [^ text].		self selectedClass isMeta ifTrue: [^'Select the browser switch "instance" to see the comment' asText].		^ 'This class has no comment' asText].	textMode == #hierarchy ifTrue:		[^ self selectedClass printHierarchy asText].	^ Text new!textMenu	"Answer an ActionMenu of operations on the source code that is to 	be displayed when the operate menu button is pressed."	"Browser flushMenus"	TextMenu == nil ifTrue: [TextMenu _ ActionMenu					labels: 'again\undo\copy\cut\paste\do it\print it\inspect\accept\cancel\format\spawn\explain' withCRs					lines: #(2 5 8 10 )					selectors: #(#again #undo #copySelection #cut #paste #doIt #printIt #inspectIt #accept #cancel #format #spawnEdits:from: #explain )].	^TextMenu!textMode: aSymbol 	"Set the mode for which text to display to be aSymbol, and then 	announce that the receiver has changed."	textMode _ aSymbol.	self changed: #text! !!Browser methodsFor: 'doIt/accept/explain'!acceptText: aText from: aController	"Text has been changed.  Store or compile the text, depending on 	the current mode of the receiver."	textMode == #classDefinition ifTrue:		[^ self acceptClass: aText from: aController].	textMode == #methodDefinition ifTrue:		[^ self acceptMethod: aText from: aController].	textMode == #categories ifTrue:		[organization changeFromString: aText string.		self newCategoryList: category.		^true].	textMode == #protocols ifTrue:		[self selectedClass organization changeFromString: aText string.		self selectedClass reorganize.		self selectedClass logOrganizationChange.		self textMode: #protocol; newProtocolList: nil.		^ true].	textMode == #comment ifTrue:		[self selectedClass comment: aText string.		self textMode: #comment; newProtocolList: nil.		^ true].	textMode == #hierarchy ifTrue:		[aController flash].	^ false!doItContext	"Answer the context in which a text selection can be evaluated."	^ nil!doItReceiver	"Answer the object that should be informed of the result of evaluating a	text selection."	^ self nonMetaClass!doItValue: ignored	"Set the value to be returned when the interrupted process proceeds."!explainSpecial: string 	"Answer with a string explaining the code view selection if it is 	displaying one of the special edit functions."	| classes whole lits reply |	(textMode == #classDefinition)		ifTrue: 			["Selector parts in class definition"			string last == $: ifFalse: [^nil].			lits _ Array with: #subclass:instanceVariableNames:classVariableNames:poolDictionaries:category:.			(whole _ lits detect: [:each | (each keywords					detect: [:frag | frag = string] ifNone: []) ~~ nil]						ifNone: []) ~~ nil				ifTrue: [reply _ '"' , string , ' is one part of the message selector ' , whole , '.']				ifFalse: [^nil].			classes _ Smalltalk allClassesImplementing: whole.			classes _ 'these classes ' , classes printString.			^reply , '  It is defined in ' , classes , '."Smalltalk browseAllImplementorsOf: #' , whole].	textMode == #hierarchy		ifTrue: 			["Instance variables in subclasses"			classes _ self selectedClass allSubclasses.			classes _ classes detect: [:each | (each instVarNames						detect: [:name | name = string] ifNone: []) ~~ nil]					ifNone: [^nil].			classes _ classes printString.			^'"is an instance variable in class ' , classes , '."' , classes , ' browseAllAccessesTo: ''' , string , '''.'].	^nil! !!Browser methodsFor: 'change management'!logProtocolChange: aString	"Add aString, which is an executable account of the last protocol change (rename,	remove, selector move) to the changes file."	Smalltalk logChange: aString! !!Browser methodsFor: 'private-category functions'!addCategory	"Prompt the user for a new category name. Insert the category into 	the class organization before the currently selected category."	| aString newCategory |	self changeRequest ifFalse: [^self].	aString _ self prompt: 'Enter new category name' initially: 'category name'.	aString isEmpty ifTrue: [^self].	newCategory _ aString asSymbol.	organization addCategory: newCategory before: category.	Smalltalk changes reorganizeSystem.	self newCategoryList: newCategory!editCategories	self changeRequest ifFalse: [^self].	self textMode: #categories!fileOutCategory	| fileName aFileStream |	fileName _ Filename request: 'File out on' initially: (category, '.st') shouldExist: false. 	fileName = '' ifTrue: [^nil].	aFileStream _ (Filename named: fileName) writeStream.	[organization fileOutCategory: category on: aFileStream]		valueNowOrOnUnwindDo: [aFileStream close]!findClass	"Prompt for a class and position myself there."	| testClass |	testClass _ self pickAClass: 'Find class:'.	testClass == nil		ifTrue: [^Transcript cr; show: 'Nobody'].	testClass isBehavior ifFalse: [testClass _ testClass class].	testClass isMeta ifTrue: [testClass _ testClass soleInstance].	self changeRequest ifFalse: [^self].	self newCategoryList: testClass category.		self newClassList: testClass name!pickAClass: prompt		"Choose a class with a prompter.  Bring up menu for wildcards."	| destClassName destClass classes chosenSelector |	destClassName _ FillInTheBlank request: prompt initialAnswer: '*'. 	destClassName = '' ifTrue: [^nil].	(destClassName findString: '*' startingAt: 1) ~=0		ifTrue: [classes _ OrderedCollection new.				Cursor execute showWhile:					[classes _ Smalltalk classNames select: [ :cn | destClassName match: cn]].				(classes == nil or: [classes size = 0]) ifTrue: [^nil].				(chosenSelector _ (PopUpMenu labelList: (Array with: classes)) startUp) = 0						ifTrue: [^nil]						ifFalse: [destClassName _ classes at: chosenSelector]]		ifFalse: [destClassName _ 					Smalltalk keys 						detect: [ :cn | destClassName match: cn] 						ifNone: [^nil]].	destClass _ Smalltalk at: destClassName asSymbol ifAbsent: [^nil].	meta ifTrue: [destClass _ destClass class].	^destClass!printOutCategory		"Default to being the same as file out."			self fileOutCategory!removeCategory	| classes |	self changeRequest ifFalse: [^self].	classes _ organization superclassOrder: category.	classes isEmpty ifFalse:		[(self confirm: 'Are you certain that you want toremove all classes in this category?') ifFalse: [^self].		classes reverseDo: [:cls | cls removeFromSystem]].	organization removeCategory: category.	Smalltalk changes reorganizeSystem.	self newCategoryList: nil!renameCategory	| aString newCategory |	self changeRequest ifFalse: [^self].	aString _ self prompt: 'Enter new category name' initially: category.	aString isEmpty ifTrue: [^ self].	newCategory _ aString asSymbol.	(organization renameCategory: category to: newCategory)		ifTrue:			[Smalltalk changes reorganizeSystem.			self newCategoryList: newCategory]!spawnCategory	BrowserView openCategoryBrowserOn: self copy!updateCategories	self changeRequest ifFalse: [^self].	self newCategoryList: category! !!Browser methodsFor: 'private-class functions'!acceptClass: aText from: aController 	| oldClass class name|	oldClass _ className == nil ifTrue: [Object] ifFalse: [self selectedClass].	class _ oldClass subclassDefinerClass				evaluate: aText string				notifying: aController				logged: true.	class isBehavior		ifTrue: [class isMeta					ifTrue: [name _ class soleInstance name]					ifFalse: [name _ class name].				self newClassList: name.  ^true]		ifFalse: [^false]!browseClassReferences	Smalltalk browseAllCallsOn: (Smalltalk associationAt: className)!browseClassVariables	"Show a menu of all class variables of the currently selected class  	and its superclasses.  Browse all methods which refer to the variable selected."	| association selectedClass |	selectedClass _ self nonMetaClass.	association _ selectedClass		showVariableMenu: [:class | class classPool associations asSortedCollection]		collect: [:assoc | assoc key].	association notNil ifTrue:		[BrowserView			openListBrowserOn: (selectedClass allCallsOn: association)			label: 'Users of ' , association key			initialSelection: association key]!browseFieldReferences	"Show a menu of all instance variables of the currently selected class  	and its superclasses.  Browse all methods which refer to the variable selected."	| name |	name _ self selectedClass showVariableMenu: [:class | class instVarNames]				collect: [:cname | cname].	name notNil ifTrue:		[BrowserView			openListBrowserOn: (self selectedClass allAccessesTo: name)			label: name			initialSelection: name]!browseHierarchy	"I am a copy; put me in the right state to browse a hierarchy"	category _ '**Hierarchy**'.	self meta: false!classMode	^#(classDefinition hierarchy comment protocols) includes: textMode!editClass	self changeRequest ifFalse: [^self].	self textMode: #classDefinition.	self newProtocolList: nil!editComment	self changeRequest ifFalse: [^self].	self textMode: #comment.	self newProtocolList: nil!editProtocols	self changeRequest ifFalse: [^self].	self textMode: #protocols.	self newProtocolList: nil!fileOutClass	| fileName fileStream |	fileName _ Filename request: 'File out on' initially: (self nonMetaClass name, '.st') shouldExist: false. 	fileName = '' ifTrue: [^nil].	fileStream _ (Filename named: fileName) writeStream.	[fileStream timeStamp.	self nonMetaClass fileOutOn: fileStream.]		valueNowOrOnUnwindDo: [fileStream close].	self nonMetaClass removeFromChanges.!findMethodAndSelectAlphabetic	"Show a menu of the methods implemented by this class.  Select the chosen one."	| chosenSelector selectorCollection |	(selectorCollection _ self selectedClass organization elements asSortedCollection) size = 0		ifTrue: [^self].	chosenSelector _ (PopUpMenu labelList: (Array with: selectorCollection)) startUp.	chosenSelector _ chosenSelector = 0		ifTrue: [nil]		ifFalse: [selectorCollection at: chosenSelector].	chosenSelector isNil		ifFalse: [self newProtocolList: (self selectedClass whichCategoryIncludesSelector: chosenSelector).				self newSelectorList: chosenSelector]!nonMetaClass	"Answer the class that is currently selected (nil of none), even	if looking at the metaClass."	| classOrNil |	classOrNil _ self selectedClass.	(meta and: [classOrNil ~~ nil])		ifTrue: [classOrNil _ classOrNil soleInstance].	^classOrNil!printOutClass	"Default to filing out the class."		self fileOutClass!promptClass	self newClassList: nil.	self textMode: #classDefinition!removeClass	| class | 	self changeRequest ifFalse: [^self].	Dictionary keyNotFoundSignal 		handle: [:ex | Transcript cr; show: 'can''t remove the class. class ', className, ' no longer exists.'. 				ex return]				"KeyNotFoundSignal is raised when the class name to be removed 				in a browser is already removed in another browser."		do: [class _ self nonMetaClass.			(self confirm: 'Are you certain that youwant to remove the class ', class name, '?')				ifTrue: 				[class subclasses size > 0					ifTrue: [self notify: class name , ' has subclasses'].				class removeFromSystem.				self newClassList: nil]]!renameClass	| aString newName cleanString |	self changeRequest ifFalse: [^self].	aString _ self prompt: 'Enter new ClassName' initially: self nonMetaClass name.	aString isEmpty ifTrue: [^self].	cleanString _ aString select: [:char | char isLetter or: [char isDigit]].	cleanString = aString		ifFalse: [aString _ cleanString.				(self confirm: 'Invalid characters in class name.  Should I use ', aString, '?')					ifFalse: [^self]].	aString first isLowercase		ifTrue: [aString at: 1 put: (aString at: 1) asUppercase.				(self confirm: 'Class names must be capitalized.  Should I use ', aString, '?')					ifFalse: [^self]].	newName _ aString asSymbol.	aString = self nonMetaClass name		ifFalse:			[self nonMetaClass rename: newName.		self newClassList: newName.		Transcript cr; show: 'Searching for references to this class...'.		self browseClassReferences]!showHierarchy	self changeRequest ifFalse: [^self].	self textMode: #hierarchy.	self newProtocolList: nil!spawnClass	BrowserView openClassBrowserOn: self copy!spawnHierarchy	BrowserView openCategoryBrowserOn: self copy browseHierarchy! !!Browser methodsFor: 'private-protocol functions'!addProtocol	| aString newProtocol |	self changeRequest ifFalse: [^self].	aString _ self			prompt: 'Enter new protocol name'			initially: (LastProtocol == nil ifTrue: ['protocol name'] ifFalse: [LastProtocol]).	aString isEmpty ifTrue: [^ self].	newProtocol _ aString asSymbol.	self selectedClass organization addCategory: newProtocol before: protocol.	self logProtocolChange: self selectedClass name, ' organization addCategory: ', newProtocol storeString, ' before: ', protocol storeString.	self selectedClass reorganize.	self newProtocolList: newProtocol!fileOutProtocol	|fileName fileStream|	fileName _ Filename request: 'File out on' initially: (self selectedClass name, '-', protocol, '.st') shouldExist: false. 	fileName = '' ifTrue: [^nil].	fileStream _ (Filename named: fileName) writeStream.	[fileStream timeStamp.	self selectedClass fileOutCategory: protocol		on: fileStream		moveSource: false		toFile: 0]		valueNowOrOnUnwindDo: [fileStream close]!printOutProtocol	"Default to filing out."	self fileOutProtocol!removeProtocol	| selectors |	self changeRequest ifFalse: [^self].	selectors _ self selectedClass organization listAtCategoryNamed: protocol.	selectors isEmpty ifFalse:		[(self confirm: 'Are you certain that you want toremove all methods in this protocol?') ifFalse: [^self].		selectors do: [:sel | self selectedClass removeSelector: sel]].	self selectedClass organization removeCategory: protocol.	self logProtocolChange: self selectedClass name, ' organization removeCategory: ', protocol storeString.	self selectedClass reorganize.	self newProtocolList: nil!renameProtocol	| aString newProtocol |	self changeRequest ifFalse: [^self].	aString _ self prompt: 'Enter new protocol name' initially: protocol.	aString isEmpty ifTrue: [^ self].	newProtocol _ aString asSymbol.	(self selectedClass organization renameCategory: protocol to: newProtocol)		ifTrue:			[self logProtocolChange: self selectedClass name, ' organization renameCategory: ', protocol storeString, ' to: ', newProtocol storeString.self selectedClass reorganize.			self newProtocolList: newProtocol]!spawnProtocol	BrowserView openProtocolBrowserOn: self copy! !!Browser methodsFor: 'private-selector functions'!acceptMethod: aText from: aController	| newSelector |	newSelector _ self selectedClass				compile: aText				classified: protocol				notifying: aController.	newSelector == nil ifTrue: [^false].	newSelector == selector		ifFalse: [self newSelectorList: newSelector].	^true!browseImplementors	Smalltalk browseAllImplementorsOf: selector!browseMessages	Smalltalk showMenuThenBrowse:		(self selectedClass compiledMethodAt: selector)			messages asSortedCollection!browseSenders	Smalltalk browseAllCallsOn: selector!fileOutMessage	| fileName fileStream sel |	selector isKeyword		ifTrue: [sel _ WriteStream on: (String new: 20).				selector keywords do: [:each | sel nextPutAll: (each copyFrom: 1 to: each size - 1)].				sel _ sel contents]		ifFalse: [sel _ selector].	fileName _ Filename request: 'File out on' initially: (self selectedClass name, '-', sel, '.st') shouldExist: false. 	fileName = '' ifTrue: [^nil].	fileStream _ (Filename named: fileName) writeStream.	[fileStream timeStamp.	self selectedClass		fileOutMessage: selector		on: fileStream		moveSource: false		toFile: 0]		valueNowOrOnUnwindDo: [fileStream close]!moveMethod	| newProtocol classPart destClass protStart moved destClassName |	self changeRequest ifFalse: [^self].	newProtocol _ self prompt: 'Type destination protocol(Class>protocol will copy)' initially: MethodMoveProtocol.	newProtocol isEmpty ifTrue: [^self].	MethodMoveProtocol _ newProtocol.	moved _ false.	(newProtocol includes: $>)		ifTrue: 			["copy to another class"			classPart _ newProtocol copyUpTo: $>.			destClassName _ classPart copyUpTo: Character space.			destClass _ Smalltalk at: destClassName asSymbol ifAbsent: [nil].			destClass isBehavior				ifFalse: [(Display flash: Display boundingBox). ^nil].			classPart size = destClassName size				ifFalse:					[(classPart size-destClassName size = 6						and: [(classPart copyFrom: classPart size - 5 to: classPart size) = ' class'])								ifTrue: [destClass _ destClass class]								ifFalse: [(Display flash: Display boundingBox). ^nil]].			protStart _ classPart size + 2.			[(newProtocol at: protStart) = $ ]				whileTrue: [protStart _ protStart + 1].			newProtocol _ (newProtocol copyFrom: protStart to: newProtocol size) asSymbol.			destClass == self selectedClass				ifFalse:					[moved _ true.					destClass compile: self text classified: newProtocol notifying: nil]]		ifFalse: 			["move within this class"			destClass _ self selectedClass.			newProtocol _ newProtocol asSymbol].	moved		ifFalse: 			[(destClass organization categories includes: newProtocol)				ifFalse: 					[destClass organization addCategory: newProtocol.					self newProtocolList: protocol].			destClass organization classify: selector under: newProtocol.			self logProtocolChange: destClass name , ' organization classify: '								, selector storeString , ' under: ' , newProtocol storeString.			destClass reorganize].	self newSelectorList: selector!printOutMessage	"Default to filing out."	self fileOutMessage!removeMethod	(self changeRequest and: [self confirm: 'Are you certain that youwant to remove this method?'])		ifTrue: 			[self selectedClass removeSelector: selector.			self newSelectorList: nil.			^ true].	^ false!spawnEdits: aText from: aController	| newController | 	newController _ aController copy.  "Copy gets the changes"	aController cancel; controlTerminate.   "Cancel changes in spawning browser"	category == nil ifTrue: [BrowserView openOn: self copy withController: newController].	className == nil ifTrue: [BrowserView openCategoryBrowserOn: self copy withController: newController].	protocol == nil ifTrue: [BrowserView openClassBrowserOn: self copy withController: newController].	selector == nil ifTrue: [BrowserView openProtocolBrowserOn: self copy withController: newController].	BrowserView openMethodBrowserOn: self copy withController: newController!spawnMethod	BrowserView openMethodBrowserOn: self copy! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Browser class	instanceVariableNames: ''!!Browser class methodsFor: 'class initialization'!flushMenus 	"Cause all menus to be newly created (so changes appear)." 	"Browser flushMenus."	MethodMoveProtocol _ 'protocol name'.	LastProtocol _ nil.	CategoryMenu _ nil.	ClassMenu _ nil.	MessageMenu _ nil.	ProtocolMenu _ nil.	TextMenu _ nil! !!Browser class methodsFor: 'instance creation'!newOnClass: aClass	"Create and schedule a view that is a browser for the class aClass."	BrowserView openClassBrowserOn: (self new onClass: aClass)! !StandardSystemView subclass: #BrowserView	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Tools-Programming'!BrowserView comment:'A BrowserView is a StandardSystemView that provides initialization methods (messages to itself) to create and schedule the various system browsers:  System Browser, System Category Browser, Class Browser, Message Category Browser, Message Browser.'!!BrowserView methodsFor: 'private-subview creation'!addCategoryView: area on: aBrowser readOnly: RO	self addSubView:		(SelectionInListView on: aBrowser printItems: false oneItem: RO			aspect: #category change: #category: list: #categoryList			menu: #categoryMenu initialSelection: #category)		in: area borderWidth: 1!addClassView: area on: aBrowser readOnly: RO	self addSubView:		(SelectionInListView on: aBrowser printItems: false oneItem: RO			aspect: #className change: #className: list: #classList			menu: #classMenu initialSelection: #className)		in: area borderWidth: 1!addMetaView: area on: aBrowser readOnly: ingored	| mid |	mid _ (area left + area right) * 0.5.	self addSubView: (BooleanView on: aBrowser aspect: #meta			label: 'instance' asText change: #meta: value: false)		in: (area copy right: mid) borderWidth: 1.	self addSubView: (BooleanView on: aBrowser aspect: #meta			label: 'class' asText change: #meta: value: true)		in: (area copy left: mid) borderWidth: 1!addMethodView: area on: aBrowser readOnly: RO	self addSubView:		(SelectionInListView on: aBrowser printItems: false oneItem: RO			aspect: #methodName change: #methodName: list: #methodList			menu: #methodMenu initialSelection: #methodName)		in: area borderWidth: 1!addProtocolView: area on: aBrowser readOnly: RO	self addSubView:		(SelectionInListView on: aBrowser printItems: false oneItem: RO			aspect: #protocol change: #protocol: list: #protocolList			menu: #protocolMenu initialSelection: #protocol)		in: area borderWidth: 1!addSelectorView: area on: aBrowser readOnly: RO	self addSubView:		(SelectionInListView on: aBrowser printItems: false oneItem: RO			aspect: #selector change: #selector: list: #selectorList			menu: #selectorMenu initialSelection: #selector)		in: area borderWidth: 1!addTextView: area on: aBrowser initialSelection: sel	self addSubView:			(CodeView on: aBrowser aspect: #text change: #acceptText:from:				menu: #textMenu initialSelection: sel)		in: area borderWidth: 1! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!BrowserView class	instanceVariableNames: ''!!BrowserView class methodsFor: 'instance creation'!openCategoryBrowserOn: aBrowser	"Create and schedule a browser on the category of classes selected by aBrowser or on a hierarchy of classes."	| topView |	(topView _ self model: aBrowser label: (aBrowser category, ' Category Browser') minimumSize: 400@250)		addCategoryView: (0@0 extent: 0.3@0.06) on: aBrowser readOnly: true;		addClassView: (0@0.06 extent: 0.3@0.28) on: aBrowser readOnly: false;		addMetaView: (0@0.34 extent: 0.3@0.06) on: aBrowser readOnly: false;		addProtocolView: (0.3@0 extent: 0.3@0.4) on: aBrowser readOnly: false;		addSelectorView: (0.6@0 extent: 0.4@0.4) on: aBrowser readOnly: false;		addTextView: (0@0.4 extent: 1.0@0.6) on: aBrowser initialSelection: nil.	topView controller open!openCategoryBrowserOn: aBrowser withController: aController	"Create and schedule a browser on the category of classes selected by aBrowser 	or on a hierarchy of classes.  Set the topview's controller to a be aController."	| topView textView |	(topView _ self model: aBrowser label: (aBrowser category, ' Category Browser') minimumSize: 400@250)		addCategoryView: (0@0 extent: 0.3@0.06) on: aBrowser readOnly: true;		addClassView: (0@0.06 extent: 0.3@0.28) on: aBrowser readOnly: false;		addMetaView: (0@0.34 extent: 0.3@0.06) on: aBrowser readOnly: false;		addProtocolView: (0.3@0 extent: 0.3@0.4) on: aBrowser readOnly: false;		addSelectorView: (0.6@0 extent: 0.4@0.4) on: aBrowser readOnly: false.	textView _ CodeView				on: aBrowser				aspect: #text				change: #acceptText:from:				menu: #textMenu				initialSelection: nil.	textView controller: aController.	topView		addSubView: textView		in: (0@0.4 extent: 1.0@0.6)		borderWidth: 1.	topView controller open!openClassBrowserOn: aBrowser	"Create and schedule a browser on the class currently selected by aBrowser."	| topView |	(topView _ self model: aBrowser label: (aBrowser className,' Class Browser') minimumSize: 400@250)		addClassView: (0@0 extent: 0.5@0.1) on: aBrowser readOnly: true;		addMetaView: (0.5@0 extent: 0.5@0.1) on: aBrowser readOnly: false;		addProtocolView: (0@0.1 extent: 0.5@0.3) on: aBrowser readOnly: false;		addSelectorView: (0.5@0.1 extent: 0.5@0.3) on: aBrowser readOnly: false;		addTextView: (0@0.4 extent: 1.0@0.6) on: aBrowser initialSelection: nil.	topView controller open!openClassBrowserOn: aBrowser withController: aController	"Create and schedule a browser on the class currently selected selected by aBrowser 	or on a hierarchy of classes.  Set the topview's controller to a be aController."	| topView textView |	(topView _ self model: aBrowser label: (aBrowser className,' Class Browser') minimumSize: 400@250)		addClassView: (0@0 extent: 0.5@0.1) on: aBrowser readOnly: true;		addMetaView: (0.5@0 extent: 0.5@0.1) on: aBrowser readOnly: false;		addProtocolView: (0@0.1 extent: 0.5@0.3) on: aBrowser readOnly: false;		addSelectorView: (0.5@0.1 extent: 0.5@0.3) on: aBrowser readOnly: false.	textView _ CodeView				on: aBrowser				aspect: #text				change: #acceptText:from:				menu: #textMenu				initialSelection: nil.	textView controller: aController.	topView		addSubView: textView		in: (0@0.4 extent: 1.0@0.6)		borderWidth: 1.	topView controller open!openListBrowserOn: aCollection label: labelString	"Create and schedule a browser on the collection of messages aCollection.  Label the topview labelString."	self openListBrowserOn: aCollection label: labelString initialSelection: nil!openListBrowserOn: aCollection label: labelString initialSelection: selector 	"Create and schedule a browser on the collection of messages 	aCollection. Label the topview labelString. If the collection is empty, 	print -Nobody- in the System Transcript."	| topView aBrowser label |	aCollection isEmpty ifTrue: [^Transcript cr; show: 'Nobody'].	aBrowser _ MethodListBrowser new on: aCollection.	label _ (labelString isKindOf: LookupKey)				ifTrue: [labelString key]				ifFalse: [labelString asString].	topView _ self				model: aBrowser				label: label				minimumSize: 300 @ 100.	topView		addMethodView: (0 @ 0 extent: 1.0 @ 0.25)		on: aBrowser		readOnly: false;		addTextView: (0 @ 0.25 extent: 1 @ 0.75)		on: aBrowser		initialSelection: selector.	topView controller open!openMethodBrowserOn: aBrowser 	"Create and schedule a browser on the method currently selected by aBrowser."	| topView |	(topView _ self				model: aBrowser				label: 'Method Browser on ' , aBrowser selectedClass name				minimumSize: 250 @ 120)		addSelectorView: (0 @ 0 extent: 1 @ 0.15)		on: aBrowser		readOnly: true;		addTextView: (0 @ 0.15 extent: 1 @ 0.85)		on: aBrowser		initialSelection: nil.	topView controller open!openMethodBrowserOn: aBrowser withController: aController 	"Create and schedule a browser on the method currently selected by aBrowser.  	Set the topview's controller to a be aController.  The method may contain changes 	that haven't already been accepted "	| topView textView |	topView _ self				model: aBrowser				label: 'Method Browser on ' , aBrowser selectedClass name				minimumSize: 250 @ 120.	topView		addSelectorView: (0 @ 0 extent: 1 @ 0.15)		on: aBrowser		readOnly: true.	textView _ CodeView				on: aBrowser				aspect: #text				change: #acceptText:from:				menu: #textMenu				initialSelection: nil.	textView controller: aController.	topView		addSubView: textView		in: (0 @ 0.15 extent: 1 @ 0.85)		borderWidth: 1.	topView controller open!openOn: anOrganizer 	"Create and schedule a browser on an entire collection of organized 	classes. For example, evaluate 		BrowserView openOn: SystemOrganization."	| topView aBrowser topY bottomY metaY |	aBrowser _ Browser new on: anOrganizer.	topY _ 0.35.	"change this to re-proportion system browser"	bottomY _ 1 - topY.	metaY _ 0.05.	"change this to re-proportion system browser"	(topView _ self model: aBrowser label: 'System Browser' minimumSize: 400 @ 250)		addCategoryView: (0 @ 0 extent: 0.25 @ topY) on: aBrowser readOnly: false;		addClassView: (0.25 @ 0 extent: 0.25 @ (topY - metaY)) on: aBrowser readOnly: false;		addMetaView: (0.25 @ (topY - metaY) extent: 0.25 @ metaY) on: aBrowser readOnly: false;		addProtocolView: (0.5 @ 0 extent: 0.25 @ topY) on: aBrowser readOnly: false;		addSelectorView: (0.75 @ 0 extent: 0.25 @ topY) on: aBrowser readOnly: false;		addTextView: (0 @ topY extent: 1.0 @ bottomY) on: aBrowser initialSelection: nil.	topView icon: (Icon constantNamed: #default).	topView controller open!openOn: aBrowser withController: aController	"Create and schedule a browser on an entire collection of organized 	classes.   Set the controller for the topview to be aController.	aController may contain changes that haven't already been accepted."	| topView textView |	(topView _ self model: aBrowser label: 'System Browser' minimumSize: 400@250)		addCategoryView: (0@0 extent: 0.25@0.4) on: aBrowser readOnly: false;		addClassView: (0.25@0 extent: 0.25@0.34) on: aBrowser readOnly: false;		addMetaView: (0.25@0.34 extent: 0.25@0.06) on: aBrowser readOnly: false;		addProtocolView: (0.5@0 extent: 0.25@0.4) on: aBrowser readOnly: false;		addSelectorView: (0.75@0 extent: 0.25@0.4) on: aBrowser readOnly: false.	textView _ CodeView 					on: aBrowser aspect: #text change: #acceptText:from:					menu: #textMenu initialSelection: nil.	textView controller: aController.	topView addSubView: textView in: (0@0.4 extent: 1@0.6) borderWidth: 1.	topView controller open!openProtocolBrowserOn: aBrowser	"Create and schedule a browser on the message category currently selected by aBrowser."	| topView |	(topView _ self model: aBrowser label: aBrowser selectedClass name, ' Protocol Browser'					minimumSize: 400@200)		addProtocolView: (0@0 extent: 1@0.1) on: aBrowser readOnly: true;		addSelectorView: (0@0.1 extent: 1@0.3) on: aBrowser readOnly: false;		addTextView: (0@0.4 extent: 1.0@0.6) on: aBrowser initialSelection: nil.	topView controller open!openProtocolBrowserOn: aBrowser withController: aController	"Create and schedule a browser on the category of messages selected by aBrowser 	or on a hierarchy of classes.  Set the topview's controller to a be aController."	| topView textView |	(topView _ self model: aBrowser label: aBrowser selectedClass name, ' Protocol Browser'					minimumSize: 400@200)		addProtocolView: (0@0 extent: 1@0.1) on: aBrowser readOnly: true;		addSelectorView: (0@0.1 extent: 1@0.3) on: aBrowser readOnly: false.	textView _ CodeView				on: aBrowser				aspect: #text				change: #acceptText:from:				menu: #textMenu				initialSelection: nil.	textView controller: aController.	topView		addSubView: textView		in: (0@0.4 extent: 1.0@0.6)		borderWidth: 1.	topView controller open! !UnixTtyOptions variableByteSubclass: #BsdTtyOptions	instanceVariableNames: ''	classVariableNames: 'LocalModes SgFlags '	poolDictionaries: ''	category: 'OS-Unix'!BsdTtyOptions comment:'Class BsdTtyOptions represents a bsd tty options structure -- but unfortunately, bsd doesn''t really have just one.  So we jammed all of them together to make something like the sys5 termio struct:struct bogus_termio {	long b_discipline;			/* line discipline */	struct /* sgttyb */ {		char sg_ispeed;			/* input speed */		char sg_ospeed;		/* output speed */		char sg_erase;			/* erase character */		char sg_kill;			/* kill character */		short sg_flags;			/* flags */	} b_sgttyb;	u_char b_tchars[6];		/* more control chars */	long b_localMode;			/* local modes */	u_char b_ltchars[6];		/* yet more control chars */};To know what all these fields really signify, see the man pages for TTY(4).Class Variables:	LocalModes		<IdentityDictionary>	SgFlags			<IdentityDictionary>'!!BsdTtyOptions methodsFor: 'accessing'!echo: bool 	"Set into/outof echo mode according to boolean arg."	| f |	f _ self flags.	bool		ifTrue: [self flags: (f maskSet: (SgFlags at: #ECHO))]		ifFalse: [self flags: (f maskClear: (SgFlags at: #ECHO))]!parity: p 	"Set the option value for tty parity. 	p = 1, odd parity. 	p = 0, even parity. 	p = nil, no parity. 	Affects generation on output, and checking on input. 	returns self."	| m f |	m _ ((SgFlags at: #ODDP)				bitOr: (SgFlags at: #EVENP)) bitInvert.	f _ self flags.	p isNil		ifTrue: [self flags: (f bitAnd: m)]		ifFalse: [self flags: ((f bitAnd: m)					bitOr: (SgFlags at: (p even								ifTrue: [#EVENP]								ifFalse: [#ODDP])))]!speed: s	"Set the line speed (baud)."	self speedCode: (Speeds keyAtValue: s).	self oSpeedCode: (Speeds keyAtValue: s)! !!BsdTtyOptions methodsFor: 'byte order reversal'!reverseByteOrder	"Reverse the byte order for dealing with platform switch on snapshot return."	self swapLongAt: 1.	self swapShortAt: 9.	self swapLongAt: 17! !!BsdTtyOptions methodsFor: 'utilities'!isBinary	"See if the tty seems to be in binary mode"	^(self flags bitAnd: (SgFlags at: #RAW)) ~= 0!setBinary	"Set modes suitable for binary data xfer.  No flow control provided for!!"	| f lm |	f _ self flags.	lm _ self localMode.	f _ f maskClear: (SgFlags at: #ALLDELAY).	f _ f maskClear: (SgFlags at: #CRMOD).	f _ f maskSet: (SgFlags at: #RAW).	f _ f maskClear: (SgFlags at: #ECHO).	f _ f maskClear: (SgFlags at: #LCASE).	f _ f maskClear: (SgFlags at: #CBREAK).	f _ f maskClear: (SgFlags at: #TANDEM).	self flags: f.	lm _ lm maskClear: (LocalModes at: #CRTBS).	lm _ lm maskClear: (LocalModes at: #PRTERA).	lm _ lm maskClear: (LocalModes at: #CRTERA).	lm _ lm maskClear: (LocalModes at: #TILDE).	lm _ lm maskClear: (LocalModes at: #MDMBUF).	lm _ lm maskSet: (LocalModes at: #LITOUT).	lm _ lm maskClear: (LocalModes at: #TOSTOP).	lm _ lm maskSet: (LocalModes at: #CRTKIL).	lm _ lm maskSet: (LocalModes at: #PASS8).	lm _ lm maskClear: (LocalModes at: #CTLECH).	lm _ lm maskClear: (LocalModes at: #PENDIN).	lm _ lm maskSet: (LocalModes at: #DECCTQ).	lm _ lm maskClear: (LocalModes at: #NOFLSH).	self localMode: lm!setDumbTerminal	"Set modes suitable for dumb terminal emulation.	Turns on XON/XOFF flow control, and turns off most	of the other IO processing"	| f lm |	f _ self flags.	lm _ self localMode.	f _ f maskClear: (SgFlags at: #ALLDELAY).	f _ f maskClear: (SgFlags at: #CRMOD).	f _ f maskClear: (SgFlags at: #RAW).	f _ f maskClear: (SgFlags at: #ECHO).	f _ f maskClear: (SgFlags at: #LCASE).	f _ f maskSet: (SgFlags at: #CBREAK).	f _ f maskSet: (SgFlags at: #TANDEM).	self flags: f.	lm _ lm maskClear: (LocalModes at: #CRTBS).	lm _ lm maskClear: (LocalModes at: #PRTERA).	lm _ lm maskClear: (LocalModes at: #CRTERA).	lm _ lm maskClear: (LocalModes at: #TILDE).	lm _ lm maskClear: (LocalModes at: #MDMBUF).	lm _ lm maskSet: (LocalModes at: #LITOUT).	lm _ lm maskClear: (LocalModes at: #TOSTOP).	lm _ lm maskSet: (LocalModes at: #CRTKIL).	lm _ lm maskSet: (LocalModes at: #PASS8).	lm _ lm maskClear: (LocalModes at: #CTLECH).	lm _ lm maskClear: (LocalModes at: #PENDIN).	lm _ lm maskSet: (LocalModes at: #DECCTQ).	lm _ lm maskClear: (LocalModes at: #NOFLSH).	self localMode: lm!setGlassCooked	"Set modes suitable for crt emulation."	| f lm |	f _ self flags.	lm _ self localMode.	f _ f maskClear: (SgFlags at: #ALLDELAY).	f _ f maskSet: (SgFlags at: #CRMOD).	f _ f maskClear: (SgFlags at: #XTABS). "Set"	f _ f maskClear: (SgFlags at: #RAW).	f _ f maskSet: (SgFlags at: #ECHO). "Set"	f _ f maskClear: (SgFlags at: #LCASE).	f _ f maskClear: (SgFlags at: #CBREAK).	f _ f maskClear: (SgFlags at: #TANDEM).	f _ f maskSet: (SgFlags at: #ODDP). "GHU"	f _ f maskSet: (SgFlags at: #EVENP). "GHU"	self flags: f.	lm _ lm maskSet: (LocalModes at: #CRTBS).	lm _ lm maskClear: (LocalModes at: #PRTERA).	lm _ lm maskSet: (LocalModes at: #CRTERA).	lm _ lm maskClear: (LocalModes at: #TILDE).	lm _ lm maskClear: (LocalModes at: #MDMBUF).	lm _ lm maskClear: (LocalModes at: #LITOUT).	lm _ lm maskClear: (LocalModes at: #TOSTOP).	lm _ lm maskSet: (LocalModes at: #CRTKIL).	lm _ lm maskClear: (LocalModes at: #PASS8).	lm _ lm maskSet: (LocalModes at: #CTLECH).	lm _ lm maskClear: (LocalModes at: #PENDIN).	lm _ lm maskSet: (LocalModes at: #DECCTQ).	lm _ lm maskClear: (LocalModes at: #NOFLSH).	self localMode: lm! !!BsdTtyOptions methodsFor: 'printing'!printOn: aStream	"Append to the argument aStream a sequence of characters that identifies the receiver."	super printOn: aStream.	aStream nextPut: $(.	self printDisciplineOn: aStream.	aStream nextPutAll: ', '.	self printLocalModeOn: aStream.	aStream nextPutAll: ', '.	self printSgttybOn: aStream.	aStream space.	self printTcharsOn: aStream.	aStream space.	self printLtCharsOn: aStream.	aStream nextPut: $)! !!BsdTtyOptions methodsFor: 'private-printing'!printFlagsOn: aStream 	| sf |	sf _ self flags.	aStream nextPutAll: 'flags:'.	SgFlags		associationsDo: 			[:a | 			(a value bitAnd: sf) = 0				ifTrue: [aStream nextPutAll: ' no-']				ifFalse: [aStream space].			aStream print: a key]!printLocalModeOn: aStream 	| lm |	lm _ self localMode.	aStream nextPutAll: 'localModes:'.	LocalModes		associationsDo: 			[:a | 			(a value bitAnd: lm)				= 0				ifTrue: [aStream nextPutAll: ' no-']				ifFalse: [aStream space].			aStream print: a key]!printLtCharsOn: aStream	aStream nextPutAll: 'susp:"'.	aStream nextPutAll: (self class controlCharAsString: (self byteAt: 21)).	aStream nextPutAll: '" '.	aStream nextPutAll: 'dsusp:"'.	aStream nextPutAll: (self class controlCharAsString: (self byteAt: 22)).	aStream nextPutAll: '" '.	aStream nextPutAll: 'rprnt:"'.	aStream nextPutAll: (self class controlCharAsString: (self byteAt: 23)).	aStream nextPutAll: '" '.	aStream nextPutAll: 'flush:"'.	aStream nextPutAll: (self class controlCharAsString: (self byteAt: 24)).	aStream nextPutAll: '" '.	aStream nextPutAll: 'weras:"'.	aStream nextPutAll: (self class controlCharAsString: (self byteAt: 25)).	aStream nextPutAll: '" '.	aStream nextPutAll: 'lnext:"'.	aStream nextPutAll: (self class controlCharAsString: (self byteAt: 26)).	aStream nextPutAll: '"'!printSgttybOn: aStream	| is os |	self printFlagsOn: aStream.	is _ self speed.	os _ self ospeed.	aStream nextPutAll: ', speed '.	aStream nextPutAll: (is <= 0 ifTrue: ['unknown'] ifFalse: [is printString, ' baud']).	((os > 0) and: [os ~= is])		ifTrue: [aStream nextPutAll: ' / output '.				aStream nextPutAll: (is <= 0						ifTrue: ['unknown']						ifFalse: [os printString]).				aStream nextPutAll: ' baud'].	aStream nextPutAll: ', erase:"'.	aStream nextPutAll: (self class controlCharAsString: (self byteAt: 7)).	aStream nextPutAll: '" kill:"'.	aStream nextPutAll: (self class controlCharAsString: (self byteAt: 8)).	aStream nextPutAll: '" '.!printTcharsOn: aStream	aStream nextPutAll: 'intr:"'.	aStream nextPutAll: (self class controlCharAsString: (self byteAt: 11)).	aStream nextPutAll: '" '.	aStream nextPutAll: 'quit:"'.	aStream nextPutAll: (self class controlCharAsString: (self byteAt: 12)).	aStream nextPutAll: '" '.	aStream nextPutAll: 'start:"'.	aStream nextPutAll: (self class controlCharAsString: (self byteAt: 13)).	aStream nextPutAll: '" '.	aStream nextPutAll: 'stop:"'.	aStream nextPutAll: (self class controlCharAsString: (self byteAt: 14)).	aStream nextPutAll: '" '.	aStream nextPutAll: 'eof:"'.	aStream nextPutAll: (self class controlCharAsString: (self byteAt: 15)).	aStream nextPutAll: '" '.	aStream nextPutAll: 'brk:"'.	aStream nextPutAll: (self class controlCharAsString: (self byteAt: 16)).	aStream nextPutAll: '" '.! !!BsdTtyOptions methodsFor: 'private-accessing'!disciplineCode	^self longAt: 1!disciplineCode: d	self longAt: 1 put: d!flags	^self unsignedShortAt: 9!flags: f	self unsignedShortAt: 9 put: f!localMode	^self unsignedLongAt: 17!localMode: v	self unsignedLongAt: 17 put: v!ospeed	^Speeds at: (self oSpeedCode)!oSpeedCode	^self byteAt: 6!oSpeedCode: br	^self byteAt: 6 put: br!speedCode	^self byteAt: 5!speedCode: br	^self byteAt: 5 put: br! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!BsdTtyOptions class	instanceVariableNames: ''!!BsdTtyOptions class methodsFor: 'class initialization'!initialize	"Set up bit field name dictionaries."	"BsdTtyOptions initialize"	self initLocalModes.	self initSgFlags!initLocalModes	"Set up the dictionary giving symbolic names for local-mode bit fields."	LocalModes _ IdentityDictionary new: 15.	LocalModes at: #CRTBS put: 1.	LocalModes at: #PRTERA put: 2.	LocalModes at: #CRTERA put: 4.	LocalModes at: #TILDE put: 8r10.	LocalModes at: #MDMBUF put: 8r20.	LocalModes at: #LITOUT put: 8r40.	LocalModes at: #TOSTOP put: 8r100.	LocalModes at: #FLUSHO put: 8r200.	LocalModes at: #NOHANG put: 8r400.	LocalModes at: #CRTKIL put: 8r2000.	LocalModes at: #PASS8 put: 8r4000.	LocalModes at: #CTLECH put: 8r10000.	LocalModes at: #PENDIN put: 8r20000.	LocalModes at: #DECCTQ put: 8r40000.	LocalModes at: #NOFLSH put: 8r100000!initSgFlags	"Set up the dictionary giving symbolic names for sgflags bit fields."	SgFlags _ IdentityDictionary new: 10.	SgFlags at: #ALLDELAY put: 8r177400.	SgFlags at: #XTABS put: 8r6000.	SgFlags at: #ODDP put: 8r100.	SgFlags at: #EVENP put: 8r200.	SgFlags at: #RAW put: 8r40.	SgFlags at: #CRMOD put: 8r20.	SgFlags at: #ECHO put: 8r10.	SgFlags at: #LCASE put: 4.	SgFlags at: #CBREAK put: 2.	SgFlags at: #TANDEM put: 1! !BsdTtyOptions initialize!ExternalStream subclass: #BufferedExternalStream	instanceVariableNames: 'binary lineEndConvention ioBuffer ioConnection '	classVariableNames: ''	poolDictionaries: 'IOConstants '	category: 'OS-Streaming'!BufferedExternalStream comment:'The subclasses of class BufferedExternalStream stream over a buffered external connection and simulate streaming over a contiguous collection.  They use the stream primitives next, nextPut: and atEnd.  When position exceeds the readLimit or writeLimit, the stream primitives fail and the Smalltalk failure code gets or writes the next buffer and resets position, readLimit and writeLimit.Instance Variables:	binary				<Boolean>	lineEndConvention	<nil | Number>	ioBuffer				<IOBuffer>	ioConnection 		<ExternalConnection>Pool Dictionaries:	IOConstants	<Dictionary> of characters keyed by symbols'!!BufferedExternalStream methodsFor: 'accessing'!commit	"Commit any buffered information to the OS."	self closed		ifFalse: 			[self flush.			ioBuffer commit]!contents	"Answer with a copy of the receiver's readable information."	| newCollectionStream |	newCollectionStream _ (self contentsSpecies new: 256) writeStream.	self class endOfStreamSignal		handle: [:ex | ex return]		do: [[newCollectionStream nextPut: self next] repeat].	^newCollectionStream contents	"[ch _ self next. ch == nil] whileFalse:		[newCollectionStream nextPut: ch].	^newCollectionStream contents"!flush	"Write any unwritten information."	^self subclassResponsibility!lineEndConvention	"Answer with the character that is the end of line convention."	^lineEndConvention!lineEndConvention: aNumber	"Set the end of line convention to be the character associated with aNumber."	self openIfClosed.	(aNumber == LineEndCR or: 	[aNumber == LineEndLF or:	[aNumber == LineEndCRLF or:	[aNumber == LineEndTransparent]]])		ifTrue: [lineEndConvention _ aNumber]		ifFalse: [^self error: 'illegal line end strategy']!next: anInteger	"Answer the next anInteger elements of the receiver."	| newCollection howManyRead increment |	(lineEndConvention == LineEndCRLF and: [binary not])		 ifTrue: [^self crlfNext: anInteger].	newCollection _ self contentsSpecies new: anInteger.	anInteger = 0		ifTrue: [^newCollection].	self atEnd		ifTrue:	[^Stream incompleteNextCountSignal					raiseRequestWith: (self contentsSpecies new: 0)].	newCollection at: 1 put: self next.	howManyRead _ 1.	[howManyRead < anInteger] whileTrue:		[self atEnd			ifTrue: [(lineEndConvention == LineEndLF and: [binary not])						ifTrue: [newCollection replaceAll: LF with: CR from: 1 to: howManyRead].					^Stream incompleteNextCountSignal						raiseRequestWith: (newCollection copyFrom: 1 to: howManyRead)].		increment _ (readLimit - position) min: (anInteger - howManyRead).		newCollection			replaceFrom: (howManyRead + 1)			to: (howManyRead _ howManyRead + increment)			with: collection			startingAt: (position + 1).		position _ position + increment].	(lineEndConvention == LineEndLF and: [binary not])		ifTrue: [newCollection replaceAll: LF with: CR from: 1 to: howManyRead].	^newCollection!nextPutAll: aCollection 	"Append the elements of aCollection onto the receiver.  Answer aCollection."	|  howManyWritten increment collectionSize  |	(lineEndConvention == LineEndCRLF and: [binary not])		ifTrue: [^self crlfNextPutAll: aCollection].	(aCollection isSequenceable and: [(collectionSize _ aCollection size) > 1])		ifFalse: [aCollection do: [:v | self nextPut: v].				^aCollection].		"Write the first with nextPut to make sure we are open and that we may write."	self nextPut: (aCollection at: 1).	position >= writeLimit		ifTrue: [self nextBuffer.				writeLimit _ ioBuffer lastWriteablePosition].	howManyWritten _ 1.	[increment _ (writeLimit - position) min: (collectionSize - howManyWritten).	collection			replaceFrom: position + 1			to: (position _ position + increment)			with: aCollection			startingAt: howManyWritten + 1.	ioBuffer bufferChanged.	(lineEndConvention == LineEndLF and: [binary not])		ifTrue: [collection replaceAll: CR with: LF from: (position - increment) + 1 to: position].	howManyWritten _ howManyWritten + increment.	howManyWritten < collectionSize] whileTrue:		[self nextBuffer.		writeLimit _ ioBuffer lastWriteablePosition].	^aCollection!size	"Answer the size of the collection the receiver streams over.	This only makes sense if the connection is a file."	self openIfClosed.	^ioConnection dataSize max: readLimit! !!BufferedExternalStream methodsFor: 'constants'!lineEndCR	self lineEndConvention: LineEndCR!lineEndCRLF	self lineEndConvention: LineEndCRLF!lineEndLF	self lineEndConvention: LineEndLF!lineEndTransparent	self lineEndConvention: LineEndTransparent! !!BufferedExternalStream methodsFor: 'character/binary'!binary	"Set the receiver's buffer to be binary." 	self openIfClosed.	binary _ true.	ioBuffer binary: true.	collection _ ioBuffer buffer!isBinary	"Answer whether the receiver's data is byte or character."	^binary!isText	"Answer true if the receiver's data is character."	^binary not!text	"Set the receiver's buffer to be character." 	self openIfClosed.	binary _ false.	ioBuffer binary: false.	collection _ ioBuffer buffer! !!BufferedExternalStream methodsFor: 'status'!close	"Close the receiver.  The exception handler on closeConnection	catches the error generated when a stream is being resynched	during the return-from-snapshot process"	self closed ifTrue: [^self].	OSHandle badArgumentsSignal		handle: [ :ex | ex return]		do: [self closeConnection].	ioBuffer _ nil.	collection _ collection species new: 0.	self removeDependency!closed	"Answer true if the receiver is closed,  otherwise answer false."	^ioBuffer == nil!release	"Close the receiver."	self close! !!BufferedExternalStream methodsFor: 'positioning'!position	"Answer the receiver's position."		^self readPosition!position: anIndex	"Set position to anInteger as long as anInteger is within the bounds of the 	receiver's contents.  If it is not, provide an error notification."	| pos |	self openIfClosed.	pos _ position + (anIndex - self readPosition).	(pos >= 0 and: [pos <= readLimit])		ifTrue: [position _ pos]		ifFalse: [self setPosition: anIndex]!readPosition	"Answer the receiver's position where next read will take place."	ioBuffer == nil  ifTrue: [self reopen].		^ioBuffer currentBufferPosition + position!reset	"Set the receiver's read position to the beginning."	self position: 0!setToEnd	"Set the read position to the end of the receiver's data."	^self position: self size!writePosition	"Answer the receiver's write position."	ioBuffer == nil  ifTrue: [self reopen].		^ioBuffer currentBufferPosition + position! !!BufferedExternalStream methodsFor: 'testing'!atEnd	"Answer true if the position is greater than or equal to the limit, 	otherwise answer false. "	^self basicAtEnd and: [self endTest]!atEndOfData	"Answer true if no more data can be read from the receiver.	This is useful for read streams on process connections."	^self atEnd and: [self ioConnection isActive not]! !!BufferedExternalStream methodsFor: 'character reading'!skipSeparators	"Move the receiver's position past any separators."	self class endOfStreamSignal		handle: [:ex | ex return]		do: [[| ch | 			ch _ self next.			ch isSeparator				ifFalse: [^self skip: -1]] repeat]! !!BufferedExternalStream methodsFor: 'fileIn'!nextChunk	"Answer the contents of the receiver, up to the next terminator character, with	double terminators ignored."	| aStream terminator |	terminator _ $!!.	aStream _ (String new: 200) writeStream.	self skipSeparators.	self class endOfStreamSignal		handle: [:ex | ex return]		do: [[| char |			char _ self next.			char == terminator			ifTrue: [(self peekFor: terminator) "doubled terminator"						ifTrue: [aStream nextPut: char]						ifFalse: [^aStream contents]]			ifFalse: [aStream nextPut: char]] repeat].	^aStream contents! !!BufferedExternalStream methodsFor: 'connection accessing'!ioConnection	"Answer the receiver's ioConnection."	^ioConnection!name	"Answer the name of the io connection being streamed over."	^ioConnection name! !!BufferedExternalStream methodsFor: 'printing'!printOn: aStream 	"Append to the argument aStream a sequence of characters that identifies the receiver."	| connectionName |	connectionName _ self name.	super printOn: aStream.	connectionName isNil		ifTrue: [^self].	aStream nextPutAll: ' on '.	connectionName printOn: aStream! !!BufferedExternalStream methodsFor: 'private'!basicAtEnd	"Answer true if the position is greater than or equal to the limit, 	otherwise answer false. Fail if position or readLimit is not a SmallInteger. 	Optional. See Object documentation whatIsAPrimitive.	Normally called atEnd but renamed since the receiver must do special testing in atEnd" 	<primitive: 67>	^true!closeConnection	"Close the receiver's io connection.	Ask the io connection to remember the current position."	self flush.	ioConnection canPersist		ifTrue: [ioConnection rememberPosition: self readPosition].	ioConnection close.	position _ readLimit _ 0.	writeLimit _ nil!crlfNext: anInteger 	| newCollection index |	newCollection _ self contentsSpecies new: anInteger.	index _ 0.	^self class endOfStreamSignal		handle: [:ex | ex returnDoing:					[self class incompleteNextCountSignal						raiseRequestWith: (newCollection copyFrom: 1 to: index - 1)]]		do: [[(index _ index + 1) <= anInteger]				whileTrue: [newCollection at: index put: self next].			newCollection]!crlfNextPutAll: aCollection	aCollection isSequenceable		ifTrue: [1 to: aCollection size do: [:i | self nextPut: (aCollection at: i)]]		ifFalse: [aCollection do: [:v | self nextPut: v]].	^aCollection!crlfSkip: n 	"Reposition to the relative number n."		| startPos ch rp count|	n > 0		ifTrue: [count _ 1.				[count <= n] whileTrue:					[position >= readLimit						ifTrue: [self nextBuffer 									ifTrue: [ch _ collection at: (position _ position + 1)]									ifFalse: [^self]]						ifFalse: [ch _ collection at: (position _ position + 1)].					ch == CR						ifTrue: [position >= readLimit									ifTrue: [self nextBuffer 												ifTrue: [ch _ collection at: (position _ position + 1)]												ifFalse: [^self]]									ifFalse: [ch _ collection at: (position _ position + 1)].								ch == LF									ifTrue: [count _ count + 1]									ifFalse: [count _ count + 2.											count > n ifTrue: [position _ position - 1]]]						ifFalse: [count _ count + 1]]]		ifFalse: [startPos _ self readPosition.				count _ n negated.				[count > 0] whileTrue:					[position = 0						ifTrue: [(rp _ self readPosition) = 0									ifTrue: [self setPosition: startPos.											^self error: 'attempt to position past begining']									ifFalse: [self setPosition: rp - 1.											position _ position+1]].					ch _ collection at: position.					position _ position - 1.					ch == LF						ifTrue: [position = 0									ifTrue: [(rp _ self readPosition) = 0												ifTrue: [self setPosition: startPos.														^self error: 'attempt to position past begining']												ifFalse: [self setPosition: rp - 1.														position _ position+1]].								ch _ collection at: position.								position _ position - 1.								ch == CR									ifTrue: [count _ count - 1]									ifFalse: [count _ count - 2.											count < 0 ifTrue: [position _ position + 1]]]						ifFalse: [count _ count - 1]]].!endTest	"Answer true if the receiver is at the end of the data, if not get the next buffer.	Used by atEnd"	self openIfClosed.		position < readLimit ifTrue: [^false].	self nextBuffer 		ifFalse: [^true].	^position = readLimit!getIoBuffer	"Get an io buffer from the receiver's io connection."	^ioConnection defaultIoBufferInMode: binary!nextBuffer	"Read the next buffer and Answer true if there was any data."	"Used by endTest"	self flush.	collection _ ioBuffer nextAndSetOffest: [:pos | position _ pos - 1].	readLimit _ ioBuffer lastDataPosition.	^readLimit > position!on: anIOConnection	"Initialize the receiver on anIOConnection."		binary _ false.	ioConnection _ anIOConnection.	self setupBufferAndLimits.	anIOConnection canPersist		ifTrue: [self setDependency]!openIfClosed	"Open the receiver if closed."	ioBuffer == nil  ifTrue: [self reopen].!pastEnd	"Raise a signal if the receiver is at the end of the data, if not get the next buffer	and return next character."	self openIfClosed.		position < readLimit		ifTrue: [^collection at: (position _ position + 1)].	^self nextBuffer 		ifTrue: [collection at: (position _ position + 1)]		ifFalse: [Signal noHandlerSignal					handle: [:ex | ex parameter proceedWith: nil]					do: [self class endOfStreamSignal raiseRequest]]!removeDependency	"Remove the receiver from the dependency system."	FileDirectory removeExternalReference: self!reopen	"Try to reopen the receiver's connection and set position to a remembered position." 	| pos |	ioConnection canPersist 		ifTrue: [ioConnection revive.				self resetDependency.				pos _ ioConnection rememberedPosition]		ifFalse: [pos _ self reopenError].	ioBuffer _ self getIoBuffer.	"If pos is a number (either returned from a remembered position or an exception handler)	 then set this as the receivers position"	pos isNil		ifTrue: [self nextBuffer]		ifFalse: [self setPosition: pos].	writeLimit _ nil.	^self!resetDependency	"Reset the receiver to the dependency system."	FileDirectory addExternalReference: self.!setConnection: anExternalConnection		ioConnection _ anExternalConnection!setDependency	"Setup the receiver to the dependency system."	FileDirectory addExternalReference: self.!setPosition: anIndex	"Reposition the receiver to a new position."	anIndex < 0 ifTrue: [^self error: 'attempt to position to a negative number' ].	self flush.	collection _ ioBuffer readPosition: anIndex setOffset: [:pos | position _ pos].	readLimit _ ioBuffer lastDataPosition.!setupBufferAndLimits	"Initialize the ioBuffer and limits."	ioBuffer _ self getIoBuffer.	collection _ ioBuffer buffer.	lineEndConvention == nil		ifTrue:	[self lineEndConvention: ioConnection lineEndConvention].	position _ 	ioBuffer firstDataPosition - 1.	readLimit _ 0.	writeLimit  _ nil! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!BufferedExternalStream class	instanceVariableNames: ''!!BufferedExternalStream class methodsFor: 'instance creation'!on: anIOConnection	"Answer a new instance of the receiver that streams over anIOConnection."	^self basicNew on: anIOConnection! !Switch subclass: #Button	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Interface-Menus'!Button comment:'A Button is a Switch that turns off automatically after being turned on, that is, it acts like a push-button switch.'!!Button methodsFor: 'state'!turnOff	"Sets the state of the receiver to 'off'.  The off action of the receiver is not  	executed."	on _ false!turnOn	"The receiver remains in the 'off' state'."	self doAction: onAction.	self doAction: offAction! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Button class	instanceVariableNames: ''!!Button class methodsFor: 'instance creation'!newOn	self error: 'Buttons cannot be created in the on state'.	^nil! !IntegerArray variableByteSubclass: #ByteArray	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Collections-Arrayed'!ByteArray comment:'Elements of a ByteArray can only be integers between 0 and 255.  The access messages at: and at:put: are handled primitively in class Object.Instance Variables: *byte indexed*'!!ByteArray methodsFor: 'accessing'!byteAt: index 	"Answer the byte at the given index."	^self basicAt: index!byteAt: index put: aByte 	"Store a byte at the given index."	^self basicAt: index put: aByte!doubleWordAt: i 	"Answer the value of the double word (4 bytes) starting at byte index i."	| b0 b1 b2 w |	"Primarily for reading socket #s in Pup headers"	b0 _ self at: i.  	b1 _ self at: i+1.  	b2 _ self at: i+2.  	w _ self at: i+3.	"Following sequence minimizes LargeInteger arithmetic for small results."	b2=0 ifFalse: [w _ (b2 bitShift: 8) + w].	b1=0 ifFalse: [w _ (b1 bitShift: 16) + w].	b0=0 ifFalse: [w _ (b0 bitShift: 24) + w].	^w!doubleWordAt: i put: value 	"Set the value of the double word (4 bytes) starting at byte index i."	| w |	"Primarily for setting socket #s in Pup headers"	w _ value truncated.	self at: i put: (w digitAt: 4).	self at: i + 1 put: (w digitAt: 3).	self at: i + 2 put: (w digitAt: 2).	self at: i + 3 put: (w digitAt: 1)!replaceBytesFrom: start to: stop with: replacement startingAt: repStart 	"This destructively replaces elements from start to stop in the receiver	starting at index, repStart, in the collection, replacement.  Answer the	receiver."	<primitive: 559>	| repOff |	repOff _ repStart - start.	(self == replacement and: [repStart < start])		ifTrue:	["Replacement would be overwritten; use reverse order"				stop to: start by: -1 do:					[ :i |	self byteAt: i put: (replacement byteAt: repOff + i)]]		ifFalse:	[start to: stop do:					[ :i |	self byteAt: i put: (replacement byteAt: repOff + i)]]!sizeInBytes	"Answer how many bytes the receiver contains."	^self size!wordAt: i 	"Answer the value of the word (2 bytes) starting at index i."	| j |	j _ i + i.	^((self at: j - 1) bitShift: 8) + (self at: j)!wordAt: i put: v 	"Set the value of the word (2 bytes) starting at index i."	| j |	j _ i + i.	self at: j - 1 put: ((v bitShift: -8) bitAnd: 8r377).	self at: j put: (v bitAnd: 8r377)! !!ByteArray methodsFor: 'converting'!asByteArray	"Answer the receiver itself."	^self!asByteString	"Answer an instance of ByteString which is = to self."	^(ByteString new: self size)		replaceFrom: 1		to: self size		withByteArray: self		startingAt: 1! !!ByteArray methodsFor: 'fileIn/Out'!storeBinaryOn: stream	stream storeRecordOfClass: self class.	stream nextPut: self size.	stream storeBytes: self! !!ByteArray methodsFor: 'private'!replaceFrom: start to: stop with: replacement startingAt: repStart 	"This destructively replaces elements from start to stop in the receiver	starting at index, repStart, in the collection, replacement.  Answer the	receiver."	<primitive: 105>	^super replaceFrom: start to: stop with: replacement startingAt: repStart! !!ByteArray methodsFor: 'copying'!deepCopy	"Answer a copy of the receiver with its own copy of each instance 	variable. Object>>deepCopy would do much unneeded work; since	the instance contains only bits, just do a copy."	^self copy! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!ByteArray class	instanceVariableNames: ''!!ByteArray class methodsFor: 'fileIn/Out'!readBinaryFrom: stream tag: tag	"Answer object appearing next in stream."	| size bytes |	size _ stream next.  "integer"	bytes _ stream readBytes: self size: size.	stream register: bytes id: tag.	^bytes! !ReadWriteStream subclass: #ByteCodeReadWriteStream	instanceVariableNames: 'noPeekPosition '	classVariableNames: ''	poolDictionaries: ''	category: 'System-Compiler-Support'!ByteCodeReadWriteStream comment:'I am a ReadWriteStream extended with a few messages for manipulating bytecode streams.  I use 0-origin indexing for compatibility with stream positions, not 1-origin like other collections.  I also keep track of whether it is safe for peephole optimization to look back at the last bytecode.Instance Variables:	noPeekPosition	<Integer>  "the position at the end of the last multi-byte opcode,			or at the last target of a branch,			or -1 if none has been output yet"'!!ByteCodeReadWriteStream methodsFor: 'accessing'!labelPosition	"Return the current position, and also	note that the caller is about to define	a label (branch target), so we can't	peek back beyond this point."	^noPeekPosition _ position! !!ByteCodeReadWriteStream methodsFor: 'accessing-collection'!at: index0	"0-origin indexing"	^collection at: index0 + 1!at: index0 put: byte	"0-origin indexing"	collection at: index0 + 1 put: byte!lastPut: byte	collection at: position put: byte!removeIndex: index0	"Remove a byte from the collection.	Return the byte removed."	"0-origin indexing"	| byte |	byte _ collection at: index0 + 1.	collection replaceFrom: index0 + 1 to: position - 1 with: collection startingAt: index0 + 2.	position _ position - 1.	noPeekPosition _ noPeekPosition - 1.	^byte! !!ByteCodeReadWriteStream methodsFor: 'accessing-bytecodes'!adjustBranchAt: index0 by: amount	"0-origin indexing; -255 <= amount <= 255"	| i lowByte |	i _ index0 + 2.	lowByte _ (collection at: i) + amount.	lowByte > 256		ifTrue:			[collection at: i - 1 put: (collection at: i - 1) + 1.			lowByte _ lowByte - 256]		ifFalse:			[lowByte < 0				ifTrue:					[collection at: i - 1 put: (collection at: i - 1) - 1.					lowByte _ lowByte + 256]].	collection at: i put: lowByte!fixBranchAt: index0 with: offset	"0-origin indexing"	collection at: index0 + 1 put: (collection at: index0 + 1) + (offset bitShift: -8).	collection at: index0 + 2 put: (offset bitAnd: 255)!lastCode	"Answer the last opcode, if it was single-byte	and a branch target didn't intervene.	If it was multi-byte, or there was none,	or the current position was the target of a branch,	answer -1."	^(position = 0 or: [position = noPeekPosition])		ifTrue: [-1]  "nothing in the stream yet, or multi-byte opcode"		ifFalse: [collection at: position]!nextPut: opcode with: extn	self nextPut: opcode; nextPut: extn.	noPeekPosition _ position!nextPut: opcode with: extn1 with: extn2	self nextPut: opcode; nextPut: extn1; nextPut: extn2.	noPeekPosition _ position! !!ByteCodeReadWriteStream methodsFor: 'private'!on: aCollection	super on: aCollection.	noPeekPosition _ -1! !Object subclass: #ByteCodeStream	instanceVariableNames: 'bindings nesting class code literals literalCollection depth maxDepth reachable labels returnsNonSelf numArgs numTemps requestor topNode sourceMap mustBeSimple '	classVariableNames: ''	poolDictionaries: ''	category: 'System-Compiler-Support'!ByteCodeStream comment:'I represent a code generator for a generic bytecode machine language.  I keep track of literals, stack depth, and reachability.The source map, translating code PCs to source positions, is sorted by code PC but not necessarily by source position.Instance variables:	bindings	<NameScope>	nesting	<Integer>	class	<Behavior>	code	<ByteCodeReadWriteStream on: ByteArray>  "code being accumulated"	literals	<IdentityDictionary>  "value -> index"	literalCollection	<OrderedCollection>	depth	<Integer>  "current stack depth"	maxDepth	<Integer>  "max stack depth"	reachable	<Boolean>	labels	<OrderedCollection of: CodeLabel>	returnsNonSelf	<Boolean>  "true if any ^ with value other than self"	numArgs	<Integer>	numTemps	<Integer>	requestor	<>  "object for handling errors"	topNode	<MethodRep | BlockRep>  "top node generating code"	sourceMap	<nil | OrderedCollection of: (Association key: Integer value: Interval)>  "map pc to source range"	mustBeSimple	<Boolean>  "true if generated code must be simple enough to decompile"Note that there is a binding for ''super'', identical to the binding for ''self''.  ''Super'' is not a variable, but it simplifies code generation slightly to do things this way.The code generation messages beginning with ''code'' are higher-level operations.  The low-level operations are deliberately chosen to have the same names as those sent by InstructionStream for instruction decoding.'!!ByteCodeStream methodsFor: 'initialize-release'!addMethodVars	bindings receiverName: 'self' withSuper: true.	bindings pseudoVariable: 'thisContext'!arguments: args	depth _ maxDepth _ bindings arguments: args startingAt: 0 from: self.	numArgs _ args size!bindRemote: contextNode in: ctxt	bindings addRemote: contextNode in: ctxt!class: aClass outerScope: aNameScope	class _ aClass.	bindings _ LocalScope new.	bindings outerScope: aNameScope.	nesting _ 0!class: aClass scope: aNameScope nesting: level	"This is used for inner blocks."	class _ aClass.	bindings _ aNameScope.	nesting _ level!initialize	code _ ByteCodeReadWriteStream on: (ByteArray new: 40).	literals _ IdentityDictionary new.	literalCollection _ OrderedCollection new.	depth _ maxDepth _ numTemps _ 0.	reachable _ true.	"labels _ OrderedCollection new."  "do when needed"	returnsNonSelf _ false.	mustBeSimple _ true  "THIS SHOULD BE CHANGED EVENTUALLY"!leaveScope	bindings leaveScope: self!newBlockScope	| inner |	inner _ self class new.	inner class: class scope: bindings newBlockScope nesting: nesting + 1.	inner requestor: requestor.	^inner!requestor: req	requestor _ req!saveSourceMap	"Initialize the source map so it will	accumulate entries."	sourceMap _ OrderedCollection new: 16!topNode: aNode	topNode _ aNode! !!ByteCodeStream methodsFor: 'accessing'!addTemporaries: temps	"Bind a collection of temporaries.	Return a value that can be used to unbind them later."	| addedCount oldCount |	addedCount _ temps size.	addedCount = 0 ifTrue: [^nil].  "nothing to bind or unbind"	oldCount _ numTemps.	numTemps _ (bindings temporaries: temps startingAt: numArgs + numTemps from: self) - numArgs.	depth _ depth + addedCount.	maxDepth _ maxDepth + addedCount.	^oldCount to: numTemps - 1!generateNames: count	"Generate a set of new temporary variable names."	^bindings generateNames: count!noteSourceNode: node	"Note the correspondence between the	current code position, and the source	position of the node."	| pos |	(sourceMap == nil or: [(pos _ node sourcePosition) == nil])		ifFalse:			[self noteSourceRange: pos]!noteSourceNodeEnd: node	"Note the correspondence between the	current code position, and the source	position of the end of the node."	| pos |	(sourceMap == nil or: [(pos _ node sourcePosition) == nil])		ifFalse:			[self noteSourceRange: (pos last + 1 to: pos last)]!noteSourceRange: pos	"Note the correspondence between the	current code position, and a range of	character positions in the source."	sourceMap == nil		ifFalse:			[sourceMap addLast: (Association key: code position + 1 value: pos)]!noteStore: varNode	| def |	def _ bindings variableAt: varNode name from: varNode.	def notNil ifTrue: [def noteStore]!removeTemporaries: oldRange	"Unbind a collection of temporaries.	oldRange is the range of old temporary indices	that was returned as the value of addTemporaries:."	oldRange notNil ifTrue:  "don't bother if nothing to unbind"		[bindings			leaveScope: self			between: numArgs + oldRange first			and: numArgs + oldRange last			remove: true]!variableAt: name from: varNode	^bindings variableAt: name from: varNode! !!ByteCodeStream methodsFor: 'testing'!inBlock	"Return true if we are compiling	the code for a block."	^self subclassResponsibility!isForNonImmediate	"Return true if this class is definitely not	an immediate class or a superclass of one,	and false otherwise."	^self subclassResponsibility!mustBeSimple	^mustBeSimple!reachable	"so code generator can decide whether	to generate default ^self at the end of	a method"	^reachable!returnsNonSelf	"so code generator can decide whether	default ^self at the end of a method	is acceptable"	^returnsNonSelf!variableIsInvariant: name	"Answer true iff name is the name of	an invariant (argument or receiver) variable."	| var |	var _ bindings variableAt: name from: nil.	var isNil ifTrue: [^false].  "name is not bound"	^var isInvariant! !!ByteCodeStream methodsFor: 'enumerating'!bindingsDo: aBlock	bindings associationsDo: aBlock! !!ByteCodeStream methodsFor: 'code generation-loads and stores'!codeLoad: name from: varNode	| var |	(var _ bindings variableAt: name from: varNode) == nil		ifTrue: [var _ bindings undeclared: name from: varNode].	var emitLoad: self from: varNode!codeStore: name value: value from: varNode in: assignNode	| var |	(var _ bindings variableAt: name from: varNode) == nil		ifTrue: [var _ bindings undeclared: name from: varNode].	var emitStore: self value: value from: assignNode!codeStorePop: name value: value from: varNode in: assignNode	| var |	(var _ bindings variableAt: name from: varNode) == nil		ifTrue: [var _ bindings undeclared: name from: varNode].	var emitStorePop: self value: value from: assignNode! !!ByteCodeStream methodsFor: 'code generation-branches and labels'!branch: label with: op	label reference: code position opcode: op.	code nextPut: op with: 0!define: label test: testBlock long: minLongJump shorten: shortenBlock	| pos refs disp op ref |	pos _ code labelPosition.	refs _ label references.	refs == nil ifTrue:  "no reference"		[label definition: pos.  ^self].	reachable _ true.	refs size > 1 ifTrue:  "too complicated to optimize"		[refs do: [:fix | self putLongBranchFrom: fix key].		label definition: pos.		^self].	"See if the reference is within short branch range."	ref _ refs first key.	disp _ pos - (ref + 2).	(testBlock value: refs first value "op" value: disp)		ifTrue:			["Can use a short branch.  Adjust any			branches into the intervening code.			Note: this depends on the minimum short			jump distances all being 1, because			it assumes that a short jump can't			become long if the displacement decreases.			Also adjust any labels within this code."			labels do: [:l | l fixAcross: ref in: code long: minLongJump].			"Scrunch the intervening code.			There may be references OUT of it			that have to be adjusted."			op _ shortenBlock value: (code removeIndex: ref).			code at: ref put: op + disp - 1.  "MinShortJump = 1"			label definition: pos - 1.  "fix up our own definition"			"Fix up any entries in the pc map."			self noteScrunch: 1 at: ref.			^self].	"Fix up the long branch."	label definition: pos.	self putLongBranchFrom: ref!labelHere	"Create a new label for backward references"	| l |	l _ CodeLabel new.	l definition: code labelPosition.	labels == nil ifTrue: [labels _ OrderedCollection new].	labels add: l.	reachable _ true.	^l!newLabel	"Create a new label for forward references"	| l |	l _ CodeLabel new.	labels == nil ifTrue: [labels _ OrderedCollection new].	labels add: l.	^l! !!ByteCodeStream methodsFor: 'code generation-utilities'!assignLiteralIndex	"Assign a literal index for a literal to be filled in later.	(This is a 0-origin index.)"	literalCollection addLast: 'a dummy literal'.	^literalCollection size - 1!literalIndex: lit	"Find the index of an existing literal,	or add it to the collection."	^literals at: lit ifAbsent: [self newLiteralIndex: lit]!newLiteralIndex: lit	"Add a literal to the collection and	return the index."	literalCollection addLast: lit.	^literals at: lit put: literalCollection size - 1!noteScrunch: amount at: pos	"Note that some code has been removed	just after pos, by decrementing all subsequent	PCs in the source map (if any).  pos is 0-origin."	| i assoc |	sourceMap notNil		ifTrue:			[i _ sourceMap size.			[i > 0 and: [(assoc _ sourceMap at: i) key - 1 > pos  "keys are 1-origin"]]				whileTrue:					[assoc key: assoc key - amount.					i _ i - 1]]!pop: n	depth _ depth - n!push	depth _ depth + 1.	depth > maxDepth ifTrue: [maxDepth _ depth]!putIndex: index count: count short: op2 long: op3	"Put out an opcode with an index and a second	parameter (numArgs for sends, level count for	outer block references.)  The short form takes	a single extension byte with a 3-bit count and	a 5-bit index; the long form takes two extension	bytes."	(index <= 31 and: [count <= 7 and: [op2 notNil]])		ifTrue: [code nextPut: op2 with: count * 32 + index]		ifFalse: [code nextPut: op3 with: count with: index]!putIndex: index short: op1 max: max long: op2	"Put out either a short or long opcode,	depending on the value of the index."	index <= max		ifTrue: [code nextPut: op1 + index]		ifFalse: [code nextPut: op2 with: index]!putLongBranch: op to: pos	| disp | 	disp _ pos - (code position + 2).	code nextPut: op + (disp bitShift: -8)		with: (disp bitAnd: 255)!putLongBranchFrom: jump	code		fixBranchAt: jump		with: code position - (jump + 2)!selectorIndex: selector allowSpecial: allowSpecial	| index |	allowSpecial		ifTrue:			[index _ self specialSelectors at: selector ifAbsent: [nil].			index == nil ifFalse: [^index]].	^literals at: selector ifAbsent:		[literalCollection addLast: selector.		literals at: selector put: literalCollection size - 1]! !!ByteCodeStream methodsFor: 'error handling'!error: type with: message at: position	requestor error: type with: message at: position!error: type with: message from: node	requestor error: type with: message in: node from: self!redeclaredArg: argNode	"An argument is being redeclared.	The error is different if this is a block argument."	self		error: (self inBlock ifTrue: [#redeclaredBlockArg] ifFalse: [#redeclared])		with: argNode name		from: argNode.	^true  "Allow the redeclaration if the user proceeds"!redeclaredTemp: tempNode	"A local variable is being redeclared.	Signal an error."	self error: #redeclared with: tempNode name from: tempNode.	^true  "Allow the redeclaration if the user proceeds"!topNode	"Return the top node, for	automatically pasting in temps."	^topNode! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!ByteCodeStream class	instanceVariableNames: ''!!ByteCodeStream class methodsFor: 'instance creation'!new	^super new initialize! !String variableByteSubclass: #ByteString	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Collections-Text'!ByteString comment:'Instances of class ByteString are indexed collections of Characters. ByteStrings store characters as bytes.  The access protocol translates between these and real Character objects.Instance Variables: *byte indexed*'!!ByteString methodsFor: 'accessing'!at: index 	"Answer the Character stored in the field of the receiver indexed by the 	argument.  Fail if the index argument is not an Integer or is out of bounds.  	Optional.  See Object documentation whatIsAPrimitive."	<primitive: 63>	^Character value: (super at: index)!at: index put: aCharacter 	"Store the Character in the field of the receiver indicated by the index.  Fail if the 	index is not an Integer or is out of bounds, or if the argument is not a Character,	or if the code of aCharacter does not fit in one byte.  	Optional.  See Object documentation whatIsAPrimitive."	<primitive: 64>	(aCharacter isKindOf: Character)		ifTrue:			[aCharacter asciiValue < 256				ifTrue: [super at: index put: aCharacter asciiValue]				ifFalse:					[| two |					two _ self asTwoByteString.					two at: index put: aCharacter.					self become: two].			^aCharacter]		ifFalse: [self error: 'Strings only store Characters']!byteAt: index 	"Answer the byte at the given index."	^self basicAt: index!byteAt: index put: aByte	"Store a byte at the given index."	^self basicAt: index put: aByte!nextIndexOf: anElement from: startIndex to: stopIndex	"Answer the next index of anElement within the receiver between startIndex and stopIndex.	 If the receiver does not contain anElement, answer nil"	<primitive: 418>	^super nextIndexOf: anElement from: startIndex to: stopIndex!prevIndexOf: anElement from: startIndex to: stopIndex	"Answer the previous index of anElement within the receiver between startIndex and stopIndex	 working backwards through the receiver.  If the receiver does not contain anElement, answer nil"	<primitive: 419>	^super prevIndexOf: anElement from: startIndex to: stopIndex!replaceFrom: start to: stop withByteArray: aByteArray startingAt: repStart	"This destructively replaces elements from start to stop in the receiver	starting at index, repStart, in the byte array, aByteArray.  Answer the	receiver."	^super replaceFrom: start to: stop withIntegerArray: aByteArray startingAt: repStart!size	"Answer the number of indexable fields in the receiver.  This value is the 	same as the largest legal subscript.  Essential.  See Object documentation	whatIsAPrimitive."	<primitive: 62>	^super size!sizeInBytes	"Answer how many bytes the receiver contains."	^self size! !!ByteString methodsFor: 'comparing'!= aString 	"Answer whether aString isKindOf: String,	and the receiver's size is the same as aString's size,	and each of the receiver's elements equals	the corresponding element of aString"	<primitive: 223>	aString isString ifFalse: [^false].	self size = aString size ifFalse: [^false].	^super = aString! !!ByteString methodsFor: 'converting'!asByteString	"Answer the receiver."	^self!asIntegerArray	"Answer an instance of a kind of IntegerArray whose elements	are the elements of the receiver transformed to integers."	^self asByteArray! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!ByteString class	instanceVariableNames: ''!!ByteString class methodsFor: 'instance creation'!new: size	^self basicNew: size! !Symbol variableByteSubclass: #ByteSymbol	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Collections-Text'!ByteSymbol comment:'Instances of class ByteSymbol are uniquely stored, immutable, indexed collections of Characters.  See Symbol for more information.  ByteSymbols store characters as bytes: the access protocol translates between these and real Character objects.Instance Variables: *byte indexed*'!!ByteSymbol methodsFor: 'accessing'!at: index 	"Answer the Character stored in the field of the receiver indexed by the 	argument.  Fail if the index argument is not an Integer or is out of bounds.  	Optional.  See Object documentation whatIsAPrimitive."	<primitive: 63>	^Character value: (super at: index)! !!ByteSymbol methodsFor: 'private'!species	^ByteString!string: aString 	self size = aString size ifFalse: [self error: 'aString size must be equal to receiver size'].	1 to: aString size do: [:j |		| code |		(code _ (aString at: j) asciiValue) < 256			ifTrue: [self basicAt: j put: code]			ifFalse: 				[| two |				two _ TwoByteSymbol new: self size.				two string: aString.				self become: two.				^self]]! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!ByteSymbol class	instanceVariableNames: ''!!ByteSymbol class methodsFor: 'instance creation'!new: size	"Redefined here to override String new:"	^self basicNew: size! !ValueNode subclass: #CascadeNode	instanceVariableNames: 'receiver messages '	classVariableNames: ''	poolDictionaries: ''	category: 'System-Compiler-Program Objects'!CascadeNode comment:'Class CascadeNode represents a cascaded message.  The receiver in each MessageNode is the same as the receiver for the cascade, so we can generate the right kind of send.Instance Variables:	receiver	<ValueNode>	messages	<"at least 2" Seq of: MessageNode>'!!CascadeNode methodsFor: 'initialize-release'!receiver: receivingObject messages: msgs 	receiver _ receivingObject.	messages _ msgs! !!CascadeNode methodsFor: 'accessing'!absoluteSourcePosition	"Answer the sourcePosition of the first child-node of this node.	For cascaded messages, this is the sourcePosition of the message's receiver"	^receiver absoluteSourcePosition!messages	^messages!receiver	^receiver! !!CascadeNode methodsFor: 'printing'!printOn: aStream indent: level 	receiver printOn: aStream indent: level precedence: 0.	1 to: messages size do: 		[:i | 		(messages at: i) printMessageOn: aStream indent: level.		i < messages size ifTrue: [aStream nextPut: $;]]!printOn: aStream indent: level precedence: p 	p < 4 ifTrue: [aStream nextPut: $(].	self printOn: aStream indent: level.	p < 4 ifTrue: [aStream nextPut: $)]! !!CascadeNode methodsFor: 'code generation'!emitValue: codeStream	receiver emitCascade: codeStream messages: messages! !Dictionary variableSubclass: #CEnvironment	instanceVariableNames: ''	classVariableNames: 'UserEnvironment Valid '	poolDictionaries: ''	category: 'OS-Support'!CEnvironment comment:'Class CEnvironment represents a Dictionary which can convert to and from the standard C  environment data structure (passed to the C entrypoint "main"), namely an array of strings which have the format "key=value".  The class is a dependent of the SystemDictionary, in order to obtain the current environment from the VM at return-from-snapshot time.  Instances are also useful in order to construct new C environments as dictionaries and then pass the standard format to forked ExternalProcess''s.Class Variables:	UserEnvironment	<CEnvironment> The environment of Smalltalk at startup	Valid	<Boolean>'!!CEnvironment methodsFor: 'converting'!asStrings	"Answer an array of strings in the external format."	| sa i |	sa _ Array new: self size.	i _ 1.	self		associationsDo: 			[:ass | 			sa at: i put: ass key asString , '=' , ass value.			i _ i + 1].	^sa! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!CEnvironment class	instanceVariableNames: ''!!CEnvironment class methodsFor: 'class initialization'!checkEnvironment	"Get the environment and cache it for later lookup by getenv:.	Valid is set to false on system startup, and to true when the	environment is loaded here"	Valid		ifFalse: 			[UserEnvironment _ self fromStrings: self primEnvironment.			Valid _ true]!initialize	"Add me as a dependent of the system dictionary (so I will be 	informed when returning from snapshot) and cache the current 	environment."	"CEnvironment initialize"	"Protect against multiple initialize's; but I sure wish that dependents 	had set semantics."	Smalltalk removeDependent: self.	Smalltalk addDependent: self.	self install!install	"Record that the environment is invalid.  On system startup,	we just flush the cache--the current environment is not loaded	until the first request"	self release.	Valid _ false!release	"Break the reference to the cached environment."	UserEnvironment _ nil! !!CEnvironment class methodsFor: 'class accessing'!getenv: key 	"Get the value of the named environment variable from the current 	environment."	self checkEnvironment.	^UserEnvironment at: key ifAbsent: ['']!userEnvironment	"Return the current user environment, namely the one at system 	startup."	self checkEnvironment.	^UserEnvironment! !!CEnvironment class methodsFor: 'instance creation'!fromStrings: aCollection 	"Create an instance by converting from the external format."	| ce |	ce _ self new: aCollection size + (aCollection size // 3).	aCollection do: 		[:elem | 		| lhs rhs eep es |		es _ elem size.		eep _ elem indexOf: $=.		lhs _ eep = 0					ifTrue: [elem copy]					ifFalse: [elem copyFrom: 1 to: eep - 1].		rhs _ eep = 0 | (eep = es)					ifTrue: [String new]					ifFalse: [elem copyFrom: eep + 1 to: es].		ce at: lhs put: rhs].	^ce! !!CEnvironment class methodsFor: 'private'!primEnvironment	"Return the standard user environment as an Array of strings with the format 'key=value'."	<primitive: 690>	^Array with: 'INVALID'! !CEnvironment initialize!Object subclass: #Change	instanceVariableNames: 'file position '	classVariableNames: ''	poolDictionaries: ''	category: 'System-Changes'!Change comment:'Class Change represents a single change of some kind.  It has many subclasses for specific kinds of changes.  The text which represents the instance is a chunk of a file starting at a particular position.  Since so many kinds of changes are related to classes, categories, and methods, there are dummy accessing methods for these parameters in class Change.Instance Variables:	file 			<FileStream>	position		<Integer>'!!Change methodsFor: 'initialize-release'!file: aFileStream position: anInteger	file _ aFileStream.	position _ anInteger! !!Change methodsFor: 'accessing'!category	^''!className	^''!classObject	"Return the class in the present system referenced by my className"	^nil!defaultName: initialString	"The default name is the first few characters of the text."	| text cr |	text _ WriteStream on: (String new: 50).	text nextPutAll: initialString.	cr _ Character cr.	self text do:		[:char |		(char = cr or: [text position >= 40]) ifTrue: [text nextPutAll: ' ...'.  ^text contents].		text nextPut: char].	^text contents!guaranteedClassObject	"Return the class in the present system referenced by my className.	If no such class exists, return Object."	| obj |	obj _ self classObject.	^obj isBehavior		ifTrue: [obj]		ifFalse: [Object]!name	"Return the name which should appear in the list view."	self subclassResponsibility!parameters	"Return the parameters used for the 'same as' test"	self subclassResponsibility!selector	^''!text	"Answer the text displayed by the receiver."	file position: position.	^file nextChunk!text: aString	| tempStream |	tempStream _ ReadWriteStream on: (String new: aString size + 20).	tempStream nextChunkPut: aString.	tempStream position: 0.  "Needed to set readLimit = writePosition"	file _ ReadStream on: tempStream contents.	position _ 0!values	"Return the value to be used for the 'same as' filter"	^Array with: self class with: self parameters! !!Change methodsFor: 'file accessing'!file	^file!fileName	(file isKindOf: BufferedExternalStream)		ifTrue: [^file name]		ifFalse: [^'some local stream']! !!Change methodsFor: 'checking'!checkWith: aConflictChecker	"This is a default, most subclasses do something more intelligent."	aConflictChecker addDoIt: self! !!Change methodsFor: 'fileIn/Out'!fileIn	^self guaranteedClassObject evaluatorClass evaluate: self text logged: true!fileOutOn: aStream	"Default, subclasses may do something different"	aStream nextChunkPut: self text; cr; cr!fileOutOn: aStream previous: previousChange next: nextChange	"Default, subclasses may be able to encode runs more compactly"	self fileOutOn: aStream! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Change class	instanceVariableNames: ''!!Change class methodsFor: 'instance creation'!file: f position: p	^super new file: f position: p! !StringHolderController subclass: #ChangeController	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Tools-Changes'!ChangeController comment:'Class ChangeController represents the text view controller for a change browser.'!!ChangeController methodsFor: 'menu messages'!accept	"Accept cannot doe anything useful, so just flash the view."	^view flash! !StringHolder subclass: #ChangeList	instanceVariableNames: 'listName changes selectionIndex list filter removed filterList filterKey changeDict doItDict checkSystem fieldList '	classVariableNames: ''	poolDictionaries: ''	category: 'Tools-Changes'!ChangeList comment:'Class ChangeList knows how to scan a changes file and produce Change objects from it.  It also functions as a model for a ListView.Instance Variables:	listName <String>  label for browser, the set of files that have been read 	changes <OrderedCollection of: Change>  the underlying collection of changes 	selectionIndex <Integer>  currently selected change, or 0 if none 	currentChange <String>  text of current selection 	list <OrderedCollection of: Change>  filtered collection of changes 	filter <BlockContext>  filter predicate 	removed <Set>  removed changes 	filterList <nil | Array of: Symbol>  individual filters	filterKey <Change>  the change supplying the key value(s) for the filter(s) 	changeDict <Dictionary from: Symbol to: (OrderedCollection of: Change)>  cross-index for conflict detection 	doItDict <Dictionary from: String to: (OrderedCollection of: Change)>  cross-index for conflict detection 	fieldList <nil | Array of: Symbol>  individual field options	'!!ChangeList methodsFor: 'initialize-release'!initialize	super initialize.	listName _ ''.	changes _ OrderedCollection new.	list _ OrderedCollection new.	selectionIndex _ 0.	filter _ [:change | true].	removed _ Set new.	filterList _ #().	fieldList _ #()!recoverFile: aFileStream	"Recover all the changes from a .changes file since the last snapshot."	| position |	position _ self findLast: '''----SNAPSHOT----''!!' in: aFileStream.	position isNil		ifTrue: [position _ 0].	aFileStream position: position.	self scanFile: aFileStream!release	"Break BlockContext cycles."	filter _ nil.	filterList _ #()!scanFile: aFileStream	"Obtain changes from aFileStream."	ChangeScanner new scanFile: aFileStream do: [:change | changes add: change].	listName size = 0		ifTrue: [listName _ aFileStream name]		ifFalse: [listName _ listName, ' ..'].	self updateList!scheduleMessageBrowser	"Create and schedule a browser on the changed messages."	| change |	selectionIndex > 0 ifTrue:		[change _ list at: selectionIndex.		(change isKindOf: MethodDefinitionChange) ifTrue:			[^BrowserView openListBrowserOn: (Array with: change name) label: 'current definition']].	^nil! !!ChangeList methodsFor: 'accessing'!addChangeSet: aChangeSet	"The changed message list of the argument aChangeSet is added as part of the receiver's list of changes."	self addChanges: aChangeSet changedMessageList!filterCopy	"Answer a list of all the items not marked for removal."		^self class new listName: '(', self listName, ')' changes: list removed: (list select: [:c | removed includes: c])!hasRemoved: index	"Answer whether the item at position index has been marked for removal.  Answer false if position index is outside the boundaries of the receiver's list."		^index > 0 and: [index <= list size and: [removed includes: (list at: index)]]!list	"Answer an OrderedCollecton of Change items in the change list."	| name v |	^list collect:		[:c |		name _ nil.		fieldList do:			[:f |			f == nil ifFalse:				[v _ c perform: f.				v == nil ifFalse:					[name == nil ifTrue: [name _ WriteStream on: (String new: 50)].					name nextPut: $(; nextPutAll: v; nextPutAll: ') ']]].		name == nil ifTrue: [c name] ifFalse: [name nextPutAll: c name.  name contents]]!listName	"Answer the label for a browser on the receiver.  The default is Changes."		listName size = 0		ifTrue: [^'Changes']		ifFalse: [^listName]!listSize	"Answer the number of items in the receiver."	^list size! !!ChangeList methodsFor: 'selecting'!contents: aString	"Set the receiver's message selector to be item."	"ignore"!deselect	"If the receiver has a selection, then it is highlighted.  Remove the highlighting."	selectionIndex _ 0.	contents _ ''!listIndex	"Answer the position of the current selection."	^selectionIndex!selection	"Answer the text of the item currently selected."	selectionIndex > 0 ifTrue: [^(list at: selectionIndex) text]!toggleListIndex: anInteger	"If the item at position anInteger is selected, deselect it, or vice versa."	selectionIndex = anInteger		ifTrue:			[self deselect]		ifFalse:			[selectionIndex _ anInteger.			contents _ self selection].	self changed: #listIndex! !!ChangeList methodsFor: 'filtering'!hasFilter: index	"Answer whether one of the receiver's filters is set to on."	^index <= filterList size and: [(filterList at: index) notNil]!switchFilter: index perform: aSymbol	"Set the action aSymbol to be the action associated with the filter 	denoted by index (the position in the list of filters)."	index > filterList size		ifTrue:			[filterList _ filterList , (Array new: index - filterList size)].	(filterList at: index) isNil		ifTrue:			[selectionIndex > 0 ifTrue:				[filterKey _ list at: selectionIndex.				filterList at: index put: aSymbol]]		ifFalse:			[filterList at: index put: nil].	self updateList! !!ChangeList methodsFor: 'checking'!checkWith: aConflictChecker 	"For each item in the list that is not removed, check to see if there is 	a conflict with other items."	list do: [:change | (removed includes: change)			ifFalse: [change checkWith: aConflictChecker]]!checkWithSystem: aBoolean	changeDict _ Dictionary new.	doItDict _ Dictionary new.	checkSystem _ aBoolean.	list do: [:change |		(removed includes: change) ifFalse: [change checkWith: self]]! !!ChangeList methodsFor: 'checking-change'!addDoIt: aChange	| fileName |	fileName _ aChange fileName.	(doItDict at: fileName ifAbsent: [doItDict at: fileName put: OrderedCollection new])		add: aChange!changesAt: changeName	^changeDict at: changeName ifAbsent: [#()]!changesAt: changeName add: aChange	(changeDict at: changeName ifAbsent: [changeDict at: changeName put: OrderedCollection new])		add: aChange!checkSystem	^checkSystem!equalWithoutComments: text1 and: text2	| stream1 stream2 t |	stream1 _ ReadStream on: text1.	stream2 _ ReadStream on: text2.	[(t _ self nextNonComment: stream1) = (self nextNonComment: stream2)]		whileTrue:			[t == nil ifTrue: [^true]].	^false! !!ChangeList methodsFor: 'checking-reporting'!reportConflictsByClassWithExtension: extension	"report conflicts among the changes"	self reportChangesOn: nil extension: extension.	^self finishReportOn: (Filename named: 'DoIts', extension) writeStream!reportConflictsOn: aStream	"report conflicts among the changes"	self reportChangesOn: aStream extension: nil.	^self finishReportOn: aStream! !!ChangeList methodsFor: 'fileIn/Out'!doThis	selectionIndex > 0 ifTrue: [(list at: selectionIndex) fileIn]!doThis: listIndex	(list at: listIndex) fileIn!fileOutOn: aFile	| previous current |	current _ previous _ nil.	list do:		[:next |		(removed includes: next) ifFalse:			[current == nil				ifFalse: [current fileOutOn: aFile previous: previous next: next].			previous _ current.			current _ next]].	current == nil ifFalse:		[current fileOutOn: aFile previous: previous next: nil]! !!ChangeList methodsFor: 'lock access'!isUnlocked	^true!lock	"ignore"!unlock	"ignore"! !!ChangeList methodsFor: 'private'!addFilter: aSymbol	| value oldFilter |	value _ filterKey perform: aSymbol.	filter isNil		ifTrue: [filter _ [:change | (change perform: aSymbol) = value]]		ifFalse:			[oldFilter _ filter.			filter _ [:change | (oldFilter value: change) and: [(change perform: aSymbol) = value]]]!findLast: aString in: aStream	"Return the position in the stream of the end of the last occurrence of aString (presumably a snapshot message)"	| firstChar endPosition position count index lastEnd |	firstChar _ aString first.	aStream setToEnd.	position _ aStream position.	lastEnd _ nil.	[endPosition _ position.	lastEnd == nil and: [(position _ endPosition - 5000 max: 0) < endPosition]]		whileTrue:			[aStream position: position.			count _ endPosition - position.			[count > 0]				whileTrue:					[count _ count - 1.					aStream next = firstChar						ifTrue:							[index _ 2.							[index <= aString size and: [(aString at: index) = aStream next]]								whileTrue: [index _ index + 1].							index > aString size								ifTrue: [lastEnd _ aStream position]								ifFalse: [aStream position: endPosition - count]]]].	^lastEnd!listName: aString changes: aChangeCollection removed: aSet	listName _ aString.	changes addAll: aChangeCollection.	list addAll: aChangeCollection.	removed addAll: aSet!showingField: index	^index <= fieldList size and: [(fieldList at: index) notNil]!switchField: index perform: aSymbol	index > fieldList size		ifTrue:			[fieldList _ fieldList , (Array new: index - fieldList size)].	(fieldList at: index) isNil		ifTrue:			[fieldList at: index put: aSymbol]		ifFalse:			[fieldList at: index put: nil].	self updateSelection: selectionIndex!updateList	| oldChange newIndex |	selectionIndex > 0 ifTrue: [oldChange _ list at: selectionIndex].	filter _ nil.	filterList do: [:aSymbol | aSymbol notNil ifTrue: [self addFilter: aSymbol]].	filter isNil ifTrue: [filter _ [:change | true]].	list _ changes select: [:change | filter value: change].	newIndex _		oldChange == nil			ifTrue: [0]			ifFalse: [list indexOf: oldChange].	self updateSelection: newIndex!updateSelection: newIndex	self deselect.	self changed: #list.	newIndex > 0 ifTrue:		[self toggleListIndex: newIndex]! !!ChangeList methodsFor: 'private-checking'!finishReportOn: aStream	"report conflicts among the changes"		doItDict associationsDo:		[:aDoIt |		aStream cr; nextChunkPut: '"*** DoIts in ', aDoIt key, ' ***"'; cr; cr.		aDoIt value do:			[:doit | self tabText: doit text on: aStream] ].	aStream isEmpty ifTrue:		[Transcript show: '*** no conflicts ***'.		aStream nextChunkPut: '"*** no conflicts ***"'; cr].	^aStream close!identifySubset: contendors name: change on: reportStream extension: extension 	"report conflicts among the changes--if all of the changes are	textually identical, there are no conflicts, so don't do a report"	| matched |	matched _ true.	1 to: contendors size - 1 do: 		[:i | 		| firstText |		matched ifTrue:			[firstText _ (contendors at: i) text.			i + 1 to: contendors size do: 				[:j | 				| secondText |				secondText _ (contendors at: j) text.				matched _ matched and: [firstText = secondText]]]].	matched		ifFalse: 			[| aStream oldText |			aStream _ reportStream.			extension == nil ifFalse: [aStream _ (Filename named: ((change copyUpTo: $ )								copyWithout: $ )								, extension) appendStream].			aStream cr; nextChunkPut: '"*** conflict: ' , change , ' ***"'; cr.			oldText _ '...'.			contendors do: [:contendor | oldText _ self							writeContendor: contendor							on: aStream							oldText: oldText].			extension == nil ifFalse: [aStream close]]!nextNonComment: sourceStream	"Return the next item from the sourceStream (assumed not atEnd),	carefully ignoring comments and separators."	| char sepr |	sepr _ false.	[true]		whileTrue:			[sourceStream atEnd ifTrue: [^nil].			char _ sourceStream peek.			char = $$ ifTrue: [sourceStream next.  ^sourceStream next].	"catch chars/strings"			char = $' ifTrue: [^String readFrom: sourceStream].			char = $"				ifTrue: [sourceStream next; skipThrough: $".  sepr _ true]				ifFalse:					[char isSeparator						ifTrue: [sourceStream skipSeparators.  sepr _ true]						ifFalse: [sepr ifTrue: [^Character space].								sourceStream next.								^char]]]!reportChangesOn: reportStream extension: extension 	"report conflicts among the changes"	| contendors |	changeDict keys asSortedCollection do: 		[:change | 		contendors _ changeDict at: change.		contendors size > 1			ifTrue: [self				identifySubset: contendors				name: change				on: reportStream				extension: extension]]!tabText: text on: aStream	"report conflicts among the changes"	| cr previous terminator |	cr _ Character cr.	terminator _ $!!.	previous _ cr.	text do:		[:char |		char = cr ifFalse: [previous = cr ifTrue: [aStream tab]].		aStream nextPut: (previous _ char).		char = terminator ifTrue: [aStream nextPut: char]].	aStream nextPut: terminator; cr!writeContendor: source on: aStream oldText: oldText	"write out the change"	| text method endComment code |	aStream cr; nextChunkPut: '"File: ', source fileName, '"'; cr.	text _ source text.	(source isKindOf: MethodDefinitionChange) ifFalse:		[self tabText: text on: aStream.		^oldText].	method _ ReadStream on: text.	method skipSeparators; skipThrough: Character cr; skipSeparators. 	"skip header"	(method peekFor: $")		ifTrue:			[method skipThrough: $"; skipSeparators].	endComment _ method position.	code _ method nextChunk.	(self equalWithoutComments: code and: oldText)		ifTrue:			[method reset.			aStream cr; nextPutAll: (method next: endComment);					nextPutAll: '[SAME CODE AS ABOVE]'; cr]		ifFalse:			[aStream cr; nextChunkPut: text; cr].	^code! !!ChangeList methodsFor: 'private-changing'!addChanges: changedMessages	ChangeScanner new scanChangedMessages: changedMessages do: [:change | changes add: change].	self updateList! !!ChangeList methodsFor: 'private-menu messages'!forget	changes _ changes select: [:c | (removed includes: c) not].	removed _ Set new.	self updateList!removeAll	removed addAll: list!removeCurrent	selectionIndex > 0 ifTrue:		[removed add: (list at: selectionIndex)]!restoreAll	list do: [:change | removed remove: change ifAbsent: []]!restoreCurrent	selectionIndex > 0 ifTrue:		[removed remove: (list at: selectionIndex) ifAbsent: []]! !LockedListController subclass: #ChangeListController	instanceVariableNames: ''	classVariableNames: 'ChangeListYellowButtonMenu ChangeListYellowButtonMessages '	poolDictionaries: ''	category: 'Tools-Changes'!ChangeListController comment:'Class ChangeListController is the controller for ChangeListView, handling the list menu.Class Variables:	ChangeListYellowButtonMenu 		<PopUpMenu> menu that appears when the operate menu is pressed, operations on the list of changes	ChangeListYellowButtonMessages  <PopUpMenu> messages associated with items in the ChangeListYellowButtonMenu'!!ChangeListController methodsFor: 'initialize-release'!initialize	super initialize.	self initializeYellowButtonMenu! !!ChangeListController methodsFor: 'scrolling'!scrollView: anInteger	| viewList maximumAmount minimumAmount amount |	viewList _ view list.	maximumAmount _		viewList clippingRectangle top -		viewList compositionRectangle top max: 0.	minimumAmount _		viewList clippingRectangle bottom -		viewList compositionRectangle bottom min: 0.	amount _		(anInteger min: maximumAmount) max:		minimumAmount.	amount ~= 0		ifTrue:			[view deselect.			viewList scrollBy: amount negated.			view displaySelectionBox]! !!ChangeListController methodsFor: 'private'!changeLabel	| superView |	"This method accesses the label with a terrible kludge.  It would be better if the label were a view of its own, but there would still be problems."	superView _ view superView.	Display gray: superView labelDisplayBox.	superView label: model listName.	superView displayView!changeModelSelection: anInteger 	model toggleListIndex: anInteger!getFile: aSymbol withPrompt: promptString do: actionBlock 	"find out the file name"	| fileName |	fileName _ FillInTheBlank		request: promptString		initialAnswer: ''.	fileName isEmpty		ifFalse: 			[Cursor wait showWhile:				[actionBlock value: ((Filename named: fileName) perform: aSymbol)]]!initializeYellowButtonMenu	self		yellowButtonMenu: ChangeListYellowButtonMenu		yellowButtonMessages: ChangeListYellowButtonMessages.! !!ChangeListController methodsFor: 'private-menu messages'!browse	"Create and schedule a list browser containing only the displayed items."	self controlTerminate.	model scheduleMessageBrowser.	self controlInitialize!check	self controlTerminate.	self checkWithSystem: false.	self controlInitialize!checkWithSystem	self controlTerminate.	self checkWithSystem: true.	self controlInitialize!copyView	"Create and schedule a list browser containing only the displayed items that are not marked for removal.  Accessed by choosing the menu command clone."	self controlTerminate.	ChangeListView openOn: model filterCopy!doAll	self controlTerminate.	self doFrom: 1.	self controlInitialize!doFrom: firstIndex	"Reset selection each time through the loop, so that if an error occurs, the selection is left at the item which caused it."	firstIndex to: model listSize do:		[:index |		(model hasRemoved: index)			ifFalse:				[model toggleListIndex: index.				model doThis: index]]!doThis	self controlTerminate.	model doThis.	self controlInitialize!forget	self controlTerminate.	Cursor execute showWhile: [model forget].	self controlInitialize!getChanges	self controlTerminate.	model addChangeSet: Smalltalk changes.	self controlInitialize!recover	self controlTerminate.	model recoverFile: (SourceFiles at: 2).	self changeLabel.	self controlInitialize!removeAll	self controlTerminate.	view deselect.	model removeAll.	view displaySelectionBox.	self controlInitialize!removeItem	view deselect.	model removeCurrent.	view displaySelectionBox!restoreAll	view deselect.	model restoreAll.	view displaySelectionBox!restoreItem	view deselect.	model restoreCurrent.	view displaySelectionBox! !!ChangeListController methodsFor: 'menu messages'!checkWithSystem: aBoolean 	self		getFile: #writeStream		withPrompt: 'type name of file on which to write conflicts'		do: 			[:aFile | 			[Cursor execute showWhile: [model checkWithSystem: aBoolean].			Cursor write showWhile: [model reportConflictsOn: aFile]]				valueNowOrOnUnwindDo: [aFile close]]!fileIn	self controlTerminate.	self		getFile: #readStream		withPrompt: 'type name of file for reading'		do: 			[:aFile | 			[model scanFile: aFile]				valueNowOrOnUnwindDo: [aFile close]].	self controlInitialize!fileOut	self controlTerminate.	self		getFile: #writeStream		withPrompt: 'type name of file for writing'		do: 			[:aFile | 			[model fileOutOn: aFile]				valueNowOrOnUnwindDo: [aFile close]].	self controlInitialize! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!ChangeListController class	instanceVariableNames: ''!!ChangeListController class methodsFor: 'class initialization'!initialize	"ChangeListController initialize"	ChangeListYellowButtonMenu _		PopUpMenu			labels:'file infile outrecover last changesdisplay system changesdo allremove allrestore allspawn allforgetdo itremove itrestore itspawn itcheck conflictscheck with system'			lines: #( 4 8 9 13 ).	ChangeListYellowButtonMessages _		#(fileIn fileOut recover getChanges doAll removeAll restoreAll copyView forget doThis removeItem restoreItem browse check checkWithSystem)! !ChangeListController initialize!ListView subclass: #ChangeListView	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Tools-Changes'!ChangeListView comment:'A ChangeListView is a list view of various system changes.'!!ChangeListView methodsFor: 'initialize-release'!release	model release.	super release! !!ChangeListView methodsFor: 'model access'!model: aChangeList	super model: aChangeList.	self list: model list.	selection _ model listIndex.! !!ChangeListView methodsFor: 'controller access'!defaultControllerClass	^ChangeListController! !!ChangeListView methodsFor: 'selecting'!displaySelectionBox	super displaySelectionBox.	self reverseRemoved!reverseRemoved	"Highlight all of the items that have been marked for removal."	| box line |	self selectionInterval do:		[:index |		(model hasRemoved: index) ifTrue:			[box _ self selectionBox: index.			line _ Rectangle origin: box leftCenter - (0@1) extent: box width @ 2.			emphasisOn				ifTrue: [Display reverse: (line intersect: self clippingBox)]				ifFalse: [Display fill: (line intersect: self clippingBox) rule: Form reverse mask: Form gray]]]!selectionBox: listIndex	"Answer the rectangle in which a particular selection is displayed."	^(self insetDisplayBox left @			(list compositionRectangle top + (self selectionBoxOffset: listIndex)) 		extent: self insetDisplayBox width @ list lineGrid)		insetBy: (Rectangle left: 1 right: 1 top: 1 bottom: 0)!selectionBoxOffset: listIndex	"Answer an integer that determines the y position for the display box of a	particular selection."	^(listIndex - 1 + self minimumSelection - 1) * list lineGrid!selectionIndex: yPosition	"Answer the selection index corresponding to a particular Y coordinate."	^(yPosition - list compositionRectangle top) // list lineGrid - self minimumSelection + 2!selectionInterval	"Answer the currently visible range of selection indices."	^((self selectionIndex: self insetDisplayBox top) max: 1) to:	 ((self selectionIndex: self insetDisplayBox bottom) min: model listSize)! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!ChangeListView class	instanceVariableNames: ''!!ChangeListView class methodsFor: 'instance creation'!open	"Open a view for changes files.  Starts as an empty template."		self openOn: ChangeList new	"ChangeListView open"!openOn: aChangeList	"schedule a change browser"	| topView aChangeListView aChangeView alignPoint |	topView _ StandardSystemView new model: aChangeList.	topView label: aChangeList listName.	topView minimumSize: 180@180.	topView borderWidth: 1.	topView window: (0@0 extent: 180@410).	aChangeListView _ self new.	aChangeListView model: aChangeList.	aChangeListView window: (0@0 extent: 180@120).	aChangeListView insideColor: Form white.	aChangeListView borderWidthLeft: 1 right: 1 top: 1 bottom: 1.	topView addSubView: aChangeListView.	alignPoint _ self		openSwitches:			#(	('show file' showingField: (1) switchField:perform: (1 fileName) 90)				('show category' showingField: (2) switchField:perform: (2 category) 90)			)		topView: topView		at: aChangeListView viewport bottomLeft		model: aChangeList.	alignPoint _ self		openSwitches:			#(	(file hasFilter: (1) switchFilter:perform: (1 file) 30)				(type hasFilter: (2) switchFilter:perform: (2 class) 30)				(class hasFilter: (3) switchFilter:perform: (3 className) 30)				(category hasFilter: (4) switchFilter:perform: (4 category) 30)				(selector hasFilter: (5) switchFilter:perform: (5 selector) 30)				(same hasFilter: (6) switchFilter:perform: (6 values) 30)			)		topView: topView		at: alignPoint		model: aChangeList.	aChangeView _ StringHolderView new.	aChangeView model: aChangeList.	aChangeView controller: ChangeController new.	aChangeView window: (0@0 extent: 180@240).	aChangeView insideColor: Form white.	aChangeView borderWidthLeft: 1 right: 1 top: 1 bottom: 1.	topView		addSubView: aChangeView		align: aChangeView viewport topLeft		with: alignPoint.	topView controller open.!recover	"Open a view of the current changes file since the last snapshot."		self openOn: (ChangeList new recoverFile: (Filename named: (SourceFiles at: 2) name) readStream)	"ChangeListView recover"! !!ChangeListView class methodsFor: 'examples'!recoverExample	"One example of the use of the ChangeList is to view actions taken before a system failure.	Assuming the file 'fileName.st' contains these actions, this example opens a browser on the	contents."	"ChangeListView recoverExample."	ChangeListView openOn: (ChangeList new recoverFile: (Filename named: 'fileName.st') readStream).! !!ChangeListView class methodsFor: 'private'!openSwitches: parameters topView: topView at: initialPoint model: aChangeList	"Define a related group of switches"	| aSwitchView alignPoint |	alignPoint _ initialPoint.	parameters do:		[:args |			[:label :viewSelector :viewArguments :controllerSelector :controllerArguments :width |			aSwitchView _ SwitchView new.			aSwitchView model: aChangeList.			aSwitchView controller: LockedSwitchController new.			aSwitchView borderWidthLeft: 1 right: 1 top: 1 bottom: 1.			aSwitchView selector: viewSelector.			aSwitchView arguments: viewArguments.			aSwitchView controller selector: controllerSelector.			aSwitchView controller arguments: controllerArguments.			aSwitchView window: (0 @ 0 extent: width @ 25).			aSwitchView label: label asParagraph.			topView addSubView: aSwitchView				align: aSwitchView viewport topLeft				with: alignPoint.			alignPoint _ aSwitchView viewport topRight.			] valueWithArguments: args].	^initialPoint x @ aSwitchView viewport bottom! !Scanner subclass: #ChangeScanner	instanceVariableNames: 'file chunkString '	classVariableNames: 'ChangeTypeTable '	poolDictionaries: ''	category: 'System-Changes'!ChangeScanner comment:'Class ChangeScanner knows how to parse a file into a collection of changes.Instance Variables:	file			<File> of change information	chunkString	<String> read from the fileClass Variables:	ChangeTypeTable	<ScannerTable>'!!ChangeScanner methodsFor: 'initialize-release'!initChangeScanner	typeTable _ ChangeTypeTable.	chunkString _ String new: 200! !!ChangeScanner methodsFor: 'change set scanning'!scanChangedMessages: changedMessages do: aBlock	| selector change className class category |	changedMessages do:		[:aString |	super scan: (ReadStream on: aString).		(className _ self nextClass) notNil ifTrue:			[(selector _ self nextSelector) notNil ifTrue:				[change _ MethodDefinitionChange new className: className; selector: selector.				(className includes: Character space)					ifTrue: [class _ (Smalltalk at: (className copyUpTo: Character space) asSymbol) class]					ifFalse: [class _ Smalltalk at: className asSymbol].				category _ class whichCategoryIncludesSelector: selector asString asSymbol.				category == nil ifTrue: [category _ 'As yet unclassified'].				change category: category.				change getSource.				aBlock value: change]]]! !!ChangeScanner methodsFor: 'file scanning'!scanFile: aFile do: aBlock	"Evaluate aBlock with each item on the file"	| position |	file _ aFile.	[file skipSeparators.	file atEnd]		whileFalse:			[file peek = $!!				ifTrue:					[file next.					super scan: self nextChunkStream.					self scanSpecialDo: aBlock]				ifFalse:					[position _ file position.					self scanExpression: self nextChunkStream do:						[:item | aBlock value: (item file: file position: position)]]]!scanMethodsClass: class category: category do: aBlock	| classObject position method selector |	classObject _ Smalltalk at: class asSymbol ifAbsent: [Object].	classObject isBehavior ifFalse: [classObject _ Object].	[file skipSeparators.	position _ file position.	(method _ self nextChunkStream) atEnd]		whileFalse:			[method _ method contents.			selector _ classObject parserClass new parseSelector: method.			selector notNil ifTrue:				[aBlock value: ((MethodDefinitionChange file: file position: position) className: class; selector: selector; category: category)]]!scanSpecialDo: aBlock	"Scan a chunk of file beginning with a !!.  For now, the only thing I understand is method definitions."	| class category |	(class _ self nextClass) notNil ifTrue:		[(tokenType == #keyword and: [token = 'methodsFor:']) ifTrue:			[self scanToken.			tokenType == #string ifTrue:				[category _ token.				self scanToken.				tokenType == #doIt ifTrue:					[^self scanMethodsClass: class category: category asSymbol do: aBlock]]]].	"I don't understand what's on the file.  Scan for a blank chunk and hope for the best."	[self nextChunkStream atEnd] whileFalse: []! !!ChangeScanner methodsFor: 'expression scanning'!scanClassDefinition: classType className: superName do: aBlock	"Scan a presumed class definition.  The classType is the first keyword of the class defining message (subclass:, variableSubclass:, etc.)"	| newName parameters |	(tokenType == #literal and: [token isSymbol]) ifFalse: [^nil].	newName _ token.	parameters _ #('instanceVariableNames:' 'classVariableNames:' 'poolDictionaries:' 'category:') collect:		[:keyword |		self scanToken.		(tokenType == #keyword and: [token = keyword]) ifFalse: [^nil].		self scanToken.		tokenType == #string ifFalse: [^nil].		token].	self scanToken.	^aBlock value: (ClassDefinitionChange new className: newName; superclassName: superName classType: classType otherParameters: parameters)!scanClassExpression: class do: aBlock	"Scan an expression beginning with a class name.  This might be a class   	definition, a class removal, a class comment change, a class initialization,	a method removal, or a doIt."	| firstToken selector newName |	firstToken _ token.	self scanToken.	firstToken = 'removeSelector:'		ifTrue: 			[(tokenType == #literal and: [token isSymbol]) ifTrue:				[selector _ token.				self scanToken.				^aBlock value: (MethodOtherChange new className: class; selector: selector; type: #remove)]].	firstToken = 'rename:'		ifTrue: 			[(tokenType == #literal and: [token isSymbol]) ifTrue:				[newName _ token.				self scanToken.				aBlock value: (ClassOtherChange new className: class; type: #rename).				^aBlock value: (ClassOtherChange new className: newName; type: 'rename to' asSymbol)]].	firstToken = 'comment:'		ifTrue:			[tokenType == #string				ifTrue:					[self scanToken.					^aBlock value: (ClassCommentChange new className: class)]].	(#('subclass:' 'variableSubclass:' 'variableByteSubclass:' 'variableWordSubclass:') includes: firstToken)		ifTrue:			[^self scanClassDefinition: firstToken className: class do: aBlock].	firstToken = 'initialize'		ifTrue:			[^aBlock value: (ClassOtherChange new className: class; type: #initialize)].	firstToken = 'removeFromSystem'		ifTrue:			[^aBlock value: (ClassOtherChange new className: class; type: #remove)].	firstToken = 'instanceVariableNames:'		ifTrue:			[tokenType == #string				ifTrue:					[self scanToken.					^aBlock value: (ClassOtherChange new className: class; type: 'inst vars for' asSymbol)]].	^nil!scanExpression: aStream do: aBlock	"Scan a chunk of file consisting of an expression.  This might be a class   	definition, a class removal, a class comment change, a method removal,   	a doIt."	| class item |	super scan: aStream.	((class _ self nextClass) notNil and: [tokenType == #keyword or: [tokenType == #word]])		ifTrue:			[self scanClassExpression: class do:				[:it | item _ it.				(tokenType == #doIt or: [tokenType == #period])					ifTrue: [aBlock value: item]]].	item == nil ifTrue: [aBlock value: OtherChange new]! !!ChangeScanner methodsFor: 'private'!nextChunkStream	"Answer a read stream on the next chunk of the file."	| chunkStream char terminator |	terminator _ $!!.	file skipSeparators.	chunkStream _ ReadWriteStream on: chunkString.	[file atEnd]		whileFalse: 			[char _ file next.			char == terminator				ifTrue: [(file peekFor: terminator)						ifTrue: ["doubled terminator"							chunkStream nextPut: char]						ifFalse: [chunkStream position: 0.  ^chunkStream]]				ifFalse: [chunkStream nextPut: char]].	chunkStream position: 0.  "Sets read limit to current position"	^chunkStream!nextClass	| class |	tokenType == #word ifTrue:		[class _ token.		self scanToken.		(tokenType == #word and: [token = 'class'])			ifTrue:				[class _ (class, ' ', token) asSymbol.				self scanToken]			ifFalse:				[class _ class asSymbol].		^class].	^nil!nextSelector	| selector |	tokenType == #keyword		ifTrue:			[self scanLitWord].	(tokenType == #word or: [tokenType == #keyword or: [tokenType == #binary]])		ifTrue:			[selector _ token.			self scanToken].	^selector! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!ChangeScanner class	instanceVariableNames: ''!!ChangeScanner class methodsFor: 'class initialization'!initialize	"ChangeScanner initialize"	"change the type table to treat #-quoted symbols as a single unit	rather than a # followed by a symbol"	ChangeTypeTable _ TypeTable copy.	ChangeTypeTable at: $# asciiValue put: #xLitQuote! !!ChangeScanner class methodsFor: 'instance creation'!new	^super new initChangeScanner! !ChangeScanner initialize!Object subclass: #ChangeSet	instanceVariableNames: 'classChanges methodChanges classRemoves reorganizeSystem specialDoIts '	classVariableNames: ''	poolDictionaries: ''	category: 'System-Changes'!ChangeSet comment:'Instances of class ChangeSet keep track of the changes made to a system, so it is possible to make an incremental fileOut.  Instances do not remember the order in which changes are made, although this sometimes matters.Instance Variables:	classChanges	<Dictionary> {class name -> <Set> 						{add, change, comment, rename, reorganize, ''oldName: xxx''}}	methodChanges	<Dictionary> {class name -> <IdentityDictionary> 										{selector -> add | change | remove}}	classRemoves	<Set> {class name}	reorganizeSystem	<Boolean> - indicates if SystemOrganization was changed.	specialDoIts		<OrderedCollection> of Smalltalk expressions.'!!ChangeSet methodsFor: 'initialize-release'!initialize	"Reset the receiver to be empty."	classChanges _ Dictionary new.	methodChanges _ Dictionary new.	classRemoves _ Set new.	reorganizeSystem _ false.	specialDoIts _ OrderedCollection new.! !!ChangeSet methodsFor: 'testing'!isEmpty	"Answer whether the receiver contains any elements."	^(((methodChanges isEmpty and: [classChanges isEmpty])		and: [classRemoves isEmpty]) and: [reorganizeSystem not]) and: [specialDoIts isEmpty]! !!ChangeSet methodsFor: 'converting'!asSortedCollection	"Answer a new instance of SortedCollection whose elements are Strings describing the changes represented by the receiver."	| summary |	summary _ SortedCollection new.	classChanges associationsDo: 		[:clAssoc | 		clAssoc value do: 			[:changeType | summary add: clAssoc key, ' - ', changeType]].	methodChanges associationsDo: 		[:clAssoc | 		clAssoc value associationsDo: 			[:mAssoc | summary add: clAssoc key, ' ', mAssoc key, ' - ', mAssoc value]].	classRemoves do:		[:name | summary add: name, ' - ', 'remove'].	reorganizeSystem ifTrue: [summary add: 'Reorganize System'].	specialDoIts isEmpty not ifTrue:		[summary add: 'SpecialDoIts - (', specialDoIts size printString, ')'].	^summary! !!ChangeSet methodsFor: 'change management'!addClass: class 	"Include indication that a new class was created." 	classRemoves remove: class name ifAbsent: [].	self atClass: class add: #add!addDoIt: smalltalkExpression	"When filing out changes, append this string to the file." 	specialDoIts add: smalltalkExpression!changeClass: class 	"Include indication that a class definition has been changed."	self atClass: class add: #change!changedClasses	"Answer a collection of the changed or edited classes, not including removed classes."	| classes |	classes _ Set new.	methodChanges keys do: [:className | classes add: (self classNamed: className)].	classChanges keys do: [:className | classes add: (self classNamed: className)].	^classes!commentClass: class 	"Include indication that a class comment has been changed."	self atClass: class add: #comment!removeClass: class 	"Include indication that a class has been forgotten."	| name |	(self isNew: class) ifTrue:		[^self removeClassChanges: class]. 	"only remember old classes"	(self atClass: class includes: #rename) 	"remember as old name"		ifTrue: [name _ self oldNameFor: class]		ifFalse: [name _ class name].	self removeClassChanges: class.	classRemoves add: name!removeClassChanges: class 	"Remove all memory of changes associated with this class and its metaclass."	classChanges removeKey: class name ifAbsent: [].	methodChanges removeKey: class name ifAbsent: [].	classChanges removeKey: class class name ifAbsent: [].	methodChanges removeKey: class class name ifAbsent: [].	classRemoves remove: class name ifAbsent: [].!renameClass: class as: newName 	"Include indication that a class has been renamed."	| value |	(self atClass: class includes: #rename) ifFalse:		[self atClass: class add: 'oldName: ', class name. 	"only original name matters"		self atClass: class add: #rename]. 	"copy changes using new name (metaclass too)"	(Array with: classChanges with: methodChanges) do:		[:changes |		(value _ changes at: class name ifAbsent: [nil]) == nil ifFalse:			[changes at: newName put: value.			changes removeKey: class name].		(value _ changes at: class class name ifAbsent: [nil]) == nil ifFalse:			[changes at: (newName, ' class') put: value.			changes removeKey: class class name]]!reorganizeClass: class 	"Include indication that a class was reorganized." 	self atClass: class add: #reorganize!reorganizeSystem	"Include indication that the system classes were reorganized." 	reorganizeSystem _ true! !!ChangeSet methodsFor: 'method changes'!addSelector: selector class: class 	"Include indication that a method has been added."	self atSelector: selector class: class put: #add!changedMessageList	"Answer an array that identifies the methods that have been changed.	Each entry is a String containing the class name and method selector."	| messageList |	messageList _ SortedCollection new.	methodChanges associationsDo: 		[:clAssoc | 		clAssoc value associationsDo: 			[:mAssoc |			mAssoc value = #remove ifFalse:				[messageList add: clAssoc key asString, ' ' , mAssoc key]]].	^messageList asArray!changeSelector: selector class: class 	"Include indication that a method has been edited."	(self atSelector: selector class: class) = #add 		ifFalse: [self atSelector: selector class: class put: #change]			"Don't forget a method is new just because it's been changed"!removeSelector: selector class: class 	"Include indication that a method has been forgotten."	(self atSelector: selector class: class) = #add		ifTrue: [self removeSelectorChanges: selector 					class: class]					"Forgot a new method, no-op"		ifFalse: [self atSelector: selector					class: class					put: #remove]!removeSelectorChanges: selector class: class 	"Remove all memory of changes associated with the argument,	selector, in this class."	| dictionary |	dictionary _ methodChanges at: class name ifAbsent: [^self].	dictionary removeKey: selector ifAbsent: [].	dictionary isEmpty ifTrue: [methodChanges removeKey: class name]! !!ChangeSet methodsFor: 'fileIn/Out'!fileOutChangesFor: class on: stream 	"Write out all the changes the receiver knows about this class."	| changes removes |					"first file out class changes"	self fileOutClassChanges: class on: stream.					"next file out changed methods"	removes _ OrderedCollection new.	changes _ OrderedCollection new.	(methodChanges at: class name ifAbsent: [^self]) associationsDo: 		[:mAssoc | 		mAssoc value = #remove			ifTrue: [removes add: mAssoc key]			ifFalse: [changes add: mAssoc key]].	changes isEmpty ifFalse: 		[class fileOutChangedMessages: changes on: stream.		stream cr].	removes do:		[:selector |		stream nextChunkPut:				class name, ' removeSelector: ', selector storeString; cr].	"reintialize metaclass if necessary"	(class isMeta and: [changes includes: #initialize]) ifTrue:		[stream nextChunkPut: class soleInstance name, ' initialize'; cr].!fileOutOn: stream 	"Write out all the changes the receiver knows about."	self isEmpty ifTrue: [self notify: 'Warning: no changes to file out'].	(ChangeSet superclassOrder: self changedClasses asOrderedCollection) do:		[:class |		self fileOutChangesFor: class on: stream].	classRemoves do:		[:className |		stream nextChunkPut: 'Smalltalk removeClassNamed: #', className; cr].	reorganizeSystem ifTrue:		[stream cr.		stream nextChunkPut: 'SystemOrganization changeFromString: ', SystemOrganization printString storeString.		stream cr; cr].	specialDoIts do:		[:expression |		stream nextChunkPut: expression; cr].!putStatsOn: stream 	"Write out all the changes the receiver knows about."	| changedClasses classes removes changes adds |	self isEmpty ifTrue: [stream nextPutAll: 'an Empty ChangeSet'. ^self].	reorganizeSystem ifTrue: [stream nextPutAll: 'Reorganized System' ;cr;cr].	changedClasses _ ChangeSet superclassOrder: self changedClasses asOrderedCollection.	classes _ changedClasses select: [:class | self atClass: class includes: #add].	classes isEmpty		ifFalse: 			[stream nextPutAll: 'Added classes:'; cr.			classes do: [:class | stream tab; nextPutAll: class name; cr].			stream cr].	classes _ changedClasses select: [:class | self atClass: class includes: #rename].	classes isEmpty		ifFalse: 			[stream nextPutAll: 'Renamed classes:'; cr.			classes do: [:class | stream tab; nextPutAll: (self oldNameFor: class); tab; nextPutAll: 'became'; tab; nextPutAll: class name; cr].			stream cr].	classes _ changedClasses select: [:class | self atClass: class includes: #change].	classes isEmpty		ifFalse: 			[stream nextPutAll: 'Redefined classes:'; cr.			classes do: [:class | stream tab; nextPutAll: class name; cr].			stream cr].	classes _ changedClasses select: [:class | self atClass: class includes: #comment].	classes isEmpty		ifFalse: 			[stream nextPutAll: 'Classes with changed comment:'; cr.			classes do: [:class | stream tab; nextPutAll: class name; cr].			stream cr].	classRemoves isEmpty		ifFalse: 			[stream nextPutAll: 'Removed classes:'; cr.			classRemoves do: [:class | stream tab; nextPutAll: class; cr].			stream cr].	classes _ changedClasses select: [:class | self atClass: class includes: #reorganize].	classes isEmpty		ifFalse: 			[stream nextPutAll: 'ReOrganized classes:'; cr.			classes do: [:class | stream tab; nextPutAll: class name; cr].			stream cr].	stream nextPutAll: 'Method changes:'; cr.	methodChanges		associationsDo: 			[:class | 			stream tab; nextPutAll: class key; cr.			removes _ OrderedCollection new.			changes _ OrderedCollection new.			adds _ OrderedCollection new.			class value associationsDo: [:mAssoc | mAssoc value = #remove					ifTrue: [removes add: mAssoc key]					ifFalse: [mAssoc value = #change							ifTrue: [changes add: mAssoc key]							ifFalse: [adds add: mAssoc key]]].			adds isEmpty				ifFalse: 					[stream tab; tab; nextPutAll: 'Added methods:'; cr.					adds do: [:selector | stream tab; tab; tab; nextPutAll: selector; cr]].			changes isEmpty				ifFalse: 					[stream tab; tab; nextPutAll: 'Changed methods:'; cr.					changes do: [:selector | stream tab; tab; tab; nextPutAll: selector; cr]].			removes isEmpty				ifFalse: 					[stream tab; tab; nextPutAll: 'Removed methods:'; cr.					removes do: [:selector | stream tab; tab; tab; nextPutAll: selector; cr]].			stream cr]! !!ChangeSet methodsFor: 'printing'!printOn: aStream 	"Append to the argument aStream a sequence of characters that 	identifies the receiver."	self putStatsOn: aStream! !!ChangeSet methodsFor: 'private'!atClass: class add: changeType 	(self isNew: class) ifFalse: 	"new classes don't matter"		[(classChanges at: class name				ifAbsent: [^classChanges at: class name put:					(Set with: changeType)])			add: changeType]!atClass: class includes: changeType	^(classChanges at: class name ifAbsent: [^false])		includes: changeType!atSelector: selector class: class 	^(methodChanges at: class name ifAbsent: [^#none])		at: selector ifAbsent: [#none]!atSelector: selector class: class put: changeType 	| name dict |	(self isNew: class) ifTrue: [^self]. 	"Don't keep method changes for new classes"	name _ class name.	(methodChanges at: name		ifAbsent: 			[dict _ IdentityDictionary new.			methodChanges at: name put: dict.			dict])		at: selector put: changeType!classNamed: className 	"className is either a class name or a class name followed by ' class'.  Answer the class or metaclass it names."	| meta name class |	(className size > 6 		and: [(className copyFrom: className size - 5 to: className size) = ' class'])		ifTrue: 			[meta _ true.			name _ className copyFrom: 1 to: className size - 6]		ifFalse: 			[meta _ false.			name _ className].	class _ Smalltalk at: name asSymbol.	meta		ifTrue: [^class class]		ifFalse: [^class]!fileOutClassChanges: class on: stream 	"Write out class changes.  i.e.  new class, definition, comment, renaming."	(self atClass: class includes: #add) ifTrue:		[stream cr.		class fileOutOn: stream.		stream cr.		^self atClass: class add: #add  "fileOut clears this!!"].	(self atClass: class includes: #rename) ifTrue:		[stream nextChunkPut: (self oldNameFor: class), ' rename: #', class name; cr].	(self atClass: class includes: #change) ifTrue:		[stream emphasis: 5; nextChunkPut: class definition; cr; emphasis: 1].	(self atClass: class includes: #comment) ifTrue:		[class organization putCommentOnFile: stream			numbered: nil moveSource: false.		stream cr].	(self atClass: class includes: #reorganize) ifTrue:		[class fileOutOrganizationOn: stream.		stream cr]!isNew: class	"Answer whether this class was added since the ChangeSet was cleared."	class isMeta		ifTrue: [^self atClass: class soleInstance includes: #add "check class"]		ifFalse: [^self atClass: class includes: #add]!oldNameFor: class	| name |	name _ (classChanges at: class name) asOrderedCollection detect:				[:x | 'oldName: *' match: x].	^(Scanner new scanTokens: name) last! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!ChangeSet class	instanceVariableNames: ''!!ChangeSet class methodsFor: 'instance creation'!new	^super new initialize! !!ChangeSet class methodsFor: 'fileIn/Out'!sortFrom: left order: order item: item 	"Add all subclasses or the metaclass of an item that are in 'left', 	into 'order'"	| list |	order addLast: item.	(item isMeta not and: [left includes: item class])		ifTrue:	[left remove: item class.				order addLast: item class].	list _ left select:		[:i |		i superclass == item and:			[i isMeta not or: [(left includes: i soleInstance) not]]].	list do: [:i | left remove: i].	list do: [:i | self			sortFrom: left			order: order			item: i]!superclassOrder: items 	"Sort all of the classes in the list into a collection where no class is 	preceded by a subclass or by its metaclass"	| order left root |	left _ IdentitySet new.	left addAll: items.	order _ OrderedCollection new.	[left isEmpty]		whileFalse: 			[root _ left detect:				[:i | 				(i isMeta 					ifTrue: ["meta should be put after soleInstance if there"							(left includes: i soleInstance) not] 					ifFalse: [true])						 and: [(left includes: i superclass) not]].			left remove: root.			self				sortFrom: left				order: order				item: root].	^order! !Magnitude subclass: #Character	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Collections-Text'!Character comment:'An instance of class Character is an element of a String.  Characters are identified by a non-negative SmallInteger code: in particular, codes 0-127 define characters according to the ASCII standard.  Instances of class Character are unique, in that all instances with the same code are identical (==).  Characters can be expressed literally by preceding the character by a dollar sign ($): for example, $A represents the capital letter "A".Characters, like SmallIntegers, use an "immediate" representation -- the character code is stored directly in the object pointer.'!!Character methodsFor: 'accessing'!asciiValue	"Answer the code value of the receiver."	<primitive: 410>	^self primitiveFailed!digitValue	"Answer 0-9 if the receiver is $0-$9, 10-35 if it is $A-$Z or $a-$z, and < 0 otherwise.	This is used to parse literal numbers of radix 2-36."	| ascii value |	ascii _ self asciiValue.	value _ ascii - $0 asciiValue.	value <= 9		ifTrue: [^value].	value _ ascii - $A asciiValue.	(value >= 0 and: [value < 26])		ifTrue: [^value + 10].	value _ ascii - $a asciiValue.	(value >= 0 and: [value < 26])		ifTrue: [^value + 10].	^-1! !!Character methodsFor: 'comparing'!< aCharacter 	"Answer whether the receiver's value is less than aCharacter's value."	^self asciiValue < aCharacter asciiValue!= aCharacter 	"Answer whether the receiver and the argument are the same object 	(have the same object pointer).  Optional.  See Object documentation 	whatIsAPrimitive. "	<primitive: 110>	^self == aCharacter!> aCharacter 	"Answer whether the receiver's value > aCharacter's value."	^self asciiValue > aCharacter asciiValue!hash	"Answer a SmallInteger unique to the receiver."	^self asciiValue!identityHash	"Answer a SmallInteger unique to the receiver."	"Must override method in Object, because characters are immediate."	^self asciiValue! !!Character methodsFor: 'testing'!isAlphabetic	"Answer whether the receiver is in the English alphabet."	^($a <= self and: [self <= $z])		or: [$A <= self and: [self <= $Z]]!isAlphaNumeric	"Answer whether the receiver is in the English alphabet or a digit."	^self isAlphabetic or: [self isDigit]!isDigit	"Answer whether the receiver is a digit."	^self >= $0 and: [self <= $9]!isLetter	"Answer whether the receiver is in the English alphabet or	an extended (multi-byte) character."	^self isAlphabetic or: [self asciiValue > 255]!isLowercase	"Answer whether the receiver is a lowercase alphabetic character."	^self >= $a and: [self <= $z]!isManifest	"Answer whether receiver is manifestly storable."	^true!isSeparator	"Answer whether the receiver is one of the separator characters--space,	cr, tab, line feed, null , or form feed."	| ascii |	ascii _ self asciiValue.	ascii > 32 ifTrue: [^false]. "normal character"	ascii = 32 ifTrue: [^true].	"space"	ascii = 13 ifTrue: [^true].	"cr"	ascii = 9 ifTrue: [^true].	"tab"	ascii = 10 ifTrue: [^true].	"line feed"	ascii = 12 ifTrue: [^true].	"form feed"	ascii = 0 ifTrue: [^true].	"null"	^false!isUppercase	"Answer whether the receiver is an uppercase alphabetic character."	^self >= $A and: [self <= $Z]!isVowel	"Answer whether the receiver is one of the vowels, AEIOU, in upper or lower case."	^'AEIOU' includes: self asUppercase!tokenish	"Answer whether the receiver is a valid token-character--letter, digit, or colon."	^self isLetter or: [self isDigit or: [self = $:]]! !!Character methodsFor: 'copying'!copy	"Answer the receiver because Characters are unique."	^self!deepCopy	"Answer the receiver becuase Characters are unique."	^self!shallowCopy	"Answer the receiver because Characters are unique"	^self! !!Character methodsFor: 'printing'!isLiteral	"Answer true that the receiver is a literal."	^true!printOn: aStream  	"Append to the argument aStream a sequence of characters preceded by the	literal $ that identifies the receiver."	aStream nextPut: $$.	aStream nextPut: self!storeOn: aStream	"Append to the argument aStream a sequence of characters that is an	expression whose evaluation creates an object similar to the receiver.	Character literals are preceded by '$'."	aStream nextPut: $$; nextPut: self! !!Character methodsFor: 'converting'!asCharacter	"Answer the receiver itself."	^self!asInteger	"Answer the value of the receiver."	<primitive: 410>	^self primitiveFailed!asLowercase	"Answer a Character that is the lower case letter corresponding to the receiver.  If	the receiver is not an upper case letter, answer the receiver itself."	| ascii |	ascii _ self asciiValue.	8r101 <= ascii 		ifTrue: [ascii <= 8r132 					ifTrue: [^Character value: ascii+8r40]]!asSymbol	"Answer the receiver converted into a Symbol."	^Symbol internCharacter: self!asUppercase	"Answer a Character that is the upper case letter corresponding to  	the receiver.  If the receiver is not a lower case letter, answer the 	receiver itself."	| ascii |	ascii _ self asciiValue.	8r141 <= ascii		ifTrue: [ascii <= 8r172 					ifTrue: [^Character value: ascii-8r40]]! !!Character methodsFor: 'fileIn/Out'!storeBinaryOn: stream 	"Put a binary representation of the receiver into stream."	stream storeCharacter: self! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Character class	instanceVariableNames: ''!!Character class methodsFor: 'instance creation'!basicNew	"Provide an error notification that creating new characters	this way is not allowed."	self error: 'Use Character value: to create new characters'!digitValue: aNumber	"Answer the Character whose digit value is aNumber.	For example, answer $9 for aNumber=9, $0 for aNumber=0,	$A for aNumber=10, $Z for aNumber=35."	| index |	index _ aNumber asSmallInteger.	^self value:		(index < 10			ifTrue: [48 + index]			ifFalse: [55 + index])!new	"Provide an error notification that creating new characters	this way is not allowed."	self error: 'Use Character value: to create new characters'!value: anInteger 	"Answer the Character whose value is anInteger."	<primitive: 411>	^self valueFromInteger: anInteger asSmallInteger!valueFromInteger: anInteger 	"Answer the Character whose value is anInteger."	<primitive: 411>	^self error: 'Character values must be non-negative SmallIntegers'! !!Character class methodsFor: 'accessing untypeable characters'!backspace	"Answer the Character representing a backspace."	^self value: 8!cr	"Answer the Character representing a carriage return."	^self value: 13!esc	"Answer the Character representing an escape."	^self value: 27!lf	"Answer the Character representing a carriage return."	^self value: 10!newPage	"Answer the Character representing a form feed."	^self value: 12!space	"Answer the Character representing a space."	^self value: 32!tab	"Answer the Character representing a tab."	^self value: 9! !Rectangle subclass: #CharacterBlock	instanceVariableNames: 'stringIndex character '	classVariableNames: ''	poolDictionaries: 'TextConstants '	category: 'Graphics-Support'!CharacterBlock comment:'Class CharacterBlock represents information about displayed characters.  Instances are used to return the results of methods	Paragraph characterBlockAtPoint: aPoint and	Paragraph characterBlockForIndex: stringIndex.Any recomposition or movement of a Paragraph can make the information obsolete.Instance Variables:	stringIndex	<Integer> the position of the receiver in the displayed string	character	<Character> the displayed characterPool Dictionary:	TextConstants	<Dictionary>'!!CharacterBlock methodsFor: 'comparing'!< aCharacterBlock 	"Answer whether the string index of the receiver precedes that of 	the argument, aCharacterBlock."	^stringIndex < aCharacterBlock stringIndex!<= aCharacterBlock 	"Answer whether the string index of the receiver does not come after that of	aCharacterBlock."	^(self > aCharacterBlock) not!= aCharacterBlock 	"Answer whether the string index of the receiver is that same	as that of the argument, aCharacterBlock."	self species = aCharacterBlock species		ifTrue: [^stringIndex = aCharacterBlock stringIndex]		ifFalse: [^false]!> aCharacterBlock 	"Answer whether the string index of the receiver comes after that of	aCharacterBlock."	^aCharacterBlock < self!>= aCharacterBlock 	"Answer whether the string index of the receiver does not precede that of	aCharacterBlock."	^(self < aCharacterBlock) not! !!CharacterBlock methodsFor: 'copying'!copy	"Answer another instance just like the receiver."	^self deepCopy! !!CharacterBlock methodsFor: 'accessing'!character	"Answer the character in the receiver."	^character!stringIndex	"Answer the position of the receiver in the string that it indexes."	^stringIndex!stringIndex: index	 "Store the argument index as the position of the character in the string."	stringIndex _ index! !!CharacterBlock methodsFor: 'printing'!printOn: aStream  	"Append to the argument aStream a sequence of characters that identifies the receiver.	The general format is		a CharacterBlock with index stringindex and character character and rectangle etc."	aStream nextPutAll: 'a CharacterBlock with index '.	stringIndex printOn: aStream.	aStream nextPutAll: ' and character '.	character printOn: aStream.	aStream nextPutAll: ' and rectangle '.	super printOn: aStream! !!CharacterBlock methodsFor: 'private'!newStringIndex: anInteger Character: aCharacter BoundingRectangle: aRectangle 		stringIndex _ anInteger.	character _ aCharacter.	super origin: aRectangle topLeft.	super corner: aRectangle corner!newStringIndex: anInteger Character: aCharacter TopLeft: originPoint Extent: extentPoint 	stringIndex _ anInteger.	character _ aCharacter.	super origin: originPoint.	super extent: extentPoint! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!CharacterBlock class	instanceVariableNames: ''!!CharacterBlock class methodsFor: 'instance creation'!stringIndex: anInteger character: aCharacter boundingRectangle: aRectangle 	"Answer an instance of the receiver with values set to the arguments."	^self new		newStringIndex: anInteger		Character: aCharacter		BoundingRectangle: aRectangle!stringIndex: anInteger character: aCharacter topLeft: originPoint extent: extentPoint 	"Answer an instance of the receiver with values set to the arguments."	^self new		newStringIndex: anInteger		Character: aCharacter		TopLeft: originPoint		Extent: extentPoint! !CharacterScanner subclass: #CharacterBlockScanner	instanceVariableNames: 'characterPoint characterIndex lastCharacter lastCharacterExtent lastSpaceOrTabExtent nextLeftMargin '	classVariableNames: ''	poolDictionaries: 'TextConstants '	category: 'Graphics-Support'!CharacterBlockScanner comment:'Instances of class CharacterBlockScanner are used to scan text to compute the CharacterBlock for a character specified by its index in the text or its proximity to the cursor location.Instance Variables:	characterPoint <Point>  Used in character location domain.  The topLeft of the character to be returned in a CharacterBlock.	characterIndex <Integer>  Used in character location domain.  The index in the stylizedString of the character to be returned in a CharacterBlock.	lastCharacter <Character>  Used in character location domain.  The character to be returned in a CharacterBlock.	lastCharacterExtent <Point>  Used in character location domain.  The extent of the character to be returned in a CharacterBlock.  The height is usually the stringStyle''s lineGrid.	lastSpaceOrTabExtent <Point>  Used in character location domain.  If the lastCharacter is a space or a tab, this will be its extent, an unexpected value when justification is turned on, and a variable value in the case of tab no matter what the alignment value is.	nextLeftMargin <Integer>  When, as in the case of cr, the left margin of the succeeding line is what is desired, this value, known to the paragraph is needed.  Since the paragraph is not available to the stop conditions, this value is set when the line of the character is discovered and before access to the paragraph is lost.Pool Dictionary:	TextConstants	<Dictionary>'!!CharacterBlockScanner methodsFor: 'scanning'!characterBlockAtPoint: aPoint in: aParagraph 	"Answer a CharacterBlock for character in aParagraph at point 	aPoint.  It is assumed that aPoint has been transformed into 	coordinates appropriate to the text's destinationForm rectangle and 	the compositionRectangle."	super initializeFromParagraph: aParagraph clippedBy: aParagraph clippingRectangle.	characterPoint _ aPoint.	^self buildCharacterBlockIn: aParagraph!characterBlockForIndex: targetIndex in: aParagraph 	"Answer a CharacterBlock for character in aParagraph at 	targetIndex.  The coordinates in the CharacterBlock will be 	appropriate to the intersection of the destinationForm rectangle and 	the compositionRectangle."	super 		initializeFromParagraph: aParagraph 		clippedBy: aParagraph clippingRectangle.	characterIndex _ targetIndex.	characterPoint _ 		aParagraph rightMarginForDisplay @ 			(aParagraph topAtLineIndex: 				(aParagraph lineIndexOfCharacterIndex: characterIndex)).	^self buildCharacterBlockIn: aParagraph!characterNotInFont	"Handle the situation when the character encountered is not	defined in the current font."	"This does not handle character selection nicely, i.e., illegal 	characters are a little tricky to select.  Since the end of a run or 	line is subverted here by actually having the scanner scan a 	different string in order to manage the illegal character, things are 	not in an absolutely correct state for the character location code. "	lastCharacterExtent _ (font widthOf: (font maxAscii + 1) asCharacter)				@ textStyle lineGrid.	^super characterNotInFont! !!CharacterBlockScanner methodsFor: 'stop conditions'!cr	"Answer an instance of CharacterBlock that specifies the current 	location of the mouse relative to a carriage return stop condition 	that has just been encountered.  The ParagraphEditor convention is 	to denote selections by CharacterBlocks, sometimes including the 	carriage return (cursor is at the end) and sometimes not (cursor is in 	the middle of the text)."	((characterIndex ~= nil		and: [characterIndex > text size])			or: [(line last = text size)				and: [(destY + textStyle lineGrid) < characterPoint y]])		ifTrue:	["When off end of string, give data for next character"				destY _ destY +  textStyle lineGrid.				lastCharacter _ nil.				characterPoint _ 					Point						x: ((text at: lastIndex) = CR								ifTrue: [leftMargin]								ifFalse: [nextLeftMargin])						y: destY.				lastIndex _ lastIndex + 1.				lastCharacterExtent x: 0.				^ true].		lastCharacter _ CR.		characterPoint _ destX @ destY.		lastCharacterExtent x: rightMargin - destX.		^true!crossedX	"Text display has wrapping.  The scanner just found a character past the 	x location of the cursor.  We know that the cursor is pointing at a character 	or before one."	| leadingTab currentX |	((characterPoint x <= (destX + ((lastCharacterExtent x) // 2)))		or: [line last = lastIndex])		ifTrue:	[lastCharacter _ (text at: lastIndex).							((lastCharacter = Space and: [textStyle alignment = Justified])					and: [destX + lastCharacterExtent x > rightMargin])					ifTrue:	[characterPoint _ nextLeftMargin @ (destY + textStyle lineGrid).							characterIndex notNil								ifTrue:	[lastIndex _ (characterIndex min: (line last + 1))]								ifFalse:	[lastIndex _ (lastIndex + 1) min: (line last + 1)]]					ifFalse:	[((lastCharacter = Tab) and: [line last = lastIndex])								ifTrue:	[(characterPoint x <= (destX + ((lastCharacterExtent x) // 2)))											ifFalse:												[destX _ (destX + lastCharacterExtent x).												characterPoint _ destX @ destY.												^ self endOfRun]].								characterPoint _ destX @ destY].				^true].	"Pointing past middle of a character, return the next character."	lastIndex _ lastIndex + 1.	lastCharacter _ text at: lastIndex.	currentX _ destX + lastCharacterExtent x.	lastCharacterExtent x: (font widthOf: lastCharacter).	characterPoint _ currentX @ destY.	"Yukky if next character is space or tab."	(lastCharacter = Space and: [textStyle alignment = Justified])		ifTrue:	[lastCharacterExtent x:					(lastCharacterExtent x + (line justifiedPadFor: (spaceCount + 1))).				^true].	lastCharacter = Tab		ifTrue:			["See tabForDisplay for illumination on the following awfulness."			leadingTab _ true.			(line first to: lastIndex - 1) do:			[:index |			(text at: index) = Space				ifTrue: [leadingTab _ false]].			(textStyle alignment ~= Justified or: [leadingTab])				ifTrue:	[lastCharacterExtent x: (textStyle nextTabXFrom: currentX							leftMargin: leftMargin rightMargin: rightMargin) -								currentX]				ifFalse:	[lastCharacterExtent x:  (((currentX + (textStyle tabWidth -								(line justifiedTabDeltaFor: spaceCount))) -									currentX) max: 0)]].	^ true!endOfRun	"Before arriving at the cursor location, the selection has encountered an 	end of run.  Answer false if the selection continues, true otherwise.  	Set up indexes for building the appropriate CharacterBlock."	| runLength lineStop |	((characterIndex ~~ nil and:		[runStopIndex < characterIndex and: [runStopIndex < text size]])			or:	[characterIndex == nil and: [lastIndex < line last]])		ifTrue:	["We're really at the end of a real run."				runLength _ (text runLengthFor: (lastIndex _ lastIndex + 1)).				characterIndex ~~ nil					ifTrue:	[lineStop _ characterIndex	"scanning for index"]					ifFalse:	[lineStop _ line last			"scanning for point"].				(runStopIndex _ lastIndex + (runLength - 1)) > lineStop					ifTrue: 	[runStopIndex _ lineStop].				self setStopConditions.				^false].	lastCharacter _ text at: lastIndex.	characterPoint _ destX @ destY.	((lastCharacter = Space and: [textStyle alignment = Justified])		or: [lastCharacter = Tab])		ifTrue: [lastCharacterExtent _ lastSpaceOrTabExtent].	characterIndex ~~ nil		ifTrue:	["If scanning for an index and we've stopped on that index,				then we back destX off by the width of the character stopped on				(it will be pointing at the right side of the character) and return"				runStopIndex = characterIndex					ifTrue:	[characterPoint x: destX - lastCharacterExtent x.							^true].				"Otherwise the requested index was greater than the length of the				string.  Return string size + 1 as index, indicate further that off the				string by setting character to nil and the extent to 0."				lastIndex _  lastIndex + 1.				lastCharacter _ nil.				lastCharacterExtent x: 0.				^true].	"Scanning for a point and either off the end of the line or off the end of the string."	runStopIndex = text size		ifTrue:	["off end of string"				lastIndex _  lastIndex + 1.				lastCharacter _ nil.				lastCharacterExtent x: 0.				^true].	"just off end of line without crossing x"	lastIndex _ lastIndex + 1.	^true!onePixelBackspace	"Decrement destX by 1 pixel size."	| characterWidth |	characterWidth _ 1.	lastCharacterExtent x: characterWidth.	lastIndex _ lastIndex + 1.	destX _ (destX - characterWidth) max: leftMargin.	^ false!onePixelSpace	"Increment destX by 1 pixel size."	| characterWidth |	characterWidth _ 1.	lastCharacterExtent x: characterWidth.	(destX + characterWidth)  >= characterPoint x		ifTrue: [^self crossedX].	lastIndex _ lastIndex + 1.	destX _ destX + characterWidth.	^ false!paddedSpace	"When the line is justified, the spaces will not be the same as the 	font's space character.  A padding of extra space must be 	considered in trying to find which character the cursor is pointing at. 	Answer true if the scanning has crossed the cursor, false otherwise."	| pad |	spaceCount _ spaceCount + 1.	pad _ line justifiedPadFor: spaceCount.	lastSpaceOrTabExtent _ lastCharacterExtent copy.	lastSpaceOrTabExtent x: spaceWidth + pad.	destX + lastSpaceOrTabExtent x >= characterPoint x		ifTrue: 			[lastCharacterExtent _ lastSpaceOrTabExtent copy.			^self crossedX].	lastIndex _ lastIndex + 1.	destX _ destX + lastSpaceOrTabExtent x.	^false!setStopConditions	"Set the font and the stop conditions for the current run."	font _ textStyle fontAt: (text emphasisAt: lastIndex).	super setStopConditions.	stopConditions 		at: Space asInteger + 1 		put: (textStyle alignment = Justified				ifTrue: [#paddedSpace]				ifFalse: [nil])!tab	"Handle leading and internal tabs in a justified line.  Leading tabs are 	considered legal and should be reflected on the display gracefully.  	Internal tabs (when the line is justified) are considered at the very 		best a misguided use of the character, and are reflected on the display 	the best we can."	| leadingTab currentX |	currentX _ destX.	leadingTab _ true.	(line first to: lastIndex)		do: [:index | (text at: index) = Space ifTrue: [leadingTab _ false]].	(textStyle alignment ~= Justified or: [leadingTab])		ifTrue: [currentX _ 					textStyle						nextTabXFrom: currentX						leftMargin: leftMargin						rightMargin: rightMargin]		ifFalse: [currentX _ 					currentX + (textStyle tabWidth - 						(line justifiedTabDeltaFor: spaceCount)) max: destX].	lastSpaceOrTabExtent _ lastCharacterExtent copy.	lastSpaceOrTabExtent x: (currentX - destX max: 0).	currentX >= characterPoint x		ifTrue: 			[lastCharacterExtent _ lastSpaceOrTabExtent copy.			^self crossedX].	destX _ currentX.	lastIndex _ lastIndex + 1.	^false! !!CharacterBlockScanner methodsFor: 'private'!buildCharacterBlockIn: aParagraph	| lineIndex runLength lineStop done stopCondition |	"handle nullText"	(aParagraph numberOfLines = 0 or: [text size = 0])		ifTrue:	[leftMargin _ (aParagraph leftMarginForDisplayForLine: 1).				^CharacterBlock					stringIndex: 1	"like being off end of string"					character: nil					topLeft: (leftMargin @								(aParagraph compositionRectangle) top)					extent: (0 @ textStyle lineGrid)].	"find the line"	lineIndex _ aParagraph lineIndexOfTop: characterPoint y.	destY _ (aParagraph topAtLineIndex: lineIndex).	line _ aParagraph lineAt: lineIndex.	text _ aParagraph textAt: lineIndex.	rightMargin _ aParagraph rightMarginForDisplay.	(lineIndex = aParagraph numberOfLines and:		[(destY + textStyle lineGrid) < characterPoint y])			ifTrue:	["if beyond lastLine, force search to last character"					characterPoint x: rightMargin]			ifFalse:	[characterPoint y < (aParagraph compositionRectangle) top						ifTrue: ["force search to first line"								characterPoint _								(aParagraph compositionRectangle) topLeft].					characterPoint x > rightMargin						ifTrue:	[characterPoint x: rightMargin]].	destX _ leftMargin _ aParagraph leftMarginForDisplayForLine: lineIndex.	nextLeftMargin_ aParagraph leftMarginForDisplayForLine: lineIndex+1.	lastIndex _ line first.	self setStopConditions.		"also sets font"	runLength _ (text runLengthFor: line first).	characterIndex ~~ nil		ifTrue:	[lineStop _ characterIndex	"scanning for index"]		ifFalse:	[lineStop _ line last].	(runStopIndex _ lastIndex + (runLength - 1)) > lineStop		ifTrue:	[runStopIndex _ lineStop].	lastCharacterExtent _ 0 @ textStyle lineGrid.	spaceCount _ 0. done  _ false.	[done]	whileFalse:	[stopCondition _ 					self scanCharactersFrom: lastIndex						to: runStopIndex						in: text string						rightX: characterPoint x						stopConditions: stopConditions						displaying: false.		"see setStopConditions for stopping conditions for character block 	operations."	lastCharacterExtent x: (font widthOf: (text at: lastIndex)).	(self perform: stopCondition)		ifTrue:	[^CharacterBlock					stringIndex: lastIndex					character: lastCharacter					topLeft: characterPoint					extent: lastCharacterExtent]]! !BitBlt subclass: #CharacterScanner	instanceVariableNames: 'lastIndex xTable stopConditions text textStyle leftMargin rightMargin font line runStopIndex spaceCount spaceWidth outputMedium '	classVariableNames: ''	poolDictionaries: 'TextConstants '	category: 'Graphics-Support'!CharacterScanner comment:'Instances of class CharacterScanner hold the state associated with scanning text.Instance Variables	lastIndex <Integer>  String index of last character scanned.	xTable <Array>  Array left x-coordinates of character glyphs (cached from font).	stopConditions <Array>  Array of selectors to perform when scanning various characters.	text <Text>  The text being scanned.	textStyle <TextStyle>  The style (font set, etc.) being used with this text.	leftMargin, rightMargin <Integers>  Screen coordinates delimiting the text.	font	 <StrikeFont>  The font currently in use.	line	 <TextLineInterval>  Giving the current range in text.	runStopIndex <Integer>  Where the current run ends in text.	spaceCount <Integer>  How many spaces have been scanned in this line.	spaceWidth <Integer>  How wide spaces should be in this line.	outputMedium <Symbol>  Needed by CompositionScanner for determining the nature of the 						font to be used for character widths.  For the DisplayScanner there are 						several places where distinguishing between displaying and printing is required.The first three variables are required (in addition to inherited BitBlt state) by the primitive scanning operation.Pool Dictionary:	TextConstants	<Dictionary>'!!CharacterScanner methodsFor: 'access'!lastIndex	 "Answer the string index of last character scanned."	^lastIndex!stopConditions: anArray	"Store the stop conditions to be the argument anArray."	stopConditions _ anArray!xTable: anArray 	"Store the argument anArray to be the array of left x-coordinates of character glyphs."	xTable _ anArray! !!CharacterScanner methodsFor: 'scanning'!characterNotInFont	"All fonts have an illegal character to be used when a character is  	not within the font's legal range.  When characters out of ranged 	are encountered in scanning text, then this special character 	indicates the appropriate behavior.  The character is usually treated 	as a unary message understood by a subclass of CharacterScanner."	| illegalAsciiString saveIndex stopCondition | 	saveIndex _ lastIndex.	illegalAsciiString _ String with: (font maxAscii + 1) asCharacter.	(self isMemberOf: CompositionScanner) not	ifTrue: [	stopCondition _ self scanCharactersFrom: 1						to: 1						in: illegalAsciiString						rightX: rightMargin						stopConditions: stopConditions						displaying: self doesDisplaying]	ifFalse:	[	stopCondition _ 		self scanCharactersFrom: 1 to: 1			in: illegalAsciiString			rightX: rightMargin stopConditions: stopConditions			displaying: self doesDisplaying].	lastIndex _ saveIndex + 1.	stopCondition ~= (stopConditions at: EndOfRun)		ifTrue:	[^self perform: stopCondition]		ifFalse: [lastIndex > runStopIndex					ifTrue:	[lastIndex _ lastIndex - 1.							^self perform: (stopConditions at: EndOfRun)].				^false]!scanCharactersFrom: startIndex to: stopIndex in: sourceString rightX: rightX stopConditions: stops displaying: display	"This is the inner loop of text display -- but consider 	scanCharactersFrom: to:rightX: which would get the string, 	stopConditions and displaying from the instance. March through 	source String from startIndex to stopIndex. If any character is 	flagged with a non-nil entry in stops, then return the corresponding 	value. Determine width of each character from xTable. If destX 	would exceed rightX, then return stops at: 258. If displaying is true, 	then display the character. Advance destX by the width of the 	character. If stopIndex has been reached, then return stops at: 257. 	Fail under the same conditions that the Smalltalk code below would 	cause an error. Optional. See Object documentation whatIsAPrimitive."	| ascii nextDestX |	<primitive: 103>	lastIndex _ startIndex.	[lastIndex <= stopIndex]		whileTrue: 			[ascii _ (sourceString at: lastIndex) asciiValue.			ascii > 255 ifTrue: [^#characterNotInFont].			(stopConditions at: ascii + 1) ~~ nil ifTrue: [^stops at: ascii + 1].			sourceX _ xTable at: ascii + 1.			nextDestX _ destX + (width _ (xTable at: ascii + 2) - sourceX).			nextDestX > rightX ifTrue: [^stops at: CrossedX].			display ifTrue: [self copyBits].			destX _ nextDestX.			lastIndex _ lastIndex + 1].	lastIndex _ stopIndex.	^stops at: EndOfRun! !!CharacterScanner methodsFor: 'stop conditions'!setStopConditions	"Set default stop conditions for the font."	spaceWidth _ font spaceWidth. 	sourceForm _ font glyphs.	xTable _ font xTable.	height _ font height.	stopConditions _ font stopConditions.	stopConditions at: Space asInteger + 1 put: #space.	stopConditions at: Tab asInteger + 1 put: #tab.	stopConditions at: CR asInteger + 1 put: #cr.	stopConditions at: 10 + 1 put: #cr.	stopConditions at: EndOfRun put: #endOfRun.	stopConditions at: CrossedX put: #crossedX.	stopConditions at: Ctrls asInteger + 1 put: #onePixelSpace.	stopConditions at: CtrlS asInteger + 1 put: #onePixelBackspace.	stopConditions at: Ctrlz asInteger + 1 put: #characterNotInFont.! !!CharacterScanner methodsFor: 'private'!doesDisplaying	^false!initializeFromParagraph: aParagraph clippedBy: clippingRectangle	text _ aParagraph text.	textStyle _ aParagraph textStyle. 	destForm _ aParagraph destinationForm.	outputMedium _ aParagraph outputMedium.	halftoneForm _ aParagraph mask.	self combinationRule: aParagraph rule.	self clipRect: clippingRectangle.	sourceY _ 0.! !Arc subclass: #Circle	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Graphics-Paths'!Circle comment:'A full circle is made from four arcs.  Class Circle modifies the Arc methods for displaying.'!!Circle methodsFor: 'displaying'!displayOn: aDisplayMedium at: aDisplayPoint clippingBox: clipRectangle rule: ruleInteger mask: aForm 	"Display the receiver on the display medium aDisplayMedium positioned 	at aDisplayPoint within the rectangle clipRectangle and with the rule, 	ruleInteger, and mask, aForm. "	1 to: 4 do: 		[:i | 		super quadrant: i.		super			displayOn: aDisplayMedium			at: aDisplayPoint			clippingBox: clipRectangle			rule: ruleInteger			mask: aForm]!displayOn: aDisplayMedium transformation: aTransformation clippingBox: clipRect rule: anInteger mask: aForm 	"Display the receiver, translated and scaled by aTransformation, 	displaying with combination rule ruleInteger, masked by aForm, and 	clipped with the rectangle clipRectangle."	1 to: 4 do: 		[:i | 		super quadrant: i.		super			displayOn: aDisplayMedium			transformation: aTransformation			clippingBox: clipRect			rule: anInteger			mask: aForm]! !!Circle methodsFor: 'display box access'!computeBoundingBox	"Answer the minimum enclosing rectangle around the image."	^center - radius + form offset extent: form extent + (radius * 2) asPoint! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Circle class	instanceVariableNames: ''!!Circle class methodsFor: 'examples'!exampleOne 	"Click any button somewhere on the screen.  The point will be the	center of the circle of radius 150."	"Circle exampleOne."	| aCircle aForm |	aForm _ Form new extent: 1@30.	aForm black.	aCircle _ Circle new.	aCircle form: aForm.	aCircle radius: 150.	aCircle center: Sensor waitButton.	aCircle displayOn: Display!exampleTwo	"Designate a rectangular area that should be used as the brush for displaying the 	circle. Click any button at a point on the screen which will be the center location	for the circle.  The curve will be displayed with a long black form."	 	 "Circle exampleTwo."	| aCircle aForm |	aForm _ Form fromUser.	aCircle _ Circle new.	aCircle form: aForm.	aCircle radius: 150.	aCircle center: Sensor waitButton.	aCircle displayOn: Display at: 0 @ 0 rule: Form reverse! !ClassDescription subclass: #Class	instanceVariableNames: 'name classPool sharedPools '	classVariableNames: ''	poolDictionaries: ''	category: 'Kernel-Classes'!Class comment:'Instances of class Class describe the representation and behavior of objects.  Class adds more comprehensive programming support facilities to the basic attributes of Behavior and the descriptive facilities of ClassDescription.  An example is accessing shared (pool) variables.Instance Variables:		name		<Symbol> name of class for printing and global reference		classPool	<Dictionary> of variables common to all instances		sharedPools	<Array of: Dictionaries> access to other shared variables'!!Class methodsFor: 'initialize-release'!declare: varString 	"Declare class variables common to all instances.  Answer whether	recompilation is advisable."	| newVars conflicts |	newVars _ 		(Scanner new scanFieldNames: varString)			collect: [:x | x asSymbol].	newVars do:		[:var | var first isLowercase			ifTrue: [self error: var, ' class variable name should be capitalized; proceed to include anyway.']].	conflicts _ false.	classPool == nil 		ifFalse: [(classPool keys reject: [:x | newVars includes: x]) do: 					[:var | self removeClassVarName: var]].	(newVars reject: [:var | self classPool includesKey: var])		do: [:var | "adding"			"check if new vars defined elsewhere"			(self scopeHas: var ifTrue: [:ignored])				ifTrue: 					[self error: var , ' is defined elsewhere'.					conflicts _ true]].	newVars size > 0		ifTrue: 			[classPool _ self classPool.			"in case it was nil"			newVars do: [:var | classPool declare: var from: Undeclared]].	^conflicts!localObsolete	"Change the receiver to an obsolete class by changing its name to have the prefix -AnObsolete-, and nilling the fields of any instances."	self isPointers ifTrue:		[self allInstancesDo: [:instance | instance nilFields]]. 	"nil fields of instances"	('AnObsolete*' match: name) ifFalse:		[name _ 'AnObsolete' , name].	classPool _ Dictionary new.	super localObsolete!obsolete	"Change the receiver to an obsolete class by changing its name to have the prefix -AnObsolete-, and nilling the fields of any instances."	self class obsolete.	super obsolete!removeFromSystem	"Forget the receiver, and all of its subclasses, from the Smalltalk 	global dictionary. Any existing instances will refer to an obsolete 	version of the receiver."	Smalltalk removeClassNamed: self name	"remove from system dictionary"!sharing: poolString 	"Set up sharedPools.  Answer whether recompilation is advisable."	| oldPools |	oldPools _ self sharedPools.	sharedPools _ Set new.	(Scanner new scanFieldNames: poolString) do: 		[:poolName | 		sharedPools add: (Smalltalk at: poolName asSymbol)].	sharedPools isEmpty ifTrue: [sharedPools _ nil].	oldPools 		detect: [:pool | (self sharedPools includes: pool) not]		ifNone: [^false].	^true	"A pool got deleted - who knows if there are still references?"! !!Class methodsFor: 'accessing'!classPool	"Answer the dictionary of class variables."	classPool == nil		ifTrue: [^Dictionary new]		ifFalse: [^classPool]!name	"Answer the name of the receiver."	name == nil		ifTrue: [^'a Class']		ifFalse: [^name]!setName: aSymbol	"Set the name of the receiver to be aSymbol."	name _ aSymbol! !!Class methodsFor: 'accessing class hierarchy'!isObsolete	"Answer whether the receiver is an obsolete class."	^self class isObsolete 		"ask the metaclass"! !!Class methodsFor: 'testing method dictionary'!hasMethods	"Answer a Boolean as to whether any methods are defined for the receiver	(includes whether there are methods defined in the receiver's metaclass)."	^super hasMethods or: [self class hasMethods]! !!Class methodsFor: 'class name'!rename: aString 	"The new name of the receiver is the argument, aString."	| newName |	newName _ aString asSymbol.	(Smalltalk includesKey: newName)		ifTrue: [^self error: newName , ' already exists'].	Smalltalk renameClass: self as: newName.	name _ newName.	self comment: self comment.	self class comment: self class comment!renameAndFixSourceTo: newName 	"The new name of the receiver is the argument, aString.	Rename the receiver, and then change all references in	the system from the old name to the new name."	| oldName |	oldName  _ self name.	self rename: newName.	self renameReferencesFrom: oldName!renameReferencesFrom: oldNameString	"The old name of the receiver is the argument, oldNameString.	Change all references in the system from the old name	to the new (current) one."	| oldName ref meths s cat pos |	oldName _ oldNameString asSymbol.	ref _ Smalltalk associationAt: oldName ifAbsent: [^self].	Smalltalk allBehaviorsDo:		[:b |		meths _ b whichSelectorsReferTo: ref.		meths size > 0			ifTrue: [meths do:						[:sel | 						sel == #DoIt							ifFalse: [s _  b sourceCodeAt: sel.									cat _ b whichCategoryIncludesSelector: sel.									Transcript cr; show: b name , ' (' , cat , ') ' , '>> ' , sel.									pos _ Scanner new										scanPositionsFor: oldName										inString: s.									pos reverseDo:										[:p |										s _ s copyReplaceFrom: p											to: p + oldName size - 1											with: name].									b compile: s classified: cat]]]].!renameToReplace: aClass	"Obsolete aClass, and then rename the receiver to	have the name that aClass currently has."	| oldName newName |	oldName _ self name.	newName _ aClass name.	aClass obsolete.	SystemOrganization removeElement: oldName.	Smalltalk changes renameClass: self as: newName.	Smalltalk at: newName put: self.	name _ newName.	Smalltalk flushClassNameCache.	self renameReferencesFrom: oldName.	Smalltalk removeKey: oldName! !!Class methodsFor: 'instance variables'!addInstVarName: aString	"Add the argument, aString, as one of the receiver's instance variables."	self classBuilder		currentClass: self;		superclass: superclass;		environment: self environment;		instanceVariables: (self instVarNames copyWith: aString);		format: self format;		reviseSystem!removeInstVarName: aString 	"Remove the argument, aString, as one of the receiver's instance variables."	(self instVarNames includes: aString)		ifFalse: [self error: aString , ' is not one of my instance variables'].	self classBuilder		currentClass: self;		superclass: superclass;		environment: self environment;		instanceVariables: (self instVarNames copyWithout: aString);		format: self format;		reviseSystem! !!Class methodsFor: 'class variables'!addClassVarName: aString 	"Add the argument, aString, as a class variable of the receiver."	aString first isLowercase		ifTrue: [self error: aString, ' class variable name should be capitalized; proceed to include anyway.'].	self withAllSubclasses do: 		[:subclass | 		subclass 			poolHas: aString asSymbol 			ifTrue:				[:ignored |				^self error: aString , ' is already used as a variable name in ' , subclass name]].	classPool _ self classPool.  "might be nil"	classPool add: (Association key: aString asSymbol value: nil)!allClassVarNames	"Answer a Set of the names of the receiver's class variables, including those	defined in the superclasses of the receiver."	| aSet |	superclass == nil		ifTrue: 			[^self classVarNames]  "This is the keys so it is a new Set."		ifFalse: 			[aSet _ superclass allClassVarNames.			aSet addAll: self classVarNames.			^aSet]!classVarNames	"Answer a Set of the names of the class variables defined in the receiver."	^self classPool keys!initialize	"Typically used for the initialization of class variables and metaclass instance	variables.  Does nothing, but may be overridden in Metaclasses."	^self!removeClassVarName: aString 	"Remove the class variable whose name is the argument, aString, from the names	defined in the receiver, a class."	| aSymbol |	aSymbol _ aString asSymbol.	(classPool includesKey: aSymbol)		ifFalse: [^self error: aString, ' is not a class variable'].	(self superclass allClassVarNames includes: aSymbol)		ifFalse: [self withAllSubclasses do: [:subclass |			(Array with: subclass with: subclass class) do:				[:classOrMeta |				(classOrMeta whichSelectorsReferTo: (classPool associationAt: aSymbol))					isEmpty						ifFalse: [^self error: aString									, ' is still used in code of class '									, classOrMeta name]]]].	classPool removeKey: aSymbol! !!Class methodsFor: 'pool variables'!addSharedPool: aDictionary 	"Add the argument, aDictionary, as one of the receiver's pool dictionaries.  Create	an error if the dictionary is already one of the pools."	(self sharedPools includes: aDictionary)		ifTrue: [^self error: 'The dictionary is already in my pool'].	sharedPools == nil		ifTrue: [sharedPools _ Set with: aDictionary]		ifFalse: [sharedPools add: aDictionary]!allSharedPools	"Answer a Set of the pools the receiver shares, including those defined 	in the superclasses of the receiver."	| aSet |	superclass == nil		ifTrue:			[^self sharedPools copy]		ifFalse: 			[aSet _ superclass allSharedPools.			aSet addAll: self sharedPools.			^aSet]!removeSharedPool: aDictionary 	"Remove the pool dictionary, aDictionary, as one of the receiver's pool dictionaries.	Create an error if the dictionary is not one of the pools."	| satisfiedSet workingSet aSubclass |	(self sharedPools includes: aDictionary)		ifFalse: [^self error: 'the dictionary is not in my pool'].	"first see if it is declared in a superclass in which case we can remove it."	(self allSuperclasses select: [:class | class sharedPools includes: aDictionary]) isEmpty		ifFalse: [sharedPools remove: aDictionary.				sharedPools isEmpty ifTrue: [sharedPools _ nil].				^self]. 	"second get all the subclasses that reference aDictionary through me rather than a 	superclass that is one of my subclasses."	workingSet _ self subclasses asOrderedCollection.	satisfiedSet _ Set new.	[workingSet isEmpty] whileFalse:		[aSubclass _ workingSet removeFirst.		(aSubclass sharedPools includes: aDictionary)			ifFalse: 				[satisfiedSet add: aSubclass.				workingSet addAll: aSubclass subclasses]].	"for each of these, see if they refer to any of the variables in aDictionary because 	if they do, we can not remove the dictionary."	satisfiedSet add: self.	satisfiedSet do: 		[:sub | 		aDictionary associationsDo: 			[:aGlobal | 			(sub whichSelectorsReferTo: aGlobal) isEmpty 				ifFalse: [^self error: aGlobal key 								, ' is still used in code of class '								, sub name]]].	sharedPools remove: aDictionary.	sharedPools isEmpty ifTrue: [sharedPools _ nil]!sharedPools	"Answer a Set of the pool dictionaries declared in the receiver."	sharedPools == nil		ifTrue: [^Set new]		ifFalse: [^sharedPools]! !!Class methodsFor: 'compiling'!compileAllFrom: otherClass	super compileAllFrom: otherClass.	self class compileAllFrom: otherClass class!poolHas: varName ifTrue: assocBlock 	"Look up the first argument in the context of the receiver.  If it is there,	pass the association to assocBlock, and answer true, else answer false."	| assoc |	assoc _ self classPool associationAt: varName ifAbsent: [].	assoc == nil		ifFalse: 			[assocBlock value: assoc.			^true].	self sharedPools do: 		[:pool | 		assoc _ pool associationAt: varName ifAbsent: [].		assoc == nil			ifFalse: 				[assocBlock value: assoc.				^true]].	^ false! !!Class methodsFor: 'subclass creation'!subclass: t instanceVariableNames: f classVariableNames: d poolDictionaries: s category: cat 	"This is the standard initialization message for creating a new class as a subclass	of an existing class (the receiver)."	^self classBuilder		superclass: self;		environment: self environment;		className: t;		instVarString: f;		classVarString: d;		poolString: s;		category: cat;		beFixed;		reviseSystem!variableByteSubclass: t instanceVariableNames: f classVariableNames: d poolDictionaries: s category: cat 	"This is the standard initialization message for creating a new class 	as a subclass of an existing class (the receiver) in which the 	subclass is to have indexable byte-sized nonpointer variables."	^(self classBuilder) 		superclass: self; 		environment: self environment; 		className: t; 		instVarString: f; 		classVarString: d; 		poolString: s; 		category: cat; 		beBytes; 		reviseSystem!variableSubclass: t instanceVariableNames: f 	classVariableNames: d poolDictionaries: s category: cat	"This is the standard initialization message for creating a new class as a subclass	of an existing class (the receiver) in which the subclass is to have indexable	pointer variables."	^self classBuilder		superclass: self;		environment: self environment;		className: t;		instVarString: f;		classVarString: d;		poolString: s;		category: cat;		beVariable;		reviseSystem! !!Class methodsFor: 'fileIn/Out'!fileOut	"Create a file whose name is the name of the receiver with -.st- as the	extension, and file a description of the receiver onto it"	| fileStream |	Transcript refresh; cr; cr; show: 'Filing out class:'.	fileStream _ (Filename named: self name , '.st') writeStream.	[fileStream timeStamp.	self fileOutOn: fileStream		moveSource: false		toFile: 0]		valueNowOrOnUnwindDo: [fileStream close].	self removeFromChanges.!fileOutOn: aFileStream moveSource: moveSource toFile: fileIndex 	"File a description of the receiver on aFileStream.  If the boolean argument,	moveSource, is true, then set the trailing bytes to the position of aFileStream and	to fileIndex in order to indicate where to find the source code."	Transcript cr; show: name.	super		fileOutOn: aFileStream		moveSource: moveSource		toFile: fileIndex.	self class nonTrivial		ifTrue:			[aFileStream cr; nextPutAll: '"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!!'; cr; cr.			self class				fileOutOn: aFileStream				moveSource: moveSource				toFile: fileIndex].!printOut	"Create a readable version of my definition, and send to a printer.	Defaults to fileOut."	self fileOut!readBinaryContentsFrom: stream	"Read instance from stream."	methodDict _ stream inClass: self do: [stream next].	organization _ stream next!removeFromChanges	"References to the receiver, a class, and its metaclass should no longer be included	in the system ChangeSet."	Smalltalk changes removeClassChanges: self!storeBinaryContentsOn: aStream	"Store binary representation of the contents of the receiver onto aStream."	aStream inClass: self do: [aStream nextPut: methodDict].	aStream nextPut: organization! !!Class methodsFor: 'testing'!shouldBeRegistered	"Answer whether the receiver is named and should be 'stored' in its environment"	^name ~~ nil! !!Class methodsFor: 'creating class hierarchy'!addToSuper	"Add the receiver to the superclass's subclass list"	super addToSuper.	self class addToSuper!removeFromSuper	"Remove the receiver from the superclass's subclass list"	super removeFromSuper.	self class removeFromSuper! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Class class	instanceVariableNames: ''!!Class class methodsFor: 'instance creation'!template: category 	"Answer an expression that can be edited and evaluated in order to define	 a new class."	^'NameOfSuperclass subclass: #NameOfClass	instanceVariableNames: ''instVarName1 instVarName2''	classVariableNames: ''ClassVarName1 ClassVarName2''	poolDictionaries: ''''	category: ''' , category , ''''! !Object subclass: #ClassBuilder	instanceVariableNames: 'class className superclass instanceVariables format classVariables pools category environment organizer recompile '	classVariableNames: 'BuildErrorSignal BuildFailureSignal NilSuperclassSignal '	poolDictionaries: ''	category: 'Kernel-Classes'!ClassBuilder comment:'ClassBuilders are initialized with a set of changes to be made to a particular class, such as changing the superclass, or the number of instance variables, then released to make the change in as nearly atomic a fashion as possible.  Initialization code makes no changes to the system, only to the state of the ClassBuilder.Instance Variables:	class				<Behavior> the class to be modified	className			<Symbol> the name of the class, if modifications are done by name, when defining a new class	superclass			<Behavior or nil> the new superclass	instanceVariables	<Array or nil> the new instance variable names	format				<SmallInteger> bit representation of the class instSize/type	classVariables		<Set> class variable names	pools				<Set> names of shared environments	category			<String> class''s category name	environment		<Environment/SystemDictionary> class''s name space	organizer			<SystemOrganizer> object which maps classes to categories	recompile			<Boolean> whether a change may have occurred that would cause the class to be recompiledClass Variables:	BuildErrorSignal		<Signal> Class definition error	BuildFailureSignal	<Signal> Invalid class definition	NilSuperclassSignal	<Signal> Warning -- class being defined with nil superclass'!!ClassBuilder methodsFor: 'initialize-release'!initialize	"Set the default parameters.	We know nothing yet about what format might be	reasonable--assume fixed"	environment _ Smalltalk.	organizer _ SystemOrganization.	format _ 0.	self beFixed.	recompile _ false! !!ClassBuilder methodsFor: 'accessing'!category	"Answer the category."	^category!category: aCategory	"Record the category."	category _ aCategory!className	"Answer the current class name.  This may be nil if the class was	specified explicitly via #currentClass:."	^className!className: aName 	"Record the name of the class--this will be resolved into a class later.	No restriction is currently placed on what a name is."	(aName isString and: [aName first isUppercase not])		ifTrue:	[self notify: 'Classes should be capitalized'].	className _ aName!classVariables	"Answer the names of class variables for the class."	classVariables == nil		ifTrue:	[^Set new]		ifFalse:	[^classVariables]!classVariables: aVariableList 	"Specify the names of class variables. This should be a set of Symbols."	classVariables _ aVariableList asSet collect: [:i | i asSymbol]!classVarString: aVariableList 	"Specify the names of class variables. This should be a set of Symbols."	self classVariables: (self scan: aVariableList)!currentClass	"Answer the class being changed."	^class!currentClass: aClass 	"Record the class to be modified."	aClass isBehavior		ifFalse:	[^self failureSignal raiseErrorString: 'Invalid class'].	class _ aClass!environment	"Answer the name space that will contain the class.	This is generally Smalltalk in the generic image."	^environment!environment: aDictionary	"Specify the name space that will contain the class.	This is generally Smalltalk in the generic image--it may	be set to nil if the class is supposed to be anonymous."	environment _ aDictionary!instanceVariables	"Answer the collection of instance variable names."	instanceVariables == nil		ifTrue:	[^#()]		ifFalse:	[^instanceVariables]!instanceVariables: aNameList 	"Specify the names of instance variables.  This should be an array of strings."	instanceVariables _ aNameList asArray collect: [:i | i asString].!instVarString: anInstVarString	"Specify the names of instance variables."	self instanceVariables: (self scan: anInstVarString)!organization	"Answer the organizer which records the class's category,	such as SystemOrganization."	^organizer!organization: anOrganizer	"Specify the organizer which records the class's category,	such as SystemOrganization."	organizer _ anOrganizer!pools	"Specify which pools are to be used. This should be a set of Symbols."	pools == nil		ifTrue:	[^Set new]		ifFalse:	[^pools]!pools: aNameList 	"Specify which pools are to be used. This should be a set of Symbols."	pools _ aNameList asSet collect: [:i | i asSymbol]!poolString: aNameList 	"Specify which pools are to be used. This should be a set of Symbols."	self pools: (Scanner new scanFieldNames: aNameList)!superclass	"Answer under which superclass the class will be created/moved."	^superclass!superclass: aClass 	"Specify under which superclass the class will be created/moved."	superclass _ aClass! !!ClassBuilder methodsFor: 'class type'!beBytes	"State that the class will have variable-length byte instances."	format _ self formatWithBytesSet: format!beFixed	"State that the class will have pointer instances with only named	instance variables."	format _ self formatWithFixedSet: format!beImmediate	"State that the class will have instances that have no instance	variables, and are stored efficiently by the Smalltalk-80	implementations.  An example of this is SmallIntegers."	format _ self formatWithImmediateSet: format!beVariable	"State that the class will have pointer instances with named	and/or indexed instance variables."	format _ self formatWithVariableSet: format!format: fmt	"Specify that the class's new format should be fmt, subject to	consistency checks against other information supplied."	format _ fmt! !!ClassBuilder methodsFor: 'evaluate'!createNewSubclass	"The class does not exist--create a new class-metaclass pair"	| newMeta |	self runValidationChecksForNewClass.	newMeta _ self metaclassClass new.	newMeta assignSuperclass: (self classOf: superclass).	newMeta methodDictionary: MethodDictionary new.	newMeta setInstanceFormat: (self classOf: superclass) format.	class _ newMeta new.	class assignSuperclass: superclass.	class methodDictionary: MethodDictionary new.	class setInstanceFormat: self computeFormat.	self setStructureOf: class.	class setName: className.	self register: class inPlaceOf: nil.	self changeMicroState.	^self logNew: class!modifyExistingClass	"Enumerate the legal types of changes and perform them.  If a new	class was created, the final check for which kind of mutation is	skipped, since a new class needs no mutation"	self runValidationChecks.	self needsMutation		ifTrue:	[self doMutationInPlace			ifTrue:	[self mutateCurrentClass]			ifFalse:	[self mutateToNewClass]].	self changeMicroState.	^self logChanged: self currentClass!mutateCurrentClass	"The only thing that needs to be done (if the superclass and	instanceVariables haven't changed) is to recompile code if the	name scope has changed"	self setStructureOf: class.	superclass == class superclass		ifFalse:			[class class				assignSuperclass: (self classOf: superclass);				flushVMmethodCache.			class				assignSuperclass: superclass;				flushVMmethodCache.			"How can we tell whether recompilation is needed?"			recompile _ true]!reviseSystem 	"Mutate the system, differently based on whether the class already exists or not"	^self needsNewClass		ifTrue:	[self createNewSubclass]		ifFalse:	[self modifyExistingClass]! !!ClassBuilder methodsFor: 'evaluate-testing'!doMutationInPlace	"Answer whether it is safe to modify the class in place. This can 	be done if the number and order of instance variables has not 	changed, and the kind of object has not changed"	self computeFormat = class format		ifFalse: [^false].	superclass == class superclass		ifTrue: [^instanceVariables == nil or: [instanceVariables = class instVarNames]].	((self allSortedInstVarNames: superclass), instanceVariables) = class allInstVarNames		ifFalse: [^false].	(class isMeta not and: [(self classOf: superclass) allInstVarNames = class class superclass allInstVarNames])		ifFalse: [^false].	^true!needsMutation	"Answer whether the class requires reconstruction"	^superclass ~~ class superclass		or: [self computeFormat ~= class format		or: [instanceVariables ~~ nil		and: [instanceVariables ~= class instVarNames]]]!needsNewClass	"If the class was specified by name, look it up. If it doesn't exist, 	return true, else return false"	class == nil		ifTrue: [(className ~~ nil and:					[environment ~~ nil and:					[environment includesKey: className]])				ifTrue: 					[class _ environment at: className.					[class isBehavior] whileFalse:						[class _ self failureSignal raiseRequestErrorString: 'Class must be a Behavior']]				ifFalse: [^true]].	^false! !!ClassBuilder methodsFor: 'evaluate-mutate instances'!createCopy: inst under: new using: newIV 	"Create an instance of 'new' that is like 'inst', using 'newIV'	to specify how named instance variables should be mapped.	If 'newIV' has zero at index 'i', the new instance will have nil	in the named instance variable 'i'.  Otherwise, the value will	specify which instance variable of 'inst' should be stored into	the new instance"	| newInst |	new isVariable		ifTrue: 			[newInst _ new basicNew: inst basicSize.			1 to: inst basicSize do: [:i | newInst basicAt: i put: (inst basicAt: i)]]		ifFalse: [newInst _ new basicNew].	1 to: new instSize do: 		[:i | 		| j |		j _ newIV at: i.		j = 0 ifFalse: [newInst instVarAt: i put: (inst instVarAt: j)]].	^newInst!genNewClass: aClass under: newSuper 	"Generate a subclass of newSuper that is 'like' aClass.  This also	creates a new metaclass for the new class"	| f new newMeta |	f _ aClass == class		ifTrue:	[self genFormat: (instanceVariables ~~ nil								ifTrue: [instanceVariables]								ifFalse: [aClass instVarNames]) size					under: newSuper					format: format]		ifFalse:	[self genFormat: aClass instVarNames size					under: newSuper					format: aClass format].	newMeta _ self genNewMetaclass: aClass class under: (self classOf: newSuper).	new _ self createCopy: aClass				under: newMeta				using: (self map: newMeta from: aClass class).	new clearInstanceVariables.	newMeta adopt: new.	new superclass: newSuper.	new setInstanceFormat: f.	aClass == class		ifTrue: [self setStructureOf: new].	^new!genNewMetaclass: aMetaclass under: newMetaSuperclass 	"Generate a subclass of newMetaSuperclass that is 'like' aMetaclass"	| f new |	f _ aMetaclass == class		ifTrue:	[self genFormat: (instanceVariables ~~ nil								ifTrue: [instanceVariables]								ifFalse: [aMetaclass instVarNames]) size					under: newMetaSuperclass					format: format]		ifFalse:	[self genFormat: aMetaclass instVarNames size					under: newMetaSuperclass					format: aMetaclass format].	new _ aMetaclass shallowCopy clearInstanceVariables.	new superclass: newMetaSuperclass.	new setInstanceFormat: f.	aMetaclass == class		ifTrue: [self setStructureOf: new].	^new!give: new identityOf: aClass 	"Having changed the structure of a class, we now want to force 	that class to be essentially the identical object it was before any 	changes took place"	| proto cl |	cl _ new shallowCopy.	cl copyMethodDictionary.	cl isMeta		ifFalse:	[cl class adopt: cl].	cl compileAllFrom: new into: aClass.	aClass removeFromSuper.	aClass flushVMmethodCache.	aClass become: cl.	aClass flushVMmethodCache.	aClass isMeta		ifFalse:	[aClass class adopt: aClass].	proto _ aClass basicNew.	new allInstances do: [:inst | inst changeClassToThatOf: proto].	new subclasses do:		[:sub |		sub superclass == new			ifTrue:	[sub assignSuperclass: aClass; flushVMmethodCache]].	self register: aClass inPlaceOf: new.	new localObsolete.	^aClass!map: newClass from: aClass	"Determine how instance variables are to be mapped between	the two classes.  This is based purely on the two instance variable	names being the same"	| newIV oldIV |	newIV _ newClass allInstVarNames.	oldIV _ aClass allInstVarNames.	^newIV collect: [ :i | oldIV indexOf: i].!mutateClass: aClass toSuper: newSuper	"Change the class's superclass to be newSuper.  This involves making	a new class, installing it in the environment, mutating all instances to	the new class, and modifying the old class's subclasses to be subclasses	of the new one"	| new |	new _ aClass isMeta				ifTrue:	[self genNewMetaclass: aClass under: newSuper]				ifFalse:	[self genNewClass: aClass under: newSuper].	aClass hasMethods		ifTrue:	[Transcript show: new name,' recompiling... '.				new compileAllFrom: aClass.				Transcript show: 'done'; cr].	self register: new inPlaceOf: aClass.	self mutateInstances: new from: aClass.	aClass subclasses do:		[ :cls |		cls superclass == aClass			ifTrue:	[self mutateClass: cls toSuper: new]].	self give: new identityOf: aClass.	^aClass!mutateInstances: newClass from: aClass	"Take all instances of aClass and make them instances of newClass"	| newIV |	newIV _ self map: newClass from: aClass.	aClass allInstancesDo:		[ :inst |		inst become: (self createCopy: inst under: newClass using: newIV)]!mutateToNewClass	"Modify class to be a subclass of superclass"	^self mutateClass: class toSuper: superclass!register: new inPlaceOf: aClass	"Do whatever is necessary to cause instance creation to use the new	version of the class"	new addToSuper.	environment == nil		ifTrue:	[^self].	new shouldBeRegistered		ifFalse:	[^self].	environment at: new name put: new.!setStructureOf: aClass	"Set aClass's instance structure."	instanceVariables == nil 		ifFalse:	[aClass instanceVariables: instanceVariables]! !!ClassBuilder methodsFor: 'evaluate-micro state'!changeCategory	"During the update phase, change the class's category"	(category == nil or: [organizer == nil])		ifFalse:	[organizer classify: class name under: category]!changeClassVariables 	"If class variable names have been specified, modify the class's classPool"	| oldClassVars removed added |	classVariables == nil		ifTrue:	[^self].	classVariables _ classVariables asOrderedCollection asArray.	recompile _ recompile | (class declare: classVariables)!changeMicroState	"Change those aspects of the class that are relatively independent 	of any other changes to the class"	self changeCategory.	self changeClassVariables.	self changePools.	self sanityCheck: class.	recompile ifTrue: [class withAllSubclasses do: [:cls | cls compileAll]]!changePools	"Revise the sharedPools of the class. The names of the pools are 	translated now rather than earlier because the environment may 	have been reset"	| oldPools removed added failString |	failString _ 'Can''t find the pool dictionary'.	pools == nil ifTrue: [^self].	pools _ pools collect:		[:i | i isString				ifTrue: [environment == nil						ifTrue: [self failureSignal raiseRequestErrorString: failString]						ifFalse: [environment at: i									ifAbsent: [self failureSignal raiseRequestErrorString: failString]]]				ifFalse: [i]].	oldPools _ class sharedPools.	removed _ oldPools - pools.	added _ pools - oldPools.	removed do: 		[:pool | 		class removeSharedPool: pool.		recompile _ true].	added do: 		[:pool | 		class addSharedPool: pool]! !!ClassBuilder methodsFor: 'validation'!runValidationChecks	"Make an effort not to start operations if they have to be abandoned later"	self computeFormat.	self validateInstanceVariables.	self validateSuperclassAssignment.	self validateSubclassFormats.	class isMeta		ifFalse:	[self validateClassInstanceVariables].!runValidationChecksForNewClass	"'Prove' that		1) the superclass is not a metaclass or other bogus object		2) the class will not have a reserved word as an instance			variable name		3) the class will not have an instance variable name in common			with one of its superclasses"	self computeFormat.	(superclass == nil or: [superclass isBehavior and: [superclass isMeta not]])		ifFalse:	[self failureSignal raiseErrorString: 'Cannot create a subclass of this object'].	self validateInstanceVariablesForNewClass!validateClassInstanceVariables	"'Prove' that		2) the class's class will not have an instance variable name in common			with one of its super-metaclasses		3) the class's sub-metaclasses have no instance variable names			in common with the new super-metaclasses"	| all vars |	all _ self allInstVarNames: (self classOf: superclass).	vars _ class class instVarNames.	1 to: vars size do: 		[:i | | n |		n _ vars at: i.		(all includes: n)			ifTrue: [self failureSignal raiseErrorString: 'Variable naming conflict in meta-hierarchy change']			ifFalse: [all add: n]].	class class allSubclassesDo: 		[:cls | | v |		v _ cls instVarNames.		1 to: v size do: 			[:i | | n |			n _ v at: i.			(all includes: n)				ifTrue: [self failureSignal raiseErrorString: 'Variable naming conflict in meta-hierarchy change']]]!validateInstanceVariables	"'Prove' that		1) the class will not have a reserved word as an instance			variable name		2) the class will not have an instance variable name in common			with one of its superclasses		3) the subclasses have no instance variable names in common			with the new instance variable names of the class, or with			the new superclasses"	| all vars |	all _ self allInstVarNames: superclass.	all addAll: #('self' 'true' 'false' 'nil' 'thisContext' 'super' ).	vars _ instanceVariables == nil				ifTrue: [class instVarNames]				ifFalse: [instanceVariables].	1 to: vars size do: 		[:i | | n |		n _ vars at: i.		(all includes: n)			ifTrue: [self failureSignal raiseErrorString: 'Variable naming conflict in hierarchy change']			ifFalse: [all add: n]].	class allSubclassesDo: 		[:cls | | v |		v _ cls instVarNames.		1 to: v size do: 			[:i | | n |			n _ v at: i.			(all includes: n)				ifTrue: [self failureSignal raiseErrorString: 'Variable naming conflict in hierarchy change']]]!validateInstanceVariablesForNewClass	"'Prove' that		1) the class will not have a reserved word as an instance			variable name		2) the class will not have an instance variable name in common			with one of its superclasses"	| all |	all _ self allInstVarNames: superclass.	all addAll: #('self' 'true' 'false' 'nil' 'thisContext' 'super' ).	1 to: instanceVariables size do: 		[:i | | n |		n _ instanceVariables at: i.		(all includes: n)			ifTrue: [self failureSignal raiseErrorString: 'Variable naming conflict in hierarchy change']			ifFalse: [all add: n]]!validateSubclassFormats	"Determine whether any changes to the class will cause subclasses to have really	bogus formats--such as an object with named instance variables that has a byte	oriented superclass"	self validateSubclassFormats: class format: format.!validateSubclassFormats: aClass format: fmt	"Determine whether any changes to the class will cause subclasses to have really	bogus formats--such as an object with named instance variables that has a byte	oriented superclass"	| list mock |	list _ aClass subclasses.	list isEmpty		ifTrue:	[^self].	"We can use a mocked class as long as the format generator only asks questions that	are confined to the format of the 'superclass'"	mock _ Behavior new.	mock setInstanceFormat: fmt.	list do:		[ :aSubclass |		| f |		f _ self genFormat: aSubclass instVarNames size under: mock format: aSubclass format.		"If the format of the subclass would change, validate subclasses of the subclass"		(self typeOf: f) = (self typeOf: aSubclass format)			ifFalse:	[self validateSubclassFormats: aSubclass format: f]].!validateSuperclassAssignment	"Do checking against legal reassignment of the superclass.  Specifically,	the redefinition of superclass-ness can not be done on a metaclass	and the new superclass cannot inherit from the new subclass."	(superclass ~~ nil and: [superclass == class or: [superclass inheritsFrom: class]])		ifTrue: [self failureSignal raiseErrorString: 'Invalid superclass--superclass inherits from class'].	(superclass == class superclass or: [class isMeta not])		ifFalse:	[self failureSignal raiseErrorString: 'Invalid superclass--redefinition of a metaclass''s superclass']! !!ClassBuilder methodsFor: 'format validation'!computeFormat	"Make sure the format value is correct"	| list |	(class ~~ nil and:			[class format ~~ nil and:			[class isBits and:			[class isFixed]]])		ifTrue:	[self beImmediate].	list _ instanceVariables == nil		ifTrue:	[class instVarNames]		ifFalse:	[instanceVariables].	format _ self genFormat: list size under: superclass format: format.	^format!genFormat: listSize under: newSuper format: aFormat	"Make sure the format value is correct"	| f size fmt |	fmt _ aFormat.	f _ fmt bitAnd: -4096.	f = 0		ifTrue:	[fmt _ self validateFormatImmediate: newSuper format: fmt size: listSize].	f = 4096		ifTrue:	[fmt _ self validateFormatBytes: newSuper format: fmt size: listSize].	f = -8192		ifTrue:	[fmt _ self validateFormatFixed: newSuper format: fmt size: listSize].	f = -4096		ifTrue:	[fmt _ self validateFormatVariable: newSuper format: fmt size: listSize].	size _ listSize + (self instSize: newSuper).	size > 255		ifTrue:	[^self failureSignal raiseErrorString: 'Object too large'].	^size bitOr: (fmt bitAnd: -256)!validateFormatBytes: newSuper format: f size: size	"Do validations based on the assumption that the subclass will be 	variable bytes"	(newSuper ~~ nil and: [newSuper instSize > 0])		ifTrue: [^self failureSignal raiseErrorString: 'cannot make a byte subclass of a class with named fields'].	(newSuper ~~ nil and: [newSuper isVariable and: [newSuper isPointers]])		ifTrue: [^self failureSignal raiseErrorString: 'cannot make a byte subclass of a class with pointer fields'].	size > 0		ifTrue: [^self failureSignal raiseErrorString: 'cannot make a byte subclass with pointer fields'].	^f!validateFormatFixed: newSuper format: f size: size	"Do validations based on the assumption that the subclass will be 	fixed-size pointers"	(newSuper ~~ nil and: [newSuper isBits])		ifTrue: [^self validateFormatBytes: newSuper format: (self formatWithBytesSet: f) size: size].	(newSuper ~~ nil and: [newSuper isVariable])		ifTrue: [^self validateFormatVariable: newSuper format: (self formatWithVariableSet: f) size: size].	^f!validateFormatImmediate: newSuper format: f size: size	"Do validations based on the assumption that the subclass will be 	an immediate class, similar to SmallInteger"	(newSuper ~~ nil and: [newSuper isVariable])		ifTrue: [^self failureSignal raiseErrorString: 'cannot make an immediate subclass of a variable class'].	(newSuper ~~ nil and: [newSuper instSize > 0])		ifTrue: [^self failureSignal raiseErrorString: 'cannot make an immediate subclass of a class with pointer fields'].	size > 0		ifTrue: [^self failureSignal raiseErrorString: 'cannot make an immediate subclass with pointer fields'].	^f!validateFormatVariable: newSuper format: f size: size	"Do validations based on the assumption that the subclass will be 	variable pointers"	(newSuper ~~ nil and: [newSuper isBits])		ifTrue: [^self failureSignal raiseErrorString: 'cannot make a pointer subclass of a class with non-pointer fields'].	^f! !!ClassBuilder methodsFor: 'defaults'!metaclassClass	"The class used to create new metaclasses when they are needed"	^Metaclass! !!ClassBuilder methodsFor: 'logging'!logChanged: aClass	"Record that a class has been modified"	environment == nil		ifFalse:	[environment changes changeClass: aClass].	^aClass!logNew: aClass	"Record that a class has been created"	environment == nil		ifFalse:	[environment changes addClass: aClass].	^aClass! !!ClassBuilder methodsFor: 'prototypes'!class	"Answer the object which is the receiver's class. Essential.  See 	documentation in Object metaclass."	<primitive: 111>	self primitiveFailed!doesNotUnderstand: aMessage 	"The default behavior is to create a Notifier containing the 	appropriate message and to allow the user to open a Debugger. 	Subclasses can override this message in order to modify this behavior."	(Object canUnderstand: aMessage selector)		ifTrue:	[self class copy: aMessage selector from: Object.				^self perform: aMessage selector withArguments: aMessage arguments].	^Object messageNotUnderstoodSignal		raiseRequestWith: aMessage		errorString: 'Message not understood: ' , aMessage selector! !!ClassBuilder methodsFor: 'private'!allInstVarNames: aClass	| cls names |	cls _ aClass.	names _ Set new.	[cls == nil]		whileFalse:			[names addAll: cls instVarNames.			cls _ cls superclass].	^names!allSortedInstVarNames: aClass	| cls names |	cls _ aClass.	names _ OrderedCollection new.	[cls == nil]		whileFalse:			[names addAllFirst: cls instVarNames.			cls _ cls superclass].	^names!classOf: aClass	^aClass == nil		ifTrue:	[Class]		ifFalse:	[aClass class]!failureSignal	^self class buildFailureSignal!formatWithBytesSet: fmt	"Answer a format similar to the one specified, but which represents	variable-length byte instances--these can have no named instance	variables"	^4096!formatWithFixedSet: fmt	"Answer a format similar to the one specified, but which represents	pointer instances with only named instance variables"	^(fmt bitAnd: 255) bitOr: -8192!formatWithImmediateSet: fmt	"Answer a format similar to the one specified, but which represents	instances that have no instance variables, and are stored efficiently	by the Smalltalk-80 implementations.  An example of this is SmallIntegers"	^0!formatWithVariableSet: fmt	"Answer a format similar to the one specified, but which represents	pointer instances with named and/or indexed instance variables"	^(fmt bitAnd: 255) bitOr: -4096!instSize: aClass	^aClass == nil		ifTrue:	[0]		ifFalse:	[aClass instSize]!sanityCheck: aClass	(aClass canUnderstand: #doesNotUnderstand:)		ifFalse:	[aClass copyCategory: #prototypes from: ClassBuilder].!scan: aString	"Answer the variable list encoded in aString"	| scanner |	scanner _ Scanner new.	^scanner scanFieldNames: aString!typeOf: fmt	"Answer the format as a specification of only kind of object, not size"	^fmt bitAnd: -256! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!ClassBuilder class	instanceVariableNames: ''!!ClassBuilder class methodsFor: 'class initialization'!initialize	"Initialize the failure signals."	"ClassBuilder initialize"	BuildErrorSignal _ (Object errorSignal newSignalMayProceed: true)				notifierString: 'Class definition error';				nameClass: self message: #errorSignal.	BuildFailureSignal _ BuildErrorSignal newSignal				notifierString: 'Invalid class definition';				nameClass: self message: #buildFailureSignal.	NilSuperclassSignal _ BuildErrorSignal newSignal				notifierString: 'Warning -- class being defined with nil superclass';				nameClass: self message: #nilSuperclassSignal! !!ClassBuilder class methodsFor: 'instance creation'!new	"Answer a new instance, suitably initialized"	^super new initialize! !!ClassBuilder class methodsFor: 'Signal constants'!buildFailureSignal	^BuildFailureSignal!errorSignal	^BuildErrorSignal!nilSuperclassSignal	^NilSuperclassSignal! !ClassBuilder initialize!Object subclass: #ClassCategoryReader	instanceVariableNames: 'class category '	classVariableNames: ''	poolDictionaries: ''	category: 'Kernel-Support'!ClassCategoryReader comment:'An instance of class ClassCategoryReader is created during file in in response to "class methodsFor: cat" message.  The instance subsequently scans consecutive "chunks" from the file in stream and asks class to compile them in this category.  It continues in this way until an empty chunk is found.Instance Variables:	class		<ClassDescription> the class being read in	category	<String> the category for methods being read in'!!ClassCategoryReader methodsFor: 'fileIn/Out'!scanFrom: aStream 	"Files in methods from the stream, aStream.  Prints the name and	category of the methods in the transcript view."	| string |	Transcript nextPutAll: class name; nextPut: $<; nextPutAll: category; cr; endEntry.	[string _ aStream nextChunk.	string size > 0]						"done when double terminators"		whileTrue: [class compile: string classified: category]! !!ClassCategoryReader methodsFor: 'private'!setClass: aClass category: aCategory 	class _ aClass.	category _ aCategory! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!ClassCategoryReader class	instanceVariableNames: ''!!ClassCategoryReader class methodsFor: 'instance creation'!class: aClass category: aCategory 	"Answer a new instance of ClassCategoryReader for the category,	aCategory, of the class, aClass."	^self new setClass: aClass category: aCategory! !ClassRelatedChange subclass: #ClassChange	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'System-Changes'!ClassChange comment:'Class ClassChange represents a change to some part of a class definition (actual definition, comment, name, ...) as opposed to a change to a method within a class.  As this class currently adds no further information, it is being used to fulfill class hierarchy symmetry with MethodChange.'!ClassOtherChange subclass: #ClassCommentChange	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'System-Changes'!ClassCommentChange comment:'Class ClassCommentChange represents a change to some part of a class comment.'!!ClassCommentChange methodsFor: 'accessing'!text	"Answer the text displayed by the receiver."	^file == nil		ifTrue: [className, ' comment:', (Smalltalk at: className) comment printString]		ifFalse: [super text]! !!ClassCommentChange methodsFor: 'checking'!checkWith: aChecker	aChecker changesAt: className, '<', type, '>' add: self! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!ClassCommentChange class	instanceVariableNames: ''!!ClassCommentChange class methodsFor: 'instance creation'!new	^super new type: #comment! !ClassChange subclass: #ClassDefinitionChange	instanceVariableNames: 'superclassName classType otherParameters '	classVariableNames: ''	poolDictionaries: ''	category: 'System-Changes'!ClassDefinitionChange comment:'Class ClassDefinitionChange represents a change to some part of a class definition.Instance Variables:	superclassName		<Symbol>	classType			<Symbol>	otherParameters 	<Array>'!!ClassDefinitionChange methodsFor: 'accessing'!name	^'  define ', className!superclassName: aSymbol classType: aSelector otherParameters: anArray	superclassName _ aSymbol.	classType _ aSelector.	otherParameters _ anArray!text	"Answer the text displayed by the receiver."	^file == nil		ifTrue: [(Smalltalk at: className) definition]		ifFalse: [super text]! !!ClassDefinitionChange methodsFor: 'checking'!checkWith: aChecker	| class |	aChecker changesAt: className add: self.	aChecker checkSystem ifTrue:		[class _ Smalltalk at: className ifAbsent: [^self].		self text = class definition ifFalse:			[aChecker changesAt: className add: (self class new className: className)]]! !Behavior subclass: #ClassDescription	instanceVariableNames: 'instanceVariables organization '	classVariableNames: ''	poolDictionaries: ''	category: 'Kernel-Classes'!ClassDescription comment:'ClassDescription adds a number of facilities to basic Behavior:		- named instance variables		- category organization for methods		- the notion of a name of this class (implemented as subclass responsibility)		- the maintenance of the Changes set, and logging changes on a file		- most of the mechanism for fileOutClassDescription is an abstract class: its facilities are intended for inheritance by the two subclasses, Class and Metaclass.Subclasses must implement	instance variables		addInstVarName:		removeInstVarName:Instance Variables:		instanceVariables	<Array of: Strings> names of instance fields		organization		<ClassOrganizer> provides organization of message protocol'!!ClassDescription methodsFor: 'initialize-release'!localObsolete	"Make the receiver obsolete."	organization _ nil.	super localObsolete! !!ClassDescription methodsFor: 'accessing'!comment	"Answer the receiver's comment."	| aString |	aString _ self organization classComment.	aString size = 0 ifTrue: [^''].	"get string only of classComment, undoubling quotes"	^ String readFromString: aString!comment: aString 	"Set the receiver's comment to be the argument, aString."	| aStream |	aString size = 0		ifTrue: 			[self organization classComment: aString]		ifFalse: 			["double internal quotes of the comment string"			aStream _ WriteStream on: (String new: aString size).			aStream nextPutAll: self name , ' comment:'; cr.			aString storeOn: aStream.			self organization classComment: aStream contents.	Smalltalk changes commentClass: self]!commentTemplate	"Answer an expression to edit and evaluate in order to produce the receiver's comment."	| aString |	aString _ self organization classComment.	aString size = 0		ifTrue: [^self name , ' comment:''This class has not yet been commented.  A proper comment should include the purpose of the class and the type and purpose of each instance variable.''']		ifFalse: [^aString]!environment	"Answer the class's compilation scope."	^Smalltalk!name	"Answer a String that is the name of the receiver."	^'an anonymous Behavior'! !!ClassDescription methodsFor: 'copying'!copy: sel from: class 	"Install the method associated with the first argument, sel, a message selector,	found in the method dictionary of the second argument, class, as one of the	receiver's methods.  Classify the message under -as yet not classified-."	self copy: sel		from: class		classified: nil!copy: sel from: class classified: cat 	"Install the method associated with the first argument, sel, a message selector,	found in the method dictionary of the second argument, class, as one of the	receiver's methods.  Classify the message under the third argument, cat."	| code category |	"Useful when modifying an existing class"	code _ class sourceMethodAt: sel.	code == nil		ifFalse: 			[cat == nil				ifTrue: [category _ class organization categoryOfElement: sel]				ifFalse: [category _ cat].			(methodDict includesKey: sel)				ifTrue: [code asString = (self sourceMethodAt: sel) asString 							ifFalse: [self error: self name 										, ' ' 										, sel 										, ' will be redefined if you proceed.']].			self compile: code classified: category]!copyAll: selArray from: class 	"Install all the methods found in the method dictionary of the second argument, class,	as the receiver's methods.  Classify the messages under -as yet not classified-."	self copyAll: selArray		from: class		classified: nil!copyAll: selArray from: class classified: cat 	"Install all the methods found in the method dictionary of the second argument, class,	as the receiver's methods.  Classify the messages under the third argument, cat."	selArray do: 		[:s | self copy: s				from: class				classified: cat]!copyAllCategoriesFrom: aClass 	"Specify that the categories of messages for the receiver include all of those found	in the class, aClass.  Install each of the messages found in these categories into the	method dictionary of the receiver, classified under the appropriate categories."	aClass organization categories do: [:cat | self copyCategory: cat from: aClass]!copyCategory: cat from: class 	"Specify that one of the categories of messages for the receiver is cat, as found	in the class, aClass.  Copy each message found in this category."	self copyCategory: cat		from: class		classified: cat!copyCategory: cat from: aClass classified: newCat 	"Specify that one of the categories of messages for the receiver is the third argument,	newCat.  Copy each message found in the category cat in class aClass into this	new category."	self copyAll: (aClass organization listAtCategoryNamed: cat)		from: aClass		classified: newCat! !!ClassDescription methodsFor: 'testing'!isMeta	"Answer whether the receiver is a meta class."	^ false! !!ClassDescription methodsFor: 'printing'!classVariablesString	"Answer a string of my class variable names separated by spaces, in alphabetical order."	| aStream |	aStream _ WriteStream on: (String new: 100).	self classPool keys asSortedCollection do: [:key | aStream nextPutAll: key; space].	^ aStream contents!definition	"Answer a string that defines the receiver."	| aStream |	aStream _ WriteStream on: (String new: 300).	aStream nextPutAll: (superclass == nil ifTrue: ['nil'] ifFalse: [superclass name]).	aStream nextPutAll: self kindOfSubclass.	self name storeOn: aStream.	aStream cr; tab; nextPutAll: 'instanceVariableNames: '.	aStream store: self instanceVariablesString.	aStream cr; tab; nextPutAll: 'classVariableNames: '.	aStream store: self classVariablesString.	aStream cr; tab; nextPutAll: 'poolDictionaries: '.	aStream store: self sharedPoolsString.	aStream cr; tab; nextPutAll: 'category: '.	(SystemOrganization categoryOfElement: self name) asString storeOn: aStream.	^aStream contents!instanceVariablesString	"Answer a string of my instance variable names separated by spaces."	| aStream names |	aStream _ WriteStream on: (String new: 100).	names _ self instVarNames.	1 to: names size do: [:i | aStream nextPutAll: (names at: i); space].	^ aStream contents!printOn: aStream  	"Append to the argument aStream a sequence of characters that identifies the receiver."	aStream nextPutAll: self name!sharedPoolsString	"Answer a string of my class variable names separated by spaces."	| aStream |	aStream _ WriteStream on: (String new: 100).	self sharedPools do: [:x | aStream nextPutAll: (Smalltalk keyAtValue: x); space].	^ aStream contents!storeOn: aStream	"Append to the argument aStream the global names of.	Classes and Metaclasses."	aStream nextPutAll: self name! !!ClassDescription methodsFor: 'instance variables'!addInstVarName: aString 	"Add the argument, aString, as one of the receiver's instance variables."	self subclassResponsibility!instanceVariables: aCollection	"Set the class's instance variable list"	(aCollection == nil or: [aCollection isEmpty])		ifTrue:	[instanceVariables _ nil]		ifFalse:	[instanceVariables _ aCollection]!instVarNames	"Answer an Array of the names of instance variables defined in the receiver."	instanceVariables == nil		ifTrue: [^#()]		ifFalse: [^instanceVariables]!removeInstVarName: aString 	"Remove the argument, aString, as one of the receiver's instance variables."	self subclassResponsibility! !!ClassDescription methodsFor: 'method dictionary'!addSelector: s withMethod: m category: c	"Add the message selector s associated with the method m under category c."	self addSelector: s withMethod: m.	self organization classify: s under: c!removeCategory: aString 	"Remove each of the messages categorized under aString in the method dictionary	of the receiver.  Then remove the category aString."	(self organization listAtCategoryNamed: aString asSymbol) do:		[:sel | self removeSelector: sel].	self organization removeEmptyCategories!removeSelector: aSymbol 	"Remove the message whose selector is aSymbol from the method	dictionary of the receiver, if it is there.  Answer nil otherwise."	(methodDict includesKey: aSymbol) ifFalse: [^nil].	super removeSelector: aSymbol.	self organization removeElement: aSymbol.	Smalltalk changes removeSelector: aSymbol class: self.	Smalltalk logChange: self name , ' removeSelector: #' , aSymbol! !!ClassDescription methodsFor: 'organization'!category	"Answer the system organization category for the receiver."	^SystemOrganization categoryOfElement: self name!category: cat 	"Categorize the receiver under the system category, cat, removing it from any	previous categorization."	cat isString		ifTrue: [SystemOrganization classify: self name under: cat asSymbol]		ifFalse: [self errorCategoryName]!logOrganizationChange	"Record that the receiver is being reorganized on the changes file."	Smalltalk logChange:			self name,			' organization changeFromString: ',			self organization printString storeString!organization	"Answer the instance of ClassOrganizer that represents the organization	of the messages of the receiver."	organization==nil		ifTrue: [organization _ ClassOrganizer new].	^organization!reorganize	"Record that the receiver is being reorganized and answer the receiver's organization."		Smalltalk changes reorganizeClass: self.	^self organization!whichCategoryIncludesSelector: aSelector 	"Answer the category of the argument, aSelector, in the organization of the	receiver, or answer nil if the receiver does not inlcude this selector."	(self includesSelector: aSelector)		ifTrue: [^organization categoryOfElement: aSelector]		ifFalse: [^nil]! !!ClassDescription methodsFor: 'compiling'!compile: code classified: heading 	"Compile the argument, code, as source code in the context of the receiver and	install the result in the receiver's method dictionary under the classification 	indicated by the second argument, heading. nil is to be notified if an error occurs.	The argument code is either a string or an object that converts to a string or a	PositionableStream on an object that converts to a string."	^self		compile: code		classified: heading		notifying: nil!compile: code classified: heading notifying: requestor 	"Compile the argument, code, as source code in the context of the receiver and	install the result in the receiver's method dictionary under the classification 	indicated by the second argument, heading  The third argument, 	requestor, is to be notified if an error occurs. The argument code is either a string or	an object that converts to a string or a PositionableStream on an object that converts	to a string."	| selector |	selector _ 		self compile: code			notifying: requestor			ifFail: [^nil].	(methodDict at: selector)		putSource: code asString		class: self		category: heading		inFile: 2.	self organization classify: selector under: heading.	^selector!compile: code notifying: requestor ifFail: failBlock 	"Intercept this message in order to remember system changes."	| methodNode selector |	Cursor execute showWhile:		[methodNode _			 	self compilerClass new					compile: code					in: self					notifying: requestor					ifFail: failBlock.	selector _ methodNode selector.	(methodDict includesKey: selector)		ifTrue: [Smalltalk changes changeSelector: selector class: self]		ifFalse: [Smalltalk changes addSelector: selector class: self].	self addSelector: selector withMethod: methodNode generate].	^selector! !!ClassDescription methodsFor: 'fileIn/Out'!fileOutCategory: aString 	"Create a file whose name is the name of the receiver with -.st- as the	extension, and file a description of the receiver's category aString onto it."	| fileName fileStream |	fileName _ self name , '-' , aString , '.st'.	fileStream _ (Filename named: fileName) writeStream.	[fileStream timeStamp.	self fileOutCategory: aString		on: fileStream		moveSource: false		toFile: 0]		valueNowOrOnUnwindDo: [fileStream close]!fileOutCategory: aString on: aFileStream moveSource: moveSource toFile: fileIndex 	"File a description of the receiver's category, aString, onto aFileStream.  If	the boolean argument, moveSource, is true, then set the trailing bytes to the position 	of aFileStream and to fileIndex in order to indicate where to find the source code."	self printCategoryChunk: aString on: aFileStream.	(self organization listAtCategoryNamed: aString)		do: [:sel | self				printMethodChunk: sel				on: aFileStream				moveSource: moveSource				toFile: fileIndex].	aFileStream nextChunkPut: ' '!fileOutChangedMessages: aSet on: aFileStream 	"File a description of the messages of the receiver that have been changed	(i.e., are entered into the system ChangeSet) onto aFileStream."	self fileOutChangedMessages: aSet		on: aFileStream		moveSource: false		toFile: 0!fileOutChangedMessages: aSet on: aFileStream moveSource: moveSource toFile: fileIndex 	"File a description of the messages of the receiver that have been changed	(i.e., are entered into the system ChangeSet) onto aFileStream.  If	the boolean argument, moveSource, is true, then set the trailing bytes to the position 	of aFileStream and to fileIndex in order to indicate where to find the source code."	| org sels |	(org _ self organization) categories do: 		[:cat | 		sels _ (org listAtCategoryNamed: cat) select: [:sel | aSet includes: sel].		sels size > 0			ifTrue: 				[Transcript cr; show: self name , '>' , cat.				self printCategoryChunk: cat on: aFileStream.				sels do: [:sel | 						self							printMethodChunk: sel							on: aFileStream							moveSource: moveSource							toFile: fileIndex].				aFileStream nextChunkPut: ' ']]!fileOutMessage: aString 	"Create a fileName which is the name of the receiver with -.st as the	extension, and file a description of the receiver's message aString onto it"	self fileOutMessage: aString		fileName: (self name , '-' , aString , '.st')!fileOutMessage: aString fileName: fileName	"Create a local file named fileName	and file a description of the receiver's message aString onto it"	| fileStream |	fileStream _ (Filename named: fileName) writeStream.	[fileStream timeStamp.	self fileOutOn: fileStream		moveSource: false		toFile: 0]		valueNowOrOnUnwindDo: [fileStream close]!fileOutMessage: aString on: aFileStream moveSource: moveSource toFile: fileIndex 	"File a description of the receiver's message, aString, onto aFileStream.  If	the boolean argument, moveSource, is true, then set the trailing bytes to the position 	of aFileStream and to fileIndex in order to indicate where to find the source code."	| cat |	cat _ self organization categoryOfElement: aString.	cat == nil ifTrue: [^self error: 'no such message'].	self printCategoryChunk: cat on: aFileStream.	self		printMethodChunk: aString		on: aFileStream		moveSource: moveSource		toFile: fileIndex.	aFileStream nextChunkPut: ' '!fileOutOn: aFileStream 	"File a description of the receiver on aFileStream."	self fileOutOn: aFileStream		moveSource: false		toFile: 0!fileOutOn: aFileStream moveSource: moveSource toFile: fileIndex	"File the receiver out on aFileStream."	aFileStream emphasis: 5.		"Meant to be 12 point bold font."	aFileStream nextChunkPut: self definition.	self organization		putCommentOnFile: aFileStream		numbered: fileIndex		moveSource: moveSource.	aFileStream cr.	self organization categories do: 		[:heading |		self			fileOutCategory: heading			on: aFileStream			moveSource: moveSource			toFile: fileIndex]!fileOutOrganizationOn: aFileStream 	"File a description of the receiver's organization onto aFileStream."	aFileStream emphasis: 3.	aFileStream cr.	aFileStream nextChunkPut:			self name ,			' organization changeFromString: ' ,			self organization printString storeString.	aFileStream cr.	aFileStream emphasis: 1!kindOfSubclass	"Answer a string that describes what kind of subclass the receiver is, i.e.,	variable, variable byte, variable word, or not variable."	self isVariable		ifTrue: [self isBits					ifTrue: [^' variableByteSubclass: ']					ifFalse: [^' variableSubclass: ']]		ifFalse: [^' subclass: ']!methodsFor: aString 	"Answer a ClassCategoryReader for accessing the messages in the method	dictionary category, aString, of the receiver."	^ClassCategoryReader class: self category: aString asSymbol	"False methodsFor: 'logical operations' inspect"!moveChangesTo: newFile 	"Used in the process of condensing changes, this message requests that the source	code of all methods of the receiver that have been changed should be moved to	newFile."	| changes |	self organization moveChangedCommentToFile: newFile numbered: 2.	changes _ methodDict keys select: [:sel | (methodDict at: sel) fileIndex > 1].	self fileOutChangedMessages: changes		on: newFile		moveSource: true		toFile: 2!printCategoryChunk: aString on: aFileStream 	"Print category definition on aFileStream."	aFileStream cr; cr; nextPut: $!!.	aFileStream nextChunkPut:				self name , ' methodsFor: ' , '''' , aString , ''''!printMethodChunk: aSelector on: aFileStream moveSource: moveSource toFile: fileIndex 	"Print the source code for the method associated with the argument 	selector onto 	the fileStream. aFileStream, and, for backup, if the argument 	moveSource (a Boolean) 	is true, also set the file index within the method to be the argument 	fileIndex. "	| position |	aFileStream cr.	Cursor write showWhile:		[moveSource			ifTrue: 				[position _ aFileStream writePosition.				aFileStream nextChunkPut: (self sourceCodeAt: aSelector).				(self compiledMethodAt: aSelector)					setSourcePosition: position inFile: fileIndex]			ifFalse: [aFileStream cr; nextChunkPut: (self sourceCodeAt: aSelector)]]!printOutCategory: aString 	"Create a readable version of the message category aString, and send to a printer.	Defaults to fileOut."	self fileOutCategory: aString!printOutMessage: aString 	"Create a readable version of the message with selector aString, and send to a printer.	Defaults to fileOut."	self fileOutMessage: aString! !!ClassDescription methodsFor: 'private'!errorCategoryName	self error: 'Category name must be a String'! !Object subclass: #ClassOrganizer	instanceVariableNames: 'globalComment categoryArray categoryStops elementArray '	classVariableNames: 'Default '	poolDictionaries: ''	category: 'Kernel-Support'!ClassOrganizer comment:'ClassOrganizers contain the categorization information for classes.  A ClassOrganizer consists of an Array of category names (categoryArray), each of which refers to an Array of elements (elementArray).  This association is made through an Array of stop indices (categoryStops), each of which is the index in elementArray of the last element (if any) of the corresponding category.	For example:		categories _ Array with: #firstCat with: secondCat with: thirdCat 		stops _ Array with: 1 with: 4 with: 4		elements _ Array with: #a with: #b with: #c with: #d	means that category firstCat has ony #a, secondCat has #b, #c, and #d,		and thirdCat has no elements.	This means that stops at: stops size must be the same as elements size.Instance Variables:	globalComment		<RemoteString> comment for the class as a whole	categoryArray		<Array of: String> category names	categoryStops		<Array of: Integer> see below	elementArray		<Array of: Symbol> message selectorsClass Variables:	Default		<Symbol>	label for a yet-to-named protocol	'!!ClassOrganizer methodsFor: 'accessing'!changeFromString: aString 	"Parse the string and make this be the receiver's structure.  Categories or elements not found are not affected.  New elements are ignored."	| scanner oldElements newElements newCategories newStops currentStop anArray |	scanner _ Scanner new scanTokens: aString.	"If nothing was scanned and I had no elements before, then default me"	(scanner size = 0 and: [elementArray size = 0])		ifTrue: [^self setDefaultList].	oldElements _ elementArray asSet.	newCategories _ Array new: scanner size.	newStops _ Array new: scanner size.	currentStop _ 0.	newElements _ WriteStream on: (Array new: 16).	1 to: scanner size do: 		[:i | 		anArray _ scanner at: i.		newCategories at: i put: anArray first asSymbol.		(anArray copyFrom: 2 to: anArray size) asSortedCollection do:			[:elem |			(oldElements remove: elem ifAbsent: [nil]) notNil ifTrue:				[newElements nextPut: elem.				currentStop _ currentStop+1]].		newStops at: i put: currentStop].	"Ignore extra elements but don't lose any existing elements!!"	oldElements _ oldElements collect:		[:elem | Array with: (self categoryOfElement: elem) with: elem].	newElements _ newElements contents.	categoryArray _ newCategories.	categoryStops _ newStops.	elementArray _ newElements.	oldElements do: [:pair | self classify: pair last under: pair first].! !!ClassOrganizer methodsFor: 'categories'!addCategory: heading 	"Add a new category named heading."	^ self addCategory: heading before: nil!addCategory: heading before: nextHeading	"Add a new category named heading.  If nextHeading is specified (not nil)	and can be found, then INSERT before that entry.  Otherwise ADD it at the end.	If heading already exists, then MOVE it where it would have gone otherwise."	| nextIndex elements | 	(categoryArray indexOf: heading) > 0		ifTrue:  "already there - maybe move"			["slow but sure;  remove all, then insert all"			elements _ self listAtCategoryNamed: heading.	"Save elements"			elements do: [:elt | self removeElement: elt].			self removeCategory: heading.		"Remove old entry"			self addCategory: heading before: nextHeading.	"Now insert anew"			self classifyAll: elements under: heading.			"And restore elements"			^self].	nextIndex _ categoryArray indexOf: nextHeading							ifAbsent: [categoryArray size+1].	categoryArray _ categoryArray  "insert before nextIndex"			copyReplaceFrom: nextIndex			to: nextIndex-1			with: (Array with: heading).	categoryStops _ categoryStops			copyReplaceFrom: nextIndex			to: nextIndex-1			with: (Array with: (nextIndex=1					ifTrue: [0]					ifFalse: [categoryStops at: nextIndex-1])).!categories	"Answer an array of categories (names)."	(categoryArray size = 1 		and: [categoryArray first = Default & (elementArray size = 0)])		ifTrue: [^Array new].	^categoryArray!categories: anArray 	"Reorder the receiver's categories to be in the order of anArray.  If the	resulting organization does not include all elements, then give an error."	| newCategories newStops newElements catName list runningTotal | 	newCategories _ Array new: anArray size.	newStops _ Array new: anArray size.	newElements _ Array new: 0.	runningTotal _ 0.	1 to: anArray size do:		[:i |		catName _ (anArray at: i) asSymbol.		list _ self listAtCategoryNamed: catName.				newElements _ newElements, list.				newCategories at: i put: catName.				newStops at: i put: (runningTotal _ runningTotal + list size)].	elementArray do:		[:element | "check to be sure all elements are included"		(newElements includes: element)			ifFalse: [^self error: 'New categories must match old ones']].	"Everything is good, now update my three arrays."	categoryArray _ newCategories.	categoryStops _ newStops.	elementArray _ newElements!categoryOfElement: element 	"Answer the category associated with the argument, element."	| index |	index _ self numberOfCategoryOfElement: element.	index = 0		ifTrue: [^nil]		ifFalse: [^categoryArray at: index]!removeCategory: cat 	"Remove the category named, cat.  Create an error if the category has	any elements in it."	| index lastStop |	index _ categoryArray indexOf: cat ifAbsent: [^self].	lastStop _ 		index = 1			ifTrue: [0]			ifFalse: [categoryStops at: index - 1].	(categoryStops at: index) - lastStop > 0 		ifTrue: [^self error: 'cannot remove non-empty category'].	categoryArray _ 		(categoryArray copyFrom: 1 to: index - 1)			, (categoryArray copyFrom: index + 1 to: categoryArray size).	categoryStops _ 		(categoryStops copyFrom: 1 to: index - 1)			, (categoryStops copyFrom: index + 1 to: categoryStops size).!removeEmptyCategories	"Remove empty categories."	| categoryIndex currentStop keptCategories keptStops |	keptCategories _ WriteStream on: (Array new: 16).	keptStops _ WriteStream on: (Array new: 16).	currentStop _ categoryIndex _ 0.	[(categoryIndex _ categoryIndex + 1) <= categoryArray size]		whileTrue: 			[(categoryStops at: categoryIndex) > currentStop				ifTrue: 					[keptCategories nextPut: (categoryArray at: categoryIndex).					keptStops nextPut: (currentStop _ categoryStops at: categoryIndex)]].	categoryArray _ keptCategories contents.	categoryStops _ keptStops contents.	"ClassOrganizer allInstancesDo: [:co | co removeEmptyCategories]."!renameCategory: oldName to: newName	"Answer the array of elements associated with the name, categoryName."	| i symbol |	i _ categoryArray indexOf: oldName		ifAbsent: [^ false].	symbol _ newName asSymbol.	categoryArray indexOf: symbol		ifAbsent: [categoryArray at: i put: symbol.  ^ true].	^ false  "newName was already there"! !!ClassOrganizer methodsFor: 'elements'!classify: element under: heading 	"Store the argument, element, in the category named heading."	| catName catIndex elemIndex realHeading |	realHeading _ heading asSymbol.	(catName _ self categoryOfElement: element) ~~ nil 		ifTrue:  "Element already there"			[realHeading = Default ifTrue: [^self].	"Default causes no change"			realHeading = catName ifTrue: [^self].	"heading didnt change"			self removeElement: element].	"remove from old heading if did change"	(categoryArray indexOf: realHeading) = 0 ifTrue: [self addCategory: realHeading].	"add realHeading if not there already"	catIndex _ categoryArray indexOf: realHeading.	elemIndex _ 		catIndex > 1			ifTrue: [categoryStops at: catIndex - 1]			ifFalse: [0].	[(elemIndex _ elemIndex + 1) <= (categoryStops at: catIndex) 		and: [element >= (elementArray at: elemIndex)]] whileTrue.	"elemIndex is now the index for inserting the element. Do the insertion before it."	elementArray _ 		(elementArray copyFrom: 1 to: elemIndex - 1)			, (Array with: element) 			, (elementArray copyFrom: elemIndex to: elementArray size).	"insertion"	"add one to stops for this and later categories"	catIndex to: categoryArray size do: 		[:i | categoryStops at: i put: (categoryStops at: i) + 1].	"remove empty default category if any"	categoryArray indexOf: Default ifAbsent: [^self].	(self listAtCategoryNamed: Default) size = 0		ifTrue: [self removeCategory: Default].!classifyAll: aCollection under: heading	"Add all the methos in aCollection under the category heading."	aCollection do:		[:element | self classify: element under: heading]!elements	"Answer an array of all the message selectors."	^elementArray!includesElement: element	"Answer whether element is in one of the receiver's categories."	^ (self categoryOfElement: element) ~~ nil!listAtCategoryNamed: categoryName	"Answer the array of elements associated with the name, categoryName."	| i |	i _ categoryArray indexOf: categoryName ifAbsent: [^Array new].	^self listAtCategoryNumber: i!removeElement: element 	"Remove the selector, element, from all categories."	| categoryIndex elementIndex nextStop newElements |	categoryIndex _ 1.	elementIndex _ 0.	nextStop _ 0.	"nextStop keeps track of the stops in the new element array"	newElements _ WriteStream on: (Array new: elementArray size).	[(elementIndex _ elementIndex + 1) <= elementArray size]		whileTrue: 			[[elementIndex > (categoryStops at: categoryIndex)]				whileTrue: 					[categoryStops at: categoryIndex put: nextStop.					categoryIndex _ categoryIndex + 1].			element = (elementArray at: elementIndex)				ifFalse: 					[nextStop _ nextStop + 1.					newElements nextPut: (elementArray at: elementIndex)]].	[categoryIndex <= categoryStops size]		whileTrue: 			[categoryStops at: categoryIndex put: nextStop.			categoryIndex _ categoryIndex + 1].	elementArray _ newElements contents! !!ClassOrganizer methodsFor: 'comment'!classComment	"Answer the comment associated with the object that refers to the receiver."	globalComment == nil ifTrue: [^''].	^globalComment string!classComment: aString 	"Store the comment, aString, associated with the object that refers to the receiver."	aString size = 0		ifTrue: [globalComment _ nil]		ifFalse: [globalComment _ RemoteString newString: aString onFileNumber: 2]!hasNoComment	"Answer whether the class classified by the receiver has a comment."	^globalComment == nil!moveChangedCommentToFile: aFileStream numbered: sourceIndex 	"This is part of source code compression.  Move the comment about the	class classified by the receiver from the file referenced by	sourceIndex and to the stream, aFileStream."	(globalComment ~~ nil and: [globalComment sourceFileNumber > 1])		ifTrue: 			[aFileStream cr; cr.			globalComment _ 				RemoteString					newString: globalComment string					onFileNumber: sourceIndex					toFile: aFileStream]!putCommentOnFile: aFileStream numbered: sourceIndex moveSource: moveSource 	"Store the comment about the class onto file, aFileStream."	| newRemoteString saveEmphasis |	saveEmphasis _ aFileStream emphasis.	aFileStream emphasis: 3.		"meant to be 10 point italic font"	globalComment ~~ nil		ifTrue: 			[aFileStream cr.			newRemoteString _ 				RemoteString						newString: globalComment string						onFileNumber: sourceIndex						toFile: aFileStream.			moveSource ifTrue: [globalComment _ newRemoteString]].	aFileStream emphasis: saveEmphasis.! !!ClassOrganizer methodsFor: 'printing'!printOn: aStream  	"Append to the argument aStream a sequence of characters that identifies the receiver."	| elementIndex |	elementIndex _ 1.	1 to: categoryArray size do: 		[:i | 		aStream nextPut: $(.		(categoryArray at: i) asString printOn: aStream.		[elementIndex <= (categoryStops at: i)]			whileTrue: 				[aStream space.				(elementArray at: elementIndex) printOn: aStream.				elementIndex _ elementIndex + 1].		aStream nextPut: $).		aStream cr]! !!ClassOrganizer methodsFor: 'fileIn/Out'!scanFrom: aStream 	"Reads in the organization from the next chunk on aStream. 	Categories or elements not found in the definition are not affected. 	New elements are ignored."	self changeFromString: aStream nextChunk! !!ClassOrganizer methodsFor: 'private'!listAtCategoryNumber: index 	"Answer the array of elements stored at the position index."	| firstIndex lastIndex |	firstIndex _ index = 1			ifTrue: [1]			ifFalse: [(categoryStops at: index - 1) + 1].	lastIndex _ categoryStops at: index.	^ elementArray copyFrom: firstIndex to: lastIndex!numberOfCategoryOfElement: element 	"Answer the index of the category with which the argument, element,	is associated."	| categoryIndex elementIndex |	categoryIndex _ 1.	elementIndex _ 0.	[(elementIndex _ elementIndex + 1) <= elementArray size]		whileTrue: 			["point to correct category"			[elementIndex > (categoryStops at: categoryIndex)]				whileTrue: [categoryIndex _ categoryIndex + 1].			"see if this is element"			element = (elementArray at: elementIndex) ifTrue: [^categoryIndex]].	^0!setDefaultList	self classComment: ''.	categoryArray _ categoryStops _ elementArray _ Array new!setDefaultList: aSortedCollection 	self classComment: ''.	categoryArray _ Array with: Default.	categoryStops _ Array with: aSortedCollection size.	elementArray _ aSortedCollection asArray! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!ClassOrganizer class	instanceVariableNames: ''!!ClassOrganizer class methodsFor: 'class initialization'!defaultProtocol	"Answer the name of the default protocol."	^Default!initialize	Default _ 'As yet unclassified' asSymbol	"ClassOrganizer initialize"! !!ClassOrganizer class methodsFor: 'instance creation'!new	"Answer a new instance of ClassOrganizer with no initial elements."	^super new setDefaultList! !ClassOrganizer initialize!ClassChange subclass: #ClassOtherChange	instanceVariableNames: 'type '	classVariableNames: ''	poolDictionaries: ''	category: 'System-Changes'!ClassOtherChange comment:'Class ClassOtherChange represents a change to a class, other than a class definition. Instance Variables:	type	<String>   Possible types are:  comment, initialize, inst vars for, rename, and rename to.'!!ClassOtherChange methodsFor: 'accessing'!name	^'  ', type, ' ', className!type	^type!type: aSymbol	type _ aSymbol! !!ClassOtherChange methodsFor: 'checking'!checkWith: aChecker 	type == #initialize ifFalse: [aChecker changesAt: className add: self].	type == #'inst vars for' ifFalse: [aChecker addDoIt: self]! !Change subclass: #ClassRelatedChange	instanceVariableNames: 'className '	classVariableNames: ''	poolDictionaries: ''	category: 'System-Changes'!ClassRelatedChange comment:'Class ClassRelatedChange represents a change related in some way to a particular class.Instance Variables:	className	<Symbol>'!!ClassRelatedChange methodsFor: 'accessing'!className	^className!className: aSymbol	className _ aSymbol asSymbol!classObject	| class |	^Smalltalk at: className ifAbsent:		[(className size > 6 and: [(className copyFrom: className size - 5 to: className size) = ' class'])			ifTrue:				[class _ Smalltalk at: (className copyFrom: 1 to: className size - 6) asSymbol ifAbsent: [^nil].				class isBehavior ifTrue: [class class] ifFalse: [nil]]			ifFalse:				[nil]]!getSource	"Set me up to point to the version of this change which is currently installed in the system."	self subclassResponsibility!parameters	^className! !TextController subclass: #CodeController	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Interface-Text'!CodeController comment:'A CodeController is an interaction with text that adds some capability appropriate only to viewing Smalltalk code, such as ''explain'' and ''format''.'!!CodeController methodsFor: 'menu messages'!doIt	"Evaluate the current text selection as an expression"	| result selectionStart oldTextSize selection |	self controlTerminate.	selectionStart _ startBlock stringIndex.	oldTextSize _ self text size.	selection _ self selection.	result _ 		model doItReceiver class evaluatorClass new				evaluate: self selectionAsStream				in: model doItContext				to: model doItReceiver				notifying: self				ifFail: 					[self controlInitialize.					^#failedDoit].	self selection asString = selection asString ifFalse:		[self selectFrom: selectionStart  "Reselect doIt range after compiler interaction"			to: selectionStart + selection size - 1 + (self text size - oldTextSize)].	Smalltalk logChange: self selection string.	model doItValue: result.	self controlInitialize.	^result!explain	"Try to shed some light on what kind of entity the current selection is.    	The selection must be a single token or construct.  Insert the answer   	after the selection.  Call private routines whose names begin with   	'explain'.  They return a String if they recognise the selection, else nil."	| reply |	reply _ (Explainer new		class: model selectedClass		selector: model selector		instance: model doItReceiver		context: model doItContext		methodText: model text) explain: self selection string for: model.	reply size = 0 ifTrue:		[reply _ '"Sorry, I can''t explain that.  Please select a single token, construct, or special character.' ,			(model isUnlocked ifTrue: ['"'] ifFalse: ['  Also, please cancel or accept."']).].	self insertAndSelect: reply at: stopBlock stringIndex!format	"Reformat the contents of the receiver's view, formatted, if the view is unlocked."	| selectedClass aCompiler newText |	Sensor leftShiftDown ifTrue: [^self miniFormat].	selectedClass _ model selectedClass.	selectedClass == nil ifTrue: [^self].	self controlTerminate.	Cursor execute		showWhile: 			[aCompiler _ selectedClass compilerClass new.			self selectFrom: 1 to: paragraph text size.			self deselect.			newText _ aCompiler						format: paragraph text						in: selectedClass						notifying: self.			newText == nil				ifFalse: 					[self replaceSelectionWith: (newText asText makeSelectorBoldIn: selectedClass).					self selectAt: 1]].	self controlInitialize!inspectIt	"Evaluate the current text selection as an expression"	| result selectionStart oldTextSize selection |	self controlTerminate.	selectionStart _ startBlock stringIndex.	oldTextSize _ self text size.	selection _ self selection.	result _ 		model doItReceiver class evaluatorClass new				evaluate: self selectionAsStream				in: model doItContext				to: model doItReceiver				notifying: self				ifFail: 					[self controlInitialize.					^#failedDoit].	self selection asString = selection asString ifFalse:		[self selectFrom: selectionStart  "Reselect doIt range after compiler interaction"			to: selectionStart + selection size - 1 + (self text size - oldTextSize)].	Smalltalk logChange: self selection string.	model doItValue: result.	result inspect!localMenuItem: selector	^ (#(doIt printIt inspectIt format explain) includes: selector) or:		[super localMenuItem: selector]!miniFormat	"Replace selection with selection un-wrapped."	| inStream outStream char |	inStream _ ReadStream on: (self selection copyWithout: Character tab).	outStream _ WriteStream on: (String new: self selection size).	[inStream atEnd]		whileFalse: 			[char _ inStream next.			char isSeparator				ifTrue: 					[outStream space.					[inStream atEnd not and: [inStream peek isSeparator]]						whileTrue: [inStream next]]				ifFalse: [outStream nextPut: char]].	self deselect.	self replaceSelectionWith: outStream contents asText.	self select!printIt	"Evaluate the current selection as an expression.  If successful, insert and	select the printString of the result of evaluation after the current selection."	| result |	result _ self doIt.	result ~~ #failedDoit		ifTrue: [self insertAndSelect: result printString at: stopBlock stringIndex]! !Object subclass: #CodeLabel	instanceVariableNames: 'references definition '	classVariableNames: ''	poolDictionaries: ''	category: 'System-Compiler-Support'!CodeLabel comment:'I represent a label in the compiled code stream.  I store references and definitions as stream indices, which are 0-origin, not 1-origin.Instance variables:	references	<Array of: (Association key: Integer value: Integer) | nil>  "the locations of the forward references: key = location, value = opcode"	definition	<Integer | nil>  "the location where the label is defined"Since the great majority of CodeLabels only have a single reference, we initialize references to nil, and create an array at the first reference, rather than copying an empty array.'!!CodeLabel methodsFor: 'accessing'!definition	^definition!definition: codePos	definition _ codePos!reference: codePos opcode: op	| ref |	ref _ Association key: codePos value: op.	references == nil		ifTrue: [references _ Array with: ref]		ifFalse: [references _ references copyWith: ref]!references	^references! !!CodeLabel methodsFor: 'scrunching'!fixAcross: codePos in: code long: longop	"If appropriate, fix any branches across	a place where a scrunch is about to happen.	Also adjust any labels beyond the scrunch point."	| refpos op |	"Note that all definitions and references are	stream positions, which are 0-origin.	This is compatible with the accessing protocol	of CodeReadWriteStream."	references notNil		ifTrue:			[references do: [:ref |				refpos _ ref key.				refpos > codePos ifTrue: [ref key: refpos - 1].				definition notNil ifTrue:					[definition > codePos						ifTrue:							["Might be a crossing forward branch,							either short or long."							refpos < codePos ifTrue:								["Crossing forward branch.								Subtract 1 from the displacement."								(op _ code at: refpos) < longop									ifTrue:										["Short branch"										code at: refpos put: op - 1]									ifFalse:										["Long branch"										code adjustBranchAt: refpos by: -1]]]						ifFalse:							["Might be a crossing backward branch.							All backward branches are long."							refpos > codePos ifTrue:								["Crossing backward branch.								Add 1 to the displacement."								code adjustBranchAt: refpos by: 1]]]]].	(definition notNil and: [definition > codePos])		ifTrue: [definition _ definition - 1]! !!CodeLabel methodsFor: 'printing'!printOn: aStream	self storeOn: aStream!storeOn: aStream	aStream nextPutAll: '(';		nextPutAll: self class name;		nextPutAll: ' new definition: ';		store: definition.	references do: [:ref |		aStream nextPutAll: '; reference: ';			store: ref key;			nextPutAll: ' opcode: ';			store: ref value].	aStream nextPutAll: ')'! !ByteCodeStream subclass: #CodeStream	instanceVariableNames: 'outerStream needsFrame hybrid usesOuter canCopy tempStores usedArgs usedTemps copiedVars finalNumTemps innerBlocks forContext forNonImmediate deferredBlocks method allSourceMaps '	classVariableNames: ''	poolDictionaries: 'OpcodePool '	category: 'System-Compiler-Support'!CodeStream comment:'I accumulate code for the compiler.Instance variables:	needsFrame	<Boolean>  "if true, this method needs a frame"	hybrid	<Boolean>  "if true, contexts for this method should be created hybrid"	usesOuter	<Integer>  "nesting level of outermost scope that must be retained"	canCopy	<Boolean>	tempStores	<nil | Array of: SmallInteger>	usedArgs	<nil | ArrayedCollection of: (Array with: Integer with: Integer)>	usedTemps	<nil | ArrayedCollection of: (Array with: Integer with: Integer)>	copiedVars	<nil | ArrayedCollection of: (Array with: Integer with: Integer)>	finalNumTemps	<nil | Integer>  "total numTemps, including generated temps, at end of method"	fullBlocks	<nil | OrderedCollection of: CompiledMethod>	forContext	<Boolean | nil>	forNonImmediate	<Boolean | nil>	deferredBlocks	<nil | OrderedCollection of: DeferredBlock>	allSourceMaps	<nil | Dictionary key: CompiledMethod value: (Array with: (OrderedCollection of: (Association key: Integer value: Integer) with: NameScope)>tempStores keeps track of the number of stores to each temporary variable bound in this scope.  A negative value means this temporary has been stored into from an inner scope; a positive value counts the number of stores at this level.usedArgs and usedTemps keep track of outer-scope variables that are read in this scope.  Eacn entry is a pair of (scope, index); index = -1 means the receiver (self).  If canCopy is true at the end of the block, we can use a copying block rather than a full block.  When recompiling the block as a copying block, copiedVars holds the list of outer variables that have been copied locally.  finalNumTemps holds the final value of numTemps from the first compilation, which may be larger than numTemps if there were any in-line blocks (e.g. for ifTrue:) with local temporaries, or any compiler-generated temporaries (e.g. for arithmetic loops).fullBlocks keeps track of block methods whose last literal must be changed, when the method at this level is completed, to a reference to this method.forContext is nil if no instance variables have been referenced, true if we are compiling in a sub- or superclass of Context and an instance variable has been referenced, and false otherwise.forNonImmediate is nil until it has been computed; then it is true if we are compiling in a class that cannot be (a superclass of) an immediate class (SmallInteger or Character), and false otherwise.deferredBlocks is shared among all the code streams for a given method (i.e. the method stream and all the interior block streams).  It holds DeferredBlocks, which represent blocks whose nature (copying or full) cannot be determined until the end of some enclosing scope.  These are revisited at the end of compiling the entire method.The entries in allSourceMaps save both the actual source-to-PC map and the scope chain.'!!CodeStream methodsFor: 'initialize-release'!initialize	super initialize.	needsFrame _ hybrid _ false.	usesOuter _ 256.  "infinity"	canCopy _ true!makeMethod: methodNode	"Return an appropriate compiled code object"	| deferred |	deferred _ deferredBlocks.  "makeMethodOfClass: sets it to nil"	self makeMethodOfClass: CompiledMethod local: false.	"Revisit all ambiguous blocks"	deferred == nil		ifFalse:			[deferred do: [:dfb | dfb complete]].	^method!newBlockScope	| inner |	inner _ super newBlockScope.	sourceMap isNil ifFalse: [inner saveSourceMap: allSourceMaps].	^inner!outerStream: aCodeStream finalNumTemps: tempCount	"Set the outer block and total temp count	when compiling a block."	outerStream _ aCodeStream.	finalNumTemps _ tempCount!saveSourceMap	super saveSourceMap.	allSourceMaps _ IdentityDictionary new: 8! !!CodeStream methodsFor: 'accessing'!addTemporaries: temps	| mark stores |	mark _ super addTemporaries: temps.	mark notNil		ifTrue:			[stores _ Array new: temps size withAll: 0.			tempStores _ tempStores == nil						ifTrue: [stores]						ifFalse: [tempStores , stores]].	^mark!bindCopied: vars	"Record the locations of	the copied values in a copying block."	copiedVars _ vars.	code nextPut: OpCopyValues		with: vars size.	depth _ depth + vars size.	depth > maxDepth ifTrue: [maxDepth _ depth]!deferredBlocks: blocks	deferredBlocks _ blocks!homeStream	"Answer the outermost (method) stream	for the current compilation."	outerStream == nil		ifTrue: [^self]		ifFalse: [^outerStream homeStream]!method	"For deferred block fixups"	^method!numTemps	"This is only meant to be used by	an outer codeStream."	^numTemps!sourceInfo	^method withAllBlockMethods collect: [:m | allSourceMaps at: m]!usedArgs	"This is only meant to be used by	an outer codeStream."	^usedArgs!usedTemps	"This is only meant to be used by	an outer codeStream."	^usedTemps!usedVars	"This is only meant to be used by	an outer codeStream."	^usedArgs == nil		ifTrue: [usedTemps]		ifFalse:			[usedTemps == nil				ifTrue: [usedArgs]				ifFalse: [usedArgs , usedTemps]]! !!CodeStream methodsFor: 'testing'!canCopy	canCopy ifFalse: [^false].	"Check potentially copied temps"	usedTemps == nil ifTrue: [^true].	usedTemps do:		[:var |		(self findStore: (var at: 2) scope: (var at: 1)) < 0			ifTrue: [^false]].	^true!inBlock	^nesting > 0!isForNonImmediate	"Return true if this class is definitely not	an immediate class or a superclass of one,	and false otherwise."	forNonImmediate == nil ifFalse: [^forNonImmediate].	class instSize > 1  "actually, should be 0 in the present implementation..."		ifTrue:  "can't be a super of an immediate"			[^forNonImmediate _ true].	^forNonImmediate _ (class = SmallInteger or: [class = Character or: [(SmallInteger inheritsFrom: class) or: [Character inheritsFrom: class]]]) not!usesOuter	^usesOuter! !!CodeStream methodsFor: 'code generation-loads and stores'!pushConstant: lit	| index | 	self push.	lit == nil ifTrue: [code nextPut: OpLoadNil.  ^self].	lit == true ifTrue: [code nextPut: OpLoadTrue.  ^self].	lit == false ifTrue: [code nextPut: OpLoadFalse.  ^self].	lit isInteger		ifTrue:			[(lit >= 0 and: [lit <= 2])				ifTrue:					[code nextPut: OpLoadZero + lit.					^self].			(lit >= 0 and: [lit <= 255])				ifTrue:					[code nextPut: OpLoadByte with: lit.					^self].			(lit >= -32768 and: [lit < 32768])				ifTrue:					[code nextPut: OpLoadTwoBytes						with: ((lit bitShift: -8) bitAnd: 255)						with: (lit bitAnd: 255).					^self]].	((lit isMemberOf: Character) and: [lit asciiValue between: 0 and: 255])		ifTrue:			[code nextPut: OpLoadCharacter with: lit asciiValue.			^self].	index _ literals at: lit ifAbsent:		["Add the literal to the collection"		literalCollection addLast: lit.		literals at: lit put: literalCollection size - 1].	index <= MaxLoadLiteral		ifTrue: [code nextPut: OpLoadLiteral + index]		ifFalse: [code nextPut: OpXLoadLiteral with: index]!pushContext	code nextPut: OpLoadThisContext.	needsFrame _ hybrid _ true.	self push!pushStatic: binding	self putIndex: (self literalIndex: binding)		short: OpLoadStatic		max: MaxLoadStatic		long: OpXLoadStatic.	self push!putLoadInst: index scope: scope	scope = nesting		ifTrue:			[self putIndex: index short: OpLoadInst max: MaxLoadInst long: OpXLoadInst]		ifFalse:			[self putLoadReceiver: scope;				putLoadInstAny: index].	forContext == nil ifTrue: [self setContextFlag].	self push!putLoadInstAny: index	code nextPut: OpLoadInstAny with: index!putLoadLocal: index argument: argFlag scope: scope	| copiedIndex |	scope = nesting		ifTrue:			[(index <= MaxPopLoadTemp and:			 [code lastCode = OpPop])				ifTrue:					[code lastPut: OpPopLoadTemp + index]				ifFalse:					[self putIndex: index short: OpLoadTemp max: MaxLoadTemp long: OpXLoadTemp]]		ifFalse:			["See if this value is being cached locally"			(copiedVars notNil and: [(copiedIndex _ copiedVars indexOf: (Array with: scope with: index)) > 0])				ifTrue:					[^self putLoadLocal: numArgs + finalNumTemps + copiedIndex - 1 argument: true scope: nesting].			(scope = (nesting - 1) and: [index <= MaxLoadTempNextOuter])				ifTrue:					[scope < usesOuter ifTrue: [usesOuter _ scope].					code nextPut: OpLoadTempNextOuter + index]				ifFalse:					[self putIndex: index scope: scope short: OpLoadTemp max: MaxLoadTemp long: OpXLoadTemp						outer: OpLoadTempOuter long: OpXLoadTempOuter noCopy: false].			canCopy				ifTrue:					[self addUse: index argument: argFlag scope: scope]].	self push!putLoadPseudo: name scope: scope	"name can only be thisContext"	self pushContext!putLoadReceiver: scope	| copiedIndex | 	scope = nesting		ifTrue:			[code lastCode = OpPop				ifTrue: [code lastPut: OpPopLoadReceiver]				ifFalse: [code nextPut: OpLoadReceiver]]		ifFalse:			["See if this value is being cached locally"			(copiedVars notNil and: [(copiedIndex _ copiedVars indexOf: (Array with: scope with: -1)) > 0])				ifTrue:					[^self putLoadLocal: numArgs + finalNumTemps + copiedIndex - 1 argument: true scope: nesting].			scope < usesOuter ifTrue: [usesOuter _ scope].			scope = (nesting - 1)				ifTrue: [code nextPut: OpLoadReceiverNextOuter]				ifFalse:					[code nextPut: OpLoadReceiverOuter						with: nesting - scope].			canCopy				ifTrue:					[self addUse: -1 argument: true scope: scope]].	self push!putStoreInst: index scope: scope	scope = nesting		ifTrue:			[self putStorePopInst: index scope: scope;				putLoadInst: index scope: scope]		ifFalse:			[self putLoadReceiver: scope;				putStoreInstAny: index.			forContext == nil ifTrue: [self setContextFlag]]!putStoreInstAny: index	code nextPut: OpStoreInstAny with: index.	self pop: 1!putStoreLocal: index scope: scope	self putStorePopLocal: index scope: scope;		putLoadLocal: index argument: false scope: scope!putStorePopInst: index scope: scope	scope = nesting		ifTrue:			[self putIndex: index short: OpStorePopInst max: MaxStorePopInst long: OpXStorePopInst.			self pop: 1]		ifFalse:			[self putLoadReceiver: scope;				putStoreInstAny: index;				pop].	forContext == nil ifTrue: [self setContextFlag]!putStorePopLocal: index scope: scope	self putIndex: index scope: scope short: OpStorePopTemp max: MaxStorePopTemp long: OpXStorePopTemp		outer: OpStorePopTempOuter long: OpXStorePopTempOuter noCopy: true.	self noteStore: index scope: scope local: true.	self pop: 1!storePopStatic: binding	code nextPut: OpXStorePopStatic		with: (self literalIndex: binding).	self pop: 1!storeStatic: binding	self storePopStatic: binding;		pushStatic: binding! !!CodeStream methodsFor: 'code generation-miscellaneous'!codeBlock: block	"This is handled differently from all other bytecodes,	because it involves creating a new CodeStream."	| inner outer innerUsed blockMethod copyingInner copyStart blockLitIndex copyEnd defb |	inner _ self newBlockScope.	inner outerStream: self finalNumTemps: nil.  "don't know numTemps yet"	deferredBlocks == nil		ifTrue:			["Create the deferred blocks collection now,			since we have to share it with the inner scope.			Note that this can only happen in the outermost			(method) scope."			deferredBlocks _ OrderedCollection new].	innerBlocks == nil ifTrue: [innerBlocks _ OrderedCollection new].	inner deferredBlocks: deferredBlocks.	block initScope: inner.	block emitBody: inner.	inner leaveScope.	outer _ inner usesOuter.	outer > nesting		ifTrue:			["No references to this scope			or any outer one.  Make a clean block.			Since there are no references to outer scopes,			make the block at compile time."			blockMethod _ inner makeLocalBlockMethod.			self pushConstant: (BlockClosure newCleanMethod: blockMethod).			innerBlocks addLast: blockMethod.			^self].	outer < usesOuter ifTrue: [usesOuter _ outer].	inner canCopy		ifTrue:			["Recompile the block with the copied values."			innerUsed _ inner usedVars.			copyingInner _ self newBlockScope.			copyingInner outerStream: self finalNumTemps: inner numTemps.			block initScope: copyingInner.			copyingInner bindCopied: innerUsed.			block emitBody: copyingInner.			copyingInner leaveScope.			"Push the values that will be copied."			copyStart _ code position.			innerUsed do:				[:var |  "array of (scope index)"				(var at: 2) < 0					ifTrue: [self putLoadReceiver: (var at: 1)]					ifFalse: [self putLoadLocal: (var at: 2) argument: true scope: (var at: 1)]].			"Emit code to create the closure."			blockMethod _ copyingInner makeLocalBlockMethod.			blockLitIndex _ self newLiteralIndex: blockMethod.			code nextPut: OpCopyingBlock				with: blockLitIndex				with: innerUsed size.			self pop: innerUsed size.			copyEnd _ code position.			"If the block used any temps, we can't tell			whether it can actually be a copying block			until we finish compiling the outermost scope			that binds any temp used by the block.			In this case, we also keep the code for the			full block, and substitute it later if needed."			inner usedTemps isNil				ifFalse:					[inner makeMethodOfClass: CompiledBlock local: false.					outer < nesting ifTrue:  "propagate need for outer scope"						["In principle, this scope could still be a copying block,						but it's too hard to keep track of which variables are used."						canCopy _ false].					"Record everything we need to make the decision later."					defb _ DeferredBlock new.					defb outer: self literalIndex: blockLitIndex						copying: copyingInner full: inner						storeCounts: (inner usedTemps collect:							[:var |  "var is Array with: scope with: index"							Association								key: var								value: (self findStore: (var at: 2) scope: (var at: 1))])						start: (self newLabel definition: copyStart)						end: (self newLabel definition: copyEnd).					deferredBlocks addLast: defb.					"We don't have to set hybrid, because the flag is only					an optimization hint anyway."					needsFrame _ true.					"Merge the temps into our own temp list."					canCopy						ifTrue:							[inner usedTemps do:								[:var |								(var at: 1) < nesting ifTrue:									[self addUse: (var at: 2) argument: false scope: (var at: 1)]]]]]		ifFalse:			[blockMethod _ inner makeMethodOfClass: CompiledBlock local: false.			code nextPut: OpFullBlock with: (self newLiteralIndex: blockMethod).			outer < nesting ifTrue:  "propagate need for outer scope"				["In principle, this scope could still be a copying block,				but it's too hard to keep track of which variables are used."				canCopy _ false].			needsFrame _ hybrid _ true].	"Remember the block method so we can fix up its last literal."	innerBlocks addLast: blockMethod.	self push!dupFirst	code nextPut: OpDupFirst.	self push!dupLast	code nextPut: OpNoDup!dupNext	code nextPut: OpDupNext!pop	code nextPut: OpPop.	self pop: 1!putPrimitive: n	n notNil ifTrue:		[code nextPut: OpPrimitive			with: (n bitShift: -8)			with: (n bitAnd: 255).		code nextPut: OpPrimReturn]! !!CodeStream methodsFor: 'code generation-jumps'!define: label	self		define: label		test:			[:op :disp |			op = OpLongBranchFalse				ifTrue: [disp between: MinShortBranchFalse and: MaxShortBranchFalse]				ifFalse:					[op = (OpLongJump + 4)						ifTrue: [disp between: MinShortJump and: MaxShortJump]						ifFalse: [false]]]		long: OpLongJump		shorten: [:op | op = (OpLongJump + 4) ifTrue: [OpShortJump] ifFalse: [OpShortBranchFalse]]!loopHead	code nextPut: OpLoopHead!putBranch: label	reachable ifTrue:  "don't bother with branch-around after a return"		[self branch: label with: OpLongJump + 4.		reachable _ false]!putBranchBack: label	label reference: code position opcode: OpLongJump + 4.	self putLongBranch: OpLongJump + 4 to: label definition.	needsFrame _ true.  "need a frame for process switch"	reachable _ false!putBranchTo: label if: bool	self pop: 1.	self branch: label with: (bool ifTrue: [OpLongBranchTrue] ifFalse: [OpLongBranchFalse]).	needsFrame _ true  "in case of notBoolean error"! !!CodeStream methodsFor: 'code generation-sends and returns'!putLocalReturn	"Do peephole optimization for return	self, nil, true, false."	| op |	reachable _ false.	op _ code lastCode.	(op >= OpLoadReceiver and: [op <= OpLoadFalse and: [op ~= OpPopLoadReceiver "confuses source map"]])		ifTrue:  "optimize"			[self noteScrunch: 1 at: code position - 1.  "fix up source map"			code lastPut: op - OpLoadReceiver + OpReturnReceiver.			^op ~= OpLoadReceiver]		ifFalse:			[code nextPut: OpReturn.			^true]!putMethodReturn	nesting = 0		ifTrue: [self putLocalReturn ifTrue: [returnsNonSelf _ true]]		ifFalse: [code nextPut: OpHomeReturn with: nesting.  returnsNonSelf _ true].	usesOuter _ 0.  "returning from method"	canCopy _ false.	reachable _ false!send: selector numArgs: nargs	| index | 	index _ self selectorIndex: selector allowSpecial: true.	index < 0		ifTrue:  "special send"			[(index = -1 and: [code lastCode = (OpLoadZero + 1)])				ifTrue:  "optimize +1"					[self noteScrunch: 1 at: code position - 1.  "fix up source map"					code lastPut: OpSendAdd1]				ifFalse:					[index + MaxShortSpecialSend < -1						ifTrue:  "extended special send"							[code nextPut: OpXSpecialSend with: -1 - index]						ifFalse: [code nextPut: OpSpecialSend - index - 1]]]		ifFalse:			[(nargs <= MaxSendNumArgs and: [index <= (MaxSends at: nargs + 1)])				ifTrue:					["Check for short send to self with 0 args"					(nargs = 0 and: [index >= 0 and: [index <= MaxSendSelf0 and: [code lastCode = OpLoadReceiver]]])						ifTrue:							[self noteScrunch: 1 at: code position - 1.  "fix up source map"							code lastPut: OpSendSelf0 + index]						ifFalse: [code nextPut: (OpSends at: nargs + 1) + index]]				ifFalse:					[self putIndex: index count: nargs short: OpXSend long: OpXXSend]].	self pop: nargs.	needsFrame _ true!sendNoCheck: selector numArgs: nargs	| index |	index _ self selectorIndex: selector allowSpecial: true.	index < 0		ifTrue:			[code nextPut: OpXNoCheckSpecialSend with: -1 - index]		ifFalse:			[self				putIndex: index				count: nargs				short: OpXNoCheckSend				long: OpXXNoCheckSend].	self pop: nargs.	needsFrame _ true!sendNonImmediate: selector numArgs: nargs	| index |	index _ self selectorIndex: selector allowSpecial: true.	index < 0		ifTrue:			[code nextPut: OpXNonImmediateSpecialSend with: -1 - index]		ifFalse:			[self				putIndex: index				count: nargs				short: OpXNonImmediateSend				long: OpXXNonImmediateSend].	self pop: nargs.	needsFrame _ true!sendSuper: selector numArgs: nargs	| index |	self pushConstant: class.  "push the class explicitly"	index _ self selectorIndex: selector allowSpecial: false.	self putIndex: index count: nargs short: OpXSuper long: OpXXSuper.	self pop: nargs + 1.  "pop the class also"	needsFrame _ true! !!CodeStream methodsFor: 'private'!addCopiedBinding: cv	"Add a binding to the local scope	that reflects a value copied here."	| scope index |	scope _ cv at: 1.	index _ cv at: 2.	bindings associationsDo:		[:bind |		(bind value isLocalScope: scope index: index)			ifTrue:				[bindings addCopied: bind key.  ^self]]!addUse: index argument: argFlag scope: scope	"Record the use of a potentially copied variable.	This is only called if canCopy is true."	| var |	var _ Array with: scope with: index.	argFlag		ifTrue:			[usedArgs == nil				ifTrue: [usedArgs _ Array with: var]				ifFalse:					[(usedArgs includes: var)						ifFalse:							[usedArgs _ usedArgs copyWith: var]]]		ifFalse:			[usedTemps == nil				ifTrue: [usedTemps _ Array with: var]				ifFalse:					[(usedTemps includes: var)						ifFalse:							[usedTemps _ usedTemps copyWith: var]]]!checkStores: storeList	"Check to make sure that all the variables	for a potential copying block are still valid,	i.e. haven't been stored into subsequently."	storeList do:		[:var |  "var key is (Array with: scope with: index), value is store count"		var value = (self findStore: (var key at: 2) scope: (var key at: 1))			ifFalse: [^false]].	^true!findStore: index scope: scope	"Retrieve the store count for	a given temporary variable."	^scope = nesting		ifTrue:			[tempStores at: index - numArgs + 1]		ifFalse:			[outerStream findStore: index scope: scope]!makeLocalBlockMethod	"Make a local (copying or clean) block method.	Such methods store their mclass explicitly."	self makeMethodOfClass: CompiledLocalBlock local: true.	method mclass: class.	^method!makeMethodOfClass: methodClass local: localFlag	"Make up a completed method.	If there are inner blocks, which need	this method filled in as the outer method,	do that now too.  If localFlag is true,	the method has no access to variables	from outer scopes, so cut the binding chain	if we are saving it."	method _ methodClass		bytes: code contents		literals: literalCollection		numArgs: numArgs		numTemps: numTemps		maxDepth: maxDepth		needsFrame: needsFrame		hybrid: hybrid		forContext: forContext == true.	innerBlocks isNil ifFalse: [innerBlocks do: [:m | m outerMethod: method]].	sourceMap isNil		ifFalse:			["If there are any copied values here,			make entries for them in the bindings."			copiedVars notNil ifTrue:				[copiedVars do: [:cv | self addCopiedBinding: cv]].			localFlag ifTrue: [bindings outerScope: NullScope new  "no outer scopes are accessible"].			allSourceMaps at: method put: (Array with: sourceMap with: bindings)].	deferredBlocks _ nil.  "break circularity"	^method!noteStore: index scope: scope local: localFlag	"We have just generated a store into	a temporary variable.	If it is one of ours, record it, otherwise	pass it on."	| tempx |	scope = nesting		ifTrue:			[tempx _ index - numArgs + 1.			tempStores at: tempx put:				(localFlag					ifTrue: [(tempStores at: tempx) + 1]					ifFalse: [SmallInteger minVal])]		ifFalse:			[outerStream noteStore: index scope: scope local: false]!putIndex: index scope: scope short: op0 max: max long: op1 outer: op2 long: op3 noCopy: noCopy	"Handle all the combinations of lengths	for a load or a store.  Set usesOuter if	the scope is an outer one; if noCopy is	true, also reset canCopy."	scope = nesting		ifTrue:			[self putIndex: index short: op0 max: max long: op1]		ifFalse:			[self putIndex: index count: nesting - scope short: op2 long: op3.			scope < usesOuter ifTrue: [usesOuter _ scope].			noCopy ifTrue: [canCopy _ false]]!saveSourceMap: allMaps	super saveSourceMap.	allSourceMaps _ allMaps  "share with outer scope"!setContextFlag	"We just saw our first reference to	an instance variable.  Check whether	this class might be a sub- or superclass	of Context, which requires special	action at run time."	forContext _ class instSize < Context instSize		ifTrue: [Context inheritsFrom: class]		ifFalse: [class == Context or: [class inheritsFrom: Context]]!specialSelectors	^SpecialSelectorDictionary! !TextView subclass: #CodeView	instanceVariableNames: 'initialSelection '	classVariableNames: ''	poolDictionaries: ''	category: 'Interface-Text'!CodeView comment:'A CodeView is a TextView that assumes the text is code.  It includes support for initial selection of a part of the text.Instance Variables:	initialSelection <nil | String | Text> nil or a message selector that is used to determine the initial text to highlight/select'!!CodeView methodsFor: 'initialize-release'!initialSelection: sel	"Set the initial code selection to be sel."	initialSelection _ sel!newText: aText	super newText: aText.	initialSelection==nil ifFalse: [self controller find: initialSelection]! !!CodeView methodsFor: 'controller access'!defaultControllerClass	^ CodeController! !!CodeView methodsFor: 'updating'!update: aSymbol	| range |	aSymbol == #pc ifTrue:		[range _ model pcRange.		self controller selectAndScrollFrom: range first to: range last].	aSymbol == #breakPC ifTrue: [^model breakPCFrom: controller].	super update: aSymbol! !!CodeView methodsFor: 'control'!isSelected	"Answer true for use with OnlyWhenSelectedCodeController"	^true! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!CodeView class	instanceVariableNames: ''!!CodeView class methodsFor: 'instance creation'!on: anObject aspect: m1 change: m3 menu: m4 initialSelection: sel	"Create an instance viewing anObject.  See super method in TextView for full	explanation.  initialSelection (if not nil) is a string which will be searched for,	and then highlighted if found, whenever the viewed text changes."	^ (super on: anObject aspect: m1 change: m3 menu: m4) initialSelection: sel! !Object subclass: #Collection	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Collections-Abstract'!Collection comment:'The abstract class Collection is at the top of the collection hierarchy.  Its subclasses are Bag, MappedCollection, SequenceableCollection, and Set.  Bag and Set are unordered and their elements are not accessible by an external key.  Duplicates are not allowed in a Set.  Elements of a SequenceableCollection are ordered and the ordering can be determined externally, as in an ArrayedCollection, or internally, as in an Interval.  MappedCollection represents an indirect access path to a collection whose elements are accessible via external keys.Concrete subclasses must implement methods for 	adding		add:	removing		remove: ifAbsent:	enumerating		do:'!!Collection methodsFor: 'accessing'!size	"Answer how many elements the receiver contains."	| tally |	tally _ 0.	self do: [:each | tally _ tally + 1].	^tally! !!Collection methodsFor: 'testing'!includes: anObject 	"Answer whether anObject is one of the receiver's elements."	self do: [:each | anObject = each ifTrue: [^true]].	^false!isEmpty	"Answer whether the receiver contains any elements."	^self size = 0!occurrencesOf: anObject 	"Answer how many of the receiver's elements are equal to anObject."	| tally |	tally _ 0.	self do: [:each | anObject = each ifTrue: [tally _ tally + 1]].	^tally! !!Collection methodsFor: 'copying'!copyEmpty: aSize	"Answer a copy of the receiver that contains no elements.	This method should be redefined in subclasses that add	instance variables, so that the state of those variables	is preserved"	^self species new: aSize! !!Collection methodsFor: 'adding'!add: newObject 	"Include newObject as one of the receiver's elements.  Answer newObject.	This message should not be sent to instances of subclasses of ArrayedCollection."	self subclassResponsibility!addAll: aCollection 	"Include all the elements of aCollection as the receiver's elements.  Answer	aCollection."	aCollection do: [:each | self add: each].	^aCollection! !!Collection methodsFor: 'removing'!remove: oldObject 	"Remove oldObject as one of the receiver's elements.  Answer 	oldObject unless no element is equal to oldObject, in which case, 	provide an error notification. "	^self remove: oldObject ifAbsent: [self notFoundError]!remove: oldObject ifAbsent: anExceptionBlock 	"Remove oldObject as one of the receiver's elements.  If several of the	elements are equal to oldObject, only one is removed. If no element is equal to	oldObject, answer the result of evaluating anExceptionBlock.  Otherwise,	answer the argument, oldObject.	SequenceableCollections can not respond to this message."	self subclassResponsibility!removeAll: aCollection 	"Remove each element of aCollection from the receiver.  If successful for each,	answer aCollection."	aCollection do: [:each | self remove: each].	^aCollection! !!Collection methodsFor: 'enumerating'!collect: aBlock  	"Evaluate aBlock with each of the values of the receiver as the  	argument.  Collect the resulting values into a collection that is like 	the receiver.  Answer the new collection."	| newCollection |	newCollection _ self species new.	self do: [:each | newCollection add: (aBlock value: each)].	^newCollection!detect: aBlock 	"Evaluate aBlock with each of the receiver's elements as the argument.	Answer the first element for which aBlock evaluates to true."	^self detect: aBlock ifNone: [self notFoundError]!detect: aBlock ifNone: exceptionBlock 	"Evaluate aBlock with each of the receiver's elements as the argument.	Answer the first element for which aBlock evaluates to true."	self do: [:each | (aBlock value: each) ifTrue: [^each]].	^exceptionBlock value!do: aBlock 	"Evaluate aBlock with each of the receiver's elements as the argument."	self subclassResponsibility!inject: thisValue into: binaryBlock 	"Accumulate a running value associated with evaluating the argument,	binaryBlock, with the current value and the receiver as block arguments. 	The initial value is the value of the argument, thisValue."	"For example, to sum a collection, use: 		collection inject: 0 into: [:subTotal :next | subTotal + next]."	| nextValue |	nextValue _ thisValue.	self do: [:each | nextValue _ binaryBlock value: nextValue value: each].	^nextValue!reject: aBlock 	"Evaluate aBlock with each of the receiver's elements as the argument. 	Collect into a new collection like the receiver, only those elements for which	aBlock evaluates to false.  Answer the new collection."	^self select: [:element | (aBlock value: element) == false]!select: aBlock 	"Evaluate aBlock with each of the receiver's elements as the argument. 	Collect into a new collection like the receiver, only those elements for which	aBlock evaluates to true.  Answer the new collection."	| newCollection |	newCollection _ self species new.	self do: [:each | (aBlock value: each) ifTrue: [newCollection add: each]].	^newCollection! !!Collection methodsFor: 'printing'!printOn: aStream 	"Append to the argument aStream a sequence of characters 	that identifies the collection.  The general format for collections	is		Collection-name ( element element element )	unless there are a large number in which case the listing is	truncated with the words ...etc..."	| tooMany |	tooMany _ aStream position + self maxPrint.	aStream nextPutAll: self class name, ' ('.	self do: 		[:element | 		aStream position > tooMany ifTrue: [aStream nextPutAll: '...etc...)'. ^self].		element printOn: aStream.		aStream space].	aStream nextPut: $)!storeOn: aStream 	"Append to the argument aStream a sequence of characters that is an expression 	whose evaluation creates an collection similar to the receiver. The general format	for collections is		((class-name new) add: element; add: element; .... ; yourself)"	| noneYet |	aStream nextPutAll: '(('.	aStream nextPutAll: self class name.	aStream nextPutAll: ' new)'.	noneYet _ true.	self do: 		[:each | 		noneYet			ifTrue: [noneYet _ false]			ifFalse: [aStream nextPut: $;].		aStream nextPutAll: ' add: '.		aStream store: each].	noneYet ifFalse: [aStream nextPutAll: '; yourself'].	aStream nextPut: $)! !!Collection methodsFor: 'converting'!asBag	"Answer a new instance of Bag whose elements are the elements of	the receiver."	| aBag |	aBag _ Bag new.	self do: [:each | aBag add: each].	^aBag!asOrderedCollection	"Answer a new instance of OrderedCollection whose elements are the elements of	the receiver.  The order in which elements are added depends on the order in	which the receiver enumerates its elements.  In the case of unordered collections,	the ordering is not necessarily the same for multiple requests for the conversion."	| anOrderedCollection |	anOrderedCollection _ OrderedCollection new: self size.	self do: [:each | anOrderedCollection addLast: each].	^anOrderedCollection!asSet	"Answer a new instance of Set whose elements are the unique elements of	the receiver."	| aSet |	aSet _ Set new: self size.	self do: [:each | aSet add: each].	^aSet!asSortedCollection	"Answer a new instance of SortedCollection whose elements are the elements of	the receiver.  The sort order is the default less than or equal ordering."	| aSortedCollection |	aSortedCollection _ SortedCollection new: self size.	aSortedCollection addAll: self.	^aSortedCollection!asSortedCollection: aBlock 	"Answer a new instance of SortedCollection whose elements are the elements of	the receiver.  The sort order is defined by the argument, aBlock."	| aSortedCollection |	aSortedCollection _ SortedCollection new: self size.	aSortedCollection sortBlock: aBlock.	aSortedCollection addAll: self.	^aSortedCollection! !!Collection methodsFor: 'private'!emptyCheck	"Provide an error notification if the collection is empty."	self isEmpty ifTrue: [^self emptyCollectionError]!emptyCollectionError	"Answer an error notification because the collection is empty."	self error: 'this collection is empty'!growSize	"Answer an amount by which the receiver should grow 	to make room for more elements."	^self basicSize max: 2!maxPrint	"Answer the maximum number of characters to print with printOn:."	^5000!noMatchError	"Answer an error notification because the collection sizes do not match."	self error: 'collection sizes do not match'!notFoundError	"Raise a signal indicating that an object is not in the collection."	Object notFoundSignal raise!notKeyedError	"Answer an error notification because the collection 	does not respond to keyed accessing messages."	self error: self class name, 's do not respond to keyed accessing messages.'! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Collection class	instanceVariableNames: ''!!Collection class methodsFor: 'instance creation'!with: anObject 	"Answer a new instance of a Collection containing anObject."	| newCollection |	newCollection _ self new.	newCollection add: anObject.	^newCollection!with: firstObject with: secondObject 	"Answer a new instance of a Collection containing 	the two arguments as elements."	| newCollection |	newCollection _ self new.	newCollection add: firstObject.	newCollection add: secondObject.	^newCollection!with: firstObject with: secondObject with: thirdObject 	"Answer with a new instance of a Collection containing 	the three arguments as elements."	| newCollection |	newCollection _ self new.	newCollection add: firstObject.	newCollection add: secondObject.	newCollection add: thirdObject.	^newCollection!with: firstObject with: secondObject with: thirdObject with: fourthObject 	"Answer a new instance of a Collection containing the		four arguments as the elements."	| newCollection |	newCollection _ self new.	newCollection add: firstObject.	newCollection add: secondObject.	newCollection add: thirdObject.	newCollection add: fourthObject.	^newCollection! !CompiledCode subclass: #CompiledBlock	instanceVariableNames: 'outerMethod '	classVariableNames: ''	poolDictionaries: ''	category: 'Kernel-Methods'!CompiledBlock comment:'Class CompiledBlock represents the compiled code for a block.Instance Variables:	outerMethod	<CompiledMethod | CompiledBlock>  the code for the enclosing scope'!!CompiledBlock methodsFor: 'initialize-release'!outerMethod: code	"This is only used by the compiler."	outerMethod _ code! !!CompiledBlock methodsFor: 'source code management'!fileIndex	source == nil ifTrue: [^outerMethod fileIndex].	^super fileIndex!filePosition	source == nil ifTrue: [^outerMethod filePosition].	^super filePosition! !!CompiledBlock methodsFor: 'accessing'!homeMethod	"Answer the context in which the receiver was defined."	^outerMethod homeMethod!numCopiedValues	"Answer the number of values of the receiver that were copied."	^(self byteAt: 1) = OpCopyValues		ifTrue: [self byteAt: 2]		ifFalse: [0]!outerMethod	^outerMethod! !!CompiledBlock methodsFor: 'comparing'!= aMethod	outerMethod == aMethod ifFalse: [^false].	^super = aMethod! !!CompiledBlock methodsFor: 'testing'!isBlockMethod	^true! !!CompiledBlock methodsFor: 'private'!methodWithSource	source == nil ifFalse: [^self].	^outerMethod methodWithSource! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!CompiledBlock class	instanceVariableNames: ''!!CompiledBlock class methodsFor: 'instance creation'!bytes: b literals: l numArgs: na numTemps: nt maxDepth: m needsFrame: nf hybrid: hf forContext: cf	"Answer a new instance of the receiver."	^self new		initBytes: b		literals: l		numArgs: na		numTemps: nt		maxDepth: m		needsFrame: nf		inBlock: true		hybrid: hf		forContext: cf! !Object subclass: #CompiledCode	instanceVariableNames: 'bytes misc firstLiteral secondLiteral source '	classVariableNames: 'NormalFrameSize NPCMapErrorSignal SourceInfoCache '	poolDictionaries: 'OpcodePool '	category: 'Kernel-Methods'!CompiledCode comment:'Class CompiledCode is an abstract class that represents compiled code for HPS.  Subclasses represent compiled methods and compiled blocks.Subclasses must implement:	accessing		homeMethod	testing		isBlockMethodCompiledCode has three formats.	Short - bytes and misc are SmallIntegers.		Up to 6 bytes are in bytes[29:6] + misc[29:6],		up to 2 literals are in firstLiteral + secondLiteral;		misc[5] = 1 if this is a block method,		misc[4] = 1 if frame needed,		misc[3:2] = numArgs, misc[1:0] = numTemps.	non-Short - bytes is a ByteArray, misc is an Array.		The first element of bytes is a flag byte.			Normal - flag is < 16r80.				flag[6] = 1 if frame is likely to become hybrid,				flag[5] = 1 if this is a block method,				flag[4] = 1 if frame is needed,				flag[3:2] = numArgs, flag[1:0] = numTemps.				Code starts in bytes[2].			Long - flag is >= 16r80.				flag[6:5] = as for normal format,				flag[4] = 1 if this refers to instance variables of a Context,				flag[3] = 1 if this is an unwind method (BlockClosure>>valueOnUnwindDo:),				flag[2] = 1 if this is a marked exception-handler propagate/handle method,				flag[1:0] are unused;				bytes[2] = numArgs, bytes[3] = numTemps,				bytes[4] = frame size (0 means no frame).				Code starts in bytes[5].Compiled code for methods and blocks are represented by subclasses, CompiledMethod and CompiledBlock, even though there is a flag in the header to indicate this distinction for the benefit of the VM.The source instance variable currently holds an integer, for backward compatibility.  This integer is a file index (index in SourceFiles -1) + a position in that file * 4.  Note that this holds the same information as the old 3-byte method trailer, but encoded differently, and without the limitation of 4 Mb per file.Instance Variables:	bytes	<SmallInteger | ByteArray>	misc	<SmallInteger | Array>	firstLiteral	<Object>	secondLiteral	<Object>	source	<nil | Integer>Class Variables:	NormalFrameSize	<SmallInteger>	NPCMapErrorSignal	<Signal> N-PC not found in map	SourceInfoCache <Association> between a CompiledMethod and a MethodNodeHolderPool Dictionary:	OpcodePool	<Dictionary>'!!CompiledCode methodsFor: 'source code management'!cacheSourceInfo: sourceInfo	"Save a reference to the receiver's current source information."	SourceInfoCache _ Association key: self value: sourceInfo!fileIndex	"Answer 1 if the source code of the receiver is on the *.sources file	and 2 if it is on the *.changes file.  If the receiver has no stored	source code, answer 0.  This is not compatible with old CompiledMethod	protocol."	source == nil ifTrue: [^0].	^source \\ 4 + 1!filePosition	"Answer the position of this method's source code	on its file."	source == nil ifTrue: [self error: 'This method has no stored source'].	^source // 4!getSource	"Answer the source code for the receiver.  Answer nil if there are	no source files specified in the global SourceFiles, or if this method	has no stored source."	SourceFiles == nil ifTrue: [^nil].	self hasSource ifFalse: [^nil].	^Cursor read		showWhile: 			[(RemoteString				newFileNumber: self fileIndex				position: self filePosition) string]!getSourceForUserIfNone: aBlock	"Answer the string corresponding to the source code for the argument.	If source code is not available, answer the result of evaluating aBlock."	| newSource index |	Sensor leftShiftDown ifTrue: [^aBlock value].  "don't use the stored source"	newSource _ self getSource.	newSource == nil ifTrue: [^aBlock value].  "no stored source"	((newSource at: newSource size) isSeparator)		ifTrue:			[index _ newSource size. "tidy up for file out"			[((newSource at: index) isSeparator)				and: [index > 1]]				whileTrue: [index _ index - 1].			newSource _ newSource copyFrom: 1 to: index].	^newSource!hasSource	"Answer whether there is a CompiledMethod that has source for the receiver."	^self methodWithSource notNil!putSource: sourceStr class: class category: catName inFile: fileIndex 	"Print an expression that is a message to the argument, class, asking the	class to accept the source code, sourceStr, as a method in category, catName.	This is part of the format for writing descriptions of methods on files.	If no sources are specified, i.e., SourceFile is nil, then do nothing.	If the fileIndex is 1, print on *.sources;  if it is 2, print on *.changes."	| file remoteString |	SourceFiles == nil ifTrue: [^self].	file _ SourceFiles at: fileIndex.	class printCategoryChunk: catName on: file.	file cr.	remoteString _ 		RemoteString			newString: sourceStr			onFileNumber: fileIndex			toFile: file.	file nextChunkPut: ' '; commit.	self setSourcePosition: remoteString position inFile: fileIndex!putSource: sourceStr inFile: fileIndex 	"Store the source code for the receiver on an external file.	If no sources are specified, i.e., SourceFile is nil, then do nothing.	If the fileIndex is 1, print on *.sources;  if it is 2, print on *.changes."	| file remoteString |	SourceFiles == nil ifTrue: [^self].	file _ SourceFiles at: fileIndex.	file cr; nextPut: $!!; nextChunkPut: 'Behavior method'; cr.	remoteString _ 		RemoteString			newString: sourceStr			onFileNumber: fileIndex			toFile: file.	file nextChunkPut: ' '; commit.	self setSourcePosition: remoteString position inFile: fileIndex!setSourcePosition: position inFile: fileIndex 	"Store the location of the source code for the receiver in the 	receiver. The location consists of which source file (*.sources or 	*.changes) and the position in that file."	(fileIndex between: 1 and: 4)		ifFalse: [^self error: 'invalid file number'].	source _ position * 4 + (fileIndex - 1)!sourceInfoIfCached	"Answer the source of information for the receiver if it was 	previously saved, otherwise answer nil."	SourceInfoCache == nil ifTrue: [^nil].	SourceInfoCache key == self ifTrue: [^SourceInfoCache value].	^nil! !!CompiledCode methodsFor: 'accessing'!endPC	"Answer a pointer to the end of the receiver."	^self bytesSize!fieldsTouched	"Answer a Set of fields touched by this method."	| scanner indexSet index |	indexSet _ Set new.	self withAllBlockMethodsDo:		[:meth |		scanner _ InstructionStream on: meth.		scanner				scanFor: 				[:x | 				((index _ scanner peekForInstVarRead) notNil or:				 [(index _ scanner peekForInstVarWrite) notNil])					ifTrue: [indexSet add: index].				false	"keep scanning"]].	^indexSet!frameSize	"Answer the size of the literal frame for the receiver."	self isShort ifTrue: [^(misc anyMask: 16) ifTrue: [NormalFrameSize] ifFalse: [0]].	self isNormal ifTrue: [^((bytes at: 1) anyMask: 16) ifTrue: [NormalFrameSize] ifFalse: [0]].	^bytes at: 4!homeMethod	"If this is the CompiledMethod for a block, answer the	CompiledMethod for the enclosing method; otherwise	answer this method."	^self subclassResponsibility!initialPC	"Answer the initial pointer into the receiver's code."	^1!mclass	"Answer the class in which this compiled code	was compiled.  If not known, answer nil."	^nil!methodSize	"Answer statistics about the receiver."	^self methodSizeAvoiding: IdentitySet new!numArgs	"Answer the number of arguments required by the receiver."	self isShort ifTrue: [^(misc bitShift: -2) bitAnd: 3].	self isNormal ifTrue: [^((bytes at: 1) bitShift: -2) bitAnd: 3].	^bytes at: 2!numTemps	"Answer the number of locals including both arguments and temps."	^self numArgs + self numTempsOnly!numTempsOnly	"Answer the number of temps exclusive	of arguments.  Unfortunately numTemps	is established as meaning args + temps."	self isShort ifTrue: [^misc bitAnd: 3].	self isNormal ifTrue: [^(bytes at: 1) bitAnd: 3].	^bytes at: 3!withFrame	"Answer a version of this method that	is guaranteed to have a frame."	self frameSize = 0 ifFalse: [^self].	^self shallowCopy forceFrame! !!CompiledCode methodsFor: 'accessing-bytes'!byteAt: index	"Answer the byte at position index."	(bytes isInteger)  "self isShort"		ifTrue:			[index = 1 ifTrue: [^(bytes bitShift: -22) bitAnd: 16rFF].			index = 2 ifTrue: [^(bytes bitShift: -14) bitAnd: 16rFF].			index = 3 ifTrue: [^(bytes bitShift: -6) bitAnd: 16rFF].			index = 4 ifTrue: [^(misc bitShift: -22) bitAnd: 16rFF].			index = 5 ifTrue: [^(misc bitShift: -14) bitAnd: 16rFF].			index = 6 ifTrue: [^(misc bitShift: -6) bitAnd: 16rFF].			^self subscriptBoundsError: index].	index <= 0 ifTrue: [^self subscriptBoundsError: index].	^(bytes at: 1) < 16r80		ifTrue: [bytes at: index + 1]		ifFalse: [bytes at: index + 4]!byteAt: index put: aByte	"Store the argument aByte at position index in the method."	"This is only used at the end of code generation to fix up block creation sequences.	*** CompiledCode MUST BE IMMUTABLE ***	or the execution mechanism will get confused."	self isShort		ifTrue:			[index = 1 ifTrue: [bytes _ (bytes bitAnd: 16r3FC00000) + (aByte bitShift: 22).  ^aByte].			index = 2 ifTrue: [bytes _ (bytes bitAnd: 16r3FC000) + (aByte bitShift: 14).  ^aByte].			index = 3 ifTrue: [bytes _ (bytes bitAnd: 16r3FC0) + (aByte bitShift: 6).  ^aByte].			index = 4 ifTrue: [misc _ (misc bitAnd: 16r3FC00000) + (aByte bitShift: 22).  ^aByte].			index = 5 ifTrue: [misc _ (misc bitAnd: 16r3FC000) + (aByte bitShift: 14).  ^aByte].			index = 6 ifTrue: [misc _ (misc bitAnd: 16r3FC0) + (aByte bitShift: 6).  ^aByte].			^self subscriptBoundsError: index].	index <= 0 ifTrue: [^self subscriptBoundsError: index].	^(bytes at: 1) < 16r80		ifTrue: [bytes at: index + 1 put: aByte]		ifFalse: [bytes at: index + 4 put: aByte]!bytes	"Answer the bytes of this method."	| index shortBytes | 	self isShort		ifTrue:			["Extract the bytes from the header"			index _ 6.			[(self byteAt: index) between: OpNoOp and: OpNoOp + 3] whileTrue: [index _ index - 1].			shortBytes _ ByteArray new: index.			1 to: index do: [:i | shortBytes at: i put: (self byteAt: i)].			^shortBytes].	^bytes copyFrom: (self isLong ifTrue: [5] ifFalse: [2]) to: bytes size!bytesIncludes: aByte	"Answer true if aByte appears anywhere	in the bytes of this method."	bytes isInteger  "self isShort"		ifTrue:			[^((bytes bitShift: -22) bitAnd: 16rFF) = aByte or:			 [((bytes bitShift: -14) bitAnd: 16rFF) = aByte or:			  [((bytes bitShift: -6) bitAnd: 16rFF) = aByte or:			   [((misc bitShift: -22) bitAnd: 16rFF) = aByte or:			    [((misc bitShift: -14) bitAnd: 16rFF) = aByte or:			     [((misc bitShift: -6) bitAnd: 16rFF) = aByte]]]]]]		ifFalse:			[(self isLong ifTrue: [4] ifFalse: [1]) to: bytes size do:				[:i | (bytes at: i) = aByte ifTrue: [^true]].			^false]!bytesSize	"Answer the size of the bytes."	bytes isInteger  "self isShort"		ifTrue:			["Extract the bytes from the header"			| size byte |			size _ 6.			[(byte _ self byteAt: size) >= OpNoOp and:			 [byte <= (OpNoOp + 2)]]				whileTrue: [size _ size - 1].			^size].	^bytes size -		((bytes at: 1) >= 16r80 "self isLong"			ifTrue: [4] ifFalse: [1])! !!CompiledCode methodsFor: 'accessing-literals'!includesLiteral: lit	"Answer whether the method includes the literal lit."	"*** This is not quite right.  It includes system-	generated literals: BlockClosures,	and the superclass for super sends.  ***"	firstLiteral == nil ifTrue: [^false].  "no literals"	firstLiteral == lit ifTrue: [^true].	secondLiteral == nil ifTrue: [^false].  "just one literal"	secondLiteral == lit ifTrue: [^true].	self isShort ifTrue: [^false].  "two literals"	1 to: misc size do: [:i | (misc at: i) == lit ifTrue: [^true]].	^false!literalAt: index	firstLiteral isNil ifTrue: [self error: 'No literals'.  ^nil].	index = 1 ifTrue: [^firstLiteral].	secondLiteral isNil ifTrue: [self error: 'Only one literal'.  ^nil].	index = 2 ifTrue: [^secondLiteral].	self isShort ifTrue: [self error: 'Only two literals'.  ^nil].	^misc at: index - 2!literalAt: index put: lit	"This is only used during code generation	to replace a copying block by a full block,	in case a subsequent store requires it."	firstLiteral isNil ifTrue: [self error: 'No literals'.  ^nil].	index = 1 ifTrue: [^firstLiteral _ lit].	secondLiteral isNil ifTrue: [self error: 'Only one literal'.  ^nil].	index = 2 ifTrue: [^secondLiteral _ lit].	self isShort ifTrue: [self error: 'Only two literals'.  ^nil].	^misc at: index - 2 put: lit!literals	firstLiteral isNil ifTrue: [^#()].  "no literals"	secondLiteral isNil ifTrue: [^Array with: firstLiteral].  "just one literal"	self isShort ifTrue: [^Array with: firstLiteral with: secondLiteral].  "two literals"	^(Array with: firstLiteral with: secondLiteral) , misc!literalsDo: aBlock	firstLiteral == nil ifTrue: [^self].  "no literals"	aBlock value: firstLiteral.	secondLiteral == nil ifTrue: [^self].  "just one literal"	aBlock value: secondLiteral.	self isShort ifTrue: [^self].  "two literals"	misc do: aBlock!messages	"Answer a Set of all the message selectors sent by this method."	| scanner selectorSet selector |	selectorSet _ Set new.	self withAllBlockMethodsDo:		[:meth |		scanner _ InstructionStream on: meth.		scanner				scanFor: 				[:byte | 				selector _ scanner peekForSelector.				selector == nil ifFalse: [selectorSet add: selector].				false	"keep scanning"]].	^selectorSet!numLiterals	firstLiteral isNil ifTrue: [^0].  "no literals"	secondLiteral isNil ifTrue: [^1].  "just one literal"	self isShort ifTrue: [^2].  "two literals"	^2 + misc size! !!CompiledCode methodsFor: 'accessing-PC map'!nFromVPC: intVPC	"Convert a V-PC to an N-PC.  The V-PC is a positiveSmallInteger, an index in the receiver's bytes; the N-PC is anegative SmallInteger, the negative of a machine PC offset within thetranslated code.  Fail if intVPC is not a positive SmallInteger, or isout of range, or if there is no N-PC corresponding to the V-PC."	<primitive: 520>	^self error: 'V-PC not found in map'!nFromVPCnoFail: intVPC	"Convert a V-PC to an N-PC.	Return nil if intVPC is not a positive SmallInteger, or is	out of range, or if there is no N-PC corresponding to the V-PC."	<primitive: 520>	^nil!vFromNPC: intNPC	"Convert an N-PC to a V-PC, the inverse of nFromVPC.Fail if intNPC is not a negative SmallInteger, or is out of range, or ifthere is no V-PC corresponding to the N-PC."	<primitive: 521>	^CompiledCode nPCMapErrorSignal raise! !!CompiledCode methodsFor: 'testing'!isBlockMethod	"Answer whether this is the compiled	code for a block."	^self subclassResponsibility!isLong	^self isShort not and: [(bytes at: 1) >= 16r80]!isMarked	"Answer true if method is marked."	^false!isMarkedForHandle	"Answer true if marked for handle."	^false!isMarkedForPropagate	"Answer true if marked for propagate."	^false!isMarkedForUnwind	"Answer true if marked for unwind."	^false!isNormal	^self isShort not and: [(bytes at: 1) < 16r80]!isQuick	^self frameSize = 0!isShort	^bytes isInteger!needsHybridFrame	self isShort ifTrue: [^false].	^bytes first anyMask: 64!readsField: varIndex 	"Answer whether the receiver loads the instance variable indexed	by the argument."	| scanner |	self withAllBlockMethodsDo:		[:meth |		scanner _ InstructionStream on: meth.		(scanner scanFor: [:byte | scanner peekForInstVarRead = varIndex])			ifTrue: [^true]].	^false!refersToLiteral: aLiteral	"Answer true if this method (or any submethod)	refers to the given literal.  We duplicate the code	of literalsDo: for speed."	firstLiteral == nil ifTrue: [^false].  "no literals"	(firstLiteral refersToLiteral: aLiteral) ifTrue: [^true].	secondLiteral == nil ifTrue: [^false].  "just one literal"	(secondLiteral refersToLiteral: aLiteral) ifTrue: [^true].	self isShort ifTrue: [^false].  "two literals"	1 to: misc size do: [:i | ((misc at: i) refersToLiteral: aLiteral) ifTrue: [^true]].	^false!returnsStaticVariable	"If this method just returns the value of	a static variable, answer the Association,	otherwise answer nil."	^((self byteAt: 1) = OpLoadStatic and:	 [(self byteAt: 2) = OpReturn])		ifTrue: [self literalAt: 1]		ifFalse: [nil]!sendsSpecialSelector: index	"Answer whether the receiver sends	the special selector with the given index."	| scanner index0 |	index0 _ index - 1.	self withAllBlockMethodsDo:		[:meth |		"Make a quick check"		((meth bytesIncludes: index0) or: [index0 <= MaxShortSpecialSend and: [(meth bytesIncludes: OpSpecialSend + index0) or: [index0 = 0 and: [meth bytesIncludes: OpSendAdd1]]]]) ifTrue:			[scanner _ InstructionStream on: meth.			(scanner scanFor: [:byte | scanner peekForSpecialSelector: index0])				ifTrue: [^true]]].	^false!usesContextInstVars	self isLong ifFalse: [^false].	^bytes first anyMask: 16!writesField: varIndex 	"Answer whether the receiver stores into the instance variable indexed	by the argument."	| scanner |	self withAllBlockMethodsDo:		[:meth |		scanner _ InstructionStream on: meth.		(scanner scanFor: [:byte | scanner peekForInstVarWrite = varIndex])			ifTrue: [^true]].	^false! !!CompiledCode methodsFor: 'enumerating'!withAllBlockMethodsDo: aBlock	"Recursively enumerate the collection of methods	(including block methods) that are included in	this method."	| cl |	aBlock value: self.	self literalsDo:		[:lit |		cl _ lit class.		(cl == CompiledBlock or: [cl == CompiledLocalBlock])			ifTrue: [lit withAllBlockMethodsDo: aBlock]			ifFalse:				[cl == BlockClosure					ifTrue: [lit method withAllBlockMethodsDo: aBlock]]]! !!CompiledCode methodsFor: 'comparing'!= aMethod	self == aMethod ifTrue: [^true].	self class = aMethod class ifFalse: [^false].	bytes = aMethod bytesInstVar ifFalse: [^false].	self isShort ifTrue:		[misc = aMethod miscInstVar ifFalse: [^false]].	self numLiterals = aMethod numLiterals ifFalse: [^false].	1 to: self numLiterals do:		[:litIndex | | lit |		((lit _ self literalAt: litIndex) class == Association				ifTrue:	[lit == (aMethod literalAt: litIndex)]				ifFalse:	[lit = (aMethod literalAt: litIndex)])			ifFalse:	[^false]].	^true!hash	^bytes hash bitXor: misc hash! !!CompiledCode methodsFor: 'printing'!printSymbolicOn: aStream	"Print a symbolic representation of my contents	on aStream." 	aStream nextPutAll:		(self isShort ifTrue: ['short'] ifFalse: [self isLong ifTrue: ['long'] ifFalse: ['normal']]).	aStream space.	self class printOn: aStream.	aStream nextPutAll: ' numArgs='; print: self numArgs.	aStream nextPutAll: ' numTemps='; print: self numTempsOnly.	aStream nextPutAll: ' frameSize='; print: self frameSize.	aStream cr; cr.	aStream nextPutAll: 'literals: ('.	self literalsDo: [:lit |		(lit isMemberOf: Association)			ifTrue: [aStream nextPut: ${; nextPutAll: lit key; nextPut: $}]			ifFalse: [lit printOn: aStream].		aStream space].	aStream nextPut: $).	aStream cr; cr.	(InstructionPrinter on: self) printInstructionsOn: aStream!symbolic	"Answer a symbolic representation of my contents	as a String."	| aStream |	aStream _ (String new: 400) writeStream.	self printSymbolicOn: aStream.	^aStream contents!who 	"Answer an Array of the class in which the receiver is defined and	the selector to which it corresponds."	| sel |	Smalltalk allBehaviorsDo:		[:class |		sel _ class selectorAtMethod: self ifAbsent: [nil].		sel notNil ifTrue: [^Array with: class with: sel]]! !!CompiledCode methodsFor: 'fileIn/Out'!resolveSource	"Put the source code onto the changes file"	source == nil		ifFalse:	[self putSource: source inFile: 2].!storeBinaryOn: stream 	"Put a binary representation of the receiver into stream."	| codePtr |	codePtr _ source.	[source == nil		ifFalse:	[source _ self getSource].	super storeBinaryOn: stream]		valueNowOrOnUnwindDo: [source _ codePtr]! !!CompiledCode methodsFor: 'private'!bytesInstVar	^bytes!compare: aMethod mapping: dict	"Compare against aMethod.  dict is a correspondence	between block methods in me and block methods in	aMethod's ancestors."	self == aMethod ifTrue: [^true].	self class = aMethod class ifFalse: [^false].	bytes = aMethod bytesInstVar ifFalse: [^false].	self isShort ifTrue:		[misc = aMethod miscInstVar ifFalse: [^false]].	self numLiterals = aMethod numLiterals ifFalse: [^false].	self literals with: aMethod literals do:		[:mine :its |		mine class = its class ifFalse: [^false].		(mine isKindOf: CompiledCode)			ifTrue:				[(dict includesKey: mine)					ifTrue:						[(dict at: mine) == its ifFalse: [^false]]					ifFalse:						[dict at: mine put: its.						(mine compare: its mapping: dict) ifFalse: [^false]]]			ifFalse:				[(mine isMemberOf: BlockClosure)					ifTrue:						[dict at: mine method put: its method.						(mine method compare: its method mapping: dict) ifFalse: [^false]]					ifFalse: [mine = its ifFalse: [^false]]]].	^true!forceFrame	"Force this method to have a frame. 	This is only done after a shallowCopy."	self isShort		ifTrue: 			[misc _ misc bitOr: 16.			^self].	self isNormal		ifTrue: 			[bytes _ bytes copy.			bytes at: 1 put: ((bytes at: 1) bitOr: 16).			^self].	"self isLong"	bytes _ bytes copy.	bytes at: 4 put: (self numTemps + 1 max: NormalFrameSize).	^self!forceLong	"Force this method to be in long format.	This is only done before the method	is ever executed."	| tempBytes |	self isLong ifTrue: [^self].	" Now we know self isShort or self isNormal. "	tempBytes _ (ByteArray			with: 16r80 + (self needsHybridFrame ifTrue: [16r40] ifFalse: [0]) +				(self isBlockMethod ifTrue: [16r20] ifFalse: [0])			with: self numArgs			with: self numTempsOnly			with: self frameSize) ,		self bytes.	self isShort ifTrue: [misc _ #()].  "no extra literals"	bytes _ tempBytes!methodSizeAvoiding: mset	"Accumulate statistics"	| objs space bsize lsize lms |	(mset includes: self)		ifTrue:  "avoid visiting method twice"			[^#(0 0 0 0)].	mset add: self.	objs _ 1.	space _ self class instSize * 4.	self isShort		ifTrue: [lsize _ bsize _ 0]		ifFalse:			[(lsize _ misc size * 4) = 0 ifFalse:  "all empty literal arrays are shared"				[objs _ objs + 1].			objs _ objs + 1.  bsize _ bytes size].	"Account for block methods"	self literalsDo:		[:lit |		lms _ nil.		(lit isMemberOf: self class)			ifTrue: [lms _ lit methodSizeAvoiding: mset]			ifFalse:				[(lit isMemberOf: BlockClosure)					ifTrue:						[objs _ objs + 1.						space _ space + lit class instSize * 4.						lms _ lit method methodSizeAvoiding: mset]].		lms isNil ifFalse:			[objs _ objs + lms first.			space _ space + (lms at: 2).			lsize _ lsize + (lms at: 3).			bsize _ bsize + (lms at: 4)]].	^Array with: objs with: space with: lsize with: bsize!methodWithSource	"Answer the CompiledMethod (this one, or,	if a block, an outer one) which supplies the	source code for this method.  If none,	answer nil."	source notNil ifTrue: [^self].	^nil!miscInstVar	^misc!shortBytes: b flags: flags	"The bytes are short enough that they	fit in a short method.  Repack them into	the two header words."	| copy |	copy _ ByteArray new: 6 withAll: OpNoOp.	copy replaceFrom: 1 to: b size with: b.	bytes _ ((((self signExtend: (copy at: 1)) bitShift: 8) + (copy at: 2) bitShift: 8) + (copy at: 3) bitShift: 6).	misc _ ((((self signExtend: (copy at: 4)) bitShift: 8) + (copy at: 5) bitShift: 8) + (copy at: 6) bitShift: 6) + flags.	^true!signExtend: byte	^byte >= 16r80 ifTrue: [byte - 16r100] ifFalse: [byte]! !!CompiledCode methodsFor: 'private-initialize-release'!initBytes: b literals: l numArgs: na numTemps: nt maxDepth: m needsFrame: nf inBlock: bf hybrid: hf forContext: cf	| lsize flags |	lsize _ l size.	lsize = 0		ifTrue:			[firstLiteral _ secondLiteral _ nil.  misc _ #()]		ifFalse:			[firstLiteral _ l first.			lsize = 1				ifTrue:					[secondLiteral _ nil.  misc _ #()]				ifFalse:					[secondLiteral _ l at: 2.					misc _ lsize <= 2 ifTrue: [#()] ifFalse: [l asArray copyFrom: 3 to: l size]]].	"Check for long format required"	flags _ (hf ifTrue: [64] ifFalse: [0]) + (bf ifTrue: [32] ifFalse: [0]).	(na > 3 or: [nt > 3 or: [m > NormalFrameSize or: [cf]]])		ifTrue:			[cf ifTrue: [flags _ flags + 16].			bytes _ (ByteArray with: 16r80 + flags with: na with: nt with: m) , b.			^self].	"Check if short format is possible"	flags _ flags + (nf ifTrue: [16] ifFalse: [0]) + (na bitShift: 2) + nt.	(flags < 64 and: [b size <= 6 and: [lsize <= 2]])		ifTrue:			[self shortBytes: b flags: flags.			^self].	"Use normal format"	bytes _ (ByteArray with: flags) , b.	^self! !!CompiledCode methodsFor: 'backward compatibility'!at: byteIndex	^self byteAt: byteIndex!scanFor: specialByte	^false! !!CompiledCode methodsFor: 'copying'!deepCopy	"Answer a copy of the receiver with its own copy of each instance 	variable. This doesn't make sense for CompiledCode."	^self deepCopyError! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!CompiledCode class	instanceVariableNames: ''!!CompiledCode class methodsFor: 'class initialization'!initialize	"CompiledCode initialize"	| es |	NormalFrameSize _ 12.	es _ Object errorSignal.	NPCMapErrorSignal _ es newSignal 		notifierString: 'N-PC not found in map';		nameClass: self message: #nPCMapErrorSignal.! !!CompiledCode class methodsFor: 'statistics'!methodsForClass: cl selector: sym	| meth |	meth _ Compiler compileClass: cl selector: sym.	^meth isNil		ifTrue: [#()]		ifFalse: [meth withAllBlockMethods]! !!CompiledCode class methodsFor: 'signal access'!nPCMapErrorSignal	^NPCMapErrorSignal! !!CompiledCode class methodsFor: 'fileIn/Out'!readBinaryFrom: stream tag: tag	"Answer object appearing next in stream."	| newObject |	newObject _ super readBinaryFrom: stream tag: tag.	newObject resolveSource.	^newObject! !CompiledCode initialize!CompiledBlock subclass: #CompiledLocalBlock	instanceVariableNames: 'mclass '	classVariableNames: ''	poolDictionaries: ''	category: 'Kernel-Methods'!CompiledLocalBlock comment:'Class CompiledLocalBlock represents the compiled code for a block that doesn''t reference its home, i.e. a copying or clean block.  Local blocks must store their mclass explicitly, since otherwise the debugger has no way to find the mclass for the purpose of recompiling the block to obtain the source map.Instance Variables:	mclass	<Behavior>  the class in which the code was compiled'!!CompiledLocalBlock methodsFor: 'private-initialize-release'!mclass: aBehavior	"This is only used by the compiler."	mclass _ aBehavior! !!CompiledLocalBlock methodsFor: 'accessing'!mclass	^mclass! !CompiledCode subclass: #CompiledMethod	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Kernel-Methods'!CompiledMethod comment:'Class CompiledMethod represents the compiled code for a method.'!!CompiledMethod methodsFor: 'accessing'!homeMethod	^self!primitiveNumber	"Return the primitive number in the	head of this method, or nil if none."	^(self byteAt: 1) = OpPrimitive		ifTrue: [(self byteAt: 2) * 256 + (self byteAt: 3)]		ifFalse: [nil]!withAllBlockMethods	"Answer an ordered collection including this method	and all related block methods."	| result |	result _ OrderedCollection new.	self withAllBlockMethodsDo: [:meth | result addLast: meth].	^result!withPrimitiveNumber: anInteger	"This method must already invoke a primitive.	Return a copy of it with the primitive number	changed.  This is only used by the simulator."	self primitiveNumber isNil		ifTrue:			[self error: 'This method has no primitive'.			^self].	(anInteger isInteger and: [anInteger noMask: 16r-10000])		ifFalse:			[self error: 'Invalid primitive number'.			^self].	^self shallowCopy forcePrimitiveNumber: anInteger! !!CompiledMethod methodsFor: 'testing'!isBlockMethod	^false! !!CompiledMethod methodsFor: 'copying'!asHandlerMethod	"Answer a copy of me as a handler method."	^MarkedMethod asHandlerFrom: self!asPropagateMethod	"Answer a copy of me as a propagate method."	^MarkedMethod asPropagateFrom: self!asUnwindMethod	"Answer a copy of me as a unwind method."	^MarkedMethod asUnwindFrom: self! !!CompiledMethod methodsFor: 'private'!forcePrimitiveNumber: anInteger 	"This is only called after a shallowCopy. 	anInteger has been checked already."	self isShort		ifTrue: [bytes _ (bytes bitAnd: 16r3FFFC0 bitInvert) + (anInteger bitShift: 6)]		ifFalse: 			[| byte0 newBytes |			byte0 _ self isLong ifTrue: [4] ifFalse: [1].			newBytes _ bytes copy.			"Byte 1 is the 'primitive' op-code"			newBytes at: byte0 + 2 put: (anInteger bitShift: -8).			newBytes at: byte0 + 3 put: (anInteger bitAnd: 255).			bytes _ newBytes]! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!CompiledMethod class	instanceVariableNames: ''!!CompiledMethod class methodsFor: 'instance creation'!bytes: b literals: l numArgs: na numTemps: nt maxDepth: m needsFrame: nf hybrid: hf forContext: cf	^self new		initBytes: b		literals: l		numArgs: na		numTemps: nt		maxDepth: m		needsFrame: nf		inBlock: false		hybrid: hf		forContext: cf! !SmalltalkCompiler subclass: #Compiler	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'System-Compiler-Public Access'!Compiler comment:'The class Compiler is a subclass of the SmalltalkCompiler that supports HPS (virtual machine) code generation.'!!Compiler methodsFor: 'private'!newCodeStream	"Return an appropriate code stream"	^CodeStream new!newMethodHolder	"Return an appropriate method holder"	^MethodNodeHolder new! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Compiler class	instanceVariableNames: ''!!Compiler class methodsFor: 'simulating'!simulate: expr	Context initialize.  "flush cache"	^self simulateAgain: expr!simulateAgain: expr	"Simulate the evaluation of expr,	without flushing the cache"	| method ctx root dummy |	method _ Compiler compileClass: Object selector: #doIt source: 'doIt ^(', expr, ')'.	dummy _ CompiledMethod bytes: #() literals: #() numArgs: 0 numTemps: 0 maxDepth: 1 needsFrame: true hybrid: false forContext: false.	root _ MethodContext sender: nil receiver: nil method: dummy arguments: #().	ctx _ MethodContext sender: root receiver: nil method: method arguments: #().	[ctx _ ctx interpretNextInstructionFor: ctx.	ctx == root]		whileFalse: [].	^ctx top! !!Compiler class methodsFor: 'public access'!compileClass: c selector: s source: source	| methodNode |	methodNode _ self parse: source class: c.	methodNode isNil ifTrue: [^nil].	^self		generate1: methodNode		scope: (NameScope forClass: c)		class: c		selector: s		log: nil		ifError: [^nil]		codeStreamClass: CodeStream! !Object subclass: #CompilerErrorHandler	instanceVariableNames: 'failBlock retryBlock class selector '	classVariableNames: ''	poolDictionaries: ''	category: 'System-Compiler-Support'!CompilerErrorHandler comment:'I am a generic abstract superclass that just defines the protocol for the ''requestor'' that gets passed to the SmalltalkParser and the CodeStream.  Use one of my concrete subclasses for actual error handling.  See my methods error:with:at: and error:with:in:from: for the various error messages I know how to handle.Instance variables:	failBlock	<Block>  "execute this for an unrecoverable error"	retryBlock	<Block with: Integer>  "execute this to retry after a correction,"			"the argument is the change in the size of the text"	class	<Behavior>  "class in which compilation is occurring"	selector	<nil | Symbol>  "selector of method (may be nil if syntax error)"'!!CompilerErrorHandler methodsFor: 'initialize-release'!class: aClass	class _ aClass!failBlock: aBlock	failBlock _ aBlock!retryBlock: aBlock	retryBlock _ aBlock!selector: aSymbol	selector _ aSymbol! !!CompilerErrorHandler methodsFor: 'error handling'!error: type with: message at: sourcePosition	"This message is sent for errors during parsing.	Possible values of type:		#syntax, message = error message		#newSelector, message = selector, sourcePosition is array of (source range,			keyword positions or nil).	Note: this comment is duplicated in all subclasses."	self subclassResponsibility!error: type with: message in: node from: codeStream	"This message is sent for errors during	code generation.  Possible values of type:		#error, message = error message		#warning, message = error message		#readBeforeWritten, message = var name		#neverRead, message = var name, node = assignment		#neverUsed, message = var name		#redeclared, message = var name		#redeclaredBlockArg, message = var name		#undeclared, message = var Association		#undeclaredStore, message = var Association, node = assignment		#noEffect, message = nil, node = statement.	Note: this comment is duplicated in all subclasses."	self subclassResponsibility! !!CompilerErrorHandler methodsFor: 'private'!abort	"Fail after error interaction"	^failBlock value!retryWith: lengthChange	"Retry after error recovery, if possible"	^retryBlock == nil		ifTrue: [failBlock value]		ifFalse: [retryBlock value: lengthChange]! !CharacterScanner subclass: #CompositionScanner	instanceVariableNames: 'spaceX spaceIndex '	classVariableNames: ''	poolDictionaries: 'TextConstants '	category: 'Graphics-Support'!CompositionScanner comment:'Instances of class CompositionScanner hold the state of CharacterScanner in addition to the following required only for composition.  CompositionScanners are used to measure text and determine where line breaks and space padding should occur.Instance Variables:	spaceX<Integer>  Left edge of last space scanned.  When line overflows this value is substracted from the rightMargin to determine how much padding is available for justification, centering, etc.	spaceIndex<Integer>  Character index of last space scanned in line.  Installed as stop in the TextLineInterval for the line being composed.Pool Dictionary:	TextConstants	<Dictionary>	'!!CompositionScanner methodsFor: 'initialize-release'!in: aParagraph	"Initialize the paragraph to be scanned as the argument, aParagraph.  Set the composition frame for the paragraph."	super initializeFromParagraph: aParagraph clippedBy: aParagraph clippingRectangle! !!CompositionScanner methodsFor: 'accessing'!rightX	"Meaningful only when a line has just been composed -- refers to the 	line most recently composed."	"This is a trick to allow for easy resizing of a composition 	rectangle to the width of the maximum line.  Useful only when there 	is only one line in the form or when each line is terminated by a 	carriage return.  Handy for sizing menus and lists."	^spaceX! !!CompositionScanner methodsFor: 'scanning'!composeLine: lineIndex fromCharacterIndex: startIndex inParagraph: aParagraph	"Answer an instance of TextLineInterval that represents the next line in the paragraph."	| runLength done stopCondition |	lastIndex _ startIndex.		"scanning sets last index"	self setStopConditions.		"also sets font"	spaceX _ destX _ leftMargin _		(aParagraph leftMarginForCompositionForLine: lineIndex).	rightMargin _ aParagraph rightMarginForComposition.	leftMargin >= rightMargin ifTrue:		[self error: 'No room between margins to compose'].	runLength _ text runLengthFor: startIndex.	runStopIndex _ (lastIndex _ startIndex) + (runLength - 1).	line _ 		TextLineInterval			start: lastIndex stop: 0 internalSpaces: 0 paddingWidth: 0.	spaceCount _ 0.	done _ false.	[done]		whileFalse: 			[stopCondition _ 				self 					scanCharactersFrom: lastIndex					to: runStopIndex					in: text string					rightX: rightMargin					stopConditions: stopConditions					displaying: false.			"See setStopConditions for stopping conditions for composing."			(self perform: stopCondition) ifTrue: [^line]]! !!CompositionScanner methodsFor: 'stop conditions'!cr	"Answer true.  Sets up values for the text line interval currently being composed."	line stop: lastIndex.	spaceX _ destX.	line paddingWidth: rightMargin - destX.	^true!crossedX	"There is a word that has fallen across the right edge of the 	composition rectangle.  This signals the need for wrapping which 	is done to the last space that was encountered, as recorded by 	the space stop condition."	line stop: spaceIndex.	spaceCount > 1			ifTrue:	["The common case. First back off the space at which we wrap."				spaceCount _ spaceCount - 1.				spaceIndex _ spaceIndex - 1.				["Check to see if any spaces preceding the one at which we wrap.					Double space after a period, most likely."				(spaceCount > 1 and: [(text at: spaceIndex) = Space])]					whileTrue:						[spaceCount _ spaceCount - 1.						spaceIndex _ spaceIndex - 1.						"Account for backing over a run which might							change width of space."						font _ self resetFont.						spaceX _ spaceX - (font widthOf: Space)].						line paddingWidth: rightMargin - spaceX.						line internalSpaces: spaceCount]		ifFalse:	[spaceCount = 1					ifTrue:	["wrap at space, but no internal spaces"							line internalSpaces: 0.							line paddingWidth: rightMargin - spaceX]					ifFalse:	["Neither internal nor trailing spaces, almost never happen,								she says confidently."							lastIndex _ lastIndex - 1.							[destX <= rightMargin]							whileFalse:								[destX _ destX - (font widthOf:													(text at: lastIndex)).										"bug --doesn't account for backing over										 run and changing actual width of										characters. Also doesn't account for										backing over a tab.  Happens only										when no spaces in line, presumably rare."								lastIndex _ lastIndex - 1].							spaceX _ destX.							line paddingWidth: rightMargin - destX.							lastIndex < line first								ifTrue:	[line stop: line first]								ifFalse:	[line stop: lastIndex]]].	^true!endOfRun	"Answer true if scanning has reached the end of the paragraph.  	Otherwise set stop conditions (mostly install potential new font) and answer false."	| runLength |	lastIndex = text size	ifTrue:	[line stop: lastIndex.			spaceX _ destX.			line paddingWidth: rightMargin - destX.			^true]	ifFalse:	[runLength _ (text runLengthFor: (lastIndex _ lastIndex + 1)).			runStopIndex _ lastIndex + (runLength - 1).			self setStopConditions.			^false]!onePixelBackspace	"Decrement destX by 1. "	destX _ (destX - 1) max: leftMargin.	lastIndex _ lastIndex + 1.	^false!onePixelSpace	"Increment destX by 1. "	destX _ destX+1.	lastIndex _ lastIndex + 1.	destX > rightMargin ifTrue: 	[^self crossedX].	^false!setStopConditions	"Set the font and the stop conditions for the current run."	font _ textStyle fontAt: (text emphasisAt: lastIndex).	super setStopConditions.!space	"Note that the left x and character index of the space character just encountered.  	Used for wrap-around.  Answer whether the character has crossed the 	right edge of the composition rectangle of the paragraph."	spaceX _ destX.	destX _ spaceX + spaceWidth.	lastIndex _ (spaceIndex _ lastIndex) + 1.	spaceCount _ spaceCount + 1.	destX > rightMargin ifTrue: 	[^self crossedX].	^false!tab	"Advance destination x according to tab settings in the paragraph's  	textStyle.  Answer whether the character has crossed the right  	edge of the composition rectangle of the paragraph.  Scale allows  	use of same code for display and printing composition."	destX _ textStyle				nextTabXFrom: destX				leftMargin: leftMargin				rightMargin: rightMargin.	destX > rightMargin ifTrue: [^self crossedX].	lastIndex _ lastIndex + 1.	^false! !!CompositionScanner methodsFor: 'private'!resetFont	"Mainly to allow the stop condition crossedX to be shared by display and printer media."	^ textStyle fontAt: (text emphasisAt: spaceIndex)! !ValueNode subclass: #ConditionalNode	instanceVariableNames: 'condition trueBody falseBody '	classVariableNames: ''	poolDictionaries: ''	category: 'System-Compiler-Program Objects'!ConditionalNode comment:'Class ConditionalNode represents an internal node class for representing conditionals (ifTrue:, ifFalse:, ifTrue:ifFalse:, ifFalse:ifTrue:, and:, or:).  Instances of the class are only created temporarily for code generation.Instance Variables:	condition <ValueNode>	trueBody <BlockNode>	falseBody <BlockNode>'!!ConditionalNode methodsFor: 'initialize-release'!condition: c trueBlock: t falseBlock: f	condition _ c.	trueBody _ t body.	falseBody _ f body! !!ConditionalNode methodsFor: 'code generation'!emitBranch: codeStream to: label if: boolean	"This is the and/or optimization.	There is a complicated case analysis according to	the value of boolean and whether the selected	body is a constant."	| constValue constCase otherBody skip |	codeStream mustBeSimple		ifTrue:  "Decompiler can't handle complex branch conditions"			[^super emitBranch: codeStream to: label if: boolean].	constValue _ trueBody booleanValue.	constValue notNil		ifTrue:			[constCase _ true.  otherBody _ falseBody]		ifFalse:			[constValue _ falseBody booleanValue.			constValue notNil				ifTrue:					[constCase _ false.  otherBody _ trueBody]				ifFalse:					["no optimization"					^super emitBranch: codeStream to: label if: boolean]].	condition		emitBranch: codeStream		to: (constValue = boolean			ifTrue: [label]			ifFalse: [skip _ codeStream newLabel])		if: constCase.	otherBody emitBranch: codeStream to: label if: boolean.	skip notNil ifTrue: [codeStream define: skip]!emitEffect: codeStream	"This is complicated because	we want to avoid generating code	for branches that have no effect."	| exit else |	trueBody hasEffect		ifTrue:			[else _ codeStream newLabel.			condition emitBranch: codeStream to: else if: false.			trueBody emitEffect: codeStream.			falseBody hasEffect				ifTrue:					[exit _ codeStream newLabel.					codeStream putBranch: exit.					codeStream define: else.					falseBody emitEffect: codeStream]				ifFalse:					["false body has no effect, no else part"					exit _ else].			codeStream define: exit]		ifFalse:			[falseBody hasEffect				ifTrue:					["true body has no effect, reverse branch, no else part"					exit _ codeStream newLabel.					condition emitBranch: codeStream to: exit if: true.					falseBody emitEffect: codeStream.					codeStream define: exit]				ifFalse:					["neither has effect, just evaluate condition"					condition emitEffect: codeStream]]!emitLocalReturn: codeStream from: bodyNode	"This is separate to avoid generating needless branches."	| else |	else _ codeStream newLabel.	condition emitBranch: codeStream to: else if: false.	trueBody emitLocalReturn: codeStream from: bodyNode.	codeStream define: else.	falseBody emitLocalReturn: codeStream from: bodyNode!emitReturn: codeStream from: returnNode	"This is separate to avoid generating needless branches."	| else |	else _ codeStream newLabel.	condition emitBranch: codeStream to: else if: false.	trueBody emitReturn: codeStream from: returnNode.	codeStream define: else.	falseBody emitReturn: codeStream from: returnNode!emitValue: codeStream	| else exit |	else _ codeStream newLabel.	exit _ codeStream newLabel.	condition emitBranch: codeStream to: else if: false.	trueBody emitValue: codeStream.	codeStream putBranch: exit.	codeStream define: else.	falseBody emitValue: codeStream.	codeStream define: exit! !InstructionStream subclass: #Context	instanceVariableNames: 'sender receiver stackp stack '	classVariableNames: 'CannotResumeSignal CannotReturnSignal CodeSimulationErrorSignal EmergencySignal MethodCache PrimitiveFailedSignal Send TryPrimitiveSelectors '	poolDictionaries: ''	category: 'Kernel-Methods'!Context comment:'Class Context represents an execution context.  The simulation methods return the new context in which to continue simulation.  This is normally the same context,  except after sends and returns.Instance Variables:	sender	<Context>	receiver	<Object>	stackp	<SmallInteger>  amount of stack that is occupied	stack	<Array>  arguments, temporaries, and working stackClass Variables:	MethodCache	<IdentityDictionary>	PrimitiveFailedSignal	<Signal> A simulated primitive has failed	Send	<Boolean>	TryPrimitiveSelectors <Array of: Symbols>'!!Context methodsFor: 'accessing'!home	"Answer the context in which the receiver was defined.	If this information is not available, answer nil."	^self subclassResponsibility!homeReceiver	"Answer the receiver from the context	in which the receiver was defined."	^self subclassResponsibility!receiver	^receiver!sender	^sender!sourceCode 	"Answer the source form of the receiver's method."	self subclassResponsibility! !!Context methodsFor: 'testing'!hasSender: aContext 	"Answer true if aContext is on the sender chain	of the receiver, i.e. if aContext is the receiver's	sender, or the receiver's sender's sender, etc"	| ctx |	ctx _ self.	[(ctx _ ctx sender) == nil]		whileFalse: 			[ctx == aContext ifTrue: [^true]].	^false!isBlockContext	"Answer true if this is a block context.	By default, contexts are not block contexts."	^false! !!Context methodsFor: 'control'!restart	"Reinitialize the receiver so that it is in the state it was at its creation."	super reset.	stackp _ method numTemps!restartWith: aCompiledMethod 	"Reinitialize the receiver as though it had been for a different method.  Used	by a Debugger when one of the methods to which it refers is recompiled."	method _ aCompiledMethod.	^self restart!resume	"Continue execution of the receiver."	self resumeWith: nil!resumeWith: result	"Continue execution of the receiver as if it had called a method which	returned result. Intervening contexts are cut-back, like an ^-return;	but no unwinds are run."	thisContext terminateTo: self.	^result!terminate	"Make the receiver unresumable."	sender _ nil.	pc _ method endPC + 1!terminateTo: newSender	"Terminate all contexts between the receiver's sender and	newSender (if they are on the same call-chain), and change	the sender of the receiver to newSender.  Do not run	unwinds.  Return receiver; fail if newSender is not a Context."	"Conceptual implementation:		| ctx |		ctx _ sender.		[(nil == ctx) or: [(newSender == ctx)]]			whileFalse: [ctx _ ctx sender].		nil == ctx ifFalse: [			ctx _ sender.			[newSender == ctx] whileFalse:				[| sndr |				sndr _ ctx sender.				ctx terminate.				ctx _ sndr]].		sender _ newSender"	<primitive: 809>	^self primitiveFailed!unwindUpTo: aContext	"Excecute unwind blocks to aContext."	| ctx |	ctx _ self.	[(ctx _ ctx findNextUnwindUpTo: aContext) == nil] whileFalse:		[(ctx localAt: 1) value]! !!Context methodsFor: 'hander search'!findNextMarkedUpTo: aContext	"Answer the next context above the receiver which has a	marked method.  Stop the search at aContext.  Return nil	if no context found.  Fails if aContext is not a kind of	Context or nil."	"Conceptual implementation:	| ctx |	(aContext == nil or: [aContext isKindOf: Context]) ifFalse: [^self primitiveFailed].	ctx _ self.	[(ctx _ ctx sender) == nil or: [ctx == aContext]] whileFalse:		[ctx method isMarked ifTrue: [^ctx]].	^nil"	<primitive: 808>	^self primitiveFailed!findNextUnwindUpTo: aContext	"Return the next unwind context above the receiver, returning	nil if there is none.  Search proceeds up to aContext."	| ctx |	ctx _ self.	[(ctx _ ctx findNextMarkedUpTo: aContext) == nil] whileFalse:		[ctx method isMarkedForUnwind ifTrue: [^ctx]].	^nil! !!Context methodsFor: 'printing'!printOn: aStream 	| mclass selector class |	selector _ 		(class _ self receiver class) 			selectorAtMethod: method			setClass: [:mc | mclass _ mc].	selector == #?		ifTrue: 			[aStream nextPut: $?; print: method who.			^self].	aStream nextPutAll: class name.	mclass == class 		ifFalse: 			[aStream nextPut: $(.			aStream nextPutAll: mclass name.			aStream nextPut: $)].	aStream nextPutAll: '>>'.	aStream nextPutAll: selector! !!Context methodsFor: 'error handling'!cannotResume	"Raise a signal which means that the reciever was resumed (e.g. 	returned into), but is not prepared for execution (e.g. was already 	returned from). This message is sent by the execution machinery 	(the VM or some execution simulator such as a debugger)."	Context cannotResumeSignal raise!cannotReturn: value 	"Raise a signal which means that the reciever attempted to return 	(with the supplied value), but its sender cannot be returned into 	(e.g. sender is nil, probably because the receiver already returned). 	This message is sent by the execution machinery (the VM or some	execution simulator such as a debugger)."	Context cannotReturnSignal raiseWith: value! !!Context methodsFor: 'accessing-debugger'!findTemp: index do: aBlock 	"index is a linear index that includes all enclosing scopes,	starting with the method scope, and that does not count	compiler-generated temporary variables.  Evaluate aBlock with	the actual context and index where the variable is stored."	self		findTemp: index		do: [:ctx :i | ^aBlock value: ctx value: i]		elseDo: [:excess | self error: 'Index is out of range']!localScope	"Answer a LocalScope containing the argument	and temporary names for this context.	Note that this includes compiler-generated	temporary variables."	self sourceInfo: [:methodHolder :index | 			^methodHolder variableMap at: index]!resizedWith: aNewMethod	"Answer a context resized" 	| nargs args |	nargs _ method numArgs.	args _ Array new: nargs.	1 to: nargs do: [:i | args at: i put: (stack at: i)].	^self class		sender: sender		receiver: receiver		method: aNewMethod		arguments: args.!sender: aContext	sender _ aContext!sendersTo: aContext	"Answer an OrderedCollection of the sender chain	starting at this context and continuing up to,	but not including, aContext."	| contexts ctxt |	contexts _ OrderedCollection new. 	ctxt _ self.	contexts addLast: ctxt.	[(ctxt _ ctxt sender) == aContext] whileFalse: 		[contexts addLast: ctxt].	^contexts!size	^stack size!sourceInfo: aBlock	"Invoke aBlock with the methodNodeHolder and the index."	| homeMethod methodHolder index |	homeMethod _ method homeMethod.	methodHolder _ homeMethod sourceInfoIfCached. 	methodHolder == nil ifTrue:		[methodHolder _ self mclass compilerClass new			parse: self sourceCode			in: self mclass			notifying: nil.		homeMethod cacheSourceInfo: methodHolder].	index _ homeMethod withAllBlockMethods identityIndexOf: method.	^aBlock value: methodHolder value: index!sourceMap	"Answer a sourceMap for PC selection in the current code."		self sourceInfo: [:methodHolder :index | 			^(methodHolder sourceMap at: index) asSortedCollection]!tempAt: index	"Answer the argument or temporary value at the given index.	The index is a linear index that includes all enclosing scopes,	starting with the method scope, and does not include	compiler-generated temporary variables."	^self findTemp: index do: [:ctx :i | ctx privateTempAt: i]!tempAt: index put: value	"Change the temporary value at the given index.	The index is a linear index that includes all enclosing scopes,	starting with the method scope, and does not include	compiler-generated temporary variables."	^self findTemp: index do: [:ctx :i | ctx privateTempAt: i put: value]!tempNames	"Answer an OrderedCollection of the name strings of the temporary 	variables for this context and all its enclosing scopes. Note that this 	does not include compiler-generated temporary variables."	^self localScope tempNames select: [:name | name first ~= $.]! !!Context methodsFor: 'simulation-primitive support'!doPrimitive: primitiveIndex receiver: rcvr numArgs: numArgs	"Simulate a primitive method whose index is primitiveIndex.  The	simulated receiver and argument count are given as arguments to this message.	The arguments are the top elements of the stack."	| args primitiveSelector value |	numArgs > 4 ifTrue: [^nil].  "currently fails text primitive"	primitiveSelector _ TryPrimitiveSelectors at: numArgs + 1.	Object addSelector: primitiveSelector		withMethod: ((Object compiledMethodAt: primitiveSelector) withPrimitiveNumber: primitiveIndex).	args _ (1 to: numArgs) collect: [:i | self localAt: stackp - numArgs + i].	^self class primitiveFailedSignal		handle: [:ex | ex returnWith: nil]		do: [value _ rcvr perform: primitiveSelector withArguments: args.			stackp _ stackp - numArgs.			self localAt: stackp put: value.			self]!result0: value	"Store the value of a 0-argument primitive"	self localAt: stackp put: value!result1: value	"Store the value of a 1-argument primitive"	stackp _ stackp - 1.	self localAt: stackp put: value!skipPrimitive	"Skip over a primitive which has	already been tried, and failed."	pc _ pc + 3.	(method byteAt: pc) = OpPrimReturn		ifTrue:  "primitive might possibly build a frame"			[pc _ pc + 1]!tryPrimitive: index receiver: rcvr numArgs: numArgs	"Return new context if successful, nil if failed"	index <= 255 ifTrue: [^self tryOldPrim: index receiver: rcvr arg: self top numArgs: numArgs].	^self tryNewPrim: index receiver: rcvr arg: self top numArgs: numArgs! !!Context methodsFor: 'simulation-primitives'!primBlockValue: closure arguments: args	(args isMemberOf: Array) ifFalse: [self error: 'Block arguments list must be an Array'.  ^nil].	closure method numArgs = args size ifFalse: [self error: 'Block called with wrong numArgs'.  ^nil].	stackp _ stackp - 2.  "pop closure and args"	^BlockContext		sender: self		receiver: closure		method: closure method		arguments: args!primBlockValue: closure numArgs: numArgs	closure method numArgs = numArgs ifFalse: [self error: 'Block called with wrong numArgs'.  ^nil].	^self runMethod: closure method numArgs: numArgs contextClass: BlockContext!primFlushVMmethodCache: r	MethodCache _ IdentityDictionary new.	Behavior flushVMmethodCache!primFlushVMmethodCacheEntries: r	"Don't bother to be selective."	self primFlushVMmethodCache: r.	^self result1: r!primPerform: rcvr selector: selector arguments: args	| rclass nargs |	(args isMemberOf: Array) ifFalse: [^nil].	nargs _ args size.	stackp - 2 + nargs > self localSize ifTrue: [^nil].  "args won't fit"	rclass _ rcvr class.	self findMethod: selector		class: rclass		ifFound:			[:meth :mclass |			"Push the arguments on the stack.			We know they fit -- we just checked."			nargs = meth numArgs ifFalse:				[self error: 'Wrong numArgs for perform'.				"To continue, just return the receiver of the message."				stackp _ stackp - 2.				^self].			stackp _ stackp - 2.			args do: [:a | self push: a].			^self runMethod: meth numArgs: nargs contextClass: MethodContext].	self error: 'Message not found: ', selector printString.	"To continue, just return the receiver of the message."	stackp _ stackp - 2!primPerform: rcvr selector: selector numArgs: numArgs	self findMethod: selector		class: rcvr class		ifFound:			[:meth :mclass |			numArgs = meth numArgs ifFalse:				[self error: 'Wrong numArgs for perform'.				"To continue, just return the receiver of the message."				stackp _ stackp - numArgs - 1.				^self].			"Squeeze the selector out of the stack"			numArgs negated to: -1 do: [:i | self localAt: stackp + i put: (self localAt: stackp + i + 1)].			stackp _ stackp - 1.			^self runMethod: meth numArgs: numArgs contextClass: MethodContext].	self error: 'Message not found: ', selector printString.	"To continue, just return the receiver of the message."	stackp _ stackp - numArgs - 1!primSuspend: r	r == Processor activeProcess		ifTrue: [self error: 'Attempt to suspend active process']		ifFalse: [self result0: r suspend]!primWait: r	| proc flag |	flag _ false.	proc _ [r wait.  flag _ true] newProcess.	proc resume.	Processor yield.  "give proc a chance to run"	flag		ifTrue:			["Semaphore had excess signals, continue"]		ifFalse:			["A real wait would occur"			proc terminate.			self error: 'Semaphore wait would suspend active process']!tryNewPrim: index receiver: r arg: a numArgs: numArgs	"We only simulate enough of the new HPS primitives	to cover those primitives that have unusual effects	on control flow (perform and block evaluation).	The rest we execute directly."	index = 500 ifTrue: ["BlockClosure valueWithArguments:" ^self primBlockValue: r arguments: a].	(index >= 501 and: [index < 510]) ifTrue: ["BlockClosure value:*" ^self primBlockValue: r numArgs: numArgs].	index = 510 ifTrue: ["Object perform:withArguments:" ^self primPerform: r selector: (self localAt: stackp - 1) arguments: a].	(index >= 511 and: [index < 520]) ifTrue: ["Object perform:with:*" ^self primPerform: r selector: (self localAt: stackp - numArgs + 1) numArgs: numArgs - 1].	index = 522 ifTrue: [^self primFlushVMmethodCacheEntries: r].	^self doPrimitive: index receiver: r numArgs: numArgs!tryOldPrim: index receiver: r arg: a numArgs: numArgs	index <= 75 ifTrue: [^self doPrimitive: index receiver: r numArgs: numArgs].	(index between: 80 and: 84) ifTrue: [^nil].  "old blockCopy, value and perform"	index = 86 ifTrue: [^self primWait: r].	index = 88 ifTrue: [^self primSuspend: r].	index = 89 ifTrue: [^self primFlushVMmethodCache: r].	^self doPrimitive: index receiver: r numArgs: numArgs! !!Context methodsFor: 'simulation-control'!callPrimitive: index	" The callPrimitive opcode should not	occur in any method. "	self error: 'Instruction decoding error'!callPrimitive: index numArgs: numArgs	" This code will eventually implement the	callPrimitive opcode.  At this time,	it is never invoked. "	| ctx |	ctx _ self		tryPrimitive: index		receiver: (self localAt: stackp - numArgs)		numArgs: numArgs.	ctx isNil		ifTrue: ["primitive failed" self push: false.  ^self]		ifFalse:			[ctx == self ifFalse: [self error: 'primitive changed contexts'].			self push: true.  ^self]!jump: delta	pc _ pc + delta!jump: delta if: condition	| cond stopPC prev |	cond _ self top.	cond == condition ifTrue: [self pop.  pc _ pc + delta.  ^self].	cond == condition not ifTrue: [self pop.  ^self].	" Non-boolean condition.  Back up the pc	and send the mustBeBoolean message. "	" The only reliable way to back up the pc is	to re-parse the instruction stream	from the front.  This isn't as bad as it sounds. "	stopPC _ pc.	pc _ method initialPC.	[pc = stopPC]		whileFalse:			[prev _ pc.			self next].	pc _ prev.	^self send: #mustBeBoolean numArgs: 0!loopHead!makeCopyingBlock: meth count: count	| block |	block _ BlockClosure			newCopyingMethod: meth			size: count			valuesFrom: [:i | self localAt: stackp - count + i].	stackp _ stackp - count.	self push: block!makeFullBlock: meth	self push: (BlockClosure			newFullMethod: meth			outerContext: self)!methodPrimitive: index	"This should never happen -- runMethod	is supposed to catch this."	self error: 'methodPrimitive called - shouldn''t happen'!noOp!primitiveReturn	^self returnTop!returnTop	^self return: self top!send: selector numArgs: na	| rcvr |	rcvr _ self localAt: stackp - na.	^self		send: selector		receiver: rcvr		class: rcvr class		super: false		numArgs: na!sendNoCheck: selector numArgs: na	^self send: selector numArgs: na!sendNonImmediate: selector numArgs: na	^self send: selector numArgs: na!sendSuper: selector numArgs: na	^self		send: selector		receiver: receiver		class: self top superclass		super: true		numArgs: na! !!Context methodsFor: 'simulation-data movement'!dupFirst	self dup!dupLast	self pop!dupNext	self pop; dup!pop	stackp _ stackp - 1!pushConstant: value	self push: value!pushContext	self push: self!pushInst: index	self push: (receiver instVarAt: index + 1)!pushInstAny: index	| value |	value _ self top instVarAt: index + 1.	self pop; push: value  "don't pop till after access succeeds"!pushLocal: index	self push: (self localAt: index + 1)!pushReceiver	self push: receiver!pushStatic: assoc	self push: assoc value!storeInst: index	receiver instVarAt: index + 1 put: self top!storeInstAny: index	| value |	value _ self localAt: stackp - 1.	self top instVarAt: index + 1 put: value.	self pop  "don't pop till after access succeeds"!storeLocal: index	self localAt: index + 1 put: self top!storeStatic: assoc	assoc value: self top! !!Context methodsFor: 'simulation-debugger'!completeCallee: aContext	"Simulate the execution of bytecodes until a return to the receiver,	or until a return to a non-context in case of block up arrow return."	| ctxt current |	ctxt _ aContext.	current _ nil.	[ctxt == current or: [(ctxt isKindOf: Context) and: [ctxt hasSender: self]]]		whileTrue: 			[current _ ctxt.			ctxt _ ctxt step].	^ctxt!send	| newContext |	Send _ true.	newContext _ self step.	Send _ false.	^newContext!step	"Simulate the execution of the receiver's next bytecode.	Answer the context that would be the active context	after this bytecode."	^Object errorSignal		handle: [:ex | Context codeSimulationErrorSignal raise]		do: [self interpretNextInstructionFor: self]!stepUntilHaveNPC	"Simulate the execution of bytecodes until	the vPC can be converted to nPC."	pc < 0 ifFalse:		[[(method nFromVPCnoFail: pc) == nil] 			whileTrue: [self completeCallee: self step]]!stepUntilPC: stopPC	"Simulate the execution of bytecodes until pc is equal to stopPC"	Object errorSignal		handle: [:ex | Context codeSimulationErrorSignal raise]		do: [[self pc < stopPC and: [self willReturn not]]					whileTrue: [self completeCallee: self step]]!stepUntilProceedable	"Step until a backward jump or a send and answer a new context activated 	by the send. If a send is primitive, or the method does not create a context,	continue to step until an ordinary send. When a return byte code is encountered, 	return to sender and continue to step."	| ctx newCtx |	pc < 0 ifTrue: [^self].	ctx _ self.	[ctx willJumpBackward ifTrue: [^ctx].	ctx willSend 		ifTrue: "create new context"			[newCtx _ ctx send.			(newCtx == ctx or: [newCtx method frameSize = 0])				ifFalse: [^newCtx].			"primitive or frameless"			ctx _ newCtx]		ifFalse: [ctx _ ctx step]]	  repeat!stepUntilVisibleEffect	"Simulate the execution of bytecodes until either sending a message 	or assigning a expression or returning a value to the receiver (that is,	until reaching a point that has meaning at the source level)."	Object errorSignal		handle: [:ex | Context codeSimulationErrorSignal raise]		do: [[self willSend or: [self willAssign or: [self willReturn]]]					whileFalse: [self step]]! !!Context methodsFor: 'fileIn/Out'!storeBinaryOn: stream	stream inClass: receiver class do: [super storeBinaryOn: stream]! !!Context methodsFor: 'backward compatibility'!copyForFixTemps	^self shallowCopy finishCopyForFixTemps!finishCopyForFixTemps	sender _ nil.	stack _ stack shallowCopy!release	"Remove information from the receiver in order to break circularities;	this shouldn't be necessary!!"	self terminate!shortStack	"Answer a string showing the top five contexts on my sender chain."	| shortStackStream |	shortStackStream _ WriteStream on: (String new: 400).	(self stackOfSize: 5) do: 		[:item | shortStackStream print: item; cr].	^shortStackStream contents!stack 	"Answer an array of the contexts on the receiver's sender chain."	^self stackOfSize: 9999!stackOfSize: limit 	"Answer an array of the top 'limit' contexts on the receiver's sender chain."	| a stk |	stk _ OrderedCollection new: (limit min: 100).	stk addLast: (a _ self).	[(a _ a sender) notNil and: [stk size < limit]]		whileTrue: 			[stk addLast: a].	^stk! !!Context methodsFor: 'private-simulation'!dup	self push: self top!findMethod: selector class: initialClass ifFound: aBlock	"Invoke aBlock with the method and the class	where it was found."	| class meth |	class _ initialClass.	[class == nil]		whileFalse:			[(class includesSelector: selector)				ifTrue:					[meth _ class compiledMethodAt: selector.					^aBlock value: meth value: class].			class _ class superclass].	^nil!push: value	stackp _ stackp + 1.	self localAt: stackp put: value!return: value 	| caller |	caller _ sender.	caller isNil		ifTrue: [^self cannotReturn: value]		ifFalse: 			[sender _ nil.			^caller push: value]!runMethod: meth numArgs: nargs contextClass: cclass	"Run a method.  numArgs is an argument	because all callers know it, and	we shouldn't have to compute it again."	| args rcvr ctx prim |	rcvr _ self localAt: stackp - nargs.	(meth isBlockMethod not and: [(prim _ meth primitiveNumber) notNil])		ifTrue:			[ctx _ self				tryPrimitive: prim				receiver: rcvr				numArgs: nargs.			ctx isNil ifFalse: [^ctx]].	args _ Array new: nargs.	1 to: nargs do: [:i | args at: i put: (self localAt: stackp - nargs + i)].	stackp _ stackp - nargs - 1.	ctx _ cclass		sender: self		receiver: rcvr		method: meth		arguments: args.	prim notNil ifTrue: [ctx skipPrimitive].	^ctx!send: selector receiver: rcvr class: rclass super: flag numArgs: na	"Don't simulate calls on error:."	selector == #error:		ifTrue:			[[true] whileTrue: [self error: 'error: called']].	(flag | Send or: [rclass == Exception]) ifFalse: 			[^self sendFast: selector receiver: rcvr numArgs: na].	self findMethod: selector		class: rclass		ifFound:			[:meth :mclass |			flag ifTrue: [self pop].  "remove class for super"			^self runMethod: meth numArgs: na contextClass: MethodContext].	self error: 'Message not found: ', selector printString.	"To continue, just return the receiver of the message."	flag ifTrue: [self pop].  "remove class for super"	stackp _ stackp - na.	self localAt: stackp put: rcvr!top	^self localAt: stackp!topPop	| top |	top _ self localAt: stackp.	stackp _ stackp - 1.	^top! !!Context methodsFor: 'private-debugger'!blockContextFrom: aBlockClosure args: anArray	"Answer a BlockContext of aBlockClosure."	| ctx |	ctx _ BlockContext				sender: self				receiver: aBlockClosure				method: aBlockClosure method				arguments: anArray.	ctx restart.	^ctx!checkHandlerBlock: block value: selector	"Answer true if the exception handler is about to run"	^method == (Exception compiledMethodAt: #propagatePrivateFrom:) 		and: [block class == BlockClosure			and: [selector == #value: or: [selector == #value:value:]]]					"handler"				"Emergency handler"!removeContextsTo: aContext	"Remove contexts from the receiver's callee to aContext.	Find aContext's callee first, and then Set aContext's callee 	to the receiver's callee."	| ctx nextCtx |	ctx _ thisContext.	[(nextCtx _ ctx sender) ==  aContext]		whileFalse: [ctx _ nextCtx].	ctx sender: self.!sendFast: selector receiver: rcvr numArgs: na	"Execute a send by using perform to invoke VM. Before doing perform,	insert extra contexts between the receiver and the perform context.	The extra contexts holds an exception handling block and an unwind block.	The exception handling block is used to repropagate the signal through the 	client process contexts chain. The unwind block is used to catch control flow	after an uparrow block return occurs in executing the send."	| args context |	args _ Array new: na.	1 to: na do: [:i | args at: i put: (self localAt: stackp - na + i)].	stackp _ stackp - na - 1.	(self checkHandlerBlock: rcvr value: selector) ifTrue: 		[args size = 2  			ifTrue: ["emergency handler"					EmergencySignal raiseWith: (args at: 1 "the exception")]			ifFalse: ["normal handler"					^Array with: (self blockContextFrom: rcvr args: args)]].	[| savedSender invisibleContext stubCtx ctx |	invisibleContext _ thisContext.	savedSender _ thisContext sender.	thisContext sender: self.	[Signal genericSignal 		handle: [:ex |				ex checkInitialContextIf: stubCtx with: self.				self removeContextsTo: stubCtx.				context _ ex rePropagateFrom: self.				thisContext sender: invisibleContext]		do: [stubCtx _ thisContext.			context _ self push: (rcvr perform: selector withArguments: args)]	] valueOnUnwindDo: 			[ctx _ thisContext sender home.			ctx method == (BlockContext compiledMethodAt: #nonlocalReturn:through:)				ifTrue: [context _ ctx uparrowReturn.].			thisContext sender: invisibleContext].	thisContext sender: savedSender] value.	^context!uparrowReturn	| home result unwindCtx context |	home _ self localAt: 4.	result _ self localAt: 5.	unwindCtx _ self localAt: 3.	context _ home sender.	context push: result.	unwindCtx unwindUpTo: home.	^context! !!Context methodsFor: 'private-initialization'!setSender: s receiver: r method: m arguments: args size: ss	args size = m numArgs ifFalse: [self error: 'Wrong number of arguments'].	super method: m.	sender _ s.	receiver _ r.	stack _ Array new: ss.	1 to: args size do: [:i | stack at: i put: (args at: i)].	stackp _ args size + m numTempsOnly! !!Context methodsFor: 'private-accessing'!countTemps: index do: aBlock elseDo: elseBlock	" aBlock is guaranteed to do a ^ return "	| i ilocal |	i _ index.	ilocal _ 1.	self localScope localTempNames do:		[:name |		name first = $. ifFalse:  " not a compiler-generated temporary "			[i = 1 ifTrue: [aBlock value: self value: ilocal].			i _ i - 1].		ilocal _ ilocal + 1].	^elseBlock value: i!localAt: index	^stack at: index!localAt: index put: value	^stack at: index put: value!localSize	^stack size! !!Context methodsFor: 'copying'!deepCopy	"Answer a copy of the receiver with its own copy of each instance 	variable. This doesn't make sense for Contexts."	^self deepCopyError! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Context class	instanceVariableNames: ''!!Context class methodsFor: 'class initialization'!initialize	"Context initialize"	MethodCache _ IdentityDictionary new.	Send _ false.	TryPrimitiveSelectors _ #(#tryPrimitive0 #tryPrimitive1: #tryPrimitive2:with: #tryPrimitive3:with:with: #tryPrimitive4:with:with:with: ).	PrimitiveFailedSignal _ Object errorSignal newSignal 		notifierString: 'A simulated primitive has failed';		nameClass: self message: #primitiveFailedSignal.	EmergencySignal _ (Signal genericSignal newSignalMayProceed: false)		notifierString: 'Code simulation emergency';		nameClass: self message: #emergencySignal.	CodeSimulationErrorSignal _ Object errorSignal newSignal 		notifierString: 'Code simulation error';		nameClass: self message: #codeSimulationErrorSignal.	CannotReturnSignal _ Object errorSignal newSignal 		notifierString: 'Context cannot return';		nameClass: self message: #cannotReturnSignal.	CannotResumeSignal _ Object errorSignal newSignal 		notifierString: 'Context cannot resume';		nameClass: self message: #cannotResumeSignal! !!Context class methodsFor: 'instance creation'!sender: s receiver: r method: m arguments: args	"If frameSize = 0, we need to use m numArgs + 2,	for simulating frameless methods."	| fs |	fs _ m frameSize.	fs = 0 ifTrue: [fs _ m numTemps + 2].	^self new setSender: s receiver: r method: m arguments: args size: fs! !!Context class methodsFor: 'Signal constants'!cannotResumeSignal	^CannotResumeSignal!cannotReturnSignal	^CannotReturnSignal!codeSimulationErrorSignal	^CodeSimulationErrorSignal!emergencySignal	^EmergencySignal!primitiveFailedSignal	^PrimitiveFailedSignal! !Context initialize!Inspector subclass: #ContextInspector	instanceVariableNames: 'tempNames '	classVariableNames: ''	poolDictionaries: ''	category: 'Tools-Inspector'!ContextInspector comment:'Class ContextInspector represents a query path into the internal representation of a ContextPart.  Typically this is a context at a point in the query path of a Debugger.  As a StringHolder, the string the ContextInspector represents is the value of the currently selected variable of the observed temporary variable of the context.Instance Variables:	tempNames	<Array of: Strings>  each the name of a temporary variable.'!!ContextInspector methodsFor: 'initialize-release'!inspect: anObject 	"Initialize the receiver so that anObject is the object to be inspected."	object _ anObject.	self changed: #field! !!ContextInspector methodsFor: 'field list'!fieldIndex	"Answer the offset corresponding to the currently selected field."	^ tempNames indexOf: field!fieldList	object == nil ifTrue: [^nil].	^(tempNames _ object tempNames)!fieldMenu	"Answer an ActionMenu of operations on variables that is to be displayed 	when the operate menu button is pressed."	field == nil ifTrue: [^ nil].	^ActionMenu		labels: 'inspect'		selectors: #(inspectField)!fieldValue	"field = 'self' ifTrue: [^ object receiver]."	^ object tempAt: self fieldIndex! !!ContextInspector methodsFor: 'doIt/accept'!acceptText: aText from: aController	"Text has been changed.  Store or compile the text, depending on 	the current mode of the receiver."	| val |	(field == nil) | (field = 'self') ifTrue: [^ false].	val _ self evaluateText: aText string from: aController ifFail: [^ false].	object tempAt: self fieldIndex put: val.	self changed: #text.	^ true!doItContext	"Answer the context in which a text selection can be evaluated."	^object!doItReceiver	"Answer the object that should be informed of the result of evaluating a	text selection."	^object homeReceiver! !Object subclass: #Controller	instanceVariableNames: 'model view sensor '	classVariableNames: 'BadControllerSignal '	poolDictionaries: ''	category: 'Interface-Framework'!Controller comment:'A Controller coordinates a view, its model, and user actions.Instance Variables:	model	<Object | Model>	view 	<View>	sensor 	<InputSensor>Class Variables:	BadControllerSignal		<Signal> Bad controller -- the view is nil'!!Controller methodsFor: 'initialize-release'!initialize	"Initializes the state of the receiver.  Subclasses should include	'super initialize' when redefining this message to insure proper initialization."	sensor _ InputSensor default!release	"Breaks the cycle between the receiver and its view. It is usually not 	necessary to send release provided the receiver's view has been properly 	released independently."	super release.	view ~= nil		ifTrue: 			[view controller: nil.			view _ nil]! !!Controller methodsFor: 'model access'!model	"Answer the receiver's model which is the same as the model of the	receiver's view."	^model!model: aModel 	"Controller|model: and Controller|view: are sent by View|controller: in order 	to coordinate the links between the model, view, and controller. In ordinary 	usage, the receiver is created and passed as the parameter to View|controller: 	so that the receiver's model and view links can be set up by the view."	model _ aModel! !!Controller methodsFor: 'view access'!view	"Answer the receiver's view."	^view!view: aView 	"Controller|view: and Controller|model: are sent by View|controller: in order 	to coordinate the links between the model, view, and controller. In ordinary 	usage, the receiver is created and passed as the parameter to View|controller: 	and the receiver's model and view links are set up automatically by the view."	view _ aView! !!Controller methodsFor: 'sensor access'!sensor	"Answer the receiver's sensor.	Subclasses may use other objects that are not instances of Sensor or its subclasses 	if more general kinds of input/output functions are required."	^sensor!sensor: aSensor	"Set the receiver's sensor to aSensor."	sensor _ aSensor! !!Controller methodsFor: 'basic control sequence'!controlInitialize	"Sent by Controller|startUp as part of the standard control sequence. It provides 	a place in the standard control sequence for initializing the receiver 	(taking into account the current state of its model and view). It should be 	redefined in subclasses to perform some specific action."	^self!controlLoop	"Sent by Controller|startUp as part of the standard control sequence. 	Controller|controlLoop sends the message Controller|isControlActive to test 	for loop termination. As long as true is returned, the loop continues. When 	false is returned, the loop ends. Each time through the loop, the message 	Controller|controlActivity is sent."	[self isControlActive] whileTrue: [Processor yield. self controlActivity]!controlTerminate	"Provide a place in the standard control sequence for terminating the  	receiver (taking into account the current state of its model and view). It  	should be redefined in subclasses to perform some specific action."	^self!startUp	"Give control to the receiver. The default control sequence is to initialize 	(see Controller|controlInitialize), to loop (see Controller|controlLoop), and 	then to terminate (see Controller|controlTerminate). After this sequence, 	control is returned to the sender of Control|startUp. The receiver's control 	sequence is used to coordinate the interaction of its view and model. In general, 	this consists of polling the sensor for user input, testing the input with respect 	to the current display of the view, and updating the model to reflect intended 	changes."	self controlInitialize.	self controlLoop.	self controlTerminate! !!Controller methodsFor: 'control defaults'!controlActivity	"Pass control to the next control level (that is, to the Controller of a subView of  	the receiver's view) if possible. It is sent by Controller|controlLoop each time  	through the main control loop. It should be redefined in a subclass if some other  	action is needed."	self controlToNextLevel!controlToNextLevel	"Pass control to the next control level, that is, to the Controller of a subView of 	the receiver's view if possible. The receiver finds the subView (if any) whose controller		wants control and sends that controller the message startUp."	| aView |	aView _ view subViewWantingControl.	aView ~~ nil ifTrue: [aView controller startUp]!isControlActive	"Answer whether the receiver wants control.  The default is to take control	if the cursor is inside the view and the blue button is not pressed.  Pressing	blue button a default to explicitly give up control without moving the cursor.	It is sent by Controller|controlLoop in order to determine when the receiver's control 	loop should terminate, and should be redefined in a subclass if some other 	condition for terminating the main control loop is needed."	^(view containsPoint: sensor cursorPoint) & sensor blueButtonPressed not!isControlWanted	"Answer true if the cursor is inside the inset display box (see 	View|insetDisplayBox) of the receiver's view, and answer false, 	otherwise. It is sent by Controller|controlNextLevel in order to determine 	whether or not control should be passed to this receiver from the Controller of 	the superView of this receiver's view."	^self viewHasCursor! !!Controller methodsFor: 'cursor'!centerCursorInView	"Position sensor's mousePoint (which is assumed to be connected to the 	cursor) to the center of its view's inset display box (see Sensor|mousePoint: and 	View|insetDisplayBox)."	^sensor cursorPoint: view insetDisplayBox center!viewHasCursor	"Answer true if the cursor point of the receiver's sensor lies within the inset 	display box of the receiver's view (see View|insetDisplayBox), and 	answer false, otherwise. Controller|viewHasCursor is normally used in 	internal methods."	^view containsPoint: sensor cursorPoint! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Controller class	instanceVariableNames: ''!!Controller class methodsFor: 'class initialization'!initialize	"Initialize signals."	| es |	es _ Object errorSignal.	BadControllerSignal _ es newSignal 		notifierString: 'Bad controller -- the view is nil';		nameClass: self message: #badControllerSignal.! !!Controller class methodsFor: 'instance creation'!new	^super new initialize! !!Controller class methodsFor: 'Signal constants'!badControllerSignal	^BadControllerSignal! !Controller initialize!Object subclass: #ControlManager	instanceVariableNames: 'scheduledControllers activeController activeControllerProcess screenController interruptLock '	classVariableNames: 'InterruptLockedSignal LastDisplayExtent '	poolDictionaries: ''	category: 'Interface-Framework'!ControlManager comment:'Class ControlManager represents the top level control over scheduling which controller of a view on the screen the user is actively using.  ScheduledControllers is the global reference to an instance of ControlManager, the one attached to the Project currently being used.   Instance Variables:	scheduledControllers	<OrderedCollection> of Controllers, usually ScheduledControllers	activeController		<Controller> usually a ScheduledController	activeControllerProcess	<Process>	screenController 		<ScreenController> also appears in ScheduledControllers	isLocked				<Boolean> true if handling #interruptName:Class Variables:	InterruptLockSignal		<Signal> raised when #interruptName: is sent while already being handled	LastDisplayExtent		<Point> the most recent display size change registered by the input mechanism.'!!ControlManager methodsFor: 'initialize-release'!initialize	"Initialize the receiver to refer to only the background controller."	| screenView |	screenController _ ScreenController new.	screenView _ FormView new.	screenView model: (InfiniteForm with: Form gray) controller: screenController.	screenView window: Display boundingBox.	scheduledControllers _ OrderedCollection with: screenController.	interruptLock _ false!release	scheduledControllers == nil		ifFalse: 			[scheduledControllers 				do: [:controller | (controller isKindOf: Controller)								ifTrue: [controller view release]								ifFalse: [controller release]].			scheduledControllers _ nil]! !!ControlManager methodsFor: 'accessing'!activeController	"Answer the currently active controller."	^activeController!activeController: aController 	"Set aController to be the currently active controller.  Give the user control in it."	activeController _ aController.	self promote: aController.	activeControllerProcess _ 			[Controller badControllerSignal				handle: [:ex | aController closeAndUnschedule.						self removeInvalidControllers.						Transcript show: 'Bad controller whose view is nil.'.						ex return]				"If the active controller 's view is nil, BadControllerSignal is raised"				do: [aController startUp].			self searchForActiveController] newProcess.	activeControllerProcess priority: Processor userSchedulingPriority.	activeControllerProcess resume!activeController: aController andProcess: aProcess 	"Set aController to be the currently active controller and aProcess to be the	the process that is handles controller scheduling activities in the system."		self inActiveControllerProcess		ifTrue: 			[aController~~nil				ifTrue: [(scheduledControllers includes: aController)							ifTrue: [self promote: aController]							ifFalse: [self error: 'Old controller not scheduled']].			activeController controlTerminate.			activeController _ aController.			activeController == nil				ifFalse: [activeController controlInitialize].			activeControllerProcess _ aProcess.			activeControllerProcess resume]		ifFalse: 			[self error: 'New active controller process must be set from old one']!activeControllerNoTerminate: aController andProcess: aProcess 	"Set aController to be the currently active controller and aProcess to be the	the process that handles controller scheduling activities in the system.	This message differs from activeController:andProcess: in that it does not send	controlTerminate to the currently active controller."		self inActiveControllerProcess		ifTrue: 			[aController~~nil				ifTrue: [(scheduledControllers includes: aController)							ifTrue: [self promote: aController]							ifFalse: [self error: 'Old controller not scheduled']].			activeController _ aController.			activeController == nil				ifFalse: [activeController controlInitialize].			activeControllerProcess _ aProcess.			activeControllerProcess resume]		ifFalse: 			[self error: 'New active controller process must be set from old one']!activeControllerProcess	"Answer the process that is currently handling controller scheduling activities	in the system."	^activeControllerProcess!isScheduled: aController	"Answer whether the argument aController is one of the scheduled	controllers."	^scheduledControllers includes: aController!removeInvalidControllers	"If any scheduledControllers would interfere with the display of a notifier, unschedule them."	activeController == nil		ifFalse:	[activeController view == nil			ifTrue:	[activeController _ nil]].	scheduledControllers _ scheduledControllers select: [ :i | i view ~~ nil]!scheduledControllers	"Answer a copy of the ordered collection of scheduled controllers."	^scheduledControllers copy! !!ControlManager methodsFor: 'scheduling'!inActiveControllerProcess	"Answer whether the active scheduling process is the actual active process in the system."	^activeControllerProcess == Processor activeProcess!interruptName: title	"Raise a signal on the active scheduling process.	The default handler of the signal creates a notifier."	| currentLock |	currentLock _ interruptLock.	interruptLock _ true.	currentLock		ifTrue:	[^self class interruptLockedSignal raise].	activeControllerProcess interruptWith:			[[Object userInterruptSignal 					raiseRequestWith: thisContext sender sender sender sender sender					errorString: title] valueNowOrOnUnwindDo: [interruptLock _ false]]!promote: aController	"Make aController be the first scheduled controller in the ordered collection."		scheduledControllers remove: aController.	scheduledControllers addFirst: aController!promoteToSecond: aController	"Make aController be the first scheduled controller in the ordered collection."		scheduledControllers remove: aController.	scheduledControllers add: aController after: scheduledControllers first!pullBottomToTop	"Make the last scheduled view which wants control be the first one.  Used for implementing the message under to a scheduled controller."	scheduledControllers reverseDo:		[:controller |		(controller isControlWanted and: [controller ~~ screenController]) ifTrue:			[^scheduledControllers addFirst: (scheduledControllers remove: controller)]]!scheduleActive: aController 	"Make aController be scheduled as the active controller.  Presumably the active	scheduling process asked to schedule this controller and that a new process associated	this controller takes control.  So this is the last act of the active scheduling process."	Cursor normal show.	self scheduleActiveNoTerminate: aController.	Processor terminateActive!scheduleActiveNoTerminate: aController 	"Make aController be the active controller.  Presumably the process that requested	the new active controller wants to keep control to do more activites before the	new controller can take control.  Therefore, do not terminate the currently	active process."	self schedulePassive: aController.	self scheduled: aController		from: Processor activeProcess!scheduleOnBottom: aController 	"Make aController be scheduled as a scheduled controller, but not the active one.	Put it at the end of the ordered collection of controllers."	scheduledControllers addLast: aController!schedulePassive: aController 	"Make aController be scheduled as a scheduled controller, but not the active one.	Put it at the beginning of the ordered collection of controllers."	scheduledControllers addFirst: aController!searchForActiveController	"Find a scheduled controller that wants control and give control to it.  If none	wants control, then see if the System Menu has been requested."	| newController |	(activeControllerProcess == nil or: [activeControllerProcess == Processor activeProcess])		ifFalse: [^self].	activeController _ nil.	Object errorSignal 		handle: [:ex | "bad controller"				ScheduledControllers removeInvalidControllers.				ex restart]		"If the active controller's view is nil, MessageNotUnderstoodSignal 		is raised and caught as ErrorSignal by the handler."		do: 		[[Processor yield.	 	newController _ scheduledControllers 			detect:				[:aController |				aController isControlWanted and:							[aController ~~ screenController]]			ifNone:				[screenController isControlWanted					ifTrue: [screenController]					ifFalse: [nil]].		newController isNil]			whileTrue].	self activeController: newController.	Processor terminateActive!unschedule: aController	"Remove the view, aController, from the collection of scheduled controllers."	scheduledControllers remove: aController ifAbsent: []! !!ControlManager methodsFor: 'displaying'!displaySafe: aBlock forController: aController 	"Put the display of the view for the argument aController at the top of all	views and evaluate the argument aBlock."	| intersects |	(scheduledControllers includes: aController)		ifFalse: [^nil].	activeController == aController ifTrue: [^aBlock value].	activeController == nil		ifTrue: 			[aController showOnDisplay.			aBlock value.			aController saveDisplayBits.			^self promote: aController].	(intersects _ activeController intersectsDisplayBoxOf: aController)		ifTrue: [activeController saveDisplayBits].	aController showOnDisplay.	aBlock value.	aController saveDisplayBits.	intersects ifTrue: [activeController showOnDisplay; flushDisplayBits].	self promoteToSecond: aController!redraw	"Redisplay all of the scheduled views on the display screen."	| aPoint |	aPoint _ 0@0.	self unschedule: screenController.	self scheduleOnBottom: screenController.	screenController view window: Display boundingBox.	scheduledControllers		reverseDo: 			[:aController | 			aController view display; deEmphasize.			(aController view viewport intersects: Display boundingBox)				ifFalse:					[(Display boundingBox containsPoint: (aPoint _ aPoint + (10@10)))						ifFalse: [aPoint _ 10@10].					aController view moveTo: aPoint].			aController saveDisplayBits].	Cursor normal show!restore	"Redisplay all of the scheduled views on the screen."	LastDisplayExtent == nil		ifFalse: 			[| ns |			ns _ LastDisplayExtent.			LastDisplayExtent _ nil.			DisplayScreen displaySize: ns].	self redraw! !!ControlManager methodsFor: 'restoring'!backgroundFormFor: aRectangle	"Answer the background bits for aRectangle no matter what the background is."	|backgroundBits background|	backgroundBits _ Form extent: aRectangle extent.	background _ screenController model.	background class == InfiniteForm		ifTrue: [background					displayOn: backgroundBits					at: 0 @ 0					clippingBox: backgroundBits boundingBox					rule: Form over					mask: Form black]		ifFalse: [(background isKindOf: Form)				ifTrue: [backgroundBits							copyBits: aRectangle							from: background							at: 0 @ 0							clippingBox: backgroundBits boundingBox							rule: Form over							mask: nil]				ifFalse: [backgroundBits gray]].	^backgroundBits!restoreOn: aRegion for: aView 	"Clear the display area aRegion for the requesting view aView."	| controller controllers regions indx hisRegion bits reg cache pt background|	"Force to a display boundary that won't leave a white line."	background _ screenController model.	background class == InfiniteForm		ifTrue: [pt _ background form extent.				reg _ Rectangle					origin: (aRegion origin - (pt - (1@1)) grid: pt)					corner: aRegion corner]		ifFalse: [reg _ aRegion].	"get the controllers that have views that intersect the view being erased"	controllers _ OrderedCollection new: scheduledControllers size.	regions _ OrderedCollection new: scheduledControllers size.	indx _ 1.	[indx <= scheduledControllers size]		whileTrue: 			[controller _ scheduledControllers at: indx.			((controller ~= screenController and: [controller view ~= aView])				and: [(hisRegion _ controller view displayRegion) intersects: reg])				ifTrue: 					[controllers add: controller.					regions add: hisRegion].			indx _ indx + 1].	"put the cached bits from intersecting views on the display with double buffering"	bits _  self backgroundFormFor: reg.	(controllers size to: 1 by: -1)		do: 			[:i | 			controller _ controllers at: i.			(cache _ controller labelForm) == nil				ifFalse: [cache displayOn: bits at: controller view labelDisplayBox origin - reg origin].			(cache _ controller viewForm) == nil				ifFalse: [cache displayOn: bits at: controller view displayBox origin - reg origin]].	"bits displayOn: Display at: reg origin"	bits displayOn: Display at: reg origin clippingBox: aRegion rule: Form over mask: nil!saveActiveViewsBits	"Cache the view image of the active controller, if there is one."	activeController ~= nil ifTrue: [activeController saveDisplayBits]! !!ControlManager methodsFor: 'backgrounds'!background: color 	"Set the background color."	"ScheduledControllers background: Form lightGray."	self backgroundForm: (InfiniteForm with: color)!backgroundForm: aDisplayObject	"Set the background form by changing the screenController's model."	"Display white.  Pen new spiral: 1000 angle: 89; home; spiral: 1000 angle: -89. 		ScheduledControllers backgroundForm: (Form fromDisplay: Display boundingBox)."	screenController view model: aDisplayObject.	self restore! !!ControlManager methodsFor: 'private'!deactivate	self flushDisplayBits.	activeController _ nil.	activeControllerProcess _ nil!flushDisplayBits	"Get rid of the cached bits."	scheduledControllers do: [:aController | aController flushDisplayBits]!scheduled: aController from: aProcess	activeControllerProcess==aProcess 		ifTrue: 			[activeController ~~ nil					ifTrue: [activeController controlTerminate].			aController centerCursorInView.			self activeController: aController]		ifFalse:			[aController view displaySafe: []]! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!ControlManager class	instanceVariableNames: ''!!ControlManager class methodsFor: 'instance creation'!new	^super new initialize! !!ControlManager class methodsFor: 'accessing'!lastDisplayExtent: aPoint	"Set a shared variable to the size of the last display area."	LastDisplayExtent _ aPoint!newScheduler: controlManager	"When switching projects, the control scheduler has to be exchanged.  The	active one is the one associated with the current project."	ScheduledControllers deactivate.	Smalltalk at: #ScheduledControllers put: controlManager.	ScheduledControllers restore.	controlManager searchForActiveController! !!ControlManager class methodsFor: 'class initialization'!initialize	"Initialize signals"	"ControlManager initialize"	InterruptLockedSignal _ (Object errorSignal newSignalMayProceed: false)		notifierString: 'There is currently no active controller';		nameClass: self message: #interruptLockedSignal! !!ControlManager class methodsFor: 'Signal constants'!interruptLockedSignal	^InterruptLockedSignal! !ControlManager initialize!FillInTheBlankController subclass: #CRFillInTheBlankController	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Interface-Prompt/Confirm'!CRFillInTheBlankController comment:'Class CRFillinTheBlankController is a FillInTheBlankController that causes termination on a carriage return.'!!CRFillInTheBlankController methodsFor: 'basic control sequence'!controlInitialize	startBlock _ paragraph characterBlockForIndex: startBlock stringIndex.	stopBlock _ paragraph characterBlockForIndex: stopBlock stringIndex.	self initializeSelection.	beginTypeInBlock _ nil! !!CRFillInTheBlankController methodsFor: 'stop conditions'!cr: characterStream key: aChar	"The carriage return was typed by the user.  This designates that the receiver should give up control."	characterStream isEmpty ifFalse:		[self replaceSelectionWith:			(Text string: characterStream contents emphasis: emphasisHere)].	self accept.	^true! !Form subclass: #Cursor	instanceVariableNames: 'name '	classVariableNames: 'BlankCursor BottomLeftCursor BullCursor CaretCursor CornerCursor CrossHairCursor CurrentCursor DownCursor GarbageCursor HandCursor MarkerCursor NormalCursor OriginCursor ReadCursor ScrollCursor SquareCursor ThumbsDownCursor ThumbsUpCursor TopRightCursor UpCursor WaitCursor WriteCursor XeqCursor '	poolDictionaries: ''	category: 'Graphics-Display Objects'!Cursor comment:'Instances of class Cursor are each represented as a 16 x 16 dot matrix suitable for use as the current cursor.Instance Variable:	name	<String>  providing a label for the cursor Class Variables:	CurrentCursor	<Cursor> the cursor that is currently being displayed on the screen	The following are all the names of instances of class Cursor that are predefined in the system.  They are accessible with messages to the class.	BlankCursor	BottomLeftCursor	BullCursor	CaretCursor	CornerCursor	CrossHairCursor	DownCursor	GarbageCursor	HandCursor	MarkerCursor	NormalCursor	OriginCursor	ReadCursor	ScrollCursor	SquareCursor	ThumbsDownCursor	ThumbsUpCursor	TopRightCursor	UpCursor	WaitCursor	WriteCursor	XeqCursor	'!!Cursor methodsFor: 'updating'!changed: aParameter 	"Receiver changed.  The change is denoted by the argument 	anAspectSymbol.  Usually the argument is a Symbol that is part of 	the dependent's change protocol, that is, some aspect of the 	object's behavior.  Inform all of the dependents."	self == CurrentCursor ifTrue: [self beCursor].	super changed: aParameter! !!Cursor methodsFor: 'displaying'!beCursor	"Tell the VM to use the receiver as the current cursor image."	^self beCursorOffsetBy: 0 @ 0 - offset!beCursorOffsetBy: aPoint 	"Tell the interpreter to use the receiver as the current cursor image, 	using the supplied point as the 'hot-spot'.  Fail if the receiver does 	not match the size expected by the hardware, or if the hot-spot is 	not within the cursor's bounding-box.  Essential.  See Object 	documentation whatIsAPrimitive."	<primitive: 702>	((aPoint isKindOf: Point)		and: [(aPoint x isKindOf: SmallInteger)				& (aPoint y isKindOf: SmallInteger)])		ifFalse: [^self beCursorOffsetBy: aPoint rounded]		ifTrue: [self primitiveFailed]!beGarbageCollectionCursor	"Tell the VM to use the receiver as the current cursor image."	^self beGarbageCollectionCursorOffsetBy: 0 @ 0 - offset!beGarbageCollectionCursorOffsetBy: aPoint 	"Tell the interpreter to use the receiver as the garbage collection cursor 	image, using the supplied point as the 'hot-spot'.  Fail if the receiver does 	not match the size expected by the hardware, or if the hot-spot is 	not within the cursor's bounding-box.  Optional.  See Object 	documentation whatIsAPrimitive."	<primitive: 704>	((aPoint isKindOf: Point)		and: [(aPoint x isKindOf: SmallInteger)				& (aPoint y isKindOf: SmallInteger)])		ifFalse: [^self beGarbageCollectionCursorOffsetBy: aPoint rounded]		ifTrue: [self primitiveFailed]!show	"Make the current cursor shape be the receiver."	Sensor currentCursor: self!showGridded: gridPoint 	"Make the current cursor shape be the receiver, forcing the location 	of cursor to the point nearest the point gridPoint."	Sensor primCursorLocPut: (Sensor cursorPoint grid: gridPoint).	Sensor currentCursor: self!showWhile: aBlock 	"While evaluating the argument, aBlock, make the receiver be the cursor shape."	| oldcursor value |	oldcursor _ Sensor currentCursor.	self show.	[value _ aBlock value.]		valueNowOrOnUnwindDo: [oldcursor show].	^value! !!Cursor methodsFor: 'printing'!printOn: aStream  	"Append to the argument aStream a sequence of characters that identifies the receiver."	self storeOn: aStream base: 2!storeOn: aStream base: anInteger 	"Store the receiver out in the form:  Form extent:fromArray:#()offset:"	aStream nextPut: $(.	super storeOn: aStream base: anInteger.	aStream nextPutAll: ' name: '.	name storeOn: aStream.	aStream nextPut: $).! !!Cursor methodsFor: 'name'!name	"Answer the string labelling the receiver."	^name!name: aString	"Make the argument aString, be the label for the receiver."	name _ aString! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Cursor class	instanceVariableNames: ''!!Cursor class methodsFor: 'class initialization'!initialize	"Create all the standard cursors."	"Cursor initialize."	BlankCursor _ Cursor new.	self initNormal.	self initXeq.	self initRead.	self initWrite.	self initUp.	self initDown.	self initMarker.	self initScroll.	self initOrigin.	self initCorner.	self initTopRight.	self initBottomLeft.	self initCrossHair.	self initCaret.	self initWait.	self initGarbage.	self initThumbsUp.	self initThumbsDown.	self initBull.	self initHand!install	"Set up standard cursors for selection and garbage collection."	self currentCursor: self normal.	self garbageCollectionCursor: self garbage! !!Cursor class methodsFor: 'instance creation'!extent: extentPoint fromArray: anArray offset: offsetPoint 	"Answer a new instance of the receiver with width and height specified by	extentPoint, offset by offsetPoint, and bits from anArray.  Provide an error	notification if the extentPoint is not 16@16."	extentPoint = (16 @ 16)		ifTrue: 			[^super				extent: extentPoint				fromArray: anArray				offset: offsetPoint]		ifFalse: [self error: 'cursors must be 16@16']!extent: extentPoint fromArray: anArray offset: offsetPoint name: aString 	"Answer a new instance of the receiver with width and height 	specified by extentPoint, offset by offsetPoint, and bits from 	anArray.   Provide an error notification if the extentPoint is not 16@16."	extentPoint = (16 @ 16)		ifTrue: [^(super				extent: extentPoint				fromArray: anArray				offset: offsetPoint)				name: aString]		ifFalse: [self error: 'cursors must be 16@16']!new		"Answer a new instance of the receiver that is a blank image."	"Cursor new bitEdit."	^self		extent: 16 @ 16		fromArray: Array new		offset: 0 @ 0! !!Cursor class methodsFor: 'current cursor'!currentCursor	"Answer the instance of the receiver that is the one currently displayed."	^CurrentCursor!currentCursor: aCursor 	"Make the instance of Cursor, aCursor, be the current cursor.  Display	it.  Provide an error notification if the argument is not a Cursor."	aCursor class == self		ifTrue: 			[CurrentCursor == aCursor				ifFalse: [CurrentCursor _ aCursor.						aCursor beCursor]]		ifFalse: [self error: 'The new cursor must be an instance of class Cursor']!cursorLink: boolean 	"Cause the cursor to track the pointing device location if the argument is true.  	Decouple the cursor from the pointing device if the argument is false.  	Essential.  See Object documentation whatIsAPrimitive."	<primitive: 92>	^self primitiveFailed!garbageCollectionCursor: aCursor 	"Make the instance of Cursor, aCursor, be the garbage collection	cursor.  Provide an error notificaton if the argument is not a Cursor."	aCursor class == self		ifTrue: [aCursor beGarbageCollectionCursor]		ifFalse: [self error: 'The cursor must be an instance of class Cursor']! !!Cursor class methodsFor: 'constants'!blank	"Answer the instance of the receiver that is all white."	^BlankCursor!bottomLeft	"Answer the instance of the receiver that is a bottom left corner."	^BottomLeftCursor!bull	"Answer the instance of the receiver that is a bull's-eye."	^BullCursor!caret	"Answer the instance of the receiver that is a caret."	^CaretCursor!corner	"Answer the instance of the receiver that is the shape of the bottom right corner of	a rectangle."	^CornerCursor!crossHair	"Answer the instance of the receiver that is the shape of a cross."	^CrossHairCursor!down	"Answer the instance of the receiver that is the shape of an arrow facing downward."	^DownCursor!execute	"Answer the instance of the receiver that is the shape of an arrow slanted left	with a star next to it."	^XeqCursor!garbage	"Answer the instance of the receiver that is the shape of a garbage can with 	open lid."	^GarbageCursor!hand	"Answer the instance of the receiver that is the shape of a hand."	^HandCursor!marker	"Answer the instance of the receiver that is displayed when thumb-scrolling."	^MarkerCursor!normal	"Answer the instance of the receiver that is the shape of an arrow slanted left."	^NormalCursor!origin	"Answer the instance of the receiver that is the shape of the top left 	corner of a rectangle."	^OriginCursor!read	"Answer the instance of the receiver that is the shape of eyeglasses."	^ReadCursor!scroll	"Answer the instance of the receiver that is up and down arrows."	^ScrollCursor!square	"Answer the instance of the receiver that is the shape of a square."	^SquareCursor!thumbsDown	"Answer the instance of the receiver that is a thumbs down."	^ThumbsDownCursor!thumbsUp	"Answer the instance of the receiver that is thumbs up."	^ThumbsUpCursor!topRight	"Answer the instance of the receiver that is a top right corner."	^TopRightCursor!up	"Answer the instance of the receiver that is the shape of an arrow facing upward."	^UpCursor!wait	"Answer the instance of the receiver that is the shape of an hour glass."	^WaitCursor!write	"Answer the instance of the receiver that is the shape of a pen writing."	^WriteCursor! !!Cursor class methodsFor: 'private-constant initialization'!initBottomLeft	BottomLeftCursor _ (Cursor			extent: 16@16			fromArray: #(		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1111111111111111		2r1111111111111111)			offset: -2@-2 name: 'bottomLeft')!initBull		BullCursor _ (Cursor 			extent: 16@16			fromArray: #(		2r0000000000000000		2r0000011111000000		2r0001100100110000		2r0010000100001000		2r0100000100000100		2r0100000100000100		2r1000000100000010		2r1000000100000010		2r1111111111111110		2r1000000100000010		2r1000000100000010		2r0100000100000100		2r0100000100000100		2r0010000100001000		2r0001100100110010		2r0000011111000000)			offset: -8@-9 name: 'bull').!initCaret	CaretCursor _ (Cursor	  extent: 16@16	  fromArray: #(		2r110000000		2r110000000		2r1111000000		2r11111100000		2r11001100000		2r0		2r0		2r0		2r0		2r0		2r0		2r0		2r0		2r0		2r0		2r0)	offset: -8@0 name: 'caret').!initCorner	CornerCursor _ (Cursor 			extent: 16@16			fromArray: #(		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r1111111111111111		2r1111111111111111)			offset: -14@-14			name: 'corner')!initCrossHair	CrossHairCursor _ (Cursor			extent: 16@16			fromArray: #(		2r0000000100000000		2r0000000100000000		2r0000000100000000		2r0000000100000000		2r0000000100000000		2r0000000100000000		2r0000000100000000		2r1111111111111110		2r0000000100000000		2r0000000100000000		2r0000000100000000		2r0000000100000000		2r0000000100000000		2r0000000100000000		2r0000000100000000		2r0)			offset: -7@-7 name: 'crossHair')!initDown	DownCursor _ (Cursor 			extent: 16@16			fromArray: #(		2r0000110000000000		2r0000110000000000		2r0000110000000000		2r0000110000000000		2r0000110000000000		2r0000110000000000		2r0000110000000000		2r0000110000000000		2r0000110000000000		2r0000110000000000		2r1111110000000000		2r0111110000000000		2r0011110000000000		2r0001110000000000		2r0000110000000000		2r0000010000000000)			offset: -5@-7 name: 'down')!initGarbage	GarbageCursor _ (Cursor	extent: 16@16	fromArray: #(		2r111111100000		2r1000000011000		2r1000000000100		2r111111100100		2r1111111111000		2r1011111101000		2r1000000001000		2r1001001001000		2r1001001001000		2r1001001001000		2r1001001001000		2r1001001001000		2r1001001001000		2r1001001001000		2r100000010000		2r11111100000)	offset: 0@0 name: 'garbage')!initHand	HandCursor _ (Cursor			extent: 16 @ 16			fromArray: #(		2r110000000		2r1101001110000		2r10011001001000		2r10011001001010		2r1001001001101		2r1001001001001		2r110100000001001		2r1001100000000001		2r1000100000000010		2r100000000000010		2r10000000000010		2r1000000000100		2r1000000000100		2r100000001000		2r10000001000		2r10000001000)			offset: 0 @ 0			name: 'hand').!initMarker	MarkerCursor _ (Cursor			extent: 16@16			fromArray: #(		2r0		2r0		2r0		2r0000001000000000		2r0000001110000000		2r0000001111100000		2r1111111111111000		2r1111111111111110		2r1111111111111000		2r0000001111100000		2r0000001110000000		2r0000001000000000		2r0		2r0		2r0		2r0)			offset: -7@-7 name: 'mark')!initNormal	NormalCursor _ (Cursor			extent: 16@16			fromArray: #(		2r1000000000000000		2r1100000000000000		2r1110000000000000		2r1111000000000000		2r1111100000000000		2r1111110000000000		2r1111111000000000		2r1111100000000000		2r1111100000000000		2r1001100000000000		2r0000110000000000		2r0000110000000000		2r0000011000000000		2r0000011000000000		2r0000001100000000		2r0000001100000000)	offset: 0@0 name: 'normal')!initOrigin	OriginCursor _ (Cursor			extent: 16@16			fromArray: #(		2r1111111111111111		2r1111111111111111		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000)			offset: -2@-2 name: 'origin')!initRead	ReadCursor _ (Cursor			extent: 16@16			fromArray: #(		2r0000110000000110		2r0001001000001001		2r0001001000001001		2r0010000000010000		2r0100000000100000		2r1111101111100000		2r1000010000100000		2r1000010000100000		2r1011010110100000		2r0111101111000000		2r0		2r0		2r0		2r0		2r0		2r0)	offset: 0@0	name: 'read')!initScroll	ScrollCursor _ (Cursor 			extent: 16@16			fromArray: #(		2r0000100000000000		2r0000110000000000		2r0000111000000000		2r0000111100000000		2r0000111110000000		2r0000111111000000		2r0000110000000000		2r0000110000000000		2r0000110000000000		2r0000110000000000		2r1111110000000000		2r0111110000000000		2r0011110000000000		2r0001110000000000		2r0000110000000000		2r0000010000000000)			offset: -5@-7 name: 'scroll')!initThumbsDown	ThumbsDownCursor _ (Cursor			extent: 16@16			fromArray:				#(		2r111111110000		2r100000001000		2r1111100000111		2r10000000000000		2r11111100000000		2r10000000000000		2r11111100000000		2r10000000000000		2r1000010000011		2r111110001100		2r10001000		2r10001000		2r1111000		2r1001000		2r1101000		2r10000)			offset: 0@0 name: 'thumbsDown').!initThumbsUp	ThumbsUpCursor _ (Cursor			extent: 16@16			fromArray: 				#(		2r10000		2r1101000		2r1001000		2r1111000		2r10001000		2r10001000		2r111110001100		2r1000010000011		2r10000000000000		2r11111100000000		2r10000000000000		2r11111100000000		2r10000000000000		2r1111100000111		2r100000001000		2r111111110000)			offset: -15@0 name: 'thumbsUp').!initTopRight	TopRightCursor _ (Cursor 			extent: 16@16			fromArray: #(		2r1111111111111111		2r1111111111111111		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011		2r0000000000000011)			offset: -14@-14			name: 'topRight')!initUp	UpCursor _ (Cursor 			extent: 16@16			fromArray: #(		2r1000000000000000		2r1100000000000000		2r1110000000000000		2r1111000000000000		2r1111100000000000		2r1111110000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000		2r1100000000000000)	 		offset: 0@-7 name: 'up')!initWait	WaitCursor _ (Cursor			extent: 16@16			fromArray: #(		2r1111111111111111		2r1000000000000001		2r0100000000000010		2r0010000000000100		2r0001110000111000		2r0000111101110000		2r0000011011100000		2r0000001111000000		2r0000001111000000		2r0000010110100000		2r0000100010010000		2r0001000110001000		2r0010001101000100		2r0100111111110010		2r1011111111111101		2r1111111111111111)			offset: 0@0			name: 'wait')!initWrite	WriteCursor _ (Cursor	extent: 16@16	fromArray: #(		2r0000000000000110		2r0000000000001111		2r0000000000010110		2r0000000000100100		2r0000000001001000		2r0000000010010000		2r0000000100100000		2r0000001001000011		2r0000010010000010		2r0000100100000110		2r0001001000001000		2r0010010000001000		2r0111100001001000		2r0101000010111000		2r0110000110000000		2r1111111100000000)	offset: 0@0	name: 'write')!initXeq	XeqCursor _ (Cursor			extent: 16@16			fromArray: #(		2r1000000000010000		2r1100000000010000		2r1110000000111000		2r1111000111111111		2r1111100011000110		2r1111110001000100		2r1111111001111100		2r1111100001101100		2r1111100011000110		2r1001100010000010		2r0000110000000000		2r0000110000000000		2r0000011000000000		2r0000011000000000		2r0000001100000000		2r0000001100000000)	offset: 0@0 	name: 'xeq')! !Cursor initialize!Path subclass: #Curve	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Graphics-Paths'!Curve comment:'Class Curve is a subclass of Path that is a conic section determined by: three points p1,p2 and p3 that interpolates p1 and p3 and is tangent to p1,p2 and p3,p2 at p1 and p3 respectively.'!!Curve methodsFor: 'displaying'!displayOn: aDisplayMedium at: aDisplayPoint clippingBox: clipRectangle rule: ruleInteger mask: aForm	"Display the receiver on the display medium aDisplayMedium positioned at aDisplayPoint within 	the rectangle clipRectangle and with the rule, ruleInteger, and mask, aForm. "	| pa pb k s p1 p2 p3 line |	line _ Line new.	line form: self form.	collectionOfPoints size < 3 ifTrue: [self error: 'Curve must have three points'].	p1 _ self firstPoint.	p2 _ self secondPoint.	p3 _ self thirdPoint.	s _ Path new.	s add: p1.	pa _ p2 - p1.	pb _ p3 - p2.	k _ 5 max: pa x abs + pa y abs + pb x abs + pb y abs // 20.	"k is a guess as to how many line segments to use to approximate 	the curve."	1 to: k do: 		[:i | 		s add: pa * i // k + p1 * (k - i) + (pb * (i - 1) // k + p2 * (i - 1)) // (k - 1)].	s add: p3.	1 to: s size - 1 do: 		[:i | 		line beginPoint: (s at: i).		line endPoint: (s at: i + 1).		line displayOn: aDisplayMedium			at: aDisplayPoint			clippingBox: clipRectangle			rule: ruleInteger			mask: aForm]! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Curve class	instanceVariableNames: ''!!Curve class methodsFor: 'instance creation'!new	"Answer a new instance of the receiver that is essentially a single point	at the upper left corner of the screen."	| newSelf | 	newSelf _ super new: 3.	newSelf add: 0@0.	newSelf add: 0@0.	newSelf add: 0@0.	^newSelf! !!Curve class methodsFor: 'examples'!sampleCurve	"Designate three locations on the screen by clicking any button.  The curve	determined by the points will be displayed with a long black form."	"Curve sampleCurve."	| aCurve aForm |  	aForm _ Form new extent: 1@30.			"make a long thin Form for display "	aForm black.								"turn it black"	aCurve _ Curve new.	aCurve form: aForm.						"set the form for display"				"collect three Points and show them on the dispaly"	aCurve firstPoint: Sensor waitButton. Sensor waitNoButton.	aForm displayOn: Display at: aCurve firstPoint.	aCurve secondPoint: Sensor waitButton. Sensor waitNoButton.	aForm displayOn: Display at: aCurve secondPoint.	aCurve thirdPoint: Sensor waitButton. Sensor waitNoButton.	aForm displayOn: Display at: aCurve thirdPoint.	aCurve displayOn: Display					"display the Curve"! !Magnitude subclass: #Date	instanceVariableNames: 'day year '	classVariableNames: 'DaysInMonth FirstDayOfMonth MonthNames SecondsInDay WeekDayNames '	poolDictionaries: ''	category: 'Magnitude-General'!Date comment:'An instance of class Date represents a specific day since the start of the Julian calendar;  a day exists in a particular month and year.  Protocol provided for the object Date supports inquiries about dates in general as well as about a specific date.Instance Variables: 	day		<Integer> from 1 to 31	year	<Integer> typically after the year 1900Class Variables: 	DaysInMonth		<Array of: Integers> the number of days in each month	FirstDayOfMonth	<Array of: Integers> the day of the year that is the first day of each month	MonthNames		<Array of: Symbols> the names of the 12 months	SecondsInDay		<Integer> total number of seconds in a day	WeekDayNames		<Array of: Symbols> the names of the 7 days in a week'!!Date methodsFor: 'comparing'!< aDate 	"Answer whether the argument, aDate, precedes the date of the 	receiver. "	year = aDate year		ifTrue: [^day < aDate day]		ifFalse: [^year < aDate year]!= aDate 	"Answer whether the argument, aDate, is the same day as the 	receiver. "	self species = aDate species		ifTrue: [^day = aDate day & (year = aDate year)]		ifFalse: [^false]!hash	"Answer a SmallInteger unique to the receiver."	^(year hash bitShift: 3) bitXor: day! !!Date methodsFor: 'accessing'!day	"Answer the day of the year represented by the receiver."	^day!leap	"Answer whether the receiver's year is a leap year."	^Date leapYear: year!monthIndex	"Answer the index of the month in which the receiver falls."	| leap firstDay |	leap _ self leap.	12 to: 1 by: -1 do: 		[ :monthIndex | 			firstDay _ (FirstDayOfMonth at: monthIndex)							+ (monthIndex > 2 ifTrue: [leap] ifFalse: [0]).			firstDay<= day				ifTrue: [^monthIndex]].	self error: 'illegal month'!monthName	"Answer the name of the month in which the receiver falls."	^MonthNames at: self monthIndex!weekday	"Answer the name of the day of the week on which the receiver falls."	^WeekDayNames at: self weekdayIndex!year	"Answer the year in which the receiver falls."	^year! !!Date methodsFor: 'arithmetic'!addDays: dayCount 	"Answer a new Date that is dayCount more days than the receiver."	^Date newDay: day + dayCount year: year!subtractDate: aDate 	"Answer the number of days between the receiver and aDate."	year = aDate year		ifTrue: [^day - aDate day  "take a shortcut"]		ifFalse: [^self asDays - aDate asDays]!subtractDays: dayCount 	"Answer a new Date that is dayCount days before the receiver."	^Date newDay: day - dayCount year: year! !!Date methodsFor: 'inquiries'!dayOfMonth	"Answer which day of the month is represented by the receiver."	^day - (self firstDayOfMonthIndex: self monthIndex) + 1!daysInMonth	"Answer the number of days in the month represented by the receiver."	^(DaysInMonth at: self monthIndex)		+ (self monthIndex = 2				ifTrue: [self leap]				ifFalse: [0])!daysInYear	"Answer the number of days in the year represented by the receiver."	^Date daysInYear: self year!daysLeftInYear	"Answer the number of days in the year after the date of the receiver."	^self daysInYear - self day!firstDayOfMonth	"Answer the index of the day of the year that is the first day	of the receiver's month."	^self firstDayOfMonthIndex: self monthIndex!previous: dayName 	"Answer the previous date whose weekday name is dayName."	^self subtractDays: 7 + self weekdayIndex - (Date dayOfWeek: dayName) \\ 7! !!Date methodsFor: 'converting'!asDays	"Answer the number of days between January 1, 1901	and the receiver's day."	| yearIndex |	yearIndex _ year - 1901.	^yearIndex * 365  "elapsed years"		+ (yearIndex // 4)  "ordinary leap years"		+ ((yearIndex + 300) // 400)  "leap centuries, first one is 2000, i.e. yearIndex = 99"		- (yearIndex // 100)  "non-leap centuries"		+ day - 1!asSeconds	"Answer the seconds between the time that 1901 began 	and the same time in the receiver's day."	^SecondsInDay * self asDays! !!Date methodsFor: 'printing'!printFormat: formatArray 	"Answer a string description of the receiver.  The argument	formatArray is the print format, where	1-3		positions to print day, month, year respectively 	4		character separator 	5		month format (1 month #, 2 first 3 characters, 3 entire name) 	6		year format (1 year #, 2 year # \\ 100)	For example, the formatArray		#(2 1 3 32 3 1 )	means print first the month, then the day, then the year; 	use a space as the separator (Ascii code 32); print entire	name of the month; full year identification.	Try		Date today printFormat: #(2 1 3 32 3 1)		Date today printFormat: #(1 2 3 45 2 2)"		| aStream |	aStream _ WriteStream on: (String new: 16).	self printOn: aStream format: formatArray.	^aStream contents!printOn: aStream 	"Append to the argument aStream a sequence of characters that 	identifies the receiver."	self printOn: aStream format: #(1 2 3 32 3 1 )!printOn: aStream format: formatArray 	"Print a description of the receiver on aStream.  The argument	formatArray is the print format, where	1-3		positions to print day, month, year respectively 	4		character separator 	5		month format (1 month #, 2 first 3 chars, 3 entire name) 	6		year format (1 year #, 2 year # \\ 100)	See also the comment for printFormat:"	| monthIndex element monthFormat |	monthIndex _ self monthIndex.	1 to: 3 do: 		[:elementIndex | 		element _ formatArray at: elementIndex.		element = 1 ifTrue: [day - self firstDayOfMonth + 1 printOn: aStream].		element = 2			ifTrue: 				[monthFormat _ formatArray at: 5.				monthFormat = 1 					ifTrue: [monthIndex printOn: aStream].				monthFormat = 2					ifTrue: [aStream nextPutAll: ((MonthNames at: monthIndex)													copyFrom: 1 to: 3)].				monthFormat = 3 					ifTrue: [aStream nextPutAll: (MonthNames at: monthIndex)]].		element = 3 			ifTrue: 				[(formatArray at: 6) = 1					ifTrue: [year printOn: aStream]					ifFalse: [(year \\ 100) printOn: aStream]].		elementIndex < 3 			ifTrue: 				[(formatArray at: 4) ~= 0 					ifTrue: [aStream nextPut: (formatArray at: 4) asCharacter]]]!storeOn: aStream 	"Append to the argument aStream a sequence of characters that is an 	expression whose evaluation creates a Date similar to the receiver.  The	form is		( class-name readFromString: datePrintString)"	aStream nextPutAll: '(', self class name, ' readFromString: ';		print: self printString;		nextPut: $)! !!Date methodsFor: 'private'!day: dayInteger year: yearInteger 	"Initialize the instance variables."	day _ dayInteger.	year _ yearInteger!firstDayOfMonthIndex: monthIndex 	"Answer the day of the year (an Integer) that is the first day of 	the receiver's month."	^(FirstDayOfMonth at: monthIndex)		+ (monthIndex > 2				ifTrue: [self leap]				ifFalse: [0])!weekdayIndex	"Sunday=1, ... , Saturday=7"	^(self asDays + 1) \\ 7 + 1  "1 January 1901 was a Monday"! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Date class	instanceVariableNames: ''!!Date class methodsFor: 'class initialization'!initialize	"Initialize class variables representing the names of the months and 	days and the number of seconds, days in each month, and first day of each 	month. "	"Date initialize."	MonthNames _ #(January February March April May 					June July August September October November December ).	SecondsInDay _ 24 * 60 * 60.	DaysInMonth _ #(31 28 31 30 31 30 31 31 30 31 30 31 ).	FirstDayOfMonth _ #(1 32 60 91 121 152 182 213 244 274 305 335 ).	WeekDayNames _ #(Monday Tuesday Wednesday Thursday Friday Saturday Sunday )! !!Date class methodsFor: 'instance creation'!fromDays: dayCount	"Answer with an instance of Date that is dayCount days since1901 began."	| aDate correction |	aDate _ self		newDay: 1 + (dayCount asSmallInteger rem: 1461)							"There are 1461 days in a 4-year cycle.							 This doesn't handle leap-centuries quite right:							 we fix this up below."		year: 1901 + ((dayCount asSmallInteger quo: 1461) * 4).	"Now correct for leap-centuries."	correction _ dayCount - aDate asDays.	^correction = 0		ifTrue: [aDate]		ifFalse: [aDate addDays: correction]!newDay: day month: monthName year: year 	"Answer with an instance of Date which is the day'th day of the month named 	monthName in the year'th year.  The year may be specified as the actual 	number of years since the beginning of the Roman calendar or the 	number of years since the beginning of the century."	| monthIndex daysInMonth firstDayOfMonth |	year < 100 ifTrue: [^self			newDay: day			month: monthName			year: 1900 + year].	monthIndex _ self indexOfMonth: monthName.	monthIndex = 2		ifTrue: [daysInMonth _ (DaysInMonth at: monthIndex)						+ (self leapYear: year)]		ifFalse: [daysInMonth _ DaysInMonth at: monthIndex].	monthIndex > 2		ifTrue: [firstDayOfMonth _ (FirstDayOfMonth at: monthIndex)						+ (self leapYear: year)]		ifFalse: [firstDayOfMonth _ FirstDayOfMonth at: monthIndex].	(day < 1 or: [day > daysInMonth])		ifTrue: [self error: 'illegal day in month']		ifFalse: [^self new day: day - 1 + firstDayOfMonth year: year]!newDay: dayCount year: referenceYear 	"Answer with a Date which is dayCount days after the beginning of the 	year referenceYear."	| day year daysInYear |	day _ dayCount.	year _ referenceYear.	[day > (daysInYear _ self daysInYear: year)]		whileTrue: 			[year _ year + 1.			 day _ day - daysInYear].	[day <= 0]		whileTrue: 			[year _ year - 1.			 day _ day + (self daysInYear: year)].	^self new day: day year: year!readFrom: aStream	"Answer a Date read from the argument aStream in any of	 the forms:		<day> <monthName> <year>		(5 April 1982; 5-APR-82)		<monthName> <day> <year>		(April 5, 1982)		<monthNumber> <day> <year>	(4/5/82)"	"Date readFrom: (ReadStream on: '5APR82')"	| day month |	aStream peek isDigit ifTrue: [day _ Integer readFrom: aStream].	[aStream peek isAlphaNumeric] whileFalse: [aStream skip: 1].	aStream peek isLetter		ifTrue:		"number/name... or name..."			[month _ WriteStream on: (String new: 10).			[aStream peek isLetter] whileTrue: [month nextPut: aStream next].			month _ month contents.			day isNil ifTrue:		"name/number..."				[[aStream peek isAlphaNumeric] whileFalse: [aStream skip: 1].				day _ Integer readFrom: aStream]]		ifFalse:		"number/number..."			[month _ Date nameOfMonth: day.			day _ Integer readFrom: aStream].	[aStream peek isAlphaNumeric] whileFalse: [aStream skip: 1].	^self newDay: day month: month year: (Integer readFrom: aStream)!today	"Answer the Date representing the day and year right now."	^self dateAndTimeNow at: 1! !!Date class methodsFor: 'general inquiries'!dateAndTimeNow	"Answer an Array with first element Date today and second element  	Time now."	^Time dateAndTimeNow!dayOfWeek: dayName 	"Answer the index in a week, 1 - 7, of the day named dayName.  	Provide an error notification if no such day exists."	1 to: 7 do: [:index | (WeekDayNames at: index)			= dayName ifTrue: [^index \\ 7]].	self error: dayName asString , ' is not a day of the week'!daysInMonth: monthName forYear: yearInteger 	"Answer the number of days in the month named monthName in the 	year yearInteger."	^(self		newDay: 1		month: monthName		year: yearInteger) daysInMonth!daysInYear: yearInteger 	"Answer the number of days in the year, yearInteger."	^365 + (self leapYear: yearInteger)!indexOfMonth: monthName 	"Answer the index, 1 - 12, of the month monthName.  Three letters as	well as full month names are accepted;  upper or lower case okay.  	Provide an error notification if no such month exists."	"Examples are		Date indexOfMonth: #May 		Date indexOfMonth: #aug "	1 to: 12 do: 		[ :index | 			(monthName , '*' match: (MonthNames at: index))						ifTrue: [^index]].	1 to: 12 do: 		[ :index | 			(monthName , '*' match: ((MonthNames at: index) copyFrom: 1 to: 3))						ifTrue: [^index]].	self error: monthName , ' is not a recognized month name'!leapYear: yearInteger 	"Answer 1 if the year yearInteger is a leap year;  answer 0 if it is 	not. "	(yearInteger \\ 4 ~= 0 or: [yearInteger \\ 100 = 0 and: [yearInteger \\ 400 ~= 0]])		ifTrue: [^0]		ifFalse: [^1]!nameOfDay: dayIndex 	"Answer a symbol representing the name of the day indexed by 	dayIndex, 1 - 7."	^WeekDayNames at: dayIndex!nameOfMonth: monthIndex 	"Answer a symbol representing the name of the month indexed by 	monthIndex, 1 - 12."	^MonthNames at: monthIndex! !Date initialize!Browser subclass: #Debugger	instanceVariableNames: 'context receiverInspector contextInspector shortStack sourceMap sourceCode processHandle mayProceed breakPC '	classVariableNames: 'ContextMenu FullStackMenu HighlightPC '	poolDictionaries: ''	category: 'Tools-Programming'!Debugger comment:'The debugger allows browsing among the stack of contexts of a suspended process.  In addition to viewing the source code at each level, the debugger supports inspection (and change) of temporary and instance variables in each context.Instance Variables:	context				<ContextPart> the currently viewed context	receiverInspector	<Inspector> on instance variables in the current context	contextInspector	<Inspector> on temporary variables in the current context 	shortStack			<Integer | nil> Integer if only that many items of the stack is being shown, nil if full stack	sourceMap			<SortedCollection of: Associations> (pc -> range)	tempNames			<Array of: String>, cached names of the temporary variables	processHandle		<ProcessHandle> holding onto the observed processClass Variables:	ContextMenu 	<ActionMenu> of operations on the sequence of message sends	FullStackMenu  <ActionMenu> of operations on executing the method	HighlightPC 	<Boolean> whether or not to highlight the position in the method at which the interrupt occurred'!!Debugger methodsFor: 'initialize-release'!process: aProcess context: aContext interrupted: aBoolean proceedable: proceedBoolean	sourceCode _ nil.	shortStack _ 9. 	"Default to 9 element stack"	processHandle _ ProcessHandle on: aProcess at: aContext interrupted: aBoolean.	mayProceed _ proceedBoolean!release	processHandle terminate.	context _ nil.	receiverInspector _ nil.	contextInspector _ nil.	super release! !!Debugger methodsFor: 'accessing'!interruptedContext	"Answer the suspended context of the interrupted process."	^processHandle topContext!mayProceed	^mayProceed!selectedClass	"Answer the class object that is currently selected."	^ context == nil		ifTrue: [nil]		ifFalse: [context mclass]! !!Debugger methodsFor: 'dependents access'!removeDependent: aDependent 	super removeDependent: aDependent.	self dependents isEmpty ifTrue: [self release]! !!Debugger methodsFor: 'doIt/accept/explain'!acceptText: aText from: aController 	"Recompile the method of the selected context."	| classOfMethod newSelector newMethod |	context == nil ifTrue: [^ false].	classOfMethod _ context mclass.	newSelector _ classOfMethod parserClass new parseSelector: aText.	newSelector ~~ selector		ifTrue: [self notify: 'selector must not change'].	Cursor execute showWhile:		[newSelector _ classOfMethod				compile: aText				classified: ClassOrganizer defaultProtocol				notifying: aController].	newSelector == nil ifTrue: [^ false].	Cursor execute showWhile:		["**have to handle newMethod needing big stack!!"		newMethod _ classOfMethod compiledMethodAt: newSelector.		sourceCode _ aText string.		newMethod isQuick			ifTrue:  "If compiled quick, we need a non-quick version to put in the context."				[newMethod _ (classOfMethod compilerClass new							parse: sourceCode in: classOfMethod notifying: nil) generateNoQuick].		context _ self homeContext.		newMethod frameSize > context size			ifTrue: [context _ context resizedWith: newMethod].		context restartWith: newMethod.		sourceMap _ context sourceMap.		self resetContext: context.		processHandle interrupted: true].	^ true!doItContext	"Answer the context in which a text selection can be evaluated."	^ context!doItReceiver	"Answer the object that should be informed of the result of evaluating a	text selection."	context == nil ifTrue: [^ nil].	^ context homeReceiver!doItValue: anObject 	"Set the value to be returned when the interrupted process proceeds."	processHandle proceedValue: anObject! !!Debugger methodsFor: 'stack manipulation'!emergencyRestart: anException	"Respond to an Context>>emergencySignal arising during simulation."	| topView labelString aContext |	aContext _ (Object userInterruptSignal accepts: anException signal)		ifTrue: [anException parameter]		ifFalse: [anException initialContext].	labelString _ 'Unhandled exception: ' , anException errorString.	topView _ (self dependents select: [:v | (v isKindOf: View)					and: [v isTopView]]) first.			"sheesh!!"	topView newLabel: labelString.	processHandle topContext: aContext.	self context: aContext.	self changed: #context.	anException initialContext == aContext		ifFalse: [anException initialContext unwindUpTo: aContext].!privateSend	"The top context on the stack must be selected.  This being so, either some message	is about to be sent in that context, or that context is about to return.  Send is only	effective in the former case.  It will cause the next message to be sent.  The send is	actually simulated, so that the debugger will regain control at the beginning of the	method which is invoked (unless it is a primitive).  In this way, you can step your	way deeper into a computation" 	self checkContextSelection.	(context ~~ processHandle topContext) | context willReturn		ifTrue: [^self].	processHandle interrupted ifFalse: [processHandle topContext push: processHandle proceedValue].	processHandle interrupted: true. "simulation leaves same state as interrupting"	context stepUntilVisibleEffect.	self resetContext: context send.	context stepUntilPC: (self stopPC: context pc).	self changed: #pc!privateSkipToCaret	"Executes and stops at the beginning of a statement that the user 	indicates by a caret. The breakPC is one after the last executed pc."	| currContext |	self checkContextSelection.	processHandle interrupted ifFalse: [processHandle topContext push: processHandle proceedValue].	processHandle interrupted: true.	self changed: #breakPC."simulation leaves same state as interrupting"	Context emergencySignal		handle: 			[:ex | 			ex returnDoing: [self emergencyRestart: ex parameter]]		do: [context == processHandle topContext				ifTrue: 					[currContext _ context.					[currContext == context and: [currContext pc < breakPC]]						whileTrue: 							[currContext _ currContext completeCallee: currContext step.							(currContext isMemberOf: Array)								ifTrue: ["handler context"									currContext _ self contextFromHolder: currContext]].					currContext == context ifFalse: [self resetContext: currContext].					self changed: #pc.					self updateInspectors]				ifFalse: 					[currContext _ context.					currContext _ currContext completeCallee: processHandle topContext.					[currContext == context and: [currContext pc < breakPC]]						whileTrue: 							[currContext _ currContext completeCallee: currContext step.							(currContext isMemberOf: Array)								ifTrue: ["handler context"									currContext _ self contextFromHolder: currContext]].					self resetContext: currContext]]!privateStep	"Step will cause the next message to be sent, or the expression to be 	assigned, or the return to be executed.  In either case, the debugger 	regains control so that you can step your way down through a method, 	and out to the caller when it returns."		| currContext |	self checkContextSelection.	processHandle interrupted ifFalse: 		[processHandle topContext push: processHandle proceedValue].	processHandle interrupted: true. "simulation leaves same state as interrupting"	context == processHandle topContext		ifTrue: 			[context stepUntilVisibleEffect.			currContext _ context completeCallee: context step.			(currContext isMemberOf: Array) ifTrue: "handler context"					[currContext _ self contextFromHolder: currContext].			currContext == context ifFalse: "return"				[self resetContext: currContext].			currContext stepUntilPC: (self stopPC: currContext pc).			self changed: #pc.			self updateInspectors]		ifFalse: 			[currContext _ context completeCallee: processHandle topContext.			(currContext isMemberOf: Array) ifTrue: "handler context"					[currContext _ self contextFromHolder: currContext].			currContext stepUntilPC: (self stopPC: currContext pc).			self resetContext: currContext]! !!Debugger methodsFor: 'contextList'!context	"Answer the currently viewed context."		^ context!context: aContext	"Set aContext to be the currently viewed context.  	This involves resetting all the inspectors, the viewed 	source code, and the exception handling signals."	| oldContext class receiver |	oldContext _ context.	context _ aContext.	context == nil		ifTrue:			[contextInspector inspect: nil.			receiverInspector inspect: nil.			self changed: #text.			^self].	receiver _ self contextReceiver.	class _ (receiver == nil 		ifTrue: [context mclass] ifFalse: [receiver class]).	Metaclass obsoleteSignal 		handle: [:ex | className _ context mclass] 		do: 		[meta _ class isMeta.		meta			ifTrue: [className _ class soleInstance name]			ifFalse: [className _ class name].		selector _ context selector.		(oldContext == nil or: [oldContext method ~~ context method])			ifTrue:				[sourceCode _ context sourceCode.				sourceMap _ context sourceMap. "will compute tempNames"				self changed: #text]].	receiver == nil		ifTrue: [receiverInspector inspect: nil.				receiverInspector changed: #empty]		ifFalse: [receiverInspector inspect: receiver].	contextInspector inspect: context.	CompiledCode nPCMapErrorSignal		handle: [:ex | Transcript cr; show: ex errorString]		do: [self changed: #pc]!contextList	"Answer the sequenceable collection containing the messages that 	are accessed from the currently selected context."	^shortStack notNil		ifTrue: 			[| list |			list _ processHandle topContext stackOfSize: shortStack.			list last sender isNil ifTrue: [shortStack _ nil].			list]		ifFalse: [processHandle topContext stack]!contextMenu	"Answer an ActionMenu of operations on the messages that is to be displayed 	when the operate menu button is pressed."	"Debugger flushMenus"	context isNil ifTrue: [^shortStack isNil			ifTrue: [ActionMenu labels: 'proceed' selectors: #(#proceed )]			ifFalse: [ActionMenu					labels: 'more stack\proceed' withCRs					lines: #(1 )					selectors: #(#moreStack #proceed )]].	^shortStack == nil		ifTrue:			[FullStackMenu == nil				ifTrue: [FullStackMenu _ ActionMenu						labels: 'proceed\restart\senders\implementors\messages\skip to caret\step\send' withCRs						lines: #(2 5 )						selectors: #(#proceed #restart #browseSenders #browseImplementors #browseMessages #skipToCaret #step #send )].			FullStackMenu]		ifFalse:			[ContextMenu == nil				ifTrue: [ContextMenu _ ActionMenu							labels: 'more stack\proceed\restart\senders\implementors\messages\skip to caret\step\send' withCRs							lines: #(1 3 6 )							selectors: #(#moreStack #proceed #restart #browseSenders #browseImplementors #browseMessages #skipToCaret #step #send )].			ContextMenu]! !!Debugger methodsFor: 'text'!text	"Answer the text for the source code that should be displayed 	based on the class and message of the currently selected message."	context == nil ifTrue: [^ Text new].	^ sourceCode asText makeSelectorBoldIn: self selectedClass! !!Debugger methodsFor: 'private-inspectors'!contextInspector	^contextInspector!openInspectors	"Further initialization when opening notify view to debug view"	receiverInspector _ Inspector inspect: nil.	contextInspector _ ContextInspector inspect: nil.	self changed: #contextList!receiverInspector	^receiverInspector!updateInspectors	receiverInspector update.	contextInspector update! !!Debugger methodsFor: 'private-menu messages'!correct: aNotifierController	"Attempt to correct the spelling of the not-understood message and resend."	| oldSelector oldFirst oldArgs selectors guess score bestScore |	processHandle topContext selector == #doesNotUnderstand:		ifFalse: [^ aNotifierController view flash].	oldSelector _ (processHandle topContext tempAt: 1) selector.	oldFirst _ oldSelector first.	oldArgs _ oldSelector numArgs.	selectors _ processHandle topContext receiver class allSelectors select:			[:sel | sel first = oldFirst and: [sel numArgs = oldArgs]].	bestScore _ 0.	selectors do:		[:sel |		(score _ sel spellAgainst: oldSelector) > bestScore ifTrue:			[bestScore _ score. guess _ sel]].	(self confirm: 'retry with selector:	', guess) ifFalse: [^ aNotifierController view flash].	processHandle topContext tempAt: 1 put:		(Message selector: guess arguments: (processHandle topContext tempAt: 1) arguments).	^ self proceed!fullStack	"Expand the stack to include all contexts, rather than the first few."	shortStack _ nil.	self changed: #context!moreStack	"If showing a short stack, expand the stack to include twice as many contexts."	shortStack isNil		ifFalse: 			[shortStack _ shortStack * 2].	self changed: #context!proceed	"Proceed from the interrupted state of the currently selected context.	The argument is a controller on a view of the receiver.  That view	is closed."	self checkContextSelection.	(context ~= processHandle topContext) | (processHandle interrupted not) 		ifTrue: [context push: processHandle proceedValue].	context _ context stepUntilProceedable.	self resumeProcess!restart	"Proceed from the initial state of the currently selected context.	The argument is a controller on a view of the receiver.  That view	is closed."	self checkContextSelection.	self revertBlock ifFalse: [^self].	context restart.	self resumeProcess!spawnEdits: aText from: aController	"Open a method browser with aController for the code controller."	| newController | 	context == nil  		ifTrue: [aController view flash "cant spawn changes when deselected"]		ifFalse: [newController _ aController copy.  "Copy gets the changes"				aController cancel; controlTerminate.   "Cancel changes in spawning browser"				BrowserView openMethodBrowserOn: self copy withController: newController]! !!Debugger methodsFor: 'private-pc selection'!breakPCFrom: aController	"The break pc is computed by comparing the location of the caret with a source position in sourceMap. The location of the caret is obtained from the controller 'startBlock' instance variable. The break pc is the pc whose source position last in sourceMap is greater than the location of the caret."	| index |	index _ aController indexOfSelection.	breakPC _ self pcForCharacter: index!pcForCharacter: index	"The break pc is one after the pc whose source position's last element in sourceMap is less than the location of the caret, and whose source position's first element is less than all of the first positions which appeared."	| min firstPos |	sourceMap last value last < index 			ifTrue: [^context method bytesSize].	min _ index.	sourceMap reverseDo: 		[:assoc | 			firstPos _ assoc value first.			firstPos < min ifTrue: 				[min _ firstPos.				assoc value last < index 					ifTrue: [^(sourceMap after: assoc) key]]].	^sourceMap first key!pcRange	"Answer the indices in the source code for the method corresponding	to the selected context's program counter value."	| pc i size end |	(HighlightPC and: [context ~~ nil])		ifFalse: [^1 to: 0].	(sourceMap == nil or: [sourceMap size = 0])		 ifTrue: [^1 to: 0].	pc_ context pc.	(context == processHandle topContext and: [processHandle interrupted])		ifFalse: "When selecting a context in middle of the stack or the context 'halt',				the pc points to the byte code after the send."			[i _ 1. 			size _ sourceMap size.			[i <= size and: [(sourceMap at: i) key < pc]] 				whileTrue: [i _ i + 1].			i > 1 ifTrue: [pc _ (sourceMap at: i - 1) key]].	pc _ pc - 1.	i _ sourceMap indexForInserting: (Association key: pc value: nil).	i < 1 ifTrue: [^1 to: 0].	i > sourceMap size		ifTrue:			[end _ sourceMap inject: 0 into:				[:prev :this | prev max: this value last].			^ end+1 to: end].	^(sourceMap at: i) value!stopPC: pc	"Answer a next stop pc included in the sourceMap.	The optimization compiler can indicate the step's stop pc	in the sourceMap. If a pc is a send or assign byte code pc 	but not in the sourceMap, the step dosen't stop at the pc" 	| nextPC loadFlag mapSize i stopPC pcCache |	nextPC _ pc.	loadFlag _ false.	mapSize _ sourceMap size.	(context isJump: nextPC) 		ifTrue: 				[context stepUntilPC: nextPC.			context step. "execute jump"			nextPC _ context pc].	i _ sourceMap indexForInserting: (Association key: nextPC - 1 value: nil).	i > mapSize ifTrue: [stopPC _ context method bytesSize]				ifFalse: [stopPC _ (sourceMap at: i) key].	[nextPC < stopPC] whileTrue:		[(context isLoad: nextPC) 			ifTrue: 				[loadFlag ifFalse: 					[loadFlag _ true. 					pcCache _ nextPC]]			ifFalse:				[loadFlag _ false].		(context isJump: nextPC) 			ifTrue: 					[context stepUntilPC: nextPC.				context step. "execute jump"				nextPC _ context pc.				i _ sourceMap indexForInserting: 						(Association key: nextPC - 1 value: nil).				i > mapSize 					ifTrue: [stopPC _ context method bytesSize]					ifFalse: [stopPC _ (sourceMap at: i) key]]			ifFalse: 				[nextPC _ context nextPC: nextPC]].	loadFlag ifTrue: [^pcCache] ifFalse: [^nextPC]! !!Debugger methodsFor: 'private-selector functions'!browseMessages	| method |	method _ Object notFoundSignal		handle: [:ex | ex returnWith: context method]				"If a method held in the debugger stack is recompiled 				and become unbound method and the menu messages of 				the unbound method is selected, KeyNotFoundSignal is raised."		do: [self selectedClass compiledMethodAt: selector].	Smalltalk showMenuThenBrowse: 		method messages asSortedCollection! !!Debugger methodsFor: 'private-stack manipulation'!checkContextSelection  	"Determine whether the currently selected context has been set, 	and if not, set it."	context == nil ifTrue: [context _ processHandle topContext]!contextFromHolder: anArray	"Answer the context stored in anArray."	^anArray at: 1!contextReceiver	| ctxt |	context isBlockContext 		ifTrue: [(ctxt _ context home) == nil 					ifTrue: [^nil] 					ifFalse: [^ctxt receiver]]		ifFalse: [^context receiver]!homeContext	| method ctx |	context isBlockContext ifTrue: 		[method _ context method homeMethod.		ctx _ context sender.		[ctx == nil] whileFalse: 				[ctx method == method ifTrue: [^ctx].				ctx _ ctx sender].		self error: 'Unable to restart: block''s home context 					not on the current process''s stack.'].	^context!resetContext: aContext 	"Used when a new context becomes top-of-stack, for instance when the	method of the selected context is re-compiled, or the simulator steps or	returns to a new method."	processHandle topContext: aContext.	context == aContext 		ifFalse: [self context: aContext].	self changed: #context!resumeProcess	processHandle topContext: context.	processHandle resumeProcess!revertBlock	"If the selected context is a block, then restart from beginning of the block or its home."	| index home |	context isBlockContext ifTrue:		[index _ (PopUpMenu labels: ' beginning of block\beginning of method\abort' withCRs)			startUp: #anyButton			withHeading: '  I will restart from '.		index = 1 ifTrue: [^true].		index = 2 ifTrue: 					[home _ context home.						home == nil 							ifTrue: [self context: self homeContext. ^true]							ifFalse: [self context: home. ^ true]].		index = 3 ifTrue: [^false]].		^true! !!Debugger methodsFor: 'private'!process: aProcess context: aContext interrupted: aBoolean 	"Set the instance variables of the receiver."		sourceCode _ nil.	shortStack _ 9. 	"Default to 9 element stack"	processHandle _ ProcessHandle on: aProcess at: aContext interrupted: aBoolean! !!Debugger methodsFor: 'menu messages'!send	"The top context on the stack must be selected.  This being so, either some message	is about to be sent in that context, or that context is about to return.  Send is only	effective in the former case.  It will cause the next message to be sent.  The send is	actually simulated, so that the debugger will regain control at the beginning of the	method which is invokedi (unless it is a primitive).  In this way, you can step your	way deeper into a computation." 	Context codeSimulationErrorSignal		handle: [:ex | (self confirm: 'Simulation error -- shall I restart the method?')						ifTrue: [context restart.								ex restart]						ifFalse: [Transcript cr; show: 'Can''t continue.']]		do: [Context emergencySignal				handle: [:ex |					ex returnDoing: [self emergencyRestart: ex parameter]]				do: [self privateSend]]!skipToCaret	Context codeSimulationErrorSignal		handle: [:ex | (self confirm: 'Simulation error -- shall I restart the method?')						ifTrue: [context restart.								ex restart]						ifFalse: [Transcript cr; show: 'Can''t continue.']]		do: [Context emergencySignal				handle: [:ex |					ex returnDoing: [self emergencyRestart: ex parameter]]				do: [self privateSkipToCaret]]!step	Context codeSimulationErrorSignal		handle: [:ex | (self confirm: 'Simulation error -- shall I restart the method?')						ifTrue: [context restart.								ex restart]						ifFalse: [Transcript cr; show: 'Can''t continue.']]		do: [Context emergencySignal				handle: [:ex |					ex returnDoing: [self emergencyRestart: ex parameter]]				do: [self privateStep]]! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Debugger class	instanceVariableNames: ''!!Debugger class methodsFor: 'class initialization'!flushMenus	"Cause all menus to be newly created (so changes appear)." 	"Debugger flushMenus."	ContextMenu _ nil.	FullStackMenu _ nil!initialize	"Debugger initialize."	HighlightPC _ true! !!Debugger class methodsFor: 'instance creation'!context: aContext 	"Answer an instance of the receiver that models the current state of the system.  The active	process has determined that a debugger should be set up (often by the user issuing	the command debug)."	| aDebugger |	aDebugger _ self new.	aDebugger		process: Processor activeProcess		context: aContext		interrupted: false.	^aDebugger!context: aContext proceedable: aBoolean 	"Answer an instance of me that models the current state of the system.  The active	process has determined that a debugger should be set up (often by the user issuing	the command debug)."	| aDebugger |	aDebugger _ self new.	aDebugger		process: Processor activeProcess		context: aContext		interrupted: false		proceedable: aBoolean.	^aDebugger!interruptProcess: interruptedProcess 	"Answer an instance of the receiver that models the current state of the system.  The active	process has decided to provide a debugger on an interrupted process.  This message	is called if the user types the ctrl c interrupt, or a low space notification occurs."	| debugger |	debugger _ self new.	debugger		process: interruptedProcess		context: interruptedProcess suspendedContext		interrupted: true.	^debugger!openFullViewOn: aDebugger label: aString 	"Answer an instance of the receiver on the model, aDebugger.	The label is aString.  Do not terminate the current active process."	| topView |	aDebugger openInspectors.	topView _ BrowserView model: aDebugger label: aString minimumSize: 300@230.	topView addSubView:			(SelectionInListView on: aDebugger printItems: true oneItem: false				aspect: #context change: #context: list: #contextList				menu: #contextMenu initialSelection: #context)		in: (0@0 extent: 1@0.2) borderWidth: 1.	topView addSubView:			(CodeView on: aDebugger aspect: #text change: #acceptText:from:				menu: #textMenu initialSelection: nil)		in: (0@0.2 extent: 1@0.6) borderWidth: 1.	InspectorView view: aDebugger receiverInspector		in: (0@0.8 extent: 0.5@0.2) of: topView.	InspectorView view: aDebugger contextInspector		in: (0.5@0.8 extent: 0.5@0.2) of: topView.	topView controller openNoTerminate.	^topView! !Debugger initialize!InstructionStream subclass: #Decompiler	instanceVariableNames: 'builder instVars localVars copiedVars tempCount stack statements limit primitive lastPc exit lastJumpPc hasValue openCondition openSign openPc openDepth loopDepth lastAssignment lastAssignVar lastAssignPc '	classVariableNames: 'CascadeFlag CascadeLastFlag '	poolDictionaries: ''	category: 'System-Compiler-Public Access'!Decompiler comment:'Class Decompiler is a translator of CompiledMethods into parse trees.IMPORTANT NOTE: the Decompiler will not be supported indefinitely.  For this reason, we have chosen to provide the Compiler with a switch that controls whether it will produce code that can be decompiled.  Decompilable code is simpler but slower than the more optimized code that the Compiler is capable of producing: specifically, it does not optimize conditional branches where the condition is itself conditional (e.g. an and: or an or:) or a constant.  While the Decompiler is supported, the default setting of this switch will be to produce decompilable code.Because this decision was made after a good deal of work had been expended on getting the Decompiler to decompile optimized code, the Decompiler''s handling of control structures is needlessly complicated.  In particular, it attempts to (but does not correctly) handle arbitrarily complex and:/or: branching structures.  The Compiler will never generate such structures when producing decompilable code.The instance variables builder, instVars, localVars, and tempCount are set at instance creation time, and may be shared with the subordinate Decompilers created for blocks.  copiedVars is set at instance creation time.  The remaining instance variables are used dynamically.Instance Variables:	builder	<ProgramBuilder>	instVars	<OrderedCollection of: VariableNode>	localVars	<OrderedCollection of: (Array of: VariableNode)>	copiedVars	<Array of: VariableNode>	tempCount	<Association value: Integer>	stack	<OrderedCollection of: ProgramNode>	statements	<OrderedCollection of: ProgramNode>	limit	<Integer>	primitive	<Integer | nil>	lastPc	<Integer>	exit	<Integer>	lastJumpPc	<Integer>	hasValue	<Boolean>	openCondition	<ValueNode | nil>	openSign	<Boolean | nil>	openPc	<Integer | nil>	openDepth	<Integer | nil>	loopDepth	<OrderedCollection of: Integer>	lastAssignment	<AssignmentNode | nil>	lastAssignVar	<VariableNode>	lastAssignPc	<Integer>Class Variables:	CascadeFlag 		<ByteString>	CascadeLastFlag	<ByteString>'!!Decompiler methodsFor: 'public access'!decompile: aSelector in: aClass	"Answer with a parse tree for this method."	^self		decompile: aSelector		in: aClass		method: (aClass compiledMethodAt: aSelector)!decompile: aSelector in: aClass method: aMethod	"Answer with a parse tree (root is a MethodNode) for this method."	^self		decompile: aSelector		in: aClass		method: aMethod		using: ProgramNodeBuilder new!decompileBlock: aMethod in: aClass	"Answer with a parse tree (root is a BlockNode) for this block method."	^self		decompileBlock: aMethod		in: aClass		using: ProgramNodeBuilder new! !!Decompiler methodsFor: 'opcodes-data movement'!dupFirst	stack addLast: OrderedCollection new.  "accumulate cascade elements"	stack addLast: CascadeFlag!dupLast	| msg |	msg _ stack removeLast.	stack last addLast: msg.	stack addLast: CascadeLastFlag!dupNext	| msg |	msg _ stack removeLast.	stack last addLast: msg.	stack addLast: CascadeFlag!pop	statements addLast: stack removeLast.	lastAssignPc = lastPc ifTrue: [lastAssignPc _ pc]  "store followed by pop"!pushConstant: value	(value isMemberOf: BlockClosure)		ifTrue: [self codeBlock: value method copied: #()]		ifFalse: [stack addLast: (builder newLiteralValue: value)]!pushContext	self pushVarNamed: 'thisContext'!pushCopiedValues: count	localVars addFirst: (localVars removeFirst , copiedVars)!pushInst: index	self pushVarNamed: (instVars at: index + 1)!pushInst: index outer: level	"Since we can only refer to instance variables	in the outermost scope, we disregard level."	self pushInst: index!pushInstAny: index	"We know this is only generated for	instance variables of the outer receiver."	stack removeLast.  "pop receiver object"	self pushInst: index!pushLocal: index	self pushLocal: index outer: 0!pushLocal: index outer: level	self pushVariable: ((localVars at: level + 1) at: index + 1)!pushReceiver	stack addLast: builder forSelf!pushReceiverOuter: level	"We can only refer to the receiver	in the outermost scope."	self pushReceiver!pushStatic: assoc	self pushVarNamed: assoc key asString!storeInst: index	self pushInst: index; doStore: stack!storeInstAny: index	"We know this is only generated for	instance variables of the outer receiver."	stack removeLast.  "pop receiver object"	self storeInst: index!storeLocal: index	self pushLocal: index; doStore: stack!storePopInst: index outer: level	self pushInst: index outer: level; doStore: statements!storePopLocal: index outer: level	self pushLocal: index outer: level; doStore: statements!storeStatic: assoc	self pushStatic: assoc; doStore: stack! !!Decompiler methodsFor: 'opcodes-control'!callPrimitive: index	" The callPrimitive opcode should not	appear in any method at this time. "	self error: 'Instruction decoding error'!jump: dist	exit _ pc + dist.	lastJumpPc _ lastPc!jump: dist if: condition	self jumpTo: pc + dist if: stack removeLast sign: condition!loopHead	loopDepth addFirst: statements size!makeCopyingBlock: meth count: count	self codeBlock: meth copied: (stack removeLast: count)!makeFullBlock: meth	self codeBlock: meth copied: #()!methodPrimitive: index	primitive _ index!methodReturnTop: levels	exit _ method endPC + 2.	lastJumpPc _ lastPc.	statements addLast: (builder newReturnValue: stack removeLast)!noOp!primitiveReturn	"No action needed"!returnTop	localVars size = 1		ifTrue:  "i.e. we are at method level"			[self methodReturnTop: 0]		ifFalse:  "i.e. we are in a block"			[exit _ method endPC + 1.			lastJumpPc _ lastPc]!send: selector numArgs: na	| args rcvr r node list |	args _ stack removeLast: na.	rcvr _ r _ stack removeLast.	(r == CascadeFlag or: [r == CascadeLastFlag])		ifTrue:			["Get the true receiver of the cascade"			rcvr _ stack at: stack size - 1].	node _ builder newMessageReceiver: rcvr selector: selector arguments: args.	r == CascadeLastFlag		ifTrue:			["This is the last message of a cascade"			list _ stack removeLast.  "cascade list"			list addLast: node.			stack removeLast.  "pop the saved receiver"			node _ builder newCascadeReceiver: rcvr messages: list asArray].	stack addLast: node!sendNoCheck: selector numArgs: na	self send: selector numArgs: na!sendNonImmediate: selector numArgs: na	self send: selector numArgs: na!sendSuper: selector numArgs: na	| rcvr rindex |	stack removeLast.  "remove class"	rindex _ stack size - na.  "index of receiver"	rcvr _ stack at: rindex.	(rcvr == CascadeFlag or: [rcvr == CascadeLastFlag])		ifTrue: [rindex _ rindex - 2].  "back up to cascade receiver"	stack at: rindex put: builder forSuper.  "replace receiver"	self send: selector numArgs: na! !!Decompiler methodsFor: 'private'!buildCond: myCond sign: mySign thenBody: thenBody elseBody: elseBody	| selector args |	elseBody isEmpty		ifTrue:			[selector _ mySign ifTrue: [#ifFalse:] ifFalse: [#ifTrue:].			args _ Array with: (builder newBlockBody: thenBody)]		ifFalse:			[thenBody isEmpty				ifTrue:					[selector _ mySign ifTrue: [#ifTrue:] ifFalse: [#ifFalse:].					args _ Array with: (builder newBlockBody: elseBody)]				ifFalse:					["Check for and: or or:"					mySign						ifTrue: [selector _ #ifFalse:ifTrue:]						ifFalse:							[thenBody booleanValue == true								ifTrue:									[selector _ #or:.									args _ Array with: (builder newBlockBody: elseBody)]								ifFalse:									[elseBody booleanValue == false										ifTrue:											[selector _ #and:.											args _ Array with: (builder newBlockBody: thenBody)]										ifFalse: [selector _ #ifTrue:ifFalse:]]].					args == nil						ifTrue:							[args _ Array with: (builder newBlockBody: thenBody) with: (builder newBlockBody: elseBody)]]].	^builder		newMessageReceiver: myCond		selector: selector		arguments: args!codeBlock: aMethod copied: values	| block |	block _ Decompiler new		decompileMethod: aMethod		builder: builder		instVars: instVars		localVars: localVars		copiedVars: values		tempCount: tempCount.	stack addLast: block!doStore: stackOrBlock	"Handle an assignment.  StackOrBlock is	stack for store, statements for storePop."	| var expr node |	var _ stack removeLast.	expr _ stack removeLast.	node _ builder newAssignmentVariable: var value: expr.	stackOrBlock addLast: node.	lastAssignment _ node.	lastAssignVar _ var.	lastAssignPc _ pc!jumpTo: elseStart if: ifExpr sign: sign	| elsePc end thenBody condHasValue thenJump elseBody elseJump cond ocond osign opc odepth myCond mySign |	elsePc _ lastPc.	end _ limit.	ocond _ openCondition.  osign _ openSign.  opc _ openPc.  odepth _ openDepth.	openCondition _ ifExpr.  openSign _ sign.  openPc _ elseStart.  openDepth _ statements size.	thenBody _ self sequenceTo: elseStart temporaries: #().	myCond _ openCondition.  mySign _ openSign.	openCondition _ ocond.  openSign _ osign.  openPc _ opc.  openDepth _ odepth.	condHasValue _ hasValue.	"We have 3 cases to consider here:		- exit < elseStart : thenBody is a loop body.		- exit <= end : thenBody is the true arm of a conditional.		- exit > end : thenBody is the true arm of a conditional, and ends with a return.  If condHasValue is true, the return is a local return from a block; if condHasValue is false, the return is a method return."	exit < elseStart		ifTrue:			["the jump is to the beginning of the while expr.  In the case of			while's with a block in the condition, the while expr			should include more than just the last expression: find all the			statements needed by using loopDepth."			statements addLast: myCond.			myCond _ builder newSequenceStatements: (statements removeLast: statements size - loopDepth first).			statements addLast:				(thenBody isEmpty					ifTrue:						[builder newCondition: myCond doWhile: mySign not]					ifFalse:						[builder newCondition: myCond while: mySign not do: thenBody]).			loopDepth removeFirst.			lastJumpPc _ nil.  "control falls through after loop"			^self].	(exit <= end and: [exit <= (method endPC + 1)])		ifTrue: ["conditional, no return" thenJump _ exit]		ifFalse: ["conditional with return" thenJump _ elseStart].	elseBody _ self sequenceTo: thenJump temporaries: #().	elseJump _ exit.	"if elseJump is backwards, it is not part of the elseExpr"	elseJump < elsePc		ifTrue: [pc _ lastPc].	cond _ self buildCond: myCond sign: mySign thenBody: thenBody elseBody: elseBody.	(condHasValue and: [elseJump <= end])  "second clause checks for local block return"		ifTrue: [stack addLast: cond]		ifFalse: [statements addLast: cond].	openCondition _ ocond.  openSign _ osign.  openPc _ opc.  openDepth _ odepth.!pushVariable: var	" Check for a store-pop followed by a push. "	(var = lastAssignVar and:	 [statements isEmpty not and:	  [statements last == lastAssignment and:	   [lastAssignPc = lastPc]]])		ifTrue:			[stack addLast: statements removeLast]		ifFalse:			[stack addLast: var]!pushVarNamed: name	self pushVariable: (builder newVariableName: name)!sequenceTo: end temporaries: temps	"Decompile a range of code as in statementsTo:,	but return a sequence."	^builder		newSequenceTemporaries: temps		statements: (self statementsTo: end)!statementsTo: end	| oldLimit blockPos stackPos |	"Decompile the method from pc up to end and return an array of	expressions.  If at run time this block will leave a value on	the stack, set hasValue to true.  If the block ends with a jump or return,	set exit to the destination of the jump, or the end of the method;	if the block ends with a conditional jump,	set exit to the destination of the jump; otherwise, set exit = end.	Leave pc = end."	oldLimit _ limit.	blockPos _ statements size.	stackPos _ stack size.	limit _ end.	[pc < limit]		whileTrue:			[lastPc _ pc.			self interpretNextInstructionFor: self].	"If there is an additional item on the stack, it will be the value	of this block."	(hasValue _ stack size > stackPos)		ifTrue:			[self pop].	lastJumpPc = lastPc ifFalse: [exit _ pc].	limit _ oldLimit.	^statements removeLast: (statements size - blockPos)! !!Decompiler methodsFor: 'private-initialize-release'!decompile: aSelector in: aClass method: aMethod using: aBuilder 	| block |	block _ self		decompileMethod: aMethod		builder: aBuilder		instVars: aClass allInstVarNames		localVars: OrderedCollection new		copiedVars: #()		tempCount: (Association key: nil value: 0).	^builder		newMethodSelector: aSelector		primitive: primitive		block: block!decompileBlock: aMethod in: aClass using: aBuilder 	| meth |	"Construct local variables for enclosing scopes"	meth _ aMethod.	localVars _ OrderedCollection new.	tempCount _ Association key: nil value: 0.	[meth _ meth outerMethod.	meth isBlockMethod]		whileTrue:			[localVars addFirst: (self newTemps: meth numTemps + meth numCopiedValues)].	localVars addFirst: (self newTemps: meth numTemps).	^self		decompileMethod: aMethod		builder: aBuilder		instVars: aClass allInstVarNames		localVars: localVars		copiedVars: (self newTemps: aMethod numCopiedValues)		tempCount: tempCount!decompileMethod: aMethod builder: aBuilder instVars: ivars localVars: lvars copiedVars: copied tempCount: tc	| locals body |	"Initialize the instance from the arguments"	super method: aMethod.	builder _ aBuilder.	instVars _ ivars.	localVars _ lvars.	copiedVars _ copied.	tempCount _ tc.	"Initialize the rest of the instance"	stack _ OrderedCollection new: aMethod frameSize.	statements _ OrderedCollection new: 20.	primitive _ nil.	loopDepth _ OrderedCollection new.	"Decompile the method"	locals _ self newTemps: method numTemps.	localVars addFirst: locals.	locals _ locals collect: [:var | builder newParameterVariable: var].	body _ self		sequenceTo: method endPC + 1		temporaries: (locals copyFrom: method numArgs + 1 to: locals size).	stack isEmpty ifFalse: [self error: 'stack not empty'].	localVars removeFirst.	^builder		newBlockArguments: (locals copyFrom: 1 to: method numArgs)		body: body!newTemps: count	"Generate this many new temp names"	| temp |	^(1 to: count) collect:		[:i |		temp _ tempCount value + 1.		tempCount value: temp.		builder newVariableName: ('t', temp printString)]! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Decompiler class	instanceVariableNames: ''!!Decompiler class methodsFor: 'class initialization'!initialize	"Decompiler initialize"	CascadeFlag _ 'cascade' copy.  "a unique object"	CascadeLastFlag _ 'cascadeLast' copy  "ditto"! !Decompiler initialize!Object subclass: #DeferredBlock	instanceVariableNames: 'outer litIndex innerCopying innerFull storeCounts startLabel endLabel '	classVariableNames: ''	poolDictionaries: 'OpcodePool '	category: 'System-Compiler-Support'!DeferredBlock comment:'I represent a block whose nature (copying or full) cannot be determined until later.  The code in the outer scope assumes this is a copying block; we go back and patch up the code and the literal later if this turns out to be wrong.Instance variables:	outer	<CodeStream>  "the code stream for the enclosing scope"	litIndex	<Integer>  "the literal index of the inner block method in the outer method"	innerCopying	<CodeStream>  "the code stream for the block, assuming copying"	innerFull	<CodeStream>  "the code stream for the block, assuming no copying"	startLabel	<CodeLabel>  "the starting position of the copying block code in the outer method''s bytes"	endLabel	<CodeLabel>  "the end position of the same"We use labels, rather than simple integers, for the starting and ending positions so that they will be fixed up properly if long jumps get scrunched into short ones.'!!DeferredBlock methodsFor: 'initialize'!outer: outerStream literalIndex: index copying: copyingStream full: fullStream storeCounts: stores start: startL end: endL	outer _ outerStream.	litIndex _ index.	innerCopying _ copyingStream.	innerFull _ fullStream.	storeCounts _ stores.	startLabel _ startL.	endLabel _ endL! !!DeferredBlock methodsFor: 'code generation'!complete	"Convert a copying method to a full method	if appropriate."	| outm fullm start |	(innerCopying checkStores: storeCounts)		ifTrue: [^self].  "Copying block is still OK, don't need to convert"	outm _ outer method.	fullm _ innerFull method.	outm literalAt: litIndex + 1 put: fullm.	fullm outerMethod: outm.	start _ startLabel definition + 1.	outm byteAt: start put: OpFullBlock.	outm byteAt: start + 1 put: litIndex.	start + 2 to: endLabel definition do:		[:i | outm byteAt: i put: OpNoOp]! !Object subclass: #DefineOpcodePool	instanceVariableNames: ''	classVariableNames: 'ExtendedSpecialSelectors FirstShortSend LastShortLoad LastShortOp LastShortSend LastXOp MaxLoadInst MaxLoadLiteral MaxLoadSmallInteger MaxLoadStatic MaxLoadTemp MaxLoadTempNextOuter MaxPopLoadTemp MaxSendNumArgs MaxSends MaxSendSelf0 MaxShortBranchFalse MaxShortJump MaxShortSpecialSend MaxStorePopInst MaxStorePopTemp MinShortBranchFalse MinShortJump OpCallPrimitive OpCopyingBlock OpCopyValues OpDupFirst OpDupNext OpFullBlock OpHomeReturn OpLoadByte OpLoadCharacter OpLoadFalse OpLoadInst OpLoadInstAny OpLoadInstOuter OpLoadLiteral OpLoadNil OpLoadReceiver OpLoadReceiverNextOuter OpLoadReceiverOuter OpLoadStatic OpLoadTemp OpLoadTempNextOuter OpLoadTempOuter OpLoadThisContext OpLoadTrue OpLoadTwoBytes OpLoadZero OpLongBranchFalse OpLongBranchTrue OpLongJump OpLoopHead OpNoDup OpNoOp OpPop OpPopLoadReceiver OpPopLoadTemp OpPopReturnReceiver OpPrimitive OpPrimReturn OpReturn OpReturnFalse OpReturnNil OpReturnReceiver OpReturnTrue OpSendAdd1 OpSends OpSendSelf0 OpShortBranchFalse OpShortJump OpSpecialSend OpStoreInstAny OpStorePopInst OpStorePopTemp OpStorePopTempOuter OpXLoadInst OpXLoadInstOuter OpXLoadLiteral OpXLoadStatic OpXLoadTemp OpXLoadTempOuter OpXNoCheckSend OpXNoCheckSpecialSend OpXNonImmediateSend OpXNonImmediateSpecialSend OpXSend OpXSpecialSend OpXStorePopInst OpXStorePopInstOuter OpXStorePopStatic OpXStorePopTemp OpXStorePopTempOuter OpXSuper OpXXNoCheckSend OpXXNonImmediateSend OpXXSend OpXXSuper SpecialSelectorDictionary SpecialSelectors '	poolDictionaries: ''	category: 'System-Compiler-Support'!DefineOpcodePool comment:'This class exists only to define the OpcodePool dictionary.  It creates the dictionary as its own class variable dictionary, and then copies all the entries into the pool.Changing the instruction set requires changing the following classes:	- DefineOpcodePool class, to define the Opxxx static variable.	- CodeStream (perhaps), to generate the opcode when compiling.	- InstructionStream, to decode the opcode.	- If the semantics have been changed or extended,	  all the subclasses of InstructionClient,	  such as simulators, printers, decompilers, and analyzers.Of course, changes in the VM will also be necessary.'!"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!DefineOpcodePool class	instanceVariableNames: ''!!DefineOpcodePool class methodsFor: 'class initialization'!initialize	"DefineOpcodePool initialize"	self initializeSpecialSelectors.	"Define all the bytecodes.	We have to do this in pieces	because there are so many."	self defineShortLoads.	self defineShortOther.	self defineTwoByteCodes.	self defineThreeByteCodes.	"Now install the pool.  This is a little	tricky: we really want to share the	Associations, not make new ones,	if possible."	(Smalltalk at: #OpcodePool ifAbsent: [nil]) isNil ifTrue:		[Smalltalk at: #OpcodePool put: Dictionary new].	self classPool associationsDo:		[:assoc | OpcodePool add: assoc]! !!DefineOpcodePool class methodsFor: 'private-initialization'!defineShortLoads	| op m |	op _ 0.	OpLoadInst _ op.  m _ MaxLoadInst _ 15.	OpLoadTemp _ op _ op + m + 1.  m _ MaxLoadTemp _ 11.	OpLoadLiteral _ op _ op + m + 1.  m _ MaxLoadLiteral _ 15.	OpLoadTempNextOuter _ op _ op + m + 1.  m _ MaxLoadTempNextOuter _ 7.	OpLoadStatic _ op _ op + m + 1.  m _ MaxLoadStatic _ 11.	OpNoOp _ op _ op + m + 1.	  op _ op + 2.  "UNASSIGNED"	OpPrimReturn _ op _ op + 1.	"Next 5 must stay in order, to match OpReturnxxx"	OpLoadReceiver _ op _ op + 1.	OpPopLoadReceiver _ op _ op + 1.	OpLoadNil _ op _ op + 1.	OpLoadTrue _ op _ op + 1.	OpLoadFalse _ op _ op + 1.	OpLoadZero _ op _ op + 1.  m _ MaxLoadSmallInteger _ 2.	  op _ op + m + 1.	OpStorePopTemp _ op.  m _ MaxStorePopTemp _ 7.	  op _ op + m + 1.	OpLoadThisContext _ op.	OpLoadReceiverNextOuter _ op _ op + 1.	OpPopLoadTemp _ op _ op + 1.  m _ MaxPopLoadTemp _ 1.	OpStorePopInst _ op _ op + m + 1.  m _ MaxStorePopInst _ 7.	  op _ op + m + 1.	LastShortLoad _ op - 1!defineShortOther	| op m |	op _ LastShortLoad + 1.	"Next 5 must stay in order to match OpLoadxxx"	OpReturnReceiver _ op.	OpPopReturnReceiver _ op _ op + 1.	OpReturnNil _ op _ op + 1.	OpReturnTrue _ op _ op + 1.	OpReturnFalse _ op _ op + 1.	OpReturn _ op _ op + 1.	OpPop _ op _ op + 1.	OpLoopHead _ op _ op + 1.	OpDupFirst _ op _ op + 1.	OpDupNext _ op _ op + 1.	OpNoDup _ op _ op + 1.	OpShortJump _ op _ op + 1.  MinShortJump _ 1.  MaxShortJump _ 5.	  op _ op + MaxShortJump - MinShortJump + 1.	"Check opcode numbering"	(op = 16r70) ifFalse: [self error: 'Opcode numbering is wrong'].	FirstShortSend _ op.	MaxSends _ #(15 15 7).	MaxSendNumArgs _ MaxSends size - 1.	m _ -1.	OpSends _ MaxSends collect: [:m1 | op _ op + m + 1.  m _ m1.  op].	OpSendSelf0 _ op _ op + m + 1.  m _ MaxSendSelf0 _ 7.	OpSpecialSend _ op _ op + m + 1.  m _ MaxShortSpecialSend _ 31.	  op _ op + m + 1.	LastShortSend _ op - 1.	OpShortBranchFalse _ op.  MinShortBranchFalse _ 1.  MaxShortBranchFalse _ 8.	  op _ op + MaxShortBranchFalse - MinShortBranchFalse + 1.	OpSendAdd1 _ op.	LastShortOp _ op!defineThreeByteCodes	| op |	op _ 16rF3.	"Check opcode numbering"	(op > LastXOp) ifFalse: [self error: '3-byte opcodes overlap'].	OpXXNonImmediateSend _ op.	OpXXNoCheckSend _ op _ op + 1.	  op _ op + 1.  "UNASSIGNED"	OpCallPrimitive _ op _ op + 1.	OpXLoadInstOuter _ op _ op + 1.	OpXLoadTempOuter _ op _ op + 1.	OpLoadTwoBytes _ op _ op + 1.	OpXStorePopInstOuter _ op _ op + 1.	OpXStorePopTempOuter _ op _ op + 1.	OpXXSend _ op _ op + 1.	OpXXSuper _ op _ op + 1.	OpPrimitive _ op _ op + 1.	OpCopyingBlock _ op _ op + 1.	"Check opcode numbering"	(op <= 16rFF) ifFalse: [self error: 'Too many opcodes']!defineTwoByteCodes	| op |	op _ 16rC9.	"Check opcode numbering"	(op > LastShortOp) ifFalse: [self error: '2-byte opcodes overlap'].	OpLoadInstAny _ op.	OpStoreInstAny _ op _ op + 1.	OpCopyValues _ op _ op + 1.	OpXNoCheckSend _ op _ op + 1.	OpXNonImmediateSend _ op _ op + 1.	OpXNonImmediateSpecialSend _ op _ op + 1.	OpFullBlock _ op_ op + 1.	OpXLoadInst _ op _ op + 1.	OpXLoadTemp _ op _ op + 1.	OpXLoadLiteral _ op _ op + 1.	OpXLoadStatic _ op _ op + 1.	OpLoadInstOuter _ op _ op + 1.	OpLoadTempOuter _ op _ op + 1.	OpLoadReceiverOuter _ op _ op + 1.	OpLoadCharacter _ op _ op + 1.	OpLoadByte _ op _ op + 1.	  op _ op + 1.  "UNASSIGNED"	OpXStorePopInst _ op _ op + 1.	OpXStorePopTemp _ op _ op + 1.	OpXStorePopStatic _ op _ op + 1.	OpStorePopTempOuter _ op _ op + 1.	OpHomeReturn _ op _ op + 1.	OpXNoCheckSpecialSend _ op _ op + 1.	OpLongJump _ op _ op + 1.	OpLongBranchFalse _ op _ op + 8.  "nota bene +8"	OpLongBranchTrue _ op _ op + 4.  "nota bene +4"	op _ op + 4.  "nota bene +4"	OpXSpecialSend _ op.	OpXSend _ op _ op + 1.	OpXSuper _ op _ op + 1.	LastXOp _ op!extendedSpecialSelectors	"These are the most common selectors	(with at least 20 occurrences)	in the current license image.	IF YOU CHANGE THIS LIST,	YOU WILL HAVE TO RECOMPILE THE	ENTIRE SYSTEM TWICE!!"	^#(, error: name nextPutAll: to:do: cr on: add: contents extent: isEmpty boundingBox isNil text subclassResponsibility ~~ first max: with: includes: last printString close controller asSymbol notNil mustBeInteger: not copy release black basicAt: top extent cursorPoint isKindOf: height show: changed: copyFrom:to: initialize primitiveFailed species position test:labeled:repeated: space showWhile: origin addLast: print: deselect truncated includesKey: to: key min: displayOn:at:clippingBox:rule:mask: over printOn: isMemberOf: string & insetDisplayBox asText width asFloat model: topLeft basicSize at:ifAbsent: perform: negated asciiValue open white organization push: translateBy: center lineGrid with:with: operation:with:with: collect: controlTerminate selectedClass new asString mustBeString: withCRs basicAt:put: display inside controlInitialize displayOn:at: unixStringFrom: method reverse scanToken allBehaviorsDo: nextChunkPut: align:with: displayOn: displayBox form: form | borderWidth: gray fill:rule:mask: show stringIndex digitLength changeRequest select: rounded associationsDo: fromDisplay: replaceSelectionWith: fileName readOnly expected: execute offset operation:with: compositionRectangle mustBeStructure:ofLength: skip: pop: receiver fill:mask: corner crtab: basicNew between:and: operation:with:with:with: compiledMethodAt: hash addAll: insideColor: viewport waitButton intersect: tab normal word printOn:indent: left addSubView: wait redButtonPressed corner: bottom digitAt: retry:coercing: isCollapsed label: instSize notify: timesRepeat: window: containsPoint: insetBy: isVariable reset changes labels:lines:selectors: )!frequentSpecialSelectors	"Find the most common selectors	for economical encoding."	"DefineOpcodePool frequentSpecialSelectors"	| dict sorted sels |	dict _ IdentityDictionary new: Symbol instanceCount * 2.	CompiledMethod allInstancesDo:		[:cmeth | cmeth literals do:			[:lit | (lit isSymbol) ifTrue:				[dict at: lit put: (dict at: lit ifAbsent: [0]) + 1]]].	sorted _ SortedCollection new: 500.	dict associationsDo:		[:a | a value >= 20 ifTrue:			[sorted add: (Association key: a value negated value: a key)]].  "negated to sort in descending order"	sels _ OrderedCollection new.	sorted do: [:a | sels add: a value].	^sels asArray!initializeSpecialSelectors	| index shortSpecialSelectors seq dict |	shortSpecialSelectors _ #(		+ - < > <= >= = ~=		* // @ , extent: isNil notNil isEmpty		at: at:put: size next nextPut: nextPutAll: == class		add: value value: do: new new: x y	).	ExtendedSpecialSelectors _ self extendedSpecialSelectors.	index _ 0.	dict _ IdentityDictionary new: 256 * 2.	seq _ OrderedCollection new: 256 * 2.	shortSpecialSelectors do:		[:sel | seq add: sel; add: sel numArgs.		dict at: sel put: (index _ index - 1)].	ExtendedSpecialSelectors do:		[:sel | (dict includesKey: sel) ifFalse:			[index > -255 ifTrue:				[seq add: sel; add: sel numArgs.				dict at: sel put: (index _ index - 1)]]].	SpecialSelectorDictionary _ dict.	SpecialSelectors _ seq asArray! !DefineOpcodePool initialize!Object subclass: #Delay	instanceVariableNames: 'delayDuration resumptionTime delaySemaphore delayInProgress '	classVariableNames: 'AccessProtect ActiveDelay SnapshotTime SuspendedDelays TimingSemaphore '	poolDictionaries: ''	category: 'Kernel-Processes'!Delay comment:'Class Delay represents a real time delay in the execution of a Process.  An instance of Delay will respond to the message #wait by suspending the active process for a certain amount of time.  The time for resumption of the active process is specified when the Delay is created.  	 The resumption time can be specified relative to the current time with the messages {Delay forMilliseconds: anInteger} and{Delay forSeconds: anInteger}. Delays created in this way can be sent the message #wait again after they have finished a previous delay. 	 The resumption time can also be specified at an absolute time with respect to the system''s millisecond clock with the message {Delay untilMillisecond: anInteger}. Delays created in this way cannot be sent the message #wait repeatedly.Instance Variables: 	delayDuration		<Integer> number of milliseconds to delay process	resumptionTime		<Integer> value of millisecond clock at which to resume	delaySemaphore	<Semaphore> on which to delay process	delayInProgress		<Boolean> true if delaying nowClass Variables:	AccessProtect		<Semaphore>	ActiveDelay		<Semaphore>	SnapshotTime		<Array>	SuspendedDelays	<SortedCollection> of Delays	TimingSemaphore 	<Semaphore>	'!!Delay methodsFor: 'accessing'!delaySemaphore	"Answer the semaphore which will be signaled when the	delay expires."	^delaySemaphore!resumptionTime	"Answer the value of the system's millisecondClock at which the receiver's 	suspended Process will resume."	^resumptionTime! !!Delay methodsFor: 'process delay'!disable	"Remove the receiver from the queue of delayed processes to be serviced."	AccessProtect wait.	delayInProgress ifTrue:		[ActiveDelay == self			ifTrue: [SuspendedDelays isEmpty						ifTrue: [Processor signal: nil atTime: 0.								ActiveDelay _ nil]						ifFalse: [SuspendedDelays removeFirst activate]]			ifFalse: [SuspendedDelays remove: self].		delaySemaphore terminateProcess.		delayInProgress _ false].	AccessProtect signal!startup	"Signal the delay's semaphore in the amount of time specified when the 	receiver was initialized."	"(ActiveDelay == nil or: [ActiveDelay resumptionTime  > Time millisecondClockValue])		ifFalse: [TimingSemaphore signal]."	AccessProtect wait.	self setResumption.	ActiveDelay == nil		ifTrue: [self activate]		ifFalse: [resumptionTime < ActiveDelay resumptionTime				ifTrue: 					[SuspendedDelays add: ActiveDelay.					self activate]				ifFalse: 					[SuspendedDelays add: self]].	AccessProtect signal!wait	"Suspend the active process for an amount of time specified when the 	receiver was initialized."	self startup.	delaySemaphore wait! !!Delay methodsFor: 'testing'!inProgress	"Answer true if the delay is still pending."	^delayInProgress! !!Delay methodsFor: 'private'!activate	"For the moment, the receiver will be the next Delay to resume the	reciever's suspended process."	ActiveDelay _ self.	TimingSemaphore initSignals.	Processor signal: TimingSemaphore atTime: resumptionTime!delay: millisecondCount 	delayDuration _ millisecondCount.	delayInProgress _ false.	delaySemaphore _ Semaphore new!delayInProgress: aBoolean	delayInProgress _ aBoolean!postSnapshot	"Reset the resumption time on a returnFromSnapshot"	(delayInProgress and: [resumptionTime ~~ nil])		ifTrue:			[| pendingDelay |			"convert from old relative time to absolute time"			pendingDelay _ resumptionTime - (SnapshotTime at: 1).			pendingDelay _ (SnapshotTime at: 2) * 1000 + pendingDelay.			"convert from absolute time to new relative time"			pendingDelay _ pendingDelay - (Time totalSeconds * 1000).			pendingDelay _ pendingDelay max: 0.			resumptionTime _ Time millisecondClockValue + pendingDelay]!reactivate	"Make sure the timer is armed to go off for this delay."	delayInProgress ifTrue:		[TimingSemaphore initSignals.		Processor signal: TimingSemaphore atTime: resumptionTime]	"if false then the timer has already fired for this delay and it is waiting (on AccessProtect) to resume"!resume	"The receiver's delay duration has expired, the process the receiver	suspended will resume now. "	Processor signal: nil atTime: 0.	delayInProgress _ false.	delaySemaphore signal!resumption: millisecondCount 	delayDuration _ nil.	resumptionTime _ millisecondCount.	delayInProgress _ false.	delaySemaphore _ Semaphore new!setResumption	delayInProgress		ifTrue: [self error: 'This Delay is already waiting']		ifFalse: 			[delayDuration == nil				ifTrue: [resumptionTime == nil ifTrue: [self error: 'uninitialized Delay']]				ifFalse: [resumptionTime _ Time millisecondClockValue + delayDuration].			delayInProgress _ true]! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Delay class	instanceVariableNames: ''!!Delay class methodsFor: 'class initialization'!initialize	"Initialize class variables that keep track of active Delays."	"Delay initialize."	TimingSemaphore _ Semaphore new.	AccessProtect _ Semaphore forMutualExclusion.	SuspendedDelays _ 		SortedCollection sortBlock: 			[:oldDelay :addedDelay | 			oldDelay resumptionTime <= addedDelay resumptionTime].	ActiveDelay _ nil.	self initializeTimingProcess! !!Delay class methodsFor: 'instance creation'!forMilliseconds: millisecondCount 	"Answer a new instance that will delay the active process for 	millisecondCount milliseconds when sent the message wait."	^self new delay: millisecondCount!forSeconds: secondCount 	"Answer a new instance that will delay the active process for secondCount seconds when sent the message wait."	^self new delay: (secondCount * 1000) rounded!untilMilliseconds: millisecondCount 	"Answer a new instance that will delay the active process until the 	system's millisecond clock value is millisecondCount when sent the 	message wait."	^self new resumption: millisecondCount! !!Delay class methodsFor: 'general inquiries'!millisecondClockValue	"Answer the current value of the system's millisecond clock."	^Time millisecondClockValue! !!Delay class methodsFor: 'snapshots'!install	"When returning from a snapshot, reset all delays to be relative	to the current absolute time"	ActiveDelay~~nil		ifTrue: [ActiveDelay postSnapshot.				  SuspendedDelays do: [ :delay | delay postSnapshot].				  ActiveDelay reactivate].	AccessProtect signal!postSnapshot	"After making a snapshot, exit the critical section preventing	Delays from firing"	AccessProtect signal!preSnapshot	"Before making a snapshot, enter a critical section that prevents	Delays from firing.  Then, record the current absolute time, so	that Delays can be updated on returning from snapshot"	AccessProtect wait.	SnapshotTime _ Array with: Time millisecondClockValue with: Time totalSeconds! !!Delay class methodsFor: 'examples'!testAbsoluteDelayOf: delay for: testCount label: label 	"Example use of Delay.	Transcript cr. 	 Delay testAbsoluteDelayOf: 1000 for: 10 label: 'A'. 	 Delay testAbsoluteDelayOf: 1500 for: 10 label: 'B'.	"	| time |	time _ Delay millisecondClockValue.	[1 to: testCount do: 		[:index | 		(Delay untilMilliseconds: time + (index * delay)) wait.		Transcript show: label.		Transcript show: index printString.		Transcript space]]		forkAt: Processor userInterruptPriority!testRelativeDelayOf: delay for: testCount label: label 	"Example use of Delay."	"Transcript cr. 	 Delay testRelativeDelayOf: 1000 for: 10 label: 'A'. 	 Delay testRelativeDelayOf: 1500 for: 10 label: 'B'"	| myDelay |	myDelay _ Delay forMilliseconds: delay.	[1 to: testCount do: 		[:index | 		myDelay wait.		Transcript show: label.		Transcript show: index printString.		Transcript space]]		forkAt: Processor userInterruptPriority! !!Delay class methodsFor: 'private'!initializeTimingProcess	[[true]		whileTrue: 			[TimingSemaphore wait.			AccessProtect wait.			ActiveDelay == nil				ifFalse:					[ActiveDelay delayInProgress: false.					ActiveDelay resume].			SuspendedDelays isEmpty				ifTrue: [ActiveDelay _ nil]				ifFalse: [SuspendedDelays removeFirst activate].			AccessProtect signal]]		forkAt: Processor timingPriority! !Delay initialize!Array variableSubclass: #DependentsCollection	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'System-Support'!DependentsCollection comment:'A DependentsCollection is a collection of dependents for some object.  Instances forward update messages to the dependents, which are the elements of the collection.  Note that the same dependent may appear more than once in the collection.  Note also that the size of a DependentsCollection must always be 2 or greater.  (If an object has only one dependent, that object by itself serves as the collection of dependents.)'!!DependentsCollection methodsFor: 'accessing'!asDependentsAsCollection	" Answer the receiver, considered as a	collection of dependents, as a real	Collection.  Since the receiver is a	Collection already, answer the receiver. "	^self!asDependentsWith: anObject	" Answer the receiver, considered as a	collection of dependents, with anObject	added. "	^self copyWith: anObject!asDependentsWithout: anObject	" Answer the receiver, considered as a	collection of dependents, with the first	occurrence of anObject (if any) removed.	If anObject does not occur in the receiver,	answer the receiver. "	" If there is only one dependent left,	just answer it, rather than a new Collection. "	| newCollection item size indx |	size _ self size.	size = 2 ifTrue:		[(self at: 1) == anObject			ifTrue: [^self at: 2]			ifFalse:				[(self at: 2) == anObject					ifTrue: [^self at: 1]					ifFalse: [^self]]].	newCollection _ self class new: size - 1.	indx _ 1.	" Search until we find an occurrence of	anObject, or until we have copied all but	the last item in the collection. "	[indx = size or:	  [item _ self at: indx.	  item == anObject]]		whileFalse:			[newCollection at: indx put: item.			indx _ indx + 1].	indx = size		ifTrue:			[(self at: size) == anObject				ifTrue: [^newCollection]				ifFalse: [^self]]		ifFalse: 			[newCollection replaceFrom: indx to: size - 1 with: self startingAt: indx + 1.			^newCollection]! !!DependentsCollection methodsFor: 'updating'!performUpdate: aSymbol	"Send aSymbol to each member of the receiver."	1 to: self size do:		[:i |		(self at: i) perform: aSymbol]!performUpdate: aSymbol with: anObject	"Send aSymbol to each member of the receiver with anObject as argument."	1 to: self size do:		[:i |		(self at: i) perform: aSymbol with: anObject]!update: anAspect with: aParameter from: anObject	"Send the message update: anAspect with: aParameter from: anObject to each member of the receiver."	1 to: self size do:		[:i |		(self at: i) update: anAspect with: aParameter from: anObject]!updateRequest	"Send the message updateRequest to each member of the receiver.	If one answers false answer falase otherwise answer true."	1 to: self size do:		[:i |		(self at: i) updateRequest			ifFalse: [^false]].	^true!updateRequest: anAspectSymbol	"Send the message updateRequest: to each member of the receiver with anAspectSymbol as argument.	If one answers false answer falase otherwise answer true."	1 to: self size do:		[:i |		((self at: i) updateRequest: anAspectSymbol)			ifFalse: [^false]].	^true! !IdentityDictionary variableSubclass: #DependentsDictionary	instanceVariableNames: 'length fullTally '	classVariableNames: ''	poolDictionaries: ''	category: 'System-Support'!DependentsDictionary comment:'A DependentsDictionary holds the dependents for objects that are the keys of the instance.  The values are either the sole dependent of an object or a DependentsCollection of dependents.Instance Variables:	length		<SmallInteger>   the basicSize of the instance 	fullTally	<SmallInteger>   the amount the instance can hold before growing is necessary '!!DependentsDictionary methodsFor: 'access'!at: anObject add: aDependentObject	"Add aDependentObject to anObject's dependents."	| deps indx obj |	indx _ self findKeyOrNil: anObject.	(obj _ self basicAt: indx) == nil		ifTrue:			[tally _ tally + 1.			self basicAt: indx put: anObject.			deps _ aDependentObject]		ifFalse:			[deps _ (valueArray at: indx) asDependentsWith: aDependentObject].	valueArray at: indx put: deps.	obj == nil ifTrue: [self fullCheck].	^aDependentObject!at: anObject remove: aDependentObject	"Remove aDependentObject from anObject's dependents."	| deps indx |	indx _ self findKeyOrNil: anObject.	(self basicAt: indx) == nil		ifTrue: [^aDependentObject].	deps _ (valueArray at: indx) asDependentsWithout: aDependentObject.	deps == nil		ifTrue:			[self removeAndCleanUpAtIndex: indx.			^aDependentObject].	valueArray at: indx put: deps.	^aDependentObject!atOrNil: anObject	"Answer a nil, singleton, or DependentsCollection of the objects that are dependent on the receiver, that is, the objects that should be notified if the receiver changes."	"^self at: anObject ifAbsent: [nil]"	| index probe start |	index _ anObject identityHash \\ length + 1.	start _ index.	[(probe _ self basicAt: index) == nil		ifTrue: [^nil].	probe == anObject		ifTrue: [^valueArray at: index].	(index _ index + 1) <= length] whileTrue.	index _ 1.	[(probe _ self basicAt: index) == nil		ifTrue: [^nil].	probe == anObject		ifTrue: [^valueArray at: index].	(index _ index + 1) < start] whileTrue.	^nil!collectionAt: anObject	"Answer a Collection of the objects that are dependent on the receiver, that is, the objects that should be notified if the receiver changes."	| index probe start |	index _ anObject identityHash \\ length + 1.	start _ index.	[(probe _ self basicAt: index) == nil ifTrue: [^#()].	probe == anObject		ifTrue: [^(valueArray at: index) asDependentsAsCollection].	(index _ index + 1) <= length] whileTrue.	index _ 1.	[(probe _ self basicAt: index) == nil ifTrue: [^#()].	probe == anObject		ifTrue: [^(valueArray at: index) asDependentsAsCollection].	(index _ index + 1) < start] whileTrue.	^#()!removeKeyNoError: anObject	"Remove anObject as a key from the receiver."	self removeKey: anObject ifAbsent: []! !!DependentsDictionary methodsFor: 'private'!findKeyOrNil: key 	"Look for the key in the receiver.  If it is found, answer the index of 	the key, otherwise answer the index of the first unused slot."	| index probe pass |	pass _ 1.	index _ key identityHash \\ length + 1.	[(probe _ self basicAt: index) == nil or: [probe == key]]		whileFalse: [(index _ index + 1) > length				ifTrue: 					[index _ 1.					pass _ pass + 1.					pass > 2 ifTrue: [^self grow findKeyOrNil: key]]].	^index!fullCheck	"Check the receiver to see if growing is necessary."	tally >= fullTally		ifTrue: [self grow]!setTally	"Initialize tally and other instance variables."	super setTally.	length _ self basicSize.	fullTally _ length - (length // 4)! !Set variableSubclass: #Dictionary	instanceVariableNames: ''	classVariableNames: 'KeyNotFoundSignal ValueNotFoundSignal '	poolDictionaries: ''	category: 'Collections-Unordered'!Dictionary comment:'A Dictionary is a set of associations.Several special kinds of Dictionaries exist in the system. They are	IdentityDictionary		do lookup using == rather than =	MethodDictionary		like IdentityDictionary except removal is implemented as an atomic operation	LiteralDictionary 		check for equality and class of keys;  used by the compiler	SystemDictionary		contains information about the systemInstance Variables: *indexed*Class Variables:	KeyNotFoundSignal		<Signal> Key not found	ValueNotFoundSignal	<Signal> Value not found'!!Dictionary methodsFor: 'accessing'!associationAt: key 	"Answer the association at key.  If key is not found, raise a signal."	^self associationAt: key ifAbsent: [self keyNotFoundError: key]!associationAt: key ifAbsent: aBlock 	"Answer the association at key.  If key is not found, answer the	result of evaluating aBlock."	| index |	index _ self findKey: key ifAbsent: [^aBlock value].	^self basicAt: index!associations	"Answer an OrderedCollection containing the receiver's associations in an 	arbitrary order."	| aCollection |	aCollection _ OrderedCollection new: self size.	self associationsDo: [:key | aCollection add: key].	^aCollection!at: key 	"Answer the value at key.  If key is not found, raise a signal."	^self at: key ifAbsent: [self keyNotFoundError: key]!at: key ifAbsent: aBlock 	"Answer the value at key.  If key is not found, answer the	result of evaluating aBlock."	| index |	index _ self findKey: key ifAbsent: [^aBlock value].	^(self basicAt: index) value!at: key ifAbsentRaise: aSignal	"Answer the value at key.  If key is not found,	raise aSignal with key as the parameter."	| index |	index _ self findKey: key ifAbsentRaise: aSignal.	^(self basicAt: index) value!at: key put: anObject 	"Set the value at key to be anObject.  If key is not found, create a new	entry for key and set is value to anObject. Answer anObject."	| index element |	index _ self findKeyOrNil: key.	element _ self basicAt: index.	element == nil		ifTrue: [self atNewIndex: index put: (Association key: key value: anObject)]		ifFalse: [element value: anObject].	^anObject!keyAtValue: value 	"Answer the key whose value equals the argument, value.  If there is none,	raise a signal."	^self keyAtValue: value ifAbsent: [self valueNotFoundError: value]!keyAtValue: value ifAbsent: exceptionBlock	"Answer the key whose value equals the argument, value.  If there is none, 	answer the result of evaluating exceptionBlock." 	self associationsDo: 		[:association | value == association value ifTrue: [^association key]].	^exceptionBlock value!keys	"Answer a set containing the receiver's keys."	| aSet |	aSet _ Set new: self size.	self keysDo: [:key | aSet add: key].	^aSet!values	"Answer a Bag containing the receiver's values."	| aBag |	aBag _ Bag new.	self do: [:value | aBag add: value].	^aBag! !!Dictionary methodsFor: 'testing'!includes: anObject 	"Answer whether anObject is one of the receiver's elements."	self do: [:each | anObject = each ifTrue: [^true]].	^false!occurrencesOf: anObject 	"Answer how many of the receiver's elements are equal to anObject."	| count |	count _ 0.	self do: [:each | anObject = each ifTrue: [count _ count + 1]].	^count! !!Dictionary methodsFor: 'adding'!add: anAssociation 	"Include newObject as one of the receiver's elements.  Answer newObject."	| index element |	index _ self findKeyOrNil: anAssociation key.	element _ self basicAt: index.	element == nil		ifTrue: [self atNewIndex: index put: anAssociation]		ifFalse: [element value: anAssociation value].	^anAssociation!declare: key from: aDictionary 	"Add key to the receiver.  If key already exists, do nothing.  If aDictionary includes	key, then remove it from aDictionary and use its association as the entry to the	receiver."	(self includesKey: key) ifTrue: [^self].	(aDictionary includesKey: key)		ifTrue: 			[self add: (aDictionary associationAt: key).			aDictionary removeKey: key]		ifFalse: 			[self at: key put: nil]!grow	"Increase the number of elements of the collection."	| newSelf |	newSelf _ self copyEmpty: self basicSize + self growSize.	self associationsDo: [:each | newSelf noCheckAdd: each].	self become: newSelf! !!Dictionary methodsFor: 'removing'!remove: anObject 	"Provide an error notification that removing an element	 from a Dictionary is not allowed."	self shouldNotImplement!remove: anObject ifAbsent: exceptionBlock 	"Provide an error notification that Dictionaries can not respond to	remove: messages."	self shouldNotImplement! !!Dictionary methodsFor: 'enumerating'!collect: aBlock 	"Evaluate aBlock with each of the values of the receiver as the  	argument.  Collect the resulting values into a collection that is like 	the receiver.  Answer the new collection."	| newCollection |	newCollection _ Bag new.	self do: [:each | newCollection add: (aBlock value: each)].	^newCollection!do: aBlock 	"Evaluate aBlock with each of the receiver's elements as the 	argument. "	super do: [:assoc | aBlock value: assoc value]!select: aBlock 	"Evaluate aBlock with each of the values of the receiver as the 	argument.  Collect into a new dictionary, only those associations 	for which aBlock evaluates to true. "	| newCollection |	newCollection _ self species new.	self associationsDo: 		[:each | (aBlock value: each value)			ifTrue: [newCollection add: each]].	^newCollection! !!Dictionary methodsFor: 'converting'!asSortedCollection	"Answer a new instance of SortedCollection whose elements are the elements of	the receiver.  The sort order is the default less than or equal ordering."	| aSortedCollection |	aSortedCollection _ SortedCollection new: self size.	self associationsDo: [:association | aSortedCollection add: association].	^aSortedCollection! !!Dictionary methodsFor: 'printing'!printOn: aStream  	"Append to the argument aStream a sequence of characters that identifies the receiver."	| tooMany |	tooMany _ aStream position + self maxPrint.	aStream nextPutAll: self class name, ' ('.	self associationsDo: 		[:element | 		aStream position > tooMany ifTrue: [aStream nextPutAll: '...etc...)'. ^self].		element printOn: aStream.		aStream space].	aStream nextPut: $)!storeOn: aStream 	"Append to the argument aStream a sequence of characters that is an expression 	whose evaluation creates an collection similar to the receiver. The general format	for a Dictionary is		((class-name new) add: association; add: association; ... ; yourself)"	| noneYet |	aStream nextPutAll: '(('.	aStream nextPutAll: self class name.	aStream nextPutAll: ' new)'.	noneYet _ true.	self associationsDo: 			[:each | 			noneYet				ifTrue: [noneYet _ false]				ifFalse: [aStream nextPut: $;].			aStream nextPutAll: ' add: '.			aStream store: each].	noneYet ifFalse: [aStream nextPutAll: '; yourself'].	aStream nextPut: $)! !!Dictionary methodsFor: 'dictionary testing'!includesAssociation: anAssociation 	"Answer whether the receiver has an element (association between a key and	a value) that is equal to the argument, anAssociation."	^super includes: anAssociation!includesKey: key 	"Answer whether the receiver has a key equal to the argument, key."	| index |	index _ self findKeyOrNil: key.	^(self basicAt: index) ~~ nil! !!Dictionary methodsFor: 'dictionary removing'!removeAssociation: anAssociation 	"Remove the key and value association, anAssociation, from the 	receiver.  Answer anAssociation.  If the key is not in the receiver,	then provide an error notification that it was not found."	^self removeAssociation: anAssociation ifAbsent: [self notFoundError]!removeAssociation: anAssociation ifAbsent: anExceptionBlock 	"Remove the key and value association, anAssociation, from the 	receiver.  If not found, answer the result of evaluating 	anExceptionBlock, otherwise answer anAssociation."	^super remove: anAssociation ifAbsent: anExceptionBlock!removeKey: key 	"Remove key from the receiver.  If key is not in the receiver, raise a signal.  Otherwise, answer the value associated with key."	^self removeKey: key ifAbsent: [self keyNotFoundError: key]!removeKey: key ifAbsent: aBlock 	"Remove key from the receiver.  If key is not in the receiver, 	answer the result of evaluating aBlock.  Otherwise, answer the value 	associated with key."	| index element |	index _ self findKey: key ifAbsent: [^aBlock value].	element _ self basicAt: index.	self basicAt: index put: nil.	tally _ tally - 1.	self fixCollisionsFrom: index.	^element value! !!Dictionary methodsFor: 'dictionary enumerating'!associationsDo: aBlock 	"Evaluate aBlock for each of the receiver's key/value associations."	super do: aBlock!keysDo: aBlock 	"Evaluate aBlock for each of the receiver's keys."	self associationsDo: [:association | aBlock value: association key]! !!Dictionary methodsFor: 'user interface'!inspect	"Create and schedule a DictionaryInspector in which the user can examine the	receiver's variables."	Cursor wait showWhile: [InspectorView open: (DictionaryInspector inspect: self)]! !!Dictionary methodsFor: 'private'!findKey: key ifAbsent: aBlock 	"Look for the key in the receiver.  If it is found, answer	the index of the association containing the key, otherwise	answer the result of evaluating aBlock."		| index |	index _ self findKeyOrNil: key.	(self basicAt: index) == nil ifTrue: [^aBlock value].	^index!findKey: key ifAbsentRaise: aSignal	"Look for the key in the receiver.  If it is found, answer	the index of the association containing the key, otherwise	raise aSignal with key as the parameter."		| index |	index _ self findKeyOrNil: key.	(self basicAt: index) == nil ifTrue: [aSignal raiseWith: key  "doesn't return"].	^index!findKeyOrNil: key  	"Look for the key in the receiver.  If it is found, answer	the index of the association containing the key, otherwise	answer the index of the first unused slot."	| location length probe pass |	length _ self basicSize.	pass _ 1.	location _ key hash \\ length + 1.	[(probe _ self basicAt: location) == nil or: [probe key = key]]		whileFalse: 			[(location _ location + 1) > length				ifTrue: 					[location _ 1.					pass _ pass + 1.					pass > 2 ifTrue: [^self grow findKeyOrNil: key]]].	^location!keyNotFoundError: key	"Raise a signal indicating that the key was	not found."	^Dictionary keyNotFoundSignal raiseWith: key!rehash	"Recompute the hash numbers for the elements of the receiver."	"Smalltalk rehash."	| newSelf |	newSelf _ self species new: self basicSize.	self associationsDo: [:each | newSelf noCheckAdd: each].	self become: newSelf!valueNotFoundError: value	"Raise a signal indicating that the value was	not found."	^Dictionary valueNotFoundSignal raiseWith: value! !!Dictionary methodsFor: 'fileIn/Out'!storeBinaryOn: stream	stream storeRecordOfClass: self class.	stream nextPut: self size.	self associationsDo: [:assoc | stream nextPut: assoc]! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Dictionary class	instanceVariableNames: ''!!Dictionary class methodsFor: 'class initialization'!initialize	"Initialize signals."	| nfs |	nfs _ Object notFoundSignal.	KeyNotFoundSignal _ nfs newSignal 		notifierString: 'Key not found: ';		nameClass: self message: #keyNotFoundSignal.	ValueNotFoundSignal _ nfs newSignal 		notifierString: 'Value not found: ';		nameClass: self message: #valueNotFoundSignal.! !!Dictionary class methodsFor: 'Signal constants'!keyNotFoundSignal	^KeyNotFoundSignal!valueNotFoundSignal	^ValueNotFoundSignal! !!Dictionary class methodsFor: 'fileIn/Out'!readBinaryFrom: stream tag: tag	"Answer object appearing next in stream."	| size dict |	size _ stream next.  "integer"	dict _ self new: (size max: 1).	stream register: dict id: tag.	1 to: size do:		[:i | dict add: stream next].	^dict! !Dictionary initialize!Inspector subclass: #DictionaryInspector	instanceVariableNames: 'ok '	classVariableNames: 'DictListMenu '	poolDictionaries: ''	category: 'Tools-Inspector'!DictionaryInspector comment:'A DictionaryInspector is an Inspector that provides the special modelling whereby the name list of the inspector are the keys of the dictionary.  Note that the fields contain the actual current dictionary key object, not a field name string.Instance Variables:	ok	<Boolean>	true if the user has provided a legal new key to be added to the dictionary	Class Variables:	DictListMenu	<ActionMenu> of operations on the keys of the dictionary being inspected'!!DictionaryInspector methodsFor: 'field list'!acceptText: aText from: aController	"Text has been changed.  Store or compile the text, depending on 	the current mode of the receiver."	| val |	field == nil ifTrue: [^ false].	val _ self evaluateText: aText string from: aController ifFail: [^ false].	object at: field put: val.	self changed: #text.	^ true!fieldList	"Answer a collection of the keys of the inspected dictionary."	| keys | 	keys _ object keys.	keys		detect: [:key | key isSymbol not]		ifNone: [^keys asSortedCollection]. "sort dictionaries with Symbol keys"	^keys asOrderedCollection!fieldMenu	"DictionaryInspector flushMenus" 	field == nil ifTrue:		[^ActionMenu labels: 'add field' withCRs			selectors: #(addField)].	DictListMenu == nil ifTrue:		[DictListMenu _ ActionMenu			labels: 'inspect\references\add field\remove' withCRs			lines: #(2)			selectors: #(inspectField browseReferences						addField removeField)].	^DictListMenu!fieldValue	^object at: field!printItems	"Answer whether the elements of the fieldList need to be converted to strings"	^true! !!DictionaryInspector methodsFor: 'compiler interface'!insertAndSelect: aString at: ignoredIndex	ok _ false! !!DictionaryInspector methodsFor: 'private-menu messages'!browseReferences	Smalltalk browseAllCallsOn: (object associationAt: field)!removeField	(self confirm: 'Confirm removal of ', field printString) ifFalse: [^self].	object removeKey: field.	field _ nil.	self changed: #field! !!DictionaryInspector methodsFor: 'menu commands'!addField	| aString key |	aString _ FillInTheBlank request: 'Enter key as a Smalltalk constant'.	aString isEmpty ifTrue: [^self].	ok _ true.	key _ Object evaluatorClass evaluate: aString.	ok ifFalse: [^nil].	key == nil ifTrue: [^nil].	object add: (Association key: key value: nil).	field _ key.	self changed: #field! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!DictionaryInspector class	instanceVariableNames: ''!!DictionaryInspector class methodsFor: 'class initialization'!flushMenus	"Cause all menus to be newly created (so changes appear)." 	DictListMenu _ nil! !!DictionaryInspector class methodsFor: 'examples'!inspectExample	"Create and schedule an Inspector in which the user can examine the	receiver's variables."	"DictionaryInspector inspectExample."	| dictionary |	dictionary _ Dictionary new.	dictionary at: 'A' put: $A.	dictionary at: 'Two' put: 2.	dictionary at: 'Three' put: 3.	InspectorView open: (DictionaryInspector inspect: dictionary)! !FormBitmap variableByteSubclass: #DisplayBitmap	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Graphics-Support'!DisplayBitmap comment:'Class DisplayBitmap is a subclass of Bitmap that is used to indicate the particular bitmap which is being displayed, so that various implementations can treat it specially.  It adds no protocol.Instance Variables: *word indexed*'!DisplayObject subclass: #DisplayMedium	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Graphics-Display Objects'!DisplayMedium comment:'The abstract class DisplayMedium represents a display object which can both paint itself on a medium (such as Display) and can act as a medium itself.  Its chief subclass is Form.Subclasses must implement methods for	coloring		fill:rule:mask: 	displaying		copyBits:from:at:clippingBox:rule:mask:		drawLine:from:to:clippingBox:rule:mask:'!!DisplayMedium methodsFor: 'coloring'!black	"Set all bits in the receiver to black (ones)."	self fill: self boundingBox		mask: Form black!black: aRectangle 	"Set all bits in the receiver's area defined by aRectangle to black (ones)."	self fill: aRectangle rule: Form over mask: Form black!darkGray	"Set all bits in the receiver to darkGray."	self fill: self boundingBox		mask: Form darkGray!darkGray: aRectangle	"Set all bits in the receiver's area defined by aRectangle to the darkGray mask."	self fill: aRectangle rule: Form over mask: Form darkGray!fill: aRectangle 	"Fill aRectangle with the default background, Form gray."	self fill: aRectangle rule: Form over mask: Form gray!fill: aRectangle mask: aForm 	"Replace a rectangular area of the receiver with the pattern described by aForm 	according to the rule over."	self fill: aRectangle rule: Form over mask: aForm!fill: aRectangle rule: anInteger mask: aForm 	"Replace a rectangular area of the receiver with the pattern described by aForm 	according to the rule anInteger."	self subclassResponsibility!gray	"Set all bits in the receiver to gray."	self fill: self boundingBox		mask: Form gray!gray: aRectangle	"Set all bits in the receiver's area defined by aRectangle to the gray mask."	self fill: aRectangle rule: Form over mask: Form gray!lightGray	"Set all bits in the receiver to lightGray."	self fill: self boundingBox		mask: Form lightGray!lightGray: aRectangle	"Set all bits in the receiver's area defined by aRectangle to the lightGray mask."	self fill: aRectangle rule: Form over mask: Form lightGray!reverse	"Change all the bits in the receiver that are white to black, and the ones	that are black to white."	self fill: self boundingBox		rule: Form reverse		mask: Form black!reverse: aRectangle	"Change all the bits in the receiver's area that intersects with aRectangle	that are white to black, and the ones that are black to white."	self fill: aRectangle rule: Form reverse mask: Form black!reverse: aRectangle mask: aMask		"Change all the bits in the receiver's area that intersect with aRectangle	according to the mask.  Black does not necessarily turn to white, rather it	changes with respect to the rule and the bit in a corresponding mask location.	Bound to give a surprise."	self fill: aRectangle rule: Form reverse mask: aMask!veryLightGray	"Set all bits in the receiver to veryLightGray."	self fill: self boundingBox		mask: Form veryLightGray!veryLightGray: aRectangle	"Set all bits in the receiver's area defined by aRectangle to the veryLightGray mask."	self fill: aRectangle rule: Form over mask: Form veryLightGray!white	"Set all bits in the form to white (i.e., to zeros)."	self fill: self boundingBox		mask: Form white!white: aRectangle	"Set all bits in the receiver's area defined by aRectangle to white (i.e., to zeros)."	self fill: aRectangle rule: Form over mask: Form white! !!DisplayMedium methodsFor: 'bordering'!border: aRectangle width: borderWidth 	"Paint a border whose rectangular area is defined by aRectangle.  The width of	the border of each side is borderWidth.  Uses Form black for drawing the border."	self border: aRectangle		width: borderWidth		mask: Form black!border: aRectangle width: borderWidth mask: aHalfTone 	"Paint a border whose rectangular area is defined by aRectangle.  The width of	the border of each side is borderWidth.  Uses aHalfTone for drawing the border."	self border: aRectangle		widthRectangle: 			(Rectangle				left: borderWidth				right: borderWidth				top: borderWidth				bottom: borderWidth)		mask: aHalfTone!border: aRectangle width: borderWidth rule: aRule mask: aHalfTone 	"Paint a border whose rectangular area is defined by aRectangle.  The width of	the border of each side is borderWidth.  Uses aHalfTone for drawing the border."	self border: aRectangle		widthRectangle: 			(Rectangle				left: borderWidth				right: borderWidth				top: borderWidth				bottom: borderWidth)		rule: aRule		mask: aHalfTone!border: aRectangle widthRectangle: insets mask: aHalfTone 	"Paint a border whose rectangular area is defined by aRectangle.  The width of	each edge of the border is determined by the four coordinates of insets.	Uses aHalfTone for drawing the border."	(aRectangle areasOutside: (aRectangle insetBy: insets)) do:		[:edgeStrip | self fill: edgeStrip mask: aHalfTone]!border: aRectangle widthRectangle: insets mask: aHalfTone clippingBox: clipRect	"Paint a border whose rectangular area is defined by aRectangle.  The width of	each edge of the border is determined by the four coordinates of insets.	Uses aHalfTone for drawing the border."	(aRectangle areasOutside: (aRectangle insetBy: insets)) do:		[:edgeStrip | self fill: (edgeStrip intersect: clipRect) mask: aHalfTone]!border: aRectangle widthRectangle: insets rule: aRule mask: aHalfTone 	"Paint a border whose rectangular area is defined by aRectangle.  The width of	each edge of the border is determined by the four coordinates of insets.	Uses aHalfTone for drawing the border."	(aRectangle areasOutside: (aRectangle insetBy: insets)) do:		[:edgeStrip | self fill: edgeStrip rule: aRule mask: aHalfTone]! !!DisplayMedium methodsFor: 'displaying'!copyBits: sourceRect from: sourceForm at: destOrigin clippingBox: clipRect rule: rule mask: aForm 	"Copy into the rectangle sourceRect within the receiver those pits from the form	sourceForm starting at position destOrigin according to the mixing rule rule and with	aForm as the mask.  Clip the receiver's destination rectangle with respect to clipRect."	self subclassResponsibility!display: aDisplayObject	"The receiver places the argument aDisplayObject on itself at its relative origin."	self display: aDisplayObject at: 0@0!display: aDisplayObject at: aPoint	"The receiver places the argument aDisplayObject on itself at aPoint."	aDisplayObject displayOn: self at: aPoint!drawLine: sourceForm from: beginPoint to: endPoint clippingBox: clipRect rule: anInteger mask: aForm 	"Affect the receiver by modifying its contents so as to effectively	draw a straight line starting at beginPoint (a position relative to the receiver) and	ending at endPoint, according to the combination rule anInteger, masked by	aForm and clipped by clipRect.  Each position on the line is drawn with the	form sourceForm."		self subclassResponsibility! !Object subclass: #DisplayObject	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Graphics-Display Objects'!DisplayObject comment:'The abstract class DisplayObject provides the protocol for most display primitives that are used by other objects, such as Views, for presenting information on the screen.  Its subclasses are DisplayMedium, DisplayText, InfiniteForm, OpaqueForm, and Path.Subclasses must implement methods for 	display box access		computeBoundingBox	displaying		displayOn:at:clippingBox:rule:mask:'!!DisplayObject methodsFor: 'accessing'!extent	"Answer the point that represents the width and height of the	receiver's bounding box."	^self boundingBox extent!height	"Answer the number that represents the height of the receiver's bounding box."	^self boundingBox height!offset	"Answer the amount by which the receiver should be offset when	it is displayed or its position is tested."	self subclassResponsibility!offset: aPoint 	"Set the amount by which the receiver's position is offset."	^self!relativeRectangle	"Answer a Rectangle whose top left corner is the receiver's offset position	and whose width and height are the same as the receiver."	^Rectangle origin: self offset extent: self extent!width	"Answer the number that represents the width of the receiver's bounding box."	^self boundingBox width! !!DisplayObject methodsFor: 'truncation and round off'!rounded	"Convert the offset of the receiver to integer coordinates."	self offset: self offset rounded! !!DisplayObject methodsFor: 'display box access'!boundingBox	"Answer the rectangular area that represents the boundaries of the 	receiver's space of information."	^self computeBoundingBox!computeBoundingBox	"Answer the rectangular area that represents the boundaries of the 	receiver's area for displaying information.  This is the primitive for computing the	area if it is not already known."	self subclassResponsibility! !!DisplayObject methodsFor: 'displaying'!display	"Show the receiver on the display screen.  Defaults to showing the receiver	in the upper left corner of the screen."	self displayOn: Display!displayAt: aDisplayPoint 	"Display the receiver located at aDisplayPoint with default settings for the	displayMedium, rule and halftone."	self displayOn: Display		at: aDisplayPoint		clippingBox: Display boundingBox		rule: Form over		mask: Form black!displayOn: aDisplayMedium	"Simple default display in order to see the receiver in the upper left corner of 	screen."	self displayOn: aDisplayMedium at: 0 @ 0!displayOn: aDisplayMedium at: aDisplayPoint 	"Display the receiver located at aDisplayPoint with default settings for rule and halftone."	self displayOn: aDisplayMedium		at: aDisplayPoint		clippingBox: aDisplayMedium boundingBox		rule: Form over		mask: Form black!displayOn: aDisplayMedium at: aDisplayPoint clippingBox: clipRectangle 	"Display the receiver located at aDisplayPoint with default settings for rule and	halftone.  Information to be displayed must be confined to the area that intersects	with clipRectangle."	self displayOn: aDisplayMedium		at: aDisplayPoint		clippingBox: clipRectangle		rule: Form over		mask: Form black!displayOn: aDisplayMedium at: aDisplayPoint clippingBox: clipRectangle rule: ruleInteger mask: aForm	"This is the basic display primitive for graphic display objects.  Display 	the receiver located at aDisplayPoint with rule, rule ruleInteger, and mask, 	aForm.  Information to be displayed must be confined to the area that 	intersects with clipRectangle."	self subclassResponsibility!displayOn: aDisplayMedium at: aDisplayPoint rule: ruleInteger	"Display the receiver located at aPoint with default setting for the halftone and clippingBox."	self displayOn: aDisplayMedium		at: aDisplayPoint		clippingBox: aDisplayMedium boundingBox		rule: ruleInteger		mask: Form black!displayOn: aDisplayMedium transformation: displayTransformation clippingBox: clipRectangle 	"Display primitive for the receiver where a DisplayTransformation is provided	as an argument.  Alignment is defaulted to the receiver's rectangle.  Information	to be displayed must be confined to the area that intersects with clipRectangle."	self displayOn: aDisplayMedium		transformation: displayTransformation		clippingBox: clipRectangle		align: self relativeRectangle center		with: self relativeRectangle center		rule: Form over		mask: Form black!displayOn: aDisplayMedium transformation: displayTransformation clippingBox: clipRectangle align: alignmentPoint with: relativePoint 	"Display primitive where a DisplayTransformation is provided as an argument,	rule is over and mask is Form black.  Information to be displayed must be confined	to the area that intersects with clipRectangle."	self displayOn: aDisplayMedium		transformation: displayTransformation		clippingBox: clipRectangle		align: alignmentPoint		with: relativePoint		rule: Form over		mask: Form black!displayOn: aDisplayMedium transformation: displayTransformation clippingBox: clipRectangle align: alignmentPoint with: relativePoint rule: ruleInteger mask: aForm 	"Display the receiver where a DisplayTransformation is provided as an argument,	rule is ruleInteger and mask is aForm.  Translate by relativePoint-alignmentPoint.	Information to be displayed must be confined to the area that intersects with	clipRectangle."	| absolutePoint |	absolutePoint _ displayTransformation applyTo: relativePoint.	self displayOn: aDisplayMedium		at: (absolutePoint - alignmentPoint) 		clippingBox: clipRectangle 		rule: ruleInteger 		mask: aForm!displayOn: aDisplayMedium transformation: displayTransformation clippingBox: clipRectangle fixedPoint: aPoint 	"Display the receiver where a DisplayTransformation is provided as an argument,	rule is over and mask is Form black.  No translation.  Information to be displayed	must be confined to the area that intersects with clipRectangle."	self displayOn: aDisplayMedium		transformation: displayTransformation		clippingBox: clipRectangle		align: aPoint		with: aPoint		rule: Form over		mask: Form black!displayOn: aDisplayMedium transformation: displayTransformation clippingBox: clipRectangle rule: ruleInteger mask: aForm 	"Display the receiver where a DisplayTransformation is provided as an argument,	rule is ruleInteger and mask is aForm.  No translation.  Information to be displayed	must be confined to the area that intersects with clipRectangle."	self displayOn: aDisplayMedium		transformation: displayTransformation		clippingBox: clipRectangle		align: self relativeRectangle origin		with: self relativeRectangle origin		rule: ruleInteger		mask: aForm! !!DisplayObject methodsFor: 'transforming'!align: alignmentPoint with: relativePoint 	"Translate the receiver's offset such that alignmentPoint aligns with relativePoint."	self offset: (self offset translateBy: relativePoint - alignmentPoint)!scaleBy: aPoint 	"Scale the receiver's offset by the amount of the argument, aPoint."	self offset: (self offset scaleBy: aPoint)!translateBy: aPoint 	"Translate the receiver's offset by the amount of the argument, aPoint."	self offset: (self offset translateBy: aPoint)! !!DisplayObject methodsFor: 'screen'!backgroundAt: location	"Answer a Form containing the contents of the Display which will be altered	if the receiver is displayed at location.  The Form remembers the location in its offset."	^ (Form fromDisplay: (location extent: self extent)) offset: location!follow: locationBlock while: durationBlock	"This method moves an image around on the Display.	It restores the background continuously without causing flashing.	LocationBlock supplies each new location, and durationBlock supplies	true to continue, and then false to stop."	"See (or run) OpaqueForm starCursor."	| location background |	location _ locationBlock value.	background _ self backgroundAt: location.	self displayAt: location.	[durationBlock value] whileTrue:		[self moveTo: locationBlock value restoring: background].	background display!moveTo: newLoc restoring: background	"Move an image to a new location on the Display, restoring the background	without causing flashing.  Background must be a Form containing	the bits to be restored at the previous location (its offset), and this method	will update its bits and offset appropriately"	| location saveAll rect1 rect2 bothRects |	(location _ background offset) = newLoc ifTrue: [^background].	background offset: 0@0.	rect1 _ location extent: self extent.	rect2 _ newLoc extent: self extent.	bothRects _ rect1 merge: rect2.	(rect1 intersects: rect2)		ifTrue:  "When overlap, buffer background for both rectangles"			[saveAll _ Form fromDisplay: bothRects.			background displayOn: saveAll at: rect1 origin - bothRects origin.			"now saveAll is clean background; get new bits for background"			background copy: (0@0 extent: self extent)				from: rect2 origin - bothRects origin				in: saveAll				rule: Form over.			self displayOn: saveAll at: rect2 origin - bothRects origin.			saveAll displayOn: Display at: bothRects origin]		ifFalse: "If no overlap, do the simple thing (both rects might be too big)"			[background displayOn: Display at: location.			background fromDisplay: rect2.			self displayOn: Display at: newLoc].	^ background offset: newLoc! !CharacterScanner subclass: #DisplayScanner	instanceVariableNames: 'lineY runX '	classVariableNames: ''	poolDictionaries: 'TextConstants '	category: 'Graphics-Support'!DisplayScanner comment:'Instances of class DisplayScanner hold the state of CharacterScanner in addition to the following required only for displaying or printing.  They are used to scan text and display it on the screen or in a hidden form.Instance Variables	lineY	<Integer>  Top of line currently being displayed or scanned.  The textStyle lineGrid is added or subtracted to discover the top of the next line.  May differ from destY when fonts of differing height fall on the same line.	runX	<Integer>  Left of first character in the current run -- allows for creating underlining or similar emphasis.Pool Dictionary:	TextConstants	<Dictionary>'!!DisplayScanner methodsFor: 'scanning'!displayLines: linesInterval in: aParagraph clippedBy: visibleRectangle	"The central display routine.  The call on the primitive 	(scanCharactersFrom:to:in:rightX:) will be interrupted according to 	the StopConditions array passed to the primitive at which time the 	code to handle the stopCondition is run and the call on the primitive 	continued until a stopCondition returns true which means the line has 	terminated. "	| runLength done lineGrid lineIndex stopCondition displaying|	self initializeFromParagraph: aParagraph clippedBy: visibleRectangle.	rightMargin _ aParagraph rightMarginForDisplay.	lineGrid _ textStyle lineGrid.	"assume outputMedium Display"	lineY _ destY _ aParagraph topAtLineIndex: linesInterval first.	displaying _ self doesDisplaying.	linesInterval do: 		[:index | 		lineIndex _ index.		runX _ destX _ leftMargin _			aParagraph leftMarginForDisplayForLine: lineIndex.		line _ aParagraph lineAt: lineIndex.		text _ aParagraph textAt: lineIndex.		lastIndex _ line first.		self setStopConditions.	"also sets the font"		destY _ lineY + self fontAscentDelta.		"fontAscent delta"		runLength _ text runLengthFor: line first.		(runStopIndex _ lastIndex + (runLength - 1)) > line last 			ifTrue: [runStopIndex _ line last].		spaceCount _ 0.		done _ false.		[done]			whileFalse: 				[stopCondition _ self scanCharactersFrom: lastIndex									to: runStopIndex									in: text string									rightX: rightMargin									stopConditions: stopConditions									displaying: displaying.				"see setStopConditions for stopping conditions for displaying."				done _ self perform: stopCondition].			"Y origin upper left -- increases as moving down page."					lineY _ lineY + lineGrid].		^lineIndex! !!DisplayScanner methodsFor: 'stop conditions'!cr	"When a carriage return is encountered, simply increment the pointer into the paragraph."	"When displaying line stopped in endOfRun, primitive hasn't incremented				lastIndex when cr stop occurs, hence, "				lastIndex_ lastIndex + 1.				^false!crossedX	"Text display has wrapping.  The scanner just found a character past the 	x location of the cursor.  We know that the cursor is pointing at a character 	or before one."	"This condition will sometimes be reached 'legally' during printing, 	when, for instance the space that caused the line to wrap actually 	extends over the right  boundary.  This character is allowed to print, 	even though it is technically outside or straddling the 	clippingRectangle since it is in the normal case not visible and is in 	any case appropriately clipped by the scanner."	self checkEmphasis.	^true!endOfRun	"The end of a run in the display case either means that there is 	actually a change in the style (run code) to be associated with the 	string or the end of this line has been reached.  A check for any 	emphasis (underlining, for example) that may run the length of the 	run is done here before returning to displayLines: to do the next line"	| runLength |	lastIndex = line last		ifTrue: [ "just displaying and at end of line"				self checkEmphasis.				^true].	self checkEmphasis.	runLength _ text runLengthFor: (lastIndex _ lastIndex + 1).	self setStopConditions.	runX _ destX.	destY _ lineY + self fontAscentDelta.		"fontAscent delta"	(runStopIndex _ lastIndex + (runLength - 1)) > line last 		ifTrue: [runStopIndex _ line last].	^false!onePixelBackspace	"Increment destX by 1"	destX _ (destX - 1) max: runX.	lastIndex _ lastIndex + 1.	^false!onePixelSpace	"Increment destX by 1"	destX _ destX + 1.	lastIndex _ lastIndex + 1.	^false!paddedSpace	"Each space is a stop condition when the alignment = justified.  	Padding must be added to the base width of the space according to 	which space in the line this space is and according to the amount of 	space that remained at the end of the line when it was composed."	spaceCount _ spaceCount + 1.	destX _ destX + spaceWidth + (line justifiedPadFor: spaceCount).	lastIndex _ lastIndex + 1.	^false!setStopConditions	"Set the font and the stop conditions for the current run."	font _ textStyle fontAt: (text emphasisAt: lastIndex).	super setStopConditions.	stopConditions 		at: Space asInteger + 1 		put: (textStyle alignment = Justified				ifTrue: [#paddedSpace]				ifFalse: [nil])!tab	"This attempts to handle leading and internal tabs in a 	justified line.  Leading tabs are considered legal and should be 	reflected on the display gracefully."	| index|	textStyle alignment = Justified		ifTrue: [index _ line first.				[index <= lastIndex] whileTrue:					[(text at: index) == Space						ifTrue: [destX _ destX +										(textStyle tabWidth -										(line justifiedTabDeltaFor: spaceCount))									max: destX.								lastIndex _ lastIndex + 1.								^false].					index _ index + 1]].	destX _ textStyle				nextTabXFrom: destX				leftMargin: leftMargin				rightMargin: rightMargin.	lastIndex _ lastIndex + 1.	^false! !!DisplayScanner methodsFor: 'private'!checkEmphasis	| emphasis sourceRect italicY lineSegment displayDestX displayRunX |		(emphasis _ (font emphasis bitAnd: 7)) = 0		ifTrue: [^self].	displayDestX _ destX.					displayRunX _ runX.	emphasis >= 8	"overstrike"		ifTrue:	[destForm							fill: ((displayRunX @ (lineY + textStyle baseline-3))							extent: (displayDestX - displayRunX) @ 1)							rule: combinationRule mask: halftoneForm.				emphasis _ emphasis - 8].	emphasis >= 4	"underlined"		ifTrue:	[lineSegment _								((displayRunX @ (lineY + textStyle baseline + 1))									extent: (displayDestX - displayRunX) @ 1).							lineSegment bottom <= (clipY+clipHeight) ifTrue:								[destForm fill: lineSegment									rule: combinationRule									mask: halftoneForm].					emphasis _ emphasis - 4].	emphasis >= 2	"italic"		ifTrue:	[italicY _ lineY + textStyle lineGrid - 4.							[italicY > lineY]							whileTrue:							[sourceRect _								displayRunX @ lineY									extent: (displayDestX - displayRunX + 2)												@ (italicY - lineY).							destForm							copyBits: sourceRect							from: destForm							at: (displayRunX+1) @ lineY							clippingBox: sourceRect							rule: Form over mask: nil.							italicY _ italicY - 4].					emphasis _ emphasis - 2].	emphasis >= 1	"bold face"		ifTrue:	[sourceRect _ displayRunX @ lineY								extent: (displayDestX - displayRunX + 1)											@ textStyle lineGrid.							destForm							copyBits: sourceRect							from: destForm							at: (displayRunX+1) @ lineY							clippingBox: sourceRect rule: Form under mask: nil]!doesDisplaying	^true!fontAscentDelta	(font emphasis bitAnd: Subscripted + Superscripted) = 0		ifTrue: [^ textStyle baseline - font ascent].	((font emphasis bitAt: SubscriptedBit) = 1)		ifTrue:	[^textStyle baseline - 2].	"Its Superscripted then"	^textStyle baseline - (textStyle fontAt: (text emphasisAt: ((lastIndex - 1) max: 1))) ascent!initializeFromParagraph: aParagraph clippedBy: clippingRectangle	super initializeFromParagraph: aParagraph clippedBy: clippingRectangle! !Form subclass: #DisplayScreen	instanceVariableNames: ''	classVariableNames: 'SavedExtent '	poolDictionaries: ''	category: 'Graphics-Display Objects'!DisplayScreen comment:'There is only one instance of of the class DisplayScreen, Display.  It is a global used to handle general client requests to deal with the whole display screen.  The instance name provides a way to distinguish this special instance from all other Forms.Class Variables:	SavedExtent	<Point>'!!DisplayScreen methodsFor: 'initialize-release'!postSnapshot	"Initialize the screen after completing a snapshot."	self class displayExtent: SavedExtent!preSnapshot	"Create a blank screen that will be shown while a system snapshot is made."	SavedExtent _ self extent.	self class displaySize: 384@256.	self gray.! !!DisplayScreen methodsFor: 'alerting'!flash: aRectangle 	"Complement twice the area of the screen defined by the argument, aRectangle."	2 timesRepeat:		[self fill: aRectangle			rule: Form reverse			mask: Form black.		(Delay forMilliseconds: 60) wait]!ringBell	"Give the user an audible signal."	"Display ringBell"	<primitive: 705>	^self flash: self boundingBox! !!DisplayScreen methodsFor: 'displaying'!beDisplay	"Tell the interpreter to use the receiver as the current display image.  Fail if the 	form is too wide to fit on the physical display.  Essential.  See Object 	documentation whatIsAPrimitive."	<primitive: 102>	self primitiveFailed! !!DisplayScreen methodsFor: 'zooming'!slink: startRect to: stopRect	"Display an evolving rectangle dynamically."	"Display slink: (100@100 extent: 300@100) to: (600@600 extent: 10@10)."	^self slink: startRect to: stopRect speed: 4000!slink: startRect to: stopRect duration: milliseconds	"Display an evolving rectangle dynamically.  Show each intermediate rectangle such that the 	entire animation takes the desired amount of time."	"Display slink: (100@100 extent: 300@100) to: (600@600 extent: 10@10) duration: 2000.	Display slink: (600@600 extent: 10@10) to: (100@100 extent: 300@100) duration: 200."	| originDelta cornerDelta pixels | 	originDelta _ stopRect origin - startRect origin.	cornerDelta _ stopRect corner - startRect corner.		"maximum number of positions for the fastest edge"	pixels _ (originDelta x abs max: originDelta y abs)				max: (cornerDelta x abs max: cornerDelta y abs).	^self slink: startRect to: stopRect speed: pixels*1000//milliseconds!slink: startRect to: stopRect speed: pixelsPerSecond	"Display an evolving rectangle dynamically.  Show each intermediate 	rectangle such that the fastest edge moves at a constant desired 	speed.  In practice, it may be necessary to skip some rectangles in 	order to keep up.  When finished. slink the rectangles back in."	"Display slink: (100@100 extent: 300@100) to: (600@600 extent: 10@10) speed: 500."	| originDelta cornerDelta nSteps period currentOrigin currentCorner step nextTime overtime samples stepRate rects | 	originDelta _ stopRect origin - startRect origin.	cornerDelta _ stopRect corner - startRect corner.	stepRate _ pixelsPerSecond//1000 max: 1.			"minimum pixels/sample"	period _ stepRate*1000//pixelsPerSecond max: 1.	"msec per sample"		"maximum number of positions for the fastest edge"	nSteps _ ((originDelta x abs max: originDelta y abs)				max: (cornerDelta x abs max: cornerDelta y abs)) // stepRate.	nSteps _ nSteps max: 1.		"position increment for each corner"	originDelta _ originDelta / nSteps asFloat.	cornerDelta _ cornerDelta / nSteps asFloat.	currentOrigin _ startRect origin.	currentCorner _ startRect corner.	rects _ OrderedCollection new.	step _ 0.	nextTime _ Time millisecondClockValue.		[[(overtime _ Time millisecondClockValue - nextTime) < 0]			whileTrue: [(Delay untilMilliseconds: nextTime) wait].		samples _ (overtime // period) + 1.		currentOrigin _ currentOrigin + (originDelta * samples).		currentCorner _ currentCorner + (cornerDelta * samples).		nextTime _ nextTime + (period * samples).		(step _ step + samples) <= nSteps]			whileTrue:				[rects add: (currentOrigin corner: currentCorner).				Display border:  (currentOrigin corner: currentCorner) width: 2 rule: Form reverse mask: Form gray].	"now reel those rectangles back in"	rects do: [:r | Display border:  r width: 2 rule: Form reverse mask: Form gray]!zoom: startRect to: stopRect	"Display an evolving rectangle dynamically."	"Display zoom: (100@100 extent: 300@100) to: (600@600 extent: 10@10)."	^self zoom: startRect to: stopRect speed: 2000!zoom: startRect to: stopRect duration: milliseconds 	"Display an evolving rectangle dynamically.  Show each intermediate 	rectangle such that the entire animation takes the desired amount of 	time. "	"Display zoom: (100@100 extent: 300@100) to: (600@600 extent: 10@10) duration: 2000. 	Display zoom: (600@600 extent: 10@10) to: (100@100 extent: 300@100) duration: 200."	| originDelta cornerDelta pixels |	originDelta _ stopRect origin - startRect origin.	cornerDelta _ stopRect corner - startRect corner.	"maximum number of positions for the fastest edge"	pixels _ (originDelta x abs max: originDelta y abs)				max: (cornerDelta x abs max: cornerDelta y abs).	^self		zoom: startRect		to: stopRect		speed: pixels * 1000 // milliseconds!zoom: startRect to: stopRect speed: pixelsPerSecond	"Display an evolving rectangle dynamically.  Show each intermediate 	rectangle such that the fastest edge moves at a constant desired 	speed.  In practice, it may be necessary to skip some rectangles in 	order to keep up."	"Display zoom: (100@100 extent: 300@100) to: (600@600 extent:10@10) speed: 500."	| originDelta cornerDelta nSteps period currentOrigin currentCorner step nextTime overtime samples stepRate | 	originDelta _ stopRect origin - startRect origin.	cornerDelta _ stopRect corner - startRect corner.	stepRate _ pixelsPerSecond//1000 max: 1.			"minimum pixels/sample"	period _ stepRate*1000//pixelsPerSecond max: 1.	"msec per sample"		"maximum number of positions for the fastest edge"	nSteps _ ((originDelta x abs max: originDelta y abs)				max: (cornerDelta x abs max: cornerDelta y abs)) // stepRate.	nSteps _ nSteps max: 1.		"position increment for each corner"	originDelta _ originDelta / nSteps asFloat.	cornerDelta _ cornerDelta / nSteps asFloat.	currentOrigin _ startRect origin.	currentCorner _ startRect corner.	step _ 0.	nextTime _ Time millisecondClockValue.	self outline: [currentOrigin corner: currentCorner]		while: [[(overtime _ Time millisecondClockValue - nextTime) < 0] whileTrue:					[(Delay untilMilliseconds: nextTime) wait].				samples _ (overtime // period) + 1.				currentOrigin _ currentOrigin + (originDelta * samples).				currentCorner _ currentCorner + (cornerDelta * samples).				nextTime _ nextTime + (period * samples).				(step _ step + samples) <= nSteps]		width: 2		halftone: Form gray! !!DisplayScreen methodsFor: 'outlining'!outline: rectBlock do: effectBlock while: durationBlock width: borderWidth halftone: halftone	"Display an evolving rectangle dynamically.	rectBlock supplies a rectangle, durationBlock supplies true, then false to terminate.	effectBlock is executed at each iteration." 	| oldRect edges rect | 	oldRect _ rectBlock value rounded.	edges _ oldRect areasOutside: (oldRect insetBy: borderWidth).	edges do: [:edge | self fill: edge rule: Form reverse mask: halftone].	[durationBlock value] whileTrue:		[rect _ rectBlock value rounded.		rect = oldRect			ifFalse:				[edges do: [:edge | self fill: edge rule: Form reverse mask: halftone].				effectBlock value.				edges _ rect areasOutside: (rect insetBy: borderWidth).				edges do: [:edge | self fill: edge rule: Form reverse mask: halftone].				oldRect _ rect]].	edges do: [:edge | self fill: edge rule: Form reverse mask: halftone].	^ oldRect!outline: rectBlock while: durationBlock width: borderWidth halftone: halftone	"Display an evolving rectangle dynamically.	rectBlock supplies a rectangle, durationBlock supplies true, then false to terminate." 	^self outline: rectBlock do: [] while: durationBlock width: borderWidth halftone: halftone! !!DisplayScreen methodsFor: 'private'!bitsClass	^DisplayBitmap! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!DisplayScreen class	instanceVariableNames: ''!!DisplayScreen class methodsFor: 'current display'!currentDisplay: form 	"Make the argument, form, be the form representing the current display	screen.  Provide an error notification if form is not an instance of the receiver."	form class == self		ifTrue: 			["We know the bits are a DisplayBitmap."			Display become: form.			Display beDisplay]		ifFalse: [self error: 'form should be DisplayForm']!displayExtent: extent 	"Make the width and height of the current display screen form be extent, and refresh the (new) display."	self displaySize: extent.	"now grow to new size"	ScheduledControllers redraw!displayHeight: height 	"Make the height of the current display screen form be the argument, height."	^self displayExtent: self boundingBox width @ height!displaySize: extent 	"Make the width and height of the current display screen form be extent."	| w |	Display lightGray.	w _ extent x.	"shrink to 16 to release old bitmap"	DisplayScreen currentDisplay: 		(DisplayScreen extent: w @ 16).	DisplayScreen currentDisplay: 		(DisplayScreen extent: w @ extent y).! !!DisplayScreen class methodsFor: 'display box access'!boundingBox	"Answer the bounding box for the form representing the current display screen."	^Display boundingBox! !DisplayObject subclass: #DisplayText	instanceVariableNames: 'text textStyle offset form '	classVariableNames: ''	poolDictionaries: 'TextConstants '	category: 'Graphics-Display Objects'!DisplayText comment:'Instances of class DisplayText get used two different ways in the system.  In the user interface, a DisplayText is used to hold onto some text which is viewed by some form of ParagraphEditor.  Used more generally as a DisplayObject, an instance may need to display efficiently--an instance variable is used to cache the bits for that purpose.Instance Variables:	text		<Text> displayed by the receiver	textStyle	<TextStyle> style by which the receiver displays its text.	offset		<Point> translation of the text position when displayed	form 		<Form>	for caching the bit representation of the receiver''s composed text.'!!DisplayText methodsFor: 'accessing'!form	"Answer the form containing the composed text."	form == nil ifTrue: [self composeForm].	^form!lineGrid	"Answer the relative space between lines of the receiver's text."	^textStyle lineGrid!numberOfLines 	"Answer the number of lines of text in the receiver."	^self height // textStyle lineGrid!offset 	"Answer the offset of the receiver."	^offset!offset: aPoint 	"Set the offset to be the argument aPoint."	offset _ aPoint!string	"Answer the string of the characters displayed by the receiver."	^text string!text 	"Answer the text displayed by the receiver."	^text!text: aText 	"Set the receiver to display the argument, aText."		text _ aText.	form _ nil.	self changed.!textStyle 	"Answer the style by which the receiver displays its text."	^textStyle!textStyle: aTextStyle 	"Set the style by which the receiver should display its text."	textStyle _ aTextStyle.	form _ nil.	self changed.! !!DisplayText methodsFor: 'displaying'!displayOn: aDisplayMedium at: aDisplayPoint clippingBox: clipRectangle rule: ruleInteger mask: aForm	"Display the receiver on the display medium aDisplayMedium positioned at aDisplayPoint within 	the rectangle clipRectangle and with the rule, ruleInteger, and mask, aForm. "	 self form		displayOn: aDisplayMedium		at: aDisplayPoint + offset		clippingBox: clipRectangle		rule: ruleInteger		mask: aForm!displayOn: aDisplayMedium transformation: displayTransformation clippingBox: clipRectangle align: alignmentPoint with: relativePoint rule: ruleInteger mask: aForm	"Display the receiver where a DisplayTransformation is provided as an argument,	rule is ruleInteger and mask is aForm.  Translate by relativePoint-alignmentPoint.	Information to be displayed must be confined to the area that intersects with	clipRectangle." 	| absolutePoint |	absolutePoint _ displayTransformation applyTo: relativePoint.	absolutePoint _ absolutePoint x truncated @ absolutePoint y truncated.	self displayOn: aDisplayMedium		at: absolutePoint - alignmentPoint		clippingBox: clipRectangle		rule: ruleInteger		mask: aForm! !!DisplayText methodsFor: 'display box access'!boundingBox 	"Answer the rectangular area that represents the boundaries of the 	receiver's space of information."	^self form boundingBox!computeBoundingBox 	"Answer the minimum enclosing rectangle around the characters in the text."	| character font width carriageReturn lineWidth lineHeight |	carriageReturn _ Character cr.	width _ lineWidth _ 0.	font _ textStyle defaultFont.	lineHeight _ textStyle lineGrid.	1 to: text size do: 		[:i | 		character _ text at: i.		character = carriageReturn		  ifTrue: 			[lineWidth _ lineWidth max: width.			lineHeight _ lineHeight + textStyle lineGrid.			width _ 0]		  ifFalse: [width _ width + (font widthOf: character)]].	lineWidth _ lineWidth max: width.	^offset extent: lineWidth @ lineHeight! !!DisplayText methodsFor: 'converting'!asParagraph	"Answer a Paragraph whose text and style are identical to that of	the receiver."	^Paragraph withText: text style: textStyle copy! !!DisplayText methodsFor: 'private'!composeForm 	"Cache the form for displaying the paragraph."	form _ self asParagraph asForm!setText: aText textStyle: aTextStyle offset: aPoint 	"Initialize the instance variables."	text _ aText.	textStyle _ aTextStyle.	offset _ aPoint.	form _ nil! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!DisplayText class	instanceVariableNames: ''!!DisplayText class methodsFor: 'instance creation'!text: aText 	"Answer an instance of me such that the text displayed is aText	according to the system's default textstyle."	^self new		setText: aText		textStyle: DefaultTextStyle copy		offset: 0 @ 0!text: aText textStyle: aTextStyle 	"Answer an instance of me such that the text displayed is aText 	according to the style specified by aTextStyle."	^self new		setText: aText		textStyle: aTextStyle		offset: 0 @ 0!text: aText textStyle: aTextStyle offset: aPoint 	"Answer an instance of me such that the text displayed is aText 	according to the style specified by aTextStyle.  The display of the 	information should be offset by the amount given as the argument, aPoint."	^self new		setText: aText		textStyle: aTextStyle		offset: aPoint! !!DisplayText class methodsFor: 'examples'!textSampler	"Continually prints two lines of text wherever you point with the cursor.	Terminate by pressing any mouse button."	"DisplayText textSampler."	| t |	t _ 'this is a line of characters andthis is the second line.' asDisplayText.	[Sensor anyButtonPressed]		whileFalse:			[t displayOn: Display at: Sensor cursorPoint]! !View subclass: #DisplayTextView	instanceVariableNames: 'rule mask editParagraph centered '	classVariableNames: ''	poolDictionaries: ''	category: 'Interface-Text'!DisplayTextView comment:'Class DisplayTextView represents a view of an instance of DisplayText.Instance Variables:	rule		<Integer> according to which character display behaves:  equal over, under, 			and reverse.	mask	<Form> with which each character is combined by the display scanner			before applying the rule.	editParagraph	<Paragraph> the composed text ready for display	centered	<Boolean> whether the text is centered'!!DisplayTextView methodsFor: 'initialize-release'!initialize	"Initialize the instance variables."	super initialize.	centered _ false! !!DisplayTextView methodsFor: 'accessing'!centered	"Set the receiver so that the text is displayed centered."	centered _ true.	self centerText!editParagraph: aParagraph 	"Set the text paragraph for the receiver to be aParagraph centered."	editParagraph _ aParagraph.	self centerText!isCentered	"Answer whether the text is centered in the view."	^centered!mask	"Answer an instance of class Form that is to be used as the mask when displaying	the receiver's model (a DisplayText)."	mask == nil		ifTrue: [^self defaultMask]		ifFalse: [^mask]!mask: aForm 	"Set aForm to be the mask used when displaying the receiver's model."	mask _ aForm!rule	"Answer a number from 0 to 15 that indicates which of the sixteen display rules	is to be used when blting the receiver's model (a DisplayText) onto the display	screen."	rule == nil		ifTrue: [^self defaultRule]		ifFalse: [^rule]!rule: anInteger 	"Set anInteger to be the rule used when displaying the receiver's model."	rule _ anInteger! !!DisplayTextView methodsFor: 'controller access'!defaultController	"Answer a new instance of the default controller and set its	paragraph for editing to be the text of the receiver."	^self defaultControllerClass newParagraph: editParagraph!defaultControllerClass	"Answer the class of the default controller."	^ParagraphEditor! !!DisplayTextView methodsFor: 'window access'!defaultWindow	"Answer the rectangle that represents the window into which the	receiver's text will display."	^((0@0 extent: editParagraph extent) expandBy: self paragraphInset)		expandBy: self borderWidth!window: aWindow 	"Set the window for display to be the argument aWindow."	super window: aWindow.	self centerText! !!DisplayTextView methodsFor: 'model access'!model: aDisplayText 	"Set the model of the receiver to be the argument aDisplayText."	super model: aDisplayText.	self editParagraph: aDisplayText asParagraph.! !!DisplayTextView methodsFor: 'displaying'!display	"Show the receiver's text model on the display screen."	self isUnlocked ifTrue: [self positionText].	super display!displayView	"Display the receiver on the display screen within its bounding rectangle."	self clearInside.	(self controller isKindOf: ParagraphEditor )		ifTrue: [controller changeParagraph: editParagraph].	self isCentered		ifTrue: 			[editParagraph				displayOn: Display				transformation: self displayTransformation				clippingBox: self insetDisplayBox				fixedPoint: editParagraph boundingBox center]		ifFalse: 			[editParagraph displayOn: Display]! !!DisplayTextView methodsFor: 'deEmphasizing'!deEmphasizeView	"Emphasize the receiver's image on the screen."	(self controller isKindOf: ParagraphEditor)	 	ifTrue: [controller deselect]! !!DisplayTextView methodsFor: 'private'!centerText	"Make the text of the receiver center within its bounding box."	self isCentered		ifTrue: 			[editParagraph				align: editParagraph boundingBox center				with: self getWindow center]!defaultMask	"Answer the default mask for the receiver."		^Form black!defaultRule	"Answer the default combination rule for the receiver."		^Form over!paragraphInset	"Answer the amount to inset the paragraph from the border."	^6@0!positionText	"Compose the text so that it displays centered within the clipping box 	of the receiver."	| box |	box _ self insetDisplayBox origin + self paragraphInset			extent: editParagraph boundingBox extent.	editParagraph recomposeIn: box clippingBox: box.	self centerText! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!DisplayTextView class	instanceVariableNames: ''!!DisplayTextView class methodsFor: 'examples'!example1		"Creates a passive view of some text on the screen."	"DisplayTextView example1."	| view |	view_ self new model: 'this is a test of one lineand the second line' asDisplayText.	view translateBy: 100@100.		view borderWidth: 2.	view insideColor: Form white.	view display.	view release!example2		"Creates four passive views of some text on the screen with fat borders."	"DisplayTextView example2."	| view |	view_ self new model: 'this is a test of one lineand the second line' asDisplayText.	view translateBy: 100@100.		view borderWidth: 5.	view insideColor: Form white.	view display.	3 timesRepeat: [view translateBy: 100@100. view display].	view release! !DosIOAccessor subclass: #DosDiskFileAccessor	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'OS-Dos'!DosDiskFileAccessor comment:'Refines class DosIOAccessor to add behavior appropriate for honest-to-goodness disk files, i.e., positioning.'!!DosDiskFileAccessor methodsFor: 'accessing'!commit	"Advise OS to synch dirty buffers associated with this accessor."	<primitive: 665>	self reportError! !!DosDiskFileAccessor methodsFor: 'defaults'!connectionClass	"Answer a default connection class for the receiver."	^FileConnection! !!DosDiskFileAccessor methodsFor: 'stream creation'!readWriteStream	"Answer a read write stream connected to the receiver."	^self asExternalConnection readWriteStream! !OSErrorHolder subclass: #DosErrorHolder	instanceVariableNames: ''	classVariableNames: 'ErrorSignals '	poolDictionaries: ''	category: 'OS-Dos'!DosErrorHolder comment:'MS-DOS error codes are interpreted here.Class Variables:	ErrorSignals		<IdentityDictionary> of Signals'!"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!DosErrorHolder class	instanceVariableNames: ''!!DosErrorHolder class methodsFor: 'class initialization'!hookupTo: platname	"Set-up to deal with a particular platform (w.r.t. error codes)."!initialize	"DosErrorHolder initialize."	self initErrorSignals! !!DosErrorHolder class methodsFor: 'error reporting'!errorDescriptionFor: aSmallInteger	"returns a string describing the error."	<primitive: 697>	^super errorDescriptionFor: aSmallInteger!reportOn: anErrorHolder 	"As an error reporter, report the error contained by this holder."	"This means, map the error holder's error code to the error name, 	map the error name to an error signal, and raise the signal."	anErrorHolder errorCode == nil		ifTrue:	[^self unsupportedOperationSignal raiseWith: anErrorHolder].	^(ErrorSignals at: anErrorHolder errorCode		ifAbsent: [self errorSignal])		raiseWith: anErrorHolder!reportProceedingOn: anErrorHolder 	"As an error reporter, report the (proceedable) error contained by this holder."	"This means, map the error holder's error code to the error name, 	map the error name to an error signal, and raise the signal."	^(ErrorSignals at: anErrorHolder errorCode		ifAbsent: [self errorSignal])		raiseRequestWith: anErrorHolder! !!DosErrorHolder class methodsFor: 'private'!initErrorSignals	"DosErrorHolder initErrorSignals"	ErrorSignals _ IdentityDictionary new: 94.	ErrorSignals at: -99 put: self errorSignal.	ErrorSignals at: -1 put: self badArgumentsSignal.	ErrorSignals at: -2 put: self rangeErrorSignal.	ErrorSignals at: -3 put: self inappropriateOperationSignal.	ErrorSignals at: -4 put: self existingReferentSignal.	ErrorSignals at: 1 put: self illegalOperationSignal.	ErrorSignals at: 2 put: self nonexistentSignal.	ErrorSignals at: 3 put: self nonexistentSignal.	ErrorSignals at: 4 put: self noResourcesSignal.	ErrorSignals at: 5 put: self noPermissionsSignal.	ErrorSignals at: 6 put: self badAccessorSignal.	ErrorSignals at: 7 put: self errorSignal. "??"	ErrorSignals at: 8 put: self noMemorySignal.	ErrorSignals at: 9 put: self badArgumentsSignal.	ErrorSignals at: 10 put: self badArgumentsSignal.	ErrorSignals at: 11 put: self badArgumentsSignal.	ErrorSignals at: 12 put: self badArgumentsSignal.	ErrorSignals at: 13 put: self badArgumentsSignal.	ErrorSignals at: 15 put: self errorSignal. "??"	ErrorSignals at: 16 put: self noPermissionsSignal.	ErrorSignals at: 17 put: self illegalOperationSignal.	ErrorSignals at: 18 put: self noResourcesSignal. "??"	ErrorSignals at: 19 put: self noPermissionsSignal.	ErrorSignals at: 20 put: self unavailableReferentSignal.	ErrorSignals at: 21 put: self notReadySignal.	ErrorSignals at: 22 put: self inappropriateReferentSignal.	ErrorSignals at: 23 put: self transferFaultSignal.	ErrorSignals at: 24 put: self rangeErrorSignal.	ErrorSignals at: 25 put: self transferFaultSignal.	ErrorSignals at: 26 put: self transferFaultSignal.	ErrorSignals at: 27 put: self transferFaultSignal.	ErrorSignals at: 28 put: self notReadySignal.	ErrorSignals at: 29 put: self transferFaultSignal.	ErrorSignals at: 30 put: self transferFaultSignal.	ErrorSignals at: 31 put: self errorSignal.	ErrorSignals at: 32 put: self noPermissionsSignal.	ErrorSignals at: 33 put: self noPermissionsSignal.	ErrorSignals at: 34 put: self inappropriateReferentSignal.	ErrorSignals at: 35 put: self invalidArgumentsSignal.	ErrorSignals at: 50 put: self unsupportedOperationSignal.	ErrorSignals at: 51 put: self peerFaultSignal.	ErrorSignals at: 52 put: self existingReferentSignal.	ErrorSignals at: 53 put: self nonexistentSignal.	ErrorSignals at: 54 put: self needRetrySignal.	ErrorSignals at: 55 put: self nonexistentSignal.	ErrorSignals at: 56 put: self rangeErrorSignal.	ErrorSignals at: 57 put: self transferFaultSignal.	ErrorSignals at: 58 put: self transferFaultSignal.	ErrorSignals at: 59 put: self transferFaultSignal.	ErrorSignals at: 60 put: self peerFaultSignal.	ErrorSignals at: 61 put: self noResourcesSignal.	ErrorSignals at: 62 put: self errorSignal. "??"	ErrorSignals at: 63 put: self noResourcesSignal.	ErrorSignals at: 64 put: self nonexistentSignal.	ErrorSignals at: 65 put: self noPermissionsSignal.	ErrorSignals at: 66 put: self wrongSubtypeForOperationSignal.	ErrorSignals at: 67 put: self nonexistentSignal.	ErrorSignals at: 68 put: self rangeErrorSignal.	ErrorSignals at: 69 put: self noResourcesSignal.	ErrorSignals at: 70 put: self notReadySignal.	DosIOAccessor wouldBlockErrorCode: 70. "Temporarily paused"	ErrorSignals at: 71 put: self transferFaultSignal.	ErrorSignals at: 72 put: self notReadySignal.	ErrorSignals at: 80 put: self existingReferentSignal.	ErrorSignals at: 82 put: self errorSignal. "??"	ErrorSignals at: 83 put: self errorSignal. "??"	ErrorSignals at: 84 put: self noResourcesSignal.	ErrorSignals at: 85 put: self existingReferentSignal.	ErrorSignals at: 86 put: self noPermissionsSignal.	ErrorSignals at: 87 put: self invalidArgumentsSignal.	ErrorSignals at: 88 put: self transferFaultSignal! !DosErrorHolder initialize!Filename subclass: #DosFilename	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'OS-Dos'!DosFilename comment:'Refines class Filename to add MS-DOS-specific behavior such as access date interpretation.'!!DosFilename methodsFor: 'instance creation'!constructString: extraFn 	"Make a new file name string, treating the receiver as a directory, and 	the string argument as a file within the pathname."	| ws prefix suffix sep |	sep _ self separator.	prefix _ nameString.	suffix _ (extraFn size > 1 and: [(extraFn at: 2) == $:])		ifTrue: [extraFn copyFrom: 2 to: extraFn size]		ifFalse: [extraFn].	suffix _ (suffix size > 0 and: [ (suffix at: 1) = sep ])		ifTrue: [suffix copyFrom: 2 to: suffix size]		ifFalse: [suffix].	ws _ WriteStream on: (String new: prefix size + suffix size + 1).	ws nextPutAll: prefix.	(prefix last = sep or: [ prefix last = $: ])		ifFalse:	[ws nextPut: sep].	ws nextPutAll: suffix.	^ws contents! !!DosFilename methodsFor: 'testing'!isAbsolute	"Answer true if this name is absolute (e.g. not relative to the	'current directory')."	| offset |	offset _ self isVolumeAbsolute		ifTrue:	[3]		ifFalse:	[1].	self size < offset		ifTrue:	[^false].	^(nameString at: offset) == self separator!isVolumeAbsolute	^nameString size > 1 and: [(nameString at: 2) == $:]!isVolumeRelative	^self isVolumeAbsolute not! !!DosFilename methodsFor: 'parsing'!extension	"Answer a String with the file extension (chars after a period) if any."	| di |	di _ self lastIndexOf: $..	di = 0 ifTrue: [^''].	^nameString copyFrom: di + 1 to: nameString size!head	"Return the filename of the directory for this Filename"	| index |	(index _ self lastIndexOf: self separator) ~= 0		ifTrue: 			[index _ index max: 2 + (self lastIndexOf: $:).			^nameString copyFrom: 1 to: index - 1]		ifFalse:			[(nameString includes: $:)				ifTrue: [^nameString copyFrom: 1 to: 2]				ifFalse: [^self class defaultDirectoryName]]!tail	"Answer the filename suffix as a String."	| index |	(index _ self lastIndexOf: self separator) ~= 0		ifTrue: 			[^nameString copyFrom: index+1 to: nameString size]		ifFalse:			[(nameString includes: $:)				ifTrue: [^nameString copyFrom: 3 to: nameString size]				ifFalse: [^nameString copy]]!volume	"Answer the volume as a string.  Default volume is empty string."	(nameString size > 1 and: [(nameString at: 2) == $:])		ifTrue: [^String with: (nameString at: 1)].	^''! !!DosFilename methodsFor: 'private'!filesMatchingAccessList: list into: allNames 	list isEmpty		ifTrue:	[^allNames].	list first = '.'		ifTrue:	[list removeFirst.				^self filesMatchingAccessList: list into: allNames].	list first = '..'		ifTrue:	[list removeFirst.				^(self construct: '..') filesMatchingAccessList: list into: allNames].	^super filesMatchingAccessList: list into: allNames!named: n	"Set the OS-specific pathname."	"Only appropriate at instance creation."	nameString _ n.	nameString size = 0		ifTrue:	[^self].	(nameString last == self separator and:		[nameString size > 1 and:		[(nameString at: nameString size - 1) ~= $:]])		ifTrue: [nameString _ nameString copyFrom: 1 to: nameString size -1]! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!DosFilename class	instanceVariableNames: ''!!DosFilename class methodsFor: 'class initialization'!hookupTo: pn	"You have become the default class for some OSHandle subclass.  Prepare yourself."	"Do nothing."!install	self setSeparator: self separator.	DefaultDirectory _ self findDefaultDirectory! !!DosFilename class methodsFor: 'defaulting'!currentDirectoryString	"Return the platform-specific token that represents the current directory"	^'.'!defaultClass	"Answer the appropriate concrete subclass."	"Return self."!errorReporter	"Answer the class which can do error interpretation for me."	^DosErrorHolder!isCaseSensitive	"Answer whether file naming is case sensitive.  True, for example, means	that 'foo.st' and 'Foo.st' name different files."	^false! !!DosFilename class methodsFor: 'constants'!changeExtension	"Answer the platform's changes filename extension."	^'.CHA'!imageExtension	"Answer the platform's image filename extension"	^'.IM'!maximumComponentLength	"Answer the maximum size of a single component of a path"	^12!maxLength	"Answer the maximum length for a platform pathname."	^63!separator	"Answer the platform's filename component separator."	^$\!sourceExtension	"Answer the platform's sources filename extension."	^'.SOU'! !!DosFilename class methodsFor: 'parsing'!canonicalize: str 	"Convert this string to a canonical platform pathname string. 	This may make for arbitrary, unpleasent transformations, like 	truncating to 8 characters, folding to upper case, etc."	| ws components sep pair st skipBack head |	str = '.' ifTrue: [^str].	ws _ String new writeStream.	sep _ self separator.	skipBack _ false.	components _ self components: str.	head _ components first.	(head last = self separator or:			[head size = 2 and:			[head first isLetter and:			[head last = $:]]])		ifTrue: [ws nextPutAll: components removeFirst asLowercase].	components do:		[:pn |		(ws size + (pn size min: 8) < self maxLength and: [pn ~= '.'])			ifTrue: 				[pn = '..'					ifTrue: [ws nextPutAll: pn]					ifFalse: 						[pair _ self splitExtension: pn.						st _ pair first reject: [:c | self isBadCharacter: c].						1 to: (st size min: 8)							do: [:i | ws nextPut: (st at: i) asLowercase].						pair last == nil							ifFalse: 								[ws nextPut: $..								st _ pair last reject: [:c | self isBadCharacter: c].								1 to: (st size min: 3)									do: [:i | ws nextPut: (st at: i) asLowercase]]].				skipBack _ true.				ws nextPut: sep]].	skipBack		ifTrue: [ws skip: -1].	^ws contents!isBadCharacter: char	"Answer if this character is illegal for a platform pathname string."	| cv |	cv _ char asciiValue.	cv <= 32 "space" ifTrue: [^true].	cv >= 8r177 "del" ifTrue: [^true].	'\:."/[]|<>+=;,*?' do: [:bc | bc == char ifTrue: [^true]].	^false!isUglyCharacter: char	"Answer if this character is in bad taste for a platform pathname string."	^self isBadCharacter: char!readBaseLocationFromStream: stream	"Return the root of a (semi)absolute path name"	| drive |	((drive _ stream next) isLetter and: [stream peekFor: $:])		ifTrue:	[drive _ String with: drive with: $:]		ifFalse:	[drive _ String new.				stream skip: -1].	^(stream peekFor: self separator)		ifTrue:	[drive, (String with: self separator)]		ifFalse:	[drive]!splitVolume: str	"Answer an Array with: with: "	| volume remainder |	((str size >= 2 and: [(str at: 2) == $:]) and: [| c | c _ (str at: 1) asUppercase. c >= $A and: [c <= $V]])		ifTrue: 			[volume _ str at: 1.			remainder _ str size > 2						ifTrue: [str copyFrom: 3 to: str size]						ifFalse: ['']]		ifFalse: [remainder _ str].	^Array with: volume with: remainder!suggest: str 	"Answer a string which is in good taste as a filename on this 	platform"	| volume fullName path moniker extension pair ws |	pair _ self splitVolume: str.	volume _ pair at: 1.	pair _ self splitPath: (pair at: 2).	path _ pair at: 1.	fullName _ pair at: 2.	pair _ self splitExtension: fullName.	moniker _ pair at: 1.	extension _ pair at: 2.	ws _ WriteStream on: (String new: str size).	volume notNil ifTrue: [ws nextPut: volume; nextPut: $:].	ws nextPutAll: path.	ws nextPutAll: (self			shrink: moniker			to: 8			dropDelim: false).	(extension notNil and: [extension size > 0])		ifTrue: [ws nextPut: $.; nextPutAll: (self					shrink: extension					to: 3					dropDelim: true)].	^self canonicalize: ws contents! !!DosFilename class methodsFor: 'utilities'!volumes	"Answer an Array of Strings naming all reachable disk volumes."	^self getVolumes asArray collect: [:v | String with: v with: $:]! !!DosFilename class methodsFor: 'private'!baseDirectoryForList: list	^((list first includes: self separator) or: [ list first includes: $: ])		ifTrue:	[self named: list removeFirst]		ifFalse:	[self currentDirectory]!getVolumes	"Return a string of all legal volume specifiers."	<primitive: 614>	^self errorReporter errorSignal raise! !IOAccessor subclass: #DosIOAccessor	instanceVariableNames: ''	classVariableNames: 'WouldBlockECode '	poolDictionaries: ''	category: 'OS-Dos'!DosIOAccessor comment:'DosIOAccessor is a reference to a MS-DOS "file descriptor".Instances of it (and its subclasses) are used to perform IO to the various kinds of stream-like services that the PC provides (disk files, serial lines, etc).Class Variables:	WouldBlockECode	<SmallInteger>						Return error code known as EWOULDBLOCK in C-land.'!!DosIOAccessor methodsFor: 'constants'!lineEndConvention	^LineEndCRLF! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!DosIOAccessor class	instanceVariableNames: ''!!DosIOAccessor class methodsFor: 'class initialization'!hookupTo: platname	"You have become the default class for some OSHandle subclass.  Prepare yourself."	"This shouldn't really be here, but *someone* needs to	tell these guys to hook-up, it might as well be me."	DosTtyAccessor hookupTo: platname.	DosErrorHolder hookupTo: platname!install	"Do nothing."!wouldBlockErrorCode: n	"Assign the value for the wouldBlock error code."	WouldBlockECode _ n! !!DosIOAccessor class methodsFor: 'defaulting'!defaultClass	"Answer the appropriate concrete subclass."	^self!defaultForFiles	"Return the appropriate class for real (disk) files."	^DosDiskFileAccessor!defaultForIPC	"Return the appropriate class for inter-process communications."	"Not supported yet."	^self unsupportedOperationSignal raise!defaultForSerial	"Return the appropriate class for serial (rs-232) communications."	^DosTtyAccessor!errorReporter	"Answer the appropriate error code interpreter for me."	^DosErrorHolder! !DosIOAccessor subclass: #DosTtyAccessor	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'OS-Dos'!DosTtyAccessor comment:'Instances of class DosTtyAccessor are io-accessors for Dos "serial line" devices.  Specialized behavior includes modem control.Because the Dos VM implementation does not treat IOAccessor handles uniformly (e.g., DosTtyAccessor handles are not drawn from the same space as DosDiskFileAccessors), DosTtyAccessor must override *all* primitives implemented in its superclasses.'!!DosTtyAccessor methodsFor: 'accessing'!bufferSize	"Answer the recommended buffer size for this accessor."	"tty's are special, the driver has a 256-element clist (usually)."	^256!fileSize	"Answer the size of the file (which is being accessed) in bytes.	Not reasonable for serial ports."	self errorReporter inappropriateReferentSignal raiseWith: self!getOptions	"Answer tty settings as DosTtyOptions instance."	| ttyo |	ttyo _ self primGetOptions.	^DosTtyOptions with: ttyo from: 1 to: ttyo size!modemBits: bits mask: mask sendBreak: bool	"Sets platform-specific modem-control bits of first arg (SmallInteger)	corresponding to mask of second arg (SmallInteger)	(e.g. only bits set in mask are effected,	0 mask means don't change any).	Sends break if third arg (Boolean) is true.	Returns incoming modem line state (SmallInteger)."	<primitive: 717>	self reportError!primSetOptions: aDosTtyOptions	"Set the port parameters.  Returns self."	<primitive: 715>	self reportError!setOptions: aDosTtyOptions	"Set the port parameters.  Returns self."	<primitive: 715>	self reportError!truncateTo: position 	"Shortens the file to the given length (in bytes).	Not reasonable for serial ports."	self errorReporter inappropriateReferentSignal raiseWith: self! !!DosTtyAccessor methodsFor: 'utilities'!setForTty	"Set up a tty suitable for using the c-shell	as a terminal emulator."	| opts |	opts _ self getOptions.	opts speed: 9600.	opts setDumbTerminal.	self setOptions: opts! !!DosTtyAccessor methodsFor: 'private'!primBufferSize	"Returns suggested buffer size in bytes (SmallInteger).	Not appropriate for serial ports."	self errorReporter illegalOperationSignal raise!primClose	"Close the accessor."	<primitive: 711>	self reportErrorProceeding!primGetOptions	"Returns serial port settings as ByteArray."	<primitive: 714>	self reportError!primGetSize	"Returns fileSize in bytes (SmallInteger).	Not appropriate for serial ports."	self errorReporter illegalOperationSignal raise!primReadInto: buffer startingAt: index for: count 	"buffer is a byte-object, the place where IO is performed. 	index is a SmallInteger, the starting-point in the buffer. 	count is a SmallInteger, the number of bytes to be read."	"Returns a SmallInteger, which is the count of the bytes read. 	Essential."	<primitive: 712>	errorCode = WouldBlockECode		ifTrue: 			[self readWait.			^self primReadInto: buffer startingAt: index for: count].	^self reportErrorProceeding!primSeekTo: position 	"Set to specified position (a positive integer). 	Not appropriate for serial ports."	self errorReporter illegalOperationSignal raise!primWriteFrom: buffer startingAt: index for: count 	"buffer is a byte-object, the place where IO is performed. 	index is a SmallInteger, the starting-point in the buffer. 	count is a SmallInteger, the number of bytes to be written."	"Returns a SmallInteger, which is the count of the bytes written. 	Essential."	<primitive: 713>	^self reportErrorProceeding!seekTo: position	"Set the `file pointer' to specified position.	Not reasonable for serial ports."	self errorReporter inappropriateReferentSignal raiseWith: self!setSem: sem forWrite: bool	"Signal this semaphore when the port is ready for an IO operation.	bool is true if the operation is for writing, false if for reading."	<primitive: 716>	^self reportError! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!DosTtyAccessor class	instanceVariableNames: ''!!DosTtyAccessor class methodsFor: 'class initialization'!hookupTo: platname	"Set-up to deal with a particular platform."	"Do nothing."! !!DosTtyAccessor class methodsFor: 'instance creation'!open: aString	"Answer an accessor on an named serial port (of the form 'COMn:')"	| fd ioa num |	(('COM#:' match: aString ignoreCase: false) and: [(aString at: 4) isDigit])		ifFalse: [self errorReporter inaccessableSignal raise].	num _ (aString at: 4) digitValue.	fd _ self primOpen: num errInto: self errorReporter new.	ioa _ self handle: fd.	ioa setForTty.	^ioa! !!DosTtyAccessor class methodsFor: 'constants'!defaultPortName	"Return the default port name"	^'COM1:'! !!DosTtyAccessor class methodsFor: 'examples'!testRead	"DosTtyAccessor testRead"	"Outputs message until mouse-button pressed."	| dta opts msg count  |	Transcript cr; nextPutAll: 'Here we go...'; endEntry.	dta _ DosTtyAccessor open: 'COM1:'.	opts _ DosTtyOptions new.	opts bits: 8.	opts echo: false.	opts inputFlowControl: false.	opts outputFlowControl: false.	opts parity: nil.	opts raw: true.	opts speed: 9600.	opts stopBits: 1.	dta setOptions: opts.	msg _ String new: 50.	[Sensor noButtonPressed]		whileTrue:                    [ count _ dta readInto: msg startingAt: 1 for: 1.                   count > 0 ifTrue: [Transcript show: (msg copyFrom: 1 to: count); space; show: (msg at: 1) asciiValue printString; space].			].	dta close.	Transcript nextPutAll: 'done.'; cr; endEntry!testWrite	"DosTtyAccessor testWrite"	"Outputs message until mouse-button pressed."	| dta opts msg d |	Transcript cr; nextPutAll: 'Here we go...'; endEntry.	dta _ DosTtyAccessor open: 'COM1:'.	opts _ DosTtyOptions new.	opts bits: 8.	opts echo: false.	opts inputFlowControl: false.	opts outputFlowControl: false.	opts parity: nil.	opts raw: true.	opts speed: 9600.	opts stopBits: 1.	dta setOptions: opts.	msg _ 'What hath god wrought.12'.	msg at: msg size - 1 put: Character cr.	msg at: msg size put: Character lf.	d _ Delay forSeconds: 1.	[Sensor noButtonPressed]		whileTrue: 			[| cnt |			cnt _ dta errorReporter notReadySignal					handle: [:ex | ex returnWith: 0]					do: [dta writeFrom: msg startingAt: 1 for: msg size].			cnt = 0				ifTrue: 					[Transcript show: '?'.					dta writeWait].			d wait].	dta close.	Transcript nextPutAll: 'done.'; cr; endEntry! !!DosTtyAccessor class methodsFor: 'private'!primOpen: aSmallInteger errInto: anErrorHolder	"Opens numbered serial port, returns handle (SmallInteger)."	<primitive: 710>	^anErrorHolder reportFor: self!primOpenFileNamed: nm direction: rwMode creation: creationRule errorInto: errorHolder	"Can't open serial ports this way"	self errorReporter illegalOperationSignal raise! !UninterpretedBytes variableByteSubclass: #DosTtyOptions	instanceVariableNames: ''	classVariableNames: 'Speeds '	poolDictionaries: ''	category: 'OS-Dos'!DosTtyOptions comment:'Class DosTtyOptions represents a DOS tty options structure.  Instances of the class communicate tty options (through a DosTtyAccessor) to the tty driver.byte 1 -- dataBits (0:7 or 1:8)byte 2 -- stopBits (0:1, 1:2)byte 3 -- parity (0:none, 1 : odd, 2:none, 3:even)byte 4 -- baudRate (0:110, 1:150, 2:300, 3:600, 4:1200, 5:2400, 6:4800, 7:9600)byte 5 -- buffering mode (0:raw, 1:line)byte 6 -- echoing mode (0:none, 1:echo)byte 7 -- input flow control (0:none, 1:XON/XOFF)byte 8 -- output flow control (0:none, 1:XON/XOFF)Instance Variables:  *byte indexed*Class Variables:	Speeds		<IdentityDictionary> Maps speed codes to baud rates'!!DosTtyOptions methodsFor: 'accessing'!bits	"Answer the data size of the port--7 or 8"	^(self byteAt: 1) + 5!bits: aValue	"Set the data size of the port"	(aValue = 7 or: [ aValue = 8 ])		ifFalse:	[self errorReporter unsupportedOperationSignal raise].	^self byteAt: 1 put: aValue - 5!echo	"Answer echo mode."	^(self byteAt: 6) = 1!echo: bool	"Set into/outof echo mode according to boolean arg."	self byteAt: 6 put: (bool ifTrue: [1] ifFalse: [0])!inputFlowControl: bool	"Set input flow control for according to boolean arg."	self byteAt: 7 put: (bool ifTrue: [1] ifFalse: [0])!isFlowControlledInput	"Answer input flow control."	^(self byteAt: 7) = 1!isFlowControlledOutput	"Answer output flow control."	^(self byteAt: 8) = 1!isLineBuffered	"Answer if in line-buffered mode."	^(self byteAt: 5) = 1!isRaw	"Answer if in line-buffered mode."	^(self byteAt: 5) = 0!outputFlowControl: bool	"Set output flow control for according to boolean arg."	self byteAt: 8 put: (bool ifTrue: [1] ifFalse: [0])!parity	"Return the option value for tty parity. 	p = 1, odd parity. 	p = 0, even parity. 	p = nil, no parity."	| parity |	"For DOS,		0 = none		1 = odd		2 = none		3 = even"	parity _ self byteAt: 3.	parity even		ifTrue:	[^nil].	parity = 1		ifTrue:	[^1]		ifFalse:	[^0]!parity: p 	"Set the option value for tty parity. 	p = 1, odd parity. 	p = 0, even parity. 	p = nil, no parity. 	Affects generation on output, and checking on input. 	returns self."	| parity |	"For DOS,		0 = none		1 = odd		2 = none		3 = even"	parity _ 0.	p = 0		ifTrue:	[parity _ 3].	p = 1		ifTrue:	[parity _ 1].	self byteAt: 3 put: parity!raw: bool	"Set into/outof raw buffer mode according to boolean arg."	self byteAt: 5 put: (bool ifTrue: [1] ifFalse: [0])!speed	"Answer the line speed in baud."	^Speeds at: (self speedCode)!speed: s	"Set the line speed (baud)."	self speedCode: (Speeds keyAtValue: s)!stopBits	"Answer the stop bits of the port--1 or 2"	^(self byteAt: 2) + 1!stopBits: aValue	"Set the stop bits of the port"	(aValue = 1 or: [ aValue = 2 ])		ifFalse:	[self errorReporter unsupportedOperationSignal raise].	^self byteAt: 2 put: aValue - 1! !!DosTtyOptions methodsFor: 'utilities'!isBinary	"See if the tty seems to be in binary mode"	^self bits = 8!setBinary	"Set modes suitable for binary data xfer."	self bits: 8;		stopBits: 1;		parity: nil;		raw: true!setDumbTerminal	"Set modes suitable for dumb terminal emulation.	Turns on XON/XOFF flow control, and turns off all	other IO processing"	self bits: 8;		stopBits: 1;		parity: nil;		inputFlowControl: true;		outputFlowControl: true;		raw: true!setGlassCooked	"Set modes suitable for line-oriented crt emulation."	self bits: 7;		stopBits: 1;		raw: false! !!DosTtyOptions methodsFor: 'printing'!printOn: aStream	"Append to the argument aStream a sequence of characters that identifies the receiver."	super printOn: aStream.	aStream nextPut: $(.	self speed printOn: aStream.	aStream nextPutAll: ' baud, '.	self bits printOn: aStream.	aStream nextPutAll: ' bits, '.	self stopBits printOn: aStream.	aStream nextPutAll: ' stop bits, '.	self printParityOn: aStream.	aStream nextPutAll: ', '.	aStream nextPutAll: (self echo ifTrue: ['echo'] ifFalse: ['no-echo']).	aStream nextPutAll: ', '.	aStream nextPutAll: (self isRaw ifTrue: ['raw'] ifFalse: ['line-buffered']).	aStream nextPutAll: ', '.	aStream nextPutAll: (self isFlowControlledInput ifTrue: [''] ifFalse: ['no ']). 	aStream nextPutAll: 'input flow control, '.	aStream nextPutAll: (self isFlowControlledOutput ifTrue: [''] ifFalse: ['no ']). 	aStream nextPutAll: 'output flow control'.	aStream nextPut: $)!printParityOn: aStream	"Append to the argument aStream a sequence of characters that identifies the receiver's parity."	| p |	(p _ self parity) == nil		ifTrue:	[aStream nextPutAll: 'no']		ifFalse:	[p = 1					ifTrue:	[aStream nextPutAll: 'odd']					ifFalse:	[aStream nextPutAll: 'even']].	aStream nextPutAll: ' parity'! !!DosTtyOptions methodsFor: 'private'!speedCode	^self byteAt: 4!speedCode: aSpeedCode	self byteAt: 4 put: aSpeedCode! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!DosTtyOptions class	instanceVariableNames: ''!!DosTtyOptions class methodsFor: 'class initialization'!initialize	"DosTtyOptions initialize"	self initSpeeds!initSpeeds	Speeds _ IdentityDictionary new: 8.	Speeds at: 0 put: 110.	Speeds at: 1 put: 150.	Speeds at: 2 put: 300.	Speeds at: 3 put: 600.	Speeds at: 4 put: 1200.	Speeds at: 5 put: 2400.	Speeds at: 6 put: 4800.	Speeds at: 7 put: 9600! !!DosTtyOptions class methodsFor: 'instance creation'!new	^super new: 8! !DosTtyOptions initialize!Object subclass: #Exception	instanceVariableNames: 'signal parameter extraString proceedBlock initialContext handlerContext firstUnwindContext '	classVariableNames: 'EmergencyHandler '	poolDictionaries: ''	category: 'Kernel-Exception Handling'!Exception comment:'Class Exception represents an occurrence of an exceptional condition.Instance Variables:	signal	<Signal>	parameter	<Object>  the with: argument to the raise... message	extraString	<String | nil>  the errorString: argument to the raise... message	proceedBlock	<BlockClosure>  the block to evaluate if the handler says to proceed	initialContext	<Context>  the initial context where the search started	handlerContext	<Context>  the context for the handle:do:	firstUnwindContext	<Context>Class Variables:	EmergencyHandler	<BlockClosure> an emergency handler for unhandled exceptions'!!Exception methodsFor: 'initialize-release'!signal: sig parameter: par extraString: str proceedBlock: pb	"Set the instance variables of the receiver."	signal _ sig.	parameter _ par.	extraString _ str.	proceedBlock _ pb! !!Exception methodsFor: 'accessing'!errorString	"Answer the String that combines the system error message with the message for the receiver."			^signal errorStringExtra: extraString with: parameter!handlerContext	"Answer the (block) context that will be evaluated when the signal is raised."	^handlerContext!parameter	"Answer the object that is the argument to raising the exception represented by the receiver."	^parameter!signal	"Answer the signal associated with the receiver."	^signal!willProceed	"Answer whether there is a set of actions (a block) to be evaluated upon proceeding."	^proceedBlock notNil! !!Exception methodsFor: 'handler responses'!proceed	"Answer nil as the value of the signal message.	Execution continues in the signaller.	The stack is only unwound up to the signaller."	^self proceedWith: nil!proceedDoing: aBlock	"Answer the result of executing aBlock	as the value of the signal message.	The block is executed in the handler	context of the signaller, so (for example)	it can raise a different signal in place	of the original one.	Execution continues in the signaller.	The stack is only unwound up to the signaller."	proceedBlock isNil		ifTrue: [Signal proceedErrorSignal raiseWith: self  "can't proceed"]		ifFalse:			[self unwindTo: initialContext.			thisContext terminateTo: initialContext.			^aBlock value]!proceedWith: aValue	"Answer aValue as the value of the signal message.	Execution continues in the signaller.	The stack is only unwound up to the signaller."	proceedBlock isNil		ifTrue: [Signal proceedErrorSignal raiseWith: self  "can't proceed"]		ifFalse: [proceedBlock value: aValue]!reject	"The handler has decided it doesn't want to	handle this Signal.  Continue searching for	another handler."	^self propagatePrivateFrom: handlerContext sender!restart	"Restart the handle:do: expression."	self unwind.	handlerContext restart.	thisContext terminateTo: handlerContext!restartDo: aBlock	"Restart the handle:do: expression,	but execute a different do: block."	self unwind.	handlerContext localAt: 2 put: aBlock.	handlerContext restart.	thisContext terminateTo: handlerContext!return	"Unwind the stack and return nil	as the value of the handle:do: expression."	^self returnWith: nil!returnDoing: aBlock	"Unwind the stack and return the result	of executing aBlock (after unwinding)	as the value of the handle:do: expression."	self unwind.	thisContext terminateTo: handlerContext.	^aBlock value!returnWith: aValue	"Unwind the stack and return aValue	as the value of the handle:do: expression."	self unwind.	thisContext terminateTo: handlerContext.	^aValue! !!Exception methodsFor: 'raising'!propagateFrom: startContext	"Search for, and run, an appropriate handler."	initialContext _ startContext.	firstUnwindContext _ nil.	^self propagatePrivateFrom: startContext! !!Exception methodsFor: 'private'!findHandlerFrom: startContext	"Search for and return an appropriate handler.	Set handlerContext and firstUnwindContext.	If no handler is found, return nil."	| ctx cm skip |	ctx _ startContext.	[ctx == nil ifTrue: [^nil].  "no handler"	cm _ ctx method.	(cm isMarkedForHandle)		ifTrue: [(ctx receiver accepts: signal) not]		ifFalse:			[(firstUnwindContext == nil and: [cm isMarkedForUnwind])				ifTrue: [firstUnwindContext _ ctx].			true]]		whileTrue:			["In VI2.4, the test here was:				(cm isMarkedForPropagate and: [ctx receiver willProceed not]) "			ctx _ (cm isMarkedForPropagate and:					[(skip _ ctx receiver handlerContext) notNil])				ifTrue:					["Skip over signals already being propagated"					skip findNextMarkedUpTo: nil]				ifFalse: [ctx findNextMarkedUpTo: nil]].	handlerContext _ ctx.	^ctx localAt: 1!noHandlerAction: result	"Decide what to do when a handler returned	without choosing a control option."	"In VI2.4, the algorithm was:		^self willProceed			ifTrue: [self proceedWith: result]			ifFalse: [self returnWith: result]"	^self returnWith: result!propagatePrivateFrom: startContext	"Search for, and run, an appropriate handler.	This is called both initially and after a reject.	In the latter case, we don't reset firstUnwindContext."	| handler ex2 result |	handler _ self findHandlerFrom: startContext.	handler == nil ifTrue:		[(Signal noHandlerSignal accepts: signal)			ifTrue:				["If this was already an unhandled exception				exception that was rejected, just start the				emergency handler--parameter is the exception				that couldn't be handled originally"				^EmergencyHandler value: parameter value: parameter initialContext]			ifFalse:				["No handler.  Convert this exception into				an unhandled exception exception				(no, you're not seeing double here.)"				ex2 _ self class new					signal: Signal noHandlerSignal					parameter: self					extraString: nil					proceedBlock: nil.				handler _ ex2 findHandlerFrom: initialContext.				handler == nil ifTrue:					["No handler for this either.  Emergency!!"					^EmergencyHandler value: self value: initialContext].				result _ handler value: ex2.				"The handler returned without choosing an option."				^ex2 noHandlerAction: result]].	result _ handler value: self.	"The handler returned without choosing an option."	^self noHandlerAction: result!unwind	"Unwind the stack to the handlerContext,	executing unwind blocks.  Start at the context	we found during the signal search, if any."	| ctx |	ctx _ firstUnwindContext.	ctx isNil ifTrue: [^self].	[ctx == nil] whileFalse:		[(ctx localAt: 1) value.		ctx _ ctx findNextUnwindUpTo: handlerContext]!unwindTo: aContext	"Unwind the stack to aContext,	executing unwind blocks."	handlerContext _ aContext.	firstUnwindContext _ thisContext findNextUnwindUpTo: aContext.	self unwind! !!Exception methodsFor: 'debugger-private'!checkInitialContextIf: fakeCtx with: realCtx	initialContext == fakeCtx 		ifTrue: [initialContext _ realCtx].!initialContext	^initialContext!rePropagateFrom: startContext	"Answer a context of 'propagatePrivateFrom:'."	| ctx propCtx |	ctx _ [self propagatePrivateFrom: startContext] newContext.	propCtx _ ctx stepUntilVisibleEffect step.	propCtx sender: thisContext sender sender sender.	^propCtx! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Exception class	instanceVariableNames: ''!!Exception class methodsFor: 'class initialization'!initialize	"Install the emergency handler"	"Exception initialize"	self emergencyHandler: [:exception :context | self emergency: exception from: context]! !!Exception class methodsFor: 'emergency handler'!emergency: exception from: context	"Define a default emergency handler.	This one is appropriate for development	environments, but not for runtime."	(Object userInterruptSignal accepts: exception signal)		ifTrue: [NotifierView					openException: exception]		ifFalse: [NotifierView					openContext: context					label: 'Unhandled exception: ' , exception errorString					contents: context shortStack					proceedable: exception willProceed]!emergencyHandler: aBlock	"Define an emergency handler	for unhandled exceptions."	EmergencyHandler _ aBlock! !!Exception class methodsFor: 'examples'!exampleCollectionAt	"Access a collection out-of-bounds and catch the error."	"Exception exampleCollectionAt"	| collection var |	collection _ OrderedCollection new.	1 to: 10 do: [:i | collection add: i].	Collection indexNotFoundSignal		handle: 			[:ex | 			Transcript cr; show: 'Exceeded collection size'.			ex return]		do: [1 to: 20 do: 				[:i | 				var _ collection at: i.				Transcript space; show: var printString]]!exampleCollectionRemove	"Signal removing nonexistent element."	"Exception exampleCollectionRemove"	| collection |	collection _ OrderedCollection new.	1 to: 10 do: [:i | collection add: i].	Object notFoundSignal 		handle: [:ex | Transcript cr; show: 'An element not found'. 				ex return]		do: [collection remove: 17.]!exampleDictionaryAt	"Signal reading at non-existing key. The handler creates the key	and restarts to read at the key."	"Exception exampleDictionaryAt"	| aDictionary value |	aDictionary _ Dictionary new.	aDictionary at: #C put: $c.	Dictionary keyNotFoundSignal		handle: [:ex | aDictionary at: #A put: $a. ex restart]		do: [value _ aDictionary at: #A].	Transcript cr; show: value printString, ' in ', aDictionary printString!exampleDictionaryRemoveKey	"Signal removing at non-existing key. The handler simply shows an error message	and aborts."	"Exception exampleDictionaryRemoveKey"	| aDictionary |	aDictionary _ Dictionary new.	aDictionary at: #C put: $c.	Dictionary keyNotFoundSignal		handle: [:ex | Transcript cr; show: ex parameter, ' not found'. 				ex return]		do: [aDictionary removeKey: #A].!exampleDivideByZeroAbort	"Exception exampleDivideByZeroAbort"	-2.0 to: 2.0 do: [:i |	Number divisionByZeroSignal		handle: [:ex | Transcript cr; show: 'divideByZero abort'. 				ex return]		do: [10.0 / i. Transcript cr; show: i printString]].!exampleHandlerCollection	"Exception exampleHandlerCollection"	| sg1 sg2 sg3 |	sg1 _ Signal new notifierString: 'sig1'.	sg2 _ Signal new notifierString: 'sig2'.	sg3 _ Signal new notifierString: 'sig3'.	HandlerCollection new		on: sg1 handle: [:ex | Transcript cr; show: 'handler of sg1'];		on: sg2 handle: [:ex | Transcript cr; show: 'handler of sg2'];		on: sg3 handle: [:ex | Transcript cr; show: 'handler of sg3'];		handleDo: [sg2 raise].	Transcript cr; show: 'end.'!exampleReturnDoing	"When a signal is raised in a critical region, one needs to unwind 	the semaphore for the critical region before the handler is executed. 	'returnDoing:' allows the unwind to be done before the handler gets 	control."	"Exception exampleReturnDoing"	| sem |	sem _ Semaphore forMutualExclusion.	Object errorSignal handle: [:ex | ex returnDoing: [sem critical: [Transcript cr; show: 'handler block']]]		do: [sem				critical: 					[Transcript cr; show: 'do block'.					Object errorSignal raise]]	"The following code causes deadlock."	"| sem | 	sem _ Semaphore forMutualExclusion. 	Object errorSignal 	handle: [:ex | sem critical: [Transcript cr; show: 'handler block']] 	do: [sem critical: [Transcript cr; show: 'do block'. 	Object errorSignal raise]]"!exampleSignalCollection	"Signal sig1 and sig2 are caught by the handler,	but signal sig3 is not caught and a Notifier view 	shows up." 	"Exception exampleSignalCollection"	| sig1 sig2 sig3 sc |	sig1 _ Signal new notifierString: 'sig1'.	sig2 _ Signal new notifierString: 'sig2'.	sig3 _ Signal new notifierString: 'sig3'.	sc _ SignalCollection new.	sc add: sig1; add: sig2.	sc handle: [:ex | Transcript cr; show: ex signal printString]		do: [sig1 raise].	sc handle: [:ex | Transcript cr; show: ex signal printString]		do: [sig2 raise].	sc handle: [:ex | Transcript cr; show: ex signal printString]		do: [sig3 raise].!exampleSignalHierarchy	"Exception exampleSignalHierarchy"	Object errorSignal		handle: [:ex | Transcript cr; show: 'Unexpected error....abort. '. 				ex return]		do: [self clientA].	Transcript cr; show: 'done.'	"The hierarchy of signal used in this example is as follows.	Object errorSignal		Object notFoundSignal			Object indexNotFoundSignal				Object subscriptOutOfBoundsSignal				Object nonIntegerIndexSignal			Dictionary keyNotFoundSignal			Dictionary valueNotFoundSignal"!exampleStreamNextPastEnd	"Signal reading past the end of the stream.	Exception handling removes checking for EOF every time 	in the main loop as in the following conventional code:		[fileStream atEnd] whileFalse:		[Transcript show: fileStream next printString].or 	[(char _ fileStream next) == nil] whileFalse:		[Transcript show: char printString]"	"Exception exampleStreamNextPastEnd"	| fileStream fileName |	fileStream _ (fileName _ Filename named: 'tempFile') writeStream.	fileStream nextPutAll: 'ua jal twa ba klm'.	fileStream close.	fileStream _ fileName readStream.	fileStream class endOfStreamSignal		handle: [:ex | fileStream close.				ex return]		do: [[Transcript show: fileStream next printString] repeat].	fileName delete!exampleStreamPositionOutOfBounds	"Signal when you set position out of bounds of the stream. 	The handler resets position to half the size of the position."	"Exception exampleStreamPositionOutOfBounds"	| stream pos |	stream _ ReadStream with: #(ua ba twa jal klm).	pos _ 24.	stream class positionOutOfBoundsSignal 		handle: [:ex | pos _ ex parameter. pos _ pos // 2. 				Transcript cr; show: pos printString.				ex restart]		do: [stream position: pos].	Transcript cr; show: stream next!exampleUnwindSemaphore	"Unwind inconsistency of semaphore state caused by error."	"Exception exampleUnwindSemaphore"	| semaphore |	semaphore _ Semaphore new.	[semaphore wait. Transcript cr; show: 'completed'] forkAt: 4.	Processor yield.	Object errorSignal		handle: 			[:ex | Transcript cr; show: 'error occurred'. ex return]		do: 		[[Object errorSignal raise.		semaphore signal.		Transcript cr; show: 'normal end.'] 			valueOnUnwindDo: 				[semaphore signal. Transcript cr; show: 'unwind']].	"Usually we use the following style so that we don't have to	write redundant code.	[Object errorSignal raise.] 		valueNowOrOnUnwindDo: [semaphore signal]."!exampleUserInterruptSignal	"Control-C causes a pause for one second."	"Exception exampleUserInterruptSignal"	Object userInterruptSignal		handle: [:ex | (Delay forSeconds: 1) wait.						ex proceed]		do: [1 to: 100 do: 				[:i | Transcript show: ' ', i printString]]! !!Exception class methodsFor: 'private'!addSelector: selector withMethod: compiledMethod 	"Intercept this so we can mark the propagate method"	super addSelector: selector withMethod:		(selector == #propagateFrom:			ifTrue: [compiledMethod asPropagateMethod]			ifFalse: [compiledMethod])! !!Exception class methodsFor: 'private-examples'!clientA	| v |	#('2' 7 5.5 -4 'abc' '1.5') do: 		[:index |		Object notFoundSignal			handle: [:ex | Transcript show: ' not found.'. 					ex return]			do: [v _ self clientB: index.				Transcript cr; show: v printString]]!clientB: index	| hc |	hc _ HandlerCollection new.	hc on: Object indexNotFoundSignal 		handle: [:ex | Transcript cr; show: 'index: ', ex parameter printString.				ex reject].	hc on: Dictionary keyNotFoundSignal		handle: [:ex | Transcript cr; show: 'key: ', ex parameter printString.				ex reject].	hc handleDo: [^self clientC: index]!clientC: index	| i collection hc |		i _ index.	collection _ OrderedCollection with: 'A' with: 'B' with: 'C'.	hc _ HandlerCollection new.	hc on: Object nonIntegerIndexSignal 		handle: [:ex | i _ ex parameter.				i isString ifTrue: [i _ i asNumber. ex restart].				i respondsToArithmetic ifTrue: [i _ i truncated. ex restart].				ex reject "can't handle here"].	hc on: Object subscriptOutOfBoundsSignal		handle: [:ex | i _ ex parameter.				i <= 0 ifTrue: [ex reject "can't handle here"].				i _ i \\ 3. ex restart].	hc handleDo: [^collection at: i]! !Exception initialize!Model subclass: #Explainer	instanceVariableNames: 'class selector instance context methodText '	classVariableNames: 'NewLine '	poolDictionaries: ''	category: 'Tools-Programming'!Explainer comment:'An Explainer tries to determine what a piece of text represents, usually in the context of a method.Instance Variables:	class			<Symbol> a class name or class variable name or pool variable name	selector		<Symbol> a message name	instance		<Object>	context			<Context>	methodText	<Text>	Class Variables:	NewLine		<String>'!!Explainer methodsFor: 'explaining'!explain: selection for: model	"Try to shed some light on what kind of entity the current selection is.    	The selection must be a single token or construct.  Insert the answer   	after the selection.  Call private routines whose names begin with   	'explain'.  They return a String if they recognise the selection, else nil."	| reply |	selection isEmpty		ifTrue: [^ '"Please select a single token, construct, or special character."'].	reply _ Cursor execute		showWhile: 			[| string tiVars cgVars selectors delimitors numbers symbol |			string _ self explainScan: selection.			"Remove space, tab, cr"			"Temps and Instance vars need only test strings that are all letters"			(string detect: [:char | (char isLetter or: [char isDigit]) not]				ifNone: [])				~~ nil				ifFalse: 					[tiVars _ self explainTemp: string.					tiVars == nil ifTrue: [tiVars _ self explainInst: string]].			(tiVars == nil)				ifTrue: [tiVars _ model explainSpecial: string].			tiVars == nil				ifTrue: [tiVars _ '']				ifFalse: [tiVars _ tiVars , NewLine].			"Context, Class, Pool, and Global vars, and Selectors need 			only test symbols"			(Symbol hasInterned: string ifTrue: [:sym | symbol _ sym])				ifTrue: 					[cgVars _ self explainCtxt: symbol.					cgVars == nil						ifTrue: 							[cgVars _ self explainClass: symbol.							cgVars == nil ifTrue: [cgVars _ self explainGlobal: symbol]].					"See if it is a Selector (sent here or not)"					selectors _ self explainMySel: symbol.					selectors == nil						ifTrue: 							[selectors _ self explainPartSel: string.							selectors == nil ifTrue: [selectors _ self explainAnySel: symbol]]]				ifFalse: [selectors _ self explainPartSel: string].			cgVars == nil				ifTrue: [cgVars _ '']				ifFalse: [cgVars _ cgVars , NewLine].			selectors == nil				ifTrue: [selectors _ '']				ifFalse: [selectors _ selectors , NewLine].			string size = 1				ifTrue: ["single special characters"					delimitors _ self explainChar: string]				ifFalse: ["matched delimitors"					delimitors _ self explainDelimitor: string].			numbers _ self explainNumber: string.			numbers == nil ifTrue: [numbers _ ''].			delimitors == nil ifTrue: [delimitors _ ''].			tiVars , cgVars , selectors , delimitors , numbers].	reply size = 0 ifTrue: [^ '"Sorry, I can''t explain that."'].	^ reply!explainScan: aString 	"Answer aString with the beginning and trailing space, all tabs, and all cr removed."	| c beg end |	beg _ 1.	end _ aString size.		[beg = end ifTrue: [^aString copyFrom: 1 to: 1].	"if all blank, tell about the first"	c _ aString at: beg.	c = Character space or: [c = Character tab or: [c = Character cr]]]		whileTrue: [beg _ beg + 1].		[c _ aString at: end.	c = Character space or: [c = Character tab or: [c = Character cr]]]		whileTrue: [end _ end - 1].	^aString copyFrom: beg to: end		"Answer purely visible characters"! !!Explainer methodsFor: 'private'!class: aClass selector: aSymbol instance: anInstance context: aContext methodText: aText	class _ aClass.	selector _ aSymbol.	instance _ anInstance.	context _ aContext.	methodText _ aText!explainAnySel: symbol 	"Is this any message selector?"	| list reply |	list _ Smalltalk allClassesImplementing: symbol.	list size = 0 ifTrue: [^nil].	list size < 12		ifTrue: [reply _ ' is a message selector which is defined in these classes: ' , list printString]		ifFalse: [reply _ ' is a message selector which is defined in many classes'].	^'"' , symbol , reply , '."', NewLine, 'Smalltalk browseAllImplementorsOf: ' , symbol storeString!explainChar: string	"Does string start with a special character?"	| char |	char _ string at: 1.	char = $. ifTrue: [^'"Period marks the end of a Smalltalk statement.  A period in the middle of a number means a decimal point.  (The number is an instance of Float.)"'].	char = $' ifTrue: [^'"The characters between two single quotes are made into an instance of class String."'].	char = $" ifTrue: [^'"Double quotes enclose a comment.  Smalltalk ignores everything between double quotes."'].	char = $# ifTrue: [^'"The characters following a hash mark are made into an instance of class Symbol.  If a parenthesis follow the hash mark, an instance of class Array is made."'].	(char = $( or: [char = $)]) ifTrue: [^'"Expressions enclosed in parentheses are evaluated first."'].	(char = $[ or: [char = $]]) ifTrue: [^'"The code inside square brackets is an unevaluated block of code.  It becomes an instance of BlockClosure and is usually passed as an argument."'].	(char = $< or: [char = $>]) ifTrue: [^'"<primitive: xx> means that this method is usually performed directly by the Virtual Machine.  If this method is primitive, its Smalltalk code is executed only when the primitive fails."'].	char = $^ ifTrue: [^'"Uparrow means return from this method.  The value returned is the expression following the ^."'].	char = $| ifTrue: [^'"Vertical bars enclose the names of the temporary variables used in this method or block.  In a block, a vertical bar separates the argument names from the rest of the code."'].	char = $_ ifTrue: [^'"Left arrow means assignment.  The value of the expression after the left arrow is stored into the variable before it."'].	char = $; ifTrue: [^'"Semicolon means cascading.  The message after the semicolon is sent to the same object that received the message before the semicolon."'].	char = $: ifTrue: [^'"A colon at the end of a keyword means that an argument is expected to follow.  Methods that take more than one argument have selectors with more than one keyword.  (One keyword, ending with a colon, appears before each argument.)', NewLine, NewLine, 'A colon before a variable name just inside a block means that the block takes an argument.  When the block is evaluated, the argument value will be assigned to the variable whose name appears after the colon."'].	char = $$ ifTrue: [^'"The single character following a dollar sign is made into an instance of class Character."'].	char = $- ifTrue: [^'"A minus sign in front of a number means a negative number."'].	char = $e ifTrue: [^'"An e in the middle of a number means that the exponent follows."'].	char = $r ifTrue: [^'"An r in the middle of a sequence of digits is an instance of Integer expressed in a certain radix.  The digits before the r denote the base, and the digits after it express a number in that base."'].	char = Character space ifTrue: [^'"the space Character"'].	char = Character tab ifTrue: [^'"the tab Character"'].	char = Character cr ifTrue: [^'"the carriage return Character"'].	^nil!explainClass: symbol 	"Is symbol a class variable or a pool variable?"	| reply classes |	class == nil ifTrue: [^nil].	  "no class is selected"	classes _		(class isMeta ifTrue: [class soleInstance] ifFalse: [class])			withAllSuperclasses.	"class variables"	reply _ classes detect: [:each | (each classVarNames			detect: [:name | symbol = name] ifNone: [])			~~ nil] ifNone: [].	reply == nil ifFalse: [^'"is a class variable, defined in class ' , reply printString, '"', NewLine,		'Smalltalk browseAllCallsOn: (', reply printString, ' classPool associationAt: ', symbol storeString, ').'].	"pool variables"	classes do: [:each | (each sharedPools			detect: [:pool | (pool includesKey: symbol) and: [reply _ pool. true]]			ifNone: []) ~~ nil].	reply == nil ifTrue: [(Undeclared includesKey: symbol) ifTrue: [reply _ Undeclared]].	reply == nil		ifFalse: 			[classes _ WriteStream on: Array new.			Smalltalk allBehaviorsDo: [:each |					(each sharedPools detect: [:pool | pool == reply] ifNone: [])					~~ nil ifTrue: [classes nextPut: each]].			"Perhaps not print whole list of classes if too long. (unlikely)"			^'"is a pool variable from the pool ' , (Smalltalk keyAtValue: reply),			', which is used by the following classes: ' , classes contents printString , '"', NewLine,			'Smalltalk browseAllCallsOn: (', (Smalltalk keyAtValue: reply) printString,			' associationAt: ', symbol storeString, ').'].	^nil!explainCtxt: symbol 	"Is symbol a context variable?"	| reply classes text |	symbol = #nil ifTrue: [reply _ '"is a constant.  It is the only instance of class UndefinedObject.  nil is the initial value of all variables."'].	symbol = #true ifTrue: [reply _ '"is a constant.  It is the only instance of class True and is the receiver of many control messages."'].	symbol = #false ifTrue: [reply _ '"is a constant.  It is the only instance of class False and is the receiver of many control messages."'].	class == nil ifTrue: [^nil].	  "no message selected"	symbol = #self		ifTrue: 			[classes _ class withAllSubclasses.			classes size > 12				ifTrue: [text _ class printString , ' or a subclass']				ifFalse: 					[classes _ classes printString.					text _ 'one of these classes: ' , classes asArray].			reply _ '"is the receiver of this message, an instance of ' , text , '"'].	symbol = #super ifTrue: [reply _ '"is just like self.  Messages to super are looked up in the superclass (' , class superclass printString , ')"'].	symbol = #thisContext ifTrue: [reply _ '"is a context variable.  Its value is always the MethodContext which is executing this method, or the BlockContext executing a block within this method."'].	^reply!explainDelimitor: string	"Is string enclosed in delimitors?"	| str |	(string at: 1) isLetter ifTrue: [^nil].  "only special chars"	(string first = string last) ifTrue:			[^ self explainChar: (String with: string first)]		ifFalse:			[(string first = $( and: [string last = $)]) ifTrue:				[^ self explainChar: (String with: string first)].			(string first = $[ and: [string last = $]]) ifTrue:				[^ self explainChar: (String with: string first)].			(string first = $< and: [string last = $>]) ifTrue:				[^ self explainChar: (String with: string first)].			(string first = $# and: [string last = $)]) ifTrue:				[^'"An instance of class Array.  The Numbers, Characters, or Symbols between the parentheses are the elements of the Array."'].			string first = $# ifTrue:				[^'"An instance of class Symbol."'].			(string first = $$ and: [string size = 2]) ifTrue:				[^'"An instance of class Character.  This one is the character ', (String with: string last), '."'].			(string first = $:) ifTrue:				[str _ (string copyFrom: 2 to: string size).				(self explainTemp: str) ~~ nil ifTrue:					[^'"An argument supplied to this block will be bound to the temporary variable ',						str, '."']]].	^ nil!explainGlobal: symbol 	"Is symbol a global variable?"	| reply classes |	reply _ Smalltalk at: symbol ifAbsent: [^nil].	reply isBehavior		ifTrue: [^'"is a global variable.  ' , symbol , ' is a class in category ', reply category,			'."', NewLine, 'Browser newOnClass: ' , symbol , '.'].	symbol == #Smalltalk ifTrue: [^'"is a global variable.  Smalltalk is the only instance of SystemDictionary and holds all global variables."'].	reply class == Dictionary		ifTrue: 			[classes _ OrderedCollection new.			Smalltalk allBehaviorsDo: [:each | (each sharedPools detect: [:pool | pool == reply]					ifNone: [])					~~ nil ifTrue: [classes add: each]].			^'"is a global variable.  ' , symbol , ' is a Dictionary.  It is a pool which is used by the following classes' , classes asArray printString , '"'].	^'"is a global variable.  ' , symbol , ' is ' , reply printString , '"'!explainInst: string 	"Is string an instance variable of this class?"	| classes |	class == nil ifTrue: [^nil].	  "no class is selected"	classes _ class withAllSuperclasses.	classes _ classes detect: [:each | (each instVarNames			detect: [:name | name = string] ifNone: [])			~~ nil] ifNone: [^nil].	classes _ classes printString.	^ '"is an instance variable of the receiver, defined in class ' , classes , '."',		NewLine , classes , ' browseAllAccessesTo: ''' , string , '''.'!explainMySel: symbol 	"Is symbol the selector of this method?  Is it sent by this method?  If 	not, then explain will call (explainPartSel:) to see if it is a fragment of a 	selector sent here.  If not, explain will call (explainAnySel:) to catch any 	selector. "	| lits classes |	selector == nil ifTrue: [^nil].	"not in a message"	classes _ Smalltalk allClassesImplementing: symbol.	classes size > 12		ifTrue: [classes _ 'many classes']		ifFalse: [classes _ 'these classes: ' , classes printString].	selector = symbol		ifTrue: [^ '"' , symbol , ' is the selector of this very method!!  It is defined in ',			classes , '.  To see the other definitions, go to the message list subview and use yellow button to select ''implementors''."']		ifFalse: 			[lits _ (class compiledMethodAt: selector) messages.			(lits detect: [:each | each == symbol]				ifNone: [])				== nil ifTrue: [^nil].			^ '"' , symbol , ' is a message selector which is defined in ', classes , '.  To see the definitions, go to the message list subview and use yellow button to select ''messages''."'].!explainNumber: string 	"Is string a Number?"	| strm c |	(c _ string at: 1) isDigit ifFalse: [(c = $- and: [string size > 1])			ifFalse: [^nil]].	strm _ ReadStream on: string.	c _ Number readFrom: strm.	strm atEnd ifFalse: [^nil].	c printString = string		ifTrue: [^'"' , string , ' is a ' , c class name , '."']		ifFalse: [^'"' , string , ' (= ' , c printString , ') is a ' , c class name , '."']!explainPartSel: string 	"Is this a fragment of a multiple-argument selector sent in this method?"	| lits whole reply classes s |	selector == nil ifTrue: [^nil].  "not in a message"	string last == $: ifFalse: [^nil].	"Name of this method"	lits _ Array with: selector.	(whole _ lits detect: [:each | (each keywords detect: [:frag | frag = string]					ifNone: []) ~~ nil]				ifNone: []) ~~ nil		ifTrue: [reply _ ', which is the selector of this very method!!'.			s _ '.  To see the other definitions, go to the message list subview and use yellow button to select ''implementors''."']		ifFalse: 			["Selectors called from this method"			lits _ (class compiledMethodAt: selector) messages.			(whole _ lits detect: [:each | (each keywords detect: [:frag | frag = string]							ifNone: []) ~~ nil]						ifNone: []) ~~ nil				ifFalse: [string = 'primitive:'					ifTrue: [^self explainChar: '<']					ifFalse: [^nil]].			reply _ '.'.			s _ '.  To see the definitions, go to the message list subview and use yellow button to select ''messages''."'].	classes _ Smalltalk allClassesImplementing: whole.	classes size > 12		ifTrue: [classes _ 'many classes']		ifFalse: [classes _ 'these classes: ' , classes printString].	^ '"' , string , ' is one part of the message selector ' , whole, reply , '  It is defined in ' , classes , s!explainTemp: string 	"Is string the name of a temporary variable (or block	argument or temporary variable)?"	| tempNames i method |	selector == nil ifTrue: [^nil].	"no message is selected"	tempNames _ class parserClass new parseArgsAndTemps: methodText notifying: nil.	method _ class compiledMethodAt: selector.	i _ tempNames indexOf: string ifAbsent:		[| holder var |		(method withAllBlockMethods size > 1 and: [Smalltalk frills])			ifFalse: [^nil]. 		"It must be a block argument or temporary.		Get the complete list of temporary variable names.		Eventually, the explanation should depend on the		scopes that enclose the selection point,		but that is too complicated to implement right now."		holder _ class compilerClass new					parse: methodText					in: class					notifying: nil.		holder variableMap			detect: [:scope | (var _ scope variableAt: string from: nil) notNil]			ifNone: [^nil].		(var isMemberOf: ArgumentVariable)			ifTrue: [^'"is an argument to a block in this method."'].		(var isKindOf: LocalVariable)			ifTrue: ['"is a temporary variable in a block in this method."'].		^nil].	^i > method numArgs		ifTrue: ['"is a temporary variable in this method."']		ifFalse: ['"is an argument to this method."']! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Explainer class	instanceVariableNames: ''!!Explainer class methodsFor: 'class initialization'!initialize 	"Explainer initialize."	NewLine _ String with: Character cr! !Explainer initialize!Object subclass: #ExternalConnection	instanceVariableNames: 'inputDescriptor outputDescriptor '	classVariableNames: ''	poolDictionaries: ''	category: 'OS-Streaming'!ExternalConnection comment:'Instances of ExternalConnection hold ioAccessors for input and output.  ExternalConnections can not be reopened although subclasses might be able to.Instance Variables:	inputDescriptor  	<IOAccessor>	outputDescriptor	<IOAccessor>'!!ExternalConnection methodsFor: 'accessing'!dataSize	"Answer zero since the receiver can't know the amount of data	assoicated with the connection."	^0!input	"Answer the receiver's input descriptor."	^inputDescriptor!input: anAccessor	"Change the receiver's input descriptor."	inputDescriptor _ anAccessor!lineEndConvention	"Answer a default line end convention for the receiver."	^inputDescriptor lineEndConvention!name	"Answer nil since the receiver knows no name."	^nil!output	"Answer the receiver's output descriptor."	^outputDescriptor!output: anAccessor	"Change the receiver's output descriptor."	outputDescriptor _ anAccessor! !!ExternalConnection methodsFor: 'iobuffer creation'!defaultIoBufferInMode: binaryFlag	"Answer a default ioBuffer approiate to the receiver with either binary or text mode."	^IOBuffer on: self mode: binaryFlag!ioBufferInMode: binaryFlag	"Answer a default ioBuffer appropriate to the receiver with either binary or text mode."	^IOBuffer on: self mode: binaryFlag! !!ExternalConnection methodsFor: 'status'!close	"Close the receiver."	self closeInput.	self closeOutput!closeInput	"Close the receiver's input descriptor.  If the output descriptor is the same as the input descriptor	then set it to nil."	inputDescriptor == nil		ifFalse: [inputDescriptor == outputDescriptor					ifTrue: [outputDescriptor _ nil].				inputDescriptor close.				inputDescriptor _ nil]!closeOutput	"Close the receiver's output descriptor.  If the input descriptor is the same as the output descriptor	then set it to nil."	outputDescriptor == nil		ifFalse: [outputDescriptor == inputDescriptor					ifTrue: [inputDescriptor _ nil].				outputDescriptor close.				outputDescriptor _ nil]!invalidate	"Forget any descriptors.	The sender is asserting that the state of the receiver is invalid."	inputDescriptor _ nil.	outputDescriptor _ nil!isActive	"Answer true if the receiver is active (open),  answer false otherwise."	^outputDescriptor ~~ nil or: [inputDescriptor ~~ nil]!release	"Release any descriptors."	inputDescriptor == nil ifFalse: [inputDescriptor release].	outputDescriptor == nil			ifFalse: [inputDescriptor == outputDescriptor						ifFalse: [outputDescriptor release]].	inputDescriptor _ nil.	outputDescriptor _ nil! !!ExternalConnection methodsFor: 'testing'!canPersist	"Answer a boolean as to whether the receiver can be reopened.	The default is false."	^false! !!ExternalConnection methodsFor: 'stream creation'!readAppendStream	"Answer a readAppendStream on the receiver."	^ExternalReadAppendStream on: self!readStream	"Answer a readStream on the receiver."	^ExternalReadStream on: self!writeStream	"Answer a writeStream on the receiver."	^ExternalWriteStream on: self! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!ExternalConnection class	instanceVariableNames: ''!!ExternalConnection class methodsFor: 'instance creation'!inputAccessor: anInputAccessor outputAccessor: anOutputAccessor	"Answer an instance of the receiver using anInputAccessor for input	and anOutputAccessor for output."	| connection |	connection _ self new.	connection input: anInputAccessor.	connection output: anOutputAccessor.	^connection!ioAccessor: anIOAccessor	"Answer an instance of the receiver using anIOAccessor for both input and output."	^self inputAccessor: anIOAccessor outputAccessor: anIOAccessor! !OSHandle subclass: #ExternalProcess	instanceVariableNames: ''	classVariableNames: 'ChildProcesses DefaultClass '	poolDictionaries: ''	category: 'OS-Support'!ExternalProcess comment:'Class ExternalProcess is an abstract class.  An instance of one of its subclasses is a reference to a (heavyweight) OS-level process which was created as a child of the running Smalltalk.  Instances are typically created from return values of primitives which "fork&exec" new (heavyweight) processes.As a subclass of OSHandle, ExternalProcess inherits the handle instance variable which is used to hold an identifier of the process which is meaningful to the underlying OS.Class Variables:	ChildProcesses	<HandleRegistry>	DefaultClass	<MetaClass> The correct concrete subclass for this platform.'!"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!ExternalProcess class	instanceVariableNames: ''!!ExternalProcess class methodsFor: 'class initialization'!clearRegistry	"Break all the references in my registry and free it."	super clearRegistry.	ChildProcesses _ nil!initialize	"ExternalProcess initialize"	"Assume no concrete subclass is available. 	Set up registry."	self = ExternalProcess		ifTrue: 			[DefaultClass _ self.			self clearRegistry.			self makeRegistry]!install	"You are the default class for ExternalProcess.  Install yourself."	"Do nothing for abstract classes."!makeRegistry	"Set up the handle registry."	ChildProcesses _ HandleRegistry new: 10! !!ExternalProcess class methodsFor: 'class access'!defaultClass: cls	"Assign the appropriate concrete class for this platform.	Typically done only when resuming a snapshot on a different	platform."	DefaultClass _ cls!registry	"Return my handle registry."	^ChildProcesses! !!ExternalProcess class methodsFor: 'process reaping'!reapSome	"Find all exited child processes and reap them."	"This routine may be called from a high priority process."	"Should be ^self subclassResponsibility but we don't want to break	InputState>>run.  When subclassResponsibility is implemented with	signals, then we wouldn't worry."! !!ExternalProcess class methodsFor: 'defaulting'!defaultClass	"Answer the appropriate concrete subclass for this platform."	^DefaultClass! !ExternalProcess initialize!ExternalReadStream subclass: #ExternalReadAppendStream	instanceVariableNames: 'writeStream '	classVariableNames: ''	poolDictionaries: ''	category: 'OS-Streaming'!ExternalReadAppendStream comment:'The receiver does read streaming in the same way as the super class.  Writing is done by forwarding to an ExternalWriteStream.  Writes only go to the end of data.Instance Variables:	writeStream 	<ExternalWriteStream>'!!ExternalReadAppendStream methodsFor: 'accessing'!commit	"Commit any unwritten information to the OS."	^writeStream commit!flush	"Write any unwritten information."	writeStream flush!lineEndConvention: aNumber	super lineEndConvention: aNumber.	writeStream lineEndConvention: aNumber!nextPut: aByte	"Insert the argument at the next position in the buffer." 	writeStream nextPut: aByte!nextPutAll: aCollection	"Append the elements of aCollection onto the receiver.  Answer aCollection."	^writeStream nextPutAll: aCollection!size	"Answer the size of data the receiver streams over."	^writeStream size! !!ExternalReadAppendStream methodsFor: 'character/binary'!binary	"Set the receiver's buffer to be binary." 	super binary.	writeStream binary!text	"Set the receiver's buffer to be character." 	super text.	writeStream text! !!ExternalReadAppendStream methodsFor: 'status'!close	"Close the receiver."	writeStream close.	super close! !!ExternalReadAppendStream methodsFor: 'positioning'!position: aPosition	"Set the receiver's read position to be aPosition."	self flush.	super position: aPosition!writePosition	"Answer the receiver's write position."	^writeStream writePosition! !!ExternalReadAppendStream methodsFor: 'fileOut'!nextChunkPut: aString 	"Put aString onto the receiver, doubling embedded terminators."	writeStream nextChunkPut: aString! !!ExternalReadAppendStream methodsFor: 'printing'!print: anObject 	"Have anObject print on the receiver."	anObject printOn: writeStream!store: anObject 	"Have anObject print on the receiver for rereading."	anObject storeOn: writeStream! !!ExternalReadAppendStream methodsFor: 'private'!on: anIOConnection	"Initialize the receiver on anIOConnection."		writeStream _ ExternalWriteStream on: anIOConnection.	super on: anIOConnection.! !BufferedExternalStream subclass: #ExternalReadStream	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'OS-Streaming'!ExternalReadStream comment:'The receiver streams over a buffered external connection and simulate streaming over a contiguous collection.  It uses the stream primitives next,and atEnd.  When position exceeds the readLimit, the stream primitives fail and the Smalltalk failure code gets the next buffer and resets position and readLimit.  Instances are only used for reading.'!!ExternalReadStream methodsFor: 'accessing'!flush	"Do nothing since the receiver only reads."	^self!next	"Answer the next object in the Stream represented by the receiver."	| ch |	position >= readLimit		ifTrue: [ch _ self pastEnd.				ch == nil ifTrue: [^nil]]		ifFalse: [ch _ collection at: (position _ position + 1)].	(binary or: [lineEndConvention == LineEndCR])		ifTrue: [^ch].	lineEndConvention == LineEndLF		ifTrue: [ch == LF					ifTrue: [^CR]					ifFalse: [^ch]].	lineEndConvention == LineEndCRLF		ifTrue: [ch == CR					ifTrue: [position >= readLimit								ifTrue: [ch _ self pastEnd.										ch == nil ifTrue: [^CR]]								ifFalse: [ch _ collection at: (position _ position + 1)].							ch == LF ifFalse: [position _ position - 1].							^CR]					ifFalse: [^ch]].	lineEndConvention == LineEndTransparent		ifTrue: [^ch]!nextHunk	"Answer the next buffers worth of stuff in the Stream represented by the receiver.  Do at most one actual io operation."	| stream ch |	(lineEndConvention == LineEndCRLF and: [binary not])		ifTrue:			[" Must do it one character at a time. "			self class endOfStreamSignal				handle: [:ex | ^self contentsSpecies new: 0]				do:	[ch _ self next].			stream _ (self contentsSpecies new: readLimit - position) writeStream.			stream nextPut: ch.			[position < (readLimit-1)] whileTrue: [stream nextPut: self next].			^stream contents].	"Force a new buffer if the current position is at the end"	self class endOfStreamSignal		handle: [:ex | ^self contentsSpecies new: 0]		do:	[self peek].	^self next: readLimit - position! !!ExternalReadStream methodsFor: 'positioning'!skip: n 	"Reposition to the relative number n."		| pos|	self openIfClosed.	(lineEndConvention == LineEndCRLF and: [binary not])		ifTrue: [^self crlfSkip: n].	pos _ position + n.	(pos >= 0 and: [pos <= readLimit])		ifTrue: [position _ pos]		ifFalse: [self setPosition: self readPosition + n]! !ExternalReadStream subclass: #ExternalReadWriteStream	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'OS-Streaming'!ExternalReadWriteStream comment:'The receiver (and subclasses) stream over a buffered external connection and simulate streaming over a contiguous collection.  It uses the stream primitives next, nextPut: and atEnd.  When position exceeds the readLimit or writeLimit, the stream primitives fail and the Smalltalk failure code gets the next buffer and resets position, readLimit and writeLimit.  Any Writing will be preceded by a read (if necessary) since writing can take place anywhere.'!!ExternalReadWriteStream methodsFor: 'accessing'!flush	"Write any unwritten information."	(writeLimit ~~ nil and: [self writing])		ifTrue: [self fixEnd.				ioBuffer flushBufferUpTo: readLimit.				writeLimit _ nil]!nextPut: aByte	"Insert the argument at the next position in the Stream represented by the receiver."	self writing ifFalse: [^self error: 'no writing allowed!!' ].	writeLimit == nil		ifTrue: [self openIfClosed.				readLimit = 0					ifTrue: [self nextBuffer].				writeLimit _ ioBuffer lastWriteablePosition.				ioBuffer bufferChanged].	position >= writeLimit		ifTrue: [self nextBuffer.				writeLimit _ ioBuffer lastWriteablePosition.				ioBuffer bufferChanged].	aByte == CR "as things stand you can't be binary and have a CR"		ifTrue: [lineEndConvention == LineEndLF					ifTrue: [collection at: (position _ position + 1) put: LF.							^aByte].				lineEndConvention == LineEndCR					ifTrue: [^collection at: (position _ position + 1) put: aByte].				lineEndConvention == LineEndCRLF					ifTrue: [collection at: (position _ position + 1) put: aByte.							position >= writeLimit								ifTrue: [self nextBuffer.										writeLimit _ ioBuffer lastWriteablePosition.										ioBuffer bufferChanged].							collection at: (position _ position + 1) put: LF.							^aByte].				lineEndConvention == LineEndTransparent					ifTrue: [^collection at: (position _ position + 1) put: aByte]]		ifFalse: [^collection at: (position _ position + 1) put: aByte]!size	"Answer the size of the file the receiver streams over."	| size |	size _ super size.	self fixEnd.	^ioBuffer currentBufferPosition + readLimit max: size! !!ExternalReadWriteStream methodsFor: 'nonhomogeneous positioning'!padTo: bsize 	"Pad (skip) to next boundary of bsize characters, and answer how many characters were skipped."	| rem |	rem _ bsize - (self position \\ bsize).	rem = bsize ifTrue: [^0].	self skip: rem.	^rem!padTo: bsize put: aCharacter 	"Pad using the argument, aCharacter, to the next boundary of bsize characters, 	and answer how many characters were written."	| rem |	rem _ bsize - (self position \\ bsize).	rem = bsize ifTrue: [^0].	self next: rem put: aCharacter.	^rem! !!ExternalReadWriteStream methodsFor: 'positioning'!position: anIndex	"Set position to anInteger.  The make readPosition be >= to the buffer position."	| pos n |	self openIfClosed.	n _ anIndex - self readPosition.	pos _ position + n.	(readLimit > 0 and: [pos >= 0 and: [pos <= collection size]])		ifTrue: [n < 0 					ifTrue: [self fixEnd.							position _ pos]					ifFalse: [position _ pos.							self fixEnd]]		ifFalse: [self setPosition: anIndex.				self fixEnd]!skip: n 	"Reposition to the relative number n."		| pos|	self openIfClosed.	(lineEndConvention == LineEndCRLF and: [binary not])		ifTrue: [self fixEnd.				self crlfSkip: n.				self fixEnd.				^self].	pos _ position + n.	(readLimit > 0 and: [pos >= 0 and: [pos <= collection size]])		ifTrue: [n < 0 					ifTrue: [self fixEnd.							position _ pos]					ifFalse: [position _ pos.							self fixEnd]]		ifFalse: [self setPosition: self position + n.				self fixEnd]! !!ExternalReadWriteStream methodsFor: 'private'!fixEnd	"Set new read limit if writing has moved position past the read limit."	position > readLimit ifTrue: [readLimit _ position]!writing	"Answer true since the receiver is permited to write." 	^true! !PositionableStream subclass: #ExternalStream	instanceVariableNames: ''	classVariableNames: 'CantReopenSignal '	poolDictionaries: ''	category: 'OS-Streaming'!ExternalStream comment:'Class ExternalStream represents an accessor for a sequence of objects that communicate to the outside world.  The instances of subclasses can contain non-homogenous elements.  Implementation of the class methods assumes streaming on a collection of binary, byte-sized elements;  methods assume that a "word" consists of two-bytes.  Its primary subclass is FileStream.Subclasses must implement	nonhomogeneous positioning		padTo:		padTo:put:Class Variables:	CantReopenSignal	<Signal> Connection can not reopen!!				'!!ExternalStream methodsFor: 'nonhomogeneous positioning'!padTo: bsize 	"Pad (skip) to next boundary of bsize characters, and answer how many characters	were skipped."	self subclassResponsibility!padTo: bsize put: aCharacter 	"Pad using the argument, aCharacter, to the next boundary of bsize characters, 	and answer how many characters were written."	self subclassResponsibility!padToNextWord	"Make position even (on word boundary), answering the padding character if any."	position even		ifTrue: [^false]		ifFalse: [^self next]!padToNextWordPut: char 	"Make position even on word boundary, writing the padding 	character, char, if necessary.  Answer nil if already on a word 	boundary."	position even		ifTrue: [^nil]		ifFalse: [^self nextPut: char]!skipWords: nWords 	"Position after nWords number of words."	self skip: 2 * nWords!wordPosition	"Answer the current position in words."	^self position / 2!wordPosition: wp 	"Set current position in words to be wp."	self position: 2 * wp! !!ExternalStream methodsFor: 'nonhomogeneous accessing'!nextLong	"Read a 32-bit quantity from the input stream."	| m1 m2 m3 m4 |	m1 _ self next. m1 == nil ifTrue: [ ^false ].	m2 _ self next. m2 == nil ifTrue: [ ^false ].	m3 _ self next. m3 == nil ifTrue: [ ^false ].	m4 _ self next. m4 == nil ifTrue: [ ^false ].	^(((m1 asInteger bitShift: 24) + (m2 asInteger bitShift: 16)) + (m3 asInteger bitShift: 8)) + m4 asInteger!nextLongPut: a32BitW	"Write out a 32-bit integer as 32 bits."	self nextPut: ((a32BitW bitShift: -24) bitAnd: 16rFF).	self nextPut: ((a32BitW bitAnd: 16rFF0000) bitShift: -16).	self nextPut: ((a32BitW bitAnd: 16rFF00) bitShift: -8).	self nextPut: (a32BitW bitAnd: 16rFF).	^a32BitW!nextNumber: n 	"Answer the next n bytes as a positive Integer or LargePositiveInteger."	| s |	n <= 2		ifTrue: 			[s _ 0.			n timesRepeat: [s _ s * 256 + self next].			^s].	s _ Integer new: n neg: false.	1 to: n do: [:i | s at: n + 1 - i put: self next].	"reverse order of significance"	^s compressed!nextNumber: n put: v 	"Append to the receiver the argument, v, which is a positive SmallInteger or	a LargePositiveInteger, as the next n bytes.  Possibly pad with leading zeros."	| vlen |	vlen _ v digitLength.	n < vlen		ifTrue: [self error: 'number too big']		ifFalse: [n > vlen ifTrue: [self next: n - vlen put: 0]].	"pad beginning with 0's"	vlen to: 1 by: -1 do:		[:i | self nextPut: (v digitAt: i)]!nextSignedInteger	"Answer the next two bytes from the receiver as a signed Integer."	| returnValue |	self atEnd ifTrue: [^false].	returnValue _ self next asInteger.	self atEnd ifTrue: [^false].	(returnValue _ returnValue * 256 + self next asInteger) highBit = 16		ifTrue:	[^returnValue - 65536	"16-bit negative 0"]		ifFalse:	[^returnValue].!nextString	"Answer a new String read from the receiver. The first byte is the 	length of the string, unless it is greater than 192, in which case the	first two bytes encode the length. "	| aString length |	length _ self next.	"first byte."	length >= 192 ifTrue: [length _ length - 192 * 256 + self next].	aString _ String new: length.	1 to: length do: [:i | aString at: i put: self next asCharacter].	^aString!nextStringPut: aString 	"Append the string, aString, to the receiver."	| length |	(length _ aString size) < 192		ifTrue: [self nextPut: length]		ifFalse: 			[self nextPut: (length // 256 + 192).			self nextPut: (length \\ 256)].	aString do: [:char | self nextPut: char asciiValue].	^aString!nextWord	"Answer the next two bytes from the receiver as an Integer."	| high low |	high _ self next.		high==nil ifTrue: [^false].	low _ self next.		low==nil ifTrue: [^false].	^(high asInteger bitShift: 8) + low asInteger!nextWordPut: aWord 	"Append to the receiver an Integer as the next two bytes."	self nextPut: ((aWord bitShift: -8) bitAnd: 255).	self nextPut: (aWord bitAnd: 255).	^aWord! !!ExternalStream methodsFor: 'errors'!reopenError	"Raise a cantReopenSignal."	^self class cantReopenSignal raiseRequestWith: self! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!ExternalStream class	instanceVariableNames: ''!!ExternalStream class methodsFor: 'class initialization'!initialize	"Initialize class variables."	"ExternalStream initialize."	self initSignals!initSignals	"ExternalStream initSignals."	CantReopenSignal _ Object errorSignal newSignal 		notifierString: 'Connection can not reopen!!';		nameClass: self message: #cantReopenSignal! !!ExternalStream class methodsFor: 'instance creation'!new	"Answer a new instance of the receiver."	^self basicNew! !!ExternalStream class methodsFor: 'Signal constants'!cantReopenSignal	^CantReopenSignal! !ExternalStream initialize!BufferedExternalStream subclass: #ExternalWriteStream	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'OS-Streaming'!ExternalWriteStream comment:'Class ExternalWriteStream streams over a buffered external connection and simulates streaming over a contiguous collection.  It uses the stream primitive nextPut: .  When position exceeds the writeLimit, the stream primitives fail and the Smalltalk failure code flushes the buffer and resets position writeLimit.  Writing only takes place at the end of data.'!!ExternalWriteStream methodsFor: 'accessing'!flush	"Write any unwritten information."	(writeLimit == nil or: [position < 1])		ifTrue: [^self].	ioBuffer bufferChanged.	ioBuffer flushBufferUpTo: position.	collection _ ioBuffer buffer.	position _ ioBuffer firstDataPosition -1.	writeLimit _ collection size.!next	"The receiver does not implement next."		^self shouldNotImplement!nextPut: aByte	"Insert the argument at the next position in the buffer." 	writeLimit == nil		ifTrue: [self openIfClosed.				writeLimit _ ioBuffer lastWriteablePosition].	position >= writeLimit		ifTrue: [self flush].	aByte == CR "as things stand you can't be binary and have a CR"		ifTrue: [lineEndConvention == LineEndLF					ifTrue: [collection at: (position _ position + 1) put: LF.							^aByte].				lineEndConvention == LineEndCR					ifTrue: [^collection at: (position _ position + 1) put: aByte].				lineEndConvention == LineEndCRLF					ifTrue: [collection at: (position _ position + 1) put: aByte.							position >= writeLimit								ifTrue: [self flush].							collection at: (position _ position + 1) put: LF.							^aByte].				lineEndConvention == LineEndTransparent					ifTrue: [^collection at: (position _ position + 1) put: aByte]]		ifFalse: [^collection at: (position _ position + 1) put: aByte]!size	"Answer the size of the collection the receiver streams over.	This only makes sense if the connection is a file."	self openIfClosed.	self flush.	^ioConnection dataSize! !!ExternalWriteStream methodsFor: 'positioning'!position	"Answer the receiver's write position."	^self writePosition!position: anIndex	"Not valid for this class"	self error: 'ExternalWriteStreams cannot be positioned'!setToEnd	"Do nothing.  The receiver is already at the end."	^self!writePosition	"Answer the receiver's write position."	ioBuffer == nil  ifTrue: [self reopen].		^ioConnection dataSize + position! !!ExternalWriteStream methodsFor: 'testing'!atEnd	"The receiver is always at the end."	^true! !!ExternalWriteStream methodsFor: 'private'!closeConnection	"Close the receiver's io connection."	self flush.	ioConnection close.	position _ readLimit _ 0.	writeLimit _ nil!getIoBuffer	"Get an io buffer from the receiver's io connection."	^ioConnection ioBufferInMode: binary!nextBuffer	"Flush the buffer.  Do not read since the receiver is write only."	self flush!reopen	"Reopen the receiver's io connection.	There is no remembered position since the receiver can only append to the end."	ioConnection canPersist		ifTrue: [ioConnection revive.				self setupBufferAndLimits.				self resetDependency.]		ifFalse: [self reopenError.				self setupBufferAndLimits].! !Boolean subclass: #False	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Kernel-Objects'!False comment:'Class False describes the behavior of its sole instance, false, logical negation.'!!False methodsFor: 'logical operations'!& alternativeObject 	"Evaluating conjunction.  Answer false since receiver is false."	^self!not	"Negation -- answer true since the receiver is false."	^true!| aBoolean 	"Evaluating disjunction (OR) -- answer with the argument, aBoolean."	^aBoolean! !!False methodsFor: 'controlling'!and: alternativeBlock 	"Nonevaluating conjunction -- answer with false since the receiver is false."	"Execution does not actually reach here because the expression is compiled in-line."	^self!ifFalse: alternativeBlock 	"Answer the value of alternativeBlock. This method is typically not 	invoked because ifTrue:/ifFalse: expressions are compiled in-line for 	literal blocks."	^alternativeBlock value!ifFalse: falseAlternativeBlock ifTrue: trueAlternativeBlock 	"Answer the value of falseAlternativeBlock. This method is typically 	not invoked because ifTrue:/ifFalse: expressions are compiled in-line 	for literal blocks."	^falseAlternativeBlock value!ifTrue: alternativeBlock 	"Since the condition is false, answer the value of the false 	alternative, which is nil. This method is typically not invoked 	because ifTrue:/ifFalse: expressions are compiled in-line for literal 	blocks."	^nil!ifTrue: trueAlternativeBlock ifFalse: falseAlternativeBlock 	"Answer the value of falseAlternativeBlock. This method is typically 	not invoked because ifTrue:/ifFalse: expressions are compiled in-line 	for literal blocks."	^falseAlternativeBlock value!or: alternativeBlock 	"Nonevaluating disjunction -- answer value of alternativeBlock."	"Execution does not actually reach here because the expression is compiled in-line."	^alternativeBlock value! !!False methodsFor: 'printing'!isLiteral	"Answer that the receiver has a literal text form recognized 	by the compiler. "	^true!printOn: aStream 	"Print false."	aStream nextPutAll: 'false'! !ExternalConnection subclass: #FileConnection	instanceVariableNames: 'fileName rwmode creationRule rememberedPosition '	classVariableNames: ''	poolDictionaries: ''	category: 'OS-Streaming'!FileConnection comment:'Instances of FileConnection hold descriptors for a named file. Connections can be reopened to a remembered position if the fileName is not nil.  The inputDescriptor and outputDescriptor are the same object.Instance Variables:	fileName				<String> 	rwmode					<Symbol>	creationRule			<Symbol>	rememberedPosition 	<SmallInteger | nil>'!!FileConnection methodsFor: 'accessing'!dataSize	"Answer the size of the file."	^inputDescriptor fileSize!name	"Answer the receiver's name."	^fileName! !!FileConnection methodsFor: 'io buffer creation'!defaultIoBuffer	"Answer a PositionalIOBuffer connected to the receiver."	^PositionalIOBuffer on: self!defaultIoBufferInMode: binaryFlag	"Answer a default ioBuffer approiate to the receiver with either binary or text mode."	^PositionalIOBuffer on: self mode: binaryFlag! !!FileConnection methodsFor: 'testing'!canPersist	"Answer a boolean as to whether the receiver can be reopened.	The answer is true if the file name is known."	^fileName notNil! !!FileConnection methodsFor: 'status'!isActive	"Answer true if the receiver is open."	^outputDescriptor ~~ nil!open	"Open the receiver."	self isActive ifTrue: [^self].	inputDescriptor _ IOAccessor				openFileNamed: fileName				direction: (IOAccessor perform: rwmode)				creation: (IOAccessor perform: creationRule).	outputDescriptor _ inputDescriptor! !!FileConnection methodsFor: 'persistence'!rememberedPosition	"Answer the receiver's remembered file position."	^rememberedPosition!rememberPosition: aPosition	"Remember the file position aPosition."	rememberedPosition _ aPosition!revive	"Restart the connection."	self open! !!FileConnection methodsFor: 'private'!setName: aName mode: aRwMode creationRule: aCreationRule	fileName  _ aName asString.	rwmode _ aRwMode.	creationRule _ aCreationRule.	self open.	"Make sure that reopening does not cause truncation."	creationRule == #truncateOrCreate		ifTrue: [creationRule _ #noCreate]		ifFalse: [creationRule == #truncateNoCreate					ifTrue: [creationRule _ #noCreate]]! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!FileConnection class	instanceVariableNames: ''!!FileConnection class methodsFor: 'instance creation'!openFileNamed: aName mode: rwMode	"Answer a new instance of the receiver with given name and read write mode."	^self openFileNamed: aName mode: rwMode creationRule: #mayCreate!openFileNamed: aName mode: rwMode creationRule: creationRule 	"Answer a new instance of the receiver with given name, read write mode,	and creation rule."	^self new		setName: aName		mode: rwMode		creationRule: creationRule! !Object subclass: #FileDirectory	instanceVariableNames: 'directoryName '	classVariableNames: 'ExternalReferences Separator '	poolDictionaries: ''	category: 'OS-Support'!FileDirectory comment:'A FileDirectory is uniquely identified by the device or server to which it refers.  A FileDirectory is a collection of file names.Instance Variables:	directoryName <String> the path that identifies the FileDirectory to the operating system.Class Variables:	ExternalReferences <OrderedCollection>		A collection of objects to be sent the message release upon quitting or snapshoting.	Separator <Character>  the character used to separate items in file paths'!!FileDirectory methodsFor: 'testing'!includesKey: fileName	"Answer whether there is a file with the given name in the receiver.  FileName is relative to the receiver."	^(Filename named: (self fullPathFor: fileName)) exists! !!FileDirectory methodsFor: 'accessing'!contents	"Answer an OrderedCollection containing all of the files within the receiver."	^self fullName asFilename directoryContents!fullName	"Answer the full path name of the directory."	^directoryName!name	"Answer the name of the directory."	| tail |	tail _ directoryName asFilename tail asFilename.	^tail constructString: ''!requestFileName: message default: default version: versionType ifFail: failBlock	"Prompt for a file name.  Insist on an existing file if versionType = #old.  Evaluate failBlock if none obtained." 	"(FileDirectory named: '' ) requestFileName: 'file:' default: '*.st' version: #any ifFail: [] "	^directoryName asFilename requestFileName: message default: default version: versionType ifFail: failBlock!size	"Answer the number of files contained in the receiver."	^self contents size! !!FileDirectory methodsFor: 'dictionary removing'!removeKey: fileName	"Remove the file from the receiver."	^self removeKey: fileName ifAbsent: [self error: 'file not found: ' , fileName]!removeKey: fileName ifAbsent: failBlock	"Remove the file from the receiver.  If the file does not exist, evaluate the fail block.	FileName is assumed to be local to the receiver."	(self includesKey: fileName)		ifFalse: [^failBlock value].	^(Filename named: (self fullPathFor: fileName)) delete! !!FileDirectory methodsFor: 'file accessing'!checkName: aFileName fixErrors: aBoolean 	"Check a string aFileName for validity as a file name.  If there are problems 	(e.g., illegal length or characters) and aBoolean is false, create an error;  if 	there are problems and aBoolean is true, make the name legal (usually by 	truncating and/or tranforming characters) and answer the new name.  Otherwise, 	answer the name.  Default behavior is to get rid of ending period.  	Subclasses can do any kind of checking they want and answer either the 	name, or false if no good."	| cstr |	cstr _ Filename defaultClass canonicalize: aFileName.	aFileName isEmpty ifTrue: [aBoolean ifFalse: [self error: 'file name empty']].	cstr = aFileName		ifTrue: 			[aBoolean ifFalse: [self error: 'file name invalid'].			^cstr]		ifFalse: [^aFileName]!filesMatching: aFilePattern	"Answer an OrderedCollection of the files within the receiver that match the file name pattern given." 	^directoryName asFilename filesMatching: aFilePattern!fixFileName: fileName 	"Make the argument, fileName, a string, into a legal file name.  	fileName is assumed to be local to the receiver."	^fileName!isLegalFileName: fileName 	"Answer whether fileName is a legal file name."	^true!rename: oldName newName: newName 	"Rename the file oldName to be newName."	^(Filename named: (self fullPathFor: oldName))		renameTo: (self fullPathFor: newName)! !!FileDirectory methodsFor: 'enumerating'!do: aBlock	"Evaluate the block with each filename in the receiver as an argument."	self contents		do:			[:fileName |			aBlock value: (Filename named: (self fullPathFor: fileName))]!keysDo: aBlock 	"Evaluate aBlock for each of the receiver's keys."	self contents		do:			[:fileName |			aBlock value: fileName]! !!FileDirectory methodsFor: 'constants'!separator	"Answer the character that is the separator in path names."	^Separator!separatorString	"Answer the string that is the separator in path names."	^String with: Separator! !!FileDirectory methodsFor: 'printing'!printOn: aStream 	"Append to the argument aStream a sequence of characters that identifies the receiver."	super printOn: aStream.	aStream nextPutAll: ' named ' ; nextPutAll: self fullName! !!FileDirectory methodsFor: 'private'!fullPathFor: fileName	"Answer a full path name for the file whose local name is given."	(self class name: fileName startsWith: self fullName)		ifTrue: [^fileName]		ifFalse: [^self fullName asFilename constructString: fileName]!setNameFrom: aPathName	"Set the name of the receiver."	directoryName _ self class nameWithSeparator: aPathName! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!FileDirectory class	instanceVariableNames: ''!!FileDirectory class methodsFor: 'class initialization'!initialize	"Initialize the receivers constants and the collection of external references."	"FileDirectory initialize"		self initializeExternalReferences.	self initializeConstants.! !!FileDirectory class methodsFor: 'instance creation'!default	"Answer the default file directory."	^self named: ''!directoryFromName: fullName setFileName: localNameBlock 	"Send the file directory and local name into the block localNameBlock."	| nameArray directory |	nameArray _ self nameAndDirectoryOf: (self fixFileName: fullName).	directory _ self named: (nameArray at: 1).	localNameBlock value: (nameArray at: 2).	^directory!forName: fullName setDirectoryAndNameIn: directoryAndNameBlock	"Create an instance of me available within the scope of the block."	| nameArray |	nameArray _ self nameAndDirectoryOf: (self fixFileName: fullName).	directoryAndNameBlock		value: (self named: (nameArray at: 1))		value: (nameArray at: 2)!named: aPathName 	"Create an instance of me representing the directory whose path is aPathname."	^self new setNameFrom: (aPathName = ''			ifTrue: [Filename defaultDirectory asString]			ifFalse: [aPathName])! !!FileDirectory class methodsFor: 'external reference access'!addExternalReference: anElement 	"Add anElement as a file that is currently referenced in the system."	(ExternalReferences includes: anElement)		ifFalse: [ExternalReferences addLast: anElement]!commitExternalReferences	"Cause all open streams to flush their buffers"	ExternalReferences do: [:i | i commit]!initializeExternalReferences	"ExternalReferences is an OrderedCollection of the files that are referenced	in the system.  Initialize this class variable."	ExternalReferences _ OrderedCollection new!releaseExternalReferences	"Remove and release all of the files referenced by the collection ExternalReferences."	[ExternalReferences isEmpty]		whileFalse: [ExternalReferences removeLast release]!removeExternalReference: anElement 	"Remove anElement as a file that is currently referenced in the system."	ExternalReferences remove: anElement ifAbsent: []! !!FileDirectory class methodsFor: 'utilities'!canReadFile: fileName	"Answer true if the file can be read."	^(Filename named: fileName) isReadable!canWriteFile: fileName	"Answer true if the file can be written."	^fileName asFilename canBeWritten!copyFileNamed: sourceName to: destName	"Copy the file named sourceName to a file named destName."	"FileDirectory copyFileNamed: 'sourceFileName' to: 'destFileName'"	sourceName asFilename copyTo: destName asFilename!filesMatching: aFilePattern 	"Answer an OrderedCollection of files whose names match the 	pattern given."	^Filename filesMatching: aFilePattern!fixFileName: aFileName	"Make the file name a valid file name."	^Filename defaultClass canonicalize: aFileName!includesKey: aFileName	"Answer true if the file system contains a file with the given name."	^aFileName asFilename exists!isDirectory: fileName	"Answer true if the file is a directory."	^Filename errorReporter inaccessableSignal		handle: [:ex | ex returnWith: false]		do: 			[fileName asFilename isDirectory]!isLegalFileName: fileDesignator	"Answer whether the specified file name is legal."	"Example: FileDirectory isLegalFileName: 'someFileName' "	^fileDesignator = (Filename defaultClass canonicalize: fileDesignator)!removeKey: fileDesignator	"Delete the specified file from its directory."	"Example:  FileDirectory removeKey: 'someFileName' "	^self removeKey: fileDesignator ifAbsent: [nil]!removeKey: fileDesignator ifAbsent: failBlock	"Remove the specified file from its directory.  If the	file is not in the directory, then answer the result of	evaluating failBlock.  Otherwise, answer the fileDesignator."	"For example:		FileDirectory removeKey: 'someFileName' ifAbsent: [^nil]"	^Filename errorReporter inaccessableSignal handle: [:ex | ex returnWith: failBlock value]		do: 			[(Filename named: fileDesignator) delete.			true]!requestFileName: message default: default version: versionType ifFail: failBlock	"Prompt for a file name.  Insist on an existing file if versionType = #old.	Evaluate failBlock if none obtained." 	"FileDirectory requestFileName: 'file:' default: '*.st' version: #any ifFail: []"	^Filename requestFileName: message default: default version: versionType ifFail: failBlock! !!FileDirectory class methodsFor: 'constants'!initializeConstants	"Initialize the receivers constants."	"FileDirectory initializeConstants"	self separator: Filename separator.!separator	"Answer the character that is the separator in path names."	^Separator!separator: aChar	"FileDirectory seperator: $/"	Separator _ aChar!separatorString	"Answer the string that is the separator in path names."	^String with: Separator! !!FileDirectory class methodsFor: 'name parsing'!name: aName startsWith: aPath	"Answer true if the file name aName starts with aPath."	^aName size >= aPath size and: [(aName copyFrom: 1 to: aPath size) = aPath]!nameWithSeparator: aNameString	"Answer a file name with a path separator appended to the end." 		^aNameString asFilename constructString: ''! !!FileDirectory class methodsFor: 'private'!nameAndDirectoryOf: fileName	"Answer an array with the directory and file components of the given name."	| fn dir fname |	fn _ fileName asFilename.	dir _ self nameWithSeparator: fn head.	fname _ fn tail.	^Array with: dir with: fname! !FileDirectory initialize!FileModel subclass: #FileList	instanceVariableNames: 'list myPattern isReading '	classVariableNames: 'DefaultPattern FileMenu PatternMenu '	poolDictionaries: ''	category: 'Tools-File Model'!FileList comment:'Class FileList represents a FileModel that can be viewed as a filtered list (menu) of file names as well as the text of a file.Instance Variables:	list				<SortedCollection of: Strings> file names	myPattern		<Text> representing the filter to select the list	isReading		<Boolean> true if system is in the process of reading the contents of a fileClass Variables:	DefaultPattern	<nil | String> the initial pattern for retrieving the file name list	FileMenu		<ActionMenu> of operations on the file name list	PatternMenu	<ActionMenu> of operations to modify the pattern string'!!FileList methodsFor: 'pattern'!acceptPattern: aText from: aController	"The text consists of file names and file name patterns separated by carriage returns.	Patterns can include the characters * (any chars) and # (any single char).	Make my new list be those file names on my directory which match the patterns."	| testPattern readStream newList |	Cursor execute showWhile:		[self pattern:  aText string.		readStream _ ReadStream on: self pattern asString.		newList _ SortedCollection new.		[readStream atEnd] whileFalse:			[testPattern _ readStream upTo: Character cr. "get next name/pattern"			(testPattern includes: $*) | (testPattern includes: $#)				ifTrue: 					[Filename errorReporter errorSignal						handle: [:ex | aController == nil									ifFalse:	[aController deselect; replaceSelectionWith: ex parameter errorString asText; select].								Cursor normal show.								^false]						do: [newList addAll: (self filesMatching: testPattern)]]				ifFalse: [(self isLegalFileName: testPattern)							ifTrue: [newList add: (Filename defaultClass canonicalize: testPattern)]]].		self list: newList.		self changed: #fileName].	^true!pattern	"Answer the receiver's current file name pattern."	^ myPattern!pattern: aString 	"Set a new pattern for the receiver.  Inform any dependents so that the labels 	for the receiver's views can be updated."	myPattern _ aString asText.	self changed: #newPattern!patternMenu	"Answer an ActionMenu of operations on the file name pattern that is to be displayed 	when the operate menu button is pressed."	"FileList flushMenus."	PatternMenu == nil ifTrue:		[PatternMenu _ ActionMenu			labels: 'again\undo\copy\cut\paste\accept\cancel\volumes' withCRs			lines: #(2 5 7)			selectors: #(again undo copySelection cut paste accept cancel chooseVolume:from:)].	^PatternMenu! !!FileList methodsFor: 'file name list'!copyName	"Put a copy of the current selections name in the text buffer."	ParagraphEditor new copySelection: self nameOfSelection asText!deleteFile	"Remove the selected file from its directory."	| fn |	fn _ fileName asFilename.	fn exists		ifTrue: [(self confirm: 'really remove the selected file?') ifFalse: [^self].				fn delete].	list remove: self nameOfSelection.	self changed: #fileName.!fileListMenu 	"Answer the ActionMenu of operations on the receiver's list subview that is	to be shown when the operate mouse button is pressed."	fileName == nil ifTrue: [^nil].	FileMenu == nil ifTrue:		[FileMenu _			ActionMenu				labels: 'get contents\file in\copy name\rename\remove\spawn' withCRs				lines: #(2 4 5)				selectors: #(getFile fileInFile copyName renameFile deleteFile spawnFileList)].	^ FileMenu	"Evaluate this when you change this method:		FileList flushMenus"!fileName	"Answer the current selection's file name."	^fileName!fileName: selection 	"Change the file selection.  If the argument selection is not nil, it is 	the name of a file to be viewed."	self setFileName: selection.	isReading _ false.	self changed: #text!fileNameList	"Answer the receiver's list of file names."		^ list!getFile	"Get the contents of the selected file."	self changeRequest ifFalse: [^self].	isReading _ true.	self changed: #text!isSelected	"Answer true if a file is selected."	^isReading!nameOfSelection	"Answer the name of the current selection."	^ fileName!renameFile	"Rename the selected file.  Prompt the user for a new name."	| newList newName continue |	fileName == nil ifTrue: [^nil].	self changeRequest ifFalse: [^nil].	continue _ true.	[continue] whileTrue:		[newName _ FillInTheBlank				request: 'New name for file?'				initialAnswer: self nameOfSelection.		newName isEmpty ifTrue: [^nil].		((self isLegalFileName: newName) and: [newName asFilename exists not])			ifTrue: [continue _ false]			ifFalse: [(BinaryChoice message: 'File exists or bad file name. Try again?')						ifFalse: [^nil]]].	Cursor execute showWhile:		[| fName |		newList _ list copyWithout: self nameOfSelection.		fName _ fileName asFilename.		fName exists			ifTrue:	[fName renameTo: newName].		newList add: newName.		list _ newList.		self changed: #fileName.		self changed: #text]!spawnFileList	"Open a FileList on the current selection."	self class openOnFileNames: (Array with: self nameOfSelection) label: self nameOfSelection! !!FileList methodsFor: 'text'!text	"Answer the text for the selected file."	isReading		ifTrue: [^super text]		ifFalse: [^'' asText]! !!FileList methodsFor: 'list access'!list: aList	"Set the list of files to be aList."	list _ aList.	isReading _ false! !!FileList methodsFor: 'file accessing'!filesMatching: pattern	"Answer a list of file names matching the pattern string.  Do this by asking the appropriate directory."	^Filename defaultClass filesMatching: pattern!isLegalFileName: pattern	"Answer whether pattern is a valid file name.  Do this by asking the appropriate directory."	^OSErrorHolder invalidArgumentsSignal		handle: [ :ex | ex returnWith: false ]		do: [| name |			name _ pattern asFilename asString.			Filename isCaseSensitive				ifTrue:	[pattern = name]				ifFalse:	[pattern sameAs: name]]!setToRead	"Set the interface to indicate that the selected file is being read."	isReading _ true! !!FileList methodsFor: 'private'!chooseVolume: volName from: aController	| choice menu volumes|	volumes _ Filename volumes.	menu _ PopUpMenu labelList: (Array with: volumes).	choice _ menu startUp.	choice = 0 ifTrue: [^self].	self setVolume: (volumes at: choice) from: aController!setVolume: volName from: aController	| volume |	volume _ (volName, '*') asText.	aController deselect.	aController view newText: volume; displayView.	aController selectFrom: volume size + 1 to: volume size.	self acceptPattern: volume from: aController.!spawnFile: aText from: aController	"Open a file editor that edits the current selection."		|fileModel newController|	fileModel _ FileModel new.	fileModel setFileName: self nameOfSelection.	newController _ aController copy. 		 "Copy gets the changes"	aController cancel; controlTerminate.   "Cancel changes in spawning fileModel"	FileModel open: fileModel named: self nameOfSelection withController: newController! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!FileList class	instanceVariableNames: ''!!FileList class methodsFor: 'class initialization'!flushMenus	"Cause all menus to be newly created (so changes appear)." 	"FileList flushMenus."	PatternMenu _ nil.	FileMenu _ nil.	super flushMenus! !!FileList class methodsFor: 'instance creation'!open	"Create and schedule a view of a new instance of the receiver.	For example, evaluate		FileList open"	^self openOnPattern: self defaultPattern!openOnFileNames: aFileNameList label: labelString	"Create and schedule a view of a new instance of the receiver such that the	instance references the files named in the argument, aFileNameList."	| topView aFileList |	aFileList _ self new list: aFileNameList.	topView _ FileListView model: aFileList label: labelString minimumSize: 200 @ 200.	topView addSubView:			(SelectionInListView on: aFileList aspect: #fileName change: #fileName:				list: #fileNameList menu: #fileListMenu initialSelection: nil)		in: (0@0 extent: 1@0.2) borderWidth: 1.	topView addSubView:			(CodeView on: aFileList aspect: #text change: #acceptText:from:				menu: #textMenu initialSelection: nil)		in: (0@0.2 extent: 1@0.8) borderWidth: 1.	topView icon: (Icon constantNamed: #default).	topView controller open!openOnPattern: aPattern	"Create and schedule a view of a new instance of the receiver with the using 	the pattern aPattern.  For example, evaluate		FileList openOnPattern: '*'"	| topView aFileList patternView label|	aFileList _ self new.	aPattern = '' 		ifFalse: [Cursor read showWhile:					[aFileList list: (SortedCollection new addAll: (aFileList filesMatching: aPattern))].				label _ 'File List on ', aPattern asString ]		ifTrue: [label _ 'File List'].	aFileList pattern: aPattern.	topView _ FileListView		 model: aFileList		 label:	label		 minimumSize: 200 @ 200.	patternView _ CodeView		 on: aFileList		 aspect: #pattern		 change: #acceptPattern:from:		 menu: #patternMenu		 initialSelection: nil.	topView		 addSubView: patternView		 in: (0@0 extent: 1@0.07)		 borderWidth: 1.	patternView controller: AlwaysAcceptCodeController new.	topView addSubView:		(SelectionInListView			 on: aFileList			 aspect: #fileName			 change: #fileName:			 list: #fileNameList			 menu: #fileListMenu			 initialSelection: nil)		in: (0@0.07 extent: 1@0.23)		borderWidth: 1.	topView addSubView:		(OnlyWhenSelectedCodeView			 on: aFileList			 aspect: #text			 change: #acceptText:from:			 menu: #textMenu			 initialSelection: nil			selection: #isSelected)		in: (0@0.3 extent: 1@0.7)		 borderWidth: 1.	topView icon: (Icon constantNamed: #default).	topView controller open! !!FileList class methodsFor: 'default pattern access'!defaultPattern	"Answer the default file pattern."	DefaultPattern == nil		ifTrue: [^'']		ifFalse: [^DefaultPattern]!defaultPattern: aString	"Set the default file pattern to be aString."	"FileList defaultPattern: '*'"	DefaultPattern _ aString! !StandardSystemView subclass: #FileListView	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Tools-File Model'!FileListView comment:'FileListView is a subclass of StandardSystemView, so that the label pattern can reflect the pattern of files being listed.'!!FileListView methodsFor: 'updating'!update: anAspect	"See if the pattern has changed so that the label can change."	anAspect = #newPattern		  ifTrue: [self deEmphasize.				 self newLabel: 'File List on ', (self stripPattern: model pattern). 				 self emphasize]! !!FileListView methodsFor: 'private'!stripPattern: aString	"Answer a String that is the argument up to the first carriage return."	| readStream |	readStream _ ReadStream on: aString.	^readStream upTo: Character cr! !Model subclass: #FileModel	instanceVariableNames: 'fileName '	classVariableNames: 'TextMenu '	poolDictionaries: ''	category: 'Tools-File Model'!FileModel comment:'Class FileModel represents an interface between a file and an editable view of it.  As a StringHolder, the string is the contents of the file.Instance Variables:	fileName	<String> the name of the file currently being viewedClass Variables:	TextMenu	<ActionMenu> of operations on the text contents of a file'!!FileModel methodsFor: 'accessing'!fileName	"Answer the currently selected file name."	^fileName! !!FileModel methodsFor: 'text'!text	"Answer the text of the receiver."	| fileNameObject |	fileName == nil ifTrue: [^nil].	(fileNameObject _ fileName asFilename) exists		ifTrue: [^Cursor read showWhile:					[fileNameObject contentsOfEntireFile asText]]		ifFalse: [^'-new file-' asText				emphasizeFrom: 2				to: 9				with: 3]!textMenu	"Answer an ActionMenu of operations on the file contents text that is to be displayed 	when the operate menu button is pressed."	fileName == nil ifTrue: [^ nil].	TextMenu == nil ifTrue:		[TextMenu _ ActionMenu			labels: 'again\undo\copy\cut\paste\do it\print it\inspect\file it in\put\get\spawn' withCRs			lines: #(2 5 8 9 11)			selectors: #(again undo copySelection cut paste doIt printIt inspectIt fileItIn:from: accept getNew:from: spawnFile:from:)].	^ TextMenu 	"FileModel flushMenus"! !!FileModel methodsFor: 'file access'!fileInFile	"Read the entire file as Smalltalk code."	(Filename named: fileName) fileIn!fileItIn: fullText from: controller	"Make a Stream on the text selection and fileIn it."	| selection |	selection _ controller selection.	(ReadWriteStream on: selection from: 1 to: selection size) fileIn! !!FileModel methodsFor: 'doIt/accept/explain'!acceptText: aText from: aController	"Update the contents of the file stream with the receiver's contents."	| stream |	Cursor write showWhile:		[stream _ (Filename named: fileName) writeStream.		[stream nextPutAll: aText string]			valueNowOrOnUnwindDo: [stream close]].	^true!doItContext	"Answer the context in which a text selection can be evaluated."	^ nil!doItReceiver	"Answer the object that should be informed of the result of evaluating a	text selection."	^ nil!doItValue: ignored	"Set the value to be returned when the interrupted process proceeds."! !!FileModel methodsFor: 'private'!getNew: ignoreText from: aController	"Reinitialize the information the receiver models by re-reading the file stream."	self changeRequest ifFalse: [^ aController view flash].	self changed: #text!setFileName: fullFileName	fileName _ fullFileName!setFileStream: aStream 	aStream release.		"close, since later a new file stream will be created"	fileName _ aStream name!spawnFile: aText from: aController	| newController | 	newController _ aController copy.  "Copy gets the changes"	aController cancel; controlTerminate.   "Cancel changes in spawning fileModel"	self class open: self copy named: fileName withController: newController! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!FileModel class	instanceVariableNames: ''!!FileModel class methodsFor: 'class initialization'!flushMenus 	"Cause all menus to be newly created (so changes appear)." 	TextMenu _ nil! !!FileModel class methodsFor: 'instance creation'!fileName: aFileName 	"Answer an instance of the receiver on the argument, aFileStream."	^self new setFileName: aFileName asString!fileStream: aFileStream 	"Answer an instance the receiver on the argument, aFileStream."	^self new setFileStream: aFileStream!open: aFileModel named: aString 	"Create and schedule a view whose model is aFileModel and whose label is aString."	| topView fn |	fn _ aFileModel fileName asFilename.	fn exists		ifTrue:			[fn isReadable				ifFalse:	[Filename errorReporter inaccessableSignal raiseWith: 'File is readProtected'].			fn isDirectory				ifTrue:	[Filename errorReporter inaccessableSignal raiseWith: 'File is a directory']]		ifFalse:	[fn canBeWritten				ifFalse:	[Filename errorReporter inaccessableSignal raiseWith: 'File can''t be created']].	topView _ StandardSystemView model: aFileModel label: aString minimumSize: 180 @ 180.	topView addSubView:			(CodeView on: aFileModel aspect: #text change: #acceptText:from:				menu: #textMenu initialSelection: nil)		in: (0@0 extent: 1@1) borderWidth: 1.	topView controller open!open: aFileModel named: aString withController: aController	"Create and schedule a FileModel view with changes made in another editor."	| topView textView |	topView _ StandardSystemView model: aFileModel label: aString minimumSize: 180 @ 180.	textView _ CodeView on: aFileModel aspect: #text change: #acceptText:from:				menu: #textMenu initialSelection: nil.	textView controller: aController.	topView addSubView: textView in: (0@0 extent: 1@1) borderWidth: 1.	topView controller open! !Object subclass: #Filename	instanceVariableNames: 'nameString '	classVariableNames: 'DefaultClass DefaultDirectory '	poolDictionaries: 'IOConstants '	category: 'OS-Support'!Filename comment:'Class Filename is an abstract class.  Instances of its subclasses encapsulate the platform-specific syntax of OS file pathnames.  Actually, this classcan almost be used as a concrete class, except name syntax is not interpreted.  There is standard protocol provided to do most of the things that OS''s can do with references to files -- deleting, renaming, etc.Instance Variables:	nameString	<String> Platform-specific syntax naming a file.  Primitives "know" that the nameString is the first instance variable.Class Variables:	DefaultDirectory	<Filename> Starting point for relative references.	DefaultClass		<Metaclass> The appropriate concrete subclass for this platform.Pool Dictionaries:	IOConstants	<Dictionary> of characters keyed by symbols'!!Filename methodsFor: 'instance creation'!construct: extraFn	"Make a new instance, treating the receiver as a directory, and	the string argument as a file within the pathname."	^self class named: (self constructString: extraFn)!constructString: extraFn	"Make a new file name string, treating the receiver as a directory, and	the string argument as a file within the pathname."	| ws prefix suffix sep |	sep _ self separator.	prefix _ nameString.	suffix _ (extraFn size > 0 and: [ (extraFn at: 1) = sep ])			ifTrue: [extraFn copyFrom: 2 to: extraFn size]			ifFalse: [extraFn].	ws _ WriteStream on: (String new: prefix size + suffix size + 1).	ws nextPutAll: prefix.	prefix last = sep		ifFalse:	[ws nextPut: sep].	ws nextPutAll: suffix.	^ws contents! !!Filename methodsFor: 'parsing'!directory	"Answer the filename of the directory for this Filename."	^self class named: self head!head	"Answer the directory prefix as a String."	| index |	(index _ self lastIndexOf: self separator) ~= 0		ifTrue:	[index _ index max: 2.				^nameString copyFrom: 1 to: index-1]		ifFalse:	[^self class defaultDirectoryName]!tail	"Answer the filename suffix as a String."	| index |	(index _ self lastIndexOf: self separator) ~= 0		ifTrue:	[^nameString copyFrom: index+1 to: nameString size]		ifFalse:	[^nameString copy]! !!Filename methodsFor: 'testing'!canBeWritten	"Answer true if the file can be written."	self exists		ifTrue: [^self isWritable and: [self isDirectory not]]		ifFalse: [^Filename errorReporter inaccessableSignal					handle: [:ex | ex returnWith: false]					do: [self directory isWritable]]!isAbsolute	"Answer true if this name is absolute (e.g. not relative to the	'current directory')."	nameString size = 0		ifTrue:	[^false].	^(nameString at: 1) == self separator!isDirectory	"Answer true if this name refers to a directory."	^self isDirectoryErrInto: (self errorReporter new)!isReadable	"Answer whether the file can be read."	^self exists!isRelative	"Answer true if this name must be interpreted relative to some	directory."	^self isAbsolute not!isWritable	"Answer true if the named file is writable by the current user."	^self isWriteableErrInto: (self errorReporter new)! !!Filename methodsFor: 'comparing'!= aFilename 	"Answer whether the receiver is equal to the argument"	^self species = aFilename species and: [self class isCaseSensitive			ifTrue: [nameString = aFilename asString]			ifFalse: [nameString sameAs: aFilename asString]]!hash 	"Answer with a SmallInteger unique to the receiver."	^nameString hash! !!Filename methodsFor: 'converting'!asFilename	"Answer self"	^self!asString	"Answer the OS-specific name string."	^nameString! !!Filename methodsFor: 'defaulting'!concreteClass	"Answer self class for concrete classes, defaultClass for abstract classes."	^self class concreteClass!defaultClass	"Answer the appropriate default concrete subclass."	^self class defaultClass!species	"Answer the appropriate class for new instances."	^self concreteClass! !!Filename methodsFor: 'constants'!separator	"Answer the platform's filename component separator."	"Delegate to metaclass."	^self class separator! !!Filename methodsFor: 'file utilities'!copyTo: destName	"Copy the file whose name is the receiver to a file named destName."	| buffer bufferSize sourceFile destFile amountRead |	sourceFile _ IOAccessor openFileReadOnly: self.	destFile _ IOAccessor openFileWriteOnly: destName asFilename.	[bufferSize _ sourceFile bufferSize.	buffer _ ByteArray new: bufferSize.		"Copy until we have a read that is less than buffer size"	[(amountRead _ sourceFile readInto: buffer) = bufferSize] whileTrue:		[destFile writeAll: buffer].	"Copy any thing left over"	amountRead > 0		ifTrue: [destFile writeFrom: buffer startingAt: 1 forSure: amountRead]	] valueNowOrOnUnwindDo: 		[sourceFile close.		destFile close]!delete	"Delete the reference to the named file (which is slightly different	than saying 'deleting the file', but means the same thing in most cases)."	self deleteErrInto: (self errorReporter new)!directoryContents	"Returns Array of strings -- the contents of the directory.	Not Array of Filenames because we'd have to prepend directory names."	^self listDirectoryErrInto: self errorReporter new.!exists	"Answer true if the named file exists."	^OSErrorHolder nonexistentSignal		handle:	[ :ex |	ex returnWith: false	]		do: [self existsErrInto: (self errorReporter new)]!fileSize	"Answer the size (in bytes) of the corresponding file."	^self fileSizeErrInto: (self errorReporter new)!filesMatching: string	"Answer an OrderedCollection of files matching string."	| list allFiles |	list _ self class components: string.	allFiles _ OrderedCollection new.	self filesMatchingAccessList: list into: allFiles.	^allFiles!makeDirectory	"Create a directory with this name."	self makeDirectoryErrInto: (self errorReporter new)!makeUnwritable	"Make this named file unwritable in the broadest sense	(e.g. to at least the current user, but to everyone if possible)."	self setWriteable: false errInto: (self errorReporter new)!makeWritable	"Make the corresponding file writable in the narrowest	sense (e.g. at least to the current user)."	self setWriteable: true errInto: (self errorReporter new)!moveTo: destName	"Copy the file whose name is the receiver to a file named destName."	self copyTo: destName.	self delete!renameTo: aFileName	"Substitute the new name for the old one (a.k.a. 'rename the file')."	self renameTo: aFileName asFilename errInto: (self errorReporter new)! !!Filename methodsFor: 'utilities'!contentsOfEntireFile	"Answer the contents of the file represented by	the receiver."	| stream contents |	stream _ self readStream.	[stream lineEndConvention = LineEndCRLF		ifTrue:	[contents _ stream contents]		ifFalse:	[contents _ stream next: self fileSize]	] valueNowOrOnUnwindDo: [stream close].	^contents!dates	"Answer a Dictionary with the file's access dates."	| dts bytes |	dts _ IdentityDictionary new: 3.	bytes _ self getDatesErrInto: self errorReporter new.	1 to: 3 do: 		[:i | 		| secs start dateAndTime |		start _ i - 1 * 4 + 1.		secs _ UninterpretedBytes with: bytes from: start to: start + 3.		(secs unsignedLongAt: 1) = 0			ifTrue:	[dateAndTime _ nil]			ifFalse:	[dateAndTime _ Time aTime: (secs unsignedLongAt: 1)].		dts at: (#(accessed modified statusChanged ) at: i)			put: dateAndTime].	^dts!edit	"Edit the contents of the file represented by	the receiver."	FileModel 		open: (FileModel fileName: self)		named: nameString!fileIn	"FileIn the contents of the file represented by	the receiver."	Transcript cr; cr; show: 'Filing in from:'; crtab; show: self asString; cr.	^self readStream fileIn!fileOutChanges	"FileOut changes on the file represented by	the receiver."	Transcript cr; cr; show: ('Filing out changes on:'); crtab; show: self asString.	self writeStream fileOutChanges!fileOutChangesFor: class	"FileOut changes for class on the file represented by	the receiver."	self writeStream fileOutChangesFor: class!requestFileName: message default: default version: versionType ifFail: failBlock	"Prompt for a file name.  Insist on an existing file if versionType = #old.  Evaluate failBlock if none obtained." 	"Filename defaultDirectory requestFileName: 'file:' default: '*.st' version: #any ifFail: [] "	| fileName list menu index err list2 eraseString |	fileName _ default.	[true] whileTrue: 		[fileName _ FillInTheBlank request: message initialAnswer: fileName.		fileName isEmpty			ifTrue: [^failBlock value].		((fileName includes: $*) or: [fileName includes: $#])			ifTrue:				[list _ self filesMatching: fileName.				eraseString _ self constructString: ''.				list2 _ list collect:					[:name |					(name findString: eraseString startingAt: 1) = 1						ifTrue: [name copyFrom: eraseString size + 1 to: name size]						ifFalse: [name]]	.				menu _ PopUpMenu							labelList: (Array											with: list2											with: #('new pattern' 'abort')).				index _ menu startUp: #anyButton withHeading:					(list isEmpty						ifTrue: [' No Matches ']						ifFalse: ['Choose a file from ', (self constructString: fileName)]) asText.				(index == 0 or: [index = (list size + 2)])					ifTrue: [^failBlock value].				index <= list size ifTrue: [^list at: index]]			ifFalse:				[(self directoryContents includes: fileName) ifTrue: [^fileName].				versionType ~= #old ifTrue: [^fileName].				fileName = (self class named: fileName) asString					ifTrue: [err _ ' File not found: \  ']					ifFalse: [err _ ' Illegal file name: \  '].				menu _ PopUpMenu labels: 'try again\abort' withCRs.				(menu					startUp: #anyButton					withHeading: err withCRs , fileName , ' ') = 2						ifTrue: [^failBlock value]]]! !!Filename methodsFor: 'stream creation'!appendStream	"Answer a write stream connected to the file represented by	the receiver."	^ExternalWriteStream on: (FileConnection			openFileNamed: self			mode: #appendOnly			creationRule: #mayCreate)!newReadAppendStream	"Answer a new readAppend stream connected to the file represented by	the receiver."	^ExternalReadAppendStream on: (FileConnection			openFileNamed: self			mode: #readAppend			creationRule: #truncateOrCreate)!newReadWriteStream	"Answer a new readWrite stream connected to the file represented by	the receiver."	^ExternalReadWriteStream on: (FileConnection			openFileNamed: self			mode: #readWrite			creationRule: #truncateOrCreate)!readAppendStream	"Answer a readAppend stream connected to the file represented by	the receiver."	^ExternalReadAppendStream on: (FileConnection			openFileNamed: self			mode: #readAppend			creationRule: #mayCreate)!readStream	"Answer a read stream connected to the file represented by	the receiver."	^ExternalReadStream on: (FileConnection			openFileNamed: self			mode: #readOnly			creationRule: #noCreate)!readWriteStream	"Answer a readWrite stream connected to the file represented by	the receiver."	^ExternalReadWriteStream on: (FileConnection			openFileNamed: self			mode: #readWrite			creationRule: #mayCreate)!writeStream	"Answer a write stream connected to the file represented by	the receiver."	^ExternalWriteStream on: (FileConnection			openFileNamed: self			mode: #writeOnly			creationRule: #truncateOrCreate)! !!Filename methodsFor: 'error reporting'!errorReporter	"Answer the appropriate error forwarder (e.g. the one who	can interpret errorHolders) for me."	^self class errorReporter!reportError	"Some error occured.  Have the error reporter signal it."	self errorReporter reportOn: self!reportErrorProceeding	"Some error occured.  Have the error reporter signal it, permitting	the signal handler to proceed."	^self errorReporter reportProceedingOn: self! !!Filename methodsFor: 'printing'!printOn: aStream	"Append to the argument aStream a sequence of characters that identifies the receiver."	"Amplifies method in superclass to add name string."	super printOn: aStream.	aStream nextPut: $(.	aStream print: self asString.	aStream nextPut: $)! !!Filename methodsFor: 'primitives'!deleteErrInto: anErrorHolder	"Delete the named file (or directory, if it's empty). Essential."	<primitive: 621>	anErrorHolder reportFor: self!existsErrInto: anErrorHolder	"Answer true if the named file exists. Essential."	<primitive: 629>	^anErrorHolder reportFor: self!fileSizeErrInto: anErrorHolder	"Answer size of file in bytes. Essential."	"However, not all files have sizes..."	<primitive: 626>	anErrorHolder reportFor: self!getDatesErrInto: anErrorHolder	"Answer ByteArray of times	(4 bytes unsigned ints each in platform order,	measured in secs since 00:00:00 GMT, Jan. 1, 1970)	 - first element is 'last accessed' time	 - second element is 'last modified' time	 - third element is 'last status changed' time	A platform is free to return 0 for any field, which is	interpreted as 'unknown'."	<primitive: 610>	anErrorHolder reportFor: self!isDirectoryErrInto: anErrorHolder	"Answer true if the named corresponds to a directory. Essential."	<primitive: 622>	anErrorHolder reportFor: self!isWriteableErrInto: anErrorHolder	"Answer true if file is writable by this user.  Essential.	Writable for a directory means that new files can be	created or old ones renamed."	<primitive: 627>	anErrorHolder reportFor: self!listDirectoryErrInto: anErrorHolder	"Receiver is a directory name.  Return an array of strings	naming files contained in this directory. Essential."	<primitive: 620>	anErrorHolder reportFor: self!makeDirectoryErrInto: anErrorHolder	"Create the named directory. Essential."	<primitive: 624>	anErrorHolder reportFor: self!renameTo: aFileName errInto: anErrorHolder	"Give the file referred to by the receiver the	new name of the first arg (this may move the file to	a different directory). Essential."	<primitive: 623>	anErrorHolder reportFor: self!setWriteable: boolean errInto: anErrorHolder	"Set the named file (or directory) to be writeable/unwritable.	Writable for a directory means that new files can be	created or old ones renamed.  Essential."	"The current user may not be able to change the permissions	for this file."	<primitive: 628>	anErrorHolder reportFor: self! !!Filename methodsFor: 'private'!filesMatchingAccessList: list into: allNames 	| contents pref sublist fullName isPattern isCaseSensitive |	list isEmpty		ifTrue:	[^allNames].	pref _ list first.	sublist _ list copyFrom: 2 to: list size.	isPattern _ ((pref includes: $*) or: [ pref includes: $# ]).	isCaseSensitive _ self class isCaseSensitive.	contents _ self directoryContents.	contents do:		[:name |		(isPattern			ifTrue:	[(pref match: name ignoreCase: isCaseSensitive not)]			ifFalse:	[isCaseSensitive not						ifTrue:	[name asUppercase = pref asUppercase]						ifFalse:	[name = pref]])			ifTrue: 				[fullName _ self construct: name.				sublist isEmpty					ifTrue: [allNames add: fullName asString]					ifFalse: [fullName isDirectory						ifTrue: [fullName										filesMatchingAccessList: sublist										into: allNames]].				isPattern					ifFalse:	[^self]]]!lastIndexOf: aChar 	"Answer the index of the last character in my nameString which 	matches aChar, if none, answer 0."	"Used to split nameStrings into head and tail components."	nameString size		to: 1		by: -1		do: [:i | (nameString at: i)				= aChar ifTrue: [^i]].	^0!named: n	"Set the OS-specific pathname."	"Only appropriate at instance creation."	nameString _ n.	nameString size = 0		ifTrue:	[^self].	(nameString last == self separator and: [nameString size > 1])		ifTrue: [nameString _ nameString copyFrom: 1 to: nameString size -1]! !!Filename methodsFor: 'copying'!copy	^self class named: self asString copy! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!Filename class	instanceVariableNames: ''!!Filename class methodsFor: 'class initialization'!findDefaultDirectory	"Determine the default directory name and cache it as a Filename.	Typically done at snapshot-return time."	| str fn e |	str _ DefaultClass defaultDirectoryErrInto: (e _ self errorReporter new).	fn _ DefaultClass new named: str.	^fn!hookupTo: pn	"The receiver has become the default class for some OSHandle subclass.  Get prepared."	"Can't do ^self subclassResponsibility because we might break return-from-snapshot."	Transcript cr; show: 'Warning -- No concrete class for ', self class name!install	"The receiver is the default class for Filenames, and installs itself."	"Do nothing for abstract classes."! !!Filename class methodsFor: 'class accessing'!defaultClass: cls	"Assign the appropriate concrete subclass for this platform.	Only done at start-up."	DefaultClass _ cls! !!Filename class methodsFor: 'instance creation'!named: str	"Answer a new Filename with the supplied name string."	"Avoid infinite recursion if there is no concrete subclass."	| cstr conClass |	str isEmpty		ifTrue:	[OSErrorHolder invalidArgumentsSignal raiseWith: str].	conClass _ self concreteClass.	cstr _ conClass canonicalize: str.	cstr isEmpty		ifTrue:	[OSErrorHolder invalidArgumentsSignal raiseWith: str].	conClass == self ifTrue: [^self new named: cstr].	^conClass named: cstr! !!Filename class methodsFor: 'defaults'!concreteClass	"Answer self for concrete classes, defaultClass for abstract classes."	self == Filename ifTrue: [^self defaultClass].	^self!currentDirectory	"Answer a filename representing the relative path name from the	current directory to itself.  On DOS and Unix platforms, this is '.'.	On Macs, it is ':'"	(self == Filename and: [self ~~ self defaultClass])		ifTrue:	[^self defaultClass currentDirectory].	^self named: self currentDirectoryString!currentDirectoryString	"Return the platform-specific token that represents the current directory.	In the default case, use the absolute path name"	^self defaultDirectoryName!defaultClass	"Answer the appropriate concrete subclass."	^DefaultClass!defaultDirectory	"Answer the default directory (e.g. interpretation starting point for	relative names)."	^DefaultDirectory copy!defaultDirectoryName	"Answer the default directory (e.g. interpretation starting point for	relative names)."	^DefaultDirectory asString copy!errorReporter	"Return the appropriate error code interpreter."	| dc |	dc _ self defaultClass.	^dc == Filename ifTrue: [OSErrorHolder] ifFalse: [dc errorReporter]! !!Filename class methodsFor: 'primitives'!defaultDirectoryErrInto: anErrorHolder	"Answer the default directory name (platform-specific) as a String.	Essential."	<primitive: 625>	anErrorHolder reportFor: self! !!Filename class methodsFor: 'constants'!changeExtension	"Answer the platform's changes filename extension."	self concreteClass == Filename ifTrue: [^self subclassResponsibility].	^self concreteClass changeExtension!imageExtension	"Answer the platform's image filename extension"	self concreteClass == Filename ifTrue: [^self subclassResponsibility].	^self concreteClass imageExtension!maxLength	"Answer the maximum length that for a platform pathname."	self concreteClass == Filename ifTrue: [^self subclassResponsibility].	^self concreteClass maxLength!separator	"Answer the platform's filename component separator."	self concreteClass == Filename ifTrue: [^self subclassResponsibility].	^self concreteClass separator!sourceExtension	"Answer the platform's sources filename extension."	self concreteClass == Filename ifTrue: [^self subclassResponsibility].	^self concreteClass sourceExtension!uglyReplacement	"Answer a character which can be used to substitute for ugly characters in filenames."	^$_		"underscore, silly!!"! !!Filename class methodsFor: 'parsing'!breakup: str 	"Answer an ordered collection of (Array with: substr with: delim) 	which is the original string broken into chunks 	(treating non-alphanumeric characters as delimitors.)"	| oc subws delimws inDelim |	oc _ OrderedCollection new.	subws _ WriteStream on: (String new: 24).	delimws _ WriteStream on: (String new: 8).	inDelim _ false.	str do: [:c | inDelim			ifTrue: [c isAlphaNumeric					ifTrue: 						[oc add: (Array with: subws contents with: delimws contents).						subws reset.						delimws reset.						inDelim _ false.						subws nextPut: c]					ifFalse: [delimws nextPut: c]]			ifFalse: [c isAlphaNumeric					ifTrue: [subws nextPut: c]					ifFalse: 						[inDelim _ true.						delimws nextPut: c]]].	(subws size > 0 or: [delimws size > 0])		ifTrue: [oc add: (Array with: subws contents with: delimws contents)].	^oc!components: nameString	"Break a filename into path compoents, answer an OrderedCollection of components."	| components separator component stream |	components _ OrderedCollection new.	separator _ self separator.	stream _ nameString readStream.	(component _ self readBaseLocationFromStream: stream) isEmpty		ifFalse:	[components add: component].	[stream atEnd]		whileFalse:			[components add: (stream upTo: separator)].	^components!isBadCharacter: char	"Answer if this character is in illegal for a platform filename string."	"Assume nobody likes unprintable characters."	| cv |	cv _ char asciiValue.	cv < 32 "space" ifTrue: [^true].	cv >= 8r177 "del" ifTrue: [^true].	^false!isUglyCharacter: char	"Answer if this character is in bad taste for a platform filename string."	^self isBadCharacter: char!lastIndexOf: aChar in: str	"Answer the index of the last character in my nameString which 	matches aChar, if none, answer 0."	"Used to split nameStrings into head and tail components."	str size		to: 1		by: -1		do: [:i | (str at: i)				= aChar ifTrue: [^i]].	^0!localNameStringFrom: aString	"Answer a string that is aString, modified to fit the platform's	definition of a relative path name.  No syntax checking is done."	aString first = self separator		ifTrue:	[^aString copyFrom: 2 to: aString size]		ifFalse:	[^aString]!mapUglies: str	"Answer string with repeated runs of uglies mapped to a single replacement character."	| ws uglies |	ws _ WriteStream on: (String new: str size).	uglies _ false.	1 to: str size do: 		[:i | 		| c |		c _ str at: i.		(self isUglyCharacter: c)			ifFalse: [uglies _ false. ws nextPut: c]			ifTrue: [uglies ifFalse: [uglies _ true. ws nextPut: self uglyReplacement]]].	^ws contents.!readBaseLocationFromStream: stream	"Answer the root of a (semi)absolute path name."	^(stream peekFor: self separator)		ifTrue:	[String with: self separator]		ifFalse:	[String new]!shrink: str to: len dropDelim: dropDelim	"Answer a string which is shortened to size len without making it 	unrecognizable, with runs of ugly characters replaced.	Non alphanumerics are dropped if dropDelim is true."	| nstr need cnt chunks chunklen ws windfall |	"First contract runs of ugly characters to a single character."	nstr _ self mapUglies: str.	nstr size <= len ifTrue: [^nstr].	"Not good enough, try harder."	need _ nstr size - len.	"Try dropping vowels."	cnt _ nstr dropFinalVowels size.	cnt <= len ifTrue: [^nstr dropVowels: need].	"Not good enough, break into substrings and shorten those."	chunks _ self breakup: nstr.	chunklen _ len // chunks size.	windfall _ len - (chunklen * chunks size).	ws _ WriteStream on: (String new: len).	chunks do: [:arry |		| sub delim target extra |		sub _ arry at: 1.		delim _ arry at: 2.		target _ chunklen + windfall.		extra _ (dropDelim or: [target <= 2]) ifTrue: [0] ifFalse: [1 min: delim size].		(sub size + extra) <= target			ifTrue: ["It fits as it!!"					ws nextPutAll: sub.					target _ target - sub size]			ifFalse: ["Try dropping vowels."					(sub dropFinalVowels size + extra) <= target						ifTrue: [ws nextPutAll: (sub dropVowels: sub size - (target - extra))]						ifFalse: [ws nextPutAll: (sub chopTo: target - extra)].					target _ extra].		extra == 0 ifFalse: [ws nextPut: (delim at: 1)].		windfall _ target - extra].	^ws contents!splitExtension: fullName	"Answer an Array with: theName with: extension."	| extIndex theName extension |	extIndex _ self lastIndexOf: $. in: fullName.	theName _ (extIndex == 1)			ifTrue: ['']			ifFalse: [fullName						copyFrom: 1						to: (extIndex == 0							ifTrue: [fullName size]							ifFalse: [extIndex - 1])].	extension _ (extIndex > 0 and: [fullName size > extIndex])		ifTrue: [fullName copyFrom: extIndex + 1 to: fullName size]		ifFalse: [extIndex == 0 ifTrue: [nil] ifFalse: ['']].	^Array with: theName with: extension!splitPath: fullName	"Answer an Array with: head with: tail."	| sepIndex head tail |	sepIndex _ self lastIndexOf: self separator in: fullName.	sepIndex < 1		ifTrue: [^Array with: '' with: fullName copy].	head _ fullName copyFrom: 1 to: sepIndex.	tail _ fullName size > sepIndex		ifTrue: [fullName copyFrom: sepIndex + 1 to: fullName size]		ifFalse: [''].	^Array with: head with: tail!suggest: str 	"Answer a string which is in good taste as a filename on this 	platform."	^self canonicalize: str! !!Filename class methodsFor: 'utilities'!filesMatching: string	| list allFiles |	(self == Filename and: [self ~~ self defaultClass])		ifTrue:	[^self defaultClass filesMatching: string].	list _ self components: string.	allFiles _ OrderedCollection new.	list isEmpty		ifTrue:	[^allFiles].	(self baseDirectoryForList: list) filesMatchingAccessList: list into: allFiles.	^allFiles!request: prompt initially: fstring shouldExist: shouldExist 	"Prompt for a filename, using the prompt message and an initial 	answer.  Persist a little if the file should exist but doesn't, or vice-versa.	nil shouldExist means no opinion.  Assumes that initial value does not intentionally	have any volume or directory specifications (e.g. /'s are stripped).	Answer a string."	| ws scp response suggested retry fn |	suggested _ self concreteClass suggest: (self filterSeps: fstring).	scp _ Sensor cursorPoint.	[retry _ false.	ws _ WriteStream on: (String new: prompt size + (fstring size * 2) + 10).	ws nextPutAll: prompt.	suggested ~= fstring		ifTrue: 			[ws nextPut: Character cr.			ws nextPut: ${.			ws nextPutAll: 'Item''s name is: "'.			ws nextPutAll: fstring.			ws nextPutAll: '"}'].	FillInTheBlank		request: ws contents		displayAt: scp		centered: true		action: [:resp | response _ resp]		initialAnswer: suggested.	(response size > 0 and: [shouldExist notNil]) ifTrue: [		fn _ Filename named: response.		shouldExist			ifTrue: [(self errorReporter errorSignal handle: [:ex | ex returnWith: false]					do: [fn exists])					ifFalse: [retry _ (BinaryChoice message:										'File does not exist. Use this name anyway?') not]]			ifFalse: [(self errorReporter errorSignal handle: [:ex | ex returnWith: false]					do: [fn exists])					ifTrue: [retry _ (BinaryChoice message:										'File already exists. Use this name anyway?') not]]].	retry] whileTrue.	^response!requestFileName: message default: default version: versionType ifFail: failBlock	"Prompt for a file name.  Insist on an existing file if versionType = #old.	Evaluate failBlock if none obtained." 	"Filename requestFileName: 'file:' default: '*.st' version: #any ifFail: []"	| fileName list menu index err list2 currentDir|	fileName _ default.	currentDir _ self defaultDirectoryName copyWith: self separator.	[true] whileTrue: 		[fileName _ FillInTheBlank request: message initialAnswer: fileName.		fileName isEmpty			ifTrue: [^failBlock value].		((fileName includes: $*) or: [fileName includes: $#])			ifTrue:				[list _ self filesMatching: fileName.				list2 _ list collect:					[:fname |					(fname findString: currentDir startingAt: 1) = 1						ifTrue: [fname copyFrom: currentDir size + 1 to: fname size]						ifFalse: [fname]]	.				menu _ PopUpMenu							labelList: (Array											with: list2											with: #('new pattern' 'abort')).				index _ menu startUp: #anyButton withHeading:					(list isEmpty						ifTrue: [' No Matches ']						ifFalse: ['Choose a file']) asText.				(index == 0 or: [index = (list size + 2)])					ifTrue: [^failBlock value].				index <= list size ifTrue: [^list2 at: index]]			  ifFalse:				[fileName asFilename exists					ifTrue: [^fileName].				versionType ~= #old					ifTrue: [^fileName].				fileName = fileName asFilename asString					ifTrue: [err _ ' File not found: \  ']					ifFalse: [err _ ' Illegal file name: \  '].				menu _ PopUpMenu labels: 'try again\abort' withCRs.				(menu					startUp: #anyButton					withHeading: err withCRs , fileName , ' ') = 2						ifTrue: [^failBlock value]]]!volumes	"Answer an Array of Strings naming all reachable disk volumes."	self == Filename ifTrue: [^self defaultClass volumes].	^Array with: self defaultDirectory asString! !!Filename class methodsFor: 'private'!baseDirectoryForList: list	^list first = (String with: self separator)		ifTrue:	[self named: list removeFirst]		ifFalse:	[self currentDirectory]!canonicalize: str	"Convert this string to a canonical platform pathname string.	This may make for arbitrary, unpleasent transformations, like	truncating to 8 characters, folding to upper case, etc."	^str reject: [:c | self isBadCharacter: c]!filterSeps: str	"Answer string with separators mapped out."	| sep |	sep _ self separator.	^str collect: [:c | c == sep ifTrue: [self uglyReplacement] ifFalse: [c]]!setSeparator: aChar	"Set the filename separator to be aChar."	FileDirectory separator: aChar! !!Filename class methodsFor: 'defaulting'!isCaseSensitive	"Answer whether file naming is case sensitive.  True, for example, means	that 'foo.st' and 'Foo.st' name different files.	Subclasses reflecting case insensitive names should overwrite this message."	self == Filename		ifTrue:	[^self defaultClass isCaseSensitive].	^true! !StringHolder subclass: #FillInTheBlank	instanceVariableNames: 'actionBlock actionTaken '	classVariableNames: ''	poolDictionaries: ''	category: 'Interface-Prompt/Confirm'!FillInTheBlank comment:'Class FillinTheBlank represents a request for information that will be applied as the argument of a block of actions.Instance Variables:	actionBlock	<BlockClosure>	actionTaken <Boolean> whether the actionBlock has been evaluated at least once'!!FillInTheBlank methodsFor: 'initialize-release'!initialize	super initialize.	actionTaken _ false! !!FillInTheBlank methodsFor: 'accessing'!action: aBlock	"The argument, aBlock, will be evaluated when the receiver is sent the	message selectAction."	actionBlock _ aBlock!actionTaken	"Answer whether the action has been taken at least once."	^actionTaken!setAction: aBoolean	"Set whether this receiver's action has been taken at least once to be aBoolean."	actionTaken _ aBoolean! !!FillInTheBlank methodsFor: 'menu messages'!selectAction	"Evaluate the receiver's assigned action block, if any, with the answer as the	block argument."	actionBlock notNil ifTrue: [actionBlock value: contents]! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!FillInTheBlank class	instanceVariableNames: ''!!FillInTheBlank class methodsFor: 'instance creation'!action: aBlock initialAnswer: aString 	"Answer an instance of the receiver whose action is aBlock and initial action argument is	aString."	| newBlank |	newBlank _ self new initialize.	newBlank action: aBlock.	newBlank contents: aString.	^newBlank!message: messageString displayAt: aPoint centered: centered action: aBlock initialAnswer: aString 	"Answer an instance of the receiver whose question is messageString.  Once the 	user provides an answer, then evaluate aBlock. If centered, a Boolean, is 	false, display the view of the instance at aPoint; otherwise display it with its center	at aPoint. "	| newBlank |	newBlank _ self new initialize.	newBlank action: aBlock.	newBlank contents: aString.	FillInTheBlankView		openOn: newBlank		message: messageString		displayAt: aPoint		centered: centered!request: messageString	"Create an instance of the receiver whose question is messageString.	Display it centered around the cursor.	Simply return whatever the user accepts."	^self request: messageString initialAnswer: ''!request: messageString displayAt: aPoint centered: centered action: aBlock initialAnswer: aString 	"Answer an instance of the receiver whose question is messageString 	and initial answer is aString. Once the user provides an answer, 	then evaluate aBlock. If centered, a Boolean, is false, display the 	view of the instance at aPoint; otherwise display it with its center 	at aPoint."	^self		request: messageString		displayAt: aPoint		centered: centered		action: aBlock		initialAnswer: aString		useCRController: true!request: messageString displayAt: aPoint centered: centered action: aBlock initialAnswer: aString useCRController: useCRController 	"Answer an instance of the receiver whose question is 	messageString. Once the user provides an answer, then evaluate 	aBlock. If centered, a Boolean, is false, display the view of the 	instance at aPoint; otherwise display it with its center at aPoint."	| newBlank fillInView savedArea |	newBlank _ self new initialize.	newBlank action: aBlock.	newBlank contents: aString.	fillInView _ FillInTheBlankView				on: newBlank				message: messageString				displayAt: aPoint				centered: centered				useCRController: useCRController.	savedArea _ Form fromDisplay: fillInView displayBox.	fillInView display.	fillInView controller centerCursorInView.	fillInView controller startUp.	fillInView release.	savedArea displayOn: Display at: fillInView viewport topLeft!request: messageString initialAnswer: aString 	"Create an instance of the receiver whose question is messageString. 	Display it centered around the cursor. Supply aString as an initial 	answer. Simply return whatever the user accepts."	| response |	self		request: messageString		displayAt: Sensor cursorPoint		centered: true		action: [:resp | response _ resp]		initialAnswer: aString.	^response! !!FillInTheBlank class methodsFor: 'examples'!example1	"Example waits for you to click select button somewhere on the screen. The	view will show where you point.  Terminate by choosing menu command accept."	FillInTheBlank		message: 'What is your name?' 		displayAt: Sensor waitButton 		centered: true		action: [:answer | Transcript cr; show: answer] 		initialAnswer: ''	"FillInTheBlank example1."!example2	"Example waits for you to click select button somewhere on the screen. The	view will show where you point.  Terminate by choosing menu command accept or	typing carriage return."	FillInTheBlank		request: 'What is your name?' 		displayAt: Sensor waitButton 		centered: true		action: [:answer | Transcript cr; show: answer] 		initialAnswer: ''	"FillInTheBlank example2."!example3	"Try this example by choosing menu command print it"	^Text fromUser	"FillInTheBlank example3."! !StringHolderController subclass: #FillInTheBlankController	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Interface-Prompt/Confirm'!FillInTheBlankController comment:'Class FillinTheBlankController is a StringHolderController for a FillInTheBlankView.  The string is information that the user can type in and edit.  Upon issuing the accept command, this information is used by the model in the evaluation of an action block.'!!FillInTheBlankController methodsFor: 'basic control sequence'!controlTerminate	| topController |	super controlTerminate.	model actionTaken ifFalse: [^self].	topController _ view topView controller.	(topController notNil & (topController isKindOf: StandardSystemController))		ifTrue: [topController close].	model selectAction! !!FillInTheBlankController methodsFor: 'control defaults'!isControlActive	model actionTaken ifTrue: [^false].	^super isControlActive!isControlWanted	model actionTaken ifTrue: [^false].	^super isControlActive! !!FillInTheBlankController methodsFor: 'menu messages'!accept	super accept.	model setAction: true! !!FillInTheBlankController methodsFor: 'initialize-release'!resetState	"intercept to force selection of entire text"	super resetState.	stopBlock stringIndex: paragraph text size + 1! !!FillInTheBlankController methodsFor: 'marker adjustment'!updateMarker	"Do not redisplay marker"	^self computeMarkerRegion! !!FillInTheBlankController methodsFor: 'private'!initializeYellowButtonMenu	self 		yellowButtonMenu:			(PopUpMenu labels: 'again\undo\copy\cut\paste\accept\cancel' withCRs						lines: #(2 5))		yellowButtonMessages:			#(again undo copySelection cut paste accept cancel)! !StringHolderView subclass: #FillInTheBlankView	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Interface-Prompt/Confirm'!FillInTheBlankView comment:'Class FillinTheBlankView represents a view of a FillInTheBlank.  Instances display a query and an area in which the user can type some information.'!!FillInTheBlankView methodsFor: 'controller access'!defaultControllerClass	^FillInTheBlankController! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!FillInTheBlankView class	instanceVariableNames: ''!!FillInTheBlankView class methodsFor: 'instance creation'!on: aFillInTheBlank message: messageString displayAt: originPoint centered: centered 	"Answer an instance of the receiver on the model aFillInTheBlank 	asking the question messageString. If the argument centered, a 	Boolean, is false, display the instance with top left corner at 	originPoint; otherwise, display it with its center at originPoint. If 	necessary, translate so the view is completely on the screen."	^self		on: aFillInTheBlank		message: messageString		displayAt: originPoint		centered: centered		useCRController: true!on: aFillInTheBlank message: messageString displayAt: originPoint centered: centered useCRController: useCRController	"Answer an instance of the receiver on the model aFillInTheBlank 	asking the question messageString. If the argument centered, a 	Boolean, is false, display the instance with top left corner at 	originPoint; otherwise, display it with its center at originPoint. If 	necessary, translate so the view is completely on the screen.  The	Boolean userCRController determines whether the user can terminate	with a carriage return or not."	| topView messageView answerView |	messageView _ self buildMessageView: messageString.	answerView _ 		self buildAnswerView: aFillInTheBlank 			frameWidth: messageView window width.	useCRController ifTrue: [answerView controller: CRFillInTheBlankController new].	topView _ View new model: aFillInTheBlank.	topView controller: BinaryChoiceController new.	topView addSubView: messageView.	topView addSubView: answerView below: messageView.	topView align: (centered			ifTrue: [topView viewport center]			ifFalse: [topView viewport topLeft])		with: originPoint.	topView window: 		(0 @ 0 extent: 			messageView window width @ 			(messageView window height + answerView window height)).	topView translateBy:		(topView displayBox amountToTranslateWithin: Display boundingBox).	^topView!openOn: aFillInTheBlank message: messageString displayAt: originPoint centered: centered	"Create and schedule an instance of me that displays aFillInTheBlank asking the	question messageString.  If the argument centered, a Boolean, is false, display the	instance with top left corner at originPoint;  otherwise, display it with its center at	originPoint.  Do not schedule, rather take control immediately and insist that	the user respond."	| topView messageView answerView |	messageView _ self buildMessageView: messageString.	answerView _ 		self buildAnswerView: aFillInTheBlank 			frameWidth: messageView window width.	topView _ StandardSystemView new model: aFillInTheBlank.	topView addSubView: messageView.	topView addSubView: answerView below: messageView. 	topView		align: (centered				ifTrue: [topView viewport center]				ifFalse: [topView viewport topLeft])		with: originPoint.	topView label: 'Type a response'.	topView window: 		(0@0 extent: messageView window width @ (messageView window height + 40)).	topView controller openDisplayAt: originPoint! !!FillInTheBlankView class methodsFor: 'private'!buildAnswerView: aFillInTheBlank frameWidth: widthInteger	| answerView |	answerView _ self new model: aFillInTheBlank.	answerView window: (0@0 extent: widthInteger @ 40).	answerView borderWidth: 2.	^answerView!buildMessageView: messageString	|  messageView  |	messageView _ DisplayTextView new editParagraph: messageString asParagraph.	messageView borderWidthLeft: 2 right: 2 top: 2 bottom: 0.	messageView insideColor: Form white.	messageView controller: NoController new.	messageView window: (0@0 extent: (messageView window extent max: 200@30)).	messageView centered.	^messageView! !LimitedPrecisionReal variableByteSubclass: #Float	instanceVariableNames: ''	classVariableNames: 'Halfpi Pi RadiansPerDegree '	poolDictionaries: ''	category: 'Magnitude-Numbers'!Float comment:'Instances of the class Float represent floating-point numbers in platform-dependent short float format.These floating-point numbers are good for about 8 or 9 digits of accuracy, and the range is between plus and minus 10^38.Here are some valid floating-point examples:	8.0   13.3   0.3   2.5e6   1.27e-30  1.27e-31 -12.987654e12The format consists mainly of no imbedded blanks, little e for tens power, and a digit on both sides of the decimal point.Instance Variables: *byte indexed*Class Variables: 	Pi					<Float> 3.14159	RadiansPerDegree	<Float> 0.0174533'!!Float methodsFor: 'accessing'!at: index 	"Override implementation in Object since Float	instances are not element indexable."	^self shouldNotImplement!at: index put: value 	"Override implementation in Object since Float	instances are not element indexable."	^self shouldNotImplement!size	"Override implementation in Object since Float	instances are not element indexable."	^self shouldNotImplement! !!Float methodsFor: 'arithmetic'!* aNumber 	"Answer a Float that is the result of multiplying the receiver by the 	argument, aNumber.  The primitive fails if it cannot coerce the argument to a Float"	<primitive: 49>	^aNumber productFromFloat: self!+ aNumber 	"Answer a Float that is the result of adding the receiver to the argument.  	The primitive fails if it cannot coerce the argument to a Float"	<primitive: 41>	^aNumber sumFromFloat: self!- aNumber 	"Answer a Float that is the difference between the receiver and aNumber.  	The primitive fails if it cannot coerce the argument to a Float"	<primitive: 42>	^aNumber differenceFromFloat: self!/ aNumber 	"Answer a Float that is the exact result of dividing the receiver 	by the argument, aNumber.  The primitive fails if it cannot coerce 	the argument to a Float"	<primitive: 50>	^aNumber quotientFromFloat: self! !!Float methodsFor: 'mathematical functions'!arcCos	"Answer the angle in radians.	The receiver must be between -1.0 and 1.0	The result will be between 0.0 and Pi"	<primitive: 593>	^self class		raise: #domainErrorSignal		receiver: self		selector: #arcCos		errorString: 'Receiver must be between 1.0 and -1.0'!arcSin	"Answer the angle in radians.	The receiver must be between -1.0 and 1.0	The result will be between -Pi/2 and Pi/2"	<primitive: 592>	^self class		raise: #domainErrorSignal		receiver: self		selector: #arcSin		errorString: 'Receiver must be between 1.0 and -1.0'!arcTan	"Answer the angle in radians.	The receiver can be any valid Float	The result will be between -Pi/2 and Pi/2"	<primitive: 602>	^self primitiveFailed!cos	"return the cosine of the receiver (an angle in radians)	The receiver can be any valid Float	The result will be between -1.0 and 1.0"	<primitive: 591>	^self primitiveFailed!exp	"return the exponential function of the receiver 	The receiver may be between roughly -86.0 and 88.0 	The result will be greater than 0.0"	<primitive: 605>	^self class		raise: (self positive				ifTrue: [#overflowSignal]				ifFalse: [#underFlowSignal])		receiver: self		selector: #exp		errorString: 'e raised to ' , self printString , ' cannot be expressed as a Float'!floorLog10	"Answer with a (quick) computation of (self log: 10) floor.	The receiver must be greater than zero	The result will be between -38 and 38"	<primitive: 609>	^self class		raise: #domainErrorSignal		receiver: self		selector: #floorLog10		errorString: 'Can''t take log of number <= 0'!ln	"answer the natural log of the reciever	The receiver must be greater than 0.0	The result will be between -88.0 and 88.0"	<primitive: 604>	^self class		raise: #domainErrorSignal		receiver: self		selector: #ln		errorString: 'Can''t take log of number <= 0'!raisedTo: power 	"return (receiver ** power)"	<primitive: 606>	^super raisedTo: power!sin	"return the sine of the receiver (an angle in radians)	The receiver can be any valid Float	The result will be between -1.0 and 1.0"	<primitive: 600>	^self primitiveFailed!sqrt	"Answer the square root of the receiver.	The receiver must be positive	The result will be positive"	<primitive: 603>	^self class		raise: #imaginaryResultSignal		receiver: self		selector: #sqrt		errorString: 'Can''t take square root of negative number'!tan	"Answer the ratio of the sine to cosine of the receiver in radians.	The receiver can be any valid Float--in practice it is unlikely that		a Float would have a value close enough to Pi/2, or -Pi/2, or		3*Pi/2, or . . . to cause the primitive to fail	The result will be between -Infinity and +Infinity--if failure occurs,		the value was arbitrarily large, either positive or negative"	<primitive: 601>	^self class		raise: #domainErrorSignal		receiver: self		selector: #tan		errorString: 'Can''t evaluate tan for pi/2, -pi/2, 3*pi/2, . . .'! !!Float methodsFor: 'testing'!isLiteral	"Answer whether the receiver has a literal text form	recognized by the compiler."	^true!isZero	"Answer whether 'self = self class zero'"	^self = 0.0! !!Float methodsFor: 'comparing'!< aNumber 	"Answer whether the receiver is less than the argument.	The primitive fails if it cannot coerce the argument to a Float"	<primitive: 43>	^aNumber lessFromFloat: self!<= aNumber 	"Answer whether the receiver is less than or equal to the argument.   	The primitive fails if it cannot coerce the argument to a Float"	<primitive: 45>	^super <= aNumber!= aNumber 	"Answer whether the receiver is equal to the argument. 	The primitive fails if it cannot coerce the argument to a Float"	<primitive: 47>	^super = aNumber!> aNumber 	"Answer whether the receiver is greater than the argument. 	The primitive fails if it cannot coerce the argument to a Float"	<primitive: 44>	^super > aNumber!>= aNumber 	"Answer whether the receiver is greater than or equal to the argument.  	The primitive fails if it cannot coerce the argument to a Float"	<primitive: 46>	^super >= aNumber!~= aNumber 	"Answer whether the receiver is not equal to the argument. 	The primitive fails if it cannot coerce the argument to a Float"	<primitive: 48>	^super ~= aNumber! !!Float methodsFor: 'truncation and round off'!fractionPart	"Answer a Float whose value is the difference between the  	receiver and the receiver's truncated value.  Optional.  See Object 	documentation whatIsAPrimitive."	<primitive: 52>	^self - self truncated!rounded	"Answer the integer nearest the receiver."	<primitive: 590>	self >= 0.0		ifTrue: [^(self + 0.5) truncated]		ifFalse: [^(self - 0.5) truncated]!truncated	"Answer a SmallInteger equal to the value of the receiver     	without its fractional part. Fail if the truncated value cannot be    	represented as a SmallInteger.  In that case, the code below will   	compute a LargeInteger truncated value. Essential. See Object  	documentation whatIsAPrimitive."	<primitive: 51>	| max |	max := SmallInteger maxVal // 2 + 1.	^(self quo: max asFloat)		* max + (self rem: max asFloat) truncated! !!Float methodsFor: 'coercing'!coerce: aNumber	"Convert a number to a compatible form"	^aNumber asFloat!generality	"Answer the number representing the ordering of the receiver in the	generality hierarchy."	^80! !!Float methodsFor: 'double dispatching'!differenceFromFloat: aFloat 	"Presumably here because Float - failed.	If the receiver's magnitude is very small, then aFloat's magnitude	must be very small, and the calculation underflowed.	Otherwise, both are very large and the calculation overflowed"	^self class		raise: (self abs > 1.0				ifTrue: [#overflowSignal]				ifFalse: [#underflowSignal])		receiver: aFloat		selector: #-		arg