ating point quantity	starting at the given byteIndex."	<primitive: 548>	"The only way we can do this is by	constructing the Float byte-by-byte."	| f |	f _ 0.0 + 0.0.  "make a Float"	f basicAt: 1 put: (self byteAt: byteIndex).	f basicAt: 2 put: (self byteAt: byteIndex+1).	f basicAt: 3 put: (self byteAt: byteIndex+2).	f basicAt: 4 put: (self byteAt: byteIndex+3).	^f!floatAt: byteIndex put: aFloat 	"Store a single-precision (32 bit) 	floating point quantity 	starting at the given byteIndex."	<primitive: 549>	"The only way we can do this is by 	storing the Float byte-by-byte."	| float |	float _ aFloat asFloat.	self byteAt: byteIndex put: (float basicAt: 1).	self byteAt: byteIndex + 1 put: (float basicAt: 2).	self byteAt: byteIndex + 2 put: (float basicAt: 3).	self byteAt: byteIndex + 3 put: (float basicAt: 4).	^float!longAt: byteIndex	"Answer a signed long (32 bit) quantity	starting at the given byteIndex."	<primitive: 546>	^self longAt: byteIndex bigEndian: self class isBigEndian!longAt: byteIndex put: aLong	"Store a signed long (32 bit) quantity	starting at the given byteIndex."	<primitive: 547>	^self longAt: byteIndex put: aLong bigEndian: self class isBigEndian!longFloatAt: byteIndex	"Answer a double-precision (64 bit)	floating point quantity	starting at the given byteIndex."	<primitive: 550>	"Long floats are not supported yet."	^self primitiveFailed!longFloatAt: byteIndex put: aLongFloat	"Store a double-precision (64 bit)	floating point quantity	starting at the given byteIndex."	<primitive: 551>	"Long floats are not supported yet."	^self primitiveFailed!shortAt: byteIndex	"Answer a signed short (16 bit) quantity	starting at the given byteIndex."	<primitive: 542>	| word |	word _ self unsignedShortAt: byteIndex.	^(word bitAnd: 16r7FFF) - (word bitAnd: 16r8000)!shortAt: byteIndex put: aShort	"Store a signed short (16 bit) quantity	starting at the given byteIndex."	<primitive: 543>	self unsignedShortAt: byteIndex put:		(aShort bitAnd: 16r7FFF) - (aShort bitAnd: -16r8000).	^aShort!size	"Override implementation in Object since UninterpretedBytes	instances are not element indexable."	^self shouldNotImplement!sizeInBytes	"Answer the number of byte fields in the receiver.  This value is the 	same as the largest legal subscript."	^super size!unsignedLongAt: byteIndex	"Answer an unsigned long (32 bit) quantity	starting at the given byteIndex."	<primitive: 544>	^self unsignedLongAt: byteIndex bigEndian: self class isBigEndian!unsignedLongAt: byteIndex put: anUnsignedLong	"Store an unsigned long (32 bit) quantity	starting at the given byteIndex."	<primitive: 545>	^self unsignedLongAt: byteIndex put: anUnsignedLong bigEndian: self class isBigEndian!unsignedShortAt: byteIndex	"Answer an unsigned short (16 bit) quantity	starting at the given byteIndex."	<primitive: 540>	^self unsignedShortAt: byteIndex bigEndian: self class isBigEndian!unsignedShortAt: byteIndex put: anUnsignedShort	"Store an unsigned short (16 bit) quantity	starting at the given byteIndex."	<primitive: 541>	^self unsignedShortAt: byteIndex put: anUnsignedShort bigEndian: self class isBigEndian! !!UninterpretedBytes methodsFor: 'accessing-platform independent'!longAt: byteIndex bigEndian: isBE	"Answer a signed long (32 bit) quantity starting at the given byteIndex."	| b0 b1 b2 w h |	isBE		ifTrue:			[b0 _ self byteAt: byteIndex.  			b1 _ self byteAt: byteIndex+1.  			b2 _ self byteAt: byteIndex+2.  			w _ self byteAt: byteIndex+3]		ifFalse:			[b0 _ self byteAt: byteIndex+3.  			b1 _ self byteAt: byteIndex+2.  			b2 _ self byteAt: byteIndex+1.  			w _ self byteAt: byteIndex].	"Following sequence minimizes LargeInteger arithmetic for small results."	h _ ((b0 bitAnd: 16r7F) - (b0 bitAnd: 16r80) bitShift: 8) + b1.	b2=0 ifFalse: [w _ (b2 bitShift: 8) + w].	h=0 ifFalse: [w _ (h bitShift: 16) + w].	^w!longAt: byteIndex put: aLong bigEndian: isBE	"Store a signed long (32 bit) quantity starting at the given byteIndex."	| b0 b1 b2 b3 |	b0 _ aLong bitShift: -24.	  b0 _ (b0 bitAnd: 16r7F) - (b0 bitAnd: -16r80).	b1 _ (aLong bitShift: -16) bitAnd: 16rFF.	b2 _ (aLong bitShift: -8) bitAnd: 16rFF.	b3 _ aLong bitAnd: 16rFF.	isBE		ifTrue:			["Only the first store can fail."			self byteAt: byteIndex put: b0.  			self byteAt: byteIndex+1 put: b1.			self byteAt: byteIndex+2 put: b2.  			self byteAt: byteIndex+3 put: b3]		ifFalse:			["Only the first store can fail."			self byteAt: byteIndex+3 put: b0.  			self byteAt: byteIndex+2 put: b1.			self byteAt: byteIndex+1 put: b2.  			self byteAt: byteIndex put: b3].	^aLong!replaceBytesFrom: start to: stop with: replacement startingAt: repStart 	"This destructively replaces bytes from start to stop in the 	receiver starting at index, repStart, from the byte-object, 	replacement. Answer the receiver."	<primitive: 559>	| repOff |	repOff _ repStart - start.	(self == replacement and: [repStart < start])		ifTrue:	["Replacement would be overwritten; use reverse order"				stop to: start by: -1 do:					[ :i |	self byteAt: i put: (replacement byteAt: repOff + i)]]		ifFalse:	[start to: stop do:					[ :i |	self byteAt: i put: (replacement byteAt: repOff + i)]]!shortAt: byteIndex bigEndian: isBE	| word |	word _ self unsignedShortAt: byteIndex bigEndian: isBE.	^(word bitAnd: 16r7FFF) - (word bitAnd: 16r8000)!shortAt: byteIndex put: aShort bigEndian: isBE	"Store a signed short (16 bit) quantity starting at the given byteIndex."	self unsignedShortAt: byteIndex put:		(aShort bitAnd: 16r7FFF) - (aShort bitAnd: -16r8000) bigEndian: isBE.	^aShort!unsignedLongAt: byteIndex bigEndian: isBE	"Answer an unsigned long (32 bit) quantity starting at the given byteIndex."	| b0 b1 b2 w |	isBE		ifTrue:			[b0 _ self byteAt: byteIndex.  			b1 _ self byteAt: byteIndex+1.  			b2 _ self byteAt: byteIndex+2.  			w _ self byteAt: byteIndex+3]		ifFalse:			[b0 _ self byteAt: byteIndex+3.  			b1 _ self byteAt: byteIndex+2.  			b2 _ self byteAt: byteIndex+1.  			w _ self byteAt: byteIndex].	"Following sequence minimizes LargeInteger arithmetic for small results."	b2=0 ifFalse: [w _ (b2 bitShift: 8) + w].	b1=0 ifFalse: [w _ (b1 bitShift: 16) + w].	b0=0 ifFalse: [w _ (b0 bitShift: 24) + w].	^w!unsignedLongAt: byteIndex put: anUnsignedLong bigEndian: isBE	"Store an unsigned long (32 bit) quantity starting at the given byteIndex."	| b0 b1 b2 b3 |	b0 _ anUnsignedLong bitShift: -24.	b1 _ (anUnsignedLong bitShift: -16) bitAnd: 16rFF.	b2 _ (anUnsignedLong bitShift: -8) bitAnd: 16rFF.	b3 _ anUnsignedLong bitAnd: 16rFF.	isBE		ifTrue:			["Only the first store can fail."			self byteAt: byteIndex put: b0.  			self byteAt: byteIndex+1 put: b1.			self byteAt: byteIndex+2 put: b2.  			self byteAt: byteIndex+3 put: b3]		ifFalse:			["Only the first store can fail."			self byteAt: byteIndex+3 put: b0.  			self byteAt: byteIndex+2 put: b1.			self byteAt: byteIndex+1 put: b2.  			self byteAt: byteIndex put: b3].	^anUnsignedLong!unsignedShortAt: byteIndex bigEndian: isBE	"Answer an unsigned short (16 bit) quantity starting at the given byteIndex."	^isBE		ifTrue: [((self byteAt: byteIndex) bitShift: 8) + (self byteAt: byteIndex + 1)]		ifFalse: [((self byteAt: byteIndex + 1) bitShift: 8) + (self byteAt: byteIndex)]!unsignedShortAt: byteIndex put: anUnsignedShort bigEndian: isBE	"Store an unsigned short (16 bit) quantity starting at the given byteIndex."	isBE		ifTrue:			["Just shifting, without masking, will cause byteAt:put:			to fail if anUnsignedShort doesn't fit in 16 bits."			self byteAt: byteIndex put: (anUnsignedShort bitShift: -8).			self byteAt: byteIndex + 1 put: (anUnsignedShort bitAnd: 16rFF)]		ifFalse:			[self byteAt: byteIndex + 1 put: (anUnsignedShort bitShift: -8).			self byteAt: byteIndex put: (anUnsignedShort bitAnd: 16rFF)].	^anUnsignedShort! !!UninterpretedBytes methodsFor: 'byte order reversal'!reverseByteOrder	"Only subclasses know what their byte interpretation is.	Default is no interpretation."	^self!swapLongAt: index 	"Used in migrating the receiver onto a new host platform"	| tmp |	tmp _ self byteAt: index.	self byteAt: index put: (self byteAt: index + 3).	self byteAt: index + 3 put: tmp.	tmp _ self byteAt: index + 1.	self byteAt: index + 1 put: (self byteAt: index + 2).	self byteAt: index + 2 put: tmp!swapShortAt: index 	"Used in migrating the receiver onto a new host platform"	| tmp |	tmp _ self byteAt: index.	self byteAt: index put: (self byteAt: index + 1).	self byteAt: index + 1 put: tmp! !!UninterpretedBytes methodsFor: 'comparing'!= anObject	"Answer whether the bytes of the receiver and argument are the same."	(anObject class isBits and: [self sizeInBytes = anObject basicSize])		ifFalse: [^false].	1 to: self sizeInBytes do: [:i | (self byteAt: i)			= (anObject basicAt: i) ifFalse: [^false]].	^true!hash	"Answer a SmallInteger unique to the receiver."	self sizeInBytes = 0 ifTrue: [^17171].	^(self byteAt: 1) hash + (self byteAt: self sizeInBytes) hash + self sizeInBytes hash! !!UninterpretedBytes methodsFor: 'copying'!deepCopy	"Answer a copy of the receiver with its own copy of each instance 	variable. Object>>deepCopy would do much unneeded work; since	the instance contains only bits, just do a copy."	^self copy! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!UninterpretedBytes class	instanceVariableNames: ''!!UninterpretedBytes class methodsFor: 'class initialization'!initialize	"UninterpretedBytes initialize."	"Protect against multiple initialize's; but I sure wish that dependents had set semantics."	EndianDependentClasses _ IdentitySet new.	Smalltalk removeDependent: self.	Smalltalk addDependent: self.	self checkByteOrder!obsolete	Smalltalk removeDependent: self.	^super obsolete! !!UninterpretedBytes class methodsFor: 'instance creation'!from: aByteArray	"Make a new UninterpretedBytes instance which copies the	contents of aByteArray.  Answer the new instance."	| ub len |	len _ aByteArray size.	ub _ self new: len.	ub replaceBytesFrom: 1 to: len with: aByteArray startingAt: 1.	^ub!with: aByteArray from: start to: stop	"Make a new UninterpretedBytes instance which copies the	contents of aByteArray beginning at index start and ending at	index stop.  Answer the new instance."	| ub len |	len _ stop - start + 1.	ub _ self new: len.	ub replaceBytesFrom: 1 to: len with: aByteArray startingAt: start.	^ub! !!UninterpretedBytes class methodsFor: 'testing'!isBigEndian	"Return true if this platform uses big-endian	order for multi-byte scalars (e.g., MC680xx,	SPARC), false if it uses little-endian order	(e.g., Intel 80x86, VAX)."	<primitive: 534>	"For debugging only, we assume big-endian.	This should be self primitiveFailed."	^true! !!UninterpretedBytes class methodsFor: 'system initialization'!checkByteOrder	"Check to see if current platform byte-endianness is the 	same as it was before. If not (e.g. returning from a snapshot 	on a different platform), inform all subclasses."	| cbe |	cbe _ self isBigEndian.	WasBigEndian notNil		ifTrue: [(WasBigEndian eqv: cbe)			ifFalse: 				[self allSubclassesDo: [:c | c reverseByteOrder].				EndianDependentClasses do: [:clName | (Smalltalk at: clName)						allInstancesDo: [:obj | obj reverseByteOrder]]]].	WasBigEndian _ cbe!deregister: aClass	"Record that aClass's instances need to be mutated when	the image is put on a machine with a different endian convention"	EndianDependentClasses remove: aClass name ifAbsent: []!register: aClass	"Record that aClass's instances need to be mutated when	the image is put on a machine with a different endian convention"	(aClass isKindOf: UninterpretedBytes)		ifFalse:	[EndianDependentClasses add: aClass name]!reverseByteOrder	"Inform all instances that they need to reverse their byte-order."	self allInstancesDo: [:o | o reverseByteOrder]! !!UninterpretedBytes class methodsFor: 'examples'!example	"UninterpretedBytes example"	| ex |	ex _ self new: 5.	ex byteAt: 2 put: 16r81.	ex byteAt: 3 put: 16r83.	ex byteAt: 4 put: 16r5.	ex byteAt: 5 put: 16r87.	#(shortAt: unsignedShortAt: longAt: unsignedLongAt:)	with: (self isBigEndian		ifTrue: [#(-16r7E7D 16r8183 -16r7E7CFA79 16r81830587)]		ifFalse: [#(-16r7C7F 16r8381 -16r78FA7C7F 16r87058381)])	do: [:msg :result |		(ex perform: msg with: 2) = result ifFalse: [self error: 'accessing error']].! !UninterpretedBytes initialize!UnixIOAccessor subclass: #UnixDiskFileAccessor	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'OS-Unix'!UnixDiskFileAccessor comment:'This class will be renamed UnixFileAccessor in a subsequent release.  It adds behavior for honest-to-goodness disk files, i.e. positioning.'!!UnixDiskFileAccessor methodsFor: 'locking'!lock: bool for: pos	"bool Boolean (true = setlock, false = clear lock)	pos is SmallInteger (byte count from current position)	Returns self."	"Locks apply from the current file pointer, for the number of bytes	specified in the second arg.  The bytecount can be negative (preceeding	but not includeing the current offset).	If the accessor was opened without write permission, call	will fail with a EACCES error.	Setting a lock when the file is locked by another process	call will fail with an EAGAIN error."	<primitive: 667>	^self reportError! !!UnixDiskFileAccessor methodsFor: 'accessing'!commit	"Advise OS to synch dirty buffers associated with this accessor."	<primitive: 665>	self reportError! !!UnixDiskFileAccessor methodsFor: 'defaults'!connectionClass	"Answer a default connection class for the receiver."	^FileConnection! !!UnixDiskFileAccessor methodsFor: 'stream creation'!readWriteStream	"Answer a read write stream connected to the receiver."	^self asExternalConnection readWriteStream! !OSErrorHolder subclass: #UnixErrorHolder	instanceVariableNames: ''	classVariableNames: 'ErrorNames ErrorSignals '	poolDictionaries: ''	category: 'OS-Unix'!UnixErrorHolder comment:'Unix error codes are interpreted here.  If we were willing to use multiple-inheritance, this class would be a mix-in for UnixIOAccessor, UnixProcess and UnixFilename.  As it is, those classes forward to UnixErrorHolder (as an `error reporter'') to interpret errors coming back from system service primitives.Class Variables:	ErrorNames		<IdentityDictionary> of Signal names	ErrorSignals		<IdentityDictionary> of Signals'!"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!UnixErrorHolder class	instanceVariableNames: ''!!UnixErrorHolder class methodsFor: 'class initialization'!hookupTo: platname	"Set-up to deal with a particular platform (w.r.t. error codes)."	"Probably should use an ordered collection of patterns (from most to least specific)	with corresponding selectors to perform.  This will have to do for now."	"The main difference between the two unixes we have to deal with (at the moment)	is the mapping from error-codes to error-names."	('* sun *' match: platname)		ifTrue: [self initSunErrorNames]		ifFalse: [('* ardent *' match: platname)				ifTrue: [self initArdentErrorNames]				ifFalse: [('* digital *' match: platname)					ifTrue: [self initDecErrorNames]					ifFalse: [self initErrorNames]]]!initialize	"UnixErrorHolder initialize."	self initErrorSignals! !!UnixErrorHolder class methodsFor: 'error reporting'!errorDescriptionFor: aSmallInteger	"returns a string describing the error."	<primitive: 697>	^super errorDescriptionFor: aSmallInteger!reportOn: anErrorHolder 	"As an error reporter, report the error contained by this holder."	"This means, map the error holder's error code to the error name, 	map the error name to an error signal, and raise the signal."	anErrorHolder errorCode == nil		ifTrue:	[^self unsupportedOperationSignal raiseWith: anErrorHolder].	^(ErrorSignals at: (ErrorNames at: anErrorHolder errorCode ifAbsent: [#unknown])		ifAbsent: [self errorSignal])		raiseWith: anErrorHolder!reportProceedingOn: anErrorHolder 	"As an error reporter, report the (proceedable) error contained by this holder."	"This means, map the error holder's error code to the error name, 	map the error name to an error signal, and raise the signal."	^(ErrorSignals at: (ErrorNames at: anErrorHolder errorCode ifAbsent: [#unknown])		ifAbsent: [self errorSignal])		raiseRequestWith: anErrorHolder! !!UnixErrorHolder class methodsFor: 'private-initialization'!initArdentErrorNames	ErrorNames _ IdentityDictionary new: 100.	self initPrivateErrorNames.	self initCommonErrorNames.	ErrorNames at: 35 put: #ENOMSG.	ErrorNames at: 36 put: #EIDRM.	ErrorNames at: 37 put: #ECHRNG.	ErrorNames at: 38 put: #EL2NSYNC.	ErrorNames at: 39 put: #EL3HLT.	ErrorNames at: 40 put: #EL3RST.	ErrorNames at: 41 put: #ELNRNG.	ErrorNames at: 42 put: #EUNATCH.	ErrorNames at: 43 put: #ENOCSI.	ErrorNames at: 44 put: #EL2HLT.	ErrorNames at: 45 put: #EWOULDBLOCK.	UnixIOAccessor wouldBlockErrorCode: 11.	ErrorNames at: 46 put: #ENOLCK.	ErrorNames at: 50 put: #EBADE.	ErrorNames at: 51 put: #EBADR.	ErrorNames at: 52 put: #EXFULL.	ErrorNames at: 53 put: #ENOANO.	ErrorNames at: 54 put: #EBADRQC.	ErrorNames at: 55 put: #EBADSLT.	ErrorNames at: 56 put: #EDEADLOCK.	ErrorNames at: 57 put: #EBFONT.	ErrorNames at: 60 put: #ENOSTR.	ErrorNames at: 61 put: #ENODATA.	ErrorNames at: 62 put: #ETIME.	ErrorNames at: 63 put: #ENOSR.	ErrorNames at: 64 put: #ENONET.	ErrorNames at: 65 put: #ENOPKG.	ErrorNames at: 66 put: #EREMOTE.	ErrorNames at: 67 put: #ENOLINK.	ErrorNames at: 68 put: #EADV.	ErrorNames at: 69 put: #ESRMNT.	ErrorNames at: 70 put: #ECOMM.	ErrorNames at: 71 put: #EPROTO.	ErrorNames at: 74 put: #EMULTIHOP.	ErrorNames at: 75 put: #ELBIN.	ErrorNames at: 76 put: #EDOTDOT.	ErrorNames at: 77 put: #EBADMSG.	ErrorNames at: 80 put: #ENOTUNIQ.	ErrorNames at: 81 put: #EBADFD.	ErrorNames at:  82 put: #EREMCHG.	ErrorNames at: 83 put: #ELIBACC.	ErrorNames at: 84 put: #ELIBBAD.	ErrorNames at: 85 put: #ELIBSCN.	ErrorNames at: 86 put: #ELIBMAX.	ErrorNames at: 87 put: #ELIBEXEC.	ErrorNames at: 90 put: #EINPROGRESS.	UnixIOAccessor inProgressErrorCode: 90.	ErrorNames at: 91 put: #EALREADY.	ErrorNames at: 92 put: #ENOTSOCK.	ErrorNames at: 93 put: #EDESTADDRREQ.	ErrorNames at: 94 put: #EMSGSIZE.	ErrorNames at: 95 put: #EPROTOTYPE.	ErrorNames at: 96 put: #ENOPROTOOPT.	ErrorNames at: 97 put: #EPROTONOSUPPORT.	ErrorNames at: 98 put: #ESOCKTNOSUPPORT.	ErrorNames at: 99 put: #EOPNOTSUPP.	ErrorNames at: 100 put: #EPFNOSUPPORT.	ErrorNames at: 101 put: #EAFNOSUPPORT.	ErrorNames at: 102 put: #EADDRINUSE.	ErrorNames at: 103 put: #EADDRNOTAVAIL.	ErrorNames at: 104 put: #ENETDOWN.	ErrorNames at: 105 put: #ENETUNREACH.	ErrorNames at: 106 put: #ENETRESET.	ErrorNames at: 107 put: #ECONNABORTED.	ErrorNames at: 108 put: #ECONNRESET.	ErrorNames at: 109 put: #ENOBUFS.	ErrorNames at: 110 put: #EISCONN.	ErrorNames at: 111 put: #ENOTCONN.	ErrorNames at: 112 put: #ESHUTDOWN.	ErrorNames at: 113 put: #ETOOMANYREFS.	ErrorNames at: 114 put: #ETIMEDOUT.	ErrorNames at: 115 put: #ECONNREFUSED.	ErrorNames at: 	116 put: #ELOOP.	ErrorNames at: 117 put: #ENAMETOOLONG.	ErrorNames at: 118 put: #EHOSTDOWN.	ErrorNames at: 119 put: #EHOSTUNREACH.	ErrorNames at: 120 put: #ENOTEMPTY.	ErrorNames at: 121 put: #EPROCLIM.	ErrorNames at: 122 put: #EUSERS.	ErrorNames at: 123 put: #EDQUOT!initBsdErrorNames	ErrorNames at: 35 put: #EWOULDBLOCK.	UnixIOAccessor wouldBlockErrorCode: 35.	ErrorNames at: 36 put: #EINPROGRESS.	UnixIOAccessor inProgressErrorCode: 36.	ErrorNames at: 37 put: #EALREADY.	ErrorNames at: 38 put: #ENOTSOCK.	ErrorNames at: 39 put: #EDESTADDRREQ.	ErrorNames at: 40 put: #EMSGSIZE.	ErrorNames at: 41 put: #EPROTOTYPE.	ErrorNames at: 42 put: #ENOPROTOOPT.	ErrorNames at: 43 put: #EPROTONOSUPPORT.	ErrorNames at: 44 put: #ESOCKTNOSUPPORT.	ErrorNames at: 45 put: #EOPNOTSUPP.	ErrorNames at: 46 put: #EPFNOSUPPORT.	ErrorNames at: 47 put: #EAFNOSUPPORT.	ErrorNames at: 48 put: #EADDRINUSE.	ErrorNames at: 49 put: #EADDRNOTAVAIL.	ErrorNames at: 50 put: #ENETDOWN.	ErrorNames at: 51 put: #ENETUNREACH.	ErrorNames at: 52 put: #ENETRESET.	ErrorNames at: 53 put: #ECONNABORTED.	ErrorNames at: 54 put: #ECONNRESET.	ErrorNames at: 55 put: #ENOBUFS.	ErrorNames at: 56 put: #EISCONN.	ErrorNames at: 57 put: #ENOTCONN.	ErrorNames at: 58 put: #ESHUTDOWN.	ErrorNames at: 59 put: #ETOOMANYREFS.	ErrorNames at: 60 put: #ETIMEDOUT.	ErrorNames at: 61 put: #ECONNREFUSED.	ErrorNames at: 62 put: #ELOOP.	ErrorNames at: 63 put: #ENAMETOOLONG.	ErrorNames at: 64 put: #EHOSTDOWN.	ErrorNames at: 65 put: #EHOSTUNREACH.	ErrorNames at: 66 put: #ENOTEMPTY.	ErrorNames at: 67 put: #EPROCLIM.	ErrorNames at: 68 put: #EUSERS.	ErrorNames at: 69 put: #EDQUOT.	ErrorNames at: 70 put: #ESTALE.	ErrorNames at: 71 put: #EREMOTE!initCommonErrorNames	"Initialize the error-code to error-name map which is common."	ErrorNames at: 1 put: #EPERM.	ErrorNames at: 2 put: #ENOENT.	ErrorNames at: 3 put: #ESRCH.	ErrorNames at: 4 put: #EINTR.	ErrorNames at: 5 put: #EIO.	ErrorNames at: 6 put: #ENXIO.	ErrorNames at: 7 put: #E2BIG.	ErrorNames at: 8 put: #ENOEXEC.	ErrorNames at: 9 put: #EBADF.	ErrorNames at: 10 put: #ECHILD.	ErrorNames at: 11 put: #EAGAIN.	ErrorNames at: 12 put: #ENOMEM.	ErrorNames at: 13 put: #EACCES.	ErrorNames at: 14 put: #EFAULT.	ErrorNames at: 15 put: #ENOTBLK.	ErrorNames at: 16 put: #EBUSY.	ErrorNames at: 17 put: #EEXIST.	ErrorNames at: 18 put: #EXDEV.	ErrorNames at: 19 put: #ENODEV.	ErrorNames at: 20 put: #ENOTDIR.	ErrorNames at: 21 put: #EISDIR.	ErrorNames at: 22 put: #EINVAL.	ErrorNames at: 23 put: #ENFILE.	ErrorNames at: 24 put: #EMFILE.	ErrorNames at: 25 put: #ENOTTY.	ErrorNames at: 26 put: #ETXTBSY.	ErrorNames at: 27 put: #EFBIG.	ErrorNames at: 28 put: #ENOSPC.	ErrorNames at: 29 put: #ESPIPE.	ErrorNames at: 30 put: #EROFS.	ErrorNames at: 31 put: #EMLINK.	ErrorNames at: 32 put: #EPIPE.	ErrorNames at: 33 put: #EDOM.	ErrorNames at: 34 put: #ERANGE!initDecErrorNames	ErrorNames _ IdentityDictionary new: 100.	self initPrivateErrorNames.	self initCommonErrorNames.	self initBsdErrorNames.	ErrorNames at: 73 put: #EIDRM.	ErrorNames at: 74 put: #EALIGN.	ErrorNames at: 75 put: #ENOLCK!initErrorNames	"BUG!!"	self initSunErrorNames!initErrorSignals	"UnixErrorHolder initErrorSignals"	ErrorSignals _ IdentityDictionary new: 100.	ErrorSignals at: #unknown put: self errorSignal.	ErrorSignals at: #EINPROGRESS put: self operationStartedSignal.	ErrorSignals at: #ENOTBLK put: self inappropriateOperationSignal.	ErrorSignals at: #ENOTDIR put: self inappropriateOperationSignal.	ErrorSignals at: #EISDIR put: self inappropriateOperationSignal.	ErrorSignals at: #ENOTTY put: self inappropriateOperationSignal.	ErrorSignals at: #ENOSTR put: self inappropriateOperationSignal.	ErrorSignals at: #ESPIPE put: self inappropriateOperationSignal.	ErrorSignals at: #ENOTSOCK put: self inappropriateOperationSignal.	ErrorSignals at: #EOPNOTSUPP put: self inappropriateOperationSignal.	ErrorSignals at: #inappropriate put: self inappropriateOperationSignal.	ErrorSignals at: #EPROTOTYPE put: self wrongSubtypeForOperationSignal.	ErrorSignals at: #ENOPROTOOPT put: self wrongSubtypeForOperationSignal.	ErrorSignals at: #EPROTONOSUPPORT put: self unsupportedOperationSignal.	ErrorSignals at: #ESOCKNOSUPPORT put: self unsupportedOperationSignal.	ErrorSignals at: #EPFNOSUPPORT put: self unsupportedOperationSignal.	ErrorSignals at: #EAFNOSUPPORT put: self unsupportedOperationSignal.	ErrorSignals at: #nosupport put: self unsupportedOperationSignal.	ErrorSignals at: #EISCONN put: self unpreparedOperationSignal.	ErrorSignals at: #ENOTCONN put: self unpreparedOperationSignal.	ErrorSignals at: #ESHUTDOWN put: self unpreparedOperationSignal.	ErrorSignals at: #EWOULDBLOCK put: self notReadySignal.	ErrorSignals at: #EALREADY put: self notReadySignal.	ErrorSignals at: #EINTR put: self transientErrorSignal.	ErrorSignals at: #allocfail put: self allocRetrySignal.	ErrorSignals at: #EIO put: self transferFaultSignal.	ErrorSignals at: #ENXIO put: self transferFaultSignal.	ErrorSignals at: #ECOMM put: self transferFaultSignal.	ErrorSignals at: #eof put: self noDataSignal.	ErrorSignals at: #ENOMSG put: self noDataSignal.	ErrorSignals at: #EPIPE put: self peerFaultSignal.	ErrorSignals at: #ENETDOWN put: self peerFaultSignal.	ErrorSignals at: #ENETUNREACH put: self peerFaultSignal.	ErrorSignals at: #ENETRESET put: self peerFaultSignal.	ErrorSignals at: #ECONNABORTED put: self peerFaultSignal.	ErrorSignals at: #ECONNRESET put: self peerFaultSignal.	ErrorSignals at: #ETIMEOUT put: self peerFaultSignal.	ErrorSignals at: #ETIME put: self peerFaultSignal.	ErrorSignals at: #ECONNREFUSED put: self peerFaultSignal.	ErrorSignals at: #EHOSTDOWN put: self peerFaultSignal.	ErrorSignals at: #EHOSTUNREACH put: self peerFaultSignal.	ErrorSignals at: #EIDRM put: self peerFaultSignal.	ErrorSignals at: #ENOSPC put: self volumeFullSignal.	ErrorSignals at: #EDQUOT put: self volumeFullSignal.	ErrorSignals at: #E2BIG put: self invalidArgumentsSignal.	ErrorSignals at: #EFAULT put: self invalidArgumentsSignal.	ErrorSignals at: #EADDRINUSE put: self invalidArgumentsSignal.	ErrorSignals at: #badargs put: self badArgumentsSignal.	ErrorSignals at: #EBADF put: self badAccessorSignal.	ErrorSignals at: #EINVAL put: self invalidArgumentsSignal.	ErrorSignals at: #EMSGSIZE put: self rangeErrorSignal.	ErrorSignals at: #EMLINK put: self rangeErrorSignal.	ErrorSignals at: #ELOOP put: self rangeErrorSignal.	ErrorSignals at: #ENAMETOOLONG put: self rangeErrorSignal.	ErrorSignals at: #EREMOTE put: self rangeErrorSignal.	ErrorSignals at: #EDESTADDRREQ put: self underspecifiedSignal.	ErrorSignals at: #ENODEV put: self inaccessableSignal.	ErrorSignals at: #ENOENT put: self nonexistentSignal.	ErrorSignals at: #EBUSY put: self unavailableReferentSignal.	ErrorSignals at: #ESTALE put: self unavailableReferentSignal.	ErrorSignals at: #ENONET put: self unavailableReferentSignal.	ErrorSignals at: #EACCES put: self noPermissionsSignal.	ErrorSignals at: #EPERM put: self noPermissionsSignal.	ErrorSignals at: #EROFS put: self noPermissionsSignal.	ErrorSignals at: #EADDRNOTAVAIL put: self noPermissionsSignal.	ErrorSignals at: #EEXIST put: self existingReferentSignal.	ErrorSignals at: #EADDRINUSE put: self existingReferentSignal.	ErrorSignals at: #EXDEV put: self inappropriateReferentSignal.	ErrorSignals at: #ENOTEMPTY put: self inappropriateReferentSignal.	ErrorSignals at: #ENFILE put: self noResourcesSignal.	ErrorSignals at: #EMFILE put: self noResourcesSignal.	ErrorSignals at: #EFBIG put: self noResourcesSignal.	ErrorSignals at: #ENOMEM put: self noMemorySignal.	ErrorSignals at: #ENOBUFS put: self noMemorySignal.	ErrorSignals at: #ENOLCK put: self noResourcesSignal.	ErrorSignals at: #ENOSR put: self noResourcesSignal.	ErrorSignals at: #ENODATA put: self notReadySignal.	ErrorSignals at: #ELBIN put: self informationSignal.	ErrorSignals at: #EDOTDOT put: self informationSignal.	ErrorSignals at: #EBADFD put: self inappropriateOperationSignal!initPrivateErrorNames	"Set up map from error-codes to error-names for internally	generated errors."	ErrorNames at: -6 put: #inappropriate.	ErrorNames at: -5 put: #badargs.	ErrorNames at: -4 put: #unknown.	ErrorNames at: -1 put: #nosupport.	ErrorNames at: -2 put: #allocfail.	ErrorNames at: -3 put: #eof!initSunErrorNames	ErrorNames _ IdentityDictionary new: 100.	self initPrivateErrorNames.	self initCommonErrorNames.	self initBsdErrorNames.	ErrorNames at: 72 put: #ENOSTR.	ErrorNames at: 73 put: #ETIME.	ErrorNames at: 74 put: #ENOSR.	ErrorNames at: 75 put: #ENOMSG.	ErrorNames at: 76 put: #EBADMSG.	ErrorNames at: 77 put: #EIDRM.	ErrorNames at: 78 put: #EDEADLK.	ErrorNames at: 79 put: #ENOLCK.	ErrorNames at: 80 put: #ENONET.	ErrorNames at: 81 put: #ERREMOTE.	ErrorNames at: 82 put: #ENOLINK.	ErrorNames at: 83 put: #EADV.	ErrorNames at: 84 put: #ESRMNT.	ErrorNames at: 85 put: #ECOMM.	ErrorNames at: 86 put: #EPROTO.	ErrorNames at: 87 put: #EMULTIHOP.	ErrorNames at: 88 put: #EDOTDOT.	ErrorNames at: 89 put: #EREMCHG! !UnixErrorHolder initialize!Filename subclass: #UnixFilename	instanceVariableNames: ''	classVariableNames: 'LengthLimit '	poolDictionaries: ''	category: 'OS-Unix'!UnixFilename comment:'Refines class Filename to add unix-specific behavior such as access date interpretation.Class Variables:	LengthLimit	<SmallInteger> 	Maximum length of a filename component. (Different between Sys-V and 4.n derived systems)'!!UnixFilename methodsFor: 'testing'!isReadable	"Answer true if the file is readable."	"Implemented by opening the file for reading, then closing it.	BUG: This doesn't work if the file is a directory!!"		^UnixIOAccessor errorSignal handle: [:ex | ex returnWith: false]		do: 			[(UnixIOAccessor openFileReadOnly: self) close.			true]! !!UnixFilename methodsFor: 'parsing'!extension	"Answer a String with the file extension (chars after a period) if any."	| di |	di _ self lastIndexOf: $..	di = 0 ifTrue: [^''].	^nameString copyFrom: di + 1 to: nameString size! !!UnixFilename methodsFor: 'utilities'!getProtection	"Return the file's protection mode"	^self primGetProtectionErrInto: self errorReporter new!setProtection: mode	"Set the file's protection mode to 'mode'."	^self primSetProtection: mode errInto: self errorReporter new! !!UnixFilename methodsFor: 'private'!filesMatchingAccessList: list into: allNames 	list isEmpty		ifTrue:	[^allNames].	list first = '.'		ifTrue:	[list removeFirst.				^self filesMatchingAccessList: list into: allNames].	list first = '..'		ifTrue:	[list removeFirst.				^(self construct: '..') filesMatchingAccessList: list into: allNames].	^super filesMatchingAccessList: list into: allNames!named: n	"UnixFilename must be ByteString."	super named: n asByteString!primGetProtectionErrInto: anErrorHolder	"Return the file's protection mode."	<primitive: 617>	anErrorHolder reportFor: self!primSetProtection: mode errInto: anErrorHolder	"Set the file's protection mode to 'mode'."	<primitive: 615>	anErrorHolder reportFor: self! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!UnixFilename class	instanceVariableNames: ''!!UnixFilename class methodsFor: 'class initialization'!hookupTo: pn	"You have become the concrete class for Filename.  Prepare yourself."	"Probably should use an ordered collection of patterns (from most to least specific)	with corresponding selectors to perform.  This will have to do for now."	"The difference between the two unixes we have to deal with here is	filename length limit."	('* sys# *' match: pn)		ifTrue: [LengthLimit _ 14]		ifFalse: [LengthLimit _ 255]!install	self setSeparator: $/.	DefaultDirectory _ self findDefaultDirectory! !!UnixFilename class methodsFor: 'defaulting'!currentDirectoryString	"Return the platform-specific token that represents the current directory"	^'.'!errorReporter	"Answer the class which can do error interpretation for me."	^UnixErrorHolder! !!UnixFilename class methodsFor: 'constants'!changeExtension	"Answer the platform's changes filename extension."	^'.changes'!imageExtension	"Answer the platform's image filename extension"	^'.im'!maximumComponentLength	"Answer the maximum size of a single component of a path"	^LengthLimit!maxLength	"Answer the maximum length for a platform pathname."	^255!separator	"Answer the platform's filename component separator."	^$/!sourceExtension	"Answer the platform's sources filename extension."	^'.sources'! !!UnixFilename class methodsFor: 'parsing'!canonicalize: str 	"Convert this string to a canonical platform pathname string. 	This may make for arbitrary, unpleasent transformations, like 	truncating to 8 characters, folding to upper case, etc."	| components ws maxComponent skipBack |	str = '.' ifTrue: [^str].	maxComponent _ self maximumComponentLength.	ws _ WriteStream on: (String new: self maxLength).	skipBack _ false.	components _ self components: str.	components first last = self separator		ifTrue:	[ws nextPutAll: components removeFirst].	components do: [:pn |		(ws size + (pn size min: maxComponent)) < self maxLength ifTrue: [			(pn size > 0 and: [pn ~= '.'])				ifTrue: [					1 to: (pn size min: maxComponent) do: 						[:i | 						| c |						c _ pn at: i.						(self isBadCharacter: c) ifFalse: [ws nextPut: c]].					skipBack _ true.					ws nextPut: self separator]]].	skipBack		ifTrue:	[ws skip: -1].	^ws contents!isBadCharacter: char	"Answer if this character is illegal for a platform filename string."	^char asciiValue == 0 or: [char == $/]!isUglyCharacter: char	"Answer if this character is in bad taste for a platform pathname string."	| cv |	cv _ char asciiValue.	cv <= 32 "space" ifTrue: [^true].	cv >= 8r177 "del" ifTrue: [^true].	'*?><|&!!"''`#$[](){}^;\~%' do: [:uc | char == uc ifTrue: [^true]].	^false!suggest: str 	"Answer a string which is in good taste as a filename on this 	platform"	| fullName path moniker newName extension pair ws llimit |	llimit _ self maximumComponentLength.	pair _ self splitPath: str.	path _ pair at: 1.	fullName _ pair at: 2.	pair _ self splitExtension: fullName.	moniker _ pair at: 1.	extension _ pair at: 2.	ws _ WriteStream on: (String new: str size).	ws nextPutAll: path.	ws nextPutAll: (newName _ self					shrink: moniker					to: llimit - (4 min: (extension notNil ifTrue: [extension size + 1] ifFalse: [0]))					dropDelim: false).	(extension notNil and: [newName size < llimit])			ifTrue: 				[ws nextPut: $..				(newName size + 1 < llimit and: [extension size > 0])					ifTrue: [ws nextPutAll: (self							shrink: extension							to: llimit - 1 - newName size							dropDelim: true)]].	^self canonicalize: ws contents! !!UnixFilename class methodsFor: 'utilities'!setCreationMask: mask	"Change the default creation mask to 'mask' and return the old value"	^self primSetCreationMask: mask errInto: self errorReporter new!volumes	"Answer an Array of Strings naming all reachable disk volumes."	^Array with: '/'! !!UnixFilename class methodsFor: 'primitives'!primSetCreationMask: mask errInto: anErrorHolder	"Change the default creation mask to 'mask' and return the old value"	<primitive: 616>	anErrorHolder reportFor: self.	^0! !IOAccessor subclass: #UnixIOAccessor	instanceVariableNames: ''	classVariableNames: 'InProgressECode WouldBlockECode '	poolDictionaries: ''	category: 'OS-Unix'!UnixIOAccessor comment:'Class UnixIOAccessor is a reference to a Unix "file descriptor".  Instances of it (and its subclasses) are used to perform IO to the various kinds of stream-like services that Unix provides (pipes, fifos, sockets, disk files, serial lines, etc).Class Variables:	InProgressECode	<SmallInteger>	WouldBlockECode	<SmallInteger> Answer the error code known as EWOULDBLOCK in C-land.'!!UnixIOAccessor methodsFor: 'initialize-release'!close	"Inform Unix that the accessor's handle should be released.	Also, remove registry references."	"Most errors occurring on close are uninteresting and are squelched.	However, any error which indicates that a previous transation on the	accessor was not completed should be signalled."	self isActive ifTrue: [self errorReporter errorSignal		handle: [:ex | (ex signal inheritsFrom: self errorReporter transferFaultSignal)					ifTrue: [ex reject] ifFalse: [ex return]]		do: [self primClose]].	self release! !!UnixIOAccessor methodsFor: 'testing'!bytesForRead	"Return the number of bytes available for reading."	<primitive: 669>	^self reportErrorProceeding! !!UnixIOAccessor methodsFor: 'constants'!lineEndConvention	^LineEndLF! !!UnixIOAccessor methodsFor: 'data transfer'!readInto: buffer startingAt: index for: count untilFalse: aBlock 	"buffer is a byte-object, the place where IO is performed. 	index is a SmallInteger, the starting-point in the buffer. 	count is a SmallInteger, the maximum number of bytes to be read. 	aBlock is a one-arg block which is sent the count thus far. 	While it evaluates to true, reads will be repeated (unless an 	error occurs or the count is satisfied. The block can access 	the buffer in order to determine the result."	"Returns a SmallInteger, which is a count of the number of bytes 	read."	| start result total ms |	start _ index.	total _ 0.	ms _ self readPauseInterval.		[result _ self				primNofailReadInto: buffer				startingAt: start				for: count - total.	result == nil		ifFalse: 			[start _ start + result.			total _ total + result]		ifTrue: [errorCode = WouldBlockECode				ifTrue: [self readWaitWithTimeoutMs: ms]				ifFalse: [self reportError]].	(aBlock value: total)		and: [total < count]] whileTrue.	^total!writeFrom: buffer startingAt: index for: count untilFalse: aBlock 	"buffer is a byte-object, the place where IO is performed. 	index is a SmallInteger, the starting-point in the buffer. 	count is a SmallInteger, the maximum number of bytes to be written. 	aBlock is a one-arg block which is sent the count thus far. 	While it evaluates to true, writes will be repeated (unless an 	error occurs or the count is satisfied. The block can access 	the buffer in order to determine the result."	"Returns a SmallInteger, which is a count of the number of bytes 	written."	| start result total ms |	start _ index.	total _ 0.	ms _ self writePauseInterval.		[result _ self				primNofailWriteFrom: buffer				startingAt: start				for: count - total.	result == nil		ifFalse: 			[start _ start + result.			total _ total + result]		ifTrue: [errorCode = WouldBlockECode				ifTrue: [self writeWaitWithTimeoutMs: ms]				ifFalse: [self reportError]].	(aBlock value: total)		and: [total < count]] whileTrue.	^total! !!UnixIOAccessor methodsFor: 'private'!primNofailReadInto: buffer startingAt: index for: count	"buffer is a byte-object, the place where IO is performed. 	index is a SmallInteger, the starting-point in the buffer. 	count is a SmallInteger, the number of bytes to be read."	"Returns a SmallInteger, which is the count of the bytes read."	"WouldBlock is a potential error condition."	<primitive: 660>	^nil!primNofailWriteFrom: buffer startingAt: index for: count	"buffer is a byte-object, the place where IO is performed.	 index is a SmallInteger, the starting-point in the buffer.	 count is a SmallInteger, the number of bytes to be written."	"Returns a SmallInteger, which is the count of the bytes written."	<primitive: 661>	^nil!primReadInto: buffer startingAt: index for: count 	"buffer is a byte-object, the place where IO is performed. 	index is a SmallInteger, the starting-point in the buffer. 	count is a SmallInteger, the number of bytes to be read."	"Returns a SmallInteger, which is the count of the bytes read."	"WouldBlock is a potential error condition."	<primitive: 660>	errorCode = WouldBlockECode		ifTrue: 			[self readWait.			^self primReadInto: buffer startingAt: index for: count].	^self reportErrorProceeding!primWriteFrom: buffer startingAt: index for: count	"buffer is a byte-object, the place where IO is performed.	 index is a SmallInteger, the starting-point in the buffer.	 count is a SmallInteger, the number of bytes to be written."	"Returns a SmallInteger, which is the count of the bytes written."	"WouldBlock is a potential error condition."	<primitive: 661>	errorCode = WouldBlockECode		ifTrue: 			[self writeWait.			^self primWriteFrom: buffer startingAt: index for: count].	^self reportErrorProceeding!setSem: sem forWrite: bool	"Signal this semaphore when the fd is ready for an IO operation.	bool is true if the fd is for writing, false if for reading."	<primitive: 668>	^self reportError! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!UnixIOAccessor class	instanceVariableNames: ''!!UnixIOAccessor class methodsFor: 'class initialization'!hookupTo: platname 	"This shouldn't really be here, but *someone* needs to	tell these guys to hook-up, it might as well be me."	UnixTtyAccessor hookupTo: platname.	UnixErrorHolder hookupTo: platname!inProgressErrorCode: n	"Assign the error code for ``operation in progress''."	InProgressECode _ n!install	"Install any additional concrete Unix IO classes."	"This should be moved somewhere else..."	| usa |	usa _ Smalltalk at: #UnixSocketAccessor ifAbsent: [nil].	usa isNil ifFalse: [usa install]!wouldBlockErrorCode: n	"Assign the value for the wouldBlock error code."	WouldBlockECode _ n! !!UnixIOAccessor class methodsFor: 'defaulting'!defaultClass	"Answer the appropriate concrete subclass."	^self!defaultForFiles	"Return the appropriate class for real (disk) files."	^UnixDiskFileAccessor!defaultForIPC	"Return the appropriate class for inter-process communications."	^Smalltalk at: #UnixSocketAccessor ifAbsent: [UnixPipeAccessor]!defaultForSerial	"Return the appropriate class for serial (rs-232) communications."	^UnixRealTtyAccessor!errorReporter	"Answer the appropriate error code interpreter for me."	^UnixErrorHolder! !UnixIOAccessor subclass: #UnixPipeAccessor	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'OS-Unix'!UnixPipeAccessor comment:'Accessors for Unix pipes (which are used for IPC to child processes).'!!UnixPipeAccessor methodsFor: 'accessing'!bufferSize	"Answer the recommended buffer size for this accessor."	"pipes are special."	^4096! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!UnixPipeAccessor class	instanceVariableNames: ''!!UnixPipeAccessor class methodsFor: 'instance creation'!openPair	"Create a pair of connected accessors.	Returns an (Array with: readEnd with: writeEnd)."	| fd2 e ur uw |	fd2 _ self primPipeErrorInto: (e _ self errorReporter new).	e failed ifTrue: [^e reportFor: self].	ur _ self handle: (fd2 at: 1).	uw _ self handle: (fd2 at: 2).	^Array with: ur with: uw! !!UnixPipeAccessor class methodsFor: 'primitives'!primPipeErrorInto: errorHolder	"Create a pair of connected accessors.	Returns an (Array with: readFD with: writeFD)."	<primitive: 652>	^errorHolder reportFor: self! !ExternalProcess subclass: #UnixProcess	instanceVariableNames: 'exitStatus exitSemaphore '	classVariableNames: ''	poolDictionaries: ''	category: 'OS-Unix'!UnixProcess comment:'Class UnixProcess provides a reference to a (heavyweight) Unix process which was created as a child of the running Smalltalk.  Instances are created from return values of primitives which "fork&exec" new (heavyweight) processes.  After you create them, the main interesting thing to do with a UnixProcess is to wait for it to be done and look at its returned status.UnixProcesses are reaped by the InputState thread; that is, when the InputState process is told that some child died, it queries the VM for the process''es handle and exit status.  It then uses the registry to inform the UnixProcess (which updates instance vars and signals semaphores).Instance Variables:	exitStatus	<SmallInteger>				The returned result from an exited process.  Not valid				until the process is known to have exited.  Interpretation				of the value is by prior agreement with the invoked process.				0 typically means that all went well.	exitSemaphore	<Semaphore>				Signalled (by the UnixProcess reaper mechanism defined				in the metaclass and invoked by InputState>>run) when				the process exits.'!!UnixProcess methodsFor: 'accessing'!status	"Return my exit status.  Only meaningful if the process has exited."	"Actually, nil means that the process (seemingly) hasn't exited yet."	^exitStatus! !!UnixProcess methodsFor: 'testing'!isActive	"Return true if the UnixProcess is still thought to be running."	^exitSemaphore notNil & (exitStatus == nil)!isExited	"Return true if the UnixProcess has exited."	^exitStatus notNil!isOK	"Return true if the UnixProcess is still thought to be running and accessable."	^self isActive & handle notNil!isZombie	"Return true if the UnixProcess is still thought to be running but is inacessable."	^self isActive & handle == nil! !!UnixProcess methodsFor: 'synchronization'!kill: sig	"send a signal to this process.  Sig is a SmallInteger, interpretation is by OS standards."	<primitive: 683>	^self reportError!wait	"Block the caller until I have exited."	"Since there could be many waiters, each waiter signals the 	semaphore an extra time in order to permit everyone to proceed."	self isExited | (exitSemaphore == nil)		ifFalse: 			[exitSemaphore wait.			exitSemaphore signal]! !!UnixProcess methodsFor: 'printing'!printOn: aStream 	"Append to the argument aStream a sequence of characters that 	identifies the receiver."	aStream nextPutAll: 'a '.	aStream nextPutAll: self class name.	handle == nil		ifTrue: 			[aStream nextPutAll: ' (Inactive: exitStatus '.			exitStatus printOn: aStream]		ifFalse: 			[aStream nextPutAll: '(Active: pid '.			handle printOn: aStream].	errorCode == nil		ifFalse: 			[aStream nextPutAll: ', '.			self printErrorDescriptionOn: aStream].	aStream nextPut: $)! !!UnixProcess methodsFor: 'private-initialize/release'!done: v 	"Handle a process which has exited."	"Record the status, remove me from the active list and awaken any waiters."	self class unregister: self.	exitStatus _ v.	handle _ nil.	exitSemaphore == nil ifFalse: [exitSemaphore signal]!initialize	"Create the semaphore to be signaled when the process has exited."	exitSemaphore _ Semaphore new.	^super initialize!release	"Break the reference to the (presumably non-existant) process."	| s |	self class unregister: self.	s _ exitSemaphore.	super release.	exitSemaphore _ nil.	s == nil ifFalse: [s signal]! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!UnixProcess class	instanceVariableNames: ''!!UnixProcess class methodsFor: 'class initialization'!hookupTo: pn	"You have become the default class for ExternalProcess.  Prepare yourself."	"Do nothing."! !!UnixProcess class methodsFor: 'instance creation'!forkJob: progName arguments: args	"Fork & exec a new unix process.  The program to exec is named	by progName (String).  Pass it the arguments args (Array of String),	the default environment and the default stdin/stdout/stderr.	Answer a UnixProcess."	^self forkJob: progName arguments: args environment: nil descriptors: nil.!forkJob: progName arguments: args descriptors: fds	"Fork & exec a new unix process.  The program to exec is named	by progName (String).  Pass it the arguments args (Array of String),	the default environment and the accessors fds	(Array with: stdin with: stdout with: stderr).  Answer a UnixProcess."	^self forkJob: progName arguments: args environment: nil descriptors: fds!forkJob: progName arguments: args environment: env descriptors: fds	"Fork & exec a new unix process.  The program to exec is named	by progName (String).  Pass it the arguments args (Array of String),	the environment env (CEnvironment) and the accessors fds	(Array with: stdin with: stdout with: stderr).  Answer a UnixProcess."	| proc pid |	pid _ self primFork: progName arguments: args environment: env descriptors: fds errorTo: (self errorReporter new).	proc _ super handle: pid.	^proc!forkJob: progName descriptors: fds	"Fork & exec a new unix process.  The program to exec is named	by progName (String).  Pass it no arguments,	the default environment and the accessors fds	(Array with: stdin with: stdout with: stderr).  Answer a UnixProcess."	^self forkJob: progName arguments: nil environment: nil descriptors: fds! !!UnixProcess class methodsFor: 'defaulting'!defaultClass	"Answer the appropriate concrete class."	"I'm quite concrete!!"	^self!errorReporter	"Answer the appropriate class for error interpretation."	^UnixErrorHolder! !!UnixProcess class methodsFor: 'process reaping'!reapSome	"Find all exited child processes and reap them."	"This routine may be called from a high priority process,	so we fork off a thread to do the ``done'' signaling."	| result process |	[(result _ self reapOne) == nil]		whileFalse: 			[process _ self findRegistrant: (result at: 1).			process == nil ifFalse: [[process done: (result at: 2)] forkAt: Processor userInterruptPriority]]! !!UnixProcess class methodsFor: 'examples'!cshBullet: string	"Execute a csh command, and ignore the reply.	Not appropriate if the command would return a long reply (>= 4096 bytes)	since the process would never exit."	"UnixProcess cshBullet: 'rm useless.file'"	| cmd proc connection|	connection _ self pipeConnectionFor: 'csh'			arguments: #('-ft')			setProcessDescriptor: [:pd | proc _ pd].	cmd _ connection writeStream.	[cmd nextPutAll: string; cr; commit.	proc wait]		valueNowOrOnUnwindDo: [cmd close].	proc release!cshOne: string 	"Invoke a c-shell, pass it the string as a command and return the 	result (a String)."	"UnixProcess cshOne: 'ls -l'"	| cmd proc reply connection |	connection _ self pipeConnectionFor: 'csh'			arguments: #('-ft')			setProcessDescriptor: [:pd | proc _ pd].	cmd _ connection readAppendStream.	[cmd nextPutAll: string; cr; commit.	reply _ cmd contents.	proc wait]		valueNowOrOnUnwindDo: [cmd close].	proc release.	^reply!directoryListing	"Return a directory listing using the Unix ls command"	"UnixProcess directoryListing"	| cmd proc reply connection |	connection _ self pipeConnectionFor: 'ls'			arguments: #('-a' '-l')			setProcessDescriptor: [:pd | proc _ pd].	cmd _ connection readStream.	[reply _ cmd contents.	proc wait]		valueNowOrOnUnwindDo: [cmd close].	proc release.	^reply! !!UnixProcess class methodsFor: 'private'!pipeConnectionFor: aName arguments: startupArguments setProcessDescriptor: pdBlock 	"Start a new job on the program called aName, passing 	startupArguments and setting up pipes to communicate to the new 	job. Answer an ExternalConnection which can communicate to the 	job. Pass the process descriptor into the block pdBlock."	| fdPair outputReadEnd outputWriteEnd inputReadEnd inputWriteEnd processDescriptor externalConnection |		[fdPair _ UnixPipeAccessor openPair.	outputReadEnd _ fdPair at: 1.	outputWriteEnd _ fdPair at: 2.	"Open a pipe for child's input"	fdPair _ UnixPipeAccessor openPair.	inputReadEnd _ fdPair at: 1.	inputWriteEnd _ fdPair at: 2.	"stderr"	processDescriptor _ self				forkJob: aName				arguments: startupArguments				descriptors: (Array						with: inputReadEnd						with: outputWriteEnd						with: outputWriteEnd)]		valueOnUnwindDo: ["Close open accessors on error."			(Array				with: outputReadEnd				with: outputWriteEnd				with: inputReadEnd				with: inputWriteEnd)				do: [:ioa | ioa notNil ifTrue: [ioa close]]].	"Close unshared FD's"	outputWriteEnd close.	inputReadEnd close.	externalConnection _ ExternalConnection new.	externalConnection input: outputReadEnd.	externalConnection output: inputWriteEnd.	pdBlock value: processDescriptor.	^externalConnection!primFork: nm arguments: args environment: env descriptors: fds errorTo: errorHolder	"Fork & exec a new unix process.  The program to exec is named	by progName (String).  Pass it the arguments args (Array of String),	the environment env (CEnvironment) and the accessors fds	(Array with: stdin with: stdout with: stderr).  Answer a unix pid."	<primitive: 681>	errorHolder reportFor: self.	^nil!reapOne	"Returns an (Array with: pid with: status) for an exited process."	<primitive: 682>	^nil! !UnixTtyAccessor subclass: #UnixPseudoTtyAccessor	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'OS-Unix'!UnixPseudoTtyAccessor comment:'Pseudo-ttys are a weird concept.  They exist pretty much exclusively for IPC with subforks.  They are like other file-descriptors except they can''t be positioned and don''t signal semaphores predictably.'!!UnixPseudoTtyAccessor methodsFor: 'private'!readWait	"Wait until the accessor has data available for reading."	"Override superclass method because ptys don't signal reliably."	[self readWaitWithTimeoutMs: self readPauseInterval] whileTrue!writeWait	"Wait until the accessor has data available for writing."	"Override superclass method because ptys don't signal reliably."	[self writeWaitWithTimeoutMs: self writePauseInterval] whileTrue! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!UnixPseudoTtyAccessor class	instanceVariableNames: ''!!UnixPseudoTtyAccessor class methodsFor: 'instance creation'!openMaster	"Creates a master pty and returns it and its identifier (e.g. 'p0') as 	an association."	'pqr' do: [:let1 |		'0123456789abcdef' do: 			[:let2 | 			| pty id |			id _ String with: let1 with: let2.			self errorSignal				handle: [:ex | ex return]				do: [pty _ self openMaster: id.					^Association key: id value: pty]]].	^self noResourcesSignal raiseErrorString: 'No more ptys'!openMaster: ptyName 	"Creates a master pty ( in /dev/pty*) and returns it."	| mfd master |	mfd _ self				primOpenFileNamed: '/dev/pty' , ptyName				direction: self readWrite				creation: self noCreate				errorInto: self errorReporter new.	master _ self handle: mfd.	^master!openPair	"Creates a connected pty pair.	Returns an (Array with: master with: slave)."	| fd2 e master slave |	fd2 _ self primPtyErrorInto: (e _ self errorReporter new).	e failed ifTrue: [^e reportFor: self].	master _ self handle: (fd2 at: 1).	slave _ self handle: (fd2 at: 2).	^Array with: master with: slave! !!UnixPseudoTtyAccessor class methodsFor: 'private'!primPtyErrorInto: errorHolder	"Create a pty pair.	Returns an (Array with: masterFD with: slaveFD)."	<primitive: 653>	^errorHolder reportFor: self! !UnixTtyAccessor subclass: #UnixRealTtyAccessor	instanceVariableNames: ''	classVariableNames: 'DefaultPort '	poolDictionaries: ''	category: 'OS-Unix'!UnixRealTtyAccessor comment:'Accessors for real "serial line" devices.  Specialized behavior includes modem control.Class Variables:	DefaultPort		<ByteString> the initial pathway information'!!UnixRealTtyAccessor methodsFor: 'primitives'!modemBits: bits mask: mask sendBreak: bool	"Sets platform-specific modem-control bits of first arg (SmallInteger)	corresponding to mask of second arg (SmallInteger)	(e.g. only bits set in mask are effected,	0 mask means don't change any).	Sends break if third arg (Boolean) is true.	Returns incoming modem line state (SmallInteger)."	<primitive: 639>	self reportError! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!UnixRealTtyAccessor class	instanceVariableNames: ''!!UnixRealTtyAccessor class methodsFor: 'class initialization'!initialize	"UnixRealTtyAccessor initialize"	DefaultPort _ '/dev/ttya'! !!UnixRealTtyAccessor class methodsFor: 'instance creation'!open: aString 	"Answer an accessor on an opened named tty. The name should be 	of the form '/dev/*', where * specifies the tty device."	| fd ioa |	fd _ self primOpen: aString errInto: self errorReporter new.	ioa _ self handle: fd.	ioa setForTty.	^ioa! !!UnixRealTtyAccessor class methodsFor: 'constants'!defaultPortName	^DefaultPort! !!UnixRealTtyAccessor class methodsFor: 'private'!primOpen: aString errInto: anErrorHolder	"Answer an accessor on an opened named tty. The name should be 	of the form '/dev/*', where * specifies the tty device.  Answers a	SmallInteger"	<primitive: 655>	^anErrorHolder reportFor: self! !UnixRealTtyAccessor initialize!UnixIOAccessor subclass: #UnixTtyAccessor	instanceVariableNames: ''	classVariableNames: 'OptionClass '	poolDictionaries: ''	category: 'OS-Unix'!UnixTtyAccessor comment:'Deals with the behavior common to both pty''s and real serial ttys, that is -- driver control.Class Variables:	OptionClass		<UnixTtyOptions> depending on which platform is being used'!!UnixTtyAccessor methodsFor: 'accessing'!bufferSize	"Answer the recommended buffer size for this accessor."	"tty's are special, the driver has a 256-element clist (usually)."	^256!getOptions	"Answer tty settings as UnixTtyOptions instance."	| ttyo |	ttyo _ self primGetOptions.	^self class defaultOptionClass with: ttyo from: 1 to: ttyo size!setOptions: opts	"Applies termio struct as tty settings."	"This is totally unreasonable, of course."	<primitive: 638>	self reportError! !!UnixTtyAccessor methodsFor: 'utilities'!setForCsh	"Set up a tty suitable for using the c-shell	as a terminal emulator."	| opts |	opts _ self getOptions.	opts discipline: #new.	opts setGlassCooked.	self setOptions: opts!setForTty	"Set up a tty suitable for using the c-shell	as a terminal emulator."	| opts |	opts _ self getOptions.	opts discipline: #new.	opts setDumbTerminal.	self setOptions: opts! !!UnixTtyAccessor methodsFor: 'private'!primGetOptions	"Returns tty settings termio struct as ByteArray."	"This is totally unreasonable, of course."	<primitive: 637>	self reportError! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!UnixTtyAccessor class	instanceVariableNames: ''!!UnixTtyAccessor class methodsFor: 'class initialization'!hookupTo: platname	"Set-up to deal with a particular platform."	"Probably should use an ordered collection of patterns (from most to least specific)	with corresponding selectors to perform.  This will have to do for now."	"The difference between the two unixes we have to deal with here	is the tty options format."	('* bsd *' match: platname)		ifTrue: [OptionClass _ BsdTtyOptions]		ifFalse: [('* sys# *' match: platname)				ifTrue: [OptionClass _ Sys5TtyOptions]				ifFalse: [OptionClass _ UnixTtyOptions]]! !!UnixTtyAccessor class methodsFor: 'defaulting'!defaultOptionClass	"Return the appropriate concrete class for interpreting options."	^OptionClass! !UninterpretedBytes variableByteSubclass: #UnixTtyOptions	instanceVariableNames: ''	classVariableNames: 'Disciplines Speeds '	poolDictionaries: ''	category: 'OS-Unix'!UnixTtyOptions comment:'Class UnixTtyOptions is an abstract class.  Instances of my subclasses are used to communicate tty options (through a UnixTtyAccessor) to the Unix tty driver.  Example subclasses are BsdTtyOptions and Sys5TtyOptions.Subclasses must implement:	accessing		echo:		parity:	utilities		setBinary		setGlassCookedClass Variables:	Disciplines	<IdentityDictionary> Maps discipline codes to symbols (e.g. old vs. new tty)	Speeds		<IdentityDictionary> Maps speed codes to baud rates (e.g. 9 is 1200 baud)'!!UnixTtyOptions methodsFor: 'accessing'!discipline	"Answer the line discipline (a Symbol)."	^Disciplines at: self disciplineCode ifAbsent: [#unknown]!discipline: aSymbol	"Assign the line discipline."	self disciplineCode: (Disciplines keyAtValue: aSymbol)!echo: bool	"Set into/outof echo mode according to boolean arg."	self subclassResponsibility!parity: p 	"Set the option value for tty parity. 	p = 1, odd parity. 	p = 0, even parity. 	p = nil, no parity. 	Affects generation on output, and checking on input. 	returns self."	self subclassResponsibility!speed	"Answer the line speed in baud."	^Speeds at: (self speedCode)!speed: s	"Set the line speed (baud)."	self speedCode: (Speeds keyAtValue: s)! !!UnixTtyOptions methodsFor: 'utilities'!setBinary	"Set modes suitable for binary data xfer."	self subclassResponsibility!setGlassCooked	"Set modes suitable for line-oriented crt emulation."	self subclassResponsibility! !!UnixTtyOptions methodsFor: 'private-printing'!printDisciplineOn: aStream	"Print the line discipline on the stream."	| disc |	disc _ self discipline.	aStream nextPutAll: 'discipline: '; print: disc! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!UnixTtyOptions class	instanceVariableNames: ''!!UnixTtyOptions class methodsFor: 'class initialization'!initDisciplines	Disciplines _ IdentityDictionary new: 3.	Disciplines at: 0 put: #old.	Disciplines at: 2 put: #new.	Disciplines at: 1 put: #net!initialize	"UnixTtyOptions initialize"	self initDisciplines.	self initSpeeds!initSpeeds	Speeds _ IdentityDictionary new: 15.	Speeds at: 0 put: 0.	Speeds at: 1 put: 50.	Speeds at: 2 put: 75.	Speeds at: 3 put: 110.	Speeds at: 4 put: 134.	Speeds at: 5 put: 150.	Speeds at: 6 put: 200.	Speeds at: 7 put: 300.	Speeds at: 8 put: 600.	Speeds at: 9 put: 1200.	Speeds at: 10 put: 1800.	Speeds at: 11 put: 2400.	Speeds at: 12 put: 4800.	Speeds at: 13 put: 9600.	Speeds at: 14 put: 19200.	Speeds at: 15 put: -1! !!UnixTtyOptions class methodsFor: 'private'!controlCharAsString: c	"Given a character value, answer a string with the printable	represention (e.g. `^C' for 8r003)"	| str cv |	c = 255 ifTrue: [^'none'].	cv _ c bitAnd: 127.	cv = 127 ifTrue: [^'del'].	cv = 32 ifTrue: [^'space'].	^cv < 32		ifTrue: 			[String with: $^ with: (Character value: cv + 64)]		ifFalse: 			[String with: (Character value: cv)]! !UnixTtyOptions initialize!StatementNode subclass: #ValueNode	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'System-Compiler-Program Objects'!ValueNode comment:'Class ValueNode is an abstract superclass for all program elements that return a value.  Currently, it has no protocol;  it exists only to mark an abstract distinction.'!Object subclass: #VariableDefinition	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'System-Compiler-Names and Scopes'!VariableDefinition comment:'This is an abstract class representing the definition of a variable.  There are six kinds of variable: argument, temporary, instance, static (class / pool / global), receiver (self, super), and pseudo (thisContext).  Named constants (nil / true / false) are not variables.'!!VariableDefinition methodsFor: 'accessing'!noteStore	"Note that this variable has been stored into.	This is only used to suppress an error message	in the situation		localVar _ [ ... localVar ...].	By default, we do nothing: if the assignment	produces an error, it does so when emitStore:	or emitStorePop: is called."! !!VariableDefinition methodsFor: 'testing'!isInvariant	"Answer true iff this variable's binding	is invariant throughout its scope.	By default, the answer is false."	^false!isLocalScope: scope index: index	"Answer true iff this is a local variable	with the given scope and index.	If index = -1, answer true iff this is a	receiver variable with the given scope.	By default, the answer is false."	^false! !!VariableDefinition methodsFor: 'checking'!leaveScope: codeStream between: minIndex and: maxIndex	"Check for anomalies when leaving	the scope of a variable.	Return true if the variable's index	was between minIndex and maxIndex.	Default is to do nothing."	^false! !!VariableDefinition methodsFor: 'code generation'!emitLoad: codeStream from: var	"Emit code to load the value of the variable.	var is the VariableNode, for reporting errors."	self subclassResponsibility!emitStore: codeStream from: var	"Emit code to store the value of the variable.	var is the VariableNode, for reporting errors."	self subclassResponsibility!emitStore: codeStream value: value from: assignment	"Emit code to assign a value to the variable."	value emitValue: codeStream forAssignment: assignment.	codeStream noteSourceNode: assignment.	self emitStore: codeStream from: assignment!emitStorePop: codeStream from: var	"Emit code to store the value of the variable	and pop the stack.	var is the VariableNode, for reporting errors."	self subclassResponsibility!emitStorePop: codeStream value: value from: assignment	"Emit code to assign a value to the variable,	and pop the value from the stack."	value emitValue: codeStream forAssignment: assignment.	codeStream noteSourceNode: assignment.	self emitStorePop: codeStream from: assignment! !LeafNode subclass: #VariableNode	instanceVariableNames: 'name '	classVariableNames: ''	poolDictionaries: ''	category: 'System-Compiler-Program Objects'!VariableNode comment:'Class VariableNode represents a variable - argument, temporary, instance, class, pool, or global.Instance Variables:	name	<String>'!!VariableNode methodsFor: 'initialize-release'!name: aSymbol	name _ aSymbol! !!VariableNode methodsFor: 'accessing'!name	"for building name scopes"	^name!sourcePosition	"VariableNodes just store the initial position,	not the Interval."	^sourcePosition to: sourcePosition + name size - 1! !!VariableNode methodsFor: 'testing'!isInvariantIn: codeStream	"Ask the codeStream if this variable	has an invariant binding"	^codeStream variableIsInvariant: name!isSelf	"Check if this is the special variable 'self'"	^name = 'self'!isSuper	"Check if this is the (non-variable) 'super'.	It's easier to do this than to detect 'super'	syntactically."	^name = 'super'! !!VariableNode methodsFor: 'printing'!printOn: aStream indent: level 	aStream nextPutAll: name! !!VariableNode methodsFor: 'code generation'!emitSend: codeStream selector: selector arguments: args	"Emit different send code if the receiver is 'super',	or if the receiver is 'self' and we can tell that the	receiver cannot be an immediate object."	self isSelf		ifTrue:			[codeStream isForNonImmediate				ifTrue: [codeStream sendNonImmediate: selector numArgs: args size]				ifFalse: [codeStream send: selector numArgs: args size]]		ifFalse:			[self isSuper				ifTrue: [codeStream sendSuper: selector numArgs: args size]				ifFalse: [codeStream send: selector numArgs: args size]]!emitStore: codeStream value: value from: assignment	codeStream codeStore: name value: value from: self in: assignment!emitStorePop: codeStream value: value from: assignment	codeStream codeStorePop: name value: value from: self in: assignment!emitValue: codeStream	codeStream codeLoad: name from: self! !Object subclass: #View	instanceVariableNames: 'model controller superView subViews transformation viewport window displayTransformation insetDisplayBox borderWidth borderColor insideColor boundingBox '	classVariableNames: ''	poolDictionaries: ''	category: 'Interface-Framework'!View comment:'Instances of class View are intended to be components in a structured picture.  Each View in the structured picture can contain other Views as sub-components.  These sub-components are called subViews.  A View can be a subView of only one View.  This View is called its superView.  The set of Views in a structured picture forms a hierarchy.  The one View in the hierarchy that has no superView is called the topView of the structured picture.  A View in a structured picture with no subViews is called a bottom View.  A View and all of its subViews, and all of their subViews and so on, are treated as a unit in many operations on the View.  For example, if a View is displayed, all of its subViews are displayed as well.  There are several catagories of operations that can be performed on a View.  Among these are the following.	1.	Adding subViews to a View.	2.	Positioning subViews within a View.	3.	Deleting subViews from a View.	4.	Transforming a View.	5.	Displaying a View. Each View has its own coordinate system.   In order to change from one coordinate system to another, each View has two transformations associated with it.  The local transformation is a WindowingTransformation that maps objects in the coordinate system of the View to objects in the coordinate system of the superView of the View.  The displayTransformation is a WindowingTransformation that maps objects in the coordinate system of the View to objects in the display screen coordinate system.The part of the space that is to be made visible is represented by the window of the View.  The window of a View is a Rectangle expressed in the coordinate system of the View.  The area occupied by a View in the coordinate system of its superView is called its viewport.  The viewport of a View is its window transformed by its local transformation.  The region of the display screen occupied by a View is called its displayBox.  The display box of a View can include a border.  The width of the border expressed in display screen coordinates is called the border width of the View.  The color of the border is called the border color.  The region of the display box of a View excluding the border is called the inset display box.  The color of the inset display box is called the inside color of the View.Instance Variables:	model			<Object | Model>	controller		<Controller>, #NoControllerAllowed, or nil	superView		<View> or nil	subViews		<OrderedCollection> of Views	transformation	<WindowingTransformation>	viewport		<Rectangle> (in superView coordinates), or nil.	window			<Rectangle> (in View coordinates), or nil.	displayTransformation	<WindowingTransformation> or nil.	insetDisplayBox	<Rectangle> (in display screen coordinates), or nil.	borderWidth	<Rectangle> (display screen unit) or 0 (meaning no border).	borderColor		<Form>	insideColor		<Form> or nil (meaning transparent)	boundingBox	<Rectangle> (in View coordinates), or nil'!!View methodsFor: 'initialize-release'!initialize	"Initialize the state of the receiver. Subclasses should include 'super initialize' 	when redefining this message to insure proper initialization."	self resetSubViews.	transformation _ WindowingTransformation identity.	self borderWidth: 0.	self borderColor: Form black!release	"Remove the receiver from its model's list of dependents (if the model exists), and 	release all of its subViews.  It is used to break possible cycles in the receiver and 	should be sent when the receiver is no longer needed.  Subclasses should include 	'super release.' when redefining release."	super release.	model removeDependent: self.	model _ nil.	controller release.	controller _ nil.	subViews ~~ nil ifTrue: [subViews do: [:aView | aView release]].	subViews _ nil.	superView _ nil.! !!View methodsFor: 'testing'!containsPoint: aPoint 	"Answer true if aPoint is within the receiver's display box,	and answer false, otherwise. It is sent to a View's 	subViews by View|subViewAt: in order to determine which subView 	contains the cursor point (so that, for example, control can be pass down to 	that subView's controller)."	^self displayBox containsPoint: aPoint! !!View methodsFor: 'model access'!model	"Answer the receiver's model."	^model!model: aModel 	"Set the receiver's model to aModel.  The model of the receiver's controller is also	set to aModel."	self model: aModel controller: controller! !!View methodsFor: 'superView access'!isTopView	"Answer true if the receiver is a top view, that is, if it has no superView."	^superView == nil!resetSubViews	"Set the list of subviews to an empty collection."		subViews _ OrderedCollection new!superView	"Answer the superView of the receiver."	^superView!topView	"Answer the root of the tree of Views in which the receiver is a node.  	The root of the tree is found by going up the superView path until reaching 	a View whose superView is nil."	superView == nil		ifTrue: [^self]		ifFalse: [^superView topView]! !!View methodsFor: 'subView access'!firstSubView	"Answer the first subView in the receiver's list of subViews if it is not empty, 	else nil."	subViews isEmpty		ifTrue: [^nil]		ifFalse: [^subViews first]!lastSubView	"Answer the last subView in the receiver's list of subViews if it is not empty, 	else nil."	subViews isEmpty		ifTrue: [^nil]		ifFalse: [^subViews last]!subViewContaining: aPoint 	"Answer the first subView that contains aPoint within its window and answer 	nil, otherwise. It is typically sent from a Controller in order to determine 	where to pass control (usually to the Controller of the View returned by 	View|subViewContaining:). "	subViews reverseDo: 		[:aSubView | 		(aSubView displayBox containsPoint: aPoint) ifTrue: [^aSubView]].	^nil!subViews	"Answer the receiver's collection of subViews."	^subViews! !!View methodsFor: 'controller access'!controller	"If the receiver's controller is nil (the default case), an initialized instance of the 	receiver's default controller is returned."	controller == nil ifTrue: [self controller: self defaultController].	^controller!controller: aController 	"Set the receiver's controller to aController.  An instance of NoController can be	specified to indicate that the receiver will not have a controller.  The model of	aController is set to the receiver's model."	self model: model controller: aController!defaultController	"Answer an initialized instance of the receiver's default controller.	Subclasses should redefine this message only if the default controller 	instances need to be initialized in a nonstandard way."	^self defaultControllerClass new!defaultControllerClass	"Answer the class of the default controller for the receiver.	Subclasses should redefine View|defaultControllerClass if the class of the 	default controller is not Controller."	^Controller!model: aModel controller: aController 	"Set the receiver's model to aModel, add the receiver to aModel's list of dependents, 	and set the receiver's controller to aController. Subsequent changes to aModel 	(see Model|change) will result in View|update: messages being sent to the 	receiver. nil for the value of aController indicates that the default	controller is to be used when needed. If aController is not nil, its view is set to the	receiver and its model is set to aModel."	model ~~ nil & (model ~~ aModel)		ifTrue: [model removeDependent: self].	aModel ~~ nil & (aModel ~~ model)		ifTrue: [aModel addDependent: self].	model _ aModel.	aController ~~ nil		ifTrue: 			[aController view: self.			aController model: aModel].	controller _ aController! !!View methodsFor: 'basic control sequence'!subViewWantingControl	"Answer the first subView that has a controller that now wants control."	subViews reverseDo: 		[:aSubView | 		Object errorSignal 			handle: [:ex | Controller badControllerSignal raise]			do: [aSubView controller isControlWanted ifTrue: [^aSubView]]].	^nil! !!View methodsFor: 'window access'!defaultWindow	"Build the minimum Rectangle that encloses all the windows of the receiver's 	subViews. The answer is a Rectangle obtained by expanding this 	minimal Rectangle by the borderWidth of the receiver. If the receiver has no 	subViews, then a Rectangle enclosing the entire display screen is answered. 	It is used internally by View methods if no window has been specified for the 	View.  Specialized subclasses of View should redefine 	View|defaultWindow to handle the default case for instances that have no 	subViews. "	| aRectangle |	subViews isEmpty ifTrue: [^DisplayScreen boundingBox].	aRectangle _ self firstSubView viewport.	subViews do: [:aView | aRectangle _ aRectangle merge: aView viewport].	^aRectangle expandBy: self borderWidth!insetWindow	"Answer a Rectangle that is obtained by insetting the receiver's window 	rectangle by the border width."	^self getWindow insetBy: self borderWidth!window	"Answer a copy of the receiver's window."	^self getWindow copy!window: aWindow 	"Set the receiver's window to a copy of aWindow."	self setWindow: aWindow copy! !!View methodsFor: 'viewport access'!viewport	"Answer a copy of the receiver's viewport."	^self getViewport copy! !!View methodsFor: 'display box access'!boundingBox	"Answer the bounding box which for the default case is the rectangular	area surrounding the bounding boxes of all the subViews."	boundingBox ~~ nil		ifTrue: [^boundingBox]		ifFalse: [^self computeBoundingBox]!computeBoundingBox	"Answer the minimum rectangle that encloses the bounding boxes of the 	receiver's subViews. If the receiver has no subViews, then the bounding box is the 	receiver's window."	"Subclasses should redefine View|boundingBox if a more 	suitable default for the case of no subViews is available."	| aRectangle |	subViews isEmpty ifTrue: [^self getWindow].	aRectangle _ self firstSubView transform: self firstSubView boundingBox.	subViews do: 		[:aView | 		aRectangle _ aRectangle merge: (aView transform: aView boundingBox).].	^aRectangle expandBy: self borderWidth!displayBox	"Answer the receiver's inset display box (see View|insetDisplayBox) expanded by the 	borderWidth.  The display box represents the region of the display screen in 	which the receiver (including the border) is displayed.  If the receiver is totally 	clipped by the display screen and its superView, the resulting Rectangle will 	be invalid."	^self insetDisplayBox expandBy: self borderWidth!insetDisplayBox	"Answer the receiver's inset display box. The inset display box is the intersection 	of the receiver's window, tranformed to display coordinates, and the inset 	display box of the superView, inset by the border width. The inset display box 	represents the region of the display screen in which the inside of the receiver (all 	except the border) is displayed. If the receiver is totally clipped by the display 	screen and its superView, the resulting Rectangle will be invalid."	[insetDisplayBox == nil] whileTrue: [insetDisplayBox _ self computeInsetDisplayBox].	^insetDisplayBox! !!View methodsFor: 'lock access'!isLocked	"Answer whether the receiver is locked.	A View is 'locked' if its display transformation and inset display box are 	defined. If these are undefined, the View is 'unlocked'. The display 	transformation and inset display box become undefined when the 	transformation of the View (or the transformation of a View in its superView 	chain) is changed, or when the superView of the View is changed, or any 	other change to the View that affects the display screen coordinates of the 	View. The locking and unlocking of a View is handled automatically by the 	internal methods of the View, but can also be done explicitly if desired (see 	View|lock, and View|unlock)."	displayTransformation == nil | (insetDisplayBox == nil)		ifTrue: [^false]		ifFalse: [^true]!isUnlocked	"Answer whether the receiver is unlocked.	See comment in View|isLocked."	^displayTransformation == nil & (insetDisplayBox == nil)!lock	"Lock the receiver and all of its subViews (see View|isLocked). This has the effect	of computing and storing the display transformation (see View|displayTransformation)	and inset display box (see View|insetDisplayBox) of the receiver and all its subViews.	 The locking and unlocking of a View is handled automatically by the internal	methods of the View, but can also be done explicitly if desired."	self isLocked ifTrue: [^self].	displayTransformation _ self computeDisplayTransformation.	insetDisplayBox _ self computeInsetDisplayBox.	subViews do: [:aSubView | aSubView lock]!unlock	"Unlock the receiver and all of its subViews (see View|isUnlocked). This has the	effect of forcing the display transformation (see View|displayTransformation) and	inset display box (see View|insetDisplayBox) of the receiver and all its subViews to	be recomputed the next time they are referenced. The locking and unlocking of a	View is handled automatically by the internal methods of the View, but can also be	done explicitly if desired."	self isUnlocked ifTrue: [^self].	displayTransformation _ nil.	insetDisplayBox _ nil.	subViews do: [:aSubView | aSubView unlock]! !!View methodsFor: 'subView inserting'!addSubView: aView 	"Remove aView from the tree of Views it is in (if any) and adds it to the rear 	of the list of subViews of the receiver.  Set the superView of aView to be the 	receiver. It is typically used to build up a hierarchy of Views (a structured 	picture). An error is generated if aView is the same as the receiver or its 	superView, etc."	self addSubView: aView ifCyclic: [self error: 'cycle in subView structure.']!addSubView: aSubView above: lowerView	"Adds aView (see View|addSubView:) so that it lies above lowerView"	self addSubView: aSubView		align: aSubView viewport bottomLeft		with: lowerView viewport topLeft!addSubView: aSubView align: aPoint1 with: aPoint2 	"Add aView to the receiver's list of subViews (see View|addSubView:) and 	translate aView so that aPoint1 coincides with aPoint2. It is typically used to 	build up a hierarchy of Views (a structured picture). Normally, aPoint1 is a 	point on aView's viewport (e.g. aView viewport topLeft, etc.), and aPoint2 is 	either an arbitrary point in the receiver's coordinate system or a point on the	receiver's window (e.g. self window topRight, etc)."	self addSubView: aSubView.	aSubView align: aPoint1 with: aPoint2!addSubView: aSubView below: lowerView	"Adds aView (see View|addSubView:) so that it lies below lowerView"	self addSubView: aSubView		align: aSubView viewport topLeft		with: lowerView viewport bottomLeft!addSubView: aView ifCyclic: exceptionBlock 	"Remove aView from the tree of Views it is in (if any) and add it to the rear of the	list of subViews of the receiver.  Set the superView of aView to be the receiver. 	It is typically used to build up a hierarchy of Views (a structured picture). An 	error is generated if aView is the same as the receiver or its superView, etc."	(self isCyclic: aView)		ifTrue: [exceptionBlock value]		ifFalse: 			[aView removeFromSuperView.			subViews addLast: aView.			aView superView: self]!addSubView: aView in: aRelativeRectangle borderWidth: width 	"Make 'aView' into a subview. Use 'aRelativeRectangle' and the 	super view's window to compute (1) a viewport within the 	superview for 'aView' and (2) the window extent for 'aView'. Note: 	defining the windowing transformation and deriving the viewport is 	logically equivalent but does not seem to be easily done"	| subViewPort myWindow myExtent myOrigin |	self addSubView: aView ifCyclic: [self error: 'cycle in subView structure.'].	aView borderWidth: width.	myWindow _ self window.	myExtent _ myWindow extent.	myOrigin _ myWindow origin.	subViewPort _ myExtent * aRelativeRectangle origin + myOrigin 						corner: myExtent * aRelativeRectangle corner + myOrigin.	aView window: aView window viewport: subViewPort!addSubView: aSubView toLeftOf: rightView	"Adds aView (see addSubView:) so that it lies to the left of rightView."	self addSubView: aSubView		align: aSubView viewport topRight		with:  rightView viewport topLeft!addSubView: aSubView toRightOf: leftView	"Adds aView (see addSubView:) so that it lies to the right of leftView"	self addSubView: aSubView		align: aSubView viewport topLeft		with: leftView viewport topRight!addSubView: aView viewport: aViewport 	"Add aView to the receiver's list of subViews (see View|addSubView:) and 	applies to aView a scale and translation computed from its window and 	aViewport (such that its window fills aViewport)."	self addSubView: aView.	aView window: aView window viewport: aViewport!addSubView: aView window: aWindow viewport: aViewport 	"Add aView to the receiver's list of subViews (see View|addSubView:) and 	applies to aView a scale and translation computed from aWindow and 	aViewport (such that aWindow fills aViewport)."	self addSubView: aView.	aView window: aWindow viewport: aViewport!insertSubView: aSubView above: lowerView 	"Add aView (see View|addSubView:) so that it lies above lowerView"	self		insertSubView: aSubView		before: lowerView		ifCyclic: [self error: 'cycle in subView structure.'].	aSubView align: aSubView viewport bottomLeft with: lowerView viewport topLeft!insertSubView: aView before: anotherView ifCyclic: exceptionBlock 	"Remove aView from the tree of Views it is in (if any) and add it to 	the rear of the list of subViews of the receiver. Set the superView 	of aView to be the receiver. It is typically used to build up a 	hierarchy of Views (a structured picture). An error is generated if 	aView is the same as the receiver or its superView."	(self isCyclic: aView)		ifTrue: [exceptionBlock value]		ifFalse: 			[aView removeFromSuperView.			subViews add: aView before: anotherView.			aView superView: self]! !!View methodsFor: 'subView removing'!releaseSubView: aView 	"Delete aView from the receiver's list of subViews and send it the message 	'release' (so that it can break up cycles with subViews, etc.)"	self removeSubView: aView.	aView release!releaseSubViews	"Release (see View|releaseSubView: ) all subViews in the receiver's list of 	subViews."	subViews do: [:aView | aView release].	self resetSubViews!removeFromSuperView	"Delete the receiver from its superView's collection of subViews."	superView ~= nil ifTrue: [superView removeSubView: self]!removeSubView: aView 	"Remove aView from the receiver's list of subViews.  	 If the list of subViews does not contain aView, an error window is created."	subViews remove: aView.	aView superView: nil.	aView unlock!removeSubViews	"Remove all the receiver's subViews."	subViews do: 		[:aView | 		aView superView: nil.		aView unlock].	self resetSubViews! !!View methodsFor: 'displaying'!display	"Display the receiver's border, model of the receiver, and then	the sub views of the receiver."	"Can be sent to the top View of a structured picture in order to display the entire 	structure, or to any particular View in the structure in order to display that 	View and its subViews.  It is typically sent in response to an update request to 	a View."	self displayBorder.	self displayView.	self displaySubViews!displayBorder	"Display the receiver's border (using the receiver's borderColor)."	self borderWidth = 0		ifTrue:			[self insideColor == nil				ifFalse: 					[Display fill: self displayBox mask: self insideColor]]		ifFalse:			[superView isNil					ifTrue:	[Display								border: self displayBox								widthRectangle: self borderWidth								mask: borderColor]					ifFalse:	[Display								border: self displayBox								widthRectangle: self borderWidth								mask: borderColor								clippingBox: superView insetDisplayBox].			self insideColor == nil				ifFalse: [Display fill: self insetDisplayBox mask: self insideColor]]!displaySafe: aBlock 	"Put the display of the receiver at the top of all	views and evaluate the argument aBlock."	self topView displaySafe: aBlock!displaySubViews	"Display all the subViews of the receiver."	subViews do: [:aSubView | aSubView display]!displayView	"Subclasses should redefine View|displayView in order to display particular 	objects associated with the View such as labels, lines, boxes, etc."	^self! !!View methodsFor: 'deEmphasizing'!deEmphasize	"Modify the emphasis (highlighting, special tabs) of the receiver.  This includes	objects such as labels, lines, and boxes.  Typically used so that the receiver is not	presented as active.  Do this for the receiver and then for each of the receiver's	subViews."	self deEmphasizeView.	self deEmphasizeSubViews!deEmphasizeSubViews	"Send the deEmphasize message to each of the receiver's subviews."	subViews do: [:aSubView | aSubView deEmphasize]!deEmphasizeView	"Subclasses should redefine View|deEmphasizeView in order to modify 	the emphasis (highlighting, special tabs) of particular objects associated 	with the View such as labels, lines, and boxes."	^self!emphasize	"Modify the emphasis (highlighting, special tabs) of the receiver.  This includes	objects such as labels, lines, and boxes.  Typically used so that the receiver is not	presented as active.  Do this for the receiver and then for each of the receiver's	subViews."	self emphasizeView.	self emphasizeSubViews!emphasizeSubViews	"Send the emphasize message to each of the receiver's subviews."	subViews do: [:aSubView | aSubView emphasize]!emphasizeView	"Subclasses should redefine View|emphasizeView in order to modify 	the emphasis (highlighting, special tabs) of particular objects associated 	with the View such as labels, lines, and boxes."	^self! !!View methodsFor: 'display transformation'!displayTransform: anObject 	"Apply the display transformation of the receiver to anObject (see 	View|displayTransformation) and answer the resulting scaled, translated 	object. It is normally applied to Rectangles, Points, and other objects with 	coordinates defined in the View's local coordinate system in order to get a 	corresponding object in display coordinates."	^(self displayTransformation applyTo: anObject) rounded!displayTransformation	"Answer a WindowingTransformation that is the result of composing all local 	transformations in the receiver's superView chain with the receiver's own local 	transformation. The resulting transformation transforms objects in the 	receiver's coordinate system into objects in the display screen coordinate 	system. "	displayTransformation == nil		ifTrue: [displayTransformation _ self computeDisplayTransformation].	^displayTransformation!inverseDisplayTransform: aPoint 	"Answer a point that is obtained from aPoint by applying to it the inverse of the	receiver's display transformation.  It is typically used by the Controller of the	receiver in order to convert a point in display coordinates, such as the cursor point,	to the local coordinate system of the receiver."	^self displayTransformation applyInverseTo: aPoint! !!View methodsFor: 'transforming'!align: aPoint1 with: aPoint2 	"Add a translation of (aPoint2 - aPoint1) to the receiver's local transformation. 	The point in the receiver's coordinate system that previously was transformed 	to aPoint1 in the superView's coordinate system will now be transformed to 	aPoint2 in the superView's coordinate system. Other points will be translated 	by the same amount. It is normally used when adding subViews to their 	superView in order to line up the Viewport of one subView with that of 	another subView (see View|addSubView:align:with:). aPoint1 and aPoint2 	are usually points on the viewports that are to be aligned. For example, 	'subView2 align: subView2 viewport topLeft with: subView1 viewport 	topRight' would be used to place the viewport of subView2 next to the 	viewport of subView1 with the topLeft and topRight corners, respectively, 	coinciding. It is also possible to align the viewport of a subView with the 	window of the superView, e.g. 'subView align: subView viewport center 	with: superView window center'. View|align:with: assumes that the view 	has been properly scaled, if necessary, to match its superView (see 	View|scaleBy:). Typically, the coordinate systems of the receiver and its 	superView will differ only by a translation offset so that no scaling is 	necessary. "	self setTransformation: (transformation align: aPoint1 with: aPoint2)!scale: aScale translation: aTranslation 	"The x component of aScale (a Point) specifies the scale (translation) in the	x direction; the y component specifies the scale (translation) in the y direction. 	aScale can optionally be an instance of Integer or Float in order to specify uniform 	scaling in both directions. 	 	Create a new local transformation for the receiver with a scale factor of aScale and 	a translation offset of aTranslation. When the transformation is applied (see 	View|transform:), the scale is applied first, followed by the translation. It is 	typically used when building a superView from its subViews in order to line 	up the viewports of the subViews in the desired way. If no scaling is required 	between subView and superView, then View|align:with: is often more 	convenient to use."	self setTransformation:		(WindowingTransformation scale: aScale translation: aTranslation)!scaleBy: aScale 	"The x component of aScale (a Point) specifies the scale in the x direction; 	the y component specifies the scale in the y direction. aScale can, optionally,	be an instance of Integer or Float in order to specify uniform scaling in both	directions. Scales the View by aScale. The scale is concatenated with the current 	transformation of the receiver and is applied when View|transform is sent. This 	happens automatically in the process of displaying the receiver, for example."	self setTransformation: (transformation scaleBy: aScale)!transform: anObject 	"Apply the local transformation of the receiver to anObject and answer the 	resulting transformation.  It is used to get the superView coordinates of an object.	For example, the viewport is equal to the window transformed."	^transformation applyTo: anObject!transformation	"Answer a copy of the receiver's local transformation."	^transformation copy!transformation: aTransformation 	"Set the receiver's local transformation to a copy of aTransformation, unlock the 	receiver (see View|unlock) and set the viewport to undefined (this forces it to be 	recomputed when needed)."	self setTransformation: aTransformation copy!translateBy: aPoint 	"Translate the receiver by aPoint. The translation is concatenated with the 	current transformation of the receiver and is applied when View|transform is 	sent. This happens automatically in the process of displaying the receiver."	self setTransformation: (transformation translateBy: aPoint)!window: aWindow viewport: aViewport 	"Set the receiver's window to aWindow, set its viewport to aViewport, and 	create a new local transformation for the receiver based on aWindow and 	aViewport. The receiver is scaled and translated so that aWindow, when 	transformed, coincides with aViewport. 	It is used to position a subView's window within some specific region of its 	superView's area. For example, 'subView window: aRectangle1 viewport: 	aRectangle2' sets subView's window to aRectangle1, its viewport to 	aRectangle2, and its local transformation to one that transforms aRectangle1 	to aRectange2."	self window: aWindow.	self setTransformation:		(WindowingTransformation window: aWindow viewport: aViewport).	self getViewport! !!View methodsFor: 'bordering'!borderColor	"Answer the receiver's border color."	^borderColor!borderColor: aColor	"Set the receiver's border color to aColor."	borderColor _ aColor!borderWidth	"Answer either 0, indicating no border, or a Rectangle whose	left value is the width in display coordinates of the receiver's left border.	Right, top, and bottom widths are analogous.	The border width is initially 0. A View with a border width of 0 will not have 	any border displayed."	^borderWidth!borderWidth: borderValue	"Set the four border widths of the receiver to anInteger or rectangle."	(borderValue isKindOf: Rectangle)			ifTrue:	[borderWidth _ borderValue.					self unlock]			ifFalse:	[self					borderWidthLeft: borderValue					right: borderValue					top: borderValue					bottom: borderValue].!borderWidthLeft: anInteger1 right: anInteger2 top: anInteger3 bottom: anInteger4	"Set the border widths of the receiver to a Rectangle made up of the four	arguments.  These arguements represent the left, right, top, and bottom border	widths."	borderWidth _			Rectangle				left: anInteger1				right: anInteger2				top: anInteger3				bottom: anInteger4.	self unlock!insideColor	"Answer the inside color of the receiver. The inside color determines the color of 	the inside of the receiver, which is the area inside the receiver's window excluding 	the border. The inside color is initially nil (meaning transparent), which 	means that when the receiver is displayed, the inside region will not be affected."	^insideColor!insideColor: aColor 	"Set the inside color of the receiver to be aColor."	insideColor _ aColor! !!View methodsFor: 'scrolling'!scrollBy: aPoint 	"The x component of aPoint specifies the amount of scrolling in the x direction; 	the y component specifies the amount of scrolling in the y direction. The amounts 	are specified in the receiver's local coordinate system. 	Scroll the receiver up or down, left or right. The window of the receiver is kept 	stationary and the subViews and other objects in the receiver are translated 	relative to it. Scrolling doesn't change the insetDisplayBox or the viewport 	since the change in the transformation is canceled by the change in the 	window. In other words, all display objects in the view, except the window, 	are translated by the scrolling operation."	| aRectangle |	aRectangle _ insetDisplayBox.	transformation _ transformation scrollBy: aPoint.	window _ self getWindow translateBy: aPoint x negated @ aPoint y negated.	self unlock.	insetDisplayBox _ aRectangle! !!View methodsFor: 'clearing'!clear	"Use the border color to paint the display box (including the border, see 	View|displayBox) of the receiver."	borderColor ~= nil ifTrue: [self clear: borderColor]!clear: aColor 	"Use aColor to paint the display box (including the border, see 	View|displayBox) of the receiver."	aColor ~= nil ifTrue: [Display fill: self displayBox mask: aColor]!clearInside	"Use the inside color to paint the inset display box (excluding the border, 	see View|insetDisplayBox) of the receiver."	self insideColor ~= nil ifTrue: [self clearInside: self insideColor]!clearInside: aColor 	"Use aColor to paint the inset display box (excluding the border, see 	View|insetDisplayBox) of the receiver."	aColor ~= nil ifTrue: [Display fill: self insetDisplayBox mask: aColor]! !!View methodsFor: 'indicating'!flash	"Cause the inset display box (the display box excluding 