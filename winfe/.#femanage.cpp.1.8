// Register a type (at init time) as associated with a particular class.
void FEManager::registerType (XuStringVar typeName, FEDocument* docClass,
		FEContent* contClass) {
	int num = theDocTypeNum++;
	theDocTypes[num].typeName = (char*)typeName;
	theDocTypes[num].docClass = docClass;
	theDocTypes[num].contClass = contClass;
}

// note that these next three members depend on the Edition structure
// created in docTypeEdition()
XuEditionP FEManager::docTypeEdition () {
	if (theDocTypeEdition == XU_NULL) {
		// make new one, with works
		theDocTypeNumEdn = XuEdition::empty(XuIDSpace::global());
		XuEditionP edn = XuEdition::empty(XuSequenceSpace::make());

		// for each registered doc type, make a work on the type name, make
		// an ID for that work, use that ID as the content class's typeID,
    // and save the ID in theDocTypeNumEdn for speedy lookup
		for (int i = 0; i < theDocTypeNum; i++) {
			XuWorkP work = XuWork::make(XuText::make
				(theDocTypes[i].typeName)->edition());
			XuIDP id = XuServer::assignID(work);
			theDocTypes[i].contClass->setTypeID(id);
      theDocTypeNumEdn = theDocTypeNumEdn->with(id, XuDataHolder::make(i));
			XuSequenceP sequence = XuSequence::string
				((XuStringVar)theDocTypes[i].typeName);
			edn = edn->with(sequence, work);
		}
		theDocTypeEdition = edn;
	}
	return theDocTypeEdition;
}


// Load theDocTypeEdition from an already-made home document
void FEManager::setDocTypeEdition (XuEditionP newEdition) {
	theDocTypeEdition = newEdition;
	XuDataP names[FE_NUMDOCTYPES];
	XuIDP ids[FE_NUMDOCTYPES];
  // Get all the doc types out of the edition, exporting their names and IDs
	// note this sequential retrieval assumes the doc types are always stored
	// consecutively along the integer axis
  XuTableStepperP stepper = newEdition->stepper(); 
	for (int i = 0; i < FE_NUMDOCTYPES; i++) {
		names[i] = XuData::make();
		FEStuff::getText(XuSequence::cast(stepper->position()), names[i]);
		ids[i] = XuServer::iDOf(XuRangeElement::cast(stepper->get()));
    stepper->step();
	}
  XuIntValueP count = newEdition->count();
	// TODO: is there a better way to do this so we don't force so damn much
  // when we initialize?
	XuPromise::forceAll();
	// Now match each type's name to a registered name in this frontend, and
	// store the number under which the type's registered at the type ID in
  // theDocTypeNumEdn
  theDocTypeNumEdn = XuEdition::empty(XuIDSpace::global());
	for (i = 0; i < count->asInt(); i++) {
		// find the  doc type with this name
		for (int j = 0; j < FE_NUMDOCTYPES; j++) {
			if (!strcmp
				(theDocTypes[j].typeName, (char*)names[i]->buffer())) {
				break;
			}
		}
		if (j == FE_NUMDOCTYPES) {
			// TODO: it may be some sort of error, if there are entries in the
			// persistent docTypeEdition that have not been registered in this
			// frontend
			continue;
		}
		theDocTypes[j].contClass->setTypeID(ids[i]);
		// store the number under which the doc type is registered in theDocTypeNumEdn
		theDocTypeNumEdn = theDocTypeNumEdn->with(ids[i], XuDataHolder::make(j));
	}
}

// get the number of the type with which edition is endorsed, by comparing
// the endorsements on edition with the numbers stored in theDocTypeNumEdn
XuIntValueP FEManager::docTypeNumber (XuEditionP edition) {
	XuIDP docTypeID = XuID::cast(theDocTypeNumEdn->domain()->intersect
		(edition->endorsements()->projection(1))->theOne());
	XuIntValueP ret = XuIntValue::cast(XuDataHolder::cast
		(theDocTypeNumEdn->get(docTypeID))->value());
	return ret;
} 	
