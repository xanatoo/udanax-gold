     CONTROL "DIRECT", 8, "Button", WS_CHILD | WS_VISIBLE | BS_AUTOCHECKBOX, 198, 76, 32, 11  /*  ,  */
     CONTROL "TBD", 9, "Edit", WS_CHILD | WS_VISIBLE | ES_LEFT, 239, 68, 27, 11  /*  ,  */
     CONTROL "Y", 10, "Edit", WS_CHILD | WS_VISIBLE | ES_LEFT, 273, 68, 9, 10  /*  ,  */
