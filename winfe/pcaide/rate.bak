     CONTROL "RATING INSTRUCTIONS", 10, "text", WS_CHILD, 5, 92, 0, 0
     CONTROL "PRODUCER", 0, "text", WS_CHILD, 5, 26, 0, 0
     CONTROL "DATE", 0, "text", WS_CHILD, 219, 8, 0, 0
     CONTROL "APPLICANT", 0, "text", WS_CHILD, 101, 26, 0, 0
     CONTROL "BILLING", 0, "text", WS_CHILD, 198, 56, 0, 0
