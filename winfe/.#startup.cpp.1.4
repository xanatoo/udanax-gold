#include <stdio.h>
#include <stdlib.h>
#include <fstream.h>
#include <string.h>
#pragma hdrstop
                                                          	
#include "absui.h"
#include "startup.h"

// just to initialize them properly
#include "title.h"
#include "clip.h"

#include "draft.h"
